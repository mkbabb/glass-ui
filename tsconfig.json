{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "preserve",
        "paths": {
            "@/*": ["./src/*"],
            "@utils": ["./src/utils"],
            "@utils/*": ["./src/utils/*"]
        },
        "types": ["vite/client"]
    },
    "include": ["src/", "demo/"]
}
