#!/bin/sh
# AX.W62 / AY.W-CARDINAL-INFRA — the live-verified-ledger commit-time forcing
# function (the fast local bite). Re-validates the PROGRESS ledger on every
# commit: a row flipped to `live-verified` without a fresh on-disk .png DELTA,
# or a retired `(DEVELOPED)` status cell, fails the commit.
#
# THE HOOK GATES THE ACTIVE TRANCHE (AY), NOT the bare default (AX). The AX
# `complete`-allowlist seeds 6 born-RED backlog rows (W05/W08/W15/W16/W17/W23 —
# the owed-DELTA debt W-DELTA0 pays). Those rows are RED-ON-PURPOSE: a TRACKER
# signal, NOT a commit-blocker. Defaulting the hook to AX would lock EVERY commit
# (including AY's own work) out behind that backlog — the gate-locks-you-out
# anti-pattern. So the hook runs `--tranche=AY` (the active tranche, green), and
# the AX backlog is the W-DELTA0 CI/local tracker (`proof:live-verified-ledger:ax`,
# born-RED, NON-blocking). When AY closes and a successor tranche opens, bump
# the `--tranche=` arg here to the new active tranche.
node scripts/proof-live-verified-ledger.mjs --tranche=AY || {
    echo ""
    echo "commit blocked: the AY live-verified ledger is inconsistent (see above)."
    echo "  Either capture the owed .png DELTA, or set the status to 'live-pending'."
    echo "  (The AX 6-row born-RED backlog is W-DELTA0's tracker, NOT this hook —"
    echo "   it does not block your commit. Run \`npm run proof:live-verified-ledger:ax\`"
    echo "   to see the backlog state.)"
    exit 1
}
