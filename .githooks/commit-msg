#!/bin/sh
# AX.W62 / AY.W-CARDINAL-INFRA — the live-verified-ledger commit-time forcing
# function (the fast local bite). Re-validates the PROGRESS ledger on every
# commit: a row flipped to `live-verified` without a fresh on-disk .png DELTA,
# or a retired `(DEVELOPED)` status cell, fails the commit.
#
# THE HOOK GATES THE ACTIVE TRANCHE (BB), NOT a closed one (BB.W-LEDGER-REPAIR
# re-pointed it AY→BB; the bare `proof:live-verified-ledger` arm runs the same
# `--tranche=BB`). The gate's parser reads the wave/status columns BY HEADER NAME
# (not position), so column order is FREE and the BA silent-no-op class — the gate
# parsing 0 rows on a re-ordered table and greening vacuously — cannot recur. When
# BB closes and a successor tranche opens, bump the `--tranche=` arg here to the
# new active tranche (the per-tranche tracker arms `:ax`/`:ay`/`:az`/`:ba` stay).
node scripts/proof-live-verified-ledger.mjs --tranche=BB || {
    echo ""
    echo "commit blocked: the BB live-verified ledger is inconsistent (see above)."
    echo "  Either capture the owed .png DELTA, or set the status to 'live-pending'."
    echo "  (The closed-tranche backlogs are their own per-tranche trackers, NOT this"
    echo "   hook — run \`npm run proof:live-verified-ledger:ba\` &c. to see them.)"
    exit 1
}
