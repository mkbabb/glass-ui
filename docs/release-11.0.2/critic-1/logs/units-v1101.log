.glass-loupe {
    
    --loupe-k-max: 2.6;
    --loupe-k-min: 1.15;
    --loupe-k: calc(
        var(--loupe-k-max) - (var(--loupe-k-max) - var(--loupe-k-min)) *
            var(--flex-vel, 0)
    );
    
    --loupe-vel: var(--flex-vel, 0);
    --loupe-span: calc(var(--slider-track-height, 1.25rem) * 6);
    position: fixed;
    z-index: calc(var(--z-overlay) - 1);
    inline-size: var(--loupe-span);
    block-size: calc(var(--slider-track-height, 1.25rem) * var(--loupe-k-max));
    inset-block-start: var(--loupe-top, 0);
    inset-inline-start: var(--loupe-left, 0);
    
    translate: -50% -100%;
    scale: 0.13;
    transform-origin: 50% 100%;
    transition:
        scale var(--spring-present-duration) var(--spring-present),
        opacity var(--spring-present-duration) var(--ease-standard);
    opacity: 0;
    overflow: hidden;
    border-radius: var(--radius-pill);
    pointer-events: none;
    
    box-shadow:
