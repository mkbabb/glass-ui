    scale: 1;
    opacity: 1;
}


.glass-loupe:not([data-engaged]) {
    transition:
        scale var(--spring-present-exit-duration) var(--ease-standard),
        opacity var(--spring-present-exit-duration) var(--ease-standard);
}

.glass-loupe-clone {
    --s: 3;
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: calc(var(--loupe-track-w, 0px) * var(--s));
    block-size: calc(var(--slider-track-height, 1.25rem) * var(--s));
    border-radius: calc(var(--radius-pill) * var(--s));
    overflow: hidden;
    background: var(--glass-slider-track-background, var(--muted-medium));
    transform: translate(
            calc(var(--loupe-span) / 2 - var(--loupe-k) * var(--loupe-x, 0px)),
            -50%
        )
        scale(calc(var(--loupe-k) / var(--s)));
    transform-origin: 0 50%;
    
    filter: blur(calc(var(--loupe-vel, 0) * 0.75px));
    transition: filter var(--duration-normal) var(--ease-standard);
}



.glass-loupe-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: var(--loupe-fill-w, 0px);
    background: var(--slider-range-bg, var(--slider-fill-ink));
}


.glass-loupe-mark {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    inline-size: 2px;
    translate: -50% 0;
    background: var(--foreground);
    opacity: 0.24;
}

@media (prefers-reduced-motion: reduce) {
    .glass-loupe {
        transition-duration: 0.01ms;
    }
    .glass-loupe-clone {
        filter: none;
    }
}
