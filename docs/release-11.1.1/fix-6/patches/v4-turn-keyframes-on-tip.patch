+/* A region reversed mid-motion turns from where it stands. The turn (`turn.ts`) names one
+   of these inline, with the height and block padding the region stood at in
+   `--disclosure-turn-size` and `--disclosure-turn-pad`, so the new motion begins at its
+   own first stop, at that height, and ends where `disclosure-open` or `disclosure-close`
+   ends. */
+@keyframes disclosure-turn-open {
+    from {
+        block-size: var(--disclosure-turn-size);
+        padding-block: var(--disclosure-turn-pad);
+    }
+
+    to {
+        block-size: var(--disclosure-content-size);
+    }
+}
+
+@keyframes disclosure-turn-close {
+    from {
+        block-size: var(--disclosure-turn-size);
+        padding-block: var(--disclosure-turn-pad);
+    }
+
+    to {
+        block-size: 0;
+        padding-block: 0;
+    }
+}
+
 @layer components {
     .disclosure {
         inline-size: 100%;
