+ * A surface a dock opened passes its portal stamp (`useDockParticipation`): the layer is
+ * part of that surface, so a pointer that moves onto it, or a tap on it, has not left the
+ * dock.
+ */
+export function outsideAttrs(
+    zIndex: string,
+    portal: DockPortalAttrs = {},
+): Record<string, unknown> {
+    return {
+        ...portal,
+        "data-slot": "overlay-outside",
+        "aria-hidden": "true",
+        class: "fixed inset-0",
+        style: { zIndex, pointerEvents: "auto" },
+        onClick: answerTap,
+    };
+}
