+import { computed, type ComputedRef, type ShallowRef } from "vue";
+import type { DockPortalAttrs } from "./participation";
+import { useRootScrollLock } from "./root-scroll-lock";
+import { useSheetWidth } from "./sheet-width";
+
+/**
+ * THE PHONE'S OUTSIDE. Below 30rem (`useSheetWidth`) the page behind an open glass
+ * surface is not live, as the page behind an iPhone's menu or popover is not: a gesture
+ * begun on the surface or beside it never moves the page, and a tap beside it closes the
+ * surface and presses nothing under it.
+ *
+ * A modal surface has that already: its scrim holds the page through the root lock and
+ * takes the outside tap. A non-modal one (a Select, a menu, a Popover, a `modal={false}`
+ * Sheet or Dialog) gets the same two parts here, for as long as it is open at this width:
+ *
+ * - The root lock. `overscroll-behavior: contain` on the plate cannot hold the page:
+ *   WebKit applies it only to a box whose content overflows (webkit.org/b/243452), so a
+ *   list that fits, and any part of a plate outside its list, hands a swipe to the page.
+ *   With the root's `overflow: hidden` the browser still runs its own pan, so a touch that
+ *   turns into a swipe ends in `pointercancel` and no control under the finger acts on it.
+ * - A clear layer under the plate, `outsideAttrs`. It takes every touch outside the plate,
+ *   so the tap that closes the surface lands on it and not on the page, and it listens
+ *   for click (`answerTap`).
+ *
+ * The hold ends at the logical close, so the page is live while the surface leaves. The
+ * hover arm of a Popover is a hint a fine pointer opened and has no root here: it holds
+ * nothing.
+ */
+export function useOverlayOutside(
+    open: () => boolean,
+    modal: () => boolean = () => false,
+): { sheet: Readonly<ShallowRef<boolean>>; held: ComputedRef<boolean> } {
+    const sheet = useSheetWidth(open);
+    const held = computed(() => open() && sheet.value && !modal());
+    useRootScrollLock(() => held.value);
+    return { sheet, held };
+}
+
+/**
+ * The outside listens for click. On a touch, reka's outside press waits for the click
+ * that ends the tap (`DismissableLayer`), and WebKit sends a tap's click only to an
+ * element that answers one: an element with no click listener gets none (iOS's rule,
+ * webkit.org/b/267688; Apple's Safari Web Content Guide makes an element clickable with
+ * an empty click handler). With this listener the tap's click reaches the document, and
+ * reka closes the surface on it.
