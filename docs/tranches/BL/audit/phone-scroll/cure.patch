+ * The outside listens for click. On a touch, reka's outside press waits for the click
+ * that ends the tap (`DismissableLayer`), and WebKit sends that click only to an element
+ * that answers one. Apple's Safari Web Content Guide, Handling Events: "If the user taps
+ * a nonclickable element, no events are generated." With this listener the tap's click
+ * reaches the document, and reka closes the surface on it.
+ */
+export function answerTap(): void {}
+
+/**
+ * The clear layer, stacked at `zIndex` and authored before its plate in the same portal.
+ *
+ * It carries reka's layer marker, `data-dismissable-layer`. reka counts a press as
+ * inside a surface when the pressed element sits in that surface's layer or in a layer
+ * that comes after it in the document. The surface this layer belongs to comes after it,
+ * so a press on the layer is outside and closes it. A surface it was opened from comes
+ * before it, so the same press is inside that one, which stays open.
+ *
+ * A surface a dock opened passes its portal stamp (`useDockParticipation`): a pointer
+ * that moves onto the layer, or a tap on it, has not left the dock.
+ */
+export function outsideAttrs(
+    zIndex: string,
+    portal: DockPortalAttrs = {},
+): Record<string, unknown> {
+    return {
+        ...portal,
+        "data-slot": "overlay-outside",
+        "data-dismissable-layer": "",
+        "aria-hidden": "true",
+        class: "fixed inset-0",
+        style: { zIndex, pointerEvents: "auto" },
+        onClick: answerTap,
+    };
+}
