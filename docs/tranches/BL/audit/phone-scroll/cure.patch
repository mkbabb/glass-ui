+import { computed, type ComputedRef, type ShallowRef } from "vue";
+import type { DockPortalAttrs } from "./participation";
+import { useRootScrollLock } from "./root-scroll-lock";
+import { useSheetWidth } from "./sheet-width";
+
+/**
+ * THE PHONE'S OUTSIDE. Below 30rem (`useSheetWidth`) a gesture begun on an open glass
+ * surface never moves the page behind it.
+ *
+ * A modal surface has that already: its scrim holds the page through the root lock and
+ * takes the outside tap. A non-modal surface takes the root lock here for as long as it
+ * is open at this width. `overscroll-behavior: contain` on the plate cannot hold the
+ * page: WebKit applies it only to a box whose content overflows (webkit.org/b/243452),
+ * so a list that fits, and any part of a plate outside its list, hands a swipe to the
+ * page. With the root's `overflow: hidden` Chromium still runs its own pan, so there a
+ * touch that turns into a swipe ends in `pointercancel` and no control under the finger
+ * acts on it. iOS WebKit turns its page pan off while the root is `hidden`, so there the
+ * same swipe can end in `pointerup` on the control it began on, which reka's Select takes
+ * as a pick or an open. WebKit has no hold scoped to the plate in CSS, so the lock holds
+ * a swipe begun beside the surface as well.
+ *
+ * A Select, a menu and a click Popover also lay a clear layer under the plate
+ * (`outsideAttrs`), as an iPhone's menu and popover take the touch beside them: the tap
+ * that closes the surface lands on the layer and presses nothing under it. The layer
+ * stands at `--z-popover`, as the plate does, and a modal Dialog or Sheet stands above
+ * that rung: beside a menu or a popover opened in one, the tap lands on the modal plate
+ * and presses what is under it there. A `modal={false}` Sheet or Dialog lays no layer.
+ * The page beside it stays live to a tap, as the area beside an iPhone's nonmodal sheet
+ * does.
+ *
+ * The hold ends at the logical close, so the page is live while the surface leaves. The
+ * hover arm of a Popover is a hint a fine pointer opened and has no root here: it holds
+ * nothing.
+ */
+export function useOverlayOutside(
+    open: () => boolean,
+    modal: () => boolean = () => false,
+): { sheet: Readonly<ShallowRef<boolean>>; held: ComputedRef<boolean> } {
+    const sheet = useSheetWidth(open);
+    const held = computed(() => open() && sheet.value && !modal());
+    useRootScrollLock(() => held.value);
+    return { sheet, held };
+}
+
