+// The draw under load.  stall.mjs <engine> <url> <out>
+//
+// Per case: mount one mark, wait until its draw is 40 ms in, then block the main thread for
+// 50 ms. Chromium runs at a 4× CPU throttle. Paint is read from the page's screencast, whose
+// frames come from the compositor; frames are placed by a corner marker, not by a clock
+// (A = the last frame before the task, B = the first after it, C = `drawn`). A control
+// square on a plain transform animation proves the screencast can see compositor frames
+// inside the task; where it cannot, the cell is unmeasurable, never a pass.
+// The page's read ledger says which layout and style reads ran in which phase.
+// A second, traced pass (Chromium) counts main-thread Layout and style events in the draw.
+import { mkdirSync, writeFileSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { PNG, jpegjs, launch, open } from "./lib.mjs";
+
+const [engine, url, out] = process.argv.slice(2);
+const png = join(out, "png");
+mkdirSync(png, { recursive: true });
+const W = 1440, H = 600, THROTTLE = 4, TASK_MS = 50;
+const CASES = [["h112", "underline"], ["h112", "highlight"], ["wrap", "underline"], ["wrap", "highlight"], ["body", "underline"]];
+const record = { engine, throttle: engine === "chromium" ? THROTTLE : null, taskMs: TASK_MS, cells: [] };
+
+const decode = (f) => { const img = jpegjs.decode(f.data, { useTArray: true }); return { ...img, scale: img.width / f.viewportWidth }; };
+function crop(img, r) {
+    const s = img.scale, x0 = Math.round(r.x * s), y0 = Math.round(r.y * s);
+    const w = Math.min(img.width - x0, Math.round(r.width * s)), h = Math.min(img.height - y0, Math.round(r.height * s));
+    const o = new PNG({ width: w, height: h });
+    for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
+        const i = ((y0 + y) * img.width + x0 + x) * 4, k = (y * w + x) * 4;
+        o.data[k] = img.data[i]; o.data[k + 1] = img.data[i + 1]; o.data[k + 2] = img.data[i + 2]; o.data[k + 3] = 255;
+    }
+    return o;
+}
+function markerOf(img) {
+    const s = img.scale, i = (Math.round(10 * s) * img.width + Math.round(10 * s)) * 4;
+    const [r, g, b] = [img.data[i], img.data[i + 1], img.data[i + 2]];
+    return r > 180 && g < 90 && b < 90 ? "A" : b > 180 && r < 90 && g < 90 ? "B" : g > 140 && r < 90 && b < 90 ? "C" : "-";
+}
+function diff(a, b, th = 48) {
+    let n = 0;
+    for (let i = 0; i < Math.min(a.data.length, b.data.length); i += 4)
+        if (Math.max(Math.abs(a.data[i] - b.data[i]), Math.abs(a.data[i + 1] - b.data[i + 1]), Math.abs(a.data[i + 2] - b.data[i + 2])) > th) n++;
+    return n;
+}
+
+const mountAndBlock = (page) => page.evaluate(async (TASK_MS) => {
+    const anims = () => (document.querySelector('[data-probe="mark"]')?.getAnimations({ subtree: true }) ?? []).filter((a) => a.playState === "running");
+    const raf = () => new Promise((r) => requestAnimationFrame(r));
+    window.__mount();
+    let run = [];
+    for (let i = 0; i < 400; i++) {
+        await raf();
+        run = anims();
+        if (run[0] && (run[0].currentTime ?? 0) - (run[0].effect.getTiming().delay || 0) >= 40) break;
+    }
+    window.__marker("rgb(255, 0, 0)");
+    await new Promise((r) => setTimeout(r, 0));
+    window.__marker("rgb(0, 0, 255)");
+    const props = [...new Set(run.flatMap((a) => a.effect.getKeyframes().flatMap((k) => Object.keys(k))))].filter((k) => !["offset", "computedOffset", "easing", "composite"].includes(k));
+    const ct0 = run.map((a) => a.currentTime);
+    const before = window.__reads.length;
+    const s = performance.now();
+    while (performance.now() - s < TASK_MS) { /* the injected task */ }
+    const taskMs = performance.now() - s;
+    const inTask = window.__reads.length - before;
+    const was = window.__phase;
+    window.__phase = "probe"; // the probe's own reads, kept out of the mark's ledger
+    setTimeout(() => window.__phase === "probe" && (window.__phase = was), 0);
+    const sp = getComputedStyle(document.querySelector('[data-probe="spring"]'));
+    const win = document.querySelector('[data-probe="mark"] .tm-window');
+    return {
+        props, taskMs, readsInTask: inTask,
+        currentTimeAtTaskStart: ct0, currentTimeAtTaskEnd: run.map((a) => a.currentTime),
+        timing: run.map((a) => ({ name: a.animationName, duration: a.effect.getComputedTiming().duration, delay: a.effect.getComputedTiming().delay })),
+        presentDuration: parseFloat(sp.animationDuration) * 1000, presentEasing: sp.animationTimingFunction,
+        drawEasing: win ? getComputedStyle(win).animationTimingFunction : null,
+    };
+}, TASK_MS);
+
+async function cell(browser, spec, shape) {
+    const name = `${spec}-${shape}`;
+    const { context, page, errors } = await open(browser, url, { width: W, height: H, dpr: 1, query: `scene=draw&case=${spec}&shape=${shape}&draw=mount` });
+    const frames = [];
+    try {
+        if (engine === "chromium") await (await context.newCDPSession(page)).send("Emulation.setCPUThrottlingRate", { rate: THROTTLE });
+        await page.screencast.start({ onFrame: (f) => frames.push({ data: f.data, viewportWidth: f.viewportWidth, ts: f.timestamp }), size: { width: W, height: H }, quality: 90 });
+        await page.waitForTimeout(400);
+        const before = frames.length;
+        const run = await mountAndBlock(page);
+        await page.waitForTimeout(1500);
+        await page.screencast.stop();
+        const after = await page.evaluate(() => {
+            window.__phase = "probe";
+            const rs = [...document.querySelectorAll('[data-probe="mark"] .tm-window')].map((p) => p.getBoundingClientRect());
+            const x0 = Math.min(...rs.map((r) => r.left)) - 6, y0 = Math.min(...rs.map((r) => r.top)) - 6;
+            const x1 = Math.max(...rs.map((r) => r.right)) + 6, y1 = Math.max(...rs.map((r) => r.bottom)) + 6;
+            const by = {};
+            for (const r of window.__reads) (by[r.phase] ??= {}), (by[r.phase][r.api] = (by[r.phase][r.api] ?? 0) + 1);
+            return { region: { x: Math.max(0, Math.floor(x0)), y: Math.max(0, Math.floor(y0)), width: Math.ceil(x1 - x0), height: Math.ceil(y1 - y0) }, reads: by, drawn: window.__drawn.length, lines: rs.length };
+        });
+        const ref = crop(decode(frames[Math.max(0, before - 1)]), after.region);
+        const fin = crop(decode(frames[frames.length - 1]), after.region);
+        const full = diff(fin, ref) || 1;
+        const CTL = { x: 30, y: 0, width: 220, height: 20 };
+        const seq = frames.map((f, i) => { const img = decode(f); const c = crop(img, after.region); return { i, m: markerOf(img), p: diff(c, ref) / full, c, ctl: crop(img, CTL) }; });
+        const a = seq.filter((s) => s.m === "A");
+        const inTask = a.slice(1);
+        const first = a[0], last = a[a.length - 1];
+        const controlMoved = first ? inTask.some((s) => diff(s.ctl, first.ctl) > 20) : false;
+        const b = seq.find((s) => s.m === "B");
+        const c0 = seq.findIndex((s) => s.m === "C");
+        const strip = [first, ...inTask, b].filter(Boolean);
+        strip.forEach((s, k) => writeFileSync(join(png, `stall-${engine}-${name}-${k}.png`), PNG.sync.write(s.c)));
