index 000000000..d1c008c54
--- /dev/null
+++ b/src/components/text-mark/geometry.ts
@@ -0,0 +1,164 @@
+/**
+ * The mark's geometry: one stroke, every dimension read from the text it marks.
+ *
+ * Pure and framework-free. A caller hands in what the text measured (the ink box of one
+ * line, its baseline, the face's own metrics) and gets back one closed SVG path in CSS px.
+ * Nothing here knows a typeface: there is no em constant for an x-height or a descender.
+ */
+
+import { hashString, mulberry32 } from "../../composables/glass/procedural/prng";
+
+export const SHAPES = ["underline", "highlight"] as const;
+export type MarkShape = (typeof SHAPES)[number];
+
+/** The marked face at its rendered size, in px. Each field is the font's own answer. */
+export interface Face {
+    /** The font size. */
+    em: number;
+    /** Ink height of a lowercase x above the baseline. */
+    xHeight: number;
+    /** Ink thickness of the face's hyphen: the weight of a free horizontal stroke in this face. */
+    rule: number;
+}
+
+/** One line of the marked run, in CSS px, in the frame that draws it. */
+export interface Line {
+    /** The ink box's left and right edges: where the first and last glyph's ink ends. */
+    x0: number;
+    x1: number;
+    /** The alphabetic baseline. */
+    baseline: number;
+    /** The inline direction: a stroke starts at the line's inline start. */
+    rtl: boolean;
+    /** Spans of x where glyph ink crosses the stroke's seat (descenders, commas). */
+    skips: Array<[number, number]>;
+}
+
+export interface Stroke {
+    /** The closed outline, as an SVG path. */
+    d: string;
+    /** The outline's bounds. */
+    box: { x: number; y: number; width: number; height: number };
+}
+
+/** 1/φ: the stroke's weight as a share of the face's own horizontal stroke. */
+const WEIGHT = 0.618;
+
+/**
+ * The stroke's vertical seat for a face, from the baseline (+ is down): its top and bottom
+ * at the stroke's start, and the clearance it keeps from glyph ink.
+ */
+export function seatOf(shape: MarkShape, face: Face, offset = 0): { top: number; bottom: number; clear: number } {
+    if (shape === "highlight") {
+        // The band covers the lowercase body, x-height to baseline, and bleeds by one rule
+        // above and below so the letterforms sit in it and not on its edge.
+        return { top: -face.xHeight - face.rule, bottom: face.rule, clear: 0 };
+    }
+    // The underline is the face's own horizontal stroke, lightened by 1/φ so it sits under
+    // the letterforms' weight, and never under 1.25px. It hangs its own thickness below the
+    // baseline, and never closer than the round letters' overshoot plus a pixel.
+    const t = Math.max(face.rule * WEIGHT, 1.25);
+    const gap = Math.max(t, 0.06 * face.em + 1) + offset;
+    return { top: gap, bottom: gap + t, clear: Math.max(0.5, Math.min(Math.max(1, t / 2), gap - 0.03 * face.em)) };
+}
+
+/** The hand: two seeded numbers, a bow and where it is deepest. Nothing else varies. */
+export function handOf(seed: number): { bow: number; lean: number } {
+    const next = mulberry32(seed >>> 0);
+    return {
+        // The stroke's sag as a share of its length: a wrist's arc, 0.3% to 0.55%.
+        bow: 0.003 + next() * 0.0025,
+        // Where the arc is deepest, as a signed skew of the two control points.
+        lean: (next() - 0.5) * 0.5,
+    };
+}
+
+export function markSeed(text: string): number {
+    return hashString(text) >>> 0;
+}
+
+const r3 = (n: number): number => Math.round(n * 1000) / 1000;
+
+/**
+ * The stroke over one line.
+ *
+ * The centreline is a single cubic from the ink box's start to its end, level at both
+ * ends, sagging by `bow × length` and never by more than 0.02em. The underline thins from full weight at its start to 0.8 at its end, as a
+ * pen lifts; the band keeps its height. Ends are round on the underline and softly
+ * squared on the band. Where glyph ink crosses the underline's seat the stroke stops and
+ * starts again, as a signwriter's underline does.
+ */
+export function markStroke(shape: MarkShape, line: Line, face: Face, seed: number, offset = 0): Stroke {
+    const band = shape === "highlight";
+    const seat = seatOf(shape, face, offset);
+    const t = seat.bottom - seat.top;
+    // The band bleeds past the ink box by one rule a side, inside the word space.
+    const bleed = band ? face.rule : 0;
+    const X0 = line.x0 - bleed;
+    const X1 = line.x1 + bleed;
+    const L = Math.max(0, X1 - X0);
+    const { bow, lean } = handOf(seed);
+    const sag = Math.min(bow * L, 0.02 * face.em);
+    const y1 = (sag / 0.75) * (1 + lean);
+    const y2 = (sag / 0.75) * (1 - lean);
+    const mid = line.baseline + (seat.top + seat.bottom) / 2;
+    const taper = band ? 0 : 0.2;
+
+    // u runs 0 → 1 from the inline start to the inline end.
+    const uOf = (x: number) => (L === 0 ? 0 : line.rtl ? (X1 - x) / L : (x - X0) / L);
+    const du = L === 0 ? 0 : (line.rtl ? -1 : 1) / L;
+    const centre = (u: number) => mid + 3 * y1 * u + (3 * y2 - 6 * y1) * u * u + (3 * y1 - 3 * y2) * u * u * u;
+    const centreD = (u: number) => 3 * y1 + 2 * (3 * y2 - 6 * y1) * u + 3 * (3 * y1 - 3 * y2) * u * u;
+    const half = (u: number) => (t / 2) * (1 - taper * u);
+    const halfD = -(t / 2) * taper;
+    /** An edge (−1 top, +1 bottom) as y(x) and dy/dx. */
+    const edge = (side: 1 | -1, x: number) => centre(uOf(x)) + side * half(uOf(x));
+    const edgeD = (side: 1 | -1, x: number) => (centreD(uOf(x)) + side * halfD) * du;
+    /** The cubic that IS the edge between xa and xb: both are cubics in x, so this is exact. */
+    const curve = (side: 1 | -1, xa: number, xb: number) => {
+        const k = (xb - xa) / 3;
+        return `C${r3(xa + k)} ${r3(edge(side, xa) + edgeD(side, xa) * k)} ${r3(xb - k)} ${r3(edge(side, xb) - edgeD(side, xb) * k)} ${r3(xb)} ${r3(edge(side, xb))}`;
+    };
+    /** The end radius at x: a full round on the underline, a soft corner on the band. */
+    const radius = (x: number) => half(uOf(x)) * (band ? 0.28 : 1);
+
+    // The pieces: the ink box less the skips. A piece shorter than three strokes is a blot, not a stroke.
+    const pieces: Array<[number, number]> = [];
+    let from = X0;
+    for (const [a, b] of band ? [] : [...line.skips].sort((p, q) => p[0] - q[0])) {
+        if (b <= from) continue;
+        if (a > from) pieces.push([from, Math.min(a, X1)]);
+        from = Math.max(from, b);
+        if (from >= X1) break;
+    }
+    if (from < X1) pieces.push([from, X1]);
+
+    let d = "";
+    for (const [xa, xb] of pieces) {
+        if (xb - xa < 3 * t && pieces.length > 1) continue;
+        const ra = Math.min(radius(xa), (xb - xa) / 2);
+        const rb = Math.min(radius(xb), (xb - xa) / 2);
+        const a = xa + ra;
+        const b = xb - rb;
+        const ya = centre(uOf(a));
+        const yb = centre(uOf(b));
+        const ha = half(uOf(a));
+        const hb = half(uOf(b));
+        d +=
+            `M${r3(a)} ${r3(ya - ha)}` +
+            curve(-1, a, b) +
+            `A${r3(rb)} ${r3(rb)} 0 0 1 ${r3(xb)} ${r3(yb - hb + rb)}` +
+            `L${r3(xb)} ${r3(yb + hb - rb)}` +
+            `A${r3(rb)} ${r3(rb)} 0 0 1 ${r3(b)} ${r3(yb + hb)}` +
+            curve(1, b, a) +
+            `A${r3(ra)} ${r3(ra)} 0 0 1 ${r3(xa)} ${r3(ya + ha - ra)}` +
+            `L${r3(xa)} ${r3(ya - ha + ra)}` +
+            `A${r3(ra)} ${r3(ra)} 0 0 1 ${r3(a)} ${r3(ya - ha)}Z`;
+    }
+    const top = mid - t / 2;
+    const bottom = mid + t / 2 + Math.max(y1, y2);
+    return {
+        d,
+        box: { x: Math.floor(X0) - 1, y: Math.floor(top) - 1, width: Math.ceil(L) + 3, height: Math.ceil(bottom - top) + 3 },
+    };
+}
