@@ -0,0 +1,39 @@
+// draw="in-view": a mark below the fold waits undrawn, then draws once when scrolled to.
+//   inview.mjs <engine> <url> <out>
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { launch, open } from "./lib.mjs";
+const [engine, url, out] = process.argv.slice(2);
+const browser = await launch(engine);
+const record = [];
+try {
+    for (const shape of ["underline", "highlight"]) {
+        const { context, page } = await open(browser, url, { query: `scene=sheet&shape=${shape}&draw=in-view`, height: 420 });
+        try {
+            const read = () => page.evaluate(() => {
+                const host = document.querySelector('[data-probe="rtl"]');
+                const win = host.querySelector(".tm-window");
+                const r = host.getBoundingClientRect();
+                return { top: Math.round(r.top), viewport: innerHeight, ink: host.dataset.ink, windows: host.querySelectorAll(".tm-window").length,
+                    windowTransform: win ? getComputedStyle(win).transform : null, drawnEvents: window.__drawn.length };
+            });
+            await page.waitForTimeout(1500);
+            const below = await read();
+            await page.locator('[data-probe="rtl"]').evaluate((el) => el.scrollIntoView({ block: "center" }));
+            await page.waitForTimeout(1200);
+            const reached = await read();
+            await page.evaluate(() => scrollTo(0, 0));
+            await page.waitForTimeout(600);
+            await page.locator('[data-probe="rtl"]').evaluate((el) => el.scrollIntoView({ block: "center" }));
+            await page.waitForTimeout(800);
+            const again = await read();
+            record.push({ shape, below, reached, again });
+        } finally {
+            await context.close();
+        }
+    }
+} finally {
+    await browser.close();
+}
+writeFileSync(join(out, `inview-${engine}.json`), JSON.stringify(record, null, 2));
+console.log(JSON.stringify(record));
diff --git a/docs/tranches/BL/design/marks/proposal-B/fixture/lib.mjs b/docs/tranches/BL/design/marks/proposal-B/fixture/lib.mjs
