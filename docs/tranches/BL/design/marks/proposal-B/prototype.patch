--- /dev/null
+++ b/docs/tranches/BL/design/marks/proposal-B/fixture/lib.mjs
@@ -0,0 +1,26 @@
+// Shared by the probes: one browser per run, a new context per cell, both closed in `finally`.
+import { chromium, webkit } from "playwright";
+import { createRequire } from "node:module";
+import { existsSync } from "node:fs";
+import { homedir } from "node:os";
+import { dirname, join } from "node:path";
+
+const require = createRequire(import.meta.url);
+export const { PNG, jpegjs } = require(join(dirname(require.resolve("playwright-core")), "lib/utilsBundle.js"));
+
+const WEBKIT_2287 = join(homedir(), "Library/Caches/ms-playwright/webkit-2287/pw_run.sh");
+export const launch = (engine) =>
+    engine === "webkit" ? webkit.launch(existsSync(WEBKIT_2287) ? { executablePath: WEBKIT_2287 } : {}) : chromium.launch();
+
+export async function open(browser, url, { width = 1440, height = 900, theme = "light", query = "", reducedMotion = "no-preference", media = "screen", forcedColors = "none", dpr = 2 } = {}) {
+    const context = await browser.newContext({ viewport: { width, height }, deviceScaleFactor: dpr, colorScheme: theme, reducedMotion, forcedColors });
+    const page = await context.newPage();
+    const errors = [];
+    page.on("pageerror", (e) => errors.push(String(e)));
+    page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
+    await page.emulateMedia({ media, reducedMotion, colorScheme: theme, forcedColors });
+    await page.goto(`${url}?${query}&theme=${theme}`, { waitUntil: "load" });
+    await page.waitForFunction(() => window.__ready === true, null, { timeout: 120_000 });
+    await page.waitForTimeout(400);
+    return { context, page, errors };
+}
