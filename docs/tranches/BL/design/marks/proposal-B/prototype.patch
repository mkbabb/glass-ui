+#!/usr/bin/env bash
+# One guarded browser run: serve this worktree with vite on <port>, run <script> in
+# <engine>, stop the server.   run.sh <port> <engine> <script.mjs> <out-dir> [args...]
+set -u
+PORT=$1; ENGINE=$2; SCRIPT=$3; OUT=$4; shift 4
+HERE=$(cd "$(dirname "$0")" && pwd)
+ROOT=$(cd "$HERE/../../../../../../.." && pwd)
+mkdir -p "$OUT"
+( cd "$ROOT" && exec npx vite --host 127.0.0.1 --port "$PORT" --strictPort ) > "$OUT/server-$ENGINE.log" 2>&1 &
+SRV=$!
+trap 'kill $SRV 2>/dev/null; wait $SRV 2>/dev/null' EXIT
+URL="http://127.0.0.1:$PORT/docs/tranches/BL/design/marks/proposal-B/fixture/index.html"
+for i in $(seq 1 90); do
+  curl -sf "$URL" > /dev/null && break
+  kill -0 $SRV 2>/dev/null || { echo "server exited early"; exit 3; }
+  sleep 2
+done
+cd "$HERE" && node "$HERE/$SCRIPT" "$ENGINE" "$URL" "$OUT" "$@"
