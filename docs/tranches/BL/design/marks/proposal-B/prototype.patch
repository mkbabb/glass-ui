@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# The whole record for one engine, each probe in its own guarded run.
+#   all.sh <engine> <out-dir>      (WebKit waits on the machine-wide webkit lock)
+set -u
+ENGINE=$1; OUT=$2
+HERE=$(cd "$(dirname "$0")" && pwd)
+G=~/.claude/guard/guarded
+if [ "$ENGINE" = webkit ]; then EX="--exclusive webkit"; PORT=7997; else EX=""; PORT=7996; fi
+mkdir -p "$OUT"
+for SCRIPT in probe.mjs stall.mjs; do
+  $G $EX --timeout 30 -- bash "$HERE/run.sh" "$PORT" "$ENGINE" "$SCRIPT" "$OUT" > "$OUT/$ENGINE-${SCRIPT%.mjs}.log" 2>&1
+  echo "$(date +%T) $ENGINE $SCRIPT exit $?" >> "$OUT/chain.log"
+done
+echo "DONE $ENGINE $(date +%T)" >> "$OUT/chain.log"
diff --git a/docs/tranches/BL/design/marks/proposal-B/fixture/diag.mjs b/docs/tranches/BL/design/marks/proposal-B/fixture/diag.mjs
new file mode 100644
index 000000000..4ab472eb6
--- /dev/null
+++ b/docs/tranches/BL/design/marks/proposal-B/fixture/diag.mjs
@@ -0,0 +1,49 @@
+// What the canvas measures against what layout set.  diag.mjs <engine> <url> <out>
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { launch, open } from "./lib.mjs";
+const [engine, url, out] = process.argv.slice(2);
+const browser = await launch(engine);
+try {
+    const { context, page } = await open(browser, url, { query: "scene=sheet&shape=underline&draw=none", height: 1100 });
+    try {
+        const r = await page.evaluate(() => {
+            const rows = [];
+            for (const k of ["h112", "wake", "google", "rtl"]) {
+                const host = document.querySelector(`[data-probe="${k}"]`);
+                const cs = getComputedStyle(host);
+                const walk = document.createTreeWalker(host, NodeFilter.SHOW_TEXT);
+                let n = walk.nextNode();
+                while (n && !n.data.trim()) n = walk.nextNode();
+                const range = document.createRange();
+                range.selectNodeContents(n);
+                const dom = range.getBoundingClientRect();
+                const c = document.createElement("canvas").getContext("2d");
+                const font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+                const tryFont = (f, ls) => {
+                    c.font = f;
+                    if ("letterSpacing" in c) c.letterSpacing = ls;
+                    c.direction = cs.direction;
+                    c.textAlign = "left";
+                    const m = c.measureText(n.data);
+                    const d = c.measureText("-");
+                    return { set: c.font, width: +m.width.toFixed(2), abl: +m.actualBoundingBoxLeft.toFixed(2), abr: +m.actualBoundingBoxRight.toFixed(2), rule: +(d.actualBoundingBoxAscent + d.actualBoundingBoxDescent).toFixed(2), fbA: m.fontBoundingBoxAscent, fbD: m.fontBoundingBoxDescent };
+                };
+                rows.push({
+                    k, font, fontShorthand: cs.font, letterSpacing: cs.letterSpacing, hasLetterSpacing: "letterSpacing" in c,
+                    domWidth: +dom.width.toFixed(2), domHeight: +dom.height.toFixed(2),
+                    built: tryFont(font, cs.letterSpacing === "normal" ? "0px" : cs.letterSpacing),
+                    shorthand: cs.font ? tryFont(cs.font, cs.letterSpacing === "normal" ? "0px" : cs.letterSpacing) : null,
+                    check: document.fonts.check(font),
+                });
+            }
+            return rows;
+        });
+        writeFileSync(join(out, `diag-${engine}.json`), JSON.stringify(r, null, 2));
+        console.log(JSON.stringify(r, null, 1));
+    } finally {
+        await context.close();
+    }
+} finally {
+    await browser.close();
+}
