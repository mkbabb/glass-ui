diff --git a/src/components/text-mark/TextMark.vue b/src/components/text-mark/TextMark.vue
new file mode 100644
index 000000000..0310732f2
--- /dev/null
+++ b/src/components/text-mark/TextMark.vue
@@ -0,0 +1,296 @@
+<!--
+  TextMark: one stroke that says which words carry the weight.
+
+  The words stay real text in the page's own element (`<span>`, or `<mark>` for the band),
+  and without script they keep a plain `text-decoration` underline or a `<mark>` ground.
+  With script, each line of the run gets one stroke whose every dimension is read from the
+  text: its ends from the glyphs' ink box, its seat from the baseline, its weight from the
+  face's own hyphen. Nothing is measured in the mount task or in a frame of the draw.
+-->
+<script setup lang="ts">
+import { computed, onBeforeUnmount, onMounted, ref, watch } from "vue";
+import { type Face, type MarkShape, markSeed, markStroke, seatOf } from "./geometry";
+import { measure } from "./measure";
+
+const props = withDefaults(
+    defineProps<{
+        shape?: MarkShape;
+        /** The ink, any CSS colour. Default: the page's focal colour, `--primary`. */
+        color?: string;
+        /**
+         * When the stroke draws in: when the reader reaches it, as soon as it is measured,
+         * or not at all (it stands drawn).
+         */
+        draw?: "in-view" | "mount" | "none";
+    }>(),
+    { shape: "underline", draw: "in-view" },
+);
+
+const emit = defineEmits<{
+    /** The mark stands complete: after its last line's last frame, or at once when nothing moves. */
+    drawn: [];
+}>();
+
+interface Drawn {
+    d: string;
+    x: number;
+    y: number;
+    width: number;
+    height: number;
+    dir: 1 | -1;
+}
+
+const root = ref<HTMLElement | null>(null);
+const origin = ref<HTMLElement | null>(null);
+const marks = ref<Drawn[]>([]);
+const live = ref(false);
+const ink = ref<"wait" | "draw" | "rest">(props.draw === "none" ? "rest" : "wait");
+
+/** The underline's extra drop, in em, read from `--mark-offset` (a token, not a prop). */
+function seat(face: Face, offsetEm: number) {
+    const s = seatOf(props.shape, face, offsetEm * face.em);
+    // The rows the stroke can reach: its seat plus the deepest sag.
+    return { ...s, bottom: s.bottom + 0.02 * face.em };
+}
+
+/** Read the text, then write the strokes. Runs only where layout is already clean. */
+function remeasure(): void {
+    const el = root.value;
+    const at = origin.value;
+    if (!el || !at) return;
+    const offsetEm = parseFloat(getComputedStyle(el).getPropertyValue("--mark-offset")) || 0;
+    const o = at.getBoundingClientRect();
+    const { face, lines } = measure(el, props.shape === "underline" ? (f) => seat(f, offsetEm) : null);
+    const seed = markSeed((el.textContent ?? "").trim());
+    marks.value = lines.map((line, i) => {
+        const local = {
+            ...line,
+            x0: line.x0 - o.left,
+            x1: line.x1 - o.left,
+            baseline: line.baseline - o.top,
+            skips: line.skips.map(([a, b]) => [a - o.left, b - o.left] as [number, number]),
+        };
+        const s = markStroke(props.shape, local, face, seed + i, offsetEm * face.em);
+        return { d: s.d, ...s.box, dir: line.rtl ? -1 : 1 };
+    });
+}
+
+const MOTION = "screen and (prefers-reduced-motion: no-preference)";
+const still = () => !(window.matchMedia?.(MOTION)?.matches ?? true);
+
+let done = false;
+function finish(): void {
+    if (done) return;
+    done = true;
+    emit("drawn");
+}
+
+function onEnd(e: AnimationEvent): void {
+    if (ink.value !== "draw" || e.animationName.indexOf("tm-window") !== 0) return;
+    if (Number((e.target as Element).getAttribute("data-i")) !== marks.value.length - 1) return;
+    // `animationend` runs before its frame is on screen; `drawn` lands one frame later.
+    requestAnimationFrame(finish);
+}
+
+let seen: IntersectionObserver | null = null;
+let sized: ResizeObserver | null = null;
+let first = true;
+let skip = true;
+
+/** The nearest block ancestor: the box whose resize can re-wrap this run. */
+function block(el: HTMLElement): HTMLElement {
+    let p = el.parentElement;
+    while (p && getComputedStyle(p).display.startsWith("inline")) p = p.parentElement;
+    return p ?? document.body;
+}
+
+function onSeen(entries: IntersectionObserverEntry[]): void {
+    const el = root.value;
+    if (!el) return;
+    if (first) {
+        // The observer's first report arrives in a task of its own, after the first layout:
+        // the first measure happens here, and the block ancestor is found here.
+        first = false;
+        remeasure();
+        // The observer's own first report repeats this measure, so it is skipped.
+        sized = new ResizeObserver(() => (skip ? (skip = false) : remeasure()));
+        sized.observe(block(el));
+        // A face that arrives late changes the ink without resizing anything.
+        if (document.fonts && document.fonts.status !== "loaded") void document.fonts.ready.then(again);
+        if (ink.value === "rest" || still()) finish();
+        if (props.draw === "mount") ink.value = "draw";
+    }
+    if (props.draw !== "in-view" || ink.value !== "wait") return;
+    if (entries.some((e) => e.intersectionRatio >= 0.5)) {
+        ink.value = "draw";
+        if (still()) finish();
+    }
+}
+
+onMounted(() => {
+    // No read here: the mount task writes one attribute and registers one observer.
+    live.value = true;
+    if (typeof IntersectionObserver === "undefined") {
+        throw new Error("[TextMark] IntersectionObserver is required.");
+    }
+    seen = new IntersectionObserver(onSeen, { threshold: [0, 0.5] });
+    if (root.value) seen.observe(root.value);
+});
+
+onBeforeUnmount(() => {
+    seen?.disconnect();
+    sized?.disconnect();
+});
+
+/** Measure again in the resize observer's own callback, where layout is clean. */
+function again(): void {
+    if (!sized || !root.value) return;
+    const b = block(root.value);
+    skip = false;
+    sized.unobserve(b);
+    sized.observe(b);
+}
+
+watch(() => props.shape, again, { flush: "post" });
+
+const tag = computed(() => (props.shape === "highlight" ? "mark" : "span"));
+</script>
+
+<template>
+    <component
+        :is="tag"
+        ref="root"
+        class="tm"
+        :data-shape="shape"
+        :data-ink="ink"
+        :data-live="live ? '' : undefined"
+        :style="color ? { '--mark-ink': color } : undefined"
+        @animationend="onEnd"
+    >
+        <slot /><span ref="origin" class="tm-origin" aria-hidden="true" /><span
+            v-for="(m, i) in marks"
+            :key="i"
+            class="tm-window"
+            :data-i="i"
+            aria-hidden="true"
+            :style="{
+                left: `${m.x}px`,
+                top: `${m.y}px`,
+                width: `${m.width}px`,
+                height: `${m.height}px`,
+                '--tm-i': i,
+                '--tm-dir': m.dir,
+                '--tm-wipe': `${m.width * m.dir}px`,
+            }"
+            ><svg class="tm-frame" :width="m.width" :height="m.height" :viewBox="`${m.x} ${m.y} ${m.width} ${m.height}`" focusable="false">
+                <path :d="m.d" /></svg
+        ></span>
+    </component>
+</template>
+
+<style>
+@layer components {
+    /* Without script (and until the component is live): the plain typographic mark. */
+    .tm {
+        /* `--mark-ink` is the consumer's token; with none, the page's focal colour. */
+        --tm-ink: var(--mark-ink, var(--primary));
+        --tm-band: light-dark(oklch(from var(--tm-ink) 0.86 0.16 h), oklch(from var(--tm-ink) 0.44 0.16 h));
+        text-decoration: underline;
+        text-decoration-color: var(--tm-ink);
+        text-decoration-thickness: 0.07em;
+        text-underline-offset: 0.09em;
+        text-decoration-skip-ink: auto;
+    }
+    mark.tm {
+        text-decoration: none;
+        color: inherit;
+        background: var(--tm-band);
+        -webkit-box-decoration-break: clone;
+        box-decoration-break: clone;
+    }
+
+    /* Live: the stroke replaces the decoration. Forced colours keep the decoration (below). */
+    @media not (forced-colors: active) {
+        .tm[data-live] {
+            position: relative;
+            isolation: isolate;
+            text-decoration: none;
+            background: none;
+        }
+    }
+    .tm-origin {
+        position: absolute;
+        left: 0;
+        top: 0;
+        width: 0;
+        height: 0;
+    }
+    .tm-window {
+        position: absolute;
+        overflow: hidden;
+        pointer-events: none;
+        user-select: none;
+    }
+    .tm-frame {
+        display: block;
+        fill: var(--tm-ink);
+    }
+    .tm[data-shape="highlight"] .tm-window {
+        z-index: -1;
+    }
+    .tm[data-shape="highlight"] .tm-frame {
+        fill: var(--tm-band);
+    }
+
+    /* The draw: a clip window slides open along the line while the stroke inside slides
+       back by the same distance, so the ink holds still. `transform` only, on the
+       `present` spring and its own clock; line i waits for the i lines before it. */
+    @media screen and (prefers-reduced-motion: no-preference) {
+        .tm[data-ink="wait"] .tm-window {
+            transform: translateX(calc(-100% * var(--tm-dir)));
+        }
+        .tm[data-ink="wait"] .tm-frame {
+            transform: translateX(var(--tm-wipe));
+        }
+        .tm[data-ink="draw"] :is(.tm-window, .tm-frame) {
+            animation-duration: var(--spring-present-duration);
+            animation-timing-function: var(--spring-present);
+            animation-delay: calc(var(--tm-i) * var(--spring-present-duration));
+            animation-fill-mode: both;
+        }
+        .tm[data-ink="draw"] .tm-window {
+            animation-name: tm-window;
+        }
+        .tm[data-ink="draw"] .tm-frame {
+            animation-name: tm-frame;
+        }
+    }
+
+    /* Forced colours: the system's own underline and highlight, and no stroke. */
+    @media (forced-colors: active) {
+        .tm-window {
+            display: none;
+        }
+        mark.tm {
+            background: Mark;
+            color: MarkText;
+        }
+    }
+}
+@keyframes tm-window {
+    from {
+        transform: translateX(calc(-100% * var(--tm-dir)));
+    }
+    to {
+        transform: translateX(0);
+    }
+}
+@keyframes tm-frame {
+    from {
+        transform: translateX(var(--tm-wipe));
+    }
+    to {
+        transform: translateX(0);
+    }
+}
+</style>
