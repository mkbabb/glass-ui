+/**
+ * TextMark public barrel. The component is the surface; `markStroke` ships with it so a
+ * caller that owns its own line (a rule, a chart leader) inks it with the same stroke.
+ */
+export { default as TextMark } from "./TextMark.vue";
+export { SHAPES, markStroke, seatOf, type Face, type Line, type MarkShape, type Stroke } from "./geometry";
diff --git a/src/components/text-mark/measure.ts b/src/components/text-mark/measure.ts
new file mode 100644
index 000000000..ad8be65f3
--- /dev/null
+++ b/src/components/text-mark/measure.ts
@@ -0,0 +1,222 @@
+/**
+ * What the text measures: the lines of a marked run, their ink boxes, their baselines,
+ * and where glyph ink crosses the underline's seat.
+ *
+ * Layout answers where each line sits (`Range` rects, the text's own boxes). The glyphs
+ * answer everything about ink: each piece of the run is drawn once into a small canvas in
+ * its own font and read back. `TextMetrics` is not used for ink: WebKit reports the
+ * advance box as `actualBoundingBoxLeft/Right` and clamps a negative descent to 0, so the
+ * two engines would disagree. Pixels agree.
+ *
+ * Call this where layout is already clean (an observer callback), never in a mount task
+ * and never in a frame of the draw.
+ */
+
+import type { Face, Line } from "./geometry";
+
+let ctx: CanvasRenderingContext2D | null = null;
+function pen(): CanvasRenderingContext2D {
+    if (!ctx) {
+        ctx = document.createElement("canvas").getContext("2d", { willReadFrequently: true });
+        if (!ctx) throw new Error("[TextMark] no 2D canvas: the mark cannot measure its text.");
+    }
+    return ctx;
+}
+
+type Spaced = CanvasRenderingContext2D & { letterSpacing?: string; wordSpacing?: string };
+
+/** Point the pen at an element's own font, as layout shaped it. */
+function load(cs: CSSStyleDeclaration): CanvasRenderingContext2D {
+    const c = pen() as Spaced;
+    c.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+    c.direction = cs.direction === "rtl" ? "rtl" : "ltr";
+    c.textAlign = "left";
+    c.textBaseline = "alphabetic";
+    if ("letterSpacing" in c) c.letterSpacing = cs.letterSpacing === "normal" ? "0px" : cs.letterSpacing;
+    if ("wordSpacing" in c) c.wordSpacing = cs.wordSpacing === "normal" ? "0px" : cs.wordSpacing;
+    if ("fontKerning" in c) c.fontKerning = cs.fontKerning as CanvasFontKerning;
+    return c;
+}
+
+interface Ink {
+    /** Ink extent in px from the text's left advance edge (x) and from the baseline (y, + down). */
+    left: number;
+    right: number;
+    top: number;
+    bottom: number;
+    /** Spans of x (same origin) whose columns carry ink between `rows[0]` and `rows[1]`. */
+    spans: Array<[number, number]>;
+}
+
+/** Draw `text` once in the element's font and read its ink. `rows` is a band from the baseline. */
+function inkOf(cs: CSSStyleDeclaration, text: string, rows: [number, number] | null): Ink | null {
+    const m = load(cs).measureText(text);
+    const em = parseFloat(cs.fontSize) || 16;
+    const S = em > 96 ? 1 : 2;
+    const pad = Math.ceil(em * 0.3) + 2;
+    const up = Math.ceil(m.fontBoundingBoxAscent) + 2;
+    const down = Math.ceil(Math.max(m.fontBoundingBoxDescent, rows ? rows[1] : 0)) + 2;
+    const w = Math.ceil((m.width + 2 * pad) * S);
+    const h = (up + down) * S;
+    const cv = pen().canvas;
+    cv.width = w;
+    cv.height = h;
+    // Resizing a canvas resets its state: load the font again.
+    const c = load(cs);
+    c.setTransform(S, 0, 0, S, 0, 0);
+    c.fillStyle = "#000";
+    c.fillText(text, pad, up);
+    const px = c.getImageData(0, 0, w, h).data;
+    c.setTransform(1, 0, 0, 1, 0, 0);
+    const r0 = rows ? Math.max(0, Math.floor((up + rows[0]) * S)) : 0;
+    const r1 = rows ? Math.min(h, Math.ceil((up + rows[1]) * S)) : 0;
+    let left = -1, right = -1, top = h, bottom = -1, open = -1;
+    const spans: Array<[number, number]> = [];
+    for (let x = 0; x <= w; x++) {
+        let any = false, inRows = false;
+        if (x < w)
+            for (let y = 0; y < h; y++)
+                if (px[(y * w + x) * 4 + 3] > 64) {
+                    any = true;
+                    if (y < top) top = y;
+                    if (y > bottom) bottom = y;
+                    if (y >= r0 && y < r1) inRows = true;
+                }
+        if (any) {
+            if (left < 0) left = x;
+            right = x + 1;
+        }
+        if (inRows && open < 0) open = x;
+        if (!inRows && open >= 0) {
+            spans.push([open / S - pad, x / S - pad]);
+            open = -1;
+        }
+    }
+    if (left < 0) return null;
+    return { left: left / S - pad, right: right / S - pad, top: top / S - up, bottom: (bottom + 1) / S - up, spans };
+}
+
+const faces = new Map<string, Face>();
+
+/** The face's own metrics at its rendered size: read once per font from an x and a hyphen. */
+export function faceOf(cs: CSSStyleDeclaration): Face {
+    const key = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+    const known = faces.get(key);
+    if (known) return known;
+    const em = parseFloat(cs.fontSize) || 16;
+    const x = inkOf(cs, "x", null);
+    const dash = inkOf(cs, "-", null);
+    const rule = dash ? dash.bottom - dash.top : 0;
+    const face: Face = {
+        em,
+        xHeight: x ? -x.top : em * 0.5,
+        // A face with no usable hyphen still gets a stroke: a fifteenth of an em.
+        rule: rule > em * 0.02 && rule < em * 0.25 ? rule : em / 15,
+    };
+    faces.set(key, face);
+    return face;
+}
+
+/** A run of one text node on one line. */
+interface Piece {
+    node: Text;
+    start: number;
+    end: number;
+    rect: DOMRect;
+}
+
+/** Split the host's text into pieces: one per text node per line, whitespace trimmed at the ends. */
+function pieces(host: HTMLElement): Piece[] {
+    const walk = document.createTreeWalker(host, NodeFilter.SHOW_TEXT);
+    const range = document.createRange();
+    const out: Piece[] = [];
+    for (let n = walk.nextNode() as Text | null; n; n = walk.nextNode() as Text | null) {
+        const text = n.data;
+        let open: { start: number; end: number; top: number; bottom: number } | null = null;
+        const close = () => {
+            if (!open) return;
+            range.setStart(n!, open.start);
+            range.setEnd(n!, open.end);
+            out.push({ node: n!, start: open.start, end: open.end, rect: range.getBoundingClientRect() });
+            open = null;
+        };
+        for (let i = 0; i < text.length; ) {
+            const step = text.codePointAt(i)! > 0xffff ? 2 : 1;
+            range.setStart(n, i);
+            range.setEnd(n, i + step);
+            const r = range.getBoundingClientRect();
+            const space = /\s/.test(text[i]);
+            if (r.width > 0 && r.height > 0 && !space) {
+                const same = open && Math.min(open.bottom, r.bottom) - Math.max(open.top, r.top) > r.height / 2;
+                if (!same) {
+                    close();
+                    open = { start: i, end: i + step, top: r.top, bottom: r.bottom };
+                } else open!.end = i + step;
+            }
+            i += step;
+        }
+        close();
+    }
+    return out;
+}
+
+export interface Measured {
+    face: Face;
+    /** Lines in client coordinates. */
+    lines: Line[];
+}
+
+/**
+ * Measure the host. `seat` is the underline's band from the baseline (top, bottom and its
+ * clearance, in px, + down); when given, each line reports the spans where glyph ink enters it.
+ */
+export function measure(
+    host: HTMLElement,
+    seat: ((face: Face) => { top: number; bottom: number; clear: number }) | null,
+): Measured {
+    const face = faceOf(getComputedStyle(host));
+    const band = seat ? seat(face) : null;
+    const styles = new Map<Element, CSSStyleDeclaration>();
+    const rows: Array<Line & { top: number; bottom: number }> = [];
+
+    for (const p of pieces(host)) {
+        const parent = p.node.parentElement ?? host;
+        let cs = styles.get(parent);
+        if (!cs) styles.set(parent, (cs = getComputedStyle(parent)));
+        const text = p.node.data.slice(p.start, p.end);
+        const m = load(cs).measureText(text);
+        const asc = m.fontBoundingBoxAscent;
+        const desc = m.fontBoundingBoxDescent;
+        const baseline = p.rect.top + (p.rect.height * asc) / (asc + desc);
+        let row = rows.find((q) => Math.min(q.bottom, p.rect.bottom) - Math.max(q.top, p.rect.top) > Math.min(q.bottom - q.top, p.rect.height) / 2);
+        const shift = row ? baseline - row.baseline : 0;
+        const ink = inkOf(cs, text, band ? [band.top - band.clear - shift, band.bottom + band.clear - shift] : null);
+        if (!ink) continue;
+        // Layout is the authority on width; the canvas is scaled onto it.
+        const k = m.width > 0 ? p.rect.width / m.width : 1;
+        const fit = Math.abs(k - 1) < 0.08 ? k : 1;
+        const inkL = p.rect.left + ink.left * fit;
+        const inkR = p.rect.left + ink.right * fit;
+        if (!row) {
+            row = { x0: inkL, x1: inkR, baseline, rtl: cs.direction === "rtl", skips: [], top: p.rect.top, bottom: p.rect.bottom };
+            rows.push(row);
+        } else {
+            row.x0 = Math.min(row.x0, inkL);
+            row.x1 = Math.max(row.x1, inkR);
+        }
+        if (band) for (const [a, b] of ink.spans) row.skips.push([p.rect.left + a * fit - band.clear, p.rect.left + b * fit + band.clear]);
+    }
+    // Merge the skips that touch.
+    for (const row of rows) {
+        row.skips.sort((a, b) => a[0] - b[0]);
+        const merged: Array<[number, number]> = [];
+        for (const s of row.skips) {
+            const last = merged[merged.length - 1];
+            if (last && s[0] <= last[1]) last[1] = Math.max(last[1], s[1]);
+            else merged.push([s[0], s[1]]);
+        }
+        row.skips = merged;
+    }
+    rows.sort((a, b) => a.top - b.top);
+    return { face, lines: rows.map(({ top: _t, bottom: _b, ...line }) => line) };
+}
