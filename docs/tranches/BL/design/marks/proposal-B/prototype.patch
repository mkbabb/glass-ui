+// A first look: every specimen at rest.  look.mjs <engine> <url> <out> [themes] [shapes] [impls]
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { launch, open } from "./lib.mjs";
+
+const [engine, url, out, themes = "light", shapes = "underline,highlight", impls = "new"] = process.argv.slice(2);
+mkdirSync(out, { recursive: true });
+const browser = await launch(engine);
+const log = {};
+try {
+    for (const theme of themes.split(","))
+        for (const shape of shapes.split(","))
+            for (const impl of impls.split(",")) {
+                const { context, page, errors } = await open(browser, url, { theme, query: `scene=sheet&shape=${shape}&impl=${impl}&draw=none`, height: 1100 });
+                try {
+                    await page.waitForTimeout(600);
+                    for (const spec of ["h48", "h85", "h112", "body", "wrap", "rtl"])
+                        await page.locator(`[data-spec="${spec}"]`).screenshot({ path: join(out, `${engine}-${impl}-${shape}-${theme}-${spec}.png`) });
+                    log[`${theme}-${shape}-${impl}`] = { errors, face: await page.evaluate(() => {
+                        const c = document.createElement("canvas").getContext("2d");
+                        const cs = getComputedStyle(document.querySelector(".head"));
+                        c.font = `${cs.fontStyle} ${cs.fontWeight} 100px ${cs.fontFamily}`;
+                        const d = c.measureText("-"), x = c.measureText("x"), p = c.measureText("p"), H = c.measureText("H"), comma = c.measureText(",");
+                        return { font: c.font, letterSpacing: "letterSpacing" in c, rule: d.actualBoundingBoxAscent + d.actualBoundingBoxDescent, x: x.actualBoundingBoxAscent, cap: H.actualBoundingBoxAscent, desc: p.actualBoundingBoxDescent, comma: comma.actualBoundingBoxDescent, fbA: x.fontBoundingBoxAscent, fbD: x.fontBoundingBoxDescent,
+                            marks: [...document.querySelectorAll(".tm-window")].length };
+                    }) };
+                } finally {
+                    await context.close();
+                }
+            }
+} finally {
+    await browser.close();
+}
+writeFileSync(join(out, `look-${engine}.json`), JSON.stringify(log, null, 2));
+console.log(JSON.stringify(log, null, 1));
diff --git a/docs/tranches/BL/design/marks/proposal-B/fixture/probe.mjs b/docs/tranches/BL/design/marks/proposal-B/fixture/probe.mjs
new file mode 100644
index 000000000..1dbbc54a1
--- /dev/null
+++ b/docs/tranches/BL/design/marks/proposal-B/fixture/probe.mjs
@@ -0,0 +1,227 @@
+// The paint record.  probe.mjs <engine> <url> <out>
+//   rest      every specimen at rest, light and dark, both shapes; 11.1.0's HandMark beside it
+//   draw      three frames of the draw, the animations paused and sought
+//   fit       measured in paint: where the stroke's ends land against the marked glyphs'
+//             ink, and how many pixels of stroke and glyph overlap
+//   still     reduced motion, print, forced colours, and the no-script fallback
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { PNG, launch, open } from "./lib.mjs";
+
+const [engine, url, out, only = ""] = process.argv.slice(2);
+const png = join(out, "png");
+mkdirSync(png, { recursive: true });
+const SPECS = ["h48", "h85", "h112", "nest", "body", "wrap", "rtl"];
+const want = (k) => !only || only.split(",").includes(k);
+const record = { engine, errors: [], fit: [], draw: [], still: [] };
+
+const shot = (page, spec, name) => page.locator(`[data-spec="${spec}"]`).screenshot({ path: join(png, `${name}.png`) });
+
+async function rest(browser) {
+    for (const theme of ["light", "dark"])
+        for (const shape of ["underline", "highlight"]) {
+            const { context, page, errors } = await open(browser, url, { theme, query: `scene=sheet&shape=${shape}&draw=none`, height: 1100 });
+            try {
+                await page.waitForTimeout(500);
+                for (const spec of SPECS) await shot(page, spec, `rest-${engine}-${shape}-${theme}-${spec}`);
+                record.errors.push(...errors);
+            } finally {
+                await context.close();
+            }
+        }
+    // 11.1.0's HandMark on the same specimens, for the before frame.
+    for (const shape of ["underline", "highlight"]) {
+        const { context, page } = await open(browser, url, { query: `scene=sheet&shape=${shape}&impl=old&draw=none`, height: 1100 });
+        try {
+            await page.waitForTimeout(800);
+            for (const spec of ["h112", "body", "wrap"]) await shot(page, spec, `before-${engine}-${shape}-light-${spec}`);
+        } finally {
+            await context.close();
+        }
+    }
+}
+
+async function draw(browser) {
+    for (const [theme, shape, specs] of [
+        ["light", "underline", ["h112", "body", "wrap", "rtl"]],
+        ["light", "highlight", ["h112", "wrap", "rtl"]],
+        ["dark", "underline", ["h112"]],
+        ["dark", "highlight", ["h112"]],
+    ]) {
+        const { context, page } = await open(browser, url, { theme, query: `scene=sheet&shape=${shape}&draw=mount&hold=1`, height: 1100 });
+        try {
+            await page.waitForTimeout(500);
+            for (const p of [0.1, 0.25, 0.5]) {
+                // Seek every mark to the same share of its own clock (lines × the spring's duration).
+                const read = await page.evaluate((p) => {
+                    const out = {};
+                    for (const host of document.querySelectorAll(".tm")) {
+                        const anims = host.getAnimations({ subtree: true });
+                        const lines = host.querySelectorAll(".tm-window").length;
+                        const dur = anims.length ? anims[0].effect.getComputedTiming().duration : 0;
+                        for (const a of anims) a.currentTime = p * lines * dur;
+                        const win = host.querySelector(".tm-window");
+                        const m = new DOMMatrix(getComputedStyle(win).transform);
+                        out[host.dataset.probe] = { lines, dur, animations: anims.length, playState: anims[0]?.playState, firstLineOpen: +(1 - Math.abs(m.m41) / win.offsetWidth).toFixed(3) };
+                    }
+                    return out;
+                }, p);
+                await page.waitForTimeout(120);
+                for (const spec of specs) await shot(page, spec, `draw-${engine}-${shape}-${theme}-${spec}-${String(p * 100).padStart(2, "0")}`);
+                record.draw.push({ theme, shape, p, read });
+            }
+        } finally {
+            await context.close();
+        }
+    }
+}
+
+/** Dark-pixel mask of a PNG buffer. */
+function mask(buf) {
+    const img = PNG.sync.read(buf);
+    const m = new Uint8Array(img.width * img.height);
+    for (let i = 0; i < m.length; i++) m[i] = img.data[i * 4] + img.data[i * 4 + 1] + img.data[i * 4 + 2] < 384 ? 1 : 0;
+    return { m, w: img.width, h: img.height };
+}
+
+async function fit(browser) {
+    const DPR = 2;
+    for (const impl of ["new", "old"])
+        for (const shape of ["underline", "highlight"]) {
+            const masks = {};
+            let lines = null;
+            for (const mode of ["marked", "mark"]) {
+                const { context, page } = await open(browser, url, { query: `scene=sheet&shape=${shape}&impl=${impl}&draw=none&only=${mode}`, height: 1100, dpr: DPR });
+                try {
+                    await page.waitForTimeout(800);
+                    masks[mode] = mask(await page.screenshot({ fullPage: true }));
+                    // Each marked line's layout rect: the region its ink is read in.
+                    lines ??= await page.evaluate(() =>
+                        [...document.querySelectorAll("[data-probe]")].flatMap((host) => {
+                            const fs = parseFloat(getComputedStyle(host).fontSize);
+                            const rows = [];
+                            const walk = document.createTreeWalker(host, NodeFilter.SHOW_TEXT);
+                            const range = document.createRange();
+                            for (let n = walk.nextNode(); n; n = walk.nextNode()) {
+                                if (!n.data.trim() || n.parentElement.closest("svg")) continue;
+                                range.selectNodeContents(n);
+                                for (const r of range.getClientRects()) {
+                                    const row = rows.find((q) => Math.abs(q.top - r.top) < r.height / 2);
+                                    if (row) { row.left = Math.min(row.left, r.left); row.right = Math.max(row.right, r.right); }
+                                    else rows.push({ top: r.top + scrollY, bottom: r.bottom + scrollY, left: r.left, right: r.right });
+                                }
+                            }
+                            return rows.map((r, i) => ({ probe: host.dataset.probe, line: i, fs, ...r }));
+                        }),
+                    );
+                } finally {
+                    await context.close();
+                }
+            }
+            const { w } = masks.marked;
+            for (const ln of lines) {
+                const pad = ln.fs * 0.6;
+                const x0 = Math.max(0, Math.floor((ln.left - pad) * DPR)), x1 = Math.min(w, Math.ceil((ln.right + pad) * DPR));
+                // A line owns the rows from its own top to just above the next line's glyphs.
+                const y0 = Math.floor((ln.top - ln.fs * 0.1) * DPR), y1 = Math.ceil((ln.bottom + ln.fs * 0.12) * DPR);
+                const ext = (m) => {
+                    let l = Infinity, r = -Infinity, t = Infinity, b = -Infinity;
+                    for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) if (m[y * w + x]) { l = Math.min(l, x); r = Math.max(r, x); t = Math.min(t, y); b = Math.max(b, y); }
+                    return { l: l / DPR, r: (r + 1) / DPR, t: t / DPR, b: (b + 1) / DPR };
+                };
+                const text = ext(masks.marked.m), stroke = ext(masks.mark.m);
+                let overlap = 0;
+                for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) if (masks.marked.m[y * w + x] && masks.mark.m[y * w + x]) overlap++;
+                record.fit.push({
+                    impl, shape, probe: ln.probe, line: ln.line, fontSize: ln.fs,
+                    startDelta: +(stroke.l - text.l).toFixed(2), endDelta: +(stroke.r - text.r).toFixed(2),
+                    strokeTop: +stroke.t.toFixed(2), strokeBottom: +stroke.b.toFixed(2), strokeHeight: +(stroke.b - stroke.t).toFixed(2),
+                    overlapPx: +(overlap / (DPR * DPR)).toFixed(1),
+                });
+            }
+        }
+}
+
+async function still(browser) {
+    const cells = [
+        ["reduced-motion", { reducedMotion: "reduce" }, "draw=in-view"],
+        ["print", { media: "print" }, "draw=in-view"],
+        ["forced-colors", { forcedColors: "active" }, "draw=none"],
+        ["no-script", {}, "impl=css"],
+    ];
+    for (const [name, opts, q] of cells)
+        for (const shape of ["underline", "highlight"]) {
+            let ctx;
+            try {
+                const { context, page } = (ctx = await open(browser, url, { ...opts, query: `scene=sheet&shape=${shape}&${q}`, height: 1100 }));
+                await page.waitForTimeout(500);
+                const read = await page.evaluate(() => {
+                    const host = document.querySelector('[data-probe="h85"]');
+                    const win = host.querySelector(".tm-window");
+                    const cs = getComputedStyle(host);
+                    return {
+                        tag: host.tagName, ink: host.dataset.ink ?? null, live: host.hasAttribute("data-live"),
+                        windows: document.querySelectorAll(".tm-window").length,
+                        windowDisplay: win ? getComputedStyle(win).display : null,
+                        windowTransform: win ? getComputedStyle(win).transform : null,
+                        running: document.getAnimations().filter((a) => a.playState === "running").length,
+                        decorationLine: cs.textDecorationLine, background: cs.backgroundColor, drawn: window.__drawn.length,
+                    };
+                });
+                for (const spec of ["h85", "body", "wrap"]) await shot(page, spec, `still-${engine}-${name}-${shape}-${spec}`);
+                record.still.push({ name, shape, read });
+            } catch (e) {
+                record.still.push({ name, shape, error: String(e).slice(0, 300) });
+            } finally {
+                await ctx?.context.close();
+            }
+        }
+}
+
+/** A narrower viewport re-wraps the three-line run: does each stroke follow its line? */
+async function resize(browser) {
+    record.resize = [];
+    for (const impl of ["new", "old"]) {
+        const { context, page } = await open(browser, url, { query: `scene=sheet&shape=underline&impl=${impl}&draw=none`, height: 1100 });
+        try {
+            const read = () => page.evaluate(() => {
+                const host = document.querySelector('[data-probe="wrap"]');
+                const walk = document.createTreeWalker(host, NodeFilter.SHOW_TEXT);
+                let n = walk.nextNode();
+                while (n && !n.data.trim()) n = walk.nextNode();
+                const range = document.createRange();
+                range.selectNodeContents(n);
+                const lines = [...range.getClientRects()].map((r) => ({ left: r.left, bottom: r.bottom }));
+                const strokes = [...host.querySelectorAll(".tm-window, .hm-reveal")].map((w) => w.getBoundingClientRect()).map((r) => ({ left: r.left, top: r.top }));
+                return {
+                    textLines: lines.length, strokes: strokes.length,
+                    // each stroke against the line it was made for: its left end from the line's left, its top from the line's bottom
+                    worstLeftPx: +Math.max(...strokes.map((s, i) => (lines[i] ? Math.abs(s.left - lines[i].left) : Infinity))).toFixed(1),
+                    worstTopPx: +Math.max(...strokes.map((s, i) => (lines[i] ? Math.abs(s.top - lines[i].bottom) : Infinity))).toFixed(1),
+                };
+            });
+            await page.waitForTimeout(600);
+            const wide = await read();
+            await page.setViewportSize({ width: 340, height: 1400 });
+            await page.waitForTimeout(900);
+            const narrow = await read();
+            await shot(page, "wrap", `resize-${engine}-${impl}-340`);
+            record.resize.push({ impl, wide, narrow });
+        } finally {
+            await context.close();
+        }
+    }
+}
+
+const browser = await launch(engine);
+try {
+    if (want("rest")) await rest(browser);
+    if (want("draw")) await draw(browser);
+    if (want("fit")) await fit(browser);
+    if (want("still")) await still(browser);
+    if (want("resize")) await resize(browser);
+} finally {
+    await browser.close();
+}
+writeFileSync(join(out, `paint-${engine}${only ? "-" + only.replace(/,/g, "-") : ""}.json`), JSON.stringify(record, null, 2));
+console.log(`${engine}: fit rows ${record.fit.length}, draw ${record.draw.length}, still ${record.still.length}, errors ${record.errors.length}`);
