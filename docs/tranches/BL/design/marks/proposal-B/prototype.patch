+            onPresentClock: run.timing.every((t) => Math.abs(t.duration - run.presentDuration) < 0.5) && run.drawEasing === run.presentEasing,
+            presentDuration: run.presentDuration,
+            task: { ms: +run.taskMs.toFixed(1), readsInsideTask: run.readsInTask },
+            mainThreadClockInTask: { start: run.currentTimeAtTaskStart, end: run.currentTimeAtTaskEnd },
+            framesInsideTask: inTask.length, controlMovedInsideTask: controlMoved,
+            measurable: controlMoved && inTask.length > 0,
+            progressAtTaskStart: first ? +first.p.toFixed(3) : null,
+            progressInsideTask: inTask.map((s) => +s.p.toFixed(3)),
+            progressFirstFrameAfterTask: b ? +b.p.toFixed(3) : null,
+            rise: inTask.length ? +(last.p - first.p).toFixed(3) : 0,
+            drawnEvents: after.drawn,
+            wholeFromDrawnOn: c0 > 0 ? seq.slice(c0).every((s) => s.p >= 0.99) : null,
+            reads: after.reads,
+            progressAll: seq.slice(Math.max(0, before - 1)).map((s) => `${s.m}${s.p.toFixed(2)}`).join(" "),
