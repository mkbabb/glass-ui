+"""Contact sheets from the probe's cropped captures.  sheets.py <captures-dir> <engine>
+
+Each sheet stacks the cropped frames of one question so a reader opens one file:
+  sheets/<engine>-rest-<shape>-<theme>.png   every specimen at rest
+  sheets/<engine>-draw-<shape>-<spec>.png    three frames of the draw (10 %, 25 %, 50 % of the clock) and the rest frame
+  sheets/<engine>-before-after-<shape>.png   11.1.0's HandMark above this proposal, same specimens
+  sheets/<engine>-still.png                  reduced motion, print, forced colours, no script
+"""
+import sys
+from pathlib import Path
+from PIL import Image
+
+root, engine = Path(sys.argv[1]), sys.argv[2]
+png = root / engine / "png"
+out = root / "sheets"
+out.mkdir(exist_ok=True)
+
+
+def stack(names, dest, bg):
+    ims = [Image.open(png / f"{n}.png").convert("RGB") for n in names if (png / f"{n}.png").exists()]
+    if not ims:
+        return
+    w, h = max(i.width for i in ims), sum(i.height for i in ims)
+    sheet = Image.new("RGB", (w, h), bg)
+    y = 0
+    for i in ims:
+        sheet.paste(i, (0, y))
+        y += i.height
+    sheet.save(out / dest, optimize=True)
+
+
+SPECS = ["h48", "h85", "h112", "nest", "body", "wrap", "rtl"]
+for shape in ["underline", "highlight"]:
+    for theme, bg in [("light", "white"), ("dark", "black")]:
+        stack([f"rest-{engine}-{shape}-{theme}-{s}" for s in SPECS], f"{engine}-rest-{shape}-{theme}.png", bg)
+    for spec in ["h112", "body", "wrap", "rtl"]:
+        stack([f"draw-{engine}-{shape}-light-{spec}-{p}" for p in ["10", "25", "50"]] + [f"rest-{engine}-{shape}-light-{spec}"], f"{engine}-draw-{shape}-{spec}.png", "white")
+    stack([f"draw-{engine}-{shape}-dark-h112-{p}" for p in ["10", "25", "50"]] + [f"rest-{engine}-{shape}-dark-h112"], f"{engine}-draw-{shape}-h112-dark.png", "black")
+    pairs = []
+    for spec in ["h112", "body", "wrap"]:
+        pairs += [f"before-{engine}-{shape}-light-{spec}", f"rest-{engine}-{shape}-light-{spec}"]
+    stack(pairs, f"{engine}-before-after-{shape}.png", "white")
+stack(
+    [f"still-{engine}-{n}-{shape}-{spec}" for n in ["reduced-motion", "print", "forced-colors", "no-script"] for shape in ["underline", "highlight"] for spec in ["h85", "wrap"]],
+    f"{engine}-still.png",
+    "white",
+)
