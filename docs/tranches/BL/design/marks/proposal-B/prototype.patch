+@import "tailwindcss" source("../../../../../../../src");
+@import "tw-animate-css";
+@import "../../../../../../../src/styles/index.css";
+
+/* The brand face ships `font-display: optional`; the fixture needs it for certain, so it
+   declares the same file under its own name and waits for it before mounting. */
+@font-face {
+    font-family: "PJS Fixture";
+    font-style: normal;
+    font-weight: 200 800;
+    font-display: block;
+    src: url("../../../../../../../src/fonts/plus-jakarta-sans/plus-jakarta-sans-latin.woff2") format("woff2");
+}
+body { margin: 0; font-family: "PJS Fixture", "Plus Jakarta Sans", sans-serif; background: var(--background); color: var(--foreground); }
+.sheet { padding: 40px 48px; display: flex; flex-direction: column; gap: 36px; align-items: flex-start; }
+.sheet section { padding: 12px 16px 20px; }
+/* Gregg's headline: Plus Jakarta Sans 800, tight tracking and leading. */
+.head { margin: 0; font-family: "PJS Fixture", sans-serif; font-weight: 800; letter-spacing: -0.045em; line-height: 1.04; white-space: nowrap; }
+.tuck { margin-inline: -0.03em -0.02em; }
+.body { margin: 0; font-size: 18px; line-height: 1.5; font-weight: 400; max-width: 620px; }
+.wrap { margin: 0; font-size: 24px; line-height: 1.35; font-weight: 600; max-width: 360px; }
+.rtl { margin: 0; font-size: 28px; line-height: 1.6; font-weight: 500; }
+.stage { padding: 60px 48px; }
+.spring-probe { animation-duration: var(--spring-present-duration); animation-timing-function: var(--spring-present); position: absolute; opacity: 0; }
+
+/* Capture modes. hold: the draw is paused so the probe can seek it. */
+html[data-hold] :is(.tm-window, .tm-frame, .hm-reveal, .hm-mark) { animation-play-state: paused !important; }
+/* only=mark: the strokes alone. only=marked: the marked words alone. */
+html[data-only="mark"] .sheet { color: transparent; }
+html[data-only="marked"] .sheet { color: transparent; }
+html[data-only="marked"] :is(.tm, .hm) { color: #000; }
+html[data-only="marked"] :is(.tm-window, .hm-reveal) { visibility: hidden; }
+html[data-only] body { background: #fff; }
+html[data-only] :is(.tm, .hm) { --mark-ink: #000; --tm-band: #000 !important; --hm-band: #000 !important; }
+
+#pm { position: fixed; left: 0; top: 0; width: 20px; height: 20px; background: transparent; }
+#ctl { position: fixed; left: 30px; top: 0; width: 20px; height: 20px; background: rgb(255, 0, 255); animation: ctl 1s linear infinite; }
+@keyframes ctl { to { transform: translateX(200px); } }
diff --git a/docs/tranches/BL/design/marks/proposal-B/fixture/fixture.ts b/docs/tranches/BL/design/marks/proposal-B/fixture/fixture.ts
new file mode 100644
index 000000000..c1b0b391e
--- /dev/null
+++ b/docs/tranches/BL/design/marks/proposal-B/fixture/fixture.ts
@@ -0,0 +1,140 @@
+// Marks proposal B fixture. One page, chosen by ?scene=.
+//
+//   ?scene=sheet   every specimen at once: the comma headline at 48, 85 and 112 px, two
+//                  body phrases, a three-line run and an RTL run.
+//                  &shape=underline|highlight  &impl=new|old|css (old = 11.1.0's HandMark;
+//                  css = the no-script fallback: the bare element with the class)
+//                  &draw=none|mount|in-view    &hold=1 (the draw paused, for seeking)
+//                  &only=mark|marked           (ink-only renderings the probe measures)
+//   ?scene=draw    one mark, mounted on demand by `__mount()`, for the stall reading.
+//                  &case=h112|body|wrap
+import "./fixture.css";
+import { createApp, defineComponent, h, nextTick, ref, type Component } from "vue";
+import { TextMark } from "../../../../../../../src/components/text-mark";
+import { HandMark } from "../../../../../../../src/components/handmark";
+
+const q = new URLSearchParams(location.search);
+const scene = q.get("scene") ?? "sheet";
+const shape = (q.get("shape") ?? "underline") as "underline" | "highlight";
+const impl = q.get("impl") ?? "new";
+const draw = (q.get("draw") ?? "none") as "none" | "mount" | "in-view";
+document.documentElement.classList.toggle("dark", q.get("theme") === "dark");
+if (q.get("hold")) document.documentElement.dataset.hold = "1";
+if (q.get("only")) document.documentElement.dataset.only = q.get("only")!;
+const w = window as unknown as Record<string, any>;
+
+// ── the read ledger: every layout or style read, with the phase it happened in ────────
+const reads: Array<{ api: string; phase: string; t: number }> = [];
+w.__reads = reads;
+w.__phase = "idle";
+function tap(proto: any, name: string, label: string) {
+    const d = Object.getOwnPropertyDescriptor(proto, name);
+    if (!d) return;
+    const note = () => reads.push({ api: label, phase: w.__phase, t: performance.now() });
+    if (typeof d.value === "function")
+        Object.defineProperty(proto, name, { ...d, value(this: any, ...a: any[]) { note(); return d.value.apply(this, a); } });
+    else if (d.get) Object.defineProperty(proto, name, { ...d, get(this: any) { note(); return d.get!.call(this); } });
+}
+tap(Element.prototype, "getBoundingClientRect", "Element.getBoundingClientRect");
+tap(Element.prototype, "getClientRects", "Element.getClientRects");
+tap(Range.prototype, "getBoundingClientRect", "Range.getBoundingClientRect");
+tap(Range.prototype, "getClientRects", "Range.getClientRects");
+for (const k of ["offsetWidth", "offsetHeight", "offsetLeft", "offsetTop", "offsetParent"]) tap(HTMLElement.prototype, k, `HTMLElement.${k}`);
+for (const k of ["clientWidth", "clientHeight", "scrollWidth", "scrollHeight", "scrollTop", "scrollLeft"]) tap(Element.prototype, k, `Element.${k}`);
+tap(window, "getComputedStyle", "getComputedStyle");
+tap(CanvasRenderingContext2D.prototype, "measureText", "canvas.measureText");
+tap(CanvasRenderingContext2D.prototype, "getImageData", "canvas.getImageData");
+
+const drawn: number[] = [];
+w.__drawn = drawn;
+const pm = document.createElement("div");
+pm.id = "pm";
+document.body.appendChild(pm);
+w.__marker = (c: string) => (pm.style.background = c);
+document.addEventListener("animationstart", (e) => { if (/^(tm-window|hm-reveal)/.test(e.animationName) && w.__phase !== "done" && w.__phase !== "draw") { w.__phase = "draw"; performance.mark("tm-draw"); } }, true);
+function onDrawn() {
+    drawn.push(performance.now());
+    performance.mark("tm-drawn");
+    w.__phase = "done";
+    pm.style.background = "rgb(0, 200, 0)";
+}
+
+const Mark: Component = impl === "old" ? HandMark : TextMark;
+const mark = (text: string, probe: string, s = shape) =>
+    impl === "css"
+        ? // The no-script fallback: the bare element and the library's class, no component.
+          h(s === "highlight" ? "mark" : "span", { class: "tm", "data-probe": probe }, text)
+        : h(
+        Mark as any,
+        impl === "old"
+            ? { shape: s, draw: draw !== "none", trigger: draw === "in-view" ? "in-view" : "mount", "data-probe": probe, onDrawn }
+            : { shape: s, draw, "data-probe": probe, onDrawn },
+        () => text,
+    );
+
+const head = (px: number) =>
+    h("section", { "data-spec": `h${px}` }, [
+        h("h1", { class: "head", style: `font-size:${px}px` }, ["The Gregg Museum counted", h("br"), mark("4,485", `h${px}`), " visits"]),
+    ]);
+
+const Sheet = defineComponent(() => () =>
+    h("div", { class: "sheet" }, [
+        head(48),
+        head(85),
+        head(112),
+        // Gregg's own markup: the figure in a word span, its comma tucked by a negative margin.
+        h("section", { "data-spec": "nest" }, [
+            h("h1", { class: "head", style: "font-size:85px" }, [
+                h(
+                    impl === "css" ? (shape === "highlight" ? "mark" : "span") : (Mark as any),
+                    impl === "css" ? { class: "tm", "data-probe": "nest" } : impl === "old" ? { shape, draw: draw !== "none", "data-probe": "nest" } : { shape, draw, "data-probe": "nest" },
+                    impl === "css" ? [h("span", { class: "word" }, ["4", h("span", { class: "tuck" }, ","), "485"])] : () => h("span", { class: "word" }, ["4", h("span", { class: "tuck" }, ","), "485"]),
+                ),
+                " visits",
+            ]),
+        ]),
+        h("section", { "data-spec": "body" }, [
+            h("p", { class: "body" }, ["Most visitors came from ", mark("Wake County", "wake"), " and found the museum through ", mark("Google", "google"), ", then came back."]),
+        ]),
+        h("section", { "data-spec": "wrap" }, [
+            h("p", { class: "wrap" }, ["September drew ", mark("more visits than any other month, by a wide and growing margin", "wrap"), " over July."]),
+        ]),
+        h("section", { "data-spec": "rtl" }, [
+            h("p", { class: "rtl", dir: "rtl", lang: "ar" }, ["زار المتحف ", mark("أربعة آلاف وأربعمئة زائر", "rtl"), " هذا الخريف."]),
+        ]),
+    ]),
+);
+
+// ── draw scene ───────────────────────────────────────────────────────────────────────
+const mounted = ref(false);
+w.__mount = () => {
+    w.__phase = "mount";
+    performance.mark("tm-mount");
+    mounted.value = true;
+    // The mount task is this call plus the microtasks it queues: Vue's flush (render,
+    // mounted hooks) and whatever those queue. Once that has drained, the task is over.
+    void nextTick().then(() => queueMicrotask(() => { if (w.__phase === "mount") w.__phase = "post-mount"; }));
+};
+const which = q.get("case") ?? "h112";
+const Draw = defineComponent(() => () =>
+    h("div", { class: "stage" }, [
+        which === "h112"
+            ? h("h1", { class: "head", style: "font-size:112px", "data-probe": "line" }, [mounted.value ? mark("4,485", "mark") : "4,485", " visits"])
+            : which === "wrap"
+              ? h("p", { class: "wrap", "data-probe": "line" }, ["September drew ", mounted.value ? mark("more visits than any other month, by a wide and growing margin", "mark") : "more visits than any other month, by a wide and growing margin", " over July."])
+              : h("p", { class: "body", "data-probe": "line" }, ["Most visitors came from ", mounted.value ? mark("Wake County", "mark") : "Wake County", "."]),
+        h("span", { class: "spring-probe", "data-probe": "spring" }, "s"),
+    ]),
+);
+if (scene === "draw") {
+    const ctl = document.createElement("div");
+    ctl.id = "ctl";
+    document.body.appendChild(ctl);
+}
+
+const raf = window.requestAnimationFrame.bind(window);
+void Promise.all([document.fonts.load('800 48px "PJS Fixture"'), document.fonts.load('400 18px "PJS Fixture"')]).then(() => {
+    w.__face = document.fonts.check('800 48px "PJS Fixture"');
+    createApp(scene === "draw" ? Draw : Sheet).mount("#app");
+    raf(() => raf(() => (w.__ready = true)));
+});
