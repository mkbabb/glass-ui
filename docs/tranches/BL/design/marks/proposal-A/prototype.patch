+                    // line's own rows. A skipped or cleared descender leaves no such column.
+                    let m0 = Infinity, m1 = -1;
+                    for (let y = y0; y < y1 && y < png.height; y++) for (let x = lo; x <= hi; x++) { const k = (y * png.width + x) * 4; if (png.data[k] > 200 && png.data[k + 1] < 90 && png.data[k + 2] > 200) { m0 = Math.min(m0, y); m1 = Math.max(m1, y); } }
+                    let cross = 0;
+                    for (let x = lo; x <= hi; x++) {
+                        if (!cols[x]) continue;
+                        for (let y = m0; y <= m1; y++) { const k = (y * png.width + x) * 4; if (png.data[k] + png.data[k + 1] + png.data[k + 2] < 180) { cross++; break; } }
