+        { id: "glass-sheet-mid-line-Google", live: true, tag: "p", text: "Google", prefix: "Most visitors came from Wake County and found the museum through ", expect: 1 },
+        { id: "glass-sheet-line-start-Wake-County", live: true, tag: "p", text: "Wake County", prefix: "", expect: 1 },
+        { id: "glass-sheet-h1-85-4,485", live: true, tag: "h1", text: "4,485", prefix: "", size: 85, weight: 800, lh: 100, expect: 1 },
+        { id: "glass-sheet-22-through", live: true, tag: "p", text: "rose through", prefix: "Attendance ", size: 22, lh: 30, expect: 1 },
