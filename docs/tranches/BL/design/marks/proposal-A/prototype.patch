diff --git a/proto/marks-a/probe.mjs b/proto/marks-a/probe.mjs
new file mode 100644
index 000000000..729b63085
--- /dev/null
+++ b/proto/marks-a/probe.mjs
@@ -0,0 +1,555 @@
+// Proposal A probe: the typographic mark in paint.
+//
+//   node probe.mjs <chromium|webkit> <base-url> <out-dir> [modes]
+//
+// modes (comma list, default all): sheet, measure, reads, still, stall
+// One browser per run, a new context per cell, every context and the browser closed in
+// `finally`. Chromium is Playwright's headless shell; WebKit is build 2287 by path.
+import { chromium, webkit } from "playwright";
+import { createRequire } from "node:module";
+import { existsSync, mkdirSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const require = createRequire(import.meta.url);
+const { PNG, jpegjs } = require(join(dirname(require.resolve("playwright-core")), "lib/utilsBundle.js"));
+
+const [engine, base, outDir, modesArg = "sheet,measure,reads,still,stall"] = process.argv.slice(2);
+const modes = new Set(modesArg.split(","));
+const pngDir = join(outDir, "png");
+mkdirSync(pngDir, { recursive: true });
+const HERE = dirname(fileURLToPath(import.meta.url));
+
+const WEBKIT_2287 = join(homedir(), "Library/Caches/ms-playwright/webkit-2287/pw_run.sh");
+const launch = () =>
+    engine === "webkit" ? webkit.launch(existsSync(WEBKIT_2287) ? { executablePath: WEBKIT_2287 } : {}) : chromium.launch();
+
+const PATH = "/proto/marks-a/index.html";
+const ROWS = ["h48", "h85", "h112", "clear", "body", "wrap", "rtl", "nested"];
+const MARKS = 9;
+const out = { engine, base, version: null, cells: {} };
+
+async function open(browser, { query, theme = "light", width = 1000, height = 1300, dpr = 2, reducedMotion = "no-preference", media = "screen", forcedColors = "none", throttle = 0 }) {
+    const context = await browser.newContext({ viewport: { width, height }, deviceScaleFactor: dpr, colorScheme: theme, reducedMotion, forcedColors });
+    const page = await context.newPage();
+    const errors = [];
+    page.on("pageerror", (e) => errors.push(String(e)));
+    page.on("console", (m) => m.type() === "error" && errors.push(m.text()));
+    await page.emulateMedia({ media, reducedMotion, colorScheme: theme, forcedColors });
+    if (throttle && engine === "chromium") {
+        const cdp = await context.newCDPSession(page);
+        await cdp.send("Emulation.setCPUThrottlingRate", { rate: throttle });
+    }
+    await page.goto(`${base}${PATH}?${query}&theme=${theme}`, { waitUntil: "load" });
+    await page.waitForFunction(() => window.__ready === true, null, { timeout: 60_000 });
+    return { context, page, errors };
+}
+
+const rowClip = (page, row, pad = 10) =>
+    page.evaluate(({ row, pad }) => {
+        const r = document.querySelector(`[data-row="${row}"]`).getBoundingClientRect();
+        return { x: Math.max(0, Math.floor(r.left - pad)), y: Math.max(0, Math.floor(r.top - pad)), width: Math.ceil(r.width + 2 * pad), height: Math.ceil(r.height + 2 * pad) };
+    }, { row, pad });
+
+async function shot(page, clip) {
+    // Clipped inside the viewport. A full-page capture re-lays the page out, and in the trial
+    // run it came back with a different Arabic fallback face than the one the page was read in.
+    return PNG.sync.read(await page.screenshot({ clip }));
+}
+
+function stack(images, gap = 6, bg = [128, 128, 128]) {
+    const width = Math.max(...images.map((i) => i.width));
+    const height = images.reduce((s, i) => s + i.height, 0) + gap * (images.length - 1);
+    const png = new PNG({ width, height });
+    for (let i = 0; i < width * height; i++) png.data.set([...bg, 255], i * 4);
+    let y = 0;
+    for (const im of images) {
+        PNG.bitblt(im, png, 0, 0, im.width, im.height, 0, y);
+        y += im.height + gap;
+    }
+    return png;
+}
+
+function diff(a, b, threshold = 48) {
+    let n = 0, max = 0, x0 = Infinity, y0 = Infinity, x1 = -1, y1 = -1;
+    const len = Math.min(a.data.length, b.data.length);
+    for (let i = 0; i < len; i += 4) {
+        const d = Math.max(Math.abs(a.data[i] - b.data[i]), Math.abs(a.data[i + 1] - b.data[i + 1]), Math.abs(a.data[i + 2] - b.data[i + 2]));
+        if (d > max) max = d;
+        if (d > threshold) {
+            n++;
+            const x = (i / 4) % a.width, y = Math.floor(i / 4 / a.width);
+            x0 = Math.min(x0, x); y0 = Math.min(y0, y); x1 = Math.max(x1, x); y1 = Math.max(y1, y);
+        }
+    }
+    return { pixels: n, of: len / 4, maxChannelDelta: max, ...(n ? { box: { x: x0, y: y0, width: x1 - x0 + 1, height: y1 - y0 + 1 } } : {}) };
+}
+
+/** Seek every held draw to a share of its own whole (n lines × the clock). */
+const seek = (page, f) =>
+    page.evaluate((f) => {
+        const seen = [];
+        for (const host of document.querySelectorAll("[data-probe]")) {
+            const wins = host.querySelectorAll(".mark-line");
+            if (!wins.length) continue;
+            const anims = host.getAnimations({ subtree: true });
+            const dur = anims[0].effect.getComputedTiming().duration;
+            for (const a of anims) {
+                a.pause();
+                a.currentTime = f * wins.length * dur;
+            }
+            seen.push({ probe: host.dataset.probe, lines: wins.length, dur });
+        }
+        return seen;
+    }, f);
+
+// ── sheet: every row, three mid-draw frames and the rest, per theme and shape ─────────
+async function sheetCell(browser, theme, shape) {
+    const cell = `${theme}-${shape}`;
+    const { context, page, errors } = await open(browser, { query: `scene=sheet&shape=${shape}&hold=1`, theme });
+    try {
+        await page.waitForFunction((MARKS) => document.querySelectorAll('[data-probe][data-ink="draw"]').length >= MARKS, MARKS, { timeout: 20_000 });
+        const face = await page.evaluate(() => window.__face);
+        // What the draw animates, and on which clock: read off the held animations.
+        const clock = await page.evaluate(() => {
+            const anims = document.getAnimations().filter((a) => /^mark-/.test(a.animationName ?? ""));
+            const sp = getComputedStyle(document.querySelector('[data-probe="spring"]'));
+            const props = [...new Set(anims.flatMap((a) => a.effect.getKeyframes().flatMap((k) => Object.keys(k))))].filter((k) => !["offset", "computedOffset", "easing", "composite"].includes(k));
+            const easings = [...new Set(anims.map((a) => getComputedStyle(a.effect.target).animationTimingFunction))];
+            return {
+                animations: anims.length, names: [...new Set(anims.map((a) => a.animationName))], props,
+                durations: [...new Set(anims.map((a) => a.effect.getComputedTiming().duration))],
+                delays: [...new Set(anims.map((a) => a.effect.getComputedTiming().delay))].sort((x, y) => x - y),
+                easingIsPresent: easings.length === 1 && easings[0] === sp.animationTimingFunction,
+                presentDuration: sp.animationDuration,
+            };
+        });
+        const clips = {};
+        for (const row of ROWS) clips[row] = await rowClip(page, row);
+        const frames = Object.fromEntries(ROWS.map((r) => [r, []]));
+        let held = null;
+        for (const f of [0.25, 0.5, 0.75]) {
+            held = await seek(page, f);
+            await page.waitForTimeout(120);
+            for (const row of ROWS) frames[row].push(await shot(page, clips[row]));
+        }
+        // Landed: every copy at its final frame, still in place. Dropping the animation is the
+        // `to` keyframe exactly (no transform), and fires no `animationend`.
+        await page.evaluate(() => {
+            const s = document.createElement("style");
+            s.id = "landed";
+            s.textContent = ".mark-line, .mark-slide { animation-name: none !important; }";
+            document.head.appendChild(s);
+        });
+        await page.waitForTimeout(120);
+        const landed = {};
+        for (const row of ROWS) landed[row] = await shot(page, clips[row]);
+        // Let go: the draws finish, the copies leave, the stylesheet's own mark stands.
+        await page.evaluate(() => {
+            document.getElementById("landed").remove();
+            document.getElementById("hold").remove();
+        });
+        await page.waitForFunction((MARKS) => document.querySelectorAll('[data-probe][data-ink="rest"]').length >= MARKS && window.__draw.drawn.length >= MARKS, MARKS, { timeout: 20_000 });
+        await page.waitForTimeout(200);
+        const swap = {};
+        for (const row of ROWS) {
+            const rest = await shot(page, clips[row]);
+            swap[row] = diff(landed[row], rest);
+            writeFileSync(join(pngDir, `${engine}-${cell}-${row}.png`), PNG.sync.write(stack([...frames[row], rest])));
+            writeFileSync(join(pngDir, `${engine}-${cell}-${row}-rest.png`), PNG.sync.write(rest));
+            if (swap[row].pixels) writeFileSync(join(pngDir, `${engine}-${cell}-${row}-landed.png`), PNG.sync.write(landed[row]));
+        }
+        const plain = await shot(page, await rowClip(page, "plain"));
+        writeFileSync(join(pngDir, `${engine}-${cell}-plain-rest.png`), PNG.sync.write(plain));
+        const left = await page.evaluate(() => ({
+            copies: document.querySelectorAll(".mark-line").length,
+            layers: document.querySelectorAll(".mark-layer").length,
+            drawn: window.__draw.drawn.length,
+        }));
+        out.cells[`sheet-${cell}`] = { face, clock, held, swapLandedVsRest: swap, atRest: left, errors };
+    } finally {
+        await context.close();
+    }
+}
+
+// ── measure: where the ink sits against the run and the font, read off magenta paint ──
+async function measureCell(browser, shape) {
+    const { context, page, errors } = await open(browser, { query: `scene=sheet&shape=${shape}&probeink=1` });
+    try {
+        await page.waitForFunction((MARKS) => window.__draw.drawn.length >= MARKS, MARKS, { timeout: 20_000 });
+        await page.waitForTimeout(200);
+        const marks = await page.evaluate(() => {
+            const cv = document.createElement("canvas").getContext("2d");
+            return [...document.querySelectorAll("[data-probe]")].filter((el) => el.dataset.probe !== "spring").map((el) => {
+                const cs = getComputedStyle(el);
+                const fs = parseFloat(cs.fontSize);
+                // The first line's baseline: a zero-size inline-block sits on it. It is removed
+                // before the lines are read; later lines are placed by the line pitch.
+                const strut = document.createElement("span");
+                strut.style.cssText = "display:inline-block;width:0;height:0;vertical-align:baseline";
+                el.parentNode.insertBefore(strut, el);
+                const base0 = strut.getBoundingClientRect().top;
+                strut.remove();
+                const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+                const range = document.createRange();
+                const lines = [];
+                for (let n = walk.nextNode(); n; n = walk.nextNode()) {
+                    range.selectNodeContents(n);
+                    for (const r of range.getClientRects()) {
+                        if (r.width <= 0) continue;
+                        const row = lines.find((q) => Math.abs(q.top - r.top) < r.height / 2);
+                        if (row) { row.left = Math.min(row.left, r.left); row.right = Math.max(row.right, r.right); }
+                        else lines.push({ left: r.left, right: r.right, top: r.top, bottom: r.bottom });
+                    }
+                }
+
+                cv.font = `${cs.fontStyle} ${cs.fontWeight} ${fs}px ${cs.fontFamily}`;
+                const m = (s) => cv.measureText(s);
+                const text = el.textContent;
+                const box = el.getBoundingClientRect();
+                return {
+                    probe: el.dataset.probe, fs, text, dir: cs.direction,
+                    lines: lines.sort((a, b) => a.top - b.top).map((l) => ({ ...l, top: l.top + scrollY, bottom: l.bottom + scrollY })),
+                    baseline0: base0 + scrollY,
+                    xHeight: m("x").actualBoundingBoxAscent,
+                    descent: Math.max(...[...text].map((c) => m(c).actualBoundingBoxDescent)),
+                    clip: { x: Math.max(0, Math.floor(box.left - 40)), y: Math.max(0, Math.floor(box.top + scrollY - 20)), width: Math.ceil(box.width + 80), height: Math.ceil(box.height + 40) },
+                    decoration: { line: cs.textDecorationLine, thickness: cs.textDecorationThickness, offset: cs.textUnderlineOffset, skip: cs.textDecorationSkipInk },
+                };
+            });
+        });
+        const rows = [];
+        for (const mk of marks) {
+            const img = await shot(page, mk.clip);
+            const s = img.width / mk.clip.width;
+            const isInk = (x, y) => {
+                const i = (y * img.width + x) * 4;
+                return img.data[i] > 200 && img.data[i + 1] < 90 && img.data[i + 2] > 200;
+            };
+            const perLine = mk.lines.map((ln, k) => {
+                // The band of rows that belongs to this line: its own rect, opened by a third of an em.
+                const y0 = Math.max(0, Math.round((ln.top - mk.clip.y - mk.fs * 0.1) * s));
+                const y1 = Math.min(img.height - 1, Math.round((ln.bottom - mk.clip.y + mk.fs * 0.35) * s));
+                let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
+                const cols = new Uint8Array(img.width);
+                for (let y = y0; y <= y1; y++)
+                    for (let x = 0; x < img.width; x++)
+                        if (isInk(x, y)) { minX = Math.min(minX, x); maxX = Math.max(maxX, x); minY = Math.min(minY, y); maxY = Math.max(maxY, y); cols[x] = 1; }
+                if (minX === Infinity) return { line: k, ink: null };
+                const gaps = [];
+                for (let x = minX, open = -1; x <= maxX + 1; x++) {
+                    if (x <= maxX && !cols[x]) { if (open < 0) open = x; }
+                    else if (open >= 0) { gaps.push({ from: +(open / s + mk.clip.x).toFixed(1), width: +((x - open) / s).toFixed(1) }); open = -1; }
+                }
+                const px = (v) => +v.toFixed(2);
+                const inkLeft = minX / s + mk.clip.x, inkRight = (maxX + 1) / s + mk.clip.x;
+                const inkTop = minY / s + mk.clip.y, inkBottom = (maxY + 1) / s + mk.clip.y;
+                // Line k's baseline: the first line's, plus the pitch between line tops.
+                const baseline = mk.baseline0 + (ln.top - mk.lines[0].top);
+                return {
+                    line: k,
+                    run: { left: px(ln.left), right: px(ln.right) },
+                    ink: { left: px(inkLeft), right: px(inkRight), top: px(inkTop), bottom: px(inkBottom) },
+                    pastStart: px(ln.left - inkLeft), pastEnd: px(inkRight - ln.right),
+                    thickness: px(inkBottom - inkTop), thicknessEm: +((inkBottom - inkTop) / mk.fs).toFixed(3),
+                    topBelowBaseline: px(inkTop - baseline), topBelowBaselineEm: +((inkTop - baseline) / mk.fs).toFixed(3),
+                    bottomBelowBaseline: px(inkBottom - baseline), bottomBelowBaselineEm: +((inkBottom - baseline) / mk.fs).toFixed(3),
+                    gaps,
+                };
+            });
+            rows.push({ probe: mk.probe, text: mk.text, fs: mk.fs, dir: mk.dir, xHeightEm: +(mk.xHeight / mk.fs).toFixed(3), deepestDescentEm: +(mk.descent / mk.fs).toFixed(3), decoration: mk.decoration, lines: perLine });
+            writeFileSync(join(pngDir, `${engine}-measure-${shape}-${mk.probe}.png`), PNG.sync.write(img));
+        }
+        out.cells[`measure-${shape}`] = { marks: rows, errors };
+    } finally {
+        await context.close();
+    }
+}
+
+// ── reads: no layout read in the mount task, none per frame of the draw ───────────────
+async function readsCell(browser, shape) {
+    const { context, page, errors } = await open(browser, { query: `scene=sheet&shape=${shape}` });
+    try {
+        await page.waitForFunction((MARKS) => window.__draw.drawn.length >= MARKS, MARKS, { timeout: 20_000 });
+        const r = await page.evaluate(() => {
+            const d = window.__draw, reads = window.__reads;
+            const tally = (list) => list.reduce((m, x) => ((m[x.api] = (m[x.api] ?? 0) + 1), m), {});
+            const lastDrawn = Math.max(...d.drawn);
+            return {
+                draw: { start: d.start, landed: d.landed, drawn: d.drawn, started: d.started, ended: d.ended },
+                inMountTask: tally(reads.filter((x) => x.phase === "mount")),
+                beforeFirstDrawFrame: tally(reads.filter((x) => x.phase !== "mount" && x.phase !== "load" && x.t <= d.start)),
+                duringDraw: tally(reads.filter((x) => x.t > d.start && x.t < d.landed)),
+                landedToDrawn: tally(reads.filter((x) => x.t >= d.landed && x.t <= lastDrawn)),
+                total: reads.length,
+            };
+        });
+        out.cells[`reads-${shape}`] = { ...r, errors };
+    } finally {
+        await context.close();
+    }
+}
+
+// ── still: reduced motion, print, forced colours, no script ───────────────────────────
+async function stillCell(browser, mode, shape) {
+    const opts = mode === "reduced-motion" ? { reducedMotion: "reduce" } : mode === "print" ? { media: "print" } : { forcedColors: "active" };
+    const { context, page, errors } = await open(browser, { query: `scene=sheet&shape=${shape}`, ...opts });
+    try {
+        const frame0 = await page.evaluate(() => ({
+            ink: [...document.querySelectorAll("[data-probe]")].filter((e) => e.dataset.probe !== "spring").map((e) => e.dataset.ink),
+            copies: document.querySelectorAll(".mark-line").length,
+            running: document.getAnimations().filter((a) => /^mark-/.test(a.animationName ?? "")).length,
+            decoration: [...document.querySelectorAll('[data-probe="h85"], [data-probe="google"]')].map((e) => {
+                const cs = getComputedStyle(e);
+                return { line: cs.textDecorationLine, color: cs.textDecorationColor, background: cs.backgroundColor, text: cs.color };
+            }),
+        }));
+        await page.waitForTimeout(400);
+        const drawn = await page.evaluate(() => window.__draw.drawn.length);
+        const imgs = [];
+        for (const row of ["h85", "body", "wrap"]) imgs.push(await shot(page, await rowClip(page, row)));
+        writeFileSync(join(pngDir, `${engine}-${mode}-${shape}.png`), PNG.sync.write(stack(imgs)));
+        out.cells[`still-${mode}-${shape}`] = { frame0, drawn, errors };
+    } finally {
+        await context.close();
+    }
+}
+
+async function noScriptCell(browser, theme) {
+    const context = await browser.newContext({ viewport: { width: 1000, height: 700 }, deviceScaleFactor: 2, colorScheme: theme, javaScriptEnabled: false });
+    try {
+        const page = await context.newPage();
+        await page.goto(pathToFileURL(join(HERE, "static.html")).href, { waitUntil: "load" });
+        await page.waitForTimeout(300);
+        writeFileSync(join(pngDir, `${engine}-noscript-${theme}.png`), await page.screenshot({ clip: { x: 0, y: 0, width: 700, height: 640 } }));
+        await page.emulateMedia({ media: "print" });
+        writeFileSync(join(pngDir, `${engine}-noscript-print-${theme}.png`), await page.screenshot({ clip: { x: 0, y: 0, width: 700, height: 640 } }));
+        out.cells[`noscript-${theme}`] = { script: false, url: "static.html (file://)" };
+    } finally {
+        await context.close();
+    }
+}
+
+// ── stall: the draw keeps painting through a 50 ms main-thread task at a 4× throttle ──
+function decode(frame) {
+    const img = jpegjs.decode(frame.data, { useTArray: true });
+    return { width: img.width, height: img.height, data: img.data, scale: img.width / frame.viewportWidth };
+}
+function crop(img, r) {
+    const s = img.scale;
+    const x0 = Math.round(r.x * s), y0 = Math.round(r.y * s);
+    const w = Math.min(img.width - x0, Math.round(r.width * s)), h = Math.min(img.height - y0, Math.round(r.height * s));
+    const png = new PNG({ width: w, height: h });
+    for (let y = 0; y < h; y++)
+        for (let x = 0; x < w; x++) {
+            const i = ((y0 + y) * img.width + x0 + x) * 4, o = (y * w + x) * 4;
+            png.data[o] = img.data[i]; png.data[o + 1] = img.data[i + 1]; png.data[o + 2] = img.data[i + 2]; png.data[o + 3] = 255;
+        }
+    return png;
+}
+function markerOf(img) {
+    const s = img.scale, i = (Math.round(10 * s) * img.width + Math.round(10 * s)) * 4;
+    const [r, g, b] = [img.data[i], img.data[i + 1], img.data[i + 2]];
+    if (r > 180 && g < 90 && b < 90) return "A";
+    if (b > 180 && r < 90 && g < 90) return "B";
+    if (g > 140 && r < 90 && b < 90) return "C";
+    return "-";
+}
+
+async function stallCell(browser, theme, shape, taskMs = 50) {
+    const cell = `${theme}-${shape}`;
+    const W = 800, H = 400;
+    const { context, page, errors } = await open(browser, { query: `scene=stall&shape=${shape}`, theme, width: W, height: H, dpr: 1, throttle: 4 });
+    const frames = [];
+    let trace = null;
+    try {
+        if (engine === "chromium") await browser.startTracing(page, { categories: ["devtools.timeline", "blink.user_timing", "disabled-by-default-devtools.timeline.frame"] });
+        await page.screencast.start({ onFrame: (f) => frames.push({ ts: f.timestamp, data: f.data, viewportWidth: f.viewportWidth }), size: { width: W, height: H }, quality: 90 });
+        await page.waitForTimeout(400);
+        const before = frames.length;
+        // The page does nothing but mount, wait 40 ms into the draw, and block: no polling and
+        // no reads, so the trace of the draw window holds the draw's own cost and the task.
+        const run = await page.evaluate((TASK) => new Promise((done) => {
+            document.addEventListener("animationstart", function on(e) {
+                if (e.animationName !== "mark-window") return;
+                document.removeEventListener("animationstart", on, true);
+                setTimeout(() => requestAnimationFrame(() => {
+                    // Marker A paints in this frame, the last before the task. The task runs as
+                    // the next task and sets marker B first, which can only paint once it ends.
+                    window.__marker("rgb(255, 0, 0)");
+                    setTimeout(() => {
+                        window.__marker("rgb(0, 0, 255)");
+                        const t0 = performance.now();
+                        performance.mark("task-start");
+                        while (performance.now() - t0 < TASK) { /* the injected main-thread task */ }
+                        performance.mark("task-end");
+                        const t1 = performance.now();
+                        setTimeout(() => {
+                            const d = window.__draw;
+                            done({
+                                taskMs: +(t1 - t0).toFixed(1), taskAt: +(t0 - d.start).toFixed(1),
+                                draw: { wallMs: +(d.landed - d.start).toFixed(1), landedToDrawnMs: +(d.drawn[0] - d.landed).toFixed(1), drawn: d.drawn.length },
+                                readsDuringDraw: window.__reads.filter((x) => x.t > d.start && x.t < d.landed).length,
+                                readsInMountTask: window.__reads.filter((x) => x.phase === "mount").length,
+                                readsBeforeDraw: window.__reads.filter((x) => x.phase !== "mount" && x.t <= d.start).map((x) => x.api),
+                            });
+                        }, 900);
+                    }, 0);
+                }), 40);
+            }, true);
+            window.__mount();
+        }), taskMs);
+        await page.waitForTimeout(300);
+        await page.screencast.stop();
+        if (engine === "chromium") trace = JSON.parse((await browser.stopTracing()).toString());
+        const region = await page.evaluate(() => {
+            const r = document.querySelector('[data-probe="mark"]').getBoundingClientRect();
+            return { x: Math.floor(r.left - 8), y: Math.floor(r.top - 4), width: Math.ceil(r.width + 16), height: Math.ceil(r.height + 20) };
+        });
+        const refCrop = crop(decode(frames[Math.max(0, before - 1)]), region);
+        const fin = crop(decode(frames[frames.length - 1]), region);
+        const full = diff(fin, refCrop).pixels || 1;
+        const CTL = { x: 30, y: 0, width: 220, height: 20 };
+        const seq = frames.map((f, i) => {
+            const img = decode(f);
+            const c = crop(img, region);
+            return { i, ts: f.ts, m: markerOf(img), p: diff(c, refCrop).pixels / full, c, ctl: crop(img, CTL) };
+        });
+        const aFrames = seq.filter((s) => s.m === "A");
+        const inTask = aFrames.slice(1);
+        const first = aFrames[0], last = aFrames[aFrames.length - 1];
+        const controlMoved = first ? inTask.some((s) => diff(s.ctl, first.ctl).pixels > 20) : false;
+        const afterTask = seq.find((s) => s.m === "B");
+        const strip = [first, ...inTask, afterTask].filter(Boolean);
+        if (strip.length) writeFileSync(join(pngDir, `${engine}-stall-${cell}.png`), PNG.sync.write(stack(strip.map((s) => s.c), 3)));
+        // Frames the reader got across the whole draw: from the first frame with ink to the first whole one.
+        const i0 = seq.findIndex((s, k) => k >= before && s.p > 0.01);
+        const i1 = seq.findIndex((s, k) => k >= before && s.p >= 0.99);
+        const drawFrames = i0 >= 0 && i1 >= 0 ? seq.slice(i0, i1 + 1) : [];
+        const gaps = drawFrames.slice(1).map((s, k) => +((s.ts - drawFrames[k].ts) * (s.ts > 1e6 ? 1 : 1000)).toFixed(1));
+
+        let traced = null;
+        if (trace) {
+            const ev = trace.traceEvents ?? trace;
+            const at = (name) => ev.filter((e) => e.name === name && e.cat?.includes("blink.user_timing")).map((e) => e.ts);
+            const start = Math.min(...at("mark-draw-start")), landed = Math.max(...at("mark-line-landed")), drawn = Math.max(...at("mark-drawn"));
+            const mainTid = ev.find((e) => e.name === "mark-draw-start")?.tid;
+            const tally = (lo, hi) => {
+                const m = {};
+                for (const e of ev) {
+                    if (e.ph !== "X" || e.ts < lo || e.ts >= hi) continue;
+                    if (!["Layout", "UpdateLayoutTree", "PrePaint", "Paint", "Layerize", "Commit", "FunctionCall", "FireAnimationFrame", "EventDispatch", "TimerFire", "RunTask", "ParseHTML", "HitTest"].includes(e.name)) continue;
+                    if (e.tid !== mainTid) continue;
+                    const k = (m[e.name] ??= { count: 0, ms: 0 });
+                    k.count++;
+                    k.ms = +(k.ms + (e.dur ?? 0) / 1000).toFixed(2);
+                }
+                return m;
+            };
+            const frameEvents = (lo, hi) => {
+                const m = {};
+                for (const e of ev) if (e.ts >= lo && e.ts < hi && ["DrawFrame", "BeginFrame", "ActivateLayerTree", "BeginMainThreadFrame", "NeedsBeginFrameChanged"].includes(e.name)) m[e.name] = (m[e.name] ?? 0) + 1;
+                return m;
+            };
+            traced = {
+                drawMs: +((landed - start) / 1000).toFixed(1), landedToDrawnMs: +((drawn - landed) / 1000).toFixed(1),
+                mainThreadDuringDraw: tally(start, landed), frameEventsDuringDraw: frameEvents(start, landed),
+                mainThreadLandedToDrawn: tally(landed, drawn),
+            };
+        }
+        out.cells[`stall-${cell}`] = {
+            throttle: engine === "chromium" ? 4 : null, run, region,
+            framesInTask: inTask.length, controlMoved,
+            progressAtTaskStart: first ? +first.p.toFixed(3) : null,
+            progressInTask: inTask.map((s) => +s.p.toFixed(3)),
+            progressFirstFrameAfterTask: afterTask ? +afterTask.p.toFixed(3) : null,
+            rise: inTask.length ? +(last.p - first.p).toFixed(3) : 0,
+            screencastFramesAcrossDraw: drawFrames.length, screencastFrameGapsMs: gaps,
+            progressAcrossDraw: drawFrames.map((s) => +s.p.toFixed(3)),
+            drawnMarkerSeen: seq.some((s) => s.m === "C"),
+            progressFromDrawnOn: seq.filter((s) => s.m === "C").map((s) => +s.p.toFixed(3)),
+            trace: traced, errors,
+        };
+    } finally {
+        await context.close();
+    }
+}
+
+// ── cycle: a mark below the fold waits; retrigger redraws; play() redraws ─────────────
+async function cycleCell(browser, shape) {
+    const state = (page) => page.evaluate(() => ({
+        ink: document.querySelector('[data-probe="mark"]').dataset.ink,
+        drawn: window.__draw.drawn.length, started: window.__draw.started,
+        copies: document.querySelectorAll(".mark-line").length,
+    }));
+    const settle = (page, n) => page.waitForFunction((n) => window.__draw.drawn.length >= n, n, { timeout: 10_000 });
+    const res = {};
+    {
+        const { context, page, errors } = await open(browser, { query: `scene=stall&shape=${shape}&fold=1`, width: 800, height: 400, dpr: 1 });
+        try {
+            await page.evaluate(() => window.__mount());
+            await page.waitForTimeout(700);
+            res.belowFoldAfter700ms = await state(page);
+            await page.evaluate(() => document.querySelector('[data-probe="mark"]').scrollIntoView({ block: "center" }));
+            await settle(page, 1);
+            await page.waitForTimeout(100);
+            res.afterScrollTo = await state(page);
+            res.errors = errors;
+        } finally {
+            await context.close();
+        }
+    }
+    {
+        const { context, page, errors } = await open(browser, { query: `scene=stall&shape=${shape}&retrigger=1`, width: 800, height: 400, dpr: 1 });
+        try {
+            await page.evaluate(() => window.__mount());
+            await settle(page, 1);
+            await page.waitForTimeout(100);
+            res.retriggerFirst = await state(page);
+            await page.evaluate(() => scrollTo(0, 700));
+            await page.waitForTimeout(400);
+            res.retriggerScrolledAway = await state(page);
+            await page.evaluate(() => scrollTo(0, 0));
+            await settle(page, 2);
+            await page.waitForTimeout(100);
+            res.retriggerBack = await state(page);
+            await page.evaluate(() => window.__play());
+            await settle(page, 3);
+            await page.waitForTimeout(100);
+            res.afterPlay = await state(page);
+            res.errors2 = errors;
+        } finally {
+            await context.close();
+        }
+    }
+    out.cells[`cycle-${shape}`] = res;
+}
+
+const browser = await launch();
+out.version = browser.version();
+let code = 0;
+try {
+    if (modes.has("sheet")) for (const theme of ["light", "dark"]) for (const shape of ["underline", "highlight"]) await sheetCell(browser, theme, shape);
+    if (modes.has("measure")) for (const shape of ["underline", "highlight"]) await measureCell(browser, shape);
+    if (modes.has("reads")) for (const shape of ["underline", "highlight"]) await readsCell(browser, shape);
+    if (modes.has("still")) {
+        for (const shape of ["underline", "highlight"]) {
+            await stillCell(browser, "reduced-motion", shape);
+            await stillCell(browser, "print", shape);
+            if (engine === "chromium") await stillCell(browser, "forced-colors", shape);
+        }
+        for (const theme of ["light", "dark"]) await noScriptCell(browser, theme);
+    }
+    if (modes.has("cycle")) for (const shape of ["underline", "highlight"]) await cycleCell(browser, shape);
+    if (modes.has("stall")) for (const theme of ["light", "dark"]) for (const shape of ["underline", "highlight"]) await stallCell(browser, theme, shape);
+} catch (e) {
+    code = 1;
+    out.error = String(e?.stack ?? e);
+    console.error(e);
+} finally {
+    await browser.close();
+    writeFileSync(join(outDir, `${engine}-${[...modes].join("+")}.json`), JSON.stringify(out, null, 1));
+}
+console.log(`${engine} ${[...modes].join(",")} exit ${code}`);
+process.exit(code);
diff --git a/proto/marks-a/run.sh b/proto/marks-a/run.sh
new file mode 100755
index 000000000..6e5c226df
--- /dev/null
+++ b/proto/marks-a/run.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# One guarded browser run: serve the worktree with vite on <port>, run probe.mjs and then
+# skip.mjs in <engine> (one browser each, one after the other), and stop the server.
+#   run.sh <port> <engine> <out-dir> [modes]
+set -u
+PORT=$1; ENGINE=$2; OUT=$3; MODES=${4:-sheet,measure,reads,still,stall}
+HERE=$(cd "$(dirname "$0")" && pwd)
+TREE=$(cd "$HERE/../.." && pwd)
+mkdir -p "$OUT"
+( cd "$TREE" && exec npx vite --host 127.0.0.1 --port "$PORT" --strictPort ) > "$OUT/$ENGINE-server.log" 2>&1 &
+SRV=$!
+trap 'kill $SRV 2>/dev/null; wait $SRV 2>/dev/null' EXIT
+for i in $(seq 1 90); do
+  curl -sf "http://127.0.0.1:$PORT/proto/marks-a/index.html" > /dev/null && break
+  kill -0 $SRV 2>/dev/null || { echo "server exited early"; exit 3; }
+  sleep 2
+done
+RC=0
+if [ "$MODES" != "skip-only" ]; then cd "$HERE" && node "$HERE/probe.mjs" "$ENGINE" "http://127.0.0.1:$PORT" "$OUT" "$MODES"; RC=$?; fi
+# The skip-ink sweep, on the same server (its glass-sheet rows are the fixture page).
+if [ "${SKIP:-1}" = "1" ]; then node "$HERE/skip.mjs" "$ENGINE" "$OUT" "http://127.0.0.1:$PORT" > "$OUT/$ENGINE-skip.txt" 2>&1 || RC=$?; fi
+exit $RC
