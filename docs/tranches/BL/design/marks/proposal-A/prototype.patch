+@import "tailwindcss" source("../../src");
+@import "tw-animate-css";
+@import "../../src/styles/index.css";
+
+body { margin: 0; background: var(--background); color: var(--foreground); font-family: "Plus Jakarta Sans", system-ui, sans-serif; }
+.sheet { padding: 40px 32px 80px; display: flex; flex-direction: column; gap: 36px; align-items: flex-start; }
+.sheet h1 { margin: 0; font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; white-space: nowrap; }
+.sheet p { margin: 0; font-size: 16px; line-height: 1.5; }
+.sheet .wrap { font-size: 22px; line-height: 1.35; inline-size: 300px; }
+.sheet .rtl { font-size: 24px; line-height: 1.6; inline-size: 300px; }
+.sheet .nested { font-size: 22px; line-height: 1.35; inline-size: 300px; }
+.spring-probe { position: fixed; left: -99px; animation-duration: var(--spring-present-duration); animation-timing-function: var(--spring-present); }
+#pm { position: fixed; left: 0; top: 0; width: 20px; height: 20px; background: transparent; }
+/* The instrument control: a plain composited transform animation, always running. */
+#ctl { position: fixed; left: 30px; top: 0; width: 20px; height: 20px; background: rgb(255, 0, 255); animation: ctl 1s linear infinite; }
+@keyframes ctl { to { transform: translateX(200px); } }
diff --git a/proto/marks-a/fixture.ts b/proto/marks-a/fixture.ts
