+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8" />
+  <title>Skip-ink by sub-pixel position</title>
+  <!-- Does the engine's skip-ink hold at every sub-pixel line position? Each row sits an
+       sixty-fourth of a pixel lower than the last. No script. -->
+  <style>
+    @font-face { font-family: "Plus Jakarta Sans"; font-weight: 200 800; src: url("../../src/fonts/plus-jakarta-sans/plus-jakarta-sans-latin.woff2") format("woff2"); }
+    :root { --primary: #ff00ff; }
+    body { margin: 0; padding: 20px; background: #fff; color: #111; font-family: "Plus Jakarta Sans", sans-serif; }
+    p { margin: 0; font-size: 16px; line-height: 24px; white-space: nowrap; }
+    h1 { margin: 0; font-size: 85px; font-weight: 800; line-height: 100px; white-space: nowrap; }
+    .step { height: 0.015625px; }
+  </style>
+  <link rel="stylesheet" href="../../src/components/mark/mark.css" />
+</head>
+<body></body>
+</html>
diff --git a/proto/marks-a/skip.mjs b/proto/marks-a/skip.mjs
new file mode 100644
index 000000000..653fead1d
--- /dev/null
+++ b/proto/marks-a/skip.mjs
@@ -0,0 +1,109 @@
+// How often does the engine's own skip-ink open a gap at a descender, across sub-pixel
+// line positions? 64 rows per case, each 1/64 px lower than the last, read off magenta paint.
+//   node skip.mjs <chromium|webkit> <out-dir>
+import { chromium, webkit } from "playwright";
+import { createRequire } from "node:module";
+import { existsSync, readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { homedir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+const require = createRequire(import.meta.url);
+const { PNG } = require(join(dirname(require.resolve("playwright-core")), "lib/utilsBundle.js"));
+const [engine, outDir, base = ""] = process.argv.slice(2);
+mkdirSync(join(outDir, "png"), { recursive: true });
+const HERE = dirname(fileURLToPath(import.meta.url));
+const WEBKIT_2287 = join(homedir(), "Library/Caches/ms-playwright/webkit-2287/pw_run.sh");
+const browser = await (engine === "webkit" ? webkit.launch(existsSync(WEBKIT_2287) ? { executablePath: WEBKIT_2287 } : {}) : chromium.launch());
+const out = { engine, version: browser.version(), cells: {} };
+const N = 64;
+const STEP = 1 / 64;
+const html = readFileSync(join(HERE, "skip.html"), "utf8");
+const body = (tag, text, style = "", attrs = "", prefix = "") => Array.from({ length: N }, (_, i) => `<div class="step"></div><${tag} data-i="${i}" style="${style}">${prefix}<span class="mark-underline"${attrs}>${text}</span></${tag}>`).join("");
+const CASES = [
+    { id: "body-16-Wake-County", tag: "p", text: "Wake County", expect: 1 },
+    { id: "body-16-Google", tag: "p", text: "Google", expect: 1 },
+    { id: "h1-85-4,485", tag: "h1", text: "4,485", expect: 1 },
+    { id: "body-16-Wake-County-offset-0.3em", tag: "p", text: "Wake County", style: "--mark-offset:0.3em", expect: 0 },
+    { id: "body-16-mid-line-Wake-County", tag: "p", text: "Wake County", prefix: "Most visitors came from ", expect: 1 },
+    { id: "body-16-mid-line-Google", tag: "p", text: "Google", prefix: "Most visitors came from Wake County and found the museum through ", expect: 1 },
+    // The same rows inside glass's own stylesheet (the fixture page; needs the dev server).
