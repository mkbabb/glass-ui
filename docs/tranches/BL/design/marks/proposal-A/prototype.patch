index 000000000..75a622be4
--- /dev/null
+++ b/proto/marks-a/fixture.ts
@@ -0,0 +1,156 @@
+// The Mark fixture. One page, chosen by the query:
+//   ?scene=sheet&shape=underline|highlight&theme=light|dark[&hold=1][&probeink=1]
+//       every row the brief names. `hold` starts every draw paused at its first frame, so
+//       a probe can seek it; `probeink` paints the mark pure magenta so a probe can find it.
+//   ?scene=stall&shape=...   one 85 px headline mark, mounted on demand by `__mount()`.
+const w = window as unknown as Record<string, any>;
+
+// Layout reads, counted at the platform: every geometry call any script makes.
+const reads: { api: string; t: number; phase: string }[] = [];
+w.__reads = reads;
+w.__phase = "load";
+const count = (api: string) => reads.push({ api, t: performance.now(), phase: w.__phase });
+function wrapFn(proto: any, name: string, label: string) {
+    const orig = proto[name];
+    proto[name] = function (...args: unknown[]) {
+        count(label);
+        return orig.apply(this, args);
+    };
+}
+function wrapGet(proto: any, name: string, label: string) {
+    const d = Object.getOwnPropertyDescriptor(proto, name);
+    if (!d?.get) return;
+    Object.defineProperty(proto, name, { ...d, get() { count(label); return d.get!.call(this); } });
+}
+wrapFn(Element.prototype, "getBoundingClientRect", "Element.getBoundingClientRect");
+wrapFn(Element.prototype, "getClientRects", "Element.getClientRects");
+wrapFn(Range.prototype, "getBoundingClientRect", "Range.getBoundingClientRect");
+wrapFn(Range.prototype, "getClientRects", "Range.getClientRects");
+wrapFn(window, "getComputedStyle", "getComputedStyle");
+for (const k of ["offsetWidth", "offsetHeight", "offsetTop", "offsetLeft", "offsetParent"]) wrapGet(HTMLElement.prototype, k, k);
+for (const k of ["clientWidth", "clientHeight", "clientTop", "clientLeft", "scrollTop", "scrollLeft", "scrollWidth", "scrollHeight"]) wrapGet(Element.prototype, k, k);
+
+// The draw's own window, marked on the page clock and in the trace.
+const draw = { start: null as number | null, landed: null as number | null, drawn: [] as number[], started: 0, ended: 0 };
+w.__draw = draw;
+document.addEventListener("animationstart", (e) => {
+    if (e.animationName !== "mark-window") return;
+    draw.started++;
+    if (draw.start === null) { draw.start = performance.now(); performance.mark("mark-draw-start"); }
+}, true);
+document.addEventListener("animationend", (e) => {
+    if (e.animationName !== "mark-window") return;
+    draw.ended++;
+    draw.landed = performance.now();
+    performance.mark("mark-line-landed");
+}, true);
+
+const params = new URLSearchParams(location.search);
+const scene = params.get("scene") ?? "sheet";
+const shape = (params.get("shape") ?? "underline") as "underline" | "highlight";
+document.documentElement.classList.toggle("dark", params.get("theme") === "dark");
+if (params.get("hold") === "1") {
+    const s = document.createElement("style");
+    s.id = "hold";
+    s.textContent = ".mark-line, .mark-slide { animation-play-state: paused !important; }";
+    document.head.appendChild(s);
+}
+if (params.get("probeink") === "1") {
+    document.documentElement.style.setProperty("--mark-ink", "#ff00ff");
+    document.documentElement.style.setProperty("--mark-band", "#ff00ff");
+}
+
+const pm = document.createElement("div");
+pm.id = "pm";
+document.body.appendChild(pm);
+w.__marker = (c: string) => (pm.style.background = c);
+
+async function main() {
+    await import("./fixture.css");
+    // The brand face is `font-display: optional`; load it before anything uses it.
+    await Promise.all([
+        document.fonts.load('800 85px "Plus Jakarta Sans"', "4,485"),
+        document.fonts.load('400 16px "Plus Jakarta Sans"', "Wake County"),
+    ]);
+    w.__face = {
+        display: document.fonts.check('800 85px "Plus Jakarta Sans"'),
+        text: document.fonts.check('400 16px "Plus Jakarta Sans"'),
+    };
+    const { createApp, defineComponent, h, ref } = await import("vue");
+    const { Mark } = await import("../../src/components/mark");
+
+    const onDrawn = () => {
+        draw.drawn.push(performance.now());
+        performance.mark("mark-drawn");
+        if (scene === "stall") pm.style.background = "rgb(0, 200, 0)";
+    };
+    const mark = (text: any, probe: string) => h(Mark, { shape, "data-probe": probe, onDrawn }, () => text);
+
+    const Sheet = defineComponent(() => () =>
+        h("div", { class: "sheet" }, [
+            ...[48, 85, 112].map((px) =>
+                h("h1", { "data-row": `h${px}`, style: `font-size:${px}px` }, [mark("4,485", `h${px}`), " visits"]),
+            ),
+            // The token that clears instead of skipping: the underline's top sits under the comma's tail.
+            h("h1", { "data-row": "clear", style: "font-size:85px;--mark-offset:0.2em" }, [mark("4,485", "clear"), " visits"]),
+            h("p", { "data-row": "body" }, [
+                "Most visitors came from ", mark("Wake County", "wake"), " and found the museum through ", mark("Google", "google"), ".",
+            ]),
+            h("p", { "data-row": "wrap", class: "wrap" }, [
+                "Attendance ", mark("rose through September and held through the last week of October", "wrap"), ", the longest run on record.",
+            ]),
+            h("p", { "data-row": "rtl", class: "rtl", dir: "rtl", lang: "ar" }, [
+                "أحصى المتحف ", mark("أربعة آلاف زيارة في فصل الخريف", "rtl"), " هذا العام.",
+            ]),
+            h("p", { "data-row": "nested", class: "nested" }, [
+                "Nested markup: ", mark(["a ", h("em", "younger"), " and ", h("strong", "larger"), " crowd than any year before"], "nested"), ".",
+            ]),
+            h("p", { "data-row": "plain" }, [
+                "No component: ", h("span", { class: "mark-underline" }, "Wake County"), " and ", h("mark", { class: "mark-highlight" }, "Google"), ".",
+            ]),
+            h("span", { class: "spring-probe", "data-probe": "spring" }),
+        ]),
+    );
+
+    const mounted = ref(false);
+    w.__mount = () => (mounted.value = true);
+    // `&fold=1` puts the mark two viewports down; `&retrigger=1` redraws it on each entry.
+    const fold = params.get("fold") === "1";
+    const retrigger = params.get("retrigger") === "1";
+    const inst = ref<{ play: () => void } | null>(null);
+    w.__play = () => inst.value?.play();
+    const Stall = defineComponent(() => () =>
+        h("div", { class: "sheet" }, [
+            fold ? h("div", { style: "block-size:200vh" }) : null,
+            h("h1", { "data-row": "stall", style: "font-size:85px" }, [
+                mounted.value ? h(Mark, { ref: inst, shape, retrigger, "data-probe": "mark", onDrawn }, () => "4,485") : "4,485",
+                " visits",
+            ]),
+            h("div", { style: "block-size:200vh" }),
+            h("span", { class: "spring-probe", "data-probe": "spring" }),
+        ]),
+    );
+    if (scene === "stall") {
+        const ctl = document.createElement("div");
+        ctl.id = "ctl";
+        document.body.appendChild(ctl);
+    }
+
+    // `?scene=sweep&prefix=...&text=...`: 64 plain-class rows inside glass's own stylesheet,
+    // each 1/64 px lower than the last (skip.mjs reads the engine's skip-ink off them).
+    const Sweep = defineComponent(() => () =>
+        h("div", { style: "padding:20px" }, Array.from({ length: 64 }, (_, i) => [
+            h("div", { style: "height:0.015625px" }),
+            h("p", { "data-i": i, style: `margin:0;font-size:${params.get("size") ?? 16}px;font-weight:${params.get("weight") ?? 400};line-height:${params.get("lh") ?? 24}px;white-space:nowrap;${params.get("offset") ? `--mark-offset:${params.get("offset")}` : ""}` }, [
+                params.get("prefix") ?? "", h("span", { class: "mark-underline" }, params.get("text") ?? "Wake County"), " and found",
+            ]),
+        ])),
+    );
+
+    w.__phase = "mount";
+    createApp(scene === "stall" ? Stall : scene === "sweep" ? Sweep : Sheet).mount("#app");
+    w.__phase = "after-mount";
+    const raf = window.requestAnimationFrame.bind(window);
+    raf(() => raf(() => (w.__ready = true)));
+}
+void main();
