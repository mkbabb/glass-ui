+                            const k = (y * png.width + x) * 4;
+                            if (png.data[k] > 200 && png.data[k + 1] < 90 && png.data[k + 2] > 200) { cols[x] = 1; lo = Math.min(lo, x); hi = Math.max(hi, x); }
