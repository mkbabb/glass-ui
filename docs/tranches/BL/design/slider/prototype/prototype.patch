+   shadow, tabular figures, its radius half its own height. It shows while the value is
+   being changed (held, or keyboard-focused), not on hover. */
+.slider-readout {
+    position: fixed;
+    inset: auto;
+    margin: 0;
+    left: anchor(left);
+    top: anchor(center);
+    padding: 0.125rem 0.5rem;
+    border: 1px solid var(--border);
+    border-radius: 999px;
+    background: var(--card);
+    color: var(--foreground);
+    font: 500 0.75rem / 1.25rem var(--font-sans, system-ui);
+    font-variant-numeric: tabular-nums;
+    white-space: nowrap;
+    pointer-events: none;
+    overflow: visible;
+    --slider-shift: calc(var(--slider-radius) + var(--slider-pa, 0) * var(--slider-travel));
+    --slider-lift: calc(var(--slider-radius) + var(--slider-g) + var(--slider-g) / 2);
+    translate: calc(var(--slider-shift) - 50%)
+        calc(-100% - var(--slider-lift));
+    transform-origin: 50% 100%;
+    scale: var(--slider-shell-rest);
+    opacity: 0;
+    transition:
