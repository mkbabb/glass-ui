diff --git a/tests/components/deck/snap-travel.test.ts b/tests/components/deck/snap-travel.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/components/deck/snap-travel.test.ts
@@ -0,0 +1,269 @@
+import { mount } from "@vue/test-utils";
+import { defineComponent, nextTick, ref } from "vue";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useDeck, useDeckSnap } from "@glass/components/deck";
+import { Carousel, CarouselContent, CarouselItem } from "@glass/components/carousel";
+
+/* The snap arm on the platform's own scroll-snap: the strip's own report never
+   scrolls it again, a press holds the strip's reports once and reconciles where the
+   strip rests, the channel rests at velocity 0, and the Carousel's `v-model:active`
+   moves the strip, from its first value on. happy-dom has no layout, so each member
+   gets a pitch, the strip a scroll position, and the strip's reports come from a
+   stand-in IntersectionObserver. */
+
+const PITCH = 400;
+
+let calls: ScrollToOptions[] = [];
+let fades: { el: Element; keyframes: unknown; finish: () => void; finished: Promise<void> }[] = [];
+let report: ((entries: Partial<IntersectionObserverEntry>[]) => void) | null = null;
+
+/** The strip reports member `i` as holding the viewport. */
+function reportMember(strip: HTMLElement, i: number): void {
+    report?.([{ target: strip.children[i]!, intersectionRatio: 1 }]);
+}
+
+function setReduced(on: boolean): void {
+    window.matchMedia = vi.fn().mockImplementation((q: string) => ({
+        matches: on && q.includes("reduce"),
+        media: q,
+        addEventListener: () => {},
+        removeEventListener: () => {},
+        addListener: () => {},
+        removeListener: () => {},
+        onchange: null,
+        dispatchEvent: () => false,
+    })) as unknown as typeof window.matchMedia;
+}
+
+function harness(n = 4) {
+    const deck = useDeck(n);
+    const strip = ref<HTMLElement | null>(null);
+    const Host = defineComponent({
+        setup() {
+            useDeckSnap({ strip, deck });
+            return { strip };
+        },
+        template: `<div ref="strip">${"<div />".repeat(n)}</div>`,
+    });
+    const wrapper = mount(Host, { attachTo: document.body });
+    return { deck, el: wrapper.element as HTMLElement };
+}
+
+beforeEach(() => {
+    vi.useFakeTimers();
+    calls = [];
+    fades = [];
+    report = null;
+    setReduced(false);
+    (window as unknown as { onscrollend: null }).onscrollend = null;
+    vi.stubGlobal(
+        "IntersectionObserver",
+        class {
+            constructor(cb: (entries: Partial<IntersectionObserverEntry>[]) => void) {
+                report = cb;
+            }
+            observe() {}
+            disconnect() {}
+        },
+    );
+    Object.defineProperty(HTMLElement.prototype, "offsetLeft", {
+        configurable: true,
+        get(this: HTMLElement) {
+            const parent = this.parentElement;
+            return parent ? Array.from(parent.children).indexOf(this) * PITCH : 0;
+        },
+    });
+    Object.defineProperty(HTMLElement.prototype, "clientWidth", {
+        configurable: true,
+        get: () => PITCH,
+    });
+    Object.defineProperty(HTMLElement.prototype, "scrollWidth", {
+        configurable: true,
+        get(this: HTMLElement) {
+            return this.children.length * PITCH;
+        },
+    });
+    const offsets = new WeakMap<Element, number>();
+    Object.defineProperty(HTMLElement.prototype, "scrollLeft", {
+        configurable: true,
+        get(this: HTMLElement) {
+            return offsets.get(this) ?? 0;
+        },
+        set(this: HTMLElement, v: number) {
+            offsets.set(this, v);
+        },
+    });
+    HTMLElement.prototype.scrollTo = function (this: HTMLElement, o?: ScrollToOptions | number) {
+        const opts = o as ScrollToOptions;
+        calls.push(opts);
+        if (typeof opts.left === "number") this.scrollLeft = opts.left;
+        this.dispatchEvent(new Event("scroll"));
+    } as typeof HTMLElement.prototype.scrollTo;
+    // happy-dom has no Web Animations; the stand-in records each fade, and a test ends
+    // one with `finish`.
+    HTMLElement.prototype.animate = function (this: HTMLElement, keyframes: unknown) {
+        let finish = () => {};
+        const finished = new Promise<void>((resolve) => (finish = resolve));
+        fades.push({ el: this, keyframes, finish, finished });
+        return { finished, cancel: () => {} } as unknown as Animation;
+    } as typeof HTMLElement.prototype.animate;
+});
+afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+    document.body.innerHTML = "";
+});
+
+describe("useDeckSnap — the strip and the index", () => {
+    it("commits a member the strip reports and never scrolls the strip to it again", async () => {
+        const { deck, el } = harness();
+        calls = [];
+        el.scrollLeft = 300;
+        reportMember(el, 1);
+        await nextTick();
+        expect(deck.index.value).toBe(1);
+        expect(calls).toHaveLength(0);
+    });
+
+    it("ignores a report of a member beside the one the strip rests on", async () => {
+        const { deck, el } = harness();
+        deck.go(1);
+        await nextTick();
+        el.dispatchEvent(new Event("scrollend"));
+        reportMember(el, 2);
+        await nextTick();
+        expect(deck.index.value).toBe(1);
+    });
+
+    it("scrolls a press to the member's own offset", async () => {
+        const { deck } = harness();
+        deck.go(2);
+        await nextTick();
+        expect(calls.at(-1)).toEqual({ left: 2 * PITCH, behavior: "smooth" });
+    });
+
+    it("releases a press's hold once, so an earlier press cannot drop a later one's", async () => {
+        const { deck, el } = harness();
+        deck.go(1);
+        await nextTick();
+        el.dispatchEvent(new Event("scrollend"));
+        vi.advanceTimersByTime(500);
+        deck.go(0);
+        await nextTick();
+        // The first press's 900 ms floor has passed; the second press still holds the
+        // strip's reports, so the member it is leaving cannot commit back.
+        vi.advanceTimersByTime(450);
+        reportMember(el, 1);
+        await nextTick();
+        expect(deck.index.value).toBe(0);
+    });
+
+    it("commits where the strip rests when the page took it elsewhere during a press", async () => {
+        const { deck, el } = harness();
+        deck.go(1);
+        await nextTick();
+        el.scrollLeft = 0;
+        reportMember(el, 0);
+        expect(deck.index.value).toBe(1);
+        el.dispatchEvent(new Event("scrollend"));
+        await nextTick();
+        expect(deck.index.value).toBe(0);
+    });
+
+    it("under reduced motion fades the strip out, seats it at once, and fades it in", async () => {
+        setReduced(true);
+        const { deck, el } = harness();
+        calls = [];
+        deck.go(2);
+        await nextTick();
+        // A press during the fade-out moves the seat; it starts no second fade.
+        deck.go(3);
+        await nextTick();
+        expect(calls).toHaveLength(0);
+        expect(fades).toHaveLength(1);
+        expect(fades[0]!.el).toBe(el);
+        expect(fades[0]!.keyframes).toEqual({ opacity: [1, 0] });
+        fades[0]!.finish();
+        await fades[0]!.finished;
+        expect(calls).toEqual([{ left: 3 * PITCH, behavior: "instant" }]);
+        expect(fades).toHaveLength(2);
+        expect(fades[1]!.el).toBe(el);
+        expect(fades[1]!.keyframes).toEqual([{ opacity: 0 }, {}]);
+    });
+
+    it("fades nothing when motion is allowed", async () => {
+        const { deck } = harness();
+        deck.go(2);
+        await nextTick();
+        expect(fades).toHaveLength(0);
+    });
+});
+
+describe("useDeckSnap — the strip at rest", () => {
+    it("feeds a zero velocity at the strip's scrollend", () => {
+        const { deck, el } = harness();
+        vi.advanceTimersByTime(1000);
+        el.scrollLeft = 300;
+        el.dispatchEvent(new Event("scroll"));
+        vi.advanceTimersByTime(16);
+        el.scrollLeft = 380;
+        el.dispatchEvent(new Event("scroll"));
+        expect(deck.velocity.value).not.toBe(0);
+        el.scrollLeft = 400;
+        el.dispatchEvent(new Event("scrollend"));
+        expect(deck.velocity.value).toBe(0);
+        expect(deck.position.value).toBe(1);
+    });
+
+    it("stands an idle floor in for scrollend where the engine has none", () => {
+        delete (window as unknown as { onscrollend?: null }).onscrollend;
+        const { deck, el } = harness();
+        vi.advanceTimersByTime(1000);
+        el.scrollLeft = 300;
+        el.dispatchEvent(new Event("scroll"));
+        vi.advanceTimersByTime(16);
+        el.scrollLeft = 400;
+        el.dispatchEvent(new Event("scroll"));
+        expect(deck.velocity.value).not.toBe(0);
+        vi.advanceTimersByTime(160);
+        expect(deck.velocity.value).toBe(0);
+    });
+});
+
+describe("Carousel — v-model:active", () => {
+    function carousel(start: number) {
+        const active = ref(start);
+        const Host = defineComponent({
+            components: { Carousel, CarouselContent, CarouselItem },
+            setup: () => ({ active }),
+            template: `
+                <Carousel v-model:active="active" aria-label="Slides">
+                    <CarouselContent>
+                        <CarouselItem v-for="i in 4" :key="i" :index="i - 1">{{ i }}</CarouselItem>
+                    </CarouselContent>
+                </Carousel>`,
+        });
+        const wrapper = mount(Host, { attachTo: document.body });
+        const state = () => wrapper.findAll('[data-slot="carousel-item"]').map((m) => m.attributes("data-state"));
+        return { active, state };
+    }
+
+    it("moves the strip when the model is written from outside", async () => {
+        const { active, state } = carousel(0);
+        await nextTick();
+        active.value = 2;
+        await nextTick();
+        await nextTick();
+        expect(calls.at(-1)).toEqual({ left: 2 * PITCH, behavior: "smooth" });
+        expect(state()[2]).toBe("active");
+    });
+
+    it("seats a non-zero first value at once", async () => {
+        const { active, state } = carousel(2);
+        await nextTick();
+        await nextTick();
+        expect(calls).toEqual([{ left: 2 * PITCH, behavior: "instant" }]);
+        expect(state()[2]).toBe("active");
+        expect(active.value).toBe(2);
+    });
+});
