@@ -0,0 +1,52 @@
+/* PRINT — paper takes none of glass's material.
+
+   Under `@media print` the page loses the chrome a reader cannot use on paper and
+   every surface flattens to paper:
+
+   - The floating chrome is hidden: the dock, popovers and hover cards, tooltips,
+     toasts, and any menu or Select list left open.
+   - Every surface resolves to its solid card through the one `--glass-level: 0`
+     escape that reduced transparency rides, and no element keeps a backdrop filter or
+     a shadow. The scrims and the focus veil that dim the page behind a modal clear, and
+     the Sheet's frost sampler goes with them.
+   - Dialog and Sheet print flat where they stand, not hidden, so a modal's content
+     still prints.
+
+   Nothing transitions into print. The overlay plates carry a discrete `display`
+   transition, and a running transition outranks an important declaration, so a plate
+   would stay on the page for the length of its exit.
+
+   The declarations are important and sit in the last layer: they beat every normal
+   rule, unlayered and inline ones included, and lose only to an important rule a site
+   writes in an earlier layer or in a style attribute. */
+@layer print {
+    @media print {
+        :root {
+            --glass-level: 0 !important;
+            --glass-grain-opacity: 0 !important;
+            --overlay-scrim: transparent !important;
+        }
+
+        *,
+        *::before,
+        *::after {
+            backdrop-filter: none !important;
+            box-shadow: none !important;
+            transition: none !important;
+        }
+
+        :is(
+            .glass-dock,
+            [data-slot="popover-content"],
+            [data-slot="tooltip-content"],
+            [data-slot="toast"],
+            [data-slot="menu-content"],
+            [data-slot="menu-sub-content"],
+            [data-slot="select-content"],
+            [data-slot="glass-graded-halo"],
+            .glass-focus-veil
+        ) {
+            display: none !important;
+        }
+    }
+}
