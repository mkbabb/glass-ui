new file mode 100644
index 0000000..2668fd6
--- /dev/null
+++ b/src/components/_shared/overlay/modal-layers.ts
@@ -0,0 +1,61 @@
+import { computed, onScopeDispose, shallowReactive, watch, type ComputedRef } from "vue";
+
+/* THE MODAL LAYERS, in the order they opened.
+ *
+ * A modal surface (a Dialog or a Sheet over its scrim, an enlarged ExpandableContainer)
+ * stands above every modal surface that opened before it. Document order cannot say
+ * which that is: a portal keeps the place its component mounted in, so a Dialog
+ * declared before the Dialog that opens it lands earlier in `body` and, on the same
+ * rung, paints under it. The order here is the order of opening.
+ *
+ * The open layer on top keeps the modal rung. Each scrim stands two steps per layer
+ * below it above the overlay rung, so it dims every earlier layer, and a covered
+ * layer's plate stands one step above its own scrim. With one layer open nothing moves:
+ * its scrim is on the overlay rung and its plate on the modal rung. A layer leaves when
+ * its scrim has gone, so the layer below takes its rung back only once nothing dims it. */
+const layers = shallowReactive<object[]>([]);
+
+export interface ModalLayer {
+    /** This layer's place in the opening order, from 0. */
+    index: ComputedRef<number>;
+    /** Whether a layer that opened later is still present above this one. */
+    covered: ComputedRef<boolean>;
+}
+
+/** Take a place in the modal order for as long as `present()` reads true. On the
+ *  server nothing takes a place: the order is shared by the whole module, and a render
+ *  there has no page to stack. */
+export function useModalLayer(present: () => boolean): ModalLayer {
+    if (typeof document === "undefined")
+        return { index: computed(() => 0), covered: computed(() => false) };
+    const self = {};
+    const leave = (): void => {
+        const at = layers.indexOf(self);
+        if (at !== -1) layers.splice(at, 1);
+    };
+    watch(
+        present,
+        (now) => {
+            if (!now) leave();
+            else if (!layers.includes(self)) layers.push(self);
+        },
+        { immediate: true, flush: "sync" },
+    );
+    onScopeDispose(leave);
+    const index = computed(() => Math.max(0, layers.indexOf(self)));
+    const covered = computed(() => {
+        const at = layers.indexOf(self);
+        return at !== -1 && at < layers.length - 1;
+    });
+    return { index, covered };
+}
+
+/** The z-index of the scrim of the layer at `index`. */
+export function scrimZ(index: number): string {
+    return `calc(var(--z-overlay) + ${2 * index})`;
+}
+
+/** The z-index of a covered layer's plate: one step above its own scrim. */
+export function coveredZ(index: number): string {
+    return `calc(var(--z-overlay) + ${2 * index + 1})`;
+}
