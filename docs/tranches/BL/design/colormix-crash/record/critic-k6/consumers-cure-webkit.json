  "valuejs-shadow": ".dark { --shadow-color: color-mix(in oklab, var(--foreground) 34%, var(--background)); }",
  "valuejs-contrast": ":root, .dark { --border: color-mix(in oklab, var(--foreground) 78%, var(--background)); --muted-foreground: color-mix(in oklab, var(--foreground) 88%, var(--background)); }",
  "hassio-accent": "[data-target=\"card\"] { --glass-accent: color-mix(in oklab, color-mix(in oklab, #2e9d5b 70%, #1c1917) 62%, transparent); --glass-accent-strength: 100%; }",
  "hassio-switch": "[data-target=\"switch-checked\"] { --control-checked-bg: color-mix(in oklab, var(--foreground) 40%, transparent); --card: oklch(0.95 0.01 80); }",
  "hassio-bit": "[data-target=\"checkbox-unchecked\"] { --control-bit-fill: color-mix(in oklab, var(--foreground) 14%, transparent); --shadow-md: 0 1px 3px color-mix(in oklab, var(--foreground) 18%, transparent); }",
  "hassio-choose": "[data-target=\"checkbox-checked\"], [data-target=\"radio-checked\"] { --control-checked-bg: color-mix(in srgb, var(--foreground) 88%, var(--glass-plate-floating)); }",
  "slides-borders": ":root { --glass-border-quiet: color-mix(in srgb, var(--foreground) 18%, transparent); --glass-border-resting: color-mix(in srgb, var(--foreground) 28%, transparent); --glass-border-floating: color-mix(in srgb, var(--foreground) 32%, transparent); } .dark { --glass-border-quiet: color-mix(in srgb, hsl(45 30% 92%) 14%, transparent); --glass-border-resting: color-mix(in srgb, hsl(45 30% 92%) 22%, transparent); --glass-border-floating: color-mix(in srgb, hsl(45 30% 92%) 28%, transparent); }",
  "parkway": ":root:not(.dark) { --glass-veil-ink: color-mix(in oklab, #e6e9dc 35%, white); } .dark { --card: color-mix(in oklab, #0d1a1b 88%, #928f84); }",
  "what-if-ink-mix": ":root, .dark { --foreground: color-mix(in oklab, #1c1917 90%, #7c2d12); }",
  "what-if-accent-mix": "[data-target=\"bare-dock-icon-button\"] { --glass-accent: color-mix(in oklab, #2e9d5b 62%, transparent); --glass-accent-strength: 100%; }",
  "card-mix-light-backdrop": ":root, .dark { --glass-backdrop: light; --card: color-mix(in oklab, white 92%, transparent); }"
