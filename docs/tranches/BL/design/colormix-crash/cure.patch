+// An endpoint split at its top-level spaces, so its weight can be dropped.
+const words = (value: string): string[] => {
+    const parts: string[] = [];
+    let depth = 0; let start = 0;
+    for (let i = 0; i <= value.length; i += 1) {
+        if (value[i] === "(") depth += 1;
+        else if (value[i] === ")") depth -= 1;
+        else if (i === value.length || (depth === 0 && /\s/.test(value[i]))) {
+            if (i > start) parts.push(value.slice(start, i));
+            start = i + 1;
+        }
+    }
+    return parts;
+};
+
+// The custom properties an endpoint IS: its var() and each var() down its fallback
+// chain. Empty when the endpoint is anything but a var().
+const namesOf = (endpoint: string): string[] => {
+    const parts = words(endpoint.trim()).filter((part) => !/^(?:-?[\d.]+%|calc\(.*\))$/s.test(part));
+    if (parts.length !== 1 || !parts[0].startsWith("var(")) return [];
+    const [call] = calls(parts[0]);
+    const name = call?.args[0]?.trim() ?? "";
+    return [name, ...(call && call.args.length > 1 ? namesOf(call.args.slice(1).join(", ")) : [])];
+};
+
+// Every declaration holding a color-mix whose two endpoints EACH hold a color-mix
+// once every var() (and its fallback) is followed through every declaration of that
+// property: an endpoint that is a mix, a relative colour of a mix, or a light-dark()
+// with a mix inside. Over-approximates on purpose: one producer that holds a mix is
+// enough, whatever selector or scheme declares it. glass's own producers cannot show
+// a consumer's value, so a color-mix whose two endpoints are the same custom property
+// is flagged too: a consumer that sets that property to a mix makes both endpoints
+// mixes.
+const mixOfMixes = (sources: StyleSource[]): string[] => {
+    const declarations: Array<{ id: string; value: string }> = [];
+    const producers = new Map<string, string[]>();
+    for (const source of sources) {
+        postcss.parse(source.css, { from: source.id }).walkDecls((decl) => {
+            const id = `${relative(process.cwd(), source.id)}:${decl.source?.start?.line}`;
+            declarations.push({ id: `${id} ${decl.prop}`, value: decl.value });
+            if (decl.prop.startsWith("--"))
+                producers.set(decl.prop, [...(producers.get(decl.prop) ?? []), decl.value]);
+        });
+    }
+    const holdsMix = (value: string, stack: string[]): boolean =>
+        calls(value).some((call) => {
+            if (call.name === "color-mix") return true;
+            if (call.name !== "var") return false;
+            const name = call.args[0]?.trim() ?? "";
+            if (call.args.length > 1 && holdsMix(call.args.slice(1).join(", "), stack)) return true;
+            if (stack.includes(name)) return false;
+            return (producers.get(name) ?? []).some((candidate) => holdsMix(candidate, [...stack, name]));
+        });
+    const found = new Set<string>();
+    for (const declaration of declarations)
+        for (const mix of calls(declaration.value).filter((call) => call.name === "color-mix")) {
+            const [first, second] = mix.args.slice(1, 3);
+            if (!first || !second) continue;
+            const shared = namesOf(first).some((name) => namesOf(second).includes(name));
+            if (shared || (holdsMix(first, []) && holdsMix(second, []))) found.add(declaration.id);
+        }
+    return [...found];
+};
