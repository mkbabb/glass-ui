+    const snap = (x: number) => Math.round((x + base.left) * dpr) / dpr - base.left;
+    // ONE INK (R-1): the first member not under its own morph inks the whole silhouette; the
+    // others stand their ink down. It sits at z 0, under every other member's controls.
+    const painter = Math.max(0, morph.findIndex((v) => !v));
