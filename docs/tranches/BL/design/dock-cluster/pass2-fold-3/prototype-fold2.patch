+   does the frame paint. On their own loops a spring minted outside this frame (a membership change)
+   ticked after the paint, and its loop's first step was a nominal 16.7 ms: one frame late, then two
+   frames at once whenever a ResizeObserver paint landed after the tick. A loop woken from rest
+   paints its first frame at zero elapsed time (as a CSS transition does), then true intervals. */
+let lastT = 0;
+function clocked(): Set<DockSpring> {
+    const all = new Set<DockSpring>(springs);
+    for (const g of glides.values()) { all.add(g.s0); all.add(g.s1); }
+    for (const r of slots.values()) all.add(r.spring);
+    for (const r of phantoms) all.add(r.spring);
+    for (const e of offsets.values()) all.add(e.spring);
