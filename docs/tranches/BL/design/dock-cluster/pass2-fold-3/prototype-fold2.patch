@@ -0,0 +1,146 @@
+/* DockCluster (W-I.8 spec graft, prototype): N GlassDocks fuse into one plate and
+ * fission back by shape alone.
+ *
+ * Paint order inside the cluster's own stack, bottom to top:
+ *   .dock-cluster-shadow   one drop shadow, outside the silhouette only (B)
+ *   .dock-cluster-lens × N one backdrop-filter per member dock, spanning the cluster box,
+ *                          clipped to that dock's share (B's geometry). No ink: every lens
+ *                          paints before any ink, so a lens never samples a neighbour's veil
+ *   .glass-dock × N        each member's OWN .dock-plate paints its ink (luma darken, ink
+ *                          tier, grain) over its share, plus the rim ring sliced to its share;
+ *                          its backdrop-filter, border and box-shadow stand down here only
+ */
+@property --dock-cluster-swap {
+    syntax: "<time>";
+    inherits: true;
+    initial-value: 0s;
+}
+
+@layer components {
+    .dock-cluster {
+        --dock-cluster-swap: var(--spring-dock-exit-duration);
+        position: relative;
+        z-index: 0;
+        display: flex;
+        flex-wrap: nowrap;
+        /* F12: the row never squeezes a member below its content; an overflow is reported. */
+        flex-shrink: 0;
+        align-items: center;
+        gap: var(--dock-cluster-gap, 0.625rem);
+        --dock-cluster-rim: 1.5px;
+        /* PROTOTYPE ONLY: the wave widens shell.css's token block to
+           `:is(.glass-dock, .dock-cluster)` instead of restating it here. */
+        --glass-blur-resting: blur(calc(var(--glass-blur-resting-radius) * var(--glass-level)))
+            saturate(1.2);
+        --dock-surface-blur: var(--glass-blur-resting);
+    }
+    .dark .dock-cluster {
+        --glass-blur-resting: blur(calc(var(--glass-blur-resting-radius) * var(--glass-level)))
+            saturate(1.3) brightness(1.14);
+    }
+
+    /* The dock's backdrop filter, split in two. The KERNEL (blur) lenses paint first;
+       a later lens samples an earlier lens's output near a cut, and a second blur of a
+       blurred field moves no mean. The TONE (saturate, brightness) is pointwise, so its
+       lenses paint after every kernel lens and each reads only the pixels under its own
+       share: a tone is applied exactly once per pixel. */
+    /* N2: an unpainted layer clips to an empty path, never a `%` inset (I8-G4) */
+    .dock-cluster-lens,
+    .dock-cluster-tone {
+        position: absolute;
+        inset: 0;
+        pointer-events: none;
+        clip-path: path("M0 0");
+    }
+    .dock-cluster-lens {
+        backdrop-filter: blur(calc(var(--glass-blur-resting-radius) * var(--glass-level)));
+    }
+    .dock-cluster-tone {
+        backdrop-filter: saturate(1.2);
+    }
+    .dark .dock-cluster-tone {
+        backdrop-filter: saturate(1.3) brightness(1.14);
+    }
+
+    .dock-cluster-shadow {
+        position: absolute;
+        inset: -40px;
+        pointer-events: none;
+        clip-path: path("M0 0");
+    }
+    .dock-cluster-shadow-blur {
+        position: absolute;
+        inset: 0;
+        filter: blur(10px);
+    }
+    .dock-cluster-shadow-fill {
+        position: absolute;
+        inset: 0;
+        background: color-mix(in srgb, var(--shadow-color) 14%, transparent);
+        clip-path: path("M0 0");
+    }
+
+    .dock-cluster > .glass-dock {
+        /* PASS 2: one material. A member's collapse lerps its ink between the wash and the
+           dock tier; in a cluster every member paints the dock tier, so a collapsed member
+           fused to an expanded one reads as one plate, not two tones. */
+        --dock-plate-collapsed-tier: var(--dock-plate-expanded-tier);
+        --dock-plate-collapsed-border: var(--dock-plate-expanded-border);
+        flex-shrink: 0;
+        /* C4: the row is the cluster's; a member's own centring margin (shell.css
+           `margin: 0 auto`) would spread the members across a root the consumer sizes */
+        margin-inline: 0;
+        position: relative;
+        z-index: 1;
+        box-shadow: none;
+    }
+    /* The member's own plate: spans the cluster box (inset written by the cluster on
+       layout change), clipped to its share (written per frame). Ink, tier, luma, grain:
+       GlassDock's own. */
+    .dock-cluster > .glass-dock > .dock-plate {
+        backdrop-filter: none;
+        border: 0;
+        /* The share path draws every corner. The run's scroll-driven cut cap
+           (run.css) animates this radius, so it stands down here with it. */
+        border-radius: 0;
+        animation: none;
+    }
+    /* one ink: the painter's grain is anchored to the cluster, so a change of painter moves no grain */
+    .dock-cluster > .glass-dock > .dock-plate::after {
+        background-position: var(--dock-cluster-grain-x, 0px) 0px;
+    }
+    .dock-cluster > .glass-dock > .dock-plate::before {
+        content: "";
+        position: absolute;
+        inset: 0;
+        pointer-events: none;
+        /* restraint (O-203): the rim is flat, one colour; no lit gradient */
+        background: var(--glass-border-dock);
+        clip-path: var(--dock-ring-clip, path("M0 0"));
+    }
+
+    /* C6 (restraint: one blur value, no blur in a blur). Inside a cluster the lenses are
+       the only backdrop-filter: no member descendant carries one (the active seat's
+       `.glass-capsule`, a capsule track). The glide's and the arriver's content clips then
+       sit over no blur, and a face's cross-fade opacity sits over no blur (I8-G8). */
+    .dock-cluster > .glass-dock * {
+        /* unprefixed only: the build emits the -webkit- pair, and a hand-written pair is
+           folded to the prefixed declaration alone (measured: Chromium kept the blur) */
+        backdrop-filter: none;
+    }
+    /* PF2 D4 (restraint: no gleam on docks). The controls' specular `::before` (the active
+       seat's rest gleam, the hover and press lift) does not paint in the fused plate. The
+       pseudo is the gleam alone (material.css), so it is not generated. The lone dock's
+       gleam is master's, struck by O-203. */
+    .dock-cluster
+        > .glass-dock
+        :is(
+            .glass-specular-track,
+            .dock-icon-button,
+            .dock-tab-button,
+            .dock-select-trigger,
+            .dock-dropdown-trigger
+        )::before {
+        content: none;
+    }
+}
