+
+const live = () =>
+    springs.some((s) => s.live) || [...offsets.values()].some((v) => v.spring.live) || morphingChildren > 0 || glides.size > 0 || slots.size > 0 || phantoms.length > 0;
+const openOf = (r: Run) => Math.max(0, Math.min(1, r.s / Math.max(1e-6, r.full)));
