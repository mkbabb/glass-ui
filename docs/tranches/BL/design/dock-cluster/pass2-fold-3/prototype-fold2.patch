+// I8-G5 source arm: every spring the cluster mints is handed the DOCK_SPRING constant itself.
+// C7 (pass 2, challenge 1): the test drives every site that mints one, a join, a width glide,
+// a pure leave (survivor offsets and a phantom) and an arrival, and asserts each stage minted
+// at least the springs that site owns, so a site the test does not reach fails it too.
+import { mount } from "@vue/test-utils";
+import { h, nextTick, ref } from "vue";
+import { describe, expect, it, vi } from "vitest";
+
+// fold-1 resume: and every one is stepped by the cluster's one clock (`clock: "host"`), so a site
+// on its own rAF loop (one frame late, then two at once) fails it too
+const seen: unknown[] = [];
+const clocks: unknown[] = [];
+vi.mock("@glass/components/dock/composables/useDockSpring", async (orig) => {
+    const real = (await orig()) as typeof import("@glass/components/dock/composables/useDockSpring");
+    return { ...real, useDockSpring: (cfg: never, o?: { clock?: string }) => { seen.push(cfg); clocks.push(o?.clock); return real.useDockSpring(cfg, o); } };
+});
+
+/* happy-dom lays nothing out: each member's box comes from its `data-w`, in a row from
+   x = 100 with a 10 px gap; the root spans the row. */
+const GAP = 10;
+function stubLayout(): void {
+    const rowOf = (root: Element) => {
+        let x = 100;
+        const boxes = new Map<Element, [number, number]>();
+        for (const d of root.querySelectorAll(":scope > .glass-dock")) {
+            const w = Number((d as HTMLElement).dataset.w);
+            boxes.set(d, [x, x + w]);
+            x += w + GAP;
+        }
+        return { boxes, end: x - GAP };
+    };
+    const rect = (l: number, r: number) => ({ left: l, right: r, x: l, y: 0, top: 0, bottom: 56, width: r - l, height: 56, toJSON() {} }) as DOMRect;
+    vi.spyOn(HTMLElement.prototype, "getBoundingClientRect").mockImplementation(function (this: HTMLElement) {
+        const root = this.closest(".dock-cluster");
+        if (!root) return rect(0, 1440);
+        const { boxes, end } = rowOf(root);
+        if (this === root) return rect(100, end);
+        const d = this.closest(".dock-cluster > .glass-dock");
+        const b = d ? boxes.get(d) : undefined;
+        return b ? rect(b[0], b[1]) : rect(100, end);
+    });
+}
+
+describe("I8-G5 · the cluster's springs are springPreset('dock') by reference, at every site", () => {
+    it("passes DOCK_SPRING at the joins, a width glide, a leave and an arrival", async () => {
+        stubLayout();
+        // no frame runs: a spring is minted and never ticks, so no paint lands between a drive
+        // and the MutationObserver delivery (happy-dom delivers it as a task, a browser does not)
+        vi.stubGlobal("requestAnimationFrame", () => 1);
+        vi.stubGlobal("cancelAnimationFrame", () => {});
+        const { DOCK_SPRING } = await import("@glass/components/dock/constants");
+        const { default: DockCluster } = await import("@glass/components/dock/DockCluster.vue");
+        const widths = ref<Record<string, number>>({ a: 100, b: 60, c: 40 });
+        const ids = ref(["a", "b", "c"]);
+        const w = mount(DockCluster, {
+            props: { fused: [true, false] },
+            attrs: { style: "display:flex;flex-direction:row;flex-wrap:nowrap;direction:ltr" },
+            slots: {
+                default: () => ids.value.map((id) => h("div", { class: "glass-dock", key: id, "data-w": widths.value[id] }, [h("div", { class: "dock-plate" }), h("div", { class: "dock-controls" })])),
+            },
+            attachTo: document.body,
+        });
+        const settle = async () => { await nextTick(); await new Promise((r) => setTimeout(r, 20)); };
+
+        // a layout change: deliver to every observer, each entry with its stubbed content rect
+        type RO = { targets: Set<Element>; callback: ResizeObserverCallback };
