+<script setup lang="ts">
+/**
+ * DockCluster (W-I.8, PASS-2 FOLD round 1 build, scratch only). Pass 2's mechanism, with the
+ * round-1 challenge folded in:
+ *   C1  the cluster holds every member open while the pointer or focus is anywhere in it
+ *       (R-13): reaching from the dock to the theme is not leaving the dock;
+ *   C2  a leaver's phantom and an arriver are ONE run of px span on one spring: a phantom
+ *       outlives later membership changes, an arriver at a live phantom's place adopts its run,
+ *       and a leaver that was still opening hands its run to its phantom. A handover is a
+ *       retarget: the span and its velocity never change units or restart;
+ *   C3  a width glide is two px springs (one per edge) anchored where the glide began; a
+ *       layout change of a glider RETARGETS them, so each edge keeps its value and velocity
+ *       and no frame stalls (a re-created spring's first frame has no elapsed time);
+ *   C4  the whole-px grid's sub-pixel remainder is a translate on the members, never an inset
+ *       on the root the consumer positions; the overflow report measures the row against the
+ *       box it lays out in;
+ *   C6  inside a cluster no member descendant carries a backdrop-filter (cluster.css), so the
+ *       glide's and the arriver's content clips (on `.dock-controls`' boxes) sit over no blur;
+ *   N2  one tone element; no `%` clip anywhere (empty `path()` defaults).
+ *   R-14 one clock: every cluster spring is stepped by the cluster's own frame loop, then the
+ *       frame paints (`useDockSpring(…, { clock: "host" })`); a loop woken from rest paints its
+ *       first frame at zero elapsed time.
+ * Pass 2: the painted extent and the chain (R-12), one ink and one tone (R-1, R-2), the capsule
+ * corner (R-4), the PRM seat (R-5).
+ */
+import { useMediaQuery } from "@vueuse/core";
+import { computed, onMounted, onUnmounted, ref, useTemplateRef, watch } from "vue";
+import { DOCK_SPRING } from "./constants";
+import { useDockSpring, type DockSpring } from "./composables/useDockSpring";
+import {
+    GLASS_BACKDROP_SHARED_ATTR,
+    useGlassBackdropLuminance,
+} from "../../composables/glass/useGlassBackdropLuminance";
+import { clusterShape, rectPath, shiftPath, type PlateBox } from "./composables/dockClusterShape";
+import { provideDockClusterContext, type DockClusterMember } from "./composables/dockClusterContext";
+
+const props = withDefaults(defineProps<{ fused?: boolean | readonly boolean[] }>(), {
+    fused: false,
+});
+
+const SHADOW_PAD = 40;
+/** Every cluster spring is stepped by the cluster's one frame loop (`tick`), then painted. */
+const HOST = { clock: "host" } as const;
+
+const root = useTemplateRef<HTMLElement>("root");
+const shadowEl = useTemplateRef<HTMLElement>("shadowEl");
+const shadowFill = useTemplateRef<HTMLElement>("shadowFill");
+const toneEl = useTemplateRef<HTMLElement>("toneEl");
+const lensEls = ref<HTMLElement[]>([]);
+useGlassBackdropLuminance(root, { shared: true });
+const count = ref(0);
+const reduced = useMediaQuery("(prefers-reduced-motion: reduce)");
+
+const target = computed(() =>
+    Array.from({ length: Math.max(0, count.value - 1) }, (_, i) =>
+        (typeof props.fused === "boolean" ? props.fused : props.fused[i]) ? 1 : 0,
+    ),
+);
+
+/* ── C1 / R-13: the cluster's hold ─────────────────────────────────────────────────
+   A member's own hover and focus regions end at its box. In a cluster the reader reaches
+   from the dock to a sibling member (the theme), which would read as leaving the dock and
+   collapse it under a resting pointer. So the cluster takes one posture hold on every
+   member while the reader is in it. PF2 D1: "in" follows the lone dock's own rule. The
+   pointer holds while it is inside. Focus holds from a `focusin` until the pointer leaves
+   or focus leaves: a click seats focus on the control it hit, and that focus must not
+   outlast the pointer, or the dock never collapses again (a lone dock's `mouseleave`
+   schedules its collapse with focus still inside). A keyboard move inside the cluster is
+   a fresh `focusin`, so a reader who Tabs is held again. On release every member runs its
+   own leave, so the collapse keeps the lone dock's delay, not the release grace on top. */
+const registered = new Set<DockClusterMember>();
+let pointerIn = false;
+let focusIn = false;
+let holding = false;
+function syncHold(): void {
+    const want = pointerIn || focusIn;
+    if (want === holding) return;
+    holding = want;
+    for (const m of registered) {
+        if (want) m.keepOpen();
+        else { m.release(); m.leave(); }
+    }
+}
+/* PF2 D3 / R-8: at most one member carries its own collapse. Two collapsing members would
+   morph at once, and the one ink cannot follow two scaled boxes. Asserted on every
+   registration and every membership change; the throw paints nothing (as R-10's layout
+   asserts do), so the failure is loud, never a half-inked silhouette. */
+function assertOneCollapsible(): void {
+    const live = [...registered].filter((m) => m.el.isConnected && m.collapsible());
+    if (live.length < 2) return;
+    const name = (m: DockClusterMember) => `"${m.el.getAttribute("aria-label") ?? m.el.id ?? "unnamed"}"`;
+    throw new Error(`DockCluster: ${live.map(name).join(" and ")} both collapse; at most one member of a cluster may carry its own collapse (W-I.8 R-8)`);
+}
+provideDockClusterContext({
+    register(m) {
+        registered.add(m);
+        if (holding) m.keepOpen();
+        assertOneCollapsible();
+        return () => {
+            if (holding) m.release();
+            registered.delete(m);
+        };
+    },
+});
+function onPointerEnter(): void { pointerIn = true; syncHold(); }
+function onPointerLeave(): void { pointerIn = false; focusIn = false; syncHold(); }
+function onFocusIn(): void { focusIn = true; syncHold(); }
+function onFocusOut(e: FocusEvent): void {
+    const to = e.relatedTarget as Node | null;
+    if (to && root.value?.contains(to)) return;
+    focusIn = false;
+    syncHold();
+}
+
+let members: HTMLElement[] = [];
+let now: number[] = [];
+let springs: DockSpring[] = [];
+const offsets = new Map<HTMLElement, { o: number; spring: DockSpring }>();
+let painted = new Map<HTMLElement, { x0: number; x1: number }>();
+let raf = 0;
+let morphingChildren = 0;
+(window as unknown as { __clusterNow?: () => number[] }).__clusterNow = () => [...now];
+
+function docks(): HTMLElement[] {
+    return root.value ? [...root.value.querySelectorAll<HTMLElement>(":scope > .glass-dock")] : [];
+}
+
+/** F10/F11: the share path is physical LTR along one row. Anything else throws. */
+function assertLayout(): void {
+    const el = root.value;
+    if (!el) return;
+    const cs = getComputedStyle(el);
+    const bad =
+        cs.direction !== "ltr" ? `direction: ${cs.direction}` :
+        cs.flexDirection !== "row" ? `flex-direction: ${cs.flexDirection}` :
+        cs.flexWrap !== "nowrap" ? `flex-wrap: ${cs.flexWrap}` : "";
+    if (bad) throw new Error(`DockCluster: ${bad} is not supported; a cluster is one LTR row (W-I.8 R-10, §6)`);
+}
+
+type Span = { x0: number; x1: number };
+const W = (x: Span) => x.x1 - x.x0;
+
+/* PF2 (D2's read): a member's own scale is read from its computed transform and `scale`, never
+   inferred from `rect.width / offsetWidth`. GlassDock's morph is a size morph (no transform),
+   and `offsetWidth` is a whole number, so the inferred `k` was off 1 by up to 0.5 / w and the
+   unscaled width by up to 0.5 px: the gap the chain hangs the next member on wobbled 0–1 px a
+   frame through every collapse. */
+function scaleOf(d: HTMLElement, _r: DOMRect): { k: number; o: number } {
+    if (!d.hasAttribute("data-morphing")) return { k: 1, o: 0 };
+    const cs = getComputedStyle(d);
+    const m = cs.transform && cs.transform !== "none" ? new DOMMatrixReadOnly(cs.transform).a : 1;
+    const sx = cs.scale && cs.scale !== "none" ? Number.parseFloat(cs.scale) || 1 : 1;
+    const k = m * sx;
+    if (Math.abs(k - 1) < 1e-6) return { k: 1, o: 0 };
+    return { k, o: Number.parseFloat(cs.transformOrigin) || 0 };
+}
+
+/** A member's pure layout box: every translate the cluster wrote, and its own scale, removed. */
+const tr = new Map<HTMLElement, number>();
+function pureBox(d: HTMLElement, r = d.getBoundingClientRect()): Span {
+    const { k, o } = scaleOf(d, r);
+    const x0 = r.left - (tr.get(d) ?? 0) - o * (1 - k);
+    return { x0, x1: x0 + r.width / k };
+}
+
+/* ── C4: the whole-px grid ──────────────────────────────────────────────────────────
+   Every member but the last takes `margin-inline-end: ceil(w) − w`, and every member
+   rides `shift`, the first member's sub-pixel remainder, as part of its translate. The
+   root, which the consumer positions (daraksha: `position: fixed; inset-inline: gutter`),
+   is never written. */
+let shift = 0;
+let overflowing = false;
+function regrid(list: HTMLElement[]): void {
+    const el = root.value;
+    if (!el || !list.length) return;
+    list.forEach((d, i) => {
+        if (i === list.length - 1) return;
+        // PF2: the layout width, never the painted rect. Under its own morph a member's rect is
+        // scaled, and `ceil(w) − w` of a scaled width wrote a margin anywhere in [0, 1) on each
+        // ResizeObserver pass: the next member's layout gap wobbled up to 1 px a frame
+        const w = W(pureBox(d));
+        const m = Math.ceil(w - 0.01) - w;
+        // full precision: both engines lay out in 1/64 px (fold F5, WebKit)
+        const v = m > 1e-3 ? `${m}px` : "";
+        if (d.style.marginInlineEnd !== v) d.style.marginInlineEnd = v;
+    });
+    const p0 = pureBox(list[0]!).x0;
+    shift = Math.ceil(p0 - 1e-3) - p0;
+    // F12 / R-10: the row is reported against the box it lays out in. A root sized by its
+    // content (a flex item) overflows its parent; a root the consumer sizes (fixed, inset)
+    // overflows itself.
+    const rr = el.getBoundingClientRect();
+    const first = pureBox(list[0]!), last = pureBox(list.at(-1)!);
+    const need = last.x1 - first.x0;
+    const pos = getComputedStyle(el).position;
+    const host =
+        pos === "fixed" ? { left: 0, right: document.documentElement.clientWidth } :
+        pos === "absolute" ? (el.offsetParent ?? el.parentElement)?.getBoundingClientRect() :
+        el.parentElement?.getBoundingClientRect();
+    const overSelf = Math.max(rr.left - first.x0, last.x1 - rr.right);
+    const overHost = host ? Math.max(host.left - rr.left, rr.right - host.right) : 0;
+    const over = Math.max(overSelf, overHost);
+    const given = overSelf >= overHost ? rr.width : host ? host.right - host.left : rr.width;
+    if (over > 0.5 && !overflowing) {
+        console.error(`DockCluster: the row needs ${need.toFixed(1)}px and its container gives ${given.toFixed(1)}px; compose two rows (W-I.8 R-10)`);
+        el.setAttribute("data-overflow", "");
+    } else if (over <= 0.5 && overflowing) el.removeAttribute("data-overflow");
+    overflowing = over > 0.5;
+}
+
+/* ── the painted extent (R-12) ──────────────────────────────────────────────────────
+   C3: a glide is two px springs, one per edge, anchored at the painted edges where the glide
+   began (`b0`, `b1`): painted edge = anchor + offset, and each offset springs toward
+   (layout edge − anchor). A later layout change of the glider RETARGETS both springs, which
+   re-seats each from its own current value and velocity: no edge stalls, none reverses.
+   C2: an arriving member and a leaver's phantom are one RUN, a span in px on one spring. An
+   arriver paints `o = span / (its width + one gap)` of its width and of one gap; a phantom
+   holds its span where it stood. A run changes role by retarget, so a swap that turns back
+   keeps its span and its velocity.
+   PF2 D2: a member's own morph that starts while it glides takes the glide over. The anchors
+   then ride the morph's painted rect (`onMorph`), and each offset is re-seated to where the
+   glide painted this frame, relative to that rect, springing to 0 on the same spring (a
+   `playTo` on a live spring keeps its velocity). When the morph settles the anchors return
+   to the layout box with the same re-seat. So the extent neither steps where the morph
+   starts nor repaints a stale glide where it ends. */
+interface Glide { b0: number; b1: number; d0: number; d1: number; s0: DockSpring; s1: DockSpring; onMorph: boolean }
+const glides = new Map<HTMLElement, Glide>();
+interface Run { s: number; full: number; role: "slot" | "phantom"; el: HTMLElement | null; after: HTMLElement | null; spring: DockSpring }
+const slots = new Map<HTMLElement, Run>();
+let phantoms: Run[] = [];
+let lastBase = new Map<HTMLElement, Span>();
+let lastExtent = new Map<HTMLElement, Span>();
+let lastGap = new Map<HTMLElement, number>();
+
+/** Map every x of an absolute M/L/C/Z path through `fx` (y untouched). */
+function mapX(d: string, fx: (x: number) => number): string {
+    return d.replace(/(-?\d+(?:\.\d+)?) (-?\d+(?:\.\d+)?)/g, (_, x: string, y: string) => `${+fx(Number(x)).toFixed(3)} ${y}`);
+}
+
+function glideTo(d: HTMLElement, from: Span, L: Span): void {
+    const g0 = glides.get(d);
+    if (g0) {
+        // retarget from the current value and velocity; a settled edge restarts from rest
+        for (const [s, k, t] of [[g0.s0, "d0", L.x0 - g0.b0], [g0.s1, "d1", L.x1 - g0.b1]] as const) {
+            if (s.live) s.retarget(t);
+            else s.playTo(g0[k], t, { onFrame: (v) => { g0[k] = v; }, onSettle: () => queueMicrotask(() => done(d, g0)) });
+        }
+        wake();
+        return;
+    }
+    const g: Glide = { b0: from.x0, b1: from.x1, d0: 0, d1: 0, s0: useDockSpring(DOCK_SPRING, HOST), s1: useDockSpring(DOCK_SPRING, HOST), onMorph: false };
+    glides.set(d, g);
+    const t0 = L.x0 - g.b0, t1 = L.x1 - g.b1;
+    // onFrame has already written the settled value (a retarget may have moved the target)
+    g.s0.playTo(0, t0, { onFrame: (v) => { g.d0 = v; }, onSettle: () => queueMicrotask(() => done(d, g)) });
+    g.s1.playTo(0, t1, { onFrame: (v) => { g.d1 = v; }, onSettle: () => queueMicrotask(() => done(d, g)) });
+    wake();
+}
+/** PF2 D2: move a glide's anchors to `to` and keep its painted edges. Each offset is re-seated
+    by the anchor's step and springs to 0, so the extent converges on `to`; `playTo` on a live
+    spring carries its velocity. */
+function reanchor(d: HTMLElement, g: Glide, to: Span): void {
+    for (const [s, k, b, n] of [[g.s0, "d0", "b0", to.x0], [g.s1, "d1", "b1", to.x1]] as const) {
+        const v = g[b] + g[k] - n;
+        g[b] = n;
+        g[k] = v;
+        s.playTo(v, 0, { onFrame: (x) => { g[k] = x; }, onSettle: () => queueMicrotask(() => done(d, g)) });
+    }
+    wake();
+}
+function done(d: HTMLElement, g: Glide): void {
+    if (g.s0.live || g.s1.live || glides.get(d) !== g) return;
+    glides.delete(d);
+    clearContentClip(d);
+    paint();
+}
+
+/** A run toward `to` (a slot opens to `full`, a phantom closes to 0): retarget a live one. */
+function runTo(r: Run, to: number): void {
+    if (r.spring.live) { r.spring.retarget(to); wake(); return; }
+    r.spring.playTo(r.s, to, {
+        onFrame: (v) => { r.s = v; },
+        onSettle: () => {
+            if (r.role === "slot") {
+                if (r.el && slots.get(r.el) === r) slots.delete(r.el);
+                if (r.el) { r.el.style.opacity = ""; clearContentClip(r.el); }
+            } else phantoms = phantoms.filter((x) => x !== r);
+            paint();
+        },
+    });
+    wake();
+}
+
+/** Read the painted boxes and write every clip. */
+function paint(): void {
+    const el = root.value;
+    if (!el) return;
+    const list = members;
+    if (list.length !== count.value || !list.length) return;
+    const dpr = window.devicePixelRatio || 1;
+    const base = el.getBoundingClientRect();
+    const raw = list.map((d) => d.getBoundingClientRect());
+    const sc = list.map((d, i) => scaleOf(d, raw[i]!));
+    const morph = list.map((d) => d.hasAttribute("data-morphing"));
+    const tCur = list.map((d) => tr.get(d) ?? 0);
+    const o = list.map((d) => offsets.get(d)?.o ?? 0);
+    // the member's layout box on the whole-px grid (its pure box plus the grid's shift)
+    const lay0: Span[] = list.map((d, i) => {
+        const p = pureBox(d, raw[i]!);
+        return { x0: p.x0 + shift, x1: p.x1 + shift };
+    });
+    // with the membership glide's offset (R-7: a leaver's survivors)
+    const lay: Span[] = lay0.map((L, i) => ({ x0: L.x0 + o[i]!, x1: L.x1 + o[i]! }));
+    // C3: a width change with no morph glides from the last painted extent; a glider whose
+    // layout moved at all re-bases its offsets from where it was painted
+    list.forEach((d, i) => {
+        const was = lastBase.get(d), from = lastExtent.get(d);
+        const L = lay0[i]!;
+        if (!was || !from || morph[i] || slots.has(d) || reduced.value) return;
+        const moved = Math.abs(was.x0 - lay[i]!.x0) > 0.01 || Math.abs(was.x1 - lay[i]!.x1) > 0.01;
+        if (glides.has(d) ? !moved : Math.abs(W(was) - W(L)) < 0.5) return;
+        if (Math.abs(from.x0 - L.x0) < 0.5 && Math.abs(from.x1 - L.x1) < 0.5 && !glides.has(d)) return;
+        const e = offsets.get(d);
+        if (e) { e.spring.dispose(); offsets.delete(d); lay[i] = { ...L }; o[i] = 0; }
+        glideTo(d, from, L);
+    });
+    // PF2 D2: a glide that a morph interrupts rides the morph's rect; one whose morph has
+    // settled returns to the layout box. Both keep the painted edges and their velocity.
+    list.forEach((d, i) => {
+        const g = glides.get(d);
+        if (!g || reduced.value) return;
+        if (morph[i] && !g.onMorph) {
+            g.onMorph = true;
+            clearContentClip(d);
+            reanchor(d, g, { x0: raw[i]!.left - tCur[i]! + shift + o[i]!, x1: raw[i]!.right - tCur[i]! + shift + o[i]! });
+        } else if (!morph[i] && g.onMorph) {
+            g.onMorph = false;
+            reanchor(d, g, lay[i]!);
+        }
+    });
+    // each member's painted extent: its scaled rect under its own morph (plus a glide it took
+    // over); its layout box plus its glide offsets; an opening slot is a droplet of `o` of its
+    // width; else its layout box
+    const ext: Span[] = list.map((d, i) => {
+        if (morph[i]) {
+            const x0 = raw[i]!.left - tCur[i]! + shift + o[i]!, x1 = raw[i]!.right - tCur[i]! + shift + o[i]!;
+            const g = glides.get(d);
+            if (!g?.onMorph) return { x0, x1 };
+            g.b0 = x0; g.b1 = x1;
+            return { x0: x0 + g.d0, x1: x1 + g.d1 };
+        }
+        const L = lay[i]!;
+        const s = slots.get(d);
+        if (s) { const c = (L.x0 + L.x1) / 2, w = W(L) * openOf(s); return { x0: c - w / 2, x1: c + w / 2 }; }
+        const g = glides.get(d);
+        return g ? { x0: g.b0 + g.d0, x1: g.b1 + g.d1 } : { ...L };
+    });
+    const open = list.map((d) => { const s = slots.get(d); return s ? openOf(s) : 1; });
+    // THE CHAIN: while anything moves, the row is painted from the first mover's extent outward,
+    // each member at its painted width, each gap its layout gap. An opening slot scales ONE of
+    // its gaps (its left one; its right one when it is first), so a slot at o and a phantom at
+    // o hold the same span; a phantom adds o of its width plus its gap where it stood.
+    const m = list.findIndex((d, i) => morph[i] || glides.has(d) || slots.has(d));
+    const P: Span[] = m < 0 ? lay.map((x) => ({ ...x })) : ext.map((x) => ({ ...x }));
+    const gapAt = (i: number) => {
+        // the gap between member i - 1 and member i
+        const lg = lay0[i]!.x0 - lay0[i - 1]!.x1;
+        const f = slots.has(list[i]!) ? open[i]! : i - 1 === 0 && slots.has(list[0]!) ? open[0]! : 1;
+        const ph = phantoms.reduce((a, p) => a + (p.after === list[i - 1] ? Math.max(0, p.s) : 0), 0);
+        return lg * f + ph;
+    };
+    if (m >= 0) {
+        for (let i = m + 1; i < list.length; i++) { const g = gapAt(i); P[i] = { x0: P[i - 1]!.x1 + g, x1: P[i - 1]!.x1 + g + W(ext[i]!) }; }
+        for (let i = m - 1; i >= 0; i--) { const g = gapAt(i + 1); P[i] = { x0: P[i + 1]!.x0 - g - W(ext[i]!), x1: P[i + 1]!.x0 - g }; }
+    }
+    // the translate that paints each member box there (C4: every one carries the grid's shift)
+    const tNew = list.map((d, i) => {
+        const p0 = lay0[i]!.x0 - shift; // the pure layout x
+        if (m < 0 || i === m) return o[i]! + shift;
+        if (morph[i]) return P[i]!.x0 - (glides.get(d)?.onMorph ? glides.get(d)!.d0 : 0) - p0 - sc[i]!.o * (1 - sc[i]!.k);
+        if (open[i]! < 1) return (P[i]!.x0 + P[i]!.x1) / 2 - (lay0[i]!.x0 + lay0[i]!.x1) / 2 + shift;
+        if (glides.has(d)) { const g = glides.get(d)!; return P[i]!.x0 - (g.b0 + g.d0 - lay0[i]!.x0) - p0; }
+        return P[i]!.x0 - p0;
+    });
+    list.forEach((d, i) => {
+        const t = Math.abs(tNew[i]!) < 1e-4 ? 0 : tNew[i]!;
+        tr.set(d, t);
+        const v = t === 0 ? "" : `${t}px 0`;
+        if (d.style.translate !== v) d.style.translate = v;
+        const op = open[i]! >= 0.999 ? "" : `${open[i]!.toFixed(3)}`;
+        if (d.style.opacity !== op) d.style.opacity = op;
+    });
+    lastBase = new Map(list.map((d, i) => [d, lay[i]!]));
+    lastExtent = new Map(list.map((d, i) => [d, P[i]!]));
+    lastGap = new Map(list.map((d, i) => [d, i > 0 ? lay0[i]!.x0 - lay0[i - 1]!.x1 : i + 1 < list.length ? lay0[1]!.x0 - lay0[0]!.x1 : 0]));
+    const rects = raw.map((r, i) => ({ left: P[i]!.x0, right: P[i]!.x1, top: r.top, bottom: r.bottom, height: r.height }));
