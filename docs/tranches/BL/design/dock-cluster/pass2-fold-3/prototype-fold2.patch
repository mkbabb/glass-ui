@@ -0,0 +1,45 @@
+import { inject, onBeforeUnmount, onMounted, provide, type InjectionKey, type Ref } from "vue";
+import type { DockHoldKind } from "./dockContext";
+
+/**
+ * A DockCluster member as the cluster sees it: its root, the hold it already
+ * publishes to its own descendants (`keepOpen`/`release`), its own leave, and
+ * whether it can collapse. The cluster takes one posture hold on every member
+ * while the reader is in the cluster, so reaching from the dock to a sibling
+ * member (the theme) never reads as leaving the dock (W-I.8 R-13). When the
+ * reader leaves the cluster, each member runs its own leave, so the collapse
+ * keeps the lone dock's timing. At most one member may be collapsible (R-8).
+ */
+export interface DockClusterMember {
+    el: HTMLElement;
+    keepOpen: (kind?: DockHoldKind) => void;
+    release: (kind?: DockHoldKind) => void;
+    /** The member's own pointer-leave (its collapse delay), run when the reader leaves the cluster. */
+    leave: () => void;
+    /** True when the member carries its own collapse (`collapse` is not `false`). */
+    collapsible: () => boolean;
+}
+
+export interface DockClusterContext {
+    register: (member: DockClusterMember) => () => void;
+}
+
+const DOCK_CLUSTER_KEY: InjectionKey<DockClusterContext> = Symbol("dock-cluster");
+
+export function provideDockClusterContext(ctx: DockClusterContext): void {
+    provide(DOCK_CLUSTER_KEY, ctx);
+}
+
+/** A GlassDock registers with its cluster, if it sits in one. */
+export function useDockClusterMember(
+    el: Readonly<Ref<HTMLElement | null>>,
+    hold: Omit<DockClusterMember, "el">,
+): void {
+    const cluster = inject(DOCK_CLUSTER_KEY, null);
+    if (!cluster) return;
+    let off: (() => void) | null = null;
+    onMounted(() => {
+        if (el.value) off = cluster.register({ el: el.value, ...hold });
+    });
+    onBeforeUnmount(() => off?.());
+}
