@@ -0,0 +1,560 @@
+<script setup lang="ts">
+/**
+ * DockCluster (W-I.8 FOLD build, scratch only): the spec-graft prototype with the
+ * challenge's cures folded in.
+ *   F1  one spring per join, each `useDockSpring(DOCK_SPRING)` (the constant itself).
+ *   F5  the ink's edge at a cut is the member plate's BOX edge, not a path edge.
+ *   F6  the whole-px grid is a margin, never a min-inline-size (no ratchet).
+ *   F7  membership glide: survivors translate from their painted place on the dock spring;
+ *       an arriver's share is clamped between its painted neighbours and opens.
+ *   F10/F11  the layout invariant (ltr, row, nowrap) throws when broken.
+ *   F12 members never shrink; an overflowing row is reported with console.error.
+ * PASS 2 (O-200, O-202, O-199, F5):
+ *   a member may carry GlassDock's own collapse: the silhouette is drawn from each member's
+ *     PAINTED extent (its scaled rect under its morph), and its plate's clip is mapped through
+ *     its own scale; the morph's frame paints the cluster (here a style observer);
+ *   a width change with no morph (a DockLayerGroup face swap) glides the extent on the dock
+ *     spring; an arriver opens from zero width; a leaver leaves a closing phantom; while
+ *     anything moves the row is painted as a CHAIN from the first mover outward;
+ *   the corner is half the cross extent (a capsule run);
+ *   one ink painter and one tone lens: no ink or tone cut anywhere (F5's root);
+ *   PRM: the joins seat in the frame a member's own snap lands.
+ */
+import { useMediaQuery } from "@vueuse/core";
+import { computed, onMounted, onUnmounted, ref, useTemplateRef, watch } from "vue";
+import { DOCK_SPRING } from "./constants";
+import { useDockSpring, type DockSpring } from "./composables/useDockSpring";
+import {
+    GLASS_BACKDROP_SHARED_ATTR,
+    useGlassBackdropLuminance,
+} from "../../composables/glass/useGlassBackdropLuminance";
+import { clusterShape, rectPath, shiftPath, type PlateBox } from "./composables/dockClusterShape";
+
+const props = withDefaults(defineProps<{ fused?: boolean | readonly boolean[] }>(), {
+    fused: false,
+});
+
+const SHADOW_PAD = 40;
+const OVERRUN = 2;
+
+const root = useTemplateRef<HTMLElement>("root");
+const shadowEl = useTemplateRef<HTMLElement>("shadowEl");
+const shadowFill = useTemplateRef<HTMLElement>("shadowFill");
+const lensEls = ref<HTMLElement[]>([]);
+const toneEls = ref<HTMLElement[]>([]);
+useGlassBackdropLuminance(root, { shared: true });
+const count = ref(0);
+const reduced = useMediaQuery("(prefers-reduced-motion: reduce)");
+
+const target = computed(() =>
+    Array.from({ length: Math.max(0, count.value - 1) }, (_, i) =>
+        (typeof props.fused === "boolean" ? props.fused : props.fused[i]) ? 1 : 0,
+    ),
+);
+
+let members: HTMLElement[] = [];
+let now: number[] = [];
+let springs: DockSpring[] = [];
+const offsets = new Map<HTMLElement, { o: number; spring: DockSpring }>();
+let arrivers = new Set<HTMLElement>();
+let painted = new Map<HTMLElement, { x0: number; x1: number }>();
+let raf = 0;
+let morphingChildren = 0;
+(window as unknown as { __clusterNow?: () => number[] }).__clusterNow = () => [...now];
+
+function docks(): HTMLElement[] {
+    return root.value ? [...root.value.querySelectorAll<HTMLElement>(":scope > .glass-dock")] : [];
+}
+
+/** F10/F11: the share path is physical LTR along one row. Anything else throws. */
+function assertLayout(): void {
+    const el = root.value;
+    if (!el) return;
+    const cs = getComputedStyle(el);
+    const bad =
+        cs.direction !== "ltr" ? `direction: ${cs.direction}` :
+        cs.flexDirection !== "row" ? `flex-direction: ${cs.flexDirection}` :
+        cs.flexWrap !== "nowrap" ? `flex-wrap: ${cs.flexWrap}` : "";
+    if (bad) throw new Error(`DockCluster: ${bad} is not supported; a cluster is one LTR row (W-I.8 R-10, §6)`);
+}
+
+let shift = 0;
+let overflowing = false;
+/** F6: whole-px member offsets by margin (no width is held, so a shrink still resizes). */
+function regrid(list: HTMLElement[]): void {
+    const el = root.value;
+    if (!el || !list.length) return;
+    list.forEach((d, i) => {
+        if (i === list.length - 1) return;
+        const t = (d.style.translate && parseFloat(d.style.translate)) || 0;
+        void t;
+        const w = d.getBoundingClientRect().width;
+        const m = Math.ceil(w - 0.01) - w;
+        // full precision: both engines lay out in 1/64 px, and a rounded margin
+        // (0.4531 for 0.453125) left WebKit's members at x.984 (fold F5, WebKit)
+        const v = m > 1e-3 ? `${m}px` : "";
+        if (d.style.marginInlineEnd !== v) d.style.marginInlineEnd = v;
+    });
+    const r0 = list[0]!.getBoundingClientRect();
+    const o0 = offsets.get(list[0]!)?.o ?? 0;
+    const left0 = r0.left - o0 - shift;
+    const want = -(left0 - Math.floor(left0));
+    if (Math.abs(want - shift) > 1e-3) {
+        shift = want;
+        el.style.left = `${shift}px`;
+    }
+    // F12: a row wider than its container is the host's to fix (R-10); say so, loudly.
+    const host = el.parentElement?.getBoundingClientRect();
+    const rr = el.getBoundingClientRect();
+    const over = host ? Math.max(host.left - rr.left, rr.right - host.right) : 0;
+    if (over > 0.5 && !overflowing) {
+        console.error(`DockCluster: the row needs ${rr.width.toFixed(1)}px and its container gives ${host!.width.toFixed(1)}px; compose two rows (W-I.8 R-10)`);
+        el.setAttribute("data-overflow", "");
+    } else if (over <= 0.5 && overflowing) el.removeAttribute("data-overflow");
+    overflowing = over > 0.5;
+}
+
+/* ── PASS 2: the painted extent ─────────────────────────────────────────────────────
+   A member's PAINTED extent is what the silhouette is drawn from. It is its layout box,
+   except while (a) GlassDock's own collapse morph runs (`[data-morphing]`: the box reserves
+   its expanded footprint and paints at `scale: k 1` about `--dock-morph-origin`; the
+   painted extent is its scaled rect), or (b) its width changed with no morph (a
+   DockLayerGroup face swap, a control added): the extent glides from where it was painted
+   to its new box on its own `useDockSpring(DOCK_SPRING)`. While a member moves, the
+   members on each side ride its painted edge (one `translate` shift per side), so the
+   row never steps and two shares never overlap. Layout never animates (P5). */
+type Span = { x0: number; x1: number };
+interface Glide { from: Span | null; p: number; spring: DockSpring }
+const glides = new Map<HTMLElement, Glide>();
+let phantoms: { at: number; w: number; g: number; p: number; spring: DockSpring }[] = [];
+const tr = new Map<HTMLElement, number>();
+let lastBase = new Map<HTMLElement, Span>();
+let lastExtent = new Map<HTMLElement, Span>();
+const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
+const query = new URLSearchParams(location.search);
+/** scratch switches for the pass-2 A/B (never shipped): ?follow=0, ?glide=0, ?cede=0, ?scalemap=0 */
+const sw = (k: string) => query.get(k) !== "0";
+
+/** Map every x of an absolute M/L/C/Z path through `fx` (y untouched). */
+function mapX(d: string, fx: (x: number) => number): string {
+    return d.replace(/(-?\d+(?:\.\d+)?) (-?\d+(?:\.\d+)?)/g, (_, x: string, y: string) => `${+fx(Number(x)).toFixed(3)} ${y}`);
+}
+
+function scaleOf(d: HTMLElement, r: DOMRect): { k: number; o: number } {
+    if (!d.hasAttribute("data-morphing")) return { k: 1, o: 0 };
+    const w = d.offsetWidth;
+    const k = w > 0 ? r.width / w : 1;
+    const o = Number.parseFloat(getComputedStyle(d).transformOrigin) || 0;
+    return { k, o };
+}
+
+/** A glide from `from` (null: an arriver, from zero width) to the member's layout box. */
+function startGlide(d: HTMLElement, from: Span | null): void {
+    const g = glides.get(d) ?? { from, p: 0, spring: useDockSpring(DOCK_SPRING) };
+    g.from = from;
+    g.p = 0;
+    glides.set(d, g);
+    g.spring.playTo(0, 1, {
+        onFrame: (v) => { g.p = v; },
+        onSettle: () => { glides.delete(d); arrivers.delete(d); g.spring.dispose(); clearContentClip(d); paint(); },
+    });
+    wake();
+}
+
+/** Read the painted boxes and write every clip. */
+function paint(): void {
+    const el = root.value;
+    if (!el) return;
+    const list = members;
+    if (list.length !== count.value || !list.length) return;
+    const dpr = window.devicePixelRatio || 1;
+    const base = el.getBoundingClientRect();
+    const gap = Number.parseFloat(getComputedStyle(el).columnGap) || 0;
+    const raw = list.map((d) => d.getBoundingClientRect());
+    const sc = list.map((d, i) => scaleOf(d, raw[i]!));
+    const morph = list.map((d) => d.hasAttribute("data-morphing"));
+    // the member's pure layout box (every translate the cluster wrote, and its own scale, removed)
+    const tCur = list.map((d) => tr.get(d) ?? 0);
+    const o = list.map((d) => offsets.get(d)?.o ?? 0);
+    const lay0: Span[] = list.map((d, i) => {
+        const { k, o: org } = sc[i]!;
+        const x0 = raw[i]!.left - tCur[i]! - org * (1 - k);
+        return { x0, x1: x0 + (morph[i] ? d.offsetWidth : raw[i]!.width) };
+    });
+    // the layout box with the membership glide's offset (R-7: a leaver's survivors)
+    const lay: Span[] = lay0.map((L, i) => ({ x0: L.x0 + o[i]!, x1: L.x1 + o[i]! }));
+    // (b) a width change with no morph starts a glide from the last painted extent
+    list.forEach((d, i) => {
+        const was = lastBase.get(d), from = lastExtent.get(d);
+        const L = lay[i]!;
+        if (!was || !from || morph[i] || arrivers.has(d) || reduced.value || !sw("glide")) return;
+        if (Math.abs((was.x1 - was.x0) - (L.x1 - L.x0)) < 0.5) return;
+        if (Math.abs(from.x0 - L.x0) < 0.5 && Math.abs(from.x1 - L.x1) < 0.5) return;
+        startGlide(d, { ...from });
+    });
+    // a glider carries its own continuity from where it was painted: it drops any R-7 offset
+    list.forEach((d, i) => {
+        const e = offsets.get(d);
+        if (e && glides.get(d)?.from) { e.spring.dispose(); offsets.delete(d); lay[i] = { ...lay0[i]! }; o[i] = 0; }
+    });
+    const W = (x: Span) => x.x1 - x.x0;
+    // each member's painted extent: its scaled rect under its own morph; a lerp from where it
+    // was painted while it glides; an arriver opens from zero width; otherwise its layout box
+    const ext: Span[] = list.map((d, i) => {
+        if (morph[i]) return { x0: raw[i]!.left - tCur[i]! + o[i]!, x1: raw[i]!.right - tCur[i]! + o[i]! };
+        const g = glides.get(d);
+        const L = lay[i]!;
+        if (g && !g.from) { const c = (L.x0 + L.x1) / 2, w = W(L) * g.p; return { x0: c - w / 2, x1: c + w / 2 }; }
+        return g && g.from ? { x0: lerp(g.from.x0, L.x0, g.p), x1: lerp(g.from.x1, L.x1, g.p) } : { ...L };
+    });
+    const open = list.map((d) => { const g = glides.get(d); return g && !g.from ? Math.max(0, Math.min(1, g.p)) : 1; });
+    // THE CHAIN: while anything moves, the row is painted from the first mover's extent outward,
+    // each member at its painted width, each gap its layout gap (an arriver's gaps open with it)
+    const m = sw("follow") ? list.findIndex((d, i) => morph[i] || glides.has(d)) : -1;
+    const P: Span[] = m < 0 ? lay.map((x) => ({ ...x })) : ext.map((x) => ({ ...x }));
+    if (m >= 0) {
+        const shut = (i: number) => phantoms.reduce((a, ph) => a + (ph.at === i ? (ph.w + ph.g) * (1 - ph.p) : 0), 0);
+        for (let i = m + 1; i < list.length; i++) {
+            const g = (lay0[i]!.x0 - lay0[i - 1]!.x1) * Math.min(open[i - 1]!, open[i]!) + shut(i);
+            P[i] = { x0: P[i - 1]!.x1 + g, x1: P[i - 1]!.x1 + g + W(ext[i]!) };
+        }
+        for (let i = m - 1; i >= 0; i--) {
+            const g = (lay0[i + 1]!.x0 - lay0[i]!.x1) * Math.min(open[i]!, open[i + 1]!) + shut(i + 1);
+            P[i] = { x0: P[i + 1]!.x0 - g - W(ext[i]!), x1: P[i + 1]!.x0 - g };
+        }
+    }
+    // the translate that paints each member box there (an arriver's full box centred on its droplet)
+    const tNew = list.map((d, i) => {
+        if (i === m || m < 0) return o[i]!;
+        if (morph[i]) return P[i]!.x0 - lay0[i]!.x0 - sc[i]!.o * (1 - sc[i]!.k);
+        if (open[i]! < 1) return (P[i]!.x0 + P[i]!.x1) / 2 - (lay0[i]!.x0 + lay0[i]!.x1) / 2;
+        return P[i]!.x0 - lay0[i]!.x0;
+    });
+    list.forEach((d, i) => {
+        const t = Math.abs(tNew[i]!) < 0.01 ? 0 : tNew[i]!;
+        tr.set(d, t);
+        const v = t === 0 ? "" : `${t}px 0`;
+        if (d.style.translate !== v) d.style.translate = v;
+        const op = open[i]! >= 0.999 ? "" : `${open[i]!.toFixed(3)}`;
+        if (d.style.opacity !== op) d.style.opacity = op;
+    });
+    lastBase = new Map(list.map((d, i) => [d, lay[i]!]));
+    lastExtent = new Map(list.map((d, i) => [d, P[i]!]));
+    const rects = raw.map((r, i) => ({ left: P[i]!.x0, right: P[i]!.x1, top: r.top, bottom: r.bottom, width: W(P[i]!), height: r.height }));
+    const boxes: PlateBox[] = list.map((_, i) => {
+        const r = rects[i]!;
+        const x0 = r.left - base.left, x1 = r.right - base.left;
+        // O-199: the corner is half the cross extent, in px; the silhouette is a capsule run.
+        // An opening member is a droplet: while narrower than tall it is a circle of its width.
+        const cy = (r.top + r.bottom) / 2 - base.top, h = Math.min(r.height, Math.max(0, x1 - x0));
+        return { x0, x1, y0: cy - h / 2, y1: cy + h / 2, r: h / 2 };
+    });
+    painted = new Map(list.map((d, i) => [d, { x0: rects[i]!.left, x1: rects[i]!.right }]));
+    const snap = (x: number) => Math.round((x + base.left) * dpr) / dpr - base.left;
+    // a member under its own morph clips its box (shell.css, the morph clip), so it cedes
+    // the bridge: the cut sits on its painted edge and the neighbour's ink spans the gap.
+    // ONE INK (pass 2, F5): every member paints the same ink (one tint, R-6; one tier, cluster.css),
+    // so one member's own .dock-plate inks the whole silhouette and the others stand their ink
+    // down. There is then no ink cut anywhere, at any device ratio. The painter is the first
+    // member not under its own morph (a morphing member clips its box); it sits at z 0, under
+    // every other member's controls. ?ink=share is the fold's per-share ink, for the A/B.
+    const oneInk = query.get("ink") !== "share";
+    const painter = oneInk ? Math.max(0, morph.findIndex((v) => !v)) : -1;
+    const cede = sw("cede") && !oneInk;
+    const cutAt = (mid: number, i: number) =>
+        cede && morph[i] && !morph[i + 1] ? boxes[i]!.x1 : cede && morph[i + 1] && !morph[i] ? boxes[i + 1]!.x0 : snap(mid);
+    const joins = now.length === boxes.length - 1 ? now : target.value;
+    const { shares, silhouette, necks, cuts } = clusterShape(boxes, joins, cutAt);
+    const w = Number.parseFloat(getComputedStyle(el).getPropertyValue("--dock-cluster-rim")) || 1.5;
+    const inner = clusterShape(boxes, joins, cutAt, w).silhouette;
+    // the lenses, the tone and the shadow span the PAINTED silhouette, which a shrinking glide or
+    // a closing phantom paints wider than the row's layout box: they overhang the root by `pad`
+    const minX = Math.min(...boxes.map((b) => b.x0)), maxX = Math.max(...boxes.map((b) => b.x1));
+    const pad = Math.ceil(Math.max(0, -minX, maxX - base.width)) + 2;
+    const padIn = `${-pad}px`;
+    for (const e of [...lensEls.value, ...toneEls.value]) if (e && e.style.insetInline !== padIn) e.style.insetInline = padIn;
+    const atPad = (d: string) => shiftPath(d, pad, 0);
+    shares.forEach((d, i) => {
+        // the kernel lenses overlap by one px across each contacted neck: a second blur of a
+        // blurred field moves no mean (R-2), so the overlap paints nothing, and no column at a
+        // cut is left to two partial coverages where the backdrop is not flat (the shadow's edge)
+        const lens = lensEls.value[i];
+        let lp = d;
+        if (i > 0 && necks[i - 1]) lp += " " + rectPath(cuts[i - 1]! - 1, necks[i - 1]![0], cuts[i - 1]! + 1, necks[i - 1]![1]);
+        if (i < shares.length - 1 && necks[i]) lp += " " + rectPath(cuts[i]! - 1, necks[i]![0], cuts[i]! + 1, necks[i]![1]);
+        if (lens) lens.style.clipPath = `path("${atPad(lp)}")`;
+        // ONE TONE (pass 2, F5): the tone is pointwise and the same for every member, so one tone
+        // lens spans the whole silhouette and has no cut; each member keeps its own kernel lens (b).
+        // ?tone=share is the fold's per-share tone, for the A/B.
+        const tone = toneEls.value[i];
+        const oneTone = query.get("tone") !== "share";
+        if (tone) tone.style.clipPath = !oneTone ? `path("${atPad(d)}")` : i === 0 ? `path("${atPad(silhouette)}")` : "inset(50%)";
+        const member = list[i]!;
+        const plate = member.querySelector<HTMLElement>(":scope > .dock-plate");
+        if (!plate) return;
+        // the member box as painted this frame (its follow shift applied, its scale kept)
+        const df = tNew[i]! - tCur[i]!;
+        const bl = raw[i]!.left + df, br = raw[i]!.right + df;
+        const k = sw("scalemap") ? sc[i]!.k : 1;
+        const inks = !oneInk || i === painter;
+        const ink = inks ? "" : "hidden";
+        if (plate.style.visibility !== ink) plate.style.visibility = ink;
+        const z = oneInk && i === painter ? "0" : "";
+        if (member.style.zIndex !== z) member.style.zIndex = z;
+        // F5 (fold): at a contacted join the plate's BOX edge sits on the cut and the path overruns it.
+        // One ink: the painter's plate spans the whole silhouette, so it has no cut.
+        const span = oneInk && i === painter;
+        const X0 = span ? Math.floor(boxes[0]!.x0) - 1 : i > 0 ? cuts[i - 1]! : Math.floor(boxes[i]!.x0);
+        const X1 = span ? Math.ceil(boxes.at(-1)!.x1) + 1 : i < boxes.length - 1 ? cuts[i]! : Math.ceil(boxes[i]!.x1);
+        // a scaled member paints its plate in its own (unscaled) px: divide the inline insets by k
+        const inset = `${base.top - raw[i]!.top}px ${(br - (base.left + X1)) / k}px ${raw[i]!.bottom - base.bottom}px ${(base.left + X0 - bl) / k}px`;
+        if (plate.style.inset !== inset) plate.style.inset = inset;
+        let path = span ? silhouette : d;
+        if (!span) plate.style.setProperty("--dock-cluster-grain-x", "0px");
+        else plate.style.setProperty("--dock-cluster-grain-x", `${-X0}px`);
+        if (!span && i > 0 && necks[i - 1] && !(cede && (morph[i] || morph[i - 1]))) path += " " + rectPath(X0 - OVERRUN, necks[i - 1]![0], X0 + 1, necks[i - 1]![1]);
+        if (!span && i < boxes.length - 1 && necks[i] && !(cede && (morph[i] || morph[i + 1]))) path += " " + rectPath(X1 - 1, necks[i]![0], X1 + OVERRUN, necks[i]![1]);
+        // the share is drawn in painted px; a member at scale k paints its plate through k,
+        // so its clip is the share mapped through 1/k (circular corners stay circular)
+        const toLocal = (x: number) => (x - X0) / k;
+        plate.style.clipPath = `path("${mapX(path, toLocal)}")`;
+        plate.style.setProperty("--dock-ring-clip", `path(evenodd, "${mapX(silhouette, toLocal)} ${mapX(inner, toLocal)}")`);
+        // a gliding member's face content is held inside its silhouette (the G12 element)
+        if (glides.has(member)) {
+            for (const fc of member.querySelectorAll<HTMLElement>(".dock-face-content")) {
+                const r = fc.getBoundingClientRect();
+                // the content box as painted this frame; the inset may be negative (a leaving face overflows its box)
+                const L = base.left + boxes[i]!.x0 - (r.left + df), R = r.right + df - (base.left + boxes[i]!.x1);
+                fc.style.clipPath = `inset(-24px ${R.toFixed(2)}px -24px ${L.toFixed(2)}px)`;
+            }
+        }
+    });
+    const shifted = shiftPath(silhouette, SHADOW_PAD + pad, SHADOW_PAD);
+    if (shadowFill.value) shadowFill.value.style.clipPath = `path("${shifted}")`;
+    if (shadowEl.value) {
+        const sIn = `${-(SHADOW_PAD + pad)}px`;
+        if (shadowEl.value.style.insetInline !== sIn) shadowEl.value.style.insetInline = sIn;
+        const W = base.width + 2 * (SHADOW_PAD + pad);
+        const H = base.height + 2 * SHADOW_PAD;
+        shadowEl.value.style.clipPath = `path(evenodd, "M0 0 L${W} 0 L${W} ${H} L0 ${H} Z ${shifted}")`;
+    }
+    (window as unknown as { __clusterPaint?: unknown }).__clusterPaint = { m, follow: tNew, boxes: boxes.map((b) => [b.x0 + base.left, b.x1 + base.left]), k: sc.map((s) => s.k), morph, gliding: list.map((d) => glides.has(d)) };
+}
+function clearContentClip(d: HTMLElement): void {
+    for (const fc of d.querySelectorAll<HTMLElement>(".dock-face-content")) fc.style.removeProperty("clip-path");
+}
+
+const live = () =>
+    springs.some((s) => s.live) || [...offsets.values()].some((v) => v.spring.live) || morphingChildren > 0 || glides.size > 0 || phantoms.length > 0;
+function tick(): void {
+    raf = 0;
+    paint();
+    if (live()) raf = requestAnimationFrame(tick);
+    else if (arrivers.size) {
+        arrivers.forEach((d) => (d.style.opacity = ""));
+        arrivers = new Set();
+        paint();
+    }
+}
+function wake(): void {
+    if (!raf) raf = requestAnimationFrame(tick);
+}
+
+/** F1: one spring per join. A join whose target is unchanged is not touched. */
+function play(next: number[]): void {
+    if (now.length !== next.length) {
+        now = [...next];
+        paint();
+        return;
+    }
+    if (reduced.value) {
+        crossfade(next);
+        return;
+    }
+    next.forEach((t, i) => {
+        if (t === (springs[i] as unknown as { _to?: number })?._to && springs[i]!.live) return;
+        if (!springs[i]!.live && Math.abs(now[i]! - t) < 1e-6) return;
+        (springs[i] as unknown as { _to?: number })._to = t;
+        springs[i]!.playTo(now[i]!, t, {
+            onFrame: (v) => {
+                now[i] = v;
+            },
+            onSettle: () => {
+                now[i] = t;
+                paint();
+            },
+        });
+    });
+    wake();
+}
+
+let fading: Animation[] = [];
+/* O-198 in a cluster: a member's own state change snaps its geometry at once (GlassDock's
+   reduced-motion path); the joins seat in that same frame, so the change is one geometry
+   frame, never two. A join-only change still seats at the floor of the dip. */
+let pendingSeat: number[] | null = null;
+function crossfade(next: number[]): void {
+    const el = root.value;
+    if (!el) return;
+    const mats = [
+        ...lensEls.value,
+        ...toneEls.value,
+        ...(shadowEl.value ? [shadowEl.value] : []),
+        ...members.map((d) => d.querySelector<HTMLElement>(":scope > .dock-plate")).filter((x): x is HTMLElement => !!x),
+    ];
+    const raw = getComputedStyle(el).getPropertyValue("--dock-cluster-swap").trim();
+    const ms = raw.endsWith("ms") ? Number.parseFloat(raw) : Number.parseFloat(raw) * 1000;
+    const duration = Number.isFinite(ms) && ms > 0 ? ms : 0;
+    fading.forEach((a) => a.cancel());
+    pendingSeat = next;
+    const out = mats.map((m) => m.animate([{ opacity: 1 }, { opacity: 0 }], { duration, easing: "ease-in", fill: "forwards" }));
+    fading = out;
+    void Promise.all(out.map((a) => a.finished)).then(() => {
+        pendingSeat = null;
+        now = [...next];
+        paint();
+        const back = mats.map((m) => m.animate([{ opacity: 0 }, { opacity: 1 }], { duration, easing: "ease-out" }));
+        out.forEach((a) => a.cancel());
+        fading = back;
+    }, () => {});
+}
+
+watch(target, (next) => play(next));
+
+/** Membership: re-index joins by member, glide survivors from where they were painted. */
+function observe(): void {
+    const list = docks();
+    const prev = members;
+    const changed = list.length !== prev.length || list.some((d, i) => d !== prev[i]);
+    assertLayout();
+    if (changed) {
+        const oldJoin = new Map(prev.slice(0, -1).map((d, i) => [d, now[i] ?? 0]));
+        const t = Array.from({ length: Math.max(0, list.length - 1) }, (_, i) =>
+            (typeof props.fused === "boolean" ? props.fused : props.fused[i]) ? 1 : 0,
+        );
+        const nextNow = t.map((tv, k) => {
+            const a = list[k]!;
+            if (oldJoin.has(a)) return oldJoin.get(a)!;
+            const left = k > 0 ? list[k - 1] : undefined;
+            if (left && oldJoin.has(left)) return oldJoin.get(left)!;
+            return tv;
+        });
+        springs.forEach((s) => s.dispose());
+        springs = t.map(() => useDockSpring(DOCK_SPRING));
+        const firstMount = prev.length === 0;
+        members = list;
+        count.value = list.length;
+        now = nextNow;
+        for (const d of [...offsets.keys()]) if (!list.includes(d)) { offsets.get(d)!.spring.dispose(); offsets.delete(d); }
+        regrid(list);
+        if (!firstMount && !reduced.value) {
+            arrivers = new Set(list.filter((d) => !prev.includes(d)));
+            // an arrival is painted by the chain (the arriver opens, its neighbours ride it);
+            // only a pure leave needs the survivors' own glide (R-7)
+            for (const d of arrivers.size && sw("follow") ? [] : list) {
+                if (arrivers.has(d)) continue;
+                const was = painted.get(d);
+                if (!was) continue;
+                const cur = offsets.get(d)?.o ?? 0;
+                const layoutX0 = d.getBoundingClientRect().left - (tr.get(d) ?? 0);
+                const from = was.x0 - layoutX0;
+                if (Math.abs(from) < 0.25) continue;
+                const entry = offsets.get(d) ?? { o: 0, spring: useDockSpring(DOCK_SPRING) };
+                offsets.set(d, entry);
+                entry.o = from;
+                entry.spring.playTo(from, 0, {
+                    onFrame: (v) => {
+                        entry.o = v;
+                    },
+                    onSettle: () => {
+                        entry.o = 0;
+                    },
+                });
+            }
+            arrivers.forEach((d) => { d.style.opacity = "0"; startGlide(d, null); });
+            // a leaver leaves a closing phantom in the chain: the gap it held closes on the dock
+            // spring, so a mover's neighbours never jump into its place
+            phantoms.forEach((ph) => ph.spring.dispose());
+            phantoms = [];
+            prev.forEach((d, idx) => {
+                if (list.includes(d)) return;
+                const was = painted.get(d);
+                const nb = painted.get(prev[idx - 1]!) ?? null;
+                if (!was) return;
+                const at = prev.slice(0, idx).filter((x) => list.includes(x)).length;
+                const ph = { at, w: was.x1 - was.x0, g: nb ? was.x0 - nb.x1 : 0, p: 0, spring: useDockSpring(DOCK_SPRING) };
+                phantoms.push(ph);
+                ph.spring.playTo(0, 1, { onFrame: (v) => { ph.p = v; }, onSettle: () => { phantoms = phantoms.filter((x) => x !== ph); ph.spring.dispose(); paint(); } });
+            });
+        }
+        // carry the joins toward the (re-indexed) targets
+        t.forEach((tv, i) => {
+            if (Math.abs(now[i]! - tv) < 1e-6) return;
+            (springs[i] as unknown as { _to?: number })._to = tv;
+            springs[i]!.playTo(now[i]!, tv, { onFrame: (v) => (now[i] = v), onSettle: () => { now[i] = tv; paint(); } });
+        });
+    }
+    ro?.disconnect();
+    if (root.value) ro?.observe(root.value);
+    if (root.value?.parentElement) ro?.observe(root.value.parentElement);
+    for (const d of list) ro?.observe(d);
+    ms?.disconnect();
+    for (const d of list) ms?.observe(d, { attributes: true, attributeFilter: ["style"] });
+    morphingChildren = list.filter((d) => d.hasAttribute("data-morphing")).length;
+    paint();
+    if (live()) wake();
+}
+
+let ro: ResizeObserver | null = null;
+let mo: MutationObserver | null = null;
+let ms: MutationObserver | null = null;
+const seenT = new WeakMap<HTMLElement, string>();
+onMounted(() => {
+    ro = new ResizeObserver(() => {
+        assertLayout();
+        if (reduced.value && pendingSeat && pendingSeat.length === now.length) now = [...pendingSeat];
+        regrid(members);
+        paint();
+        if (live()) wake();
+    });
+    mo = new MutationObserver(() => observe());
+    // the member's own morph writes its scalar on its root's style each spring frame; this
+    // observer's microtask runs right after that callback, so the silhouette is painted from
+    // the same frame's scale, whatever the rAF order (the wave: a dockClusterContext hook)
+    // only the member's own scalar wakes it: the cluster's own writes (translate, opacity) do not
+    ms = new MutationObserver(() => {
+        let moved = false;
+        for (const d of members) {
+            const t = d.style.getPropertyValue("--dock-morph-t");
+            if (seenT.get(d) !== t) { seenT.set(d, t); moved = true; }
+        }
+        if (moved) paint();
+    });
+    if (root.value) mo.observe(root.value, { childList: true, subtree: true, attributes: true, attributeFilter: ["data-morphing", "dir"] });
+    observe();
+    now = [...target.value];
+    paint();
+});
+
+onUnmounted(() => {
+    ro?.disconnect();
+    mo?.disconnect();
+    ms?.disconnect();
+    if (raf) cancelAnimationFrame(raf);
+    springs.forEach((s) => s.dispose());
+    offsets.forEach((v) => v.spring.dispose());
+});
+</script>
+
+<template>
+    <div ref="root" class="dock-cluster" :[GLASS_BACKDROP_SHARED_ATTR]="''">
+        <div ref="shadowEl" class="dock-cluster-shadow" aria-hidden="true">
+            <div class="dock-cluster-shadow-blur">
+                <div ref="shadowFill" class="dock-cluster-shadow-fill"></div>
+            </div>
+        </div>
+        <div v-for="i in count" :key="i" :ref="(el) => { if (el) lensEls[i - 1] = el as HTMLElement }" class="dock-cluster-lens" aria-hidden="true"></div>
+        <div v-for="i in count" :key="`t${i}`" :ref="(el) => { if (el) toneEls[i - 1] = el as HTMLElement }" class="dock-cluster-tone" aria-hidden="true"></div>
+        <slot />
+    </div>
+</template>
