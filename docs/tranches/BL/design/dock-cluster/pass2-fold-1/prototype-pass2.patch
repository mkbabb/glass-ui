+// I8-G5 source arm (fold): every spring the cluster mints is handed the DOCK_SPRING constant itself.
+import { mount } from "@vue/test-utils";
+import { h } from "vue";
+import { describe, expect, it, vi } from "vitest";
+
+const seen: unknown[] = [];
+vi.mock("@glass/components/dock/composables/useDockSpring", async (orig) => {
+    const real = (await orig()) as typeof import("@glass/components/dock/composables/useDockSpring");
+    return { ...real, useDockSpring: (cfg: never) => { seen.push(cfg); return real.useDockSpring(cfg); } };
+});
+
+describe("I8-G5 · the cluster's spring is springPreset('dock') by reference", () => {
+    it("passes DOCK_SPRING, never a literal, a copy or a local constant", async () => {
+        const { DOCK_SPRING } = await import("@glass/components/dock/constants");
+        const { default: DockCluster } = await import("@glass/components/dock/DockCluster.vue");
+        const w = mount(DockCluster, {
+            props: { fused: [true, false] },
+            attrs: { style: "display:flex;flex-direction:row;flex-wrap:nowrap;direction:ltr" },
+            slots: { default: () => [0, 1, 2].map((i) => h("div", { class: "glass-dock", key: i }, [h("div", { class: "dock-plate" })])) },
+            attachTo: document.body,
+        });
+        await new Promise((r) => setTimeout(r, 20));
+        expect(seen.length).toBeGreaterThan(0);
+        for (const cfg of seen) expect(cfg).toBe(DOCK_SPRING);
+        w.unmount();
+    });
+});
