+<script setup lang="ts">
+/* Fixture for DockCluster (O-195 proposal B). Query: n=2|3, fused=0|1, variant=cluster|ancestor. */
+import { computed, nextTick, onMounted, ref, useTemplateRef } from "vue";
+import { Bookmark, Moon, Search, Sun } from "@lucide/vue";
+import { DockCluster, DockControl, GlassDock } from "../../src/components/dock";
+
+const q = new URLSearchParams(location.search);
+const n = Number(q.get("n") ?? 3);
+const variant = q.get("variant") ?? "cluster";
+const dark = q.get("dark") === "1";
+const narrow = window.innerWidth < 500;
+const tabs = narrow ? ["Home", "Read"] : ["Home", "Read", "Listen", "About"];
+const active = ref(1);
+const fused = ref(q.get("fused") === "1");
+const joins = computed(() => Array.from({ length: n - 1 }, () => fused.value));
+const cluster = useTemplateRef<InstanceType<typeof DockCluster>>("cluster");
+
+declare global {
+    interface Window {
+        __cluster?: { set(f: boolean): void; seat(j: number[]): void };
+        __ready?: boolean;
+    }
+}
+onMounted(async () => {
+    window.__cluster = {
+        set: (f) => (fused.value = f),
+        seat: (j) => cluster.value?.seat(j),
+    };
+    await document.fonts.ready;
+    await nextTick();
+    requestAnimationFrame(() => requestAnimationFrame(() => (window.__ready = true)));
+});
+</script>
+
+<template>
+    <main class="stage" :data-variant="variant" :data-exp="q.get('exp') ?? ''">
+        <div class="field" aria-hidden="true">
+            <p v-for="i in 14" :key="i">glass reads what lies under it — {{ i }}</p>
+        </div>
+
+        <DockCluster v-if="variant === 'cluster'" ref="cluster" :joins="joins" class="probe" data-testid="cluster">
+            <GlassDock fit-content :collapse="false" aria-label="Pages">
+                <DockControl v-for="(t, i) in tabs" :key="t" shape="tab" :active="i === active" @click="active = i">{{ t }}</DockControl>
+            </GlassDock>
+            <GlassDock fit-content :collapse="false" aria-label="Controls">
+                <DockControl aria-label="Search"><Search /></DockControl>
+                <DockControl aria-label="Bookmark"><Bookmark /></DockControl>
+                <DockControl v-if="n === 2" :aria-label="dark ? 'Light theme' : 'Dark theme'"><Moon v-if="!dark" /><Sun v-else /></DockControl>
+            </GlassDock>
+            <GlassDock v-if="n === 3" fit-content :collapse="false" aria-label="Theme">
+                <DockControl :aria-label="dark ? 'Light theme' : 'Dark theme'"><Moon v-if="!dark" /><Sun v-else /></DockControl>
+            </GlassDock>
+        </DockCluster>
+
+        <!-- The naive shared silhouette: ONE ancestor owns the clip, plates blur beneath it. -->
+        <div v-else-if="variant === 'ancestor'" class="probe ancestor-clip" data-testid="cluster">
+            <div class="ancestor-plate"></div>
+        </div>
+        <!-- Reference: the same backdrop under a lone plate with no ancestor clip. -->
+        <div v-else class="probe" data-testid="cluster">
+            <div class="ancestor-plate"></div>
+        </div>
+    </main>
+</template>
+
+<style>
+html, body { margin: 0; }
+.stage {
+    position: relative;
+    min-height: 100vh;
+    display: grid;
+    place-items: center;
+    overflow: hidden;
+    background:
+        radial-gradient(circle at 30% 40%, oklch(0.75 0.17 25 / 0.9), transparent 40%),
+        radial-gradient(circle at 70% 60%, oklch(0.7 0.15 250 / 0.9), transparent 45%),
+        repeating-linear-gradient(90deg, oklch(0.25 0 0) 0 6px, oklch(0.97 0 0) 6px 12px);
+}
+.dark .stage {
+    background:
+        radial-gradient(circle at 30% 40%, oklch(0.55 0.17 25 / 0.9), transparent 40%),
+        radial-gradient(circle at 70% 60%, oklch(0.5 0.15 250 / 0.9), transparent 45%),
+        repeating-linear-gradient(90deg, oklch(0.12 0 0) 0 6px, oklch(0.6 0 0) 6px 12px);
+}
+.field {
+    position: absolute;
+    inset: 0;
+    display: grid;
+    align-content: center;
+    font: 600 22px/1.3 system-ui, sans-serif;
+    color: oklch(0.2 0 0 / 0.8);
+    text-align: center;
+    pointer-events: none;
+}
+.probe { position: relative; z-index: 1; }
+.ancestor-clip, .probe:has(> .ancestor-plate) { width: 320px; height: 56px; }
+.ancestor-clip { clip-path: path("M28 0 L292 0 C307.5 0 320 12.5 320 28 C320 43.5 307.5 56 292 56 L28 56 C12.5 56 0 43.5 0 28 C0 12.5 12.5 0 28 0 Z"); }
+.ancestor-plate { position: absolute; inset: 0; backdrop-filter: blur(16px) saturate(1.2); background: oklch(1 0 0 / 0.25); border-radius: 28px; }
+[data-exp~="noafter"] .dock-cluster-plate::after { display: none; }
+[data-exp~="noclip"] .dock-cluster-plate { clip-path: none !important; }
+[data-exp~="noz"] .dock-cluster { z-index: auto; }
+[data-exp~="noz"] .probe { z-index: auto; }
+[data-exp~="nobg"] .dock-cluster-plate { background: none; }
+</style>
