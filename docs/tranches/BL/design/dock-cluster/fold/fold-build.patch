diff --git a/src/components/dock/DockCluster.vue b/src/components/dock/DockCluster.vue
new file mode 100644
index 000000000..0beff6af5
--- /dev/null
+++ b/src/components/dock/DockCluster.vue
@@ -0,0 +1,348 @@
+<script setup lang="ts">
+/**
+ * DockCluster (W-I.8 FOLD build, scratch only): the spec-graft prototype with the
+ * challenge's cures folded in.
+ *   F1  one spring per join, each `useDockSpring(DOCK_SPRING)` (the constant itself).
+ *   F5  the ink's edge at a cut is the member plate's BOX edge, not a path edge.
+ *   F6  the whole-px grid is a margin, never a min-inline-size (no ratchet).
+ *   F7  membership glide: survivors translate from their painted place on the dock spring;
+ *       an arriver's share is clamped between its painted neighbours and opens.
+ *   F10/F11  the layout invariant (ltr, row, nowrap) throws when broken.
+ *   F12 members never shrink; an overflowing row is reported with console.error.
+ */
+import { useMediaQuery } from "@vueuse/core";
+import { computed, onMounted, onUnmounted, ref, useTemplateRef, watch } from "vue";
+import { DOCK_SPRING } from "./constants";
+import { useDockSpring, type DockSpring } from "./composables/useDockSpring";
+import {
+    GLASS_BACKDROP_SHARED_ATTR,
+    useGlassBackdropLuminance,
+} from "../../composables/glass/useGlassBackdropLuminance";
+import { clusterShape, rectPath, shiftPath, type PlateBox } from "./composables/dockClusterShape";
+
+const props = withDefaults(defineProps<{ fused?: boolean | readonly boolean[] }>(), {
+    fused: false,
+});
+
+const SHADOW_PAD = 40;
+const OVERRUN = 2;
+
+const root = useTemplateRef<HTMLElement>("root");
+const shadowEl = useTemplateRef<HTMLElement>("shadowEl");
+const shadowFill = useTemplateRef<HTMLElement>("shadowFill");
+const lensEls = ref<HTMLElement[]>([]);
+const toneEls = ref<HTMLElement[]>([]);
+useGlassBackdropLuminance(root, { shared: true });
+const count = ref(0);
+const reduced = useMediaQuery("(prefers-reduced-motion: reduce)");
+
+const target = computed(() =>
+    Array.from({ length: Math.max(0, count.value - 1) }, (_, i) =>
+        (typeof props.fused === "boolean" ? props.fused : props.fused[i]) ? 1 : 0,
+    ),
+);
+
+let members: HTMLElement[] = [];
+let now: number[] = [];
+let springs: DockSpring[] = [];
+const offsets = new Map<HTMLElement, { o: number; spring: DockSpring }>();
+let arrivers = new Set<HTMLElement>();
+let painted = new Map<HTMLElement, { x0: number; x1: number }>();
+let raf = 0;
+let morphingChildren = 0;
+(window as unknown as { __clusterNow?: () => number[] }).__clusterNow = () => [...now];
+
+function docks(): HTMLElement[] {
+    return root.value ? [...root.value.querySelectorAll<HTMLElement>(":scope > .glass-dock")] : [];
+}
+
+/** F10/F11: the share path is physical LTR along one row. Anything else throws. */
+function assertLayout(): void {
+    const el = root.value;
+    if (!el) return;
+    const cs = getComputedStyle(el);
+    const bad =
+        cs.direction !== "ltr" ? `direction: ${cs.direction}` :
+        cs.flexDirection !== "row" ? `flex-direction: ${cs.flexDirection}` :
+        cs.flexWrap !== "nowrap" ? `flex-wrap: ${cs.flexWrap}` : "";
+    if (bad) throw new Error(`DockCluster: ${bad} is not supported; a cluster is one LTR row (W-I.8 R-10, §6)`);
+}
+
+let shift = 0;
+let overflowing = false;
+/** F6: whole-px member offsets by margin (no width is held, so a shrink still resizes). */
+function regrid(list: HTMLElement[]): void {
+    const el = root.value;
+    if (!el || !list.length) return;
+    list.forEach((d, i) => {
+        if (i === list.length - 1) return;
+        const t = (d.style.translate && parseFloat(d.style.translate)) || 0;
+        void t;
+        const w = d.getBoundingClientRect().width;
+        const m = Math.ceil(w - 0.01) - w;
+        // full precision: both engines lay out in 1/64 px, and a rounded margin
+        // (0.4531 for 0.453125) left WebKit's members at x.984 (fold F5, WebKit)
+        const v = m > 1e-3 ? `${m}px` : "";
+        if (d.style.marginInlineEnd !== v) d.style.marginInlineEnd = v;
+    });
+    const r0 = list[0]!.getBoundingClientRect();
+    const o0 = offsets.get(list[0]!)?.o ?? 0;
+    const left0 = r0.left - o0 - shift;
+    const want = -(left0 - Math.floor(left0));
+    if (Math.abs(want - shift) > 1e-3) {
+        shift = want;
+        el.style.left = `${shift}px`;
+    }
+    // F12: a row wider than its container is the host's to fix (R-10); say so, loudly.
+    const host = el.parentElement?.getBoundingClientRect();
+    const rr = el.getBoundingClientRect();
+    const over = host ? Math.max(host.left - rr.left, rr.right - host.right) : 0;
+    if (over > 0.5 && !overflowing) {
+        console.error(`DockCluster: the row needs ${rr.width.toFixed(1)}px and its container gives ${host!.width.toFixed(1)}px; compose two rows (W-I.8 R-10)`);
+        el.setAttribute("data-overflow", "");
+    } else if (over <= 0.5 && overflowing) el.removeAttribute("data-overflow");
+    overflowing = over > 0.5;
+}
+
+/** Read the painted boxes and write every clip. */
+function paint(): void {
+    const el = root.value;
+    if (!el) return;
+    const list = members;
+    if (list.length !== count.value || !list.length) return;
+    const dpr = window.devicePixelRatio || 1;
+    const base = el.getBoundingClientRect();
+    const gap = Number.parseFloat(getComputedStyle(el).columnGap) || 0;
+    const rects = list.map((d) => d.getBoundingClientRect());
+    const boxes: PlateBox[] = list.map((d, i) => {
+        const r = rects[i]!;
+        const rad = Number.parseFloat(getComputedStyle(d).borderTopLeftRadius) || 0;
+        let x0 = r.left - base.left, x1 = r.right - base.left;
+        if (arrivers.has(d)) {
+            // F7: an arriver opens between its painted neighbours.
+            if (i > 0) x0 = Math.max(x0, rects[i - 1]!.right - base.left + gap);
+            if (i < list.length - 1) x1 = Math.min(x1, rects[i + 1]!.left - base.left - gap);
+            const open = Math.max(0, Math.min(1, (x1 - x0) / Math.max(1, r.width)));
+            d.style.opacity = open >= 0.999 ? "" : `${open.toFixed(3)}`;
+            if (x1 < x0) x0 = x1 = (x0 + x1) / 2;
+            // a droplet: while narrower than tall it is a circle of its width
+            const cy = (r.top + r.bottom) / 2 - base.top, h = Math.min(r.height, x1 - x0);
+            return { x0, x1, y0: cy - h / 2, y1: cy + h / 2, r: rad };
+        }
+        return { x0, x1, y0: r.top - base.top, y1: r.bottom - base.top, r: rad };
+    });
+    painted = new Map(list.map((d, i) => [d, { x0: rects[i]!.left, x1: rects[i]!.right }]));
+    // scratch experiment switch: ?snap=local snaps cuts in the root's own device space
+    const local = new URLSearchParams(location.search).get("snap") === "local";
+    const snap = local ? (x: number) => Math.round(x * dpr) / dpr : (x: number) => Math.round((x + base.left) * dpr) / dpr - base.left;
+    const joins = now.length === boxes.length - 1 ? now : target.value;
+    const { shares, silhouette, necks, cuts } = clusterShape(boxes, joins, snap);
+    const w = Number.parseFloat(getComputedStyle(el).getPropertyValue("--dock-cluster-rim")) || 1.5;
+    const inner = clusterShape(boxes, joins, snap, w).silhouette;
+    shares.forEach((d, i) => {
+        const lens = lensEls.value[i];
+        if (lens) lens.style.clipPath = `path("${d}")`;
+        const tone = toneEls.value[i];
+        // scratch switch ?tone=one: ONE tone pass over the whole silhouette (no cut inside it)
+        const oneTone = new URLSearchParams(location.search).get("tone") === "one";
+        if (tone) tone.style.clipPath = oneTone ? (i === 0 ? `path("${silhouette}")` : "inset(50%)") : `path("${d}")`;
+        const plate = list[i]!.querySelector<HTMLElement>(":scope > .dock-plate");
+        const r = rects[i]!;
+        if (!plate) return;
+        // F5: at a contacted join the plate's BOX edge sits on the cut (layout snaps both
+        // neighbours' edges alike) and the path overruns it, so no path edge rasters there.
+        const X0 = i > 0 ? cuts[i - 1]! : Math.floor(boxes[i]!.x0);
+        const X1 = i < boxes.length - 1 ? cuts[i]! : Math.ceil(boxes[i]!.x1);
+        const inset = `${base.top - r.top}px ${r.right - (base.left + X1)}px ${r.bottom - base.bottom}px ${base.left + X0 - r.left}px`;
+        if (plate.style.inset !== inset) plate.style.inset = inset;
+        let path = d;
+        if (i > 0 && necks[i - 1]) path += " " + rectPath(X0 - OVERRUN, necks[i - 1]![0], X0 + 1, necks[i - 1]![1]);
+        if (i < boxes.length - 1 && necks[i]) path += " " + rectPath(X1 - 1, necks[i]![0], X1 + OVERRUN, necks[i]![1]);
+        plate.style.clipPath = `path("${shiftPath(path, -X0, 0)}")`;
+        plate.style.setProperty("--dock-ring-clip", `path(evenodd, "${shiftPath(silhouette, -X0, 0)} ${shiftPath(inner, -X0, 0)}")`);
+    });
+    const shifted = shiftPath(silhouette, SHADOW_PAD, SHADOW_PAD);
+    if (shadowFill.value) shadowFill.value.style.clipPath = `path("${shifted}")`;
+    if (shadowEl.value) {
+        const W = base.width + 2 * SHADOW_PAD;
+        const H = base.height + 2 * SHADOW_PAD;
+        shadowEl.value.style.clipPath = `path(evenodd, "M0 0 L${W} 0 L${W} ${H} L0 ${H} Z ${shifted}")`;
+    }
+}
+
+const live = () =>
+    springs.some((s) => s.live) || [...offsets.values()].some((v) => v.spring.live) || morphingChildren > 0;
+function tick(): void {
+    raf = 0;
+    paint();
+    if (live()) raf = requestAnimationFrame(tick);
+    else if (arrivers.size) {
+        arrivers.forEach((d) => (d.style.opacity = ""));
+        arrivers = new Set();
+        paint();
+    }
+}
+function wake(): void {
+    if (!raf) raf = requestAnimationFrame(tick);
+}
+
+/** F1: one spring per join. A join whose target is unchanged is not touched. */
+function play(next: number[]): void {
+    if (now.length !== next.length) {
+        now = [...next];
+        paint();
+        return;
+    }
+    if (reduced.value) {
+        crossfade(next);
+        return;
+    }
+    next.forEach((t, i) => {
+        if (t === (springs[i] as unknown as { _to?: number })?._to && springs[i]!.live) return;
+        if (!springs[i]!.live && Math.abs(now[i]! - t) < 1e-6) return;
+        (springs[i] as unknown as { _to?: number })._to = t;
+        springs[i]!.playTo(now[i]!, t, {
+            onFrame: (v) => {
+                now[i] = v;
+            },
+            onSettle: () => {
+                now[i] = t;
+                paint();
+            },
+        });
+    });
+    wake();
+}
+
+let fading: Animation[] = [];
+function crossfade(next: number[]): void {
+    const el = root.value;
+    if (!el) return;
+    const mats = [
+        ...lensEls.value,
+        ...toneEls.value,
+        ...(shadowEl.value ? [shadowEl.value] : []),
+        ...members.map((d) => d.querySelector<HTMLElement>(":scope > .dock-plate")).filter((x): x is HTMLElement => !!x),
+    ];
+    const raw = getComputedStyle(el).getPropertyValue("--dock-cluster-swap").trim();
+    const ms = raw.endsWith("ms") ? Number.parseFloat(raw) : Number.parseFloat(raw) * 1000;
+    const duration = Number.isFinite(ms) && ms > 0 ? ms : 0;
+    fading.forEach((a) => a.cancel());
+    const out = mats.map((m) => m.animate([{ opacity: 1 }, { opacity: 0 }], { duration, easing: "ease-in", fill: "forwards" }));
+    fading = out;
+    void Promise.all(out.map((a) => a.finished)).then(() => {
+        now = [...next];
+        paint();
+        const back = mats.map((m) => m.animate([{ opacity: 0 }, { opacity: 1 }], { duration, easing: "ease-out" }));
+        out.forEach((a) => a.cancel());
+        fading = back;
+    }, () => {});
+}
+
+watch(target, (next) => play(next));
+
+/** Membership: re-index joins by member, glide survivors from where they were painted. */
+function observe(): void {
+    const list = docks();
+    const prev = members;
+    const changed = list.length !== prev.length || list.some((d, i) => d !== prev[i]);
+    assertLayout();
+    if (changed) {
+        const oldJoin = new Map(prev.slice(0, -1).map((d, i) => [d, now[i] ?? 0]));
+        const t = Array.from({ length: Math.max(0, list.length - 1) }, (_, i) =>
+            (typeof props.fused === "boolean" ? props.fused : props.fused[i]) ? 1 : 0,
+        );
+        const nextNow = t.map((tv, k) => {
+            const a = list[k]!;
+            if (oldJoin.has(a)) return oldJoin.get(a)!;
+            const left = k > 0 ? list[k - 1] : undefined;
+            if (left && oldJoin.has(left)) return oldJoin.get(left)!;
+            return tv;
+        });
+        springs.forEach((s) => s.dispose());
+        springs = t.map(() => useDockSpring(DOCK_SPRING));
+        const firstMount = prev.length === 0;
+        members = list;
+        count.value = list.length;
+        now = nextNow;
+        for (const d of [...offsets.keys()]) if (!list.includes(d)) { offsets.get(d)!.spring.dispose(); offsets.delete(d); }
+        regrid(list);
+        if (!firstMount && !reduced.value) {
+            arrivers = new Set(list.filter((d) => !prev.includes(d)));
+            for (const d of list) {
+                if (arrivers.has(d)) continue;
+                const was = painted.get(d);
+                if (!was) continue;
+                const cur = offsets.get(d)?.o ?? 0;
+                const layoutX0 = d.getBoundingClientRect().left - cur;
+                const from = was.x0 - layoutX0;
+                if (Math.abs(from) < 0.25) continue;
+                const entry = offsets.get(d) ?? { o: 0, spring: useDockSpring(DOCK_SPRING) };
+                offsets.set(d, entry);
+                entry.o = from;
+                d.style.translate = `${from}px 0`;
+                entry.spring.playTo(from, 0, {
+                    onFrame: (v) => {
+                        entry.o = v;
+                        d.style.translate = Math.abs(v) < 0.01 ? "" : `${v}px 0`;
+                    },
+                    onSettle: () => {
+                        entry.o = 0;
+                        d.style.translate = "";
+                    },
+                });
+            }
+            arrivers.forEach((d) => (d.style.opacity = "0"));
+        }
+        // carry the joins toward the (re-indexed) targets
+        t.forEach((tv, i) => {
+            if (Math.abs(now[i]! - tv) < 1e-6) return;
+            (springs[i] as unknown as { _to?: number })._to = tv;
+            springs[i]!.playTo(now[i]!, tv, { onFrame: (v) => (now[i] = v), onSettle: () => { now[i] = tv; paint(); } });
+        });
+    }
+    ro?.disconnect();
+    if (root.value) ro?.observe(root.value);
+    if (root.value?.parentElement) ro?.observe(root.value.parentElement);
+    for (const d of list) ro?.observe(d);
+    morphingChildren = list.filter((d) => d.hasAttribute("data-morphing")).length;
+    paint();
+    if (live()) wake();
+}
+
+let ro: ResizeObserver | null = null;
+let mo: MutationObserver | null = null;
+onMounted(() => {
+    ro = new ResizeObserver(() => {
+        assertLayout();
+        regrid(members);
+        paint();
+    });
+    mo = new MutationObserver(() => observe());
+    if (root.value) mo.observe(root.value, { childList: true, subtree: true, attributes: true, attributeFilter: ["data-morphing", "dir"] });
+    observe();
+    now = [...target.value];
+    paint();
+});
+
+onUnmounted(() => {
+    ro?.disconnect();
+    mo?.disconnect();
+    if (raf) cancelAnimationFrame(raf);
+    springs.forEach((s) => s.dispose());
+    offsets.forEach((v) => v.spring.dispose());
+});
+</script>
+
+<template>
+    <div ref="root" class="dock-cluster" :[GLASS_BACKDROP_SHARED_ATTR]="''">
+        <div ref="shadowEl" class="dock-cluster-shadow" aria-hidden="true">
+            <div class="dock-cluster-shadow-blur">
+                <div ref="shadowFill" class="dock-cluster-shadow-fill"></div>
+            </div>
+        </div>
+        <div v-for="i in count" :key="i" :ref="(el) => { if (el) lensEls[i - 1] = el as HTMLElement }" class="dock-cluster-lens" aria-hidden="true"></div>
+        <div v-for="i in count" :key="`t${i}`" :ref="(el) => { if (el) toneEls[i - 1] = el as HTMLElement }" class="dock-cluster-tone" aria-hidden="true"></div>
+        <slot />
+    </div>
+</template>
