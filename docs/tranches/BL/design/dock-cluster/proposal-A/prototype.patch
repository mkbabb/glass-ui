diff --git a/src/components/dock/styles/cluster.css b/src/components/dock/styles/cluster.css
new file mode 100644
index 000000000..185d8f4eb
--- /dev/null
+++ b/src/components/dock/styles/cluster.css
@@ -0,0 +1,197 @@
+/* DockCluster: GlassDock plates that fuse into one pill and fission back.
+ *
+ * Shape and position only. Every plate keeps its own `.dock-plate` backdrop-filter,
+ * and nothing here puts a filter, mask, opacity or clip-path on an ANCESTOR of a
+ * plate (each would make that ancestor a backdrop root and blank the glass).
+ *
+ * Per plate, the cluster writes two numbers, `--dock-fuse-start` and
+ * `--dock-fuse-end` (0 split, 1 fused, one spring: DockCluster.vue), and a FLIP
+ * `translate`. From them:
+ *
+ *   corners  the facing corners go from the plate's px radius to 0. The radius is a
+ *            registered `<length>`, so a percentage cannot reach it (the r1 law);
+ *   border   the plate clips its own facing border off (`clip-path: inset` on the
+ *            plate, composed with the dock's extent inset). The fused layout overlaps
+ *            neighbours by two border widths, so glass meets glass with no line;
+ *   shadow   the elevation and the rim move from the dock box to `::before`, whose
+ *            polygon clip cuts out the slot the neighbour's glass covers. No shadow
+ *            paints over a neighbour, and no plate blurs a neighbour's shadow.
+ *            Outside the plates the two halos still sum, and the halo of two
+ *            abutting rectangles is the halo of their union: one shadow.
+ *   rim      the key shade's x leg sits on one vertical edge; it fades with that
+ *            edge's fuse, so the seam carries no 1px line.
+ *
+ * Gap and overlap are layout, written once when the fuse arms; between, only
+ * `translate`, `border-*-radius`, `clip-path` and two numbers move. */
+
+@property --dock-fuse-start {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+}
+
+@property --dock-fuse-end {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+}
+
+/* A `<length>`: `50%` is invalid here at computed-value time, so the fused corners can
+   never be a per-axis percentage that turns a pill into an ellipse. */
+@property --dock-cluster-radius {
+    syntax: "<length>";
+    inherits: true;
+    initial-value: 0px;
+}
+
+/* The reduced-motion dip's half, registered so it resolves to a time the script reads. */
+@property --dock-cluster-swap {
+    syntax: "<time>";
+    inherits: true;
+    initial-value: 0s;
+}
+
+/* The reduced-motion dip (DockCluster.vue animates it with WAAPI, which the PRM
+   transition carve does not reach). */
+@property --dock-cluster-fade {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 1;
+}
+
+@layer components {
+    .glass-dock-cluster {
+        --dock-cluster-gap: 0.5rem;
+        /* The plate border (dock.css `.dock-plate`, 1.5px) that each facing edge clips.
+           DockCluster rewrites it with the width the engine paints (1px at DPR 1). */
+        --dock-cluster-seam: 1.5px;
+        /* How far a plate's elevation can paint past its box (`--shadow-dock` is a 20px blur). */
+        --dock-cluster-reach: 64px;
+        --dock-cluster-swap: var(--spring-dock-exit-duration);
+        position: relative;
+        display: flex;
+        flex-wrap: nowrap;
+        align-items: center;
+        justify-content: center;
+    }
+
+    .glass-dock-cluster > .glass-dock {
+        margin-inline: 0;
+        --dock-cluster-radius: var(--radius-dock);
+        border-start-start-radius: calc(
+            var(--dock-cluster-radius) * (1 - var(--dock-fuse-start))
+        );
+        border-end-start-radius: calc(
+            var(--dock-cluster-radius) * (1 - var(--dock-fuse-start))
+        );
+        border-start-end-radius: calc(
+            var(--dock-cluster-radius) * (1 - var(--dock-fuse-end))
+        );
+        border-end-end-radius: calc(
+            var(--dock-cluster-radius) * (1 - var(--dock-fuse-end))
+        );
+        /* The box paints nothing; `::before` carries the elevation and rim. */
+        box-shadow: none;
+    }
+
+    .glass-dock-cluster > .glass-dock[data-seam-start="split"] {
+        margin-inline-start: var(--dock-cluster-gap);
+    }
+
+    .glass-dock-cluster > .glass-dock[data-seam-start="fused"] {
+        margin-inline-start: calc(-2 * var(--dock-cluster-seam));
+    }
+
+    /* The facing border, clipped off the plate itself (never an ancestor). */
+    .glass-dock-cluster > .glass-dock > .dock-plate {
+        --dock-clip-end: calc(var(--dock-cluster-seam) * var(--dock-fuse-end));
+        --dock-clip-start: calc(var(--dock-cluster-seam) * var(--dock-fuse-start));
+        clip-path: inset(
+            var(--dock-plate-inset-block)
+                calc(var(--dock-plate-inset-inline) + var(--dock-clip-end))
+                var(--dock-plate-inset-block)
+                calc(var(--dock-plate-inset-inline) + var(--dock-clip-start))
+        );
+    }
+
+    .glass-dock-cluster > .glass-dock:dir(rtl) > .dock-plate {
+        clip-path: inset(
+            var(--dock-plate-inset-block)
+                calc(var(--dock-plate-inset-inline) + var(--dock-clip-start))
+                var(--dock-plate-inset-block)
+                calc(var(--dock-plate-inset-inline) + var(--dock-clip-end))
+        );
+    }
+
+    /* The elevation + rim carrier. `--dock-gap-*` is the distance from this plate's
+       edge to where the neighbour's glass starts: the gap when split, minus one border
+       width when fused (the overlap less the neighbour's own clipped border). It is
+       linear in the fuse, as the FLIP translate is, so the slot tracks the glass on
+       every frame. A side with no neighbour pushes its slot out of reach. */
+    .glass-dock-cluster > .glass-dock::before {
+        content: "";
+        position: absolute;
+        inset: 0;
+        z-index: -2;
+        border-radius: inherit;
+        pointer-events: none;
+        --dock-gap-end: calc(
+            (1 - var(--dock-fuse-end)) * var(--dock-cluster-gap) -
+                var(--dock-fuse-end) * var(--dock-cluster-seam)
+        );
+        --dock-gap-start: calc(
+            (1 - var(--dock-fuse-start)) * var(--dock-cluster-gap) -
+                var(--dock-fuse-start) * var(--dock-cluster-seam)
+        );
+        --r: var(--dock-cluster-reach);
+        box-shadow:
+            var(--glass-rim-top),
+            inset 0 var(--glass-key-shade-y) 0
+                color-mix(
+                    in srgb,
+                    var(--foreground) calc(6% * var(--glass-level)),
+                    transparent
+                ),
+            inset
+                calc(
+                    max(var(--glass-key-shade-x), 0px) * (1 - var(--dock-fuse-start)) +
+                        min(var(--glass-key-shade-x), 0px) * (1 - var(--dock-fuse-end))
+                )
+                0 0
+                color-mix(
+                    in srgb,
+                    var(--foreground) calc(4% * var(--glass-level)),
+                    transparent
+                ),
+            var(--shadow-dock-override, var(--shadow-dock));
+        clip-path: polygon(
+            calc(-1 * var(--r)) calc(-1 * var(--r)),
+            calc(100% + var(--r)) calc(-1 * var(--r)),
+            calc(100% + var(--r)) 0,
+            calc(100% + var(--dock-gap-end)) 0,
+            calc(100% + var(--dock-gap-end)) 100%,
+            calc(100% + var(--r)) 100%,
+            calc(100% + var(--r)) calc(100% + var(--r)),
+            calc(-1 * var(--r)) calc(100% + var(--r)),
+            calc(-1 * var(--r)) 100%,
+            calc(-1 * var(--dock-gap-start)) 100%,
+            calc(-1 * var(--dock-gap-start)) 0,
+            calc(-1 * var(--r)) 0
+        );
+    }
+
+    .glass-dock-cluster > .glass-dock:not([data-seam-end])::before {
+        --dock-gap-end: var(--dock-cluster-reach);
+    }
+
+    .glass-dock-cluster > .glass-dock:not([data-seam-start])::before {
+        --dock-gap-start: var(--dock-cluster-reach);
+    }
+
+    /* Reduced motion: the plate paint dips and rises around the geometry swap. */
+    .glass-dock-cluster > .glass-dock::before,
+    .glass-dock-cluster > .glass-dock > .dock-plate,
+    .glass-dock-cluster > .glass-dock > .dock-controls > * {
+        opacity: var(--dock-cluster-fade);
+    }
+}
