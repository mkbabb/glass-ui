diff --git a/src/components/dock/DockCluster.vue b/src/components/dock/DockCluster.vue
new file mode 100644
index 000000000..f39cd044d
--- /dev/null
+++ b/src/components/dock/DockCluster.vue
@@ -0,0 +1,251 @@
+<script setup lang="ts">
+/**
+ * DockCluster: a row of GlassDock plates that fuse into one pill and fission back.
+ *
+ * Each plate stays its own GlassDock with its own `.dock-plate` backdrop the whole
+ * time. A seam's fuse is shape and position only (styles/cluster.css):
+ *
+ *   - position: `translate` per plate, a FLIP from the box it painted before the
+ *     state change to the box the new layout gives it (one layout read at arm,
+ *     none per frame);
+ *   - shape: the facing corners spring from the plate's px radius to 0, and the
+ *     plate clips its own facing border off (`clip-path: inset`, on the plate);
+ *   - seam paint: the elevation and the rim ride a per-plate `::before` whose
+ *     `clip-path` removes the slot the neighbour's glass covers, so no shadow paints
+ *     over or under a neighbour's glass.
+ *
+ * One spring drives every seam: `useDockSpring(DOCK_SPRING)`, the dock's own.
+ * Reduced motion swaps the geometry at the floor of an opacity dip.
+ *
+ * The cluster never reorders, re-parents, hides or focuses anything: roles, names
+ * and tab order are the plates' own through every fuse.
+ */
+import { useMediaQuery } from "@vueuse/core";
+import { computed, onMounted, onUnmounted, useTemplateRef, watch } from "vue";
+import { DOCK_SPRING } from "./constants";
+import { useDockSpring } from "./composables/useDockSpring";
+
+const props = withDefaults(
+    defineProps<{
+        /** `true` fuses every seam; an array fuses seam i (between plate i and i+1). */
+        fused?: boolean | readonly boolean[];
+    }>(),
+    { fused: false },
+);
+
+const rootEl = useTemplateRef<HTMLElement>("rootEl");
+const reduced = useMediaQuery("(prefers-reduced-motion: reduce)");
+const spring = useDockSpring({
+    response: DOCK_SPRING.response,
+    dampingFraction: DOCK_SPRING.dampingFraction,
+});
+
+function plates(): HTMLElement[] {
+    const el = rootEl.value;
+    return el
+        ? (Array.from(el.children).filter((c) =>
+              c.classList.contains("glass-dock"),
+          ) as HTMLElement[])
+        : [];
+}
+
+function targetSeams(n: number): number[] {
+    const f = props.fused;
+    return Array.from({ length: Math.max(0, n - 1) }, (_, i) =>
+        (typeof f === "boolean" ? f : !!f[i]) ? 1 : 0,
+    );
+}
+
+/* The live per-seam fuse, 0 split … 1 fused. */
+let live: number[] = [];
+let from: number[] = [];
+let to: number[] = [];
+let dx: number[] = [];
+let lefts: number[] = [];
+let fade: Animation | null = null;
+
+function writeSeams(els: HTMLElement[], seams: number[]): void {
+    els.forEach((el, i) => {
+        el.style.setProperty("--dock-fuse-start", `${i > 0 ? seams[i - 1] ?? 0 : 0}`);
+        el.style.setProperty("--dock-fuse-end", `${i < els.length - 1 ? seams[i] ?? 0 : 0}`);
+    });
+}
+
+/* Layout: each plate's start seam is fused or split in the target layout. */
+function writeLayout(els: HTMLElement[], seams: number[]): void {
+    els.forEach((el, i) => {
+        if (i === 0) el.removeAttribute("data-seam-start");
+        else el.setAttribute("data-seam-start", seams[i - 1] ? "fused" : "split");
+        if (i === els.length - 1) el.removeAttribute("data-seam-end");
+        else el.setAttribute("data-seam-end", seams[i] ? "fused" : "split");
+    });
+}
+
+function frame(els: HTMLElement[], s: number): void {
+    live = from.map((f0, j) => f0 + ((to[j] ?? f0) - f0) * s);
+    writeSeams(els, live);
+    els.forEach((el, i) => {
+        const d = (dx[i] ?? 0) * (1 - s);
+        el.style.translate = Math.abs(d) < 0.01 ? "" : `${d}px 0`;
+    });
+}
+
+function settle(els: HTMLElement[]): void {
+    live = to.slice();
+    writeSeams(els, live);
+    els.forEach((el) => (el.style.translate = ""));
+    lefts = els.map((el) => el.getBoundingClientRect().left);
+    rootEl.value?.removeAttribute("data-fusing");
+}
+
+/* Put every seam on the device-pixel grid. A seam at a fractional x anti-aliases both
+   plates' clip edges into one pixel and the field shows through as a light line, so:
+   the seam inset is the border width the engine actually paints (it snaps per DPR),
+   each plate's width rounds up to whole device pixels, and the cluster shifts by its
+   sub-pixel remainder (relative `left`, not a transform). Layout, written at arm only. */
+function snapGrid(els: HTMLElement[]): void {
+    const root = rootEl.value;
+    if (!root || !els.length) return;
+    const dpr = window.devicePixelRatio || 1;
+    const plate = els[0]!.querySelector(".dock-plate");
+    if (plate) {
+        const bw = parseFloat(getComputedStyle(plate).borderInlineEndWidth) || 0;
+        root.style.setProperty("--dock-cluster-seam", `${bw}px`);
+    }
+    els.forEach((el) => (el.style.minInlineSize = ""));
+    root.style.left = "";
+    const ws = els.map((el) => el.getBoundingClientRect().width);
+    els.forEach((el, i) => {
+        const w = Math.ceil(ws[i]! * dpr - 0.01) / dpr;
+        if (w - ws[i]! > 1e-3) el.style.minInlineSize = `${w}px`;
+    });
+    const l = els[0]!.getBoundingClientRect().left;
+    const d = Math.round(l * dpr) / dpr - l;
+    if (Math.abs(d) > 1e-3) root.style.left = `${d}px`;
+}
+
+/** Arm a FLIP from the painted boxes to the target layout and spring it. */
+function arm(before: number[] | null): void {
+    const els = plates();
+    if (!els.length) return;
+    const next = targetSeams(els.length);
+    if (live.length !== next.length) live = next.map((_, j) => live[j] ?? next[j]!);
+    const painted = before ?? els.map((el) => el.getBoundingClientRect().left);
+
+    if (reduced.value) {
+        // A plain cross-fade: dip each plate's paint, swap at the floor, rise.
+        // WAAPI on a registered number: the PRM transition carve snaps CSS
+        // transitions, and an opacity fade is not a vestibular trigger (canon P6).
+        const root = rootEl.value!;
+        spring.dispose();
+        fade?.cancel();
+        const ms = swapMs();
+        const easing = getComputedStyle(root).getPropertyValue("--ease-standard").trim() || "ease";
+        const out = root.animate(
+            [{ "--dock-cluster-fade": 1 }, { "--dock-cluster-fade": 0 }],
+            { duration: ms, easing, fill: "forwards" },
+        );
+        fade = out;
+        out.finished
+            .then(() => {
+                from = next.slice();
+                to = next.slice();
+                writeLayout(els, next);
+                snapGrid(els);
+                settle(els);
+                fade = root.animate(
+                    [{ "--dock-cluster-fade": 0 }, { "--dock-cluster-fade": 1 }],
+                    { duration: ms, easing },
+                );
+                out.cancel();
+            })
+            .catch(() => {});
+        return;
+    }
+
+    // Velocity carried into the new leg: the first seam that moves sets the ratio.
+    let scale = 0;
+    if (spring.live) {
+        const j = next.findIndex((t, k) => t !== (to[k] ?? t));
+        const k = j >= 0 ? j : 0;
+        const oldSpan = (to[k] ?? 0) - (from[k] ?? 0);
+        const newSpan = next[k]! - (live[k] ?? 0);
+        if (Math.abs(newSpan) > 1e-3) scale = oldSpan / newSpan;
+    }
+    from = live.slice();
+    to = next;
+    writeLayout(els, next);
+    els.forEach((el) => (el.style.translate = ""));
+    snapGrid(els);
+    const after = els.map((el) => el.getBoundingClientRect().left);
+    dx = after.map((a, i) => (painted[i] ?? a) - a);
+    rootEl.value?.setAttribute("data-fusing", "");
+    frame(els, 0);
+    spring.playTo(0, 1, {
+        inheritVelocityScale: scale,
+        onFrame: (s) => frame(els, s),
+        onSettle: () => settle(els),
+    });
+}
+
+function swapMs(): number {
+    const el = rootEl.value;
+    if (!el) return 0;
+    const v = getComputedStyle(el).getPropertyValue("--dock-cluster-swap").trim();
+    return v.endsWith("ms") ? parseFloat(v) : parseFloat(v) * 1000 || 0;
+}
+
+const key = computed(() => JSON.stringify(props.fused));
+watch(key, () => arm(null), { flush: "pre" });
+
+/* A plate that changes size (a page's control set) moves its neighbours: FLIP them
+   from where they painted last. */
+let ro: ResizeObserver | null = null;
+let mo: MutationObserver | null = null;
+onMounted(() => {
+    const els = plates();
+    to = targetSeams(els.length);
+    from = to.slice();
+    live = to.slice();
+    writeLayout(els, to);
+    writeSeams(els, to);
+    snapGrid(els);
+    lefts = els.map((el) => el.getBoundingClientRect().left);
+    ro = new ResizeObserver(() => {
+        if (spring.live) return;
+        const prev = lefts;
+        const now = plates();
+        if (prev.length !== now.length) return;
+        const cur = now.map((el) => el.getBoundingClientRect().left);
+        if (cur.every((c, i) => Math.abs(c - prev[i]!) < 0.5)) return;
+        arm(prev);
+    });
+    els.forEach((el) => ro!.observe(el));
+    mo = new MutationObserver(() => {
+        ro?.disconnect();
+        const now = plates();
+        now.forEach((el) => ro!.observe(el));
+        arm(null);
+    });
+    mo.observe(rootEl.value!, { childList: true });
+});
+onUnmounted(() => {
+    ro?.disconnect();
+    mo?.disconnect();
+    spring.dispose();
+});
+
+defineExpose({
+    /** Harness-only: pin the morph at spring progress `s` for a deterministic capture. */
+    scrub(s: number): void {
+        spring.dispose();
+        frame(plates(), s);
+    },
+});
+</script>
+
+<template>
+    <div ref="rootEl" class="glass-dock-cluster">
+        <slot />
+    </div>
+</template>
