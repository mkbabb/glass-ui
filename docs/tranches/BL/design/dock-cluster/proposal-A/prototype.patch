--- /dev/null
+++ b/tests-visual/dock-cluster/App.vue
@@ -0,0 +1,91 @@
+<script setup lang="ts">
+/* DockCluster fixture: two and three plates fusing and fissioning over a field
+   with a striped band (the backdrop the seam and the blur are read against).
+   Query: n=2|3, fused=0|1, theme via html.dark. Hooks on window.__cluster. */
+import { onMounted, ref, useTemplateRef } from "vue";
+import { DockCluster, DockControl, GlassDock } from "@glass/components/dock";
+
+const q = new URLSearchParams(location.search);
+const n = ref(q.get("n") === "2" ? 2 : 3);
+const fused = ref<boolean | boolean[]>(q.get("fused") === "1");
+const page = ref(0);
+const extra = ref(q.get("extra") === "1");
+// A phone row holds three short tabs beside two icon plates (358 px at 390 wide);
+// daraksha's four named tabs take their own row there (see proposal-A.md §1.4).
+const PAGES = innerWidth < 500 ? ["Read", "Hear", "Learn"] : ["Read", "Hear", "Learn", "About"];
+const dark = ref(document.documentElement.classList.contains("dark"));
+const cluster = useTemplateRef<{ scrub(s: number): void }>("cluster");
+
+onMounted(() => {
+    (window as any).__cluster = {
+        set: (v: boolean | boolean[]) => { fused.value = v; },
+        scrub: (s: number) => cluster.value?.scrub(s),
+        page: (i: number) => { page.value = i; },
+        extra: (v: boolean) => { extra.value = v; },
+        root: () => document.querySelector(".glass-dock-cluster"),
+        ready: true,
+    };
+});
+</script>
+
+<template>
+    <main class="field">
+        <div class="band"></div>
+        <div class="stage" data-testid="stage">
+            <DockCluster ref="cluster" :fused="fused" data-testid="cluster" dir="ltr">
+                <GlassDock fit-content :collapse="false" aria-label="Pages" data-plate="pages">
+                    <DockControl v-for="(p, i) in PAGES" :key="p" shape="tab" :active="i === page" @click="page = i">{{ p }}</DockControl>
+                </GlassDock>
+                <GlassDock fit-content :collapse="false" aria-label="Page controls" data-plate="controls">
+                    <DockControl aria-label="Text size">
+                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 18 9 6l5 12M6 14h6M15 18l3-7 3 7"/></svg>
+                    </DockControl>
+                    <DockControl v-if="extra" aria-label="Bookmark">
+                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4h12v16l-6-4-6 4z"/></svg>
+                    </DockControl>
+                    <DockControl v-if="n === 2" :aria-label="dark ? 'Light theme' : 'Dark theme'" :active="dark">
+                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14A8 8 0 1 1 10 4a7 7 0 0 0 10 10z"/></svg>
+                    </DockControl>
+                </GlassDock>
+                <GlassDock v-if="n === 3" fit-content :collapse="false" aria-label="Theme" data-plate="theme">
+                    <DockControl :aria-label="dark ? 'Light theme' : 'Dark theme'" :active="dark">
