@@ -0,0 +1,70 @@
+/* The glyph (W-B.17 R-6).
+
+   Two inherited numbers on every control: `--intent` (a pointer is over THIS control)
+   and `--intent-set` (this control is on, open or current). Every control resets both,
+   so a control nested in another answers for itself. The glyph computes its own
+   `scale`, `translate` or `rotate` from them; the transition runs on the glyph. Every
+   rule is `:where()`, zero specificity. */
+@layer components {
+    :where(
+            .plate,
+            button,
+            a[href],
+            summary,
+            [role="button"],
+            [role="tab"],
+            [role="option"],
+            [role="menuitem"],
+            [role="menuitemcheckbox"],
+            [role="menuitemradio"]
+        ) {
+        --intent: 0;
+        --intent-set: 0;
+
+        @media (hover: hover) {
+            &:hover:not(:disabled, [aria-disabled="true"]) {
+                --intent: 1;
+            }
+        }
+        &:is(
+                [aria-pressed="true"],
+                [aria-expanded="true"],
+                [aria-checked="true"],
+                [aria-current]:not([aria-current="false"]),
+                [data-state="open"],
+                [data-state="on"],
+                [data-state="active"],
+                [data-state="checked"]
+            ) {
+            --intent-set: 1;
+        }
+    }
+
+    :where([data-glyph], .plate > svg) {
+        transform-box: fill-box;
+        transform-origin: center;
+        rotate: calc(var(--glyph-flip, 0deg) * var(--intent-set, 0));
+        transition:
+            scale var(--spring-present-duration) var(--spring-present),
+            translate var(--spring-present-duration) var(--spring-present),
+            rotate var(--spring-present-duration) var(--spring-present);
+    }
+    :where([data-glyph=""], [data-glyph="grow"], .plate > svg:not([data-glyph])) {
+        scale: calc(1 + var(--glyph-grow, 0.08) * var(--motion-weight, 1) * var(--intent, 0));
+    }
+    :where([data-glyph="nudge"]) {
+        translate: calc(var(--glyph-dx, 2px) * var(--motion-weight, 1) * var(--intent, 0))
+            calc(var(--glyph-dy, 0px) * var(--motion-weight, 1) * var(--intent, 0));
+    }
+    :where([data-glyph="turn"]) {
+        rotate: calc(
+            var(--glyph-turn, 15deg) * var(--motion-weight, 1) * var(--intent, 0) +
+                var(--glyph-flip, 0deg) * var(--intent-set, 0)
+        );
+    }
+    :where([data-glyph="draw"][pathLength="1"], [data-glyph="draw"] [pathLength="1"]) {
+        stroke-dasharray: 1 0.3;
+        stroke-dashoffset: calc(-1.3 * max(var(--intent, 0), var(--intent-set, 0)));
+        transition: stroke-dashoffset var(--duration-fast) var(--ease-standard);
+    }
+}
diff --git a/src/styles/glass/plate.css b/src/styles/glass/plate.css
