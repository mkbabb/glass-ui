@@ -0,0 +1,26 @@
+// <Presence> (W-B.17 R-7): Vue's <Transition> under one of two names. It renders no
+// element and stamps nothing on its child. Two boolean props and no others.
+import { Transition, h, type FunctionalComponent } from "vue";
+import { readReducedMotion } from "../core/useReducedMotion";
+import { reclaimHooks } from "./follow";
+
+export interface PresenceProps {
+    /** The node is replaced in its seat: out, then in. */
+    swap?: boolean;
+    /** The node's arrival pushes what follows it: its block size follows. */
+    reclaim?: boolean;
+}
+
+export const Presence: FunctionalComponent<PresenceProps> = (props, { slots }) =>
+    h(
+        Transition,
+        {
+            name: props.swap ? "presence-swap" : "presence",
+            mode: props.swap ? "out-in" : undefined,
+            ...(props.reclaim && !readReducedMotion() ? reclaimHooks : {}),
+        },
+        slots,
+    );
+
+Presence.props = { swap: Boolean, reclaim: Boolean };
+Presence.displayName = "Presence";
diff --git a/src/composables/motion/presence/follow.ts b/src/composables/motion/presence/follow.ts
new file mode 100644
index 000000000..b2eb78a05
--- /dev/null
+++ b/src/composables/motion/presence/follow.ts
@@ -0,0 +1,69 @@
+// follow (W-B.17 R-8): a box whose content changed reaches its new size by one tween.
+//
+// The one writer in glass that animates a size. One shot per change, on the smallest
+// box, on the `present` clock read from the same tokens the CSS legs read. Under
+// reduced motion it does not run: the box lands in one frame and what arrived fades.
+import { nextTick } from "vue";
+import { readReducedMotion } from "../core/useReducedMotion";
+
+const ID = "follow";
+
+interface Box {
+    w: number;
+    h: number;
+}
+const box = (el: HTMLElement): Box => ({ w: el.offsetWidth, h: el.offsetHeight });
+
+/** The `present` clock: `--spring-present` over `--spring-present-settle` x tempo. */
+function presentClock(el: HTMLElement): { duration: number; easing: string } {
+    const cs = getComputedStyle(el);
+    const settle = Number.parseFloat(cs.getPropertyValue("--spring-present-settle")) || 0.2;
+    const tempo = Number.parseFloat(cs.getPropertyValue("--motion-tempo")) || 1;
+    const easing = cs.getPropertyValue("--spring-present").trim() || "ease-out";
+    return { duration: settle * 1000 * tempo, easing };
+}
+
+function size(el: HTMLElement, from: Box, to: Box, extra?: PropertyIndexedKeyframes): Animation {
+    return el.animate(
+        {
+            overflow: ["clip", "clip"],
+            ...(from.w !== to.w && { inlineSize: [`${from.w}px`, `${to.w}px`] }),
+            ...(from.h !== to.h && { blockSize: [`${from.h}px`, `${to.h}px`] }),
+            ...extra,
+        },
+        { id: ID, ...presentClock(el) },
+    );
+}
+
+/** Call BEFORE the change. Resolves when the box has settled. */
+export async function follow(el: HTMLElement | null): Promise<void> {
+    if (!el || readReducedMotion()) return;
+    const from = box(el);
+    await nextTick();
+    for (const a of el.getAnimations()) if (a.id === ID) a.cancel();
+    const to = box(el);
+    if (from.w === to.w && from.h === to.h) return;
+    await size(el, from, to).finished.catch(() => {});
+}
+
+const gapOf = (el: HTMLElement): number =>
+    Number.parseFloat(getComputedStyle(el.parentElement ?? el).rowGap) || 0;
+
+/** `<Presence reclaim>`: a node that arrives or leaves in flow. It carries no block
+ *  padding, border or margin of its own. */
+export const reclaimHooks = {
+    onEnter(el: Element, done: () => void): void {
+        const node = el as HTMLElement;
+        const gap = gapOf(node);
+        size(node, { w: node.offsetWidth, h: 0 }, box(node), {
+            marginBlockStart: [`${-gap}px`, "0px"],
+        }).finished.then(done, done);
+    },
+    onLeave(el: Element, done: () => void): void {
+        const node = el as HTMLElement;
+        const gap = gapOf(node);
+        size(node, box(node), { w: node.offsetWidth, h: 0 }, {
+            marginBlockStart: ["0px", `${-gap}px`],
+        }).finished.then(done, done);
+    },
+};
