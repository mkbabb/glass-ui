diff --git a/src/components/tabs/composables/useStripOverflow.ts b/src/components/tabs/composables/useStripOverflow.ts
new file mode 100644
index 0000000..ea4189f
--- /dev/null
+++ b/src/components/tabs/composables/useStripOverflow.ts
@@ -0,0 +1,78 @@
+import { onBeforeUnmount, shallowRef, watch, type Ref } from "vue";
+
+/* WHETHER THE STRIP'S TABS RUN PAST ITS BOX. Bind the result to `data-overflow`;
+ * segmented.css makes the strip a scroller only while it holds, because a scroll
+ * container ends the `touch-action` its ancestors set (Pointer Events read it only up
+ * to the nearest scroll container), and a strip with nothing to scroll must not lift
+ * a `touch-action: none` box's or a detented Sheet header's restriction.
+ *
+ * The reading is the tabs' inline extent against the strip's content box: the span of
+ * their layout boxes (`offset*`, as the dock reads its seats). A tab is never narrower
+ * than its label (`nowrap`, and no clip on the tab), so the tabs' span is the content's.
+ * Layout boxes ignore transforms, so a strip in a sheet or a dialog that scales in
+ * reads the same as at rest. Neither the span nor the room depends on whether
+ * the strip scrolls (the strip's minimum is 0 in both states, and an offset is read
+ * against the strip's unscrolled padding edge), so setting the attribute never changes
+ * the reading. A strip's `scrollWidth` would: a scroller counts its end padding and a
+ * box that does not scroll does not, so tabs that reach into the trim would read as
+ * fitting until the strip scrolled and as overflowing after.
+ *
+ * A ResizeObserver on the strip and on each tab keeps it live: the strip resizes with
+ * its container, and a tab resizes when its label or its font changes, which a strip
+ * already at its cap would not show. Its first delivery is the first reading, after
+ * layout and before paint. */
+export function useStripOverflow(
+    strip: Ref<HTMLElement | null>,
+    tabs: Ref<HTMLElement[]>,
+): Readonly<Ref<"" | undefined>> {
+    const overflow = shallowRef<"" | undefined>(undefined);
+    let observer: ResizeObserver | null = null;
+    let observedStrip: HTMLElement | null = null;
+    let observed: HTMLElement[] = [];
+
+    const measure = () => {
+        const el = strip.value;
+        if (!el) return;
+        let start = Infinity;
+        let end = -Infinity;
+        for (const tab of observed) {
+            if (!tab.isConnected) continue;
+            start = Math.min(start, tab.offsetLeft);
+            end = Math.max(end, tab.offsetLeft + tab.offsetWidth);
+        }
+        const style = getComputedStyle(el);
+        const room = el.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
+        // Each layout length is whole pixels, rounded, so a span within 1 px of the room
+        // fits: the tabs then reach at most a pixel into the trim.
+        overflow.value = end - start > room + 1 ? "" : undefined;
+    };
+
+    watch(
+        [strip, () => [...tabs.value]],
+        ([el, list]) => {
+            // A re-render refills the tab refs with the same buttons; nothing to re-observe.
+            const same =
+                observer !== null &&
+                el === observedStrip &&
+                list.length === observed.length &&
+                list.every((t, i) => t === observed[i]);
+            if (same) return;
+            observer?.disconnect();
+            observer = null;
+            observedStrip = el;
+            observed = list;
+            if (!el || typeof ResizeObserver === "undefined") return;
+            observer = new ResizeObserver(measure);
+            observer.observe(el);
+            for (const tab of list) observer.observe(tab);
+        },
+        { flush: "post", immediate: true },
+    );
+
+    onBeforeUnmount(() => {
+        observer?.disconnect();
+        observer = null;
+    });
+
+    return overflow;
+}
