 {
  "name": "M1b atlas's Filters drawer, a toggle label longer than the field",
  "tree": "base",
  "port": 5391,
  "cell": "390t-light",
  "url": "/ovf.html?fold",
  "do": [
   "tap:[data-testid=fold-open-atlas]",
   "wait:2500",
   "eval:(()=>{const e=document.querySelectorAll(\"[data-testid=fold-atlas] [data-slot=toggle-group-item]\")[0];if(!e)return 'none';const w=document.createTreeWalker(e,NodeFilter.SHOW_TEXT);let t,best=null;while((t=w.nextNode()))if(t.textContent.trim().length>1&&(!best||t.textContent.length>best.textContent.length))best=t;if(best)best.textContent=\"Per-pupil expenditure by funding source, all years\";return 'ok'})()",
   "wait:600",
   "swipe:[data-testid=fold-atlas-body]@-150@0",
   "eval:document.querySelector(\"[data-testid=fold-atlas-body]\")?.scrollLeft",
   "eval:[...document.querySelectorAll(\"[data-testid=fold-atlas] [data-slot=toggle-group-item]\")].map(e=>{const r=document.createRange();r.selectNodeContents(e);const t=new Set();for(const q of r.getClientRects())if(q.width>0.5&&q.height>4)t.add(Math.round(q.top));const b=e.getBoundingClientRect();return e.textContent.trim().slice(0,14)+' w'+Math.round(b.width*10)/10+' L'+t.size})"
  ],
  "sel": [
   "[data-testid=fold-atlas-body]",
   "[data-testid=fold-atlas-toggle]",
   "[data-testid=fold-atlas] [data-slot=toggle-group-item]"
  ]
 },
