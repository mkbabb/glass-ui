   "swipe:[data-testid=fold-dock3] .dock-run@48@-200@start",
   "eval:document.querySelector(\"[data-testid=fold-dock3] .dock-run\")?.scrollLeft"
  ],
  "sel": [
   "[data-testid=fold-dock3] .dock-run",
   "[data-testid=fold-dock3] .glass-dock"
  ]
