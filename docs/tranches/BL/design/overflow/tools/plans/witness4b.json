 {
  "name": "M3 three-seat dock whose seats all show",
  "tree": "base",
  "port": 5391,
  "cell": "390t-light",
  "url": "/ovf.html?fold",
  "do": [
   "eval:document.querySelector('[data-testid=fold-dock3]').scrollIntoView({block:'center'})",
   "wait:600",
