   "eval:(()=>{const e=document.querySelectorAll(\"main [data-slot=label]\")[0];if(!e)return 'none';const w=document.createTreeWalker(e,NodeFilter.SHOW_TEXT);let t,best=null;while((t=w.nextNode()))if(t.textContent.trim().length>1&&(!best||t.textContent.length>best.textContent.length))best=t;if(best)best.textContent=\"district_enrollment_by_program_quarterly_2019-2026.csv\";return 'ok'})()",
   "wait:600"
  ],
  "sel": [
   "main .inputs-stage",
   "main .inputs-stage-field",
   "main [data-slot=label]",
   "main [data-slot=input]"
  ]
 },
