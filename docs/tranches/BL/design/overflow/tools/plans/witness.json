 {
  "name": "F1 SegmentedTabs long label in a demo variant row",
  "tree": "base",
  "port": 5391,
  "cell": "390t-light",
  "url": "/foundations/colors",
  "do": [
   "eval:(()=>{const e=document.querySelectorAll(\".story-variant-row .segmented-tab\")[0];if(!e)return 'none';const w=document.createTreeWalker(e,NodeFilter.SHOW_TEXT);let t,best=null;while((t=w.nextNode()))if(t.textContent.trim().length>1&&(!best||t.textContent.length>best.textContent.length))best=t;if(best)best.textContent=\"Quarterly enrollment by district and program, all years\";return 'ok'})()",
   "wait:600",
   "swipe:main@-150@0",
   "eval:document.querySelector(\"main\")?.scrollLeft"
  ],
  "sel": [
   "main",
   ".story-variant-row .segmented-tabs"
  ]
 },
