@@ -0,0 +1,88 @@
+// D5 pass 3 (P-A3), CK-03 and CK-21 on route A's members: every state member of a committing
+// class goes through the engage door with `commit: "state"`, so its host carries the mount
+// frame (`data-engage-arming`) from mount to the first frame. A member that skipped the door
+// would glide or light on an in-task arrival after a style read (the D5 battery's
+// `arrival·ownflush` cell); this reads the adoption at the source of the behaviour, the
+// rendered host. The paint is the battery's.
+
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, type Component } from "vue";
+import { describe, expect, it } from "vitest";
+
+import { Switch } from "@glass/components/switch";
+import { Checkbox } from "@glass/components/checkbox";
+import { RadioGroup, RadioGroupItem } from "@glass/components/radio-group";
+import { Chip } from "@glass/components/chip";
+import { ToggleGroup, ToggleGroupItem } from "@glass/components/toggle-group";
+import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@glass/components/accordion";
+import { SegmentedTabs } from "@glass/components/tabs";
+import { Popover, PopoverTrigger } from "@glass/components/popover";
+import { Button } from "@glass/components/button";
+import { Collapsible, CollapsibleTrigger } from "@glass/components/collapsible";
+import { Select, SelectTrigger, SelectValue } from "@glass/components/select";
+import { DropdownMenu, DropdownMenuTrigger } from "@glass/components/menu";
+
+const frame = (): Promise<void> => new Promise((ok) => requestAnimationFrame(() => ok()));
+
+const MEMBERS: Array<[string, () => ReturnType<typeof h>, string]> = [
+    ["switch", () => h(Switch), '[data-slot="switch"]'],
+    ["checkbox", () => h(Checkbox), '[data-slot="checkbox"]'],
+    ["radio", () => h(RadioGroup, { defaultValue: "a" }, () => [h(RadioGroupItem, { value: "a" })]), '[data-slot="radio-group-item"]'],
+    ["chip (selectable)", () => h(Chip as Component, { mode: "selectable" }, () => "Chip"), ".engage-chosen"],
+    ["toggle item", () => h(ToggleGroup, { type: "single" }, () => [h(ToggleGroupItem, { value: "a" }, () => "A")]), '[data-slot="toggle-group-item"]'],
+    [
+        "accordion trigger",
+        () =>
+            h(Accordion, { type: "single", collapsible: true }, () => [
+                h(AccordionItem, { value: "one" }, () => [h(AccordionTrigger, () => "One"), h(AccordionContent, () => "Body")]),
+            ]),
+        '[data-slot="accordion-trigger"]',
+    ],
+    ["collapsible trigger", () => h(Collapsible, () => [h(CollapsibleTrigger, () => "More")]), '[data-slot="collapsible-trigger"]'],
+    ["select trigger", () => h(Select, () => [h(SelectTrigger, () => [h(SelectValue, { placeholder: "Pick" })])]), '[data-slot="select-trigger"]'],
+    ["dropdown trigger", () => h(DropdownMenu, () => [h(DropdownMenuTrigger, () => "Menu")]), '[data-slot="menu-trigger"]'],
+    ["popover trigger", () => h(Popover, () => [h(PopoverTrigger, () => "Open")]), '[aria-haspopup="dialog"]'],
+    ["segmented tabs", () => h(SegmentedTabs, { modelValue: "a", options: [{ label: "A", value: "a" }, { label: "B", value: "b" }], ariaLabel: "t" }), ".segmented-tabs"],
+];
+
+describe("route A's state members hold the mount frame through the door (CK-03)", () => {
+    for (const [name, render, sel] of MEMBERS) {
+        it(`${name}: armed at mount, lifted after the first frame`, async () => {
+            const w = mount(defineComponent({ setup: () => render }), { attachTo: document.body });
+            await nextTick();
+            const host = w.element.ownerDocument.querySelector(sel) as HTMLElement | null;
+            expect(host, `${name} rendered no ${sel}`).not.toBeNull();
+            expect(host!.hasAttribute("data-engage-arming")).toBe(true);
+            await frame();
+            await frame();
+            expect(host!.hasAttribute("data-engage-arming")).toBe(false);
+            w.unmount();
+        });
+    }
+});
+
+
+describe("the popover trigger stamps its class on either path (CK-01)", () => {
+    const classesOf = (asChild: boolean, child: () => ReturnType<typeof h>): string[] => {
+        const w = mount(
+            defineComponent({ setup: () => () => h(Popover, () => [h(PopoverTrigger, { asChild }, child)]) }),
+            { attachTo: document.body },
+        );
+        const el = w.element.ownerDocument.querySelector('[aria-haspopup="dialog"]') as HTMLElement;
+        const out = [...el.classList].filter((c) => c.startsWith("engage-"));
+        w.unmount();
+        return out;
+    };
+
+    it("its own button is disclosed", () => {
+        expect(classesOf(false, () => h("span", "Open"))).toEqual(["engage-disclosed"]);
+    });
+
+    it("as-child, a plain element it merges onto is disclosed", () => {
+        expect(classesOf(true, () => h("span", { tabindex: 0 }, "Open"))).toEqual(["engage-disclosed"]);
+    });
+
+    it("as-child over a library Button, the Button carries one class, the disclosure's", () => {
+        expect(classesOf(true, () => h(Button, () => "Open"))).toEqual(["engage-disclosed"]);
+    });
+});
