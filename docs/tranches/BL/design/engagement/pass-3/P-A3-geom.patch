diff --git a/tests/styles/engage-floor.test.ts b/tests/styles/engage-floor.test.ts
new file mode 100644
index 000000000..9a39581f0
--- /dev/null
+++ b/tests/styles/engage-floor.test.ts
@@ -0,0 +1,87 @@
+// The engagement register's shared rules (utilities/engage.css; D5 pass 3, F5'): the
+// mount frame's transition hold (CK-03, F-7) and the commit light's reduced-motion
+// authorization, AUTH-4 of BJ's §PRM-AUTHORIZED-SET (CK-10, F-9).
+//
+// happy-dom runs no cascade, so these read the shipped source; the battery reads the paint.
+
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { describe, expect, it } from "vitest";
+
