index 000000000..324081089
--- /dev/null
+++ b/src/composables/motion/engage/engageClasses.ts
@@ -0,0 +1,141 @@
+// The glass-ui ENGAGEMENT DECLARATION: what each component directory IS on the ladder.
+//
+// The ladder (`engageLadder.ts`) names the rungs; this table names the members. Every
+// component directory is declared into exactly one class (a mode-split member lists
+// each class it may render as), and every class names the highest ladder rung it owes,
+// or none with the reason. One source of record: a class's look and motion live in its
+// one recipe, and the recipe stamps the class on the element it paints as the
+// registered `--rung-class` (`tokens/property-regs.css`; initial value `unclassed`).
+//
+// The census reads THIS table and then the rendered element, never source bytes: a
+// member is adopted when its rendered root computes a `--rung-class` its row declares.
+// Until every member is, the census is RED by its latch (`tests/styles/engage-ladder`).
+//
+// It mints no figure: rungs come from `ENGAGE_LADDER`, clocks from the spring and
+// envelope tables, scales from the scale register.
+
+import type { EngageRungName } from "./engageLadder";
+
+/** The register classes. */
+export type EngageClass =
+    | "pressed"
+    | "chosen"
+    | "held"
+    | "dragged"
+    | "disclosed"
+    | "presented"
+    | "field"
+    | "ambient"
+    | "static";
+
+/** One class: the rung it owes, or none with the reason, and the directory that proves it. */
+export interface EngageClassRow {
+    readonly rung: EngageRungName | null;
+    readonly reason?: string;
+    readonly exemplar?: string;
+    /** The class's recipe plays a commit edge (CK-02's members). The engage door reads
+     *  the commit's tokens loudly on a host that stamps it (`useEngage`). */
+    readonly commits?: true;
+}
+
+export interface EngageDeclaration {
+    readonly classes: Readonly<Record<EngageClass, EngageClassRow>>;
+    /** Each directory's PRIMARY class. */
+    readonly members: Readonly<Record<string, EngageClass>>;
+    /** A member whose class depends on its rendered mode lists every class it may
+     *  stamp (its primary first). The runtime census accepts any of them per element. */
+    readonly modes: Readonly<Record<string, readonly EngageClass[]>>;
+}
+
+export const ENGAGE_DECLARATION: EngageDeclaration = {
+    classes: {
+        pressed: { rung: "press", exemplar: "button", commits: true },
+        chosen: { rung: "press", exemplar: "switch", commits: true },
+        held: { rung: "engaged", exemplar: "slider" },
+        dragged: { rung: "press", exemplar: "sortable-list" },
+        disclosed: { rung: "press", exemplar: "accordion", commits: true },
+        presented: { rung: "modal", exemplar: "sheet" },
+        field: { rung: "hover", exemplar: "input" },
+        ambient: { rung: "rest", exemplar: "aurora" },
+        static: {
+            rung: null,
+            reason: "no input of its own: its engagement is its host's (a separator, a placeholder) or its members' (a table, a labelled field)",
+        },
+    },
+    members: {
+        accordion: "disclosed",
+        alert: "static",
+        aurora: "ambient",
+        avatar: "static",
+        badge: "static",
+        blob: "ambient",
+        button: "pressed",
+        card: "static",
+        carousel: "dragged",
+        checkbox: "chosen",
+        chip: "chosen",
+        collapsible: "disclosed",
+        command: "field",
+        configurator: "static",
+        constellation: "ambient",
+        "dark-mode-toggle": "chosen",
+        "data-table": "static",
+        deck: "dragged",
+        dialog: "presented",
+        dock: "held",
+        easing: "chosen",
+        "expandable-container": "disclosed",
+        "fading-scroll": "dragged",
+        "fourier-field": "ambient",
+        handmark: "ambient",
+        "infinite-scroll": "dragged",
+        input: "field",
+        label: "static",
+        "labeled-field": "static",
+        menu: "disclosed",
+        metric: "static",
+        "music-staff": "ambient",
+        "number-field": "held",
+        "pager-dots": "chosen",
+        popover: "disclosed",
+        progress: "static",
+        "radio-group": "chosen",
+        "scroll-progress-rim": "static",
+        select: "disclosed",
+        separator: "static",
+        sheet: "presented",
+        skeleton: "static",
+        slider: "held",
+        "sortable-list": "dragged",
+        "status-dot": "static",
+        surface: "static",
+        switch: "chosen",
+        table: "static",
+        tabs: "chosen",
+        textarea: "field",
+        timeline: "static",
+        toast: "presented",
+        "toggle-group": "chosen",
+        tooltip: "presented",
+        typewriter: "static",
+    },
+    modes: {
+        // selectable → chosen; action → pressed; removable and static → static (the
+        // remove button is its own control)
+        chip: ["chosen", "pressed", "static"],
+        // inert prose → static; `selected` present (even false) makes it an option, with
+        // a role and a tab stop → chosen
+        card: ["static", "chosen"],
+        // a Card renders through a Surface, so the Surface's root is the Card's: it
+        // carries whichever class the Card stamps
+        surface: ["static", "chosen"],
+        // the configurator is prose and rows; each layer's header is a disclosure
+        configurator: ["static", "disclosed"],
+        // the trigger discloses; the panel it opens is a presented plate
+        popover: ["disclosed", "presented"],
+        // a timeline REPORTS (`role="progressbar"`, never a slider): the bar is static and
+        // each span's mark is a press that selects it. Nothing in it is held, so it has no
+        // `held` stamp to leave unengaged (C-A2 §0 item 5)
+        timeline: ["static", "pressed"],
+    },
+};
