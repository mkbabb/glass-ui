index 000000000..08d4791dc
--- /dev/null
+++ b/src/composables/motion/engage/hold.ts
@@ -0,0 +1,136 @@
+import { onBeforeUnmount, onMounted, onScopeDispose, ref, type Ref } from "vue";
+
+/**
+ * ══ THE HAND, AND THE ONE KEEP-OPEN TOKEN ══
+ *
+ * Two pieces that every engaged control composes, kept beside the engage door that
+ * owns them (`useEngage.ts`). Neither knows about a dock: the posture a hold takes is
+ * handed in as a `HoldTarget`, so this module imports nothing from `components/`.
+ *
+ * WHAT KIND OF HOLD A TOKEN IS. Two different facts, and only one is a hand:
+ *  - `"morph"` (the default): posture only. "Something is open and the host must not
+ *    idle-collapse under it": an armed search field, an open popover, a focused
+ *    switcher tab. It is NOT a hand and never engages the grasp optic (glass/grasp.css).
+ *  - `"grasp"`: a live pointer hold on a control. A grasp implies a morph hold (a
+ *    finger down must also hold the host open), so a target takes both counts.
+ */
+export type HoldKind = "morph" | "grasp";
+
+/** The ref-counted posture a token holds: the dock's `keepOpen`/`release` pair. */
+export interface HoldTarget {
+    keepOpen: (kind?: HoldKind) => void;
+    release: (kind?: HoldKind) => void;
+}
+
+export interface HoldToken {
+    /** `true` while this token holds its count. */
+    readonly isHeld: Readonly<Ref<boolean>>;
+    /** Idempotent: a second call while held is a no-op, never a second count. */
+    acquire: () => void;
+    /** Idempotent: a release while free is a no-op, never a negative count. */
+    release: () => void;
+}
+
+/**
+ * One holder takes exactly one count and gives it back exactly once, including on
+ * teardown. Four sites used to hand-roll these six lines (a Popover, the dock layer
+ * group, the dock search, the hand); a leaked token is a dock that never idle-collapses
+ * again for the life of the page.
+ *
+ * `target` is a getter so a holder can sit above the thing it holds. A null target is
+ * not an error: the flag still flips, because whether the holder is holding is a fact
+ * about the holder, not about whether a dock happened to be listening.
+ */
+export function useHoldToken(
+    target: () => HoldTarget | null | undefined,
+    kind?: HoldKind,
+): HoldToken {
+    const isHeld = ref(false);
+
+    function acquire(): void {
+        if (isHeld.value) return;
+        isHeld.value = true;
+        target()?.keepOpen(kind);
+    }
+
+    function release(): void {
+        if (!isHeld.value) return;
+        isHeld.value = false;
+        target()?.release(kind);
+    }
+
+    onScopeDispose(release);
+
+    return { isHeld, acquire, release };
+}
+
+export interface UseHoldOptions {
+    /** The posture the hold takes (the enclosing dock's context), or none. */
+    target?: () => HoldTarget | null | undefined;
+    /** Whether the hold is armed. A getter, so a prop can disarm it live. Default armed. */
+    enabled?: () => boolean;
+}
+
+/**
+ * THE HAND: a host's own live pointer or touch hold.
+ *
+ * The only path in the library driven by a pointer actually going down, so it is the
+ * one the grasp register (glass/grasp.css) is sourced from. The returned `isHeld` flips
+ * with the finger whether or not a target is listening: a standalone control engages
+ * on its own drag, and a control inside a dock never co-engages off a sibling's hold.
+ *
+ * Native listeners on the RESOLVED host, for three reasons: `pointerdown` and
+ * `touchstart` fold onto one acquire under one owner; the release is window-scoped and
+ * so survives reka's `setPointerCapture` retarget; and the acquire is capture-
+ * independent, so it is instant-on (the halo lights the instant the pointer goes down;
+ * the spring governs only the settle). reka's `<SliderRoot>` does forward a consumer
+ * `@pointerdown` (`mergeProps` chains it), but last, after its own slide start.
+ *
+ * @param resolveHost a getter for the real host element, called in `onMounted`, so a
+ *   reka forwardRef host (`SliderRoot.$el`) is live by then.
+ */
+export function useHold(
+    resolveHost: () => HTMLElement | null,
+    options: UseHoldOptions = {},
+): { isHeld: Readonly<Ref<boolean>> } {
+    const armed = options.enabled ?? (() => true);
+    const token = useHoldToken(() => options.target?.(), "grasp");
+
+    const off = (): void => {
+        window.removeEventListener("pointerup", onWindowRelease);
+        window.removeEventListener("pointercancel", onWindowRelease);
+        window.removeEventListener("blur", onWindowRelease);
+    };
+
+    function onWindowRelease(): void {
+        token.release();
+        off();
+    }
+
+    function onPress(): void {
+        if (!armed()) return;
+        token.acquire();
+        // remove-then-add: a touch then its synthesized pointer must not install two
+        off();
+        window.addEventListener("pointerup", onWindowRelease);
+        window.addEventListener("pointercancel", onWindowRelease);
+        window.addEventListener("blur", onWindowRelease);
+    }
+
+    let host: HTMLElement | null = null;
+    onMounted(() => {
+        host = resolveHost();
+        host?.addEventListener("pointerdown", onPress);
+        host?.addEventListener("touchstart", onPress, { passive: true });
+    });
+    onBeforeUnmount(() => {
+        // a gesture mid-flight at unmount (a slider unmounted under a held thumb) gives
+        // its count back here, so the target's keep-open count can never leak
+        host?.removeEventListener("pointerdown", onPress);
+        host?.removeEventListener("touchstart", onPress);
+        if (typeof window !== "undefined") off();
+        token.release();
+    });
+
+    return { isHeld: token.isHeld };
+}
diff --git a/src/composables/motion/engage/press.ts b/src/composables/motion/engage/press.ts
new file mode 100644
index 000000000..f82b1d6ee
--- /dev/null
+++ b/src/composables/motion/engage/press.ts
@@ -0,0 +1,63 @@
+// The press mark: the door's one writer of `data-press`.
+//
+// `data-press` says the press part is down: a primary pointer down on the control, or
+// its activation key (Enter, Space) held. The engage door marks its host with it
+// (`useEngage`'s press part), and a group control whose press lands on one of many hit
+// targets and is painted on an organ elsewhere (the pager rail: a transparent button
+// over a pip in the bed layer) names that organ with `organ`. Either way this file is
+// the only place the attribute is written (CK-08).
+//
+// The mark is the hand's state only. It paints nothing: the recipe that reads it does.
+
+import { onBeforeUnmount, onMounted } from "vue";
+
+/** Native listeners on the host, bound at mount and dropped at unmount. */
+export function listen(host: () => HTMLElement | null, on: [string, (e: Event) => void][]): void {
+    let el: HTMLElement | null = null;
+    onMounted(() => {
+        el = host();
+        for (const [n, f] of on) el?.addEventListener(n, f);
+    });
+    onBeforeUnmount(() => {
+        for (const [n, f] of on) el?.removeEventListener(n, f);
+    });
+}
+
+export interface UsePressMarkOptions {
+    /** The element a press marks, from the event that pressed (default the host). */
+    organ?: (e: Event) => Element | null | undefined;
+    /** A disabled control is not pressed. */
+    disabled?: () => boolean;
+}
+
+const ACTIVATION_KEYS: ReadonlySet<string> = new Set(["Enter", " "]);
+
+export function usePressMark(host: () => HTMLElement | null, o: UsePressMarkOptions = {}): void {
+    let marked: Element | null = null;
+    const down = (e: Event): void => {
+        if (o.disabled?.()) return;
+        const el = o.organ ? o.organ(e) : host();
+        if (!el || el === marked) return;
+        up();
+        marked = el;
+        el.setAttribute("data-press", "");
+    };
+    const up = (): void => {
+        marked?.removeAttribute("data-press");
+        marked = null;
+    };
+    listen(host, [
+        ["pointerdown", (e) => { if ((e as PointerEvent).button === 0) down(e); }],
+        ["pointerenter", (e) => { if ((e as PointerEvent).buttons & 1) down(e); }],
+        ["pointerup", up],
+        ["pointercancel", up],
+        ["pointerleave", up],
+        ["keydown", (e) => {
+            const k = e as KeyboardEvent;
+            if (ACTIVATION_KEYS.has(k.key) && !k.repeat) down(e);
+        }],
+        ["keyup", (e) => { if (ACTIVATION_KEYS.has((e as KeyboardEvent).key)) up(); }],
+        ["focusout", up],
+    ]);
+    onBeforeUnmount(up);
+}
diff --git a/src/composables/motion/engage/release.ts b/src/composables/motion/engage/release.ts
new file mode 100644
index 000000000..dedc3891e
--- /dev/null
+++ b/src/composables/motion/engage/release.ts
@@ -0,0 +1,69 @@
+// THE RELEASE RULE: hallmark 6's one measurement.
+//
+// "A release carries its velocity into the settle" has two halves. This file is the
+// first, for every surface: the release velocity is the chord across the pointer
+// samples no older than the rule's window, measured back from the release itself, and
+// the release is a sample. A finger held still for longer than the window before it
+// lifts therefore throws nothing, and one stalled frame cannot fling anything.
+//
+// The second half, the settle, stays with each surface, seeded with this velocity on a
+// named spring row (`springPresets.ts`): the slider's carry and the tabs drag on `dock`
+// through the engage door and the drag morph, the sortable flight on `dock`
+// (`sortable-list/motion.ts`), the Sheet on its own detent legs (`sheet/detents`).
+//
+// Pure data and arithmetic: no Vue, no keyframes.js. `useDragVelocity` ships on the
+// keyframes-free root and `/dom` entries and reads this file.
+
+/** The rule's one table. A surface reads it; none restates a figure from it. */
+export const RELEASE_RULE = {
+    /**
+     * The velocity window, in ms: only samples this young, against the release, count.
+     * It is the drag engine's own default (keyframes.js `Draggable`'s `velocityWindow`,
+     * 100 ms) and the platforms' velocity-tracker horizon (Android `VelocityTracker`,
+     * Flutter `VelocityTracker._horizonMilliseconds`), so a drag measured here and a
+     * drag the engine measures agree. It is not the press-acknowledge budget
+     * (`ACKNOWLEDGE_WINDOW_MS`), which bounds how fast a press is answered, not how far
+     * back a release looks.
+     */
+    windowMs: 100,
+    /** The settle row a release carry rides unless its surface names its own. */
+    row: "dock",
+} as const;
+
+/** A pointer sample: position and the clock it was taken on. */
+interface Sample {
+    x: number;
+    y: number;
+    t: number;
+}
+
+/** The last few pointer samples; the release velocity is the chord across the window. */
+export class VelocitySampler {
+    private readonly ring: Sample[] = [];
+    private readonly size = 8;
+
+    push(x: number, y: number, t: number = performance.now()): void {
+        this.ring.push({ x, y, t });
+        if (this.ring.length > this.size) this.ring.shift();
+    }
+
+    reset(): void {
+        this.ring.length = 0;
+    }
+
+    /** px/s across the samples inside the rule's window; `{x:0,y:0}` when there are fewer than two. */
+    velocity(): { x: number; y: number } {
+        const last = this.ring[this.ring.length - 1];
+        const first = last && this.ring.find((s) => last.t - s.t <= RELEASE_RULE.windowMs);
+        if (!first || !last) return { x: 0, y: 0 };
+        const dt = (last.t - first.t) / 1000;
+        if (dt <= 0) return { x: 0, y: 0 };
+        return { x: (last.x - first.x) / dt, y: (last.y - first.y) / dt };
+    }
+
+    /** The release: the lift is a sample, then the windowed velocity. */
+    release(x: number, y: number, t: number = performance.now()): { x: number; y: number } {
+        this.push(x, y, t);
+        return this.velocity();
+    }
+}
diff --git a/src/composables/motion/engage/useEngage.ts b/src/composables/motion/engage/useEngage.ts
new file mode 100644
index 000000000..c9e353634
--- /dev/null
+++ b/src/composables/motion/engage/useEngage.ts
@@ -0,0 +1,376 @@
+// useEngage: the engage door.
+//
+// Engagement is behaviour, so it has one door. A component hands it its host and names
+// the parts it has; the door owns the state and is the ONLY writer of the engagement
+// attributes:
+//   · data-held      the hand is down on the control (a pointer or touch hold), and only
+//                    that. The grasp register (glass/grasp.css) and a host's own rules
+//                    read it as the hand's
+//   · data-engaged   the control is engaged: the hand is down, or the keyboard is driving
+//                    it. Written on the host and on the organs the adopter names
+//                    (`engagedOn`: a veil, a loupe)
+//   · data-press     the press part is down (written through press.ts, its one writer)
+//   · data-commit    a stateless control's commit edge, as a parity ("a" ↔ "b") that
+//                    flips on every activation
+//   · data-engage-arming   a state member's mount frame (`commit: "state"`): its
+//                    transitions are held off from mount until the first frame
+//                    (utilities/engage.css), so a state that ARRIVES with the mount (an
+//                    async model set in the mount's own task, even after a style read) is
+//                    the rest it mounts in, never a commit. On that frame the door flushes
+//                    style, so the arrived state is the before-change style, and lifts the
+//                    mark. A state set after it commits. B's one-frame arming (CP), moved
+//                    to the door (F5' F-7)
+//
+// The commit's inputs fail loud. On a committing host the door reads the commit envelope
+// (`--engage-control-engage-{attack,release}`) and, when the host's `--rung-class` is a
+// class whose recipe commits (`ENGAGE_DECLARATION` `commits`), `--rung-light`: a state
+// member at its arming frame and on every `data-state` edge, a stateless one on every
+// `commit()`. Each unreadable token is said once per host in a `console.error`: a
+// transition whose clock does not resolve plays nothing and says nothing (C-A2 CK-21).
+// B's loud read (CP), moved to the door (F-8)
+//
+// The parts, each the shipped leaf composed rather than copied:
+//   · the hand      `useHold` (hold.ts): pointer and touch acquire, the window-scoped
+//                   release, the target's posture token. Beside it the keyboard
+//                   engagement: a focus that a KEY brought (never a script `focus()`,
+//                   never a pointer's), or a key the control acts on, engages; Escape
+//                   and leaving disengage. A modifier alone, or a key the control does
+//                   not act on, does nothing
+//   · the press     `useLiquidPress`, on its one `--press-t` drive with its own defaults:
+//                   the door takes no press options beyond `disabled`. It binds the
+//                   handlers natively and writes the press style on the host, so an
+//                   adopter binds nothing in its template. Under reduced motion the
+//                   press keeps its light (`--press-t`) and drops its geometry (`scale`)
+//   · the commit    `commit: "call"`, a stateless control (a command): the adopter calls
+//                   the returned `commit()` on activation and the door flips the parity.
+//                   `commit: "state"`, a control with a committed state its class recipe
+//                   plays from `data-state`: the door arms its mount frame and reads its
+//                   commit loudly; it plays nothing.
+//                   The door paints nothing for it; a class recipe reads the parity
+//   · the release   `useDragVelocity` measures the release on the release rule
+//                   (release.ts) and the door carries it: the visible body stretches
+//                   toward the fling from its own transform origin and the `dock` row
+//                   (the engaged rung's spring) brings it home. The value the finger
+//                   chose does not move
+
+import {
+    computed,
+    onBeforeUnmount,
+    onMounted,
+    shallowRef,
+    watch,
+    type Ref,
+} from "vue";
+import { SpringProgress } from "@mkbabb/keyframes.js";
+
+import { useDragVelocity } from "../../dom/useDragVelocity";
+import { motionTempo } from "../core/motionTempo";
+import { useLiquidPress } from "../spring/useLiquidPress";
+import { springPreset } from "../spring/springPresets";
+import { ENGAGE_DECLARATION, type EngageClassRow } from "./engageClasses";
+import { useHold, type HoldTarget } from "./hold";
+import { listen, usePressMark } from "./press";
+import { RELEASE_RULE } from "./release";
+
+/** The keys a range control acts on: the acting-key set a held range engages on. */
+const RANGE_ACTING_KEYS: ReadonlySet<string> = new Set([
+    "ArrowLeft",
+    "ArrowRight",
+    "ArrowUp",
+    "ArrowDown",
+    "PageUp",
+    "PageDown",
+    "Home",
+    "End",
+]);
+
+export interface UseEngageOptions {
+    /** The hand, and the keyboard engagement beside it. */
+    hold?: {
+        /** The posture a hold takes (the enclosing dock's context), or none. */
+        target?: () => HoldTarget | null | undefined;
+        /** The keys the control acts on. Default `RANGE_ACTING_KEYS`. */
+        keys?: ReadonlySet<string>;
+        /** Elements that carry `data-held` with the host (a grasp register's host). */
+        heldOn?: () => (Element | null | undefined)[];
+        /** Elements that carry `data-engaged` with the host (a veil, a loupe). */
+        engagedOn?: () => (Element | null | undefined)[];
+    };
+    /** The press: the interruptible press spring on the host. */
+    press?: { disabled?: () => boolean };
+    /** The commit: `"call"`, a stateless edge the adopter fires with `commit()`; `"state"`,
+     *  a committed state the class recipe plays (the door arms the mount frame). */
+    commit?: "call" | "state";
+    /** A drag surface: the axis its velocity is read on and the visible body a release carries. */
+    drag?: {
+        axis: () => "x" | "y";
+        body: () => HTMLElement | null;
+        /** A second element that receives the live drag velocity (a teleported organ). */
+        mirror?: () => HTMLElement | null;
+        enabled?: () => boolean;
+    };
+}
+
+export interface UseEngageReturn {
+    /** The hand is down on the control. */
+    isHeld: Readonly<Ref<boolean>>;
+    /** The hand is down, or the keyboard drives the control. */
+    isEngaged: Readonly<Ref<boolean>>;
+    /** Fire the commit edge now (a stateless control's activation). */
+    commit: () => void;
+}
+
+const reduced = (): boolean =>
+    typeof window !== "undefined" &&
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+// ── the keys held down, page-wide ───────────────────────────────────────────────
+// A focus is the keyboard's only while a key is down: Tab moves focus inside its own
+// keydown, before its keyup. A script `focus()` arrives with no key down. One capture
+// listener pair for the page, installed by the first door that needs it.
+const keysDown = new Set<string>();
+let tracking = false;
+function trackKeys(): void {
+    if (tracking || typeof window === "undefined") return;
+    tracking = true;
+    window.addEventListener("keydown", (e) => keysDown.add(e.key), true);
+    window.addEventListener("keyup", (e) => keysDown.delete(e.key), true);
+    window.addEventListener("blur", () => keysDown.clear());
+}
+
+// ── fail loud ───────────────────────────────────────────────────────────────────
+// once per host and token: each degraded control speaks, none repeats itself
+const said = new WeakMap<Element, Set<string>>();
+function loud(token: string, on: Element): void {
+    const seen = said.get(on) ?? new Set<string>();
+    if (seen.has(token)) return;
+    said.set(on, seen.add(token));
+    console.error(
+        `[glass-ui] useEngage: ${token} is unreadable on the host; the engagement it drives paints nothing. Is the glass-ui stylesheet loaded?`,
+    );
+}
+
+/** The commit envelope's clocks, in `ENGAGE_ENVELOPES`' CSS mirror (`control-engage`). */
+const COMMIT_CLOCKS = ["--engage-control-engage-attack", "--engage-control-engage-release"] as const;
+
+const supports = (prop: string, v: string): boolean =>
+    v !== "" && (typeof CSS === "undefined" || typeof CSS.supports !== "function" || CSS.supports(prop, v));
+
+/** The host's declared class commits: its recipe plays a commit edge. */
+function commitsByClass(h: Element): boolean {
+    const name = getComputedStyle(h).getPropertyValue("--rung-class").trim();
+    const rows = ENGAGE_DECLARATION.classes as Readonly<Record<string, EngageClassRow | undefined>>;
+    return rows[name]?.commits === true;
+}
+
+/** Read the commit's inputs on the host, loudly: the envelope's clocks, and the light a class recipe paints with. */
+function readCommit(h: Element, light: boolean): void {
+    const cs = getComputedStyle(h);
+    for (const t of COMMIT_CLOCKS) if (!supports("transition-duration", cs.getPropertyValue(t).trim())) loud(t, h);
+    if (light && !supports("color", cs.getPropertyValue("--rung-light").trim())) loud("--rung-light", h);
+}
+
+/** A row's settle clock in ms, read from its CSS token on `el` (tempo included); 0, loudly, when unreadable. */
+function rowClockMs(row: string, el: Element): number {
+    const token = `--spring-${row}-settle`;
+    const s = Number.parseFloat(getComputedStyle(el).getPropertyValue(token));
+    if (Number.isFinite(s) && s > 0) return s * 1000 * motionTempo(el);
+    loud(token, el);
+    return 0;
+}
+
+/** A row's response to an impulse: displacement 0, velocity `v0`, target 0, sampled over `ms`. */
+function impulseFrames(v0: number, ms: number, n = 24): number[] {
+    const r = springPreset(RELEASE_RULE.row);
+    const spring = new SpringProgress({
+        response: r.response * motionTempo(),
+        dampingFraction: r.dampingFraction,
+        initial: 0,
+        initialVelocity: v0,
+        respectReducedMotion: false,
+    });
+    spring.target = 0;
+    const out: number[] = [];
+    for (let k = 0; k <= n; k++) out.push(k === n ? 0 : spring.tickToTime((k / n) * (ms / 1000)));
+    spring.dispose();
+    return out;
+}
+
+/**
+ * The release carry on the visible body: its edge away from its transform origin (the
+ * leading edge of a fill) travels with the fling and the row brings it home, as a
+ * stretch along the axis composited onto whatever transform the body already plays.
+ */
+function carry(body: HTMLElement, axis: "x" | "y", v: number): void {
+    if (!v) return;
+    const ms = rowClockMs(RELEASE_RULE.row, body);
+    if (!ms) return;
+    const box = body.getBoundingClientRect();
+    const length = axis === "x" ? box.width : box.height;
+    if (length < 1) return;
+    const [ox, oy] = getComputedStyle(body).transformOrigin.split(" ").map(Number.parseFloat);
+    const origin = axis === "x" ? ox : oy;
+    // the edge that moves is the one away from the origin: a fill growing from its start
+    // stretches with a forward fling and shortens with a backward one
+    const dir = (origin ?? 0) <= length / 2 ? 1 : -1;
+    const s = (d: number): number => Math.max(0, 1 + (dir * d) / length);
+    body.animate(
+        impulseFrames(v, ms).map((d) => ({
+            transform: axis === "x" ? `scaleX(${s(d)})` : `scaleY(${s(d)})`,
+        })),
+        { duration: ms, composite: "add" },
+    );
+}
+
+export function useEngage(
+    host: () => HTMLElement | null,
+    o: UseEngageOptions,
+): UseEngageReturn {
+    // ── the hand, and the keyboard that engages like it ─────────────────────────
+    const isHeld: Readonly<Ref<boolean>> = o.hold
+        ? useHold(host, { target: o.hold.target }).isHeld
+        : shallowRef(false);
+    const keyed = shallowRef(false);
+    const isEngaged = computed(() => isHeld.value || keyed.value);
+    if (o.hold) {
+        const h = o.hold;
+        const keys = h.keys ?? RANGE_ACTING_KEYS;
+        trackKeys();
+        // A pointer's focus (reka focuses the thumb by script on a slide) is not the
+        // keyboard's, though `:focus-visible` may match it, and a key held through a
+        // click (Shift-click) must not make it one. The mark lives as long as the hand.
+        let pointed = false;
+        watch(isHeld, (held) => {
+            if (!held) pointed = false;
+        });
+        listen(host, [
+            ["pointerdown", () => { pointed = true; keyed.value = false; }],
+            ["focusin", () => { keyed.value = !pointed && keysDown.size > 0; }],
+            ["keydown", (e) => {
+                const k = (e as KeyboardEvent).key;
+                if (k === "Escape") keyed.value = false;
+                else if (keys.has(k)) keyed.value = true;
+            }],
+            ["focusout", (e) => {
+                const to = (e as FocusEvent).relatedTarget as Node | null;
+                if (to && host()?.contains(to)) return;
+                keyed.value = false;
+            }],
+        ]);
+        watch(
+            () => [isHeld.value, isEngaged.value, h.heldOn?.(), h.engagedOn?.()] as const,
+            ([held, engaged, heldOn, engagedOn]) => {
+                const el = host();
+                for (const x of [el, ...(heldOn ?? [])]) x?.toggleAttribute("data-held", held);
+                for (const x of [el, ...(engagedOn ?? [])]) x?.toggleAttribute("data-engaged", engaged);
+                // The held class's grow reads `--scale-engage` in CSS, where an unreadable
+                // value fails silently to no grow; the door that marks the engagement says
+                // so once (CK-21), the same voice as its clock reads.
+                if (engaged && el?.classList.contains("engage-held")) {
+                    const v = Number.parseFloat(getComputedStyle(el).getPropertyValue("--scale-engage"));
+                    if (!Number.isFinite(v)) loud("--scale-engage", el);
+                }
+            },
+            { flush: "post" },
+        );
+    }
+
+    // ── the press ──────────────────────────────────────────────────────────────
+    if (o.press) {
+        const disabled = o.press.disabled;
+        const el = shallowRef<HTMLElement | null>(null);
+        const p = useLiquidPress({ el, disabled });
+        let written: string[] = [];
+        watch(
+            () => p.pressStyle.value,
+            (style) => {
+                const h = el.value;
+                if (!h) return;
+                const rec = style as Record<string, string>;
+                for (const k of written) if (!(k in rec)) h.style.removeProperty(k);
+                // under reduce the press keeps its light and drops its geometry
+                written = Object.keys(rec).filter((k) => k !== "scale" || !reduced());
+                for (const k of written) h.style.setProperty(k, rec[k]!);
+            },
+            { flush: "sync" },
+        );
+        // the mark is press.ts's, the one writer of `data-press`
+        usePressMark(host, { disabled });
+        listen(host, [
+            ["pointerdown", (e) => p.handlers.onPointerdown(e as PointerEvent)],
+            ["pointerenter", (e) => p.handlers.onPointerenter(e as PointerEvent)],
+            ["pointerup", () => p.handlers.onPointerup()],
+            ["pointercancel", () => p.handlers.onPointercancel()],
+            ["pointerleave", () => p.handlers.onPointerleave()],
+            ["keydown", (e) => p.handlers.onKeydown(e as KeyboardEvent)],
+            ["keyup", (e) => p.handlers.onKeyup(e as KeyboardEvent)],
+            ["blur", () => p.handlers.onBlur()],
+        ]);
+        onMounted(() => {
+            el.value = host();
+            // the press is JS-owned from here: the `:active` CSS floors stand down
+            el.value?.setAttribute("data-press-armed", "");
+        });
+    }
+
+    // ── the release, carried on the visible body ────────────────────────────────
+    if (o.drag) {
+        const d = o.drag;
+        useDragVelocity({
+            host: () => (d.enabled?.() === false ? null : host()),
+            mirror: d.mirror,
+            axis: d.axis,
+            onRelease: (v) => {
+                const body = d.body();
+                if (body && !reduced()) carry(body, d.axis(), v);
+            },
+        });
