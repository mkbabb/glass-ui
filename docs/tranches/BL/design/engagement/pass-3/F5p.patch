--- /dev/null
+++ b/src/styles/utilities/engage.css
@@ -0,0 +1,57 @@
+/* utilities/engage.css
+   The engagement register's shared rules: what every engagement recipe stands on.
+   A partial of the utilities.css cascade; @import-ed by utilities.css in cascade order.
+   See docs/precepts/design-idioms.md §cohesion-aware partials. */
+
+@layer components {
+    /* ── THE MOUNT FRAME (the one-frame commit arming) ──────────────────────────────
+       The engage door (composables/motion/engage/useEngage.ts) marks its host
+       `data-engage-arming` from mount until the first frame, where it flushes style
+       and lifts the mark. Until then nothing under the host transitions, so a state
+       that arrives with the mount (an async model set in the mount's own task, even
+       after something read style) is the rest the host mounts in, not a commit
+       (CK-03). Only `transition-property` is held: a duration or an authorization is
+       untouched, and an animation (an entrance keyframe) is not a transition. The
+       theme flip's `html.no-transition` (a11y-overrides.css) is the same idiom for
+       a different moment. */
+    [data-engage-arming],
+    [data-engage-arming] *,
+    [data-engage-arming]::before,
+    [data-engage-arming]::after,
+    [data-engage-arming] *::before,
+    [data-engage-arming] *::after {
+        transition-property: none !important;
+    }
+}
+
+/* AUTH-4 begin ── PRM-AUTHORIZED (docs/tranches/BJ/waves/BAND-FEEDBACK-MOTION.md
+   §PRM-AUTHORIZED-SET, row AUTH-4): the engagement commit light keeps its envelope
+   clocks under reduced motion. The commit is light (CK-02 arm iii, Q-5's default),
+   and light is the channel reduced motion keeps (CK-10); the library's instant
+   fallback (a11y-overrides.css, `*, *::after { transition-duration: 0s !important }`)
+   would zero it. The rows name the commit seat exactly as the recipes do (the host's
+   `::after` on a face-less member, the face's `[data-engage-light]` layer otherwise)
+   and outrank the `*` fallback by specificity inside `@layer components`, as the
+   transitions.css fade rows do. The clocks are `ENGAGE_ENVELOPES`' `control-engage`
+   row, in each state's leg order (the gate's opacity, then the charge's
+   background-color): at rest the gate closes on the release over a charge that
+   returns on the attack; committed, the gate opens on the attack over a charge that
+   drains on the release. No transform rides it. CP's row (D5 pass 2,
+   `CP/css-prm-over-css.patch`), placed by F5' (F-9). */
+@layer components {
+    @media (prefers-reduced-motion: reduce) {
+        :where(.engage-chosen, .engage-pressed, .engage-disclosed):not(:has([data-engage-face]))::after,
+        :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+            transition-duration:
+                var(--engage-control-engage-release), var(--engage-control-engage-attack) !important;
+        }
+
+        :where(.engage-chosen, .engage-disclosed):is([data-state="checked"], [data-state="open"]):not(:has([data-engage-face]))::after,
+        :where(.engage-chosen, .engage-disclosed):is([data-state="checked"], [data-state="open"]) [data-engage-light],
+        :where(.engage-pressed)[data-commit="b"]::after {
+            transition-duration:
+                var(--engage-control-engage-attack), var(--engage-control-engage-release) !important;
+        }
+    }
+}
+/* AUTH-4 end */
