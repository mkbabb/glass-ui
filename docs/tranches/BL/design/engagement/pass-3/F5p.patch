@@ -0,0 +1,87 @@
+// The engagement register's shared rules (utilities/engage.css; D5 pass 3, F5'): the
+// mount frame's transition hold (CK-03, F-7) and the commit light's reduced-motion
+// authorization, AUTH-4 of BJ's §PRM-AUTHORIZED-SET (CK-10, F-9).
+//
+// happy-dom runs no cascade, so these read the shipped source; the battery reads the paint.
+
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+const read = (rel: string): string => readFileSync(join(process.cwd(), rel), "utf8");
+const ENGAGE = read("src/styles/utilities/engage.css");
+const UTILITIES = read("src/styles/utilities.css");
+const A11Y = read("src/styles/utilities/a11y-overrides.css");
+const decomment = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+
+/** `sed -n '/AUTH-4 begin/,/AUTH-4 end/p'`: whole lines, each with its newline. */
+const authBlock = (): string => {
+    const lines = ENGAGE.split("\n");
