@@ -0,0 +1,315 @@
+// useEngage: the engage door.
+//
+// Engagement is behaviour, so it has one door. A component hands it its host and names
+// the parts it has; the door owns the state and is the ONLY writer of the engagement
+// attributes:
+//   · data-held      the hand is down on the control (a pointer or touch hold), and only
+//                    that. The grasp register (glass/grasp.css) and a host's own rules
+//                    read it as the hand's
+//   · data-engaged   the control is engaged: the hand is down, or the keyboard is driving
+//                    it. Written on the host and on the organs the adopter names
+//                    (`engagedOn`: a veil, a loupe)
+//   · data-press     the press part is down
+//   · data-commit    a stateless control's commit edge, as a parity ("a" ↔ "b") that
+//                    flips on every activation
+//
+// The parts, each the shipped leaf composed rather than copied:
+//   · the hand      `useHold` (hold.ts): pointer and touch acquire, the window-scoped
+//                   release, the target's posture token. Beside it the keyboard
+//                   engagement: a focus that a KEY brought (never a script `focus()`,
+//                   never a pointer's), or a key the control acts on, engages; Escape
+//                   and leaving disengage. A modifier alone, or a key the control does
+//                   not act on, does nothing
+//   · the press     `useLiquidPress`, on its one `--press-t` drive with its own defaults:
+//                   the door takes no press options beyond `disabled`. It binds the
+//                   handlers natively and writes the press style on the host, so an
+//                   adopter binds nothing in its template. Under reduced motion the
+//                   press keeps its light (`--press-t`) and drops its geometry (`scale`)
+//   · the commit    `commit: "call"`, a stateless control (a command): the adopter calls
+//                   the returned `commit()` on activation and the door flips the parity.
+//                   The door paints nothing for it; a class recipe reads the parity
+//   · the release   `useDragVelocity` measures the release on the release rule
+//                   (release.ts) and the door carries it: the visible body stretches
+//                   toward the fling from its own transform origin and the `dock` row
+//                   (the engaged rung's spring) brings it home. The value the finger
+//                   chose does not move
+
+import {
+    computed,
+    onBeforeUnmount,
+    onMounted,
+    shallowRef,
+    watch,
+    type Ref,
+} from "vue";
+import { SpringProgress } from "@mkbabb/keyframes.js";
+
+import { useDragVelocity } from "../../dom/useDragVelocity";
+import { motionTempo } from "../core/motionTempo";
+import { useLiquidPress } from "../spring/useLiquidPress";
+import { springPreset } from "../spring/springPresets";
+import { useHold, type HoldTarget } from "./hold";
+import { RELEASE_RULE } from "./release";
+
+/** The keys a range control acts on: the acting-key set a held range engages on. */
+const RANGE_ACTING_KEYS: ReadonlySet<string> = new Set([
+    "ArrowLeft",
+    "ArrowRight",
+    "ArrowUp",
+    "ArrowDown",
+    "PageUp",
+    "PageDown",
+    "Home",
+    "End",
+]);
+
+export interface UseEngageOptions {
+    /** The hand, and the keyboard engagement beside it. */
+    hold?: {
+        /** The posture a hold takes (the enclosing dock's context), or none. */
+        target?: () => HoldTarget | null | undefined;
+        /** The keys the control acts on. Default `RANGE_ACTING_KEYS`. */
+        keys?: ReadonlySet<string>;
+        /** Elements that carry `data-held` with the host (a grasp register's host). */
+        heldOn?: () => (Element | null | undefined)[];
+        /** Elements that carry `data-engaged` with the host (a veil, a loupe). */
+        engagedOn?: () => (Element | null | undefined)[];
+    };
+    /** The press: the interruptible press spring on the host. */
+    press?: { disabled?: () => boolean };
+    /** A stateless control's commit edge: the adopter calls `commit()` on activation. */
+    commit?: "call";
+    /** A drag surface: the axis its velocity is read on and the visible body a release carries. */
+    drag?: {
+        axis: () => "x" | "y";
+        body: () => HTMLElement | null;
+        /** A second element that receives the live drag velocity (a teleported organ). */
+        mirror?: () => HTMLElement | null;
+        enabled?: () => boolean;
+    };
+}
+
+export interface UseEngageReturn {
+    /** The hand is down on the control. */
+    isHeld: Readonly<Ref<boolean>>;
+    /** The hand is down, or the keyboard drives the control. */
+    isEngaged: Readonly<Ref<boolean>>;
+    /** Fire the commit edge now (a stateless control's activation). */
+    commit: () => void;
+}
+
+const reduced = (): boolean =>
+    typeof window !== "undefined" &&
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+// ── the keys held down, page-wide ───────────────────────────────────────────────
+// A focus is the keyboard's only while a key is down: Tab moves focus inside its own
+// keydown, before its keyup. A script `focus()` arrives with no key down. One capture
+// listener pair for the page, installed by the first door that needs it.
+const keysDown = new Set<string>();
+let tracking = false;
+function trackKeys(): void {
+    if (tracking || typeof window === "undefined") return;
+    tracking = true;
+    window.addEventListener("keydown", (e) => keysDown.add(e.key), true);
+    window.addEventListener("keyup", (e) => keysDown.delete(e.key), true);
+    window.addEventListener("blur", () => keysDown.clear());
+}
+
+// ── fail loud ───────────────────────────────────────────────────────────────────
+const said = new Set<string>();
+function loud(token: string): void {
+    if (said.has(token)) return;
+    said.add(token);
+    console.error(
+        `[glass-ui] useEngage: ${token} is unreadable on the host; the engagement it drives paints nothing. Is the glass-ui stylesheet loaded?`,
+    );
+}
+
+/** A row's settle clock in ms, read from its CSS token on `el` (tempo included); 0, loudly, when unreadable. */
+function rowClockMs(row: string, el: Element): number {
+    const token = `--spring-${row}-settle`;
+    const s = Number.parseFloat(getComputedStyle(el).getPropertyValue(token));
+    if (Number.isFinite(s) && s > 0) return s * 1000 * motionTempo(el);
+    loud(token);
+    return 0;
+}
+
+/** A row's response to an impulse: displacement 0, velocity `v0`, target 0, sampled over `ms`. */
+function impulseFrames(v0: number, ms: number, n = 24): number[] {
+    const r = springPreset(RELEASE_RULE.row);
+    const spring = new SpringProgress({
+        response: r.response * motionTempo(),
+        dampingFraction: r.dampingFraction,
+        initial: 0,
+        initialVelocity: v0,
+        respectReducedMotion: false,
+    });
+    spring.target = 0;
+    const out: number[] = [];
+    for (let k = 0; k <= n; k++) out.push(k === n ? 0 : spring.tickToTime((k / n) * (ms / 1000)));
+    spring.dispose();
+    return out;
+}
+
+/**
+ * The release carry on the visible body: its edge away from its transform origin (the
+ * leading edge of a fill) travels with the fling and the row brings it home, as a
+ * stretch along the axis composited onto whatever transform the body already plays.
+ */
+function carry(body: HTMLElement, axis: "x" | "y", v: number): void {
+    if (!v) return;
+    const ms = rowClockMs(RELEASE_RULE.row, body);
+    if (!ms) return;
+    const box = body.getBoundingClientRect();
+    const length = axis === "x" ? box.width : box.height;
+    if (length < 1) return;
+    const [ox, oy] = getComputedStyle(body).transformOrigin.split(" ").map(Number.parseFloat);
+    const origin = axis === "x" ? ox : oy;
+    // the edge that moves is the one away from the origin: a fill growing from its start
+    // stretches with a forward fling and shortens with a backward one
+    const dir = (origin ?? 0) <= length / 2 ? 1 : -1;
+    const s = (d: number): number => Math.max(0, 1 + (dir * d) / length);
+    body.animate(
+        impulseFrames(v, ms).map((d) => ({
+            transform: axis === "x" ? `scaleX(${s(d)})` : `scaleY(${s(d)})`,
+        })),
+        { duration: ms, composite: "add" },
+    );
+}
+
+/** Native listeners on the host, bound at mount and dropped at unmount. */
+function listen(host: () => HTMLElement | null, on: [string, (e: Event) => void][]): void {
+    let el: HTMLElement | null = null;
+    onMounted(() => {
+        el = host();
+        for (const [n, f] of on) el?.addEventListener(n, f);
+    });
+    onBeforeUnmount(() => {
+        for (const [n, f] of on) el?.removeEventListener(n, f);
+    });
+}
+
+export function useEngage(
+    host: () => HTMLElement | null,
+    o: UseEngageOptions,
+): UseEngageReturn {
+    // ── the hand, and the keyboard that engages like it ─────────────────────────
+    const isHeld: Readonly<Ref<boolean>> = o.hold
+        ? useHold(host, { target: o.hold.target }).isHeld
+        : shallowRef(false);
+    const keyed = shallowRef(false);
+    const isEngaged = computed(() => isHeld.value || keyed.value);
+    if (o.hold) {
+        const h = o.hold;
+        const keys = h.keys ?? RANGE_ACTING_KEYS;
+        trackKeys();
+        // A pointer's focus (reka focuses the thumb by script on a slide) is not the
+        // keyboard's, though `:focus-visible` may match it, and a key held through a
+        // click (Shift-click) must not make it one. The mark lives as long as the hand.
+        let pointed = false;
+        watch(isHeld, (held) => {
+            if (!held) pointed = false;
+        });
+        listen(host, [
+            ["pointerdown", () => { pointed = true; keyed.value = false; }],
+            ["focusin", () => { keyed.value = !pointed && keysDown.size > 0; }],
+            ["keydown", (e) => {
+                const k = (e as KeyboardEvent).key;
+                if (k === "Escape") keyed.value = false;
+                else if (keys.has(k)) keyed.value = true;
+            }],
+            ["focusout", (e) => {
+                const to = (e as FocusEvent).relatedTarget as Node | null;
+                if (to && host()?.contains(to)) return;
+                keyed.value = false;
+            }],
+        ]);
+        watch(
+            () => [isHeld.value, isEngaged.value, h.heldOn?.(), h.engagedOn?.()] as const,
+            ([held, engaged, heldOn, engagedOn]) => {
+                const el = host();
+                for (const x of [el, ...(heldOn ?? [])]) x?.toggleAttribute("data-held", held);
+                for (const x of [el, ...(engagedOn ?? [])]) x?.toggleAttribute("data-engaged", engaged);
+                // The held class's grow reads `--scale-engage` in CSS, where an unreadable
+                // value fails silently to no grow; the door that marks the engagement says
+                // so once (CK-21), the same voice as its clock reads.
+                if (engaged && el?.classList.contains("engage-held")) {
+                    const v = Number.parseFloat(getComputedStyle(el).getPropertyValue("--scale-engage"));
+                    if (!Number.isFinite(v)) loud("--scale-engage");
+                }
+            },
+            { flush: "post" },
+        );
+    }
+
+    // ── the press ──────────────────────────────────────────────────────────────
+    if (o.press) {
+        const disabled = o.press.disabled;
+        const el = shallowRef<HTMLElement | null>(null);
+        const p = useLiquidPress({ el, disabled });
+        let written: string[] = [];
+        watch(
+            () => p.pressStyle.value,
+            (style) => {
+                const h = el.value;
+                if (!h) return;
+                const rec = style as Record<string, string>;
+                for (const k of written) if (!(k in rec)) h.style.removeProperty(k);
+                // under reduce the press keeps its light and drops its geometry
+                written = Object.keys(rec).filter((k) => k !== "scale" || !reduced());
+                for (const k of written) h.style.setProperty(k, rec[k]!);
+            },
+            { flush: "sync" },
+        );
+        const isKey = (e: Event): boolean => ["Enter", " "].includes((e as KeyboardEvent).key);
+        const down = (on: boolean): void => {
+            if (on && disabled?.()) return;
+            el.value?.toggleAttribute("data-press", on);
+        };
+        listen(host, [
+            ["pointerdown", (e) => { p.handlers.onPointerdown(e as PointerEvent); down((e as PointerEvent).button === 0); }],
+            ["pointerenter", (e) => { p.handlers.onPointerenter(e as PointerEvent); if ((e as PointerEvent).buttons & 1) down(true); }],
+            ["pointerup", () => { p.handlers.onPointerup(); down(false); }],
+            ["pointercancel", () => { p.handlers.onPointercancel(); down(false); }],
+            ["pointerleave", () => { p.handlers.onPointerleave(); down(false); }],
+            ["keydown", (e) => { p.handlers.onKeydown(e as KeyboardEvent); if (isKey(e) && !(e as KeyboardEvent).repeat) down(true); }],
+            ["keyup", (e) => { p.handlers.onKeyup(e as KeyboardEvent); if (isKey(e)) down(false); }],
+            ["blur", () => { p.handlers.onBlur(); down(false); }],
+        ]);
+        onMounted(() => {
+            el.value = host();
+            // the press is JS-owned from here: the `:active` CSS floors stand down
+            el.value?.setAttribute("data-press-armed", "");
+        });
+    }
+
+    // ── the release, carried on the visible body ────────────────────────────────
+    if (o.drag) {
+        const d = o.drag;
+        useDragVelocity({
+            host: () => (d.enabled?.() === false ? null : host()),
+            mirror: d.mirror,
+            axis: d.axis,
+            onRelease: (v) => {
+                const body = d.body();
+                if (body && !reduced()) carry(body, d.axis(), v);
+            },
+        });
+    }
+
+    // ── the stateless commit edge ──────────────────────────────────────────────
+    // The parity is stamped at mount (no before-change style, so nothing reads it as a
+    // commit) and flips on every activation, so a recipe keyed on it answers each one.
+    if (o.commit === "call") {
+        onMounted(() => host()?.setAttribute("data-commit", "a"));
+    }
+    const commit = (): void => {
+        const h = host();
+        if (o.commit !== "call" || !h) return;
+        h.setAttribute("data-commit", h.getAttribute("data-commit") === "a" ? "b" : "a");
+    };
+
+    return { isHeld, isEngaged, commit };
+}
diff --git a/src/styles/utilities/engage.css b/src/styles/utilities/engage.css
new file mode 100644
index 000000000..6234c1723
--- /dev/null
+++ b/src/styles/utilities/engage.css
@@ -0,0 +1,140 @@
+/* utilities/engage.css — the engagement classes the commit-path bake-off (D5 pass 2,
+ * seat CP) adopts on the trio (Switch, accordion trigger, Slider) and the Button.
+ *
+ * A member composes its class's utility on the element it paints; every utility stamps
+ * its class as the registered `--rung-class` (tokens/property-regs.css), which the
+ * runtime census reads.
+ *
+ * THE COMMIT IS LIGHT (CK-02 arm iii, Q-5's default). On the commit edge the painted
+ * face's light seat brightens and drains back to the committed rest on the
+ * `control-engage` envelope: a GATE (the seat's opacity) opens on the row's attack
+ * while a CHARGE (the seat's light) drains on its release, and the light is their
+ * product, zero at rest in either state. Its seat is the member's PAINTED FACE: the
+ * host's own `::after`, under its content, or, on a face that carries a mark (the
+ * control bit's thumb), the face's last layer `[data-engage-light]`, over the mark.
+ * WHAT PLAYS THE EDGE is the commit path, the one thing the bake-off varies: the
+ * block at the end of this file. */
+
+@property --rung-grow {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+/* PRESSED — an action with no state (the button). The press is the door's script
+   press; the commit edge is the door's parity (`data-commit` "a" ↔ "b"). */
+@utility engage-pressed {
+    --rung-class: pressed;
+}
+
+/* CHOSEN — a control with a committed state (the switch). The press is light on the
+   member's own paint; the commit is the light below. */
+@utility engage-chosen {
+    --rung-class: chosen;
+}
+
+/* DISCLOSED — a trigger that opens a region (the accordion trigger). It commits in
+   light when the region opens and when it closes. Its hover and press are the
+   substrate's (components/_shared/disclosure/disclosure.css). */
+@utility engage-disclosed {
+    --rung-class: disclosed;
+}
+
+/* HELD — a control the hand holds (the slider). The engaged rung in place on a fine
+   pointer: the host grows to `--scale-engage` on the `dock` row while the door marks it
+   engaged, and leaves on the row's exit clock. A coarse pointer does not grow in place
+   (Q-3 (c)). It has no commit edge. */
+@utility engage-held {
+    --rung-class: held;
+    scale: calc(1 + (var(--scale-engage) - 1) * var(--rung-grow));
+    transform-origin: center;
+    transition:
+        --rung-grow var(--spring-dock-exit-duration) var(--spring-dock),
+        color var(--duration-fast) var(--ease-standard);
+
+    @media (hover: hover) and (pointer: fine) {
+        &[data-engaged] {
+            --rung-grow: 1;
+            transition-duration: var(--spring-dock-duration), var(--duration-fast);
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+    }
+}
+
+@layer components {
+    /* the seat's geometry: the painted face's light layer */
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed):where(:not(:has([data-engage-face]))),
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) :where([data-engage-face]) {
+        position: relative;
+        isolation: isolate;
+    }
+
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed):not(:has([data-engage-face]))::after,
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+        content: "";
+        position: absolute;
+        inset: 0;
+        z-index: -1;
+        border-radius: inherit;
+        pointer-events: none;
+    }
+
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+        z-index: auto;
+    }
+
+    /* the light is the brighter ground of each scheme */
+    :root {
+        --rung-light: var(--neutral-0);
+    }
+
+    .dark {
+        --rung-light: var(--foreground);
+    }
+
+    /* FL-3: under forced colours the system palette owns every fill, so the seat is
+       removed. Under reduced transparency the light stays: an opaque-ink event. */
+    @media (forced-colors: active) {
+        :where(.engage-chosen, .engage-pressed, .engage-disclosed)::after,
+        :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+            display: none;
+        }
+    }
+}
+
+/* ── THE COMMIT PATH ─────────────────────────────────────────────────────────────── */
+@layer components {
+    /* A REGISTERED PHASE, from transitions alone. The two states swap which leg is
+       fast, so the product rises and falls on EVERY edge:
+         · committed  (state checked or open, or the parity "b"): the gate opens
+           (opacity 0 → 1, attack) over a charge that drains (light → none, release);
+         · released   (state unchecked or closed, or the parity "a"): the charge
+           returns (none → light, attack) under a gate that closes (1 → 0, release).
+       A member that MOUNTS committed shows nothing (an inserted element has no
+       before-change style), and a second commit mid-flight retargets both legs. */
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed):not(:has([data-engage-face]))::after,
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+        background-color: color-mix(
+            in oklab,
+            var(--rung-light) calc(var(--fill-selected) * 100%),
+            transparent
+        );
+        opacity: 0;
+        transition:
+            opacity var(--engage-control-engage-release) var(--ease-standard),
+            background-color var(--engage-control-engage-attack) var(--ease-standard);
+    }
+
+    :where(.engage-chosen, .engage-disclosed):is([data-state="checked"], [data-state="open"]):not(:has([data-engage-face]))::after,
+    :where(.engage-chosen, .engage-disclosed):is([data-state="checked"], [data-state="open"]) [data-engage-light],
+    :where(.engage-pressed)[data-commit="b"]::after {
+        background-color: color-mix(in oklab, var(--rung-light) 0%, transparent);
+        opacity: 1;
+        transition:
+            opacity var(--engage-control-engage-attack) var(--ease-standard),
+            background-color var(--engage-control-engage-release) var(--ease-standard);
+    }
+}
diff --git a/tests/composables/motion/engage-door.test.ts b/tests/composables/motion/engage-door.test.ts
new file mode 100644
index 000000000..fd4f520c7
--- /dev/null
+++ b/tests/composables/motion/engage-door.test.ts
@@ -0,0 +1,151 @@
+// The engage door's floor contract (D5 pass 2, F5): the hand and the keyboard engagement
+// beside it (CK-04), the press's reduce arm (CK-10), the stateless commit edge, and the
+// release rule's window (CK-18). Paint is the D5 battery's; this file holds the door's
+// own state machine, each case with the input that must NOT engage beside the one that
+// must.
+
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, ref } from "vue";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { useEngage } from "@glass/composables/motion/engage/useEngage";
+import { RELEASE_RULE, VelocitySampler } from "@glass/composables/motion/engage/release";
+
+function mountDoor(o: Parameters<typeof useEngage>[1]) {
+    const api: { door?: ReturnType<typeof useEngage> } = {};
+    const C = defineComponent({
+        setup() {
+            const el = ref<HTMLElement | null>(null);
+            api.door = useEngage(() => el.value, o);
+            return () => h("div", { ref: el, tabindex: 0 }, [h("button", { class: "inner" })]);
+        },
+    });
+    const wrapper = mount(C, { attachTo: document.body });
+    return { wrapper, host: wrapper.element as HTMLElement, api };
+}
+
+/** A key the way a hand presses it: down on the page, the default action, then up. */
+async function press(key: string, during?: () => void): Promise<void> {
+    const target = document.activeElement ?? document.body;
+    target.dispatchEvent(new KeyboardEvent("keydown", { key, bubbles: true }));
+    during?.();
+    target.dispatchEvent(new KeyboardEvent("keyup", { key, bubbles: true }));
+    await nextTick();
+}
+
+describe("the keyboard engagement (CK-04): its own state, never the hand's", () => {
+    let w: ReturnType<typeof mountDoor> | null = null;
+    afterEach(() => {
+        w?.wrapper.unmount();
+        w = null;
+    });
+
+    it("a Tab's focus engages; data-held stays absent; Escape and leaving disengage", async () => {
+        w = mountDoor({ hold: {} });
+        await press("Tab", () => w!.host.focus());
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+        expect(w.host.hasAttribute("data-held")).toBe(false);
+        expect(w.api.door!.isHeld.value).toBe(false);
+        await press("Escape");
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+        await press("ArrowRight");
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+        w.host.blur();
+        await nextTick();
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+    });
+
+    it("a script focus() with no key down engages nothing", async () => {
+        w = mountDoor({ hold: {} });
+        w.host.focus();
+        await nextTick();
+        expect(document.activeElement).toBe(w.host);
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+    });
+
+    it("a modifier alone, or a key the control does not act on, engages nothing", async () => {
+        w = mountDoor({ hold: {} });
+        w.host.focus();
+        for (const key of ["Shift", "Meta", "Control", "Alt", "k", ".", "Enter", " "]) {
+            await press(key);
+            expect(w.host.hasAttribute("data-engaged"), key).toBe(false);
+        }
+        await press("End");
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+    });
+
+    it("the hand: data-held while the pointer is down, and a key held through the click is not a keyboard focus", async () => {
+        w = mountDoor({ hold: {} });
+        window.dispatchEvent(new KeyboardEvent("keydown", { key: "Shift" }));
+        w.host.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true }));
+        w.host.focus();
+        await nextTick();
+        expect(w.host.hasAttribute("data-held")).toBe(true);
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+        window.dispatchEvent(new PointerEvent("pointerup"));
+        window.dispatchEvent(new KeyboardEvent("keyup", { key: "Shift" }));
+        await nextTick();
+        expect(w.host.hasAttribute("data-held")).toBe(false);
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+    });
+});
+
+describe("the press (CK-10): one --press-t drive; under reduce the geometry retires", () => {
+    afterEach(() => vi.restoreAllMocks());
+
+    it("writes --press-t and scale while pressed, and only --press-t under reduce", async () => {
+        vi.useFakeTimers();
+        const both: string[][] = [];
+        for (const reduce of [false, true]) {
+            vi.spyOn(window, "matchMedia").mockImplementation(
+                (q: string) =>
+                    ({ matches: reduce && q.includes("reduce"), media: q, addEventListener() {}, removeEventListener() {} }) as unknown as MediaQueryList,
+            );
+            const w = mountDoor({ press: {} });
+            w.host.dispatchEvent(new PointerEvent("pointerdown", { button: 0, bubbles: true }));
+            await vi.advanceTimersByTimeAsync(120);
+            both.push([w.host.style.getPropertyValue("--press-t"), w.host.style.getPropertyValue("scale")]);
+            expect(w.host.hasAttribute("data-press")).toBe(true);
+            expect(w.host.hasAttribute("data-press-armed")).toBe(true);
+            w.wrapper.unmount();
+            vi.restoreAllMocks();
+        }
+        vi.useRealTimers();
+        expect(Number(both[0][0])).toBeGreaterThan(0);
+        expect(both[0][1]).not.toBe("");
+        expect(Number(both[1][0])).toBeGreaterThan(0);
+        expect(both[1][1]).toBe("");
+    });
+});
+
+describe("the stateless commit edge", () => {
+    it("stamps the parity at mount and flips it on every activation", async () => {
+        const w = mountDoor({ commit: "call" });
+        await nextTick();
+        expect(w.host.getAttribute("data-commit")).toBe("a");
+        w.api.door!.commit();
+        expect(w.host.getAttribute("data-commit")).toBe("b");
+        w.api.door!.commit();
+        expect(w.host.getAttribute("data-commit")).toBe("a");
+        w.wrapper.unmount();
+    });
+});
+
+describe("the release rule (CK-18): the window, the lift a sample", () => {
+    const drive = (s: VelocitySampler): void => {
+        s.reset();
+        for (let k = 0; k <= 3; k++) s.push(40 * k, 0, 16 * k);
+    };
+
+    it("a fling released at once carries the drive's velocity", () => {
+        const s = new VelocitySampler();
+        drive(s);
+        expect(s.release(120, 0, 64).x).toBeGreaterThan(1000);
+    });
+
+    it("a finger still for longer than the window releases with nothing", () => {
+        const s = new VelocitySampler();
+        drive(s);
+        expect(s.release(120, 0, 48 + RELEASE_RULE.windowMs + 1).x).toBe(0);
+    });
+});
