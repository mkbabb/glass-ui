@@ -0,0 +1,143 @@
+import { onBeforeUnmount, onMounted, onScopeDispose, ref, type Ref } from "vue";
+
+/**
+ * ══ THE HAND, AND THE ONE KEEP-OPEN TOKEN ══
+ *
+ * Two pieces that every engaged control composes, kept beside the engage door that
+ * owns them (`useEngage.ts`). Neither knows about a dock: the posture a hold takes is
+ * handed in as a `HoldTarget`, so this module imports nothing from `components/`.
+ *
+ * WHAT KIND OF HOLD A TOKEN IS. Two different facts, and only one is a hand:
+ *  - `"morph"` (the default): posture only. "Something is open and the host must not
+ *    idle-collapse under it": an armed search field, an open popover, a focused
+ *    switcher tab. It is NOT a hand and never engages the grasp optic (glass/grasp.css).
+ *  - `"grasp"`: a live pointer hold on a control. A grasp implies a morph hold (a
+ *    finger down must also hold the host open), so a target takes both counts.
+ */
+export type HoldKind = "morph" | "grasp";
+
+/**
+ * THE HAND'S SLOP, in px: the series rung above coarse-tap jitter (5–10 px). Below it a
+ * gesture is a click; past it the hand has taken the control (a sortable row's lift, a
+ * number field's scrub, one step per slop travelled).
+ */
+export const HOLD_SLOP_PX = 8;
+
+/** The ref-counted posture a token holds: the dock's `keepOpen`/`release` pair. */
+export interface HoldTarget {
+    keepOpen: (kind?: HoldKind) => void;
+    release: (kind?: HoldKind) => void;
+}
+
+export interface HoldToken {
+    /** `true` while this token holds its count. */
+    readonly isHeld: Readonly<Ref<boolean>>;
+    /** Idempotent: a second call while held is a no-op, never a second count. */
+    acquire: () => void;
+    /** Idempotent: a release while free is a no-op, never a negative count. */
+    release: () => void;
+}
+
+/**
+ * One holder takes exactly one count and gives it back exactly once, including on
+ * teardown. Four sites used to hand-roll these six lines (a Popover, the dock layer
+ * group, the dock search, the hand); a leaked token is a dock that never idle-collapses
+ * again for the life of the page.
+ *
+ * `target` is a getter so a holder can sit above the thing it holds. A null target is
+ * not an error: the flag still flips, because whether the holder is holding is a fact
+ * about the holder, not about whether a dock happened to be listening.
+ */
+export function useHoldToken(
+    target: () => HoldTarget | null | undefined,
+    kind?: HoldKind,
+): HoldToken {
+    const isHeld = ref(false);
+
+    function acquire(): void {
+        if (isHeld.value) return;
+        isHeld.value = true;
+        target()?.keepOpen(kind);
+    }
+
+    function release(): void {
+        if (!isHeld.value) return;
+        isHeld.value = false;
+        target()?.release(kind);
+    }
+
+    onScopeDispose(release);
+
+    return { isHeld, acquire, release };
+}
+
+export interface UseHoldOptions {
+    /** The posture the hold takes (the enclosing dock's context), or none. */
+    target?: () => HoldTarget | null | undefined;
+    /** Whether the hold is armed. A getter, so a prop can disarm it live. Default armed. */
+    enabled?: () => boolean;
+}
+
+/**
+ * THE HAND: a host's own live pointer or touch hold.
+ *
+ * The only path in the library driven by a pointer actually going down, so it is the
+ * one the grasp register (glass/grasp.css) is sourced from. The returned `isHeld` flips
+ * with the finger whether or not a target is listening: a standalone control engages
+ * on its own drag, and a control inside a dock never co-engages off a sibling's hold.
+ *
+ * Native listeners on the RESOLVED host, for three reasons: `pointerdown` and
+ * `touchstart` fold onto one acquire under one owner; the release is window-scoped and
+ * so survives reka's `setPointerCapture` retarget; and the acquire is capture-
+ * independent, so it is instant-on (the halo lights the instant the pointer goes down;
+ * the spring governs only the settle). reka's `<SliderRoot>` does forward a consumer
+ * `@pointerdown` (`mergeProps` chains it), but last, after its own slide start.
+ *
+ * @param resolveHost a getter for the real host element, called in `onMounted`, so a
+ *   reka forwardRef host (`SliderRoot.$el`) is live by then.
+ */
+export function useHold(
+    resolveHost: () => HTMLElement | null,
+    options: UseHoldOptions = {},
+): { isHeld: Readonly<Ref<boolean>> } {
+    const armed = options.enabled ?? (() => true);
+    const token = useHoldToken(() => options.target?.(), "grasp");
+
+    const off = (): void => {
+        window.removeEventListener("pointerup", onWindowRelease);
+        window.removeEventListener("pointercancel", onWindowRelease);
+        window.removeEventListener("blur", onWindowRelease);
+    };
+
+    function onWindowRelease(): void {
+        token.release();
+        off();
+    }
+
+    function onPress(): void {
+        if (!armed()) return;
+        token.acquire();
+        // remove-then-add: a touch then its synthesized pointer must not install two
+        off();
+        window.addEventListener("pointerup", onWindowRelease);
+        window.addEventListener("pointercancel", onWindowRelease);
+        window.addEventListener("blur", onWindowRelease);
+    }
+
+    let host: HTMLElement | null = null;
+    onMounted(() => {
+        host = resolveHost();
+        host?.addEventListener("pointerdown", onPress);
+        host?.addEventListener("touchstart", onPress, { passive: true });
+    });
+    onBeforeUnmount(() => {
+        // a gesture mid-flight at unmount (a slider unmounted under a held thumb) gives
+        // its count back here, so the target's keep-open count can never leak
+        host?.removeEventListener("pointerdown", onPress);
+        host?.removeEventListener("touchstart", onPress);
+        if (typeof window !== "undefined") off();
+        token.release();
+    });
+
+    return { isHeld: token.isHeld };
+}
diff --git a/src/composables/motion/engage/release.ts b/src/composables/motion/engage/release.ts
new file mode 100644
index 000000000..dedc3891e
--- /dev/null
+++ b/src/composables/motion/engage/release.ts
@@ -0,0 +1,69 @@
+// THE RELEASE RULE: hallmark 6's one measurement.
+//
+// "A release carries its velocity into the settle" has two halves. This file is the
+// first, for every surface: the release velocity is the chord across the pointer
+// samples no older than the rule's window, measured back from the release itself, and
+// the release is a sample. A finger held still for longer than the window before it
+// lifts therefore throws nothing, and one stalled frame cannot fling anything.
+//
+// The second half, the settle, stays with each surface, seeded with this velocity on a
+// named spring row (`springPresets.ts`): the slider's carry and the tabs drag on `dock`
+// through the engage door and the drag morph, the sortable flight on `dock`
+// (`sortable-list/motion.ts`), the Sheet on its own detent legs (`sheet/detents`).
+//
+// Pure data and arithmetic: no Vue, no keyframes.js. `useDragVelocity` ships on the
+// keyframes-free root and `/dom` entries and reads this file.
+
+/** The rule's one table. A surface reads it; none restates a figure from it. */
+export const RELEASE_RULE = {
+    /**
+     * The velocity window, in ms: only samples this young, against the release, count.
+     * It is the drag engine's own default (keyframes.js `Draggable`'s `velocityWindow`,
+     * 100 ms) and the platforms' velocity-tracker horizon (Android `VelocityTracker`,
+     * Flutter `VelocityTracker._horizonMilliseconds`), so a drag measured here and a
+     * drag the engine measures agree. It is not the press-acknowledge budget
+     * (`ACKNOWLEDGE_WINDOW_MS`), which bounds how fast a press is answered, not how far
+     * back a release looks.
+     */
+    windowMs: 100,
+    /** The settle row a release carry rides unless its surface names its own. */
+    row: "dock",
+} as const;
+
+/** A pointer sample: position and the clock it was taken on. */
+interface Sample {
+    x: number;
+    y: number;
+    t: number;
+}
+
+/** The last few pointer samples; the release velocity is the chord across the window. */
+export class VelocitySampler {
+    private readonly ring: Sample[] = [];
+    private readonly size = 8;
+
+    push(x: number, y: number, t: number = performance.now()): void {
+        this.ring.push({ x, y, t });
+        if (this.ring.length > this.size) this.ring.shift();
+    }
+
+    reset(): void {
+        this.ring.length = 0;
+    }
+
+    /** px/s across the samples inside the rule's window; `{x:0,y:0}` when there are fewer than two. */
+    velocity(): { x: number; y: number } {
+        const last = this.ring[this.ring.length - 1];
+        const first = last && this.ring.find((s) => last.t - s.t <= RELEASE_RULE.windowMs);
+        if (!first || !last) return { x: 0, y: 0 };
+        const dt = (last.t - first.t) / 1000;
+        if (dt <= 0) return { x: 0, y: 0 };
+        return { x: (last.x - first.x) / dt, y: (last.y - first.y) / dt };
+    }
+
+    /** The release: the lift is a sample, then the windowed velocity. */
+    release(x: number, y: number, t: number = performance.now()): { x: number; y: number } {
+        this.push(x, y, t);
+        return this.velocity();
+    }
+}
diff --git a/src/composables/motion/engage/settle.ts b/src/composables/motion/engage/settle.ts
new file mode 100644
index 000000000..588a07ede
--- /dev/null
+++ b/src/composables/motion/engage/settle.ts
@@ -0,0 +1,58 @@
+// THE SETTLE: the second half of the release rule (release.ts), and the voice that says
+// when it cannot run.
+//
+// A surface that settles on a spring row reads that row twice: its clock from the CSS
+// token (`--spring-<row>-settle`, so the tempo and a consumer's override reach it) and its
+// shape from the spring table (`springPresets.ts`). Every read of a token or clock the
+// engagement code depends on fails LOUD when it is unreadable (CK-21): one
+// `console.error` per token, never a silent default.
+
+import { SpringProgress } from "@mkbabb/keyframes.js";
+
+import { motionTempo } from "../core/motionTempo";
+import { springPreset, type SpringPresetName } from "../spring/springPresets";
+
+const said = new Set<string>();
+
+/** Say once, loudly, that `token` is unreadable where the engagement reads it. */
+export function loud(token: string, who = "engage"): void {
+    if (said.has(token)) return;
+    said.add(token);
+    console.error(
+        `[glass-ui] ${who}: ${token} is unreadable on the host; the engagement it drives paints nothing. Is the glass-ui stylesheet loaded?`,
+    );
+}
+
+/** A row's settle clock in ms, read from its CSS token on `el` (tempo included); 0, loudly, when unreadable. */
+export function rowClockMs(row: SpringPresetName, el: Element): number {
+    const token = `--spring-${row}-settle`;
+    const s = Number.parseFloat(getComputedStyle(el).getPropertyValue(token));
+    if (Number.isFinite(s) && s > 0) return s * 1000 * motionTempo(el);
+    loud(token);
+    return 0;
+}
+
+/**
+ * A row's settle from displacement `x0` (any unit) with velocity `v0` (units/s) to 0,
+ * sampled over `ms`: an impulse is `x0 = 0`, a landing is `v0 = 0`.
+ */
+export function settleFrames(row: SpringPresetName, x0: number, v0: number, ms: number, n = 24): number[] {
+    const r = springPreset(row);
+    const spring = new SpringProgress({
+        response: r.response * motionTempo(),
+        dampingFraction: r.dampingFraction,
+        initial: x0,
+        initialVelocity: v0,
+        respectReducedMotion: false,
+    });
+    spring.target = 0;
+    const out: number[] = [];
+    for (let k = 0; k <= n; k++) out.push(k === n ? 0 : spring.tickToTime((k / n) * (ms / 1000)));
+    spring.dispose();
+    return out;
+}
+
+export const reducedMotion = (): boolean =>
+    typeof window !== "undefined" &&
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
diff --git a/src/composables/motion/engage/stage.ts b/src/composables/motion/engage/stage.ts
new file mode 100644
index 000000000..4788e64e3
--- /dev/null
+++ b/src/composables/motion/engage/stage.ts
@@ -0,0 +1,304 @@
+// THE ENGAGED STAGE: the ladder's ENGAGED rung (`engageLadder.ts`, "the control promoted
+// out of its own footprint"), built once, for every control of the `held` class whose
+// door asks for it (useEngage's `stage`).
+//
+// PROMOTED WHERE IT STANDS. An engaged control takes `popover="manual"` and enters the top
+// layer without leaving its place in the DOM, so it keeps what a moved node loses
+// (pointer capture, focus, its inherited custom properties) and escapes every ancestor
+// that would trap a fixed box (`backdrop-filter`, `transform`, `filter`,
+// `contain: paint`). A footprint the size of the control stays in flow beneath it and is
+// the anchor the control is pinned to (`anchor()`), so it tracks scroll with no listener.
+// The grow is the held class's own recipe (utilities/engage.css `engage-held`), capped
+// along the inline axis by the reach the stage computes (glass/engage-stage.css).
+//
+// THE WORLD RECEDES behind ONE stage-owned veil (`.glass-focus-veil`), a manual popover
+// shown under the first promoted control and kept open while any control is on the
+// stage. Whether an engagement raises it is the door's to say: the hand always does; a
+// keyboard engagement does when `KEYBOARD_VEIL` (Q-3's keyboard arm, both built in D5
+// pass 2).
+//
+// ONE WRITER of `data-engaged` (on the control and on the veil): this module.
+//
+// HANDED OVER, NEVER HIDDEN (D-1, CK-20). The ladder's rung is a singleton: a second
+// engagement releases the first. The first does not leave in a frame: it springs home on
+// its own exit clock while still promoted, exactly as its own release does, and leaves
+// the top layer when its animations finish. The shared veil is not dropped across a
+// hand-off: its centre glides to the incoming control (`--veil-x`/`--veil-y` are
+// registered) and its level never re-ramps from 0.
+//
+// THE FOOTPRINT HOLDS THE PLACE. A parent re-render during a hold can insert a node
+// between the footprint and the control, or move either. The stage re-seats the
+// footprint against the control, and any change of the footprint's place glides the
+// control from where it was on the `dock` row, during the hold and at the landing.
+//
+// FAILS LOUD (CK-21). The grow figure and the reach are read back on every engagement;
+// an unreadable one says so once (settle.ts `loud`). The registered reach's initial
+// value is 0, a value no valid input computes to, so it can never pass for an answer.
+
+import { onBeforeUnmount, watch, type Ref } from "vue";
+
+import { loud, reducedMotion, rowClockMs, settleFrames } from "./settle";
+
+/** Q-3's keyboard arm: a keyboard engagement promotes AND raises the veil (true), or promotes without it (false). */
+export const KEYBOARD_VEIL = false;
+
+interface Holder {
+    host: HTMLElement;
+    footprint: HTMLElement;
+    /** The footprint's page-frame box at the last read, to tell a re-render's move from a scroll. */
+    at: { x: number; y: number };
+    generation: number;
+    engaged: boolean;
+}
+
+const holders = new Map<HTMLElement, Holder>();
+let current: Holder | null = null;
+let generation = 0;
+let veil: HTMLElement | null = null;
+let observer: MutationObserver | null = null;
+
+function stageVeil(): HTMLElement {
+    if (veil?.isConnected) return veil;
+    veil = document.createElement("span");
+    veil.className = "glass-focus-veil";
+    veil.setAttribute("popover", "manual");
+    veil.setAttribute("aria-hidden", "true");
+    document.body.append(veil);
+    return veil;
+}
+
+const pageBox = (el: Element): { x: number; y: number } => {
+    const r = el.getBoundingClientRect();
+    return { x: r.left + window.scrollX, y: r.top + window.scrollY };
+};
+
+function writeGeometry(h: Holder): void {
+    // One layout read per engagement, scroll or re-render, never per frame.
+    const rect = h.footprint.getBoundingClientRect();
+    const vw = window.innerWidth;
+    h.host.style.setProperty("--stage-room", `${Math.max(0, Math.min(rect.left, vw - rect.right))}px`);
+    h.host.style.setProperty("--stage-w", `${rect.width}px`);
+    h.at = pageBox(h.footprint);
+    if (current !== h) return;
+    const v = stageVeil();
+    v.style.setProperty("--veil-x", `${((rect.left + rect.width / 2) / vw) * 100}%`);
+    v.style.setProperty("--veil-y", `${((rect.top + rect.height / 2) / window.innerHeight) * 100}%`);
+    v.style.setProperty("--glass-focus-veil-core-x", `${rect.width / 2}px`);
+    v.style.setProperty("--glass-focus-veil-core-y", `${rect.height / 2}px`);
+}
+
+/** Carry `host` from an offset of (dx, dy) px home on the `dock` row: a moved place is travelled, never jumped. */
+function glide(host: HTMLElement, dx: number, dy: number): void {
+    if (Math.hypot(dx, dy) < 0.5 || reducedMotion()) return;
+    const ms = rowClockMs("dock", host);
+    if (!ms) return;
+    host.animate(
+        settleFrames("dock", 1, 0, ms).map((k) => ({ transform: `translate(${dx * k}px, ${dy * k}px)` })),
+        { duration: ms, composite: "add" },
+    );
+}
+
+/** A re-render under a hold: re-seat each footprint against its control, and glide any control whose place moved. */
+function onMutation(): void {
+    for (const h of holders.values()) {
+        if (h.host.isConnected && h.host.previousSibling !== h.footprint) h.host.before(h.footprint);
+        // the layout has already moved the pinned control with its footprint: the place it
+        // was is the footprint's last read, in the page frame (a scroll moves neither)
+        const was = h.at;
+        writeGeometry(h);
+        glide(h.host, was.x - h.at.x, was.y - h.at.y);
+    }
+}
+
+function onScroll(): void {
+    for (const h of holders.values()) writeGeometry(h);
+}
+
+function setVeil(on: boolean): void {
+    const v = stageVeil();
+    v.toggleAttribute("data-engaged", on);
+    if (!on) settleVeil();
+}
+
+/** The veil leaves the top layer once nothing is on the stage and its fade has run. */
+function settleVeil(): void {
+    const v = stageVeil();
+    const fades = v.getAnimations().filter((a) => a.effect?.getComputedTiming().endTime !== Infinity);
+    void Promise.all(fades.map((a) => a.finished.catch(() => undefined))).then(() => {
+        if (holders.size || v.hasAttribute("data-engaged")) return;
+        if (v.matches(":popover-open")) v.hidePopover();
+    });
+}
+
+/** Read back what the grow depends on; say so once if it cannot be read (CK-21). */
+function readBack(host: HTMLElement): void {
+    const cs = getComputedStyle(host);
+    if (!(Number.parseFloat(cs.getPropertyValue("--scale-engage")) > 0)) loud("--scale-engage", "engage stage");
+    // `--stage-reach` is registered with initial 0: an invalid `--space-section`,
+    // `--stage-room` or `--stage-w` computes it to that, and no valid input does
+    if (!(Number.parseFloat(cs.getPropertyValue("--stage-reach")) >= 1))
+        loud("--stage-reach (from --space-section, --stage-room, --stage-w)", "engage stage");
+}
+
+function promote(host: HTMLElement): Holder {
+    const rect = host.getBoundingClientRect();
+    const cs = getComputedStyle(host);
+    const footprint = document.createElement("span");
+    footprint.className = "engage-footprint";
+    footprint.setAttribute("aria-hidden", "true");
+    footprint.style.inlineSize = `${rect.width}px`;
+    footprint.style.blockSize = `${rect.height}px`;
+    footprint.style.margin = cs.margin;
+    footprint.style.display = cs.display.startsWith("inline") ? "inline-block" : "block";
+    footprint.style.verticalAlign = cs.verticalAlign;
+    host.before(footprint);
+    const h: Holder = { host, footprint, at: { x: 0, y: 0 }, generation, engaged: false };
+    holders.set(host, h);
+    // Top-layer order is show order: the veil is open beneath every promoted control.
+    const v = stageVeil();
+    if (!v.matches(":popover-open")) {
+        v.showPopover();
+        // resolve its rest style, so its in-clock has a value to transition FROM
+        void getComputedStyle(v).opacity;
+    }
+    host.setAttribute("popover", "manual");
+    host.setAttribute("data-engage-stage", "");
+    host.showPopover();
+    if (!observer) {
+        observer = new MutationObserver(onMutation);
+        observer.observe(document.body, { childList: true, subtree: true });
+        window.addEventListener("scroll", onScroll, { passive: true, capture: true });
+    }
+    return h;
+}
+
+function hide(h: Holder): void {
+    const { host } = h;
+    const before = host.getBoundingClientRect();
+    holders.delete(host);
+    if (holders.size === 0) {
+        observer?.disconnect();
+        observer = null;
+        window.removeEventListener("scroll", onScroll, true);
+    }
+    if (host.matches(":popover-open")) host.hidePopover();
+    host.removeAttribute("popover");
+    host.removeAttribute("data-engage-stage");
+    host.style.removeProperty("--stage-room");
+    host.style.removeProperty("--stage-w");
+    h.footprint.remove();
+    // The landing: if the control's place in flow is not where its footprint held it
+    // (a re-render moved it), it travels there; it never lands in a frame.
+    if (host.isConnected) {
+        const after = host.getBoundingClientRect();
+        glide(host, before.left - after.left, before.top - after.top);
+    }
+    if (holders.size === 0 && veil && !veil.hasAttribute("data-engaged")) settleVeil();
+}
+
+/** Release `h` on its own exit clock; it leaves the top layer when its animations have run. */
+function leave(h: Holder): void {
+    if (!h.engaged) return;
+    h.engaged = false;
+    if (current === h) current = null;
+    h.host.removeAttribute("data-engaged");
+    const mine = h.generation;
+    const running = h.host
+        .getAnimations({ subtree: true })
+        .filter((a) => a.effect?.getComputedTiming().endTime !== Infinity);
+    void Promise.all(running.map((a) => a.finished.catch(() => undefined))).then(() => {
+        // a re-engagement during the exit took a new generation: this release is stale
+        if (holders.get(h.host) === h && !h.engaged && h.generation === mine) hide(h);
+    });
+}
+
+/** Engage `host` on the stage (promoting it if it is not there), with or without the veil. */
+function engageStage(host: HTMLElement, withVeil: boolean): void {
+    generation += 1;
+    if (current && current.host !== host) leave(current);
+    const h = holders.get(host) ?? promote(host);
+    h.generation = generation;
+    h.engaged = true;
+    current = h;
+    writeGeometry(h);
+    setVeil(withVeil);
+    host.setAttribute("data-engaged", "");
+    readBack(host);
+}
+
+/** Release `host`. `immediate` (an unmount) leaves at once. */
+function releaseStage(host: HTMLElement, immediate = false): void {
+    const h = holders.get(host);
+    if (!h) return;
+    const was = current === h;
+    leave(h);
+    if (immediate && holders.get(host) === h) hide(h);
+    // A hand-off releases the outgoing control and engages the incoming one in the same
+    // task (a Tab's focusout, then its focusin): the veil drops only if nothing took
+    // the engagement by the end of that task's microtasks.
+    if (was) queueMicrotask(() => {
+        if (!current) setVeil(false);
+    });
+}
+
+/**
+ * The release fling: `host`, still promoted, leaves the hand at `v` (px/s along `axis`)
+ * and the `dock` row brings it home. The leading edge travels, the trailing edge holds
+ * (a stretch: the value the control shows does not move), soft-limited (tanh) to the
+ * reach the grow is allowed along that axis. Returns false when `host` is not on the stage.
+ */
+export function flingStage(host: HTMLElement, axis: "x" | "y", v: number): boolean {
+    const h = holders.get(host);
+    if (!h) return false;
+    if (!v || reducedMotion()) return true;
+    const ms = rowClockMs("dock", host);
+    const cs = getComputedStyle(host);
+    const reach = Number.parseFloat(cs.getPropertyValue(axis === "x" ? "--stage-reach" : "--scale-engage"));
+    const size = axis === "x" ? h.footprint.offsetWidth : h.footprint.offsetHeight;
+    const cap = (reach - 1) * size;
+    if (!ms || !(cap > 0) || !size) return true;
+    const dir = Math.sign(v);
+    host.animate(
+        settleFrames("dock", 0, v, ms).map((d) => {
+            const t = cap * Math.tanh(d / cap);
+            const s = 1 + (dir * t) / size;
+            return {
+                transform: axis === "x" ? `translateX(${t / 2}px) scaleX(${s})` : `translateY(${t / 2}px) scaleY(${s})`,
+            };
+        }),
+        { duration: ms, composite: "add" },
+    );
+    return true;
+}
+
+/**
+ * Bind a control's engagement to the stage: `engaged` true promotes the host, false
+ * releases it; `veil` says whether this engagement raises the veil. The engagement is
+ * the door's; the stage owns the rung.
+ */
+export function useEngageStage(
+    resolveHost: () => HTMLElement | null,
+    engaged: Readonly<Ref<boolean>>,
+    veilWanted: () => boolean,
+    enabled: () => boolean = () => true,
+): void {
+    let on = false;
+    watch(
+        () => [engaged.value, veilWanted()] as const,
+        ([e, v]) => {
+            const host = resolveHost();
+            if (!host || typeof window === "undefined") return;
+            if (e && enabled()) {
+                engageStage(host, v);
+                on = true;
+            } else if (on) {
+                releaseStage(host);
+                on = false;
+            }
+        },
+    );
+    onBeforeUnmount(() => {
+        const host = resolveHost();
+        if (host) releaseStage(host, true);
+    });
+}
diff --git a/src/composables/motion/engage/useEngage.ts b/src/composables/motion/engage/useEngage.ts
new file mode 100644
index 000000000..f38b4a2cd
--- /dev/null
+++ b/src/composables/motion/engage/useEngage.ts
@@ -0,0 +1,337 @@
+// useEngage: the engage door.
+//
+// Engagement is behaviour, so it has one door. A component hands it its host and names
+// the parts it has; the door owns the state and is the ONLY writer of the engagement
+// attributes:
+//   · data-held      the hand is down on the control (a pointer or touch hold), and only
+//                    that. The grasp register (glass/grasp.css) and a host's own rules
+//                    read it as the hand's
+//   · data-engaged   the control is engaged: the hand is down, or the keyboard is driving
+//                    it. The door owns the STATE; the engaged stage (stage.ts) is the one
+//                    WRITER of the attribute, because the rung it marks is the stage's
+//   · data-press     the press part is down
+//   · data-commit    a stateless control's commit edge, as a parity ("a" ↔ "b") that
+//                    flips on every activation
+//
+// The parts, each the shipped leaf composed rather than copied:
+//   · the hand      `useHold` (hold.ts): pointer and touch acquire, the window-scoped
+//                   release, the target's posture token. Beside it the keyboard
+//                   engagement: a focus that Tab brought (never a script `focus()`, even
+//                   one a printable key's handler makes; never a pointer's), or a key the
+//                   control acts on, engages; Escape and leaving disengage. An Escape that
+//                   disengages is spent there (default prevented), so it does not also
+//                   close the Dialog the control sits in: the next one does. A modifier
+//                   alone, or a key the control does not act on, does nothing
+//   · the stage     `stage`: the engagement promotes the host onto the engaged stage
+//                   (stage.ts) and raises the veil for the hand (and for the keyboard,
+//                   on `KEYBOARD_VEIL`)
+//   · the scrub     `scrub`: a press that travels past the hand's slop takes the control
+//                   (a number field's value scrub): one `step` per slop travelled,
+//                   the hand's own `data-held`, and the stage's release fling
+//   · the press     `useLiquidPress`, on its one `--press-t` drive with its own defaults:
+//                   the door takes no press options beyond `disabled`. It binds the
+//                   handlers natively and writes the press style on the host, so an
+//                   adopter binds nothing in its template. Under reduced motion the
+//                   press keeps its light (`--press-t`) and drops its geometry (`scale`)
+//   · the commit    `commit: "call"`, a stateless control (a command): the adopter calls
+//                   the returned `commit()` on activation and the door flips the parity.
+//                   The door paints nothing for it; a class recipe reads the parity
+//   · the release   `useDragVelocity` measures the release on the release rule
+//                   (release.ts) and the door carries it: a host on the stage stretches
+//                   toward the fling with its trailing edge held (stage.ts
+//                   `flingStage`); a fill in flow stretches from its own transform
+//                   origin. The `dock` row (the engaged rung's spring) brings either
+//                   home. The value the finger chose does not move
+
+import {
+    computed,
+    onBeforeUnmount,
+    onMounted,
+    shallowRef,
+    watch,
+    type Ref,
+} from "vue";
+import { useDragVelocity } from "../../dom/useDragVelocity";
+import { useLiquidPress } from "../spring/useLiquidPress";
+import { HOLD_SLOP_PX, useHold, type HoldTarget } from "./hold";
+import { RELEASE_RULE } from "./release";
+import { reducedMotion as reduced, rowClockMs, settleFrames } from "./settle";
+import { flingStage, KEYBOARD_VEIL, useEngageStage } from "./stage";
+
+/** The keys a range control acts on: the acting-key set a held range engages on. */
+const RANGE_ACTING_KEYS: ReadonlySet<string> = new Set([
+    "ArrowLeft",
+    "ArrowRight",
+    "ArrowUp",
+    "ArrowDown",
+    "PageUp",
+    "PageDown",
+    "Home",
+    "End",
+]);
+
+export interface UseEngageOptions {
+    /** The hand, and the keyboard engagement beside it. */
+    hold?: {
+        /** The posture a hold takes (the enclosing dock's context), or none. */
+        target?: () => HoldTarget | null | undefined;
+        /** The keys the control acts on. Default `RANGE_ACTING_KEYS`. */
+        keys?: ReadonlySet<string>;
+        /** Elements that carry `data-held` with the host (a grasp register's host). */
+        heldOn?: () => (Element | null | undefined)[];
+    };
+    /** The engaged stage: whether an engagement promotes the host (default: always). */
+    stage?: () => boolean;
+    /** A press that travels takes the control: `step(n)` moves the value n steps (±). */
+    scrub?: { step: (n: number) => void; disabled?: () => boolean };
+    /** The press: the interruptible press spring on the host. */
+    press?: { disabled?: () => boolean };
+    /** A stateless control's commit edge: the adopter calls `commit()` on activation. */
+    commit?: "call";
+    /** A drag surface: the axis its velocity is read on and the visible body a release carries. */
+    drag?: {
+        axis: () => "x" | "y";
+        body: () => HTMLElement | null;
+        /** A second element that receives the live drag velocity (a teleported organ). */
+        mirror?: () => HTMLElement | null;
+        enabled?: () => boolean;
+    };
+}
+
+export interface UseEngageReturn {
+    /** The hand is down on the control. */
+    isHeld: Readonly<Ref<boolean>>;
+    /** The hand is down, or the keyboard drives the control. */
+    isEngaged: Readonly<Ref<boolean>>;
+    /** Fire the commit edge now (a stateless control's activation). */
+    commit: () => void;
+}
+
+// ── the keys held down, page-wide ───────────────────────────────────────────────
+// A focus is the keyboard's only while a key is down: Tab moves focus inside its own
+// keydown, before its keyup. A script `focus()` arrives with no key down. One capture
+// listener pair for the page, installed by the first door that needs it.
+const keysDown = new Set<string>();
+let tracking = false;
+function trackKeys(): void {
+    if (tracking || typeof window === "undefined") return;
+    tracking = true;
+    window.addEventListener("keydown", (e) => keysDown.add(e.key), true);
+    window.addEventListener("keyup", (e) => keysDown.delete(e.key), true);
+    window.addEventListener("blur", () => keysDown.clear());
+}
+
+/**
+ * The release carry on the visible body: its edge away from its transform origin (the
+ * leading edge of a fill) travels with the fling and the row brings it home, as a
+ * stretch along the axis composited onto whatever transform the body already plays.
+ */
+function carry(body: HTMLElement, axis: "x" | "y", v: number): void {
+    if (!v) return;
+    const ms = rowClockMs(RELEASE_RULE.row, body);
+    if (!ms) return;
+    const box = body.getBoundingClientRect();
+    const length = axis === "x" ? box.width : box.height;
+    if (length < 1) return;
+    const [ox, oy] = getComputedStyle(body).transformOrigin.split(" ").map(Number.parseFloat);
+    const origin = axis === "x" ? ox : oy;
+    // the edge that moves is the one away from the origin: a fill growing from its start
+    // stretches with a forward fling and shortens with a backward one
+    const dir = (origin ?? 0) <= length / 2 ? 1 : -1;
+    const s = (d: number): number => Math.max(0, 1 + (dir * d) / length);
+    body.animate(
+        settleFrames(RELEASE_RULE.row, 0, v, ms).map((d) => ({
+            transform: axis === "x" ? `scaleX(${s(d)})` : `scaleY(${s(d)})`,
+        })),
+        { duration: ms, composite: "add" },
+    );
+}
+
+/** Native listeners on the host, bound at mount and dropped at unmount. */
+function listen(host: () => HTMLElement | null, on: [string, (e: Event) => void][]): void {
+    let el: HTMLElement | null = null;
+    onMounted(() => {
+        el = host();
+        for (const [n, f] of on) el?.addEventListener(n, f);
+    });
+    onBeforeUnmount(() => {
+        for (const [n, f] of on) el?.removeEventListener(n, f);
+    });
+}
+
+export function useEngage(
+    host: () => HTMLElement | null,
+    o: UseEngageOptions,
+): UseEngageReturn {
+    // ── the hand, and the keyboard that engages like it ─────────────────────────
+    const hand: Readonly<Ref<boolean>> = o.hold
+        ? useHold(host, { target: o.hold.target }).isHeld
+        : shallowRef(false);
+    const scrubbing = shallowRef(false);
+    const isHeld = computed(() => hand.value || scrubbing.value);
+    const keyed = shallowRef(false);
+    const isEngaged = computed(() => isHeld.value || keyed.value);
+    if (o.hold) {
+        const h = o.hold;
+        const keys = h.keys ?? RANGE_ACTING_KEYS;
+        trackKeys();
+        // A pointer's focus (reka focuses the thumb by script on a slide) is not the
+        // keyboard's, though `:focus-visible` may match it, and a key held through a
+        // click (Shift-click) must not make it one. The mark lives as long as the hand.
+        let pointed = false;
+        watch(isHeld, (held) => {
+            if (!held) pointed = false;
+        });
+        listen(host, [
+            ["pointerdown", () => { pointed = true; keyed.value = false; }],
+            // Only Tab moves focus as the keyboard's own act. A focus that arrives while
+            // some other key is down is a script's (an app shortcut's handler), and a
+            // focus with no key down is a script's or a pointer's
+            ["focusin", () => { keyed.value = !pointed && keysDown.has("Tab"); }],
+            ["keydown", (e) => {
+                const k = (e as KeyboardEvent).key;
+                if (k === "Escape") {
+                    // spent here when it disengages: the enclosing layer's dismiss reads
+                    // `defaultPrevented` (reka's DismissableLayer), so one Escape is one act
+                    if (keyed.value) e.preventDefault();
+                    keyed.value = false;
+                } else if (keys.has(k)) keyed.value = true;
+            }],
+            ["focusout", (e) => {
+                const to = (e as FocusEvent).relatedTarget as Node | null;
+                if (to && host()?.contains(to)) return;
+                keyed.value = false;
+            }],
+        ]);
+    }
+    if (o.hold || o.scrub) {
+        const heldOn = o.hold?.heldOn;
+        watch(
+            () => [isHeld.value, heldOn?.()] as const,
+            ([held, on]) => {
+                for (const x of [host(), ...(on ?? [])]) x?.toggleAttribute("data-held", held);
+            },
+            { flush: "post" },
+        );
+        useEngageStage(
+            host,
+            isEngaged,
+            () => isHeld.value || (KEYBOARD_VEIL && keyed.value),
+            () => o.stage?.() !== false,
+        );
+    }
+
+    // ── the scrub: a press that travels takes the control ───────────────────────
+    if (o.scrub) {
+        const sc = o.scrub;
+        let x0 = 0;
+        let applied = 0;
+        let armed = false;
+        const move = (e: PointerEvent): void => {
+            if (!armed) return;
+            const dx = e.clientX - x0;
+            if (!scrubbing.value) {
+                if (Math.abs(dx) < HOLD_SLOP_PX) return;
+                scrubbing.value = true;
+                window.getSelection()?.removeAllRanges();
+            }
+            e.preventDefault();
+            const n = Math.trunc(dx / HOLD_SLOP_PX);
+            if (n !== applied) {
+                sc.step(n - applied);
+                applied = n;
+            }
+        };
+        const up = (): void => {
+            armed = false;
+            scrubbing.value = false;
+            window.removeEventListener("pointermove", move);
+            window.removeEventListener("pointerup", up);
+            window.removeEventListener("pointercancel", up);
+        };
+        listen(host, [
+            ["pointerdown", (e) => {
+                const p = e as PointerEvent;
+                if (p.button !== 0 || sc.disabled?.()) return;
+                armed = true;
+                x0 = p.clientX;
+                applied = 0;
+                window.addEventListener("pointermove", move, { passive: false });
+                window.addEventListener("pointerup", up);
+                window.addEventListener("pointercancel", up);
+            }],
+        ]);
+        onBeforeUnmount(up);
+    }
+
+    // ── the press ──────────────────────────────────────────────────────────────
+    if (o.press) {
+        const disabled = o.press.disabled;
+        const el = shallowRef<HTMLElement | null>(null);
+        const p = useLiquidPress({ el, disabled });
+        let written: string[] = [];
+        watch(
+            () => p.pressStyle.value,
+            (style) => {
+                const h = el.value;
+                if (!h) return;
+                const rec = style as Record<string, string>;
+                for (const k of written) if (!(k in rec)) h.style.removeProperty(k);
+                // under reduce the press keeps its light and drops its geometry
+                written = Object.keys(rec).filter((k) => k !== "scale" || !reduced());
+                for (const k of written) h.style.setProperty(k, rec[k]!);
+            },
+            { flush: "sync" },
+        );
+        const isKey = (e: Event): boolean => ["Enter", " "].includes((e as KeyboardEvent).key);
+        const down = (on: boolean): void => {
+            if (on && disabled?.()) return;
+            el.value?.toggleAttribute("data-press", on);
+        };
+        listen(host, [
+            ["pointerdown", (e) => { p.handlers.onPointerdown(e as PointerEvent); down((e as PointerEvent).button === 0); }],
+            ["pointerenter", (e) => { p.handlers.onPointerenter(e as PointerEvent); if ((e as PointerEvent).buttons & 1) down(true); }],
+            ["pointerup", () => { p.handlers.onPointerup(); down(false); }],
+            ["pointercancel", () => { p.handlers.onPointercancel(); down(false); }],
+            ["pointerleave", () => { p.handlers.onPointerleave(); down(false); }],
+            ["keydown", (e) => { p.handlers.onKeydown(e as KeyboardEvent); if (isKey(e) && !(e as KeyboardEvent).repeat) down(true); }],
+            ["keyup", (e) => { p.handlers.onKeyup(e as KeyboardEvent); if (isKey(e)) down(false); }],
+            ["blur", () => { p.handlers.onBlur(); down(false); }],
+        ]);
+        onMounted(() => {
+            el.value = host();
+            // the press is JS-owned from here: the `:active` CSS floors stand down
+            el.value?.setAttribute("data-press-armed", "");
+        });
+    }
+
+    // ── the release, carried on the visible body ────────────────────────────────
+    if (o.drag) {
+        const d = o.drag;
+        useDragVelocity({
+            host: () => (d.enabled?.() === false ? null : host()),
+            mirror: d.mirror,
+            axis: d.axis,
+            onRelease: (v) => {
+                const h = host();
+                if (h && flingStage(h, d.axis(), v)) return;
+                const body = d.body();
+                if (body && !reduced()) carry(body, d.axis(), v);
+            },
+        });
+    }
+
+    // ── the stateless commit edge ──────────────────────────────────────────────
+    // The parity is stamped at mount (no before-change style, so nothing reads it as a
+    // commit) and flips on every activation, so a recipe keyed on it answers each one.
+    if (o.commit === "call") {
+        onMounted(() => host()?.setAttribute("data-commit", "a"));
+    }
+    const commit = (): void => {
+        const h = host();
+        if (o.commit !== "call" || !h) return;
+        h.setAttribute("data-commit", h.getAttribute("data-commit") === "a" ? "b" : "a");
+    };
+
+    return { isHeld, isEngaged, commit };
+}
