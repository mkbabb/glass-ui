+/* utilities/engage.css — ONE RECIPE PER ENGAGEMENT CLASS.
+ *
+ * `ENGAGE_DECLARATION` (composables/motion/engage/engageClasses.ts) says what each
+ * component directory is; this file says what each class does. A member composes its
+ * class's utility on the element it paints, and every utility stamps its class as the
+ * registered `--rung-class` (tokens/property-regs.css), which the runtime census reads
+ * to prove the member composes the recipe its row declares. Where a class's answer
+ * belongs to a substrate that already paints the member (the field's focus paint, the
+ * sortable row's fill, the modal veil), the substrate keeps it and the utility stamps.
+ *
+ * THE PRESS IS NEVER A CLASS'S GEOMETRY. A member presses in LIGHT on its own paint,
+ * or by script where the engage door owns the press (`useEngage`: the Button's squish
+ * on the one `--press-t` drive). No recipe here writes `scale` for a press, and none
+ * sets `scale: none` to silence another class: the press-snap and hover lift that used
+ * to ride `.tap-squish`, `.interactive-item` and `.glass-capsule-hover` are retired at
+ * their source, not overridden here.
+ *
+ * THE COMMIT IS LIGHT (CK-02 arm iii, Q-5's default). On the commit edge the painted
+ * face brightens and the light drains back to the committed rest, on the
+ * `control-engage` envelope ("the engagement wash and bloom on a control surface"):
+ * a GATE opens on the row's attack while a CHARGE drains on its release, and the light
+ * is their product. The two states swap which leg is fast, so the product rises and
+ * falls on EVERY edge, in either direction, from transitions alone:
+ *   · committed  (state on, open, or the parity "b"): the gate opens (opacity 0 → 1,
+ *     attack) over a charge that drains (light → none, release);
+ *   · released   (state off, closed, or the parity "a"): the charge returns (none →
+ *     light, attack) under a gate that closes (opacity 1 → 0, release).
+ * At rest in either state the product is zero, so a member that MOUNTS committed shows
+ * nothing (a transition needs a before-change style, and an inserted element has none),
+ * a commit from the model and one from a gesture take one path, and a second commit
+ * mid-flight retargets both legs. It is light, so it stays under reduced motion. Its
+ * seat is the member's PAINTED FACE: the element's own `::after`, under its content
+ * (`z-index: -1` in its own stacking context, so a label never washes out), or, on a
+ * face that carries a mark (the control bit's thumb, tick or dot), the face's last
+ * layer `[data-engage-light]`, over the mark, so the whole 20 px face brightens and
+ * not only the rim the mark leaves showing.
+ *
+ * Clocks: geometry on the spring table's generated tokens, light on the envelope
+ * table's (`--engage-*`). The commit's amplitude is the fill ladder's state rung
+ * (`--fill-selected`); its light is the page's own ground (`--neutral-0` in light,
+ * the ink in dark: the brighter of the two in each scheme). */
+
+@property --rung-grow {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+/* PRESSED — an action with no state (button, action chip). The press is the member's
+   light or the door's script press; the commit edge is the door's parity
+   (`data-commit` "a" ↔ "b", `useEngage` `commit: "call"`). */
+@utility engage-pressed {
+    --rung-class: pressed;
+}
+
+/* CHOSEN — a control with a committed state (switch, checkbox, radio, selectable chip,
+   toggle item, segmented tabs). The press is LIGHT on the member's own paint; the
+   commit is the light below, or, where the member has a travelling body (the tabs'
+   indicator), that body's travel on its own row. */
+@utility engage-chosen {
+    --rung-class: chosen;
+}
+
+/* DISCLOSED — a trigger that opens a region (accordion, collapsible, popover, select,
+   menu). A row-width target answers a press in LIGHT only (a full-width squish reads
+   as the row collapsing), on the press envelope's attack; it commits in light when the
+   region opens and when it closes. Its hover is the substrate's
+   (components/_shared/disclosure/disclosure.css), under `(hover: hover)`. */
+@utility engage-disclosed {
+    --rung-class: disclosed;
+    transition:
+        background-color var(--engage-press-drain-release) var(--ease-standard),
+        color var(--duration-control) var(--ease-standard),
+        box-shadow var(--duration-control) var(--ease-standard);
+
+    &:active:not(:disabled, [data-disabled]) {
+        background-color: color-mix(
+            in oklab,
+            var(--foreground) calc(var(--fill-selected) * 100%),
+            transparent
+        );
+        transition-duration:
+            var(--engage-press-drain-attack), var(--duration-control),
+            var(--duration-control);
+    }
+}
+
+/* HELD — a control the hand holds (slider, number-field scrub, timeline, the dock's
+   controls). The ENGAGED rung is the stage's (composables/motion/engage/stage.ts): the
+   door's engagement (the hand down, or a key that brought the focus or acts on it)
+   promotes the host in place into the top layer, and this recipe is its grow: to
+   `--scale-engage` (the ladder's engaged row) on the block axis, and inline to the reach
+   the stage computes from the page gutter (`--stage-reach`, glass/engage-stage.css), on
+   the `dock` row, leaving on the row's exit clock. A host off the stage reads reach 0 and
+   rests at ×1, because `--rung-grow` is 0 there. Every pointer: the gutter cap is what
+   keeps a phone's full-width control inside the page. */
+@utility engage-held {
+    --rung-class: held;
+    scale: calc(1 + (var(--stage-reach) - 1) * var(--rung-grow))
+        calc(1 + (var(--scale-engage) - 1) * var(--rung-grow));
+    transform-origin: center;
+    /* the host's ink leg rides with the grow: the slider lane (unlayered) declares no
+       transition of its own, so this list is the host's one */
+    transition:
+        --rung-grow var(--spring-dock-exit-duration) var(--spring-dock),
+        color var(--duration-fast) var(--ease-standard);
+
+    &[data-engaged] {
+        --rung-grow: 1;
+        transition-duration: var(--spring-dock-duration), var(--duration-fast);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+    }
+}
+
+/* DRAGGED — a surface the hand moves, whose job is momentum (the door's release rule).
+   Its press is the substrate's light rule; the utility stamps the class. */
+@utility engage-dragged {
+    --rung-class: dragged;
+}
+
+/* PRESENTED — a surface raised over the page (dialog, sheet, toast, tooltip). Its rung
+   is the modal one, and its paint is the veil's: the scrim keys on its overlay's open
+   state (glass/focus-veil.css), never on `data-engaged`. The utility stamps the class
+   on the presented plate. */
+@utility engage-presented {
+    --rung-class: presented;
+}
+
+/* FIELD — text entry. Its engagement is focus, painted by the field substrate
+   (components/_shared/field/control.css); the utility stamps the class. */
+@utility engage-field {
+    --rung-class: field;
+}
+
+/* AMBIENT — a field that answers the pointer's presence (aurora, blob, constellation,
+   the fourier field, the staff). Its rung is REST: the member's own field moves with
+   the pointer, and the utility stamps the class on the field's root. */
+@utility engage-ambient {
+    --rung-class: ambient;
+}
+
+/* STATIC — no input of its own. The class carries no rung; composing it is the
+   member's declaration that it was classified, read at runtime like any other. */
+@utility engage-static {
+    --rung-class: static;
+}
+
+@layer components {
+    /* THE COMMIT'S SEAT: the painted face's light layer. `:where()` keeps it at zero
+       specificity, so a member's own `position` (a dock control, an absolute chip
+       remove) wins. */
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed):where(:not(:has([data-engage-face]))),
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) :where([data-engage-face]) {
+        position: relative;
+        isolation: isolate;
+    }
+
+    /* released: the charge returns on the attack under a gate closing on the release */
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed):not(:has([data-engage-face]))::after,
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+        content: "";
+        position: absolute;
+        inset: 0;
+        z-index: -1;
+        border-radius: inherit;
+        pointer-events: none;
+        background-color: color-mix(
+            in oklab,
+            var(--rung-light) calc(var(--fill-selected) * 100%),
+            transparent
+        );
+        opacity: 0;
+        transition:
+            opacity var(--engage-control-engage-release) var(--ease-standard),
+            background-color var(--engage-control-engage-attack) var(--ease-standard);
+    }
+
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+        z-index: auto;
+    }
+
+    /* committed: the gate opens on the attack over a charge draining on the release */
+    :where(.engage-chosen, .engage-disclosed):is([data-state="checked"], [data-state="on"], [data-state="open"]):not(:has([data-engage-face]))::after,
+    :where(.engage-chosen, .engage-disclosed):is([data-state="checked"], [data-state="on"], [data-state="open"]) [data-engage-light],
+    :where(.engage-pressed)[data-commit="b"]::after {
+        background-color: color-mix(in oklab, var(--rung-light) 0%, transparent);
+        opacity: 1;
+        transition:
+            opacity var(--engage-control-engage-attack) var(--ease-standard),
+            background-color var(--engage-control-engage-release) var(--ease-standard);
+    }
+
+    /* the light is the brighter ground of each scheme */
+    :root {
+        --rung-light: var(--neutral-0);
+    }
+
+    .dark {
+        --rung-light: var(--foreground);
+    }
+
+    /* FL-3: under forced colours the system palette owns every fill, and a transient
+       wash would paint over it, so the seat is removed. Under reduced transparency the
+       light stays: it is an opaque-ink event on the face, not a translucent material. */
+    @media (forced-colors: active) {
+        :where(.engage-chosen, .engage-pressed, .engage-disclosed)::after,
+        :where(.engage-chosen, .engage-pressed, .engage-disclosed) [data-engage-light] {
+            display: none;
+        }
+    }
+}
diff --git a/tests/composables/motion/engage-door.test.ts b/tests/composables/motion/engage-door.test.ts
new file mode 100644
index 000000000..fd4f520c7
--- /dev/null
+++ b/tests/composables/motion/engage-door.test.ts
@@ -0,0 +1,151 @@
+// The engage door's floor contract (D5 pass 2, F5): the hand and the keyboard engagement
+// beside it (CK-04), the press's reduce arm (CK-10), the stateless commit edge, and the
+// release rule's window (CK-18). Paint is the D5 battery's; this file holds the door's
+// own state machine, each case with the input that must NOT engage beside the one that
+// must.
+
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, ref } from "vue";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { useEngage } from "@glass/composables/motion/engage/useEngage";
+import { RELEASE_RULE, VelocitySampler } from "@glass/composables/motion/engage/release";
+
+function mountDoor(o: Parameters<typeof useEngage>[1]) {
+    const api: { door?: ReturnType<typeof useEngage> } = {};
+    const C = defineComponent({
+        setup() {
+            const el = ref<HTMLElement | null>(null);
+            api.door = useEngage(() => el.value, o);
+            return () => h("div", { ref: el, tabindex: 0 }, [h("button", { class: "inner" })]);
+        },
+    });
+    const wrapper = mount(C, { attachTo: document.body });
+    return { wrapper, host: wrapper.element as HTMLElement, api };
+}
+
+/** A key the way a hand presses it: down on the page, the default action, then up. */
+async function press(key: string, during?: () => void): Promise<void> {
+    const target = document.activeElement ?? document.body;
+    target.dispatchEvent(new KeyboardEvent("keydown", { key, bubbles: true }));
+    during?.();
+    target.dispatchEvent(new KeyboardEvent("keyup", { key, bubbles: true }));
+    await nextTick();
+}
+
+describe("the keyboard engagement (CK-04): its own state, never the hand's", () => {
+    let w: ReturnType<typeof mountDoor> | null = null;
+    afterEach(() => {
+        w?.wrapper.unmount();
+        w = null;
+    });
+
+    it("a Tab's focus engages; data-held stays absent; Escape and leaving disengage", async () => {
+        w = mountDoor({ hold: {} });
+        await press("Tab", () => w!.host.focus());
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+        expect(w.host.hasAttribute("data-held")).toBe(false);
+        expect(w.api.door!.isHeld.value).toBe(false);
+        await press("Escape");
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+        await press("ArrowRight");
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+        w.host.blur();
+        await nextTick();
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+    });
+
+    it("a script focus() with no key down engages nothing", async () => {
+        w = mountDoor({ hold: {} });
+        w.host.focus();
+        await nextTick();
+        expect(document.activeElement).toBe(w.host);
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+    });
+
+    it("a modifier alone, or a key the control does not act on, engages nothing", async () => {
+        w = mountDoor({ hold: {} });
+        w.host.focus();
+        for (const key of ["Shift", "Meta", "Control", "Alt", "k", ".", "Enter", " "]) {
+            await press(key);
+            expect(w.host.hasAttribute("data-engaged"), key).toBe(false);
+        }
+        await press("End");
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+    });
+
+    it("the hand: data-held while the pointer is down, and a key held through the click is not a keyboard focus", async () => {
+        w = mountDoor({ hold: {} });
+        window.dispatchEvent(new KeyboardEvent("keydown", { key: "Shift" }));
+        w.host.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true }));
+        w.host.focus();
+        await nextTick();
+        expect(w.host.hasAttribute("data-held")).toBe(true);
+        expect(w.host.hasAttribute("data-engaged")).toBe(true);
+        window.dispatchEvent(new PointerEvent("pointerup"));
+        window.dispatchEvent(new KeyboardEvent("keyup", { key: "Shift" }));
+        await nextTick();
+        expect(w.host.hasAttribute("data-held")).toBe(false);
+        expect(w.host.hasAttribute("data-engaged")).toBe(false);
+    });
+});
+
+describe("the press (CK-10): one --press-t drive; under reduce the geometry retires", () => {
+    afterEach(() => vi.restoreAllMocks());
+
+    it("writes --press-t and scale while pressed, and only --press-t under reduce", async () => {
+        vi.useFakeTimers();
+        const both: string[][] = [];
+        for (const reduce of [false, true]) {
+            vi.spyOn(window, "matchMedia").mockImplementation(
+                (q: string) =>
+                    ({ matches: reduce && q.includes("reduce"), media: q, addEventListener() {}, removeEventListener() {} }) as unknown as MediaQueryList,
+            );
+            const w = mountDoor({ press: {} });
+            w.host.dispatchEvent(new PointerEvent("pointerdown", { button: 0, bubbles: true }));
+            await vi.advanceTimersByTimeAsync(120);
+            both.push([w.host.style.getPropertyValue("--press-t"), w.host.style.getPropertyValue("scale")]);
+            expect(w.host.hasAttribute("data-press")).toBe(true);
+            expect(w.host.hasAttribute("data-press-armed")).toBe(true);
+            w.wrapper.unmount();
+            vi.restoreAllMocks();
+        }
+        vi.useRealTimers();
+        expect(Number(both[0][0])).toBeGreaterThan(0);
+        expect(both[0][1]).not.toBe("");
+        expect(Number(both[1][0])).toBeGreaterThan(0);
+        expect(both[1][1]).toBe("");
+    });
+});
+
+describe("the stateless commit edge", () => {
+    it("stamps the parity at mount and flips it on every activation", async () => {
+        const w = mountDoor({ commit: "call" });
+        await nextTick();
+        expect(w.host.getAttribute("data-commit")).toBe("a");
+        w.api.door!.commit();
+        expect(w.host.getAttribute("data-commit")).toBe("b");
+        w.api.door!.commit();
+        expect(w.host.getAttribute("data-commit")).toBe("a");
+        w.wrapper.unmount();
+    });
+});
+
+describe("the release rule (CK-18): the window, the lift a sample", () => {
+    const drive = (s: VelocitySampler): void => {
+        s.reset();
+        for (let k = 0; k <= 3; k++) s.push(40 * k, 0, 16 * k);
+    };
+
+    it("a fling released at once carries the drive's velocity", () => {
+        const s = new VelocitySampler();
+        drive(s);
+        expect(s.release(120, 0, 64).x).toBeGreaterThan(1000);
+    });
+
+    it("a finger still for longer than the window releases with nothing", () => {
+        const s = new VelocitySampler();
+        drive(s);
+        expect(s.release(120, 0, 48 + RELEASE_RULE.windowMs + 1).x).toBe(0);
+    });
+});
diff --git a/tests/composables/motion/engage-stage.test.ts b/tests/composables/motion/engage-stage.test.ts
new file mode 100644
index 000000000..45c580b77
--- /dev/null
+++ b/tests/composables/motion/engage-stage.test.ts
@@ -0,0 +1,248 @@
+// The engaged stage's contract (D5 pass 2, P-E2): the hand-off that hands over instead
+// of hiding (CK-20), the keys that may engage and the Escape that is spent once (CK-04,
+// CK-22), the footprint re-seated under a re-render (CK-20), the loud read-back (CK-21),
+// the grow figure on the ladder's row (CK-12), and the stage's second client, the
+// NumberField scrub (CK-27). Paint is the D5 battery's; each case here has the input that
+// must NOT do the thing beside the one that must.
+
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, ref } from "vue";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { useEngage } from "@glass/composables/motion/engage/useEngage";
+import { engageRung } from "@glass/composables/motion/engage/engageLadder";
+import { KEYBOARD_VEIL } from "@glass/composables/motion/engage/stage";
+import { NumberField, NumberFieldInput } from "@glass/components/number-field";
+
+function mountPair() {
+    const C = defineComponent({
+        setup() {
+            const a = ref<HTMLElement | null>(null);
+            const b = ref<HTMLElement | null>(null);
+            useEngage(() => a.value, { hold: {} });
+            useEngage(() => b.value, { hold: {} });
+            return () =>
+                h("div", [
+                    h("div", { ref: a, tabindex: 0, "data-t": "a" }),
+                    h("div", { ref: b, tabindex: 0, "data-t": "b" }),
+                ]);
+        },
+    });
+    const w = mount(C, { attachTo: document.body });
+    const el = w.element as HTMLElement;
+    const [a, b] = ["a", "b"].map((t) => el.querySelector(`[data-t="${t}"]`) as HTMLElement);
+    return { w, a: a!, b: b! };
+}
+
+/** A key the way a hand presses it: down on the page, the default action, then up. */
+async function press(key: string, during?: () => void): Promise<KeyboardEvent> {
+    const target = document.activeElement ?? document.body;
+    const down = new KeyboardEvent("keydown", { key, bubbles: true, cancelable: true });
+    target.dispatchEvent(down);
+    during?.();
+    target.dispatchEvent(new KeyboardEvent("keyup", { key, bubbles: true }));
+    await nextTick();
+    return down;
+}
+
+const veil = (): HTMLElement | null => document.querySelector(".glass-focus-veil");
+
+describe("the hand-off (CK-20): handed over, never hidden", () => {
+    let w: ReturnType<typeof mountPair> | null = null;
+    afterEach(() => {
+        w?.w.unmount();
+        w = null;
+    });
+
+    it("Tab A → B: A leaves on its own exit still promoted, B engages, the veil never drops", async () => {
+        w = mountPair();
+        await press("Tab", () => w!.a.focus());
+        expect(w.a.hasAttribute("data-engaged")).toBe(true);
+        // any write of the veil's attribute across the hand-off is a drop and a re-raise
+        const log: (string | null)[] = [];
+        const mo = new MutationObserver((rs) => rs.forEach((r) => log.push(r.oldValue)));
+        mo.observe(veil()!, { attributes: true, attributeOldValue: true, attributeFilter: ["data-engaged"] });
+        // A's exit: one finite animation the stage must wait for (happy-dom runs none)
+        let exitDone: () => void = () => {};
+        const exit = { effect: { getComputedTiming: () => ({ endTime: 300 }) }, finished: new Promise<void>((r) => (exitDone = r)) };
+        w.a.getAnimations = (() => [exit]) as unknown as HTMLElement["getAnimations"];
+        await press("Tab", () => w!.b.focus());
+        await Promise.resolve();
+        mo.disconnect();
+        expect(w.b.hasAttribute("data-engaged")).toBe(true);
+        expect(w.a.hasAttribute("data-engaged")).toBe(false);
+        // A is still on the stage: it leaves when its exit has run, not in this frame
+        expect(w.a.hasAttribute("data-engage-stage")).toBe(true);
+        expect(w.a.matches(":popover-open")).toBe(true);
+        expect(log, "the veil dropped across the hand-off").toHaveLength(0);
+        // Q-3's keyboard arm: the keyboard raises the veil only on KEYBOARD_VEIL
+        expect(veil()!.hasAttribute("data-engaged")).toBe(KEYBOARD_VEIL);
+        exitDone();
+        await new Promise((r) => setTimeout(r, 0));
+        expect(w.a.hasAttribute("data-engage-stage")).toBe(false);
+        expect(w.b.hasAttribute("data-engage-stage")).toBe(true);
+    });
+
+    it("plant: a release with nothing taking over drops the veil (the case above is not vacuous)", async () => {
+        w = mountPair();
+        await press("Tab", () => w!.a.focus());
+        await press("Escape");
+        await Promise.resolve();
+        expect(veil()!.hasAttribute("data-engaged")).toBe(false);
+    });
+});
+
+describe("the keys (CK-04, CK-22)", () => {
+    let w: ReturnType<typeof mountPair> | null = null;
+    afterEach(() => {
+        w?.w.unmount();
+        w = null;
+    });
+
+    it("a printable key whose handler focuses the control by script engages nothing", async () => {
+        w = mountPair();
+        await press("k", () => w!.a.focus());
+        expect(document.activeElement).toBe(w.a);
+        expect(w.a.hasAttribute("data-engaged")).toBe(false);
+        // the same focus brought by Tab engages
+        w.a.blur();
+        await press("Tab", () => w!.a.focus());
+        expect(w.a.hasAttribute("data-engaged")).toBe(true);
+    });
+
+    it("an Escape that disengages is spent (default prevented); the next one is not", async () => {
+        w = mountPair();
+        await press("Tab", () => w!.a.focus());
+        const first = await press("Escape");
+        expect(first.defaultPrevented).toBe(true);
+        expect(w.a.hasAttribute("data-engaged")).toBe(false);
+        const second = await press("Escape");
+        expect(second.defaultPrevented).toBe(false);
+    });
+});
+
+describe("the footprint under a re-render (CK-20)", () => {
+    it("a node inserted between the footprint and the control: the footprint is re-seated", async () => {
+        const w = mountPair();
+        await press("Tab", () => w.a.focus());
+        const fp = w.a.previousElementSibling!;
+        expect(fp.classList.contains("engage-footprint")).toBe(true);
+        const intruder = document.createElement("div");
+        w.a.before(intruder);
+        await Promise.resolve();
+        await Promise.resolve();
+        expect(w.a.previousElementSibling).toBe(fp);
+        expect(fp.previousElementSibling).toBe(intruder);
+        w.w.unmount();
+    });
+});
+
+describe("fail loud (CK-21)", () => {
+    // `loud` speaks once per token per page, so each case loads a fresh module graph
+    async function engageWith(values: Record<string, string>): Promise<string[]> {
+        vi.resetModules();
+        const { useEngage: fresh } = await import("@glass/composables/motion/engage/useEngage");
+        const native = window.getComputedStyle;
+        const gcs = vi.spyOn(window, "getComputedStyle").mockImplementation((el, p) => {
+            const cs = native(el, p);
+            return new Proxy(cs, {
+                get(t, k) {
+                    if (k === "getPropertyValue") return (n: string) => (n in values ? values[n] : t.getPropertyValue(n));
+                    const v = Reflect.get(t, k);
+                    return typeof v === "function" ? v.bind(t) : v;
+                },
+            });
+        });
+        const err = vi.spyOn(console, "error").mockImplementation(() => {});
+        const C = defineComponent({
+            setup() {
+                const el = ref<HTMLElement | null>(null);
+                fresh(() => el.value, { hold: {} });
+                return () => h("div", { ref: el, tabindex: 0 });
+            },
+        });
+        const w = mount(C, { attachTo: document.body });
+        await press("Tab", () => (w.element as HTMLElement).focus());
+        const said = err.mock.calls.map((c) => String(c[0]));
+        w.unmount();
+        err.mockRestore();
+        gcs.mockRestore();
+        return said;
+    }
+
+    it("readable figures: silent", async () => {
+        const said = await engageWith({ "--scale-engage": "1.06", "--stage-reach": "1.04" });
+        expect(said.filter((m) => m.includes("engage stage"))).toEqual([]);
+    });
+
+    it("plant: the reach at its registered initial (an invalid --space-section) is loud, not the answer", async () => {
+        const said = await engageWith({ "--scale-engage": "1.06", "--stage-reach": "0" });
+        expect(said.some((m) => m.includes("--stage-reach") && m.includes("--space-section"))).toBe(true);
+    });
+
+    it("plant: an unreadable --scale-engage is loud", async () => {
+        const said = await engageWith({ "--scale-engage": "", "--stage-reach": "1.04" });
+        expect(said.some((m) => m.includes("--scale-engage"))).toBe(true);
+    });
+});
+
+describe("the grow figure (CK-12): one source, the ladder's engaged row", () => {
+    it("--scale-engage mirrors engageRung('engaged').scale", () => {
+        const css = readFileSync(join(process.cwd(), "src/styles/tokens/scale-paper.css"), "utf8");
+        const m = css.match(/--scale-engage:\s*([\d.]+);/);
+        expect(engageRung("engaged").scale).toBeTypeOf("number");
+        expect(Number(m?.[1])).toBe(engageRung("engaged").scale);
+    });
+});
+
+describe("the stage's second client: the NumberField scrub (CK-27)", () => {
+    function mountField() {
+        const n = ref(50);
+        const C = defineComponent({
+            setup: () => () =>
+                h(NumberField, { modelValue: n.value, "onUpdate:modelValue": (v: number) => (n.value = v), min: 0, max: 200 }, () => [
+                    h(NumberFieldInput),
+                ]),
+        });
+        const w = mount(C, { attachTo: document.body });
+        return { w, n, root: w.element as HTMLElement };
+    }
+    const at = (type: string, x: number): PointerEvent =>
+        new PointerEvent(type, { bubbles: true, button: 0, clientX: x, clientY: 10 });
+
+    it("a press that does not travel past the slop is a click: no hand, no promotion, no step", async () => {
+        const f = mountField();
+        f.root.dispatchEvent(at("pointerdown", 100));
+        window.dispatchEvent(at("pointermove", 104));
+        await nextTick();
+        expect(f.root.hasAttribute("data-held")).toBe(false);
+        expect(f.root.hasAttribute("data-engage-stage")).toBe(false);
+        window.dispatchEvent(at("pointerup", 104));
+        await nextTick();
+        expect(f.n.value).toBe(50);
+        f.w.unmount();
+    });
+
+    it("a press that travels takes the value, one step per slop, and is promoted while the hand is down", async () => {
+        const f = mountField();
+        f.root.dispatchEvent(at("pointerdown", 100));
+        window.dispatchEvent(at("pointermove", 125));
+        await nextTick();
+        await nextTick();
+        expect(f.root.hasAttribute("data-held")).toBe(true);
+        expect(f.root.hasAttribute("data-engaged")).toBe(true);
+        expect(f.root.matches(":popover-open")).toBe(true);
+        expect(f.n.value).toBe(53);
+        window.dispatchEvent(at("pointermove", 84));
+        await nextTick();
+        expect(f.n.value).toBe(48);
+        window.dispatchEvent(at("pointerup", 84));
+        await nextTick();
+        expect(f.root.hasAttribute("data-held")).toBe(false);
+        expect(f.root.hasAttribute("data-engaged")).toBe(false);
+        expect(f.n.value).toBe(48);
+        f.w.unmount();
+    });
+});
