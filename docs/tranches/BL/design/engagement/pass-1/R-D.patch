+// The substrate registry (D5-D): every component directory composes one registered
+// substrate, and the substrate owns the whole ladder for its kind. A component states
+// no rung; the census reads this table and presses each substrate's exemplar.
+// Shape: the battery's E-1 contract, `{ members: { dir: substrate }, classes: { substrate:
+// { rung, reason?, exemplar? } } }`. `rung` names an ENGAGE_LADDER rung (the highest one
+// the substrate answers); `null` with a reason is a declared static atom (Q-1 default c).
+import type { EngageRungName } from "./engageLadder";
+
+export type EngageSubstrate =
+    | "control-bit"
+    | "capsule"
+    | "field"
+    | "disclosure"
+    | "row"
+    | "track"
+    | "drag"
+    | "plate"
+    | "overlay"
+    | "static";
+
+interface SubstrateRow {
+    readonly rung: EngageRungName | null;
+    readonly recipe?: string;
+    readonly exemplar?: string;
+    readonly reason?: string;
+}
+
+const CLASSES: Readonly<Record<EngageSubstrate, SubstrateRow>> = {
+    "control-bit": { rung: "press", recipe: "styles/glass/control-bit.css", exemplar: "switch" },
+    capsule: { rung: "press", recipe: "styles/glass/glass-capsule.css", exemplar: "chip" },
+    field: { rung: "hover", recipe: "components/_shared/field", exemplar: "input" },
+    disclosure: { rung: "press", recipe: "components/_shared/disclosure/disclosure.css", exemplar: "accordion" },
+    row: { rung: "press", recipe: "components/_shared/menu", exemplar: "menu" },
+    track: { rung: "engaged", recipe: "styles/glass/grasp.css", exemplar: "slider" },
+    drag: { rung: "engaged", recipe: "styles/glass/grasp.css", exemplar: "sortable-list" },
+    plate: { rung: "rest", recipe: "styles/glass/material.css", exemplar: "card" },
+    overlay: { rung: "modal", recipe: "components/_shared/overlay", exemplar: "dialog" },
+    static: {
+        rung: null,
+        reason: "no plate and no input: a mark, a loading stand-in, a status glyph or an ambient field; nothing is pressed, so nothing is engaged",
+    },
+};
+
+const MEMBERS: Readonly<Record<string, EngageSubstrate>> = {
+    checkbox: "control-bit", "radio-group": "control-bit", switch: "control-bit",
+    button: "capsule", chip: "capsule", tabs: "capsule", "toggle-group": "capsule", configurator: "capsule",
+    dock: "capsule", "dark-mode-toggle": "capsule", timeline: "capsule", "pager-dots": "capsule", easing: "capsule",
+    input: "field", textarea: "field", "number-field": "field", select: "field", "labeled-field": "field",
+    accordion: "disclosure", collapsible: "disclosure", "expandable-container": "disclosure",
+    menu: "row", command: "row", "data-table": "row", table: "row",
+    slider: "track",
+    "sortable-list": "drag", carousel: "drag", deck: "drag", sheet: "drag",
+    card: "plate", alert: "plate", avatar: "plate", metric: "plate", "music-staff": "plate", surface: "plate",
+    dialog: "overlay", popover: "overlay", tooltip: "overlay", toast: "overlay",
+    separator: "static", skeleton: "static", "status-dot": "static", badge: "static", label: "static",
+    typewriter: "static", "fading-scroll": "static", "infinite-scroll": "static", aurora: "static", blob: "static",
+    constellation: "static", "fourier-field": "static", handmark: "static", progress: "static",
+    "scroll-progress-rim": "static",
+};
+
+export const ENGAGE_DECLARATION = { members: MEMBERS, classes: CLASSES } as const;
diff --git a/src/composables/motion/engage/useGraspEngaged.ts b/src/composables/motion/engage/useGraspEngaged.ts
new file mode 100644
index 00000000..b3e48555
--- /dev/null
+++ b/src/composables/motion/engage/useGraspEngaged.ts
@@ -0,0 +1,21 @@
+import { watchEffect, type Ref } from "vue";
+
+/**
+ * The one writer of `data-engaged` (E-7, W-J.2 G2). It means HELD: a live pointer or
+ * touch on a graspable surface. The surface's teleported carriers (the focus veil,
+ * the loupe) leave its inheritance, so the attribute is written on each of them
+ * while the hand is down. A modal's scrim keys on its overlay's own `data-state`,
+ * never on this attribute.
+ */
+export function useGraspEngaged(
+    held: Ref<boolean>,
+    carriers: () => readonly (HTMLElement | null | undefined)[],
+): void {
+    watchEffect(
+        () => {
+            const on = held.value;
+            for (const el of carriers()) el?.toggleAttribute("data-engaged", on);
+        },
+        { flush: "post" },
+    );
+}
