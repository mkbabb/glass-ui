diff --git a/src/styles/glass/engage.css b/src/styles/glass/engage.css
new file mode 100644
index 00000000..3629796d
--- /dev/null
+++ b/src/styles/glass/engage.css
@@ -0,0 +1,92 @@
+/* glass/engage.css — THE ENGAGEMENT SCALAR (D5-C prototype).
+
+   Engagement is one number per host. `--engage` is 0 at rest and 1 while the hand is
+   on the host (`:active`, `[data-held]`) or, for a host that declares `focus`, while
+   keyboard focus is inside it. `--commit` is the host's committed state as a level
+   (0 off, 1 on); it is transitioned on the one row whose rebound is intrinsic
+   (`--spring-panel`), and a component reads the IMPULSE `4c(1 − c)` from it: 0 at
+   either end, 1 half way, negative while the level overshoots 1. One transition of a
+   level therefore yields a pop and a rebound below the settle, with no keyframe, and a
+   host that MOUNTS committed has no before-change style, so it pops nothing (H-8).
+
+   A host opts in with `data-engage` (a token list: `press`, plus `focus` for hosts
+   whose engaged rung includes keyboard focus). A host resets both scalars to 0, so a
+   control nested in an engaged host is not engaged by inheritance; anything that is
+   NOT a host inherits its nearest host's scalars (the passive answer, Q-1).
+
+   No component writes a figure. The three budgets below are derived from the shipped
+   press scale and nothing else; under reduced motion they are 0 in one place, so every
+   spatial mapping retires and every light mapping stays. */
+
+@property --engage {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+}
+
+@property --commit {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+}
+
+@property --carry {
+    syntax: "<length>";
+    inherits: true;
+    initial-value: 0px;
+}
+
+:root {
+    /* The press rung's depth: 1 − 0.96. */
+    --rung-press-depth: calc(1 - var(--scale-press));
+    /* The engaged rung's in-place grow is the press's reciprocal: 1/0.96 − 1. */
+    --rung-grow: calc(1 / var(--scale-press) - 1);
+    /* The commit gives back what the press took. */
+    --commit-pop: var(--rung-press-depth);
+    /* The two scalar legs every host runs, appended to a host's own transition list
+       (a `transition` shorthand on a host would otherwise clobber the host's legs). */
+    --scalar-legs:
+        --engage var(--spring-press-duration) var(--spring-press),
+        --commit var(--spring-panel-duration) var(--spring-panel);
+}
+
+@media (prefers-reduced-motion: reduce) {
+    :root {
+        --rung-press-depth: 0;
+        --rung-grow: 0;
+        --commit-pop: 0;
+    }
+}
+
+@layer components {
+    [data-engage] {
+        --engage: 0;
+        --commit: 0;
+        --carry: 0px;
+        /* The commit impulse, read by a mapping: 4c(1 − c). */
+        --commit-bump: calc(4 * var(--commit) * (1 - var(--commit)));
+        /* The press-and-commit scale every bit-sized host maps: the press takes its
+           depth, the commit gives it back with the impulse's rebound, and a commit in
+           flight pre-empts the press (a tap commits before its press has drained). */
+        --scalar-scale: calc(
+            1 + var(--commit-bump) * var(--commit-pop) - var(--engage) *
+                var(--rung-press-depth) * (1 - var(--commit-bump))
+        );
+        transition: var(--scalar-legs);
+    }
+
+    [data-engage]:active,
+    [data-engage][data-held],
+    [data-engage~="focus"]:has(:focus-visible) {
+        --engage: 1;
+    }
+
+    [data-engage]:is(
+            [data-state="checked"],
+            [data-state="open"],
+            [data-state="on"],
+            [aria-pressed="true"]
+        ) {
+        --commit: 1;
+    }
+}
