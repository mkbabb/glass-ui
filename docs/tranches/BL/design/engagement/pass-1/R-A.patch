diff --git a/src/styles/utilities/engage.css b/src/styles/utilities/engage.css
new file mode 100644
index 00000000..dc027d1c
--- /dev/null
+++ b/src/styles/utilities/engage.css
@@ -0,0 +1,163 @@
+/* utilities/engage.css — ONE RECIPE PER ENGAGEMENT CLASS.
+ *
+ * `ENGAGE_DECLARATION` (composables/motion/engage/engageClasses.ts) says what each
+ * component directory is; this file says what each class does. A member composes its
+ * class's utility and states nothing else about engagement. Every recipe stamps its
+ * class as `--rung-class` (registered, not inherited), which is what the runtime
+ * census reads to prove a member composes the recipe its row declares.
+ *
+ * The registered names are `--rung-*`: the `--engage-*` namespace on `:root` is the
+ * envelope table's mirror, and a registered property with an initial value lands there.
+ *
+ * THE MECHANISM IS REGISTERED NUMBERS, NOT KEYFRAMES. Each rung is a registered
+ * `<number>` that a state selector sets to 0 or 1 and a spring row transitions; the
+ * geometry is a function of those numbers. Three properties follow from that and are
+ * the reason for it:
+ *   · a component that MOUNTS in its committed state pops nothing: a transition needs a
+ *     before-style, and an inserted element has none (H-8, with no guard);
+ *   · a commit fired from the MODEL (programmatic) and one fired from a gesture take the
+ *     same path, because both only flip the state attribute;
+ *   · a re-commit mid-flight retargets from where the number is (interruptible), instead
+ *     of restarting a keyframe.
+ *
+ * THE POP. `c` (`--rung-commit`) rides the `panel` spring, the one row whose rebound is
+ * intrinsic, from 0 to 1 (or back). The scale is `1 + (crest − 1)·sin(π·c)`: a crest at
+ * c = ½, rest at c = 1, and a rebound below rest while `panel` overshoots c past 1, of
+ * sin(π·M_panel) ≈ 0.132 of the crest. No keyframe offset, no duration and no scale is
+ * written here; the crest is a scale-register row.
+ *
+ * Clocks: geometry on the spring table's generated tokens, light on the envelope table's
+ * (`--engage-*`), with the ladder's exit law: geometry leaves on its `-exit-duration`,
+ * light leaves on its release, slower than its attack. */
+
+@property --rung-class {
+    syntax: "<custom-ident>";
+    inherits: false;
+    initial-value: unclassed;
+}
+
+@property --rung-press {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+@property --rung-commit {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+@property --rung-grow {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+/* CHOSEN — a control with a committed state (switch, checkbox, radio, toggle, chip).
+   The press is the squish; the commit is a pop on the host, or, where the member has a
+   travelling body (`[data-engage-body]`, the switch's thumb), the body's travel on the
+   same `panel` row instead of the pop (Q-5 default (a)). The light leg is the member's
+   own material (a control bit's face fill), not the host's. */
+@utility engage-chosen {
+    --rung-class: chosen;
+    --rung-crest: var(--scale-commit-pop);
+    scale: calc(
+        (1 - (1 - var(--scale-press)) * var(--rung-press)) *
+            (1 + (var(--rung-crest) - 1) * sin(var(--rung-commit) * 180deg))
+    );
+    transform-origin: center;
+    transition:
+        --rung-press var(--spring-press-duration) var(--spring-press),
+        --rung-commit var(--spring-panel-duration) var(--spring-panel);
+
+    &:is([data-state="checked"], [data-state="on"]) {
+        --rung-commit: 1;
+    }
+
+    &:active:not(:disabled, [data-disabled]) {
+        --rung-press: 1;
+    }
+
+    &:has([data-engage-body]) {
+        --rung-crest: 1;
+    }
+
+    & [data-engage-body] {
+        transition: translate var(--spring-panel-duration) var(--spring-panel);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+
+        & [data-engage-body] {
+            transition: none;
+        }
+    }
+}
+
+/* DISCLOSED — a trigger that opens a region (accordion, collapsible, popover, select).
+   A row-width target answers a press in LIGHT only (a full-width squish reads as the row
+   collapsing), on the press envelope's attack; it commits with the pop when the region
+   opens and when it closes. */
+@utility engage-disclosed {
+    --rung-class: disclosed;
+    scale: calc(1 + (var(--scale-commit-pop) - 1) * sin(var(--rung-commit) * 180deg));
+    transform-origin: center;
+    transition:
+        --rung-commit var(--spring-panel-duration) var(--spring-panel),
+        background-color var(--engage-press-drain-release) var(--ease-standard),
+        color var(--duration-control) var(--ease-standard),
+        box-shadow var(--duration-control) var(--ease-standard);
+
+    &[data-state="open"] {
+        --rung-commit: 1;
+    }
+
+    &:active:not(:disabled, [data-disabled]) {
+        background-color: color-mix(
+            in oklab,
+            var(--foreground) calc(var(--fill-selected) * 100%),
+            transparent
+        );
+        transition-duration:
+            var(--spring-panel-duration), var(--engage-press-drain-attack),
+            var(--duration-control), var(--duration-control);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+    }
+}
+
+/* HELD — a control the hand holds (slider, number-field scrub, the dock's controls).
+   The ENGAGED rung in place on a fine pointer: the host grows to `--scale-engage` on
+   the `dock` row while held or keyboard-focused, and leaves on the row's exit clock.
+   On a coarse pointer it does not grow in place (a full-width track has no gutter to
+   grow into); the rung there is a promotion, which this class does not own (Q-3
+   default (c)). Release velocity is script, outside this recipe. */
+@utility engage-held {
+    --rung-class: held;
+    scale: calc(1 + (var(--scale-engage) - 1) * var(--rung-grow));
+    transform-origin: center;
+    transition:
+        --rung-grow var(--spring-dock-exit-duration) var(--spring-dock),
+        color var(--duration-fast) var(--ease-standard);
+
+    @media (hover: hover) and (pointer: fine) {
+        &:is([data-held], :active, :has(:focus-visible)) {
+            --rung-grow: 1;
+            transition-duration: var(--spring-dock-duration), var(--duration-fast);
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+    }
+}
+
+/* STATIC — no input of its own. The class carries no rung; composing it is the
+   member's declaration that it was classified, read at runtime like any other. */
+@utility engage-static {
+    --rung-class: static;
+}
