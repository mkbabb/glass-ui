index 00000000..67cc2391
--- /dev/null
+++ b/src/composables/motion/engage/useEngage.ts
@@ -0,0 +1,304 @@
+// useEngage — the one engage primitive (D5-B).
+//
+// Engagement is behaviour, so it has one door. A component hands it its host and says
+// which parts it has; the primitive owns the state and is the ONLY writer of the
+// engagement attributes:
+//   · data-held     the control is engaged: "" while the hand is down on it, "key" while
+//                   the keyboard drives it (focus that did not arrive from a pointer)
+//   · data-engaged  the held control's organs (veil, loupe) are live — it means the
+//                   hand is down, and nothing else writes it (E-7)
+//   · data-press    the press part is down (the press light leg reads it)
+//   · data-commit   one commit edge, present while its crest plays (none under reduce)
+//
+// Three parts behind the door, each the shipped leaf, composed rather than copied:
+//   · the hand      `useDockHold` (pointer + touch acquire, window-scoped release,
+//                   the dock posture token), plus the keyboard modality
+//   · the press     `useLiquidPress` (the interruptible press spring), its options passed
+//                   through; the primitive binds its handlers natively and writes its
+//                   style, so an adopter binds nothing in its template
+//   · the velocity  `useDragVelocity` (the live smear) plus the release rule
+//                   (`release.ts`): the release velocity seeds the settle
+//
+// THE COMMIT FIRES FROM THE MODEL. `commit: "state"` watches the host's `data-state`,
+// which a reka host writes from its model whoever changed it (keyboard, pointer, a
+// programmatic write). `commit: getter` watches a model getter. `commit: "call"` is a
+// stateless control (a command): the adopter calls the returned `commit()` on
+// activation. Every form plays the same crest: the `panel` row's step response read as
+// a phase c, mapped `1 + (crest − 1)·sin(π·c)` on `transform`. The row's own overshoot
+// past 1 is the rebound; the crest is the `--scale-commit-pop` token on the host.
+//
+// THE CENSUS (Q-1, the default (c)): every directory mounts this door exactly once per
+// exemplar. An interactive component mounts it with parts; a passive one mounts it with
+// `exempt: "<reason>"` and gets nothing written. A census page that defines
+// `globalThis.__glassEngageCensus` (a Map) receives one row per mount: directory → parts
+// or reason. Without that global nothing is recorded.
+
+import {
+    onBeforeUnmount,
+    onMounted,
+    shallowRef,
+    toValue,
+    watch,
+    type MaybeRefOrGetter,
+    type Ref,
+} from "vue";
+
+import { useDockHold } from "../../../components/dock/composables/useDockHold";
+import { useDragVelocity } from "../../dom/useDragVelocity";
+import { impulseFrames, rowClockMs, stepFrames } from "./release";
+import { useLiquidPress } from "../spring/useLiquidPress";
+
+export type EngageState = "rest" | "press" | "held";
+
+export interface EngagePressOptions {
+    /** The custom property the press drive is written under. Default `--press-t`. */
+    var?: string;
+    /** The uniform shrink at full press (`useLiquidPress` `shrinkDepth`). */
+    depth?: number;
+    /** The reciprocal squish (`useLiquidPress` `squish`). Default false: a uniform shrink. */
+    squish?: boolean;
+    /** Activation is blocked; a held press releases. */
+    disabled?: () => boolean;
+}
+
+export interface UseEngageOptions {
+    /** The component directory this host belongs to: the census key. */
+    component: string;
+    /** A passive component: the reason it carries no rung. Nothing else applies. */
+    exempt?: string;
+    /** The hand: a pointer or touch hold lights `data-held`; so does keyboard focus. */
+    hold?: boolean;
+    /** The press: the interruptible press spring on the host. */
+    press?: boolean | EngagePressOptions;
+    /** The commit edge: the host's `data-state`, a model getter, or the adopter's call. */
+    commit?: "state" | "call" | (() => unknown);
+    /** A drag surface: the axis its velocity is read on, and the body the release carries. */
+    drag?: {
+        axis: () => "x" | "y";
+        body: () => HTMLElement | null;
+        mirror?: () => HTMLElement | null;
+        enabled?: () => boolean;
+    };
+    /** Elements that carry `data-held` with the host (the grasp register's own host). */
+    heldOn?: () => (Element | null | undefined)[];
+    /** The held control's organs: they carry `data-engaged` while the hand is down. */
+    engagedOn?: () => (Element | null | undefined)[];
+}
+
+export interface UseEngageReturn {
+    state: Readonly<Ref<EngageState>>;
+    isHeld: Readonly<Ref<boolean>>;
+    /** Fire the commit edge now (a stateless control's activation). */
+    commit: () => void;
+}
+
+type Census = Map<string, { parts: string[]; exempt?: string }>;
+
+const reduced = (): boolean =>
+    typeof window !== "undefined" &&
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+/** The commit crest: the `panel` row's step response as a phase, mapped onto the
+ *  `--scale-commit-pop` crest and composited onto the host's transform. */
+const crests = new WeakMap<HTMLElement, Animation>();
+let unreadable = false;
+
+function fireCommit(el: HTMLElement): void {
+    // under reduce the crest retires and schedules nothing: the state's own paint (its
+    // checked, open or pressed light) is the whole answer
+    if (reduced()) return;
+    // a commit during a crest restarts it: one crest per element, never two summed
+    crests.get(el)?.cancel();
+    el.removeAttribute("data-commit");
+    el.setAttribute("data-commit", "");
+    const crest = Number.parseFloat(getComputedStyle(el).getPropertyValue("--scale-commit-pop"));
+    const ms = rowClockMs("panel", el);
+    if (!(crest > 1) || !ms) {
+        // a host outside the library's stylesheet: the commit cannot paint, and says so
+        // once (loud, not fatal: an activation handler must not throw)
+        el.removeAttribute("data-commit");
+        if (!unreadable) console.error("[glass-ui] useEngage: --scale-commit-pop or --spring-panel-settle is unreadable on the host; the commit paints nothing. Is the glass-ui stylesheet loaded?");
+        unreadable = true;
+        return;
+    }
+    const a = el.animate(
+        stepFrames("panel", ms).map((c) => ({
+            transform: `scale(${1 + (crest - 1) * Math.sin(Math.PI * c)})`,
+        })),
+        { duration: ms, composite: "add" },
+    );
+    crests.set(el, a);
+    a.onfinish = a.oncancel = () => {
+        if (crests.get(el) !== a) return;
+        crests.delete(el);
+        el.removeAttribute("data-commit");
+    };
+}
+
+/** The release carry: the drag body leaves the finger at the finger's velocity and the
+ *  `dock` row (the engaged rung's spring) brings it home. */
+function carry(body: HTMLElement, axis: "x" | "y", v: number): void {
+    if (!v || reduced()) return;
+    const ms = rowClockMs("dock", body);
+    if (!ms) return;
+    const xs = impulseFrames("dock", v, ms);
+    body.animate(
+        xs.map((d) => ({ translate: axis === "x" ? `${d}px 0` : `0 ${d}px` })),
+        { duration: ms, composite: "add" },
+    );
+}
+
+/** Native listeners on the host, bound at mount and dropped at unmount. */
+function listen(host: () => HTMLElement | null, on: [string, (e: Event) => void][]): void {
+    let el: HTMLElement | null = null;
+    onMounted(() => {
+        el = host();
+        for (const [n, f] of on) el?.addEventListener(n, f);
+    });
+    onBeforeUnmount(() => {
+        for (const [n, f] of on) el?.removeEventListener(n, f);
+    });
+}
+
+export function useEngage(
+    host: () => HTMLElement | null,
+    o: UseEngageOptions,
+): UseEngageReturn {
+    const census = (globalThis as { __glassEngageCensus?: Census }).__glassEngageCensus;
+    const parts = ["hold", "press", "commit", "drag"].filter(
+        (k) => !o.exempt && o[k as keyof UseEngageOptions],
+    );
+    onMounted(() => census?.set(o.component, { parts, exempt: o.exempt }));
+
+    const state = shallowRef<EngageState>("rest");
+    let ready = false;
+    const commit = (): void => {
+        const h = host();
+        if (ready && h) fireCommit(h);
+    };
+    if (o.exempt) return { state, isHeld: shallowRef(false), commit };
+
+    // ── the hand, and the keyboard that engages like it ─────────────────────────
+    const isHeld: Ref<boolean> = o.hold ? useDockHold(host).isHeld : shallowRef(false);
+    if (o.hold) {
+        // Focus that a pointer brought (reka focuses the thumb by script on a slide)
+        // is not a keyboard engagement, though `:focus-visible` may match it.
+        const keyed = shallowRef(false);
+        let pointed = false;
+        listen(host, [
+            ["pointerdown", () => { pointed = true; keyed.value = false; }],
+            ["focusin", () => { keyed.value = !pointed; }],
+            ["keydown", (e) => { if ((e as KeyboardEvent).key !== "Tab") keyed.value = true; }],
+            ["focusout", (e) => {
+                const to = (e as FocusEvent).relatedTarget as Node | null;
+                if (to && host()?.contains(to)) return;
+                keyed.value = false;
+                pointed = false;
+            }],
+        ]);
+        watch(
+            [isHeld, keyed, () => o.heldOn?.(), () => o.engagedOn?.()],
+            ([held, key]) => {
+                state.value = held || key ? "held" : "rest";
+                const v = held ? "" : key ? "key" : null;
+                for (const el of [host(), ...(o.heldOn?.() ?? [])]) {
+                    if (v === null) el?.removeAttribute("data-held");
+                    else el?.setAttribute("data-held", v);
+                }
+                for (const el of o.engagedOn?.() ?? []) el?.toggleAttribute("data-engaged", held);
+            },
+            { flush: "post" },
+        );
+    }
+
+    // ── the press ──────────────────────────────────────────────────────────────
+    if (o.press) {
+        const po: EngagePressOptions = o.press === true ? {} : o.press;
+        const el = shallowRef<HTMLElement | null>(null);
+        const p = useLiquidPress({
+            el,
+            pressVar: po.var,
+            shrinkDepth: po.depth,
+            squish: po.squish ?? false,
+            disabled: po.disabled,
+        });
+        let written: string[] = [];
+        watch(
+            () => p.pressStyle.value,
+            (s) => {
+                const h = el.value;
+                if (!h) return;
+                const rec = s as Record<string, string>;
+                for (const k of written) if (!(k in rec)) h.style.removeProperty(k);
+                // under reduce the press keeps its light and drops its geometry
+                written = Object.keys(rec).filter((k) => k !== "scale" || !reduced());
+                for (const k of written) h.style.setProperty(k, rec[k]!);
+            },
+            { flush: "sync" },
+        );
+        const isKey = (e: Event) => ["Enter", " "].includes((e as KeyboardEvent).key);
+        const press = (down: boolean) => {
+            if (down && po.disabled?.()) return;
+            state.value = down ? "press" : isHeld.value ? "held" : "rest";
+            el.value?.toggleAttribute("data-press", down);
+        };
+        listen(host, [
+            ["pointerdown", (e) => { p.handlers.onPointerdown(e as PointerEvent); press(true); }],
+            ["pointerenter", (e) => { p.handlers.onPointerenter(e as PointerEvent); if ((e as PointerEvent).buttons & 1) press(true); }],
+            ["pointerup", () => { p.handlers.onPointerup(); press(false); }],
+            ["pointercancel", () => { p.handlers.onPointercancel(); press(false); }],
+            ["pointerleave", () => { p.handlers.onPointerleave(); press(false); }],
+            ["keydown", (e) => { p.handlers.onKeydown(e as KeyboardEvent); if (isKey(e)) press(true); }],
+            ["keyup", (e) => { p.handlers.onKeyup(e as KeyboardEvent); if (isKey(e)) press(false); }],
+            ["blur", () => { p.handlers.onBlur(); press(false); }],
+        ]);
+        onMounted(() => {
+            el.value = host();
+            el.value?.setAttribute("data-press-armed", "");
+        });
+    }
+
+    // ── the velocity, and the release that carries it ───────────────────────────
+    if (o.drag) {
+        const d = o.drag;
+        useDragVelocity({
+            host: () => (d.enabled?.() === false ? null : host()),
+            mirror: d.mirror,
+            axis: d.axis,
+            onRelease: (v) => {
+                const body = d.body();
+                if (body) carry(body, d.axis(), v);
+            },
+        });
+    }
+
+    // ── the commit edge, from the model ─────────────────────────────────────────
+    if (o.commit) {
+        // A model that lands before the first paint is the mount, not a commit. A
+        // stateless control has no model: every call is an activation, armed at once.
+        let arm = 0;
+        if (o.commit === "call") ready = true;
+        else {
+            onMounted(() => (arm = requestAnimationFrame(() => (ready = true))));
+            onBeforeUnmount(() => cancelAnimationFrame(arm));
+        }
+        if (o.commit === "state") {
+            let mo: MutationObserver | null = null;
+            onMounted(() => {
+                const h = host();
+                if (!h) return;
+                mo = new MutationObserver((rs) => {
+                    if (rs.some((r) => r.oldValue !== h.getAttribute("data-state"))) commit();
+                });
+                mo.observe(h, { attributes: true, attributeFilter: ["data-state"], attributeOldValue: true });
+            });
+            onBeforeUnmount(() => mo?.disconnect());
+        } else if (typeof o.commit === "function") {
+            const model: MaybeRefOrGetter<unknown> = o.commit;
+            watch(() => toValue(model), commit, { flush: "post" });
+        }
+    }
+
+    return { state, isHeld, commit };
+}
