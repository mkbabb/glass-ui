diff --git a/src/composables/motion/engage/engageStage.ts b/src/composables/motion/engage/engageStage.ts
new file mode 100644
index 00000000..a704fa43
--- /dev/null
+++ b/src/composables/motion/engage/engageStage.ts
@@ -0,0 +1,169 @@
+import { onBeforeUnmount, ref, watch, type Ref } from "vue";
+
+/**
+ * THE ENGAGED STAGE: the ladder's ENGAGED rung (`engageLadder.ts`, "the control promoted
+ * out of its own footprint"), built once.
+ *
+ * A held control is PROMOTED WHERE IT STANDS: it takes `popover="manual"` and enters the
+ * top layer without leaving its place in the DOM. That keeps the three things a moved node
+ * loses (pointer capture, focus, its inherited custom properties) and escapes the trap
+ * every teleport existed for: a top-layer box resolves against the viewport whatever its
+ * ancestors carry (`backdrop-filter`, `transform`, `filter`, `contain: paint`). A
+ * footprint the size of the control stays in flow beneath it and is the anchor the
+ * promoted control is pinned to (`anchor()`), so it tracks scroll with no listener.
+ *
+ * The world recedes behind ONE stage-owned veil (`.glass-focus-veil`, the focus-veil
+ * recipe), itself a manual popover shown just before the host so the top layer stacks it
+ * under the control. It is an element and not the host's `::backdrop`: Playwright WebKit
+ * runs no transition on a `::backdrop` engaged after it opens, and re-applies a
+ * `::backdrop` starting style when its ramp ends (R-E stage-flicker-film).
+ *
+ * SINGLETON (the ladder's `singleton: true`): a second request releases the first.
+ * ONE WRITER of `data-engaged`: this module, and it means held.
+ */
+
+interface Holder {
+    host: HTMLElement;
+    footprint: HTMLElement;
+    generation: number;
+}
+
+let holder: Holder | null = null;
+let generation = 0;
+let veil: HTMLElement | null = null;
+
+function stageVeil(): HTMLElement {
+    if (veil?.isConnected) return veil;
+    veil = document.createElement("span");
+    veil.className = "glass-focus-veil";
+    veil.setAttribute("popover", "manual");
+    veil.setAttribute("aria-hidden", "true");
+    document.body.append(veil);
+    return veil;
+}
+
+function writeGeometry(host: HTMLElement, footprint: HTMLElement): void {
+    // One layout read per engage (and per scroll while engaged), never per frame.
+    const rect = footprint.getBoundingClientRect();
+    const vw = window.innerWidth;
+    const vh = window.innerHeight;
+    const v = stageVeil();
+    v.style.setProperty("--veil-x", `${((rect.left + rect.width / 2) / vw) * 100}%`);
+    v.style.setProperty("--veil-y", `${((rect.top + rect.height / 2) / vh) * 100}%`);
+    v.style.setProperty("--glass-focus-veil-core-x", `${rect.width / 2}px`);
+    v.style.setProperty("--glass-focus-veil-core-y", `${rect.height / 2}px`);
+    // The inline grow is capped in CSS (glass/engage-stage.css) by the control's own
+    // clearance to the viewport edge less the page gutter rung: these are its inputs.
+    host.style.setProperty("--engage-room", `${Math.max(0, Math.min(rect.left, vw - rect.right))}px`);
+    host.style.setProperty("--engage-w", `${rect.width}px`);
+}
+
+function onViewportMove(): void {
+    if (holder) writeGeometry(holder.host, holder.footprint);
+}
+
+function setEngaged(host: HTMLElement, on: boolean): void {
+    host.toggleAttribute("data-engaged", on);
+    stageVeil().toggleAttribute("data-engaged", on);
+}
+
+function hide(h: Holder): void {
+    setEngaged(h.host, false);
+    if (h.host.matches(":popover-open")) h.host.hidePopover();
+    if (veil?.matches(":popover-open")) veil.hidePopover();
+    h.host.removeAttribute("popover");
+    h.host.removeAttribute("data-engage-stage");
+    h.footprint.remove();
+    window.removeEventListener("scroll", onViewportMove, true);
+    if (holder === h) holder = null;
+}
+
+/** Promote `host` onto the stage. Re-requesting the current holder re-engages it. */
+export function engageStage(host: HTMLElement): void {
+    if (holder && holder.host !== host) hide(holder);
+    generation += 1;
+    if (holder?.host === host) {
+        holder.generation = generation;
+        setEngaged(host, true);
+        return;
+    }
+    const rect = host.getBoundingClientRect();
+    const cs = getComputedStyle(host);
+    const footprint = document.createElement("span");
+    footprint.className = "engage-footprint";
+    footprint.setAttribute("aria-hidden", "true");
+    footprint.style.inlineSize = `${rect.width}px`;
+    footprint.style.blockSize = `${rect.height}px`;
+    footprint.style.margin = cs.margin;
+    footprint.style.display = cs.display.startsWith("inline") ? "inline-block" : "block";
+    footprint.style.verticalAlign = cs.verticalAlign;
+    host.before(footprint);
+    holder = { host, footprint, generation };
+    writeGeometry(host, footprint);
+    // Top-layer order is show order: the veil first, so the control stacks above it.
+    stageVeil().showPopover();
+    host.setAttribute("popover", "manual");
+    host.setAttribute("data-engage-stage", "");
+    host.showPopover();
+    // The host keeps its prior style through the promotion, so its grow transitions in
+    // this frame. The veil was `display: none` until now: resolving its rest style first
+    // gives its in-clock a value to transition FROM.
+    void getComputedStyle(stageVeil()).opacity;
+    setEngaged(host, true);
+    window.addEventListener("scroll", onViewportMove, { passive: true, capture: true });
+}
+
+/**
+ * Release `host`. The control springs home on its own clock and the veil fades on its
+ * out-clock; both leave the top layer when those transitions finish (read from the
+ * running animations, never a timer). Under reduced motion nothing runs: they leave at once.
+ */
+export function releaseStage(host: HTMLElement, immediate = false): void {
+    const h = holder;
+    if (!h || h.host !== host) return;
+    setEngaged(host, false);
+    if (immediate) return hide(h);
+    const mine = h.generation;
+    const v = stageVeil();
+    const running = [
+        ...host.getAnimations().filter((a) => (a as CSSTransition).transitionProperty === "scale"),
+        ...v.getAnimations().filter((a) => (a as CSSTransition).transitionProperty === "opacity"),
+    ];
+    Promise.all(running.map((a) => a.finished.catch(() => undefined))).then(() => {
+        // A re-grab during the exit took a new generation: this release is stale.
+        if (holder === h && h.generation === mine && !host.hasAttribute("data-engaged")) hide(h);
+    });
+}
+
+export interface UseEngageStageReturn {
+    /** True while this host is on the stage and engaged. */
+    engaged: Readonly<Ref<boolean>>;
+}
+
+/**
+ * Bind a control's hold to the stage: `held` true promotes the host, false releases it.
+ * The hold is the caller's (the slider's `useDockHold`); the stage owns the rung.
+ */
+export function useEngageStage(
+    resolveHost: () => HTMLElement | null,
+    held: Ref<boolean>,
+    enabled: () => boolean = () => true,
+): UseEngageStageReturn {
+    const engaged = ref(false);
+    watch(held, (on) => {
+        const host = resolveHost();
+        if (!host || typeof window === "undefined") return;
+        if (on && enabled()) {
+            engageStage(host);
+            engaged.value = true;
+        } else if (engaged.value) {
+            releaseStage(host);
+            engaged.value = false;
+        }
+    });
+    onBeforeUnmount(() => {
+        const host = resolveHost();
+        if (host) releaseStage(host, true);
+    });
+    return { engaged };
+}
