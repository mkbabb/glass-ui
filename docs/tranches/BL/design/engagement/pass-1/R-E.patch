+
+/* THE GUTTER CAP. Inline, the grow may spend only the clearance the control has beyond
+   the page gutter (`--space-section`, the spacing register's "page gutter" rung):
+   1 + 2·max(0, room − gutter)/width. A control already on its gutter (a full-width
+   phone slider) keeps its width and grows along the block axis alone. Typed
+   arithmetic (length ÷ length) parses in both engines (R-E platform probe). */
+[popover][data-engage-stage][data-engaged] {
+    scale: min(
+            var(--scale-engage),
+            calc(1 + 2 * max(0px, var(--engage-room) - var(--space-section)) / var(--engage-w))
+        )
+        var(--scale-engage);
+}
+
+@media (prefers-reduced-motion: reduce) {
+    [popover][data-engage-stage][data-engaged] {
+        scale: 1;
+    }
