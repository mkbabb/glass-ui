+// The engaged stage's keyboard arm, through the engage door (`useEngage` → `isEngaged`).
+//
+// The door keys the engagement on focus that did not arrive from a pointer, or on a key the
+// control acts on; Escape and leaving disengage. The stage, and nothing else, writes
+// `data-engaged`. `data-held` stays the hand's alone: the grasp register and the slider
+// lane read it as a pointer hold (glass/grasp.css), so a keyboard engagement must not
+// write it.
+import { mount } from "@vue/test-utils";
+import { describe, expect, it } from "vitest";
+import { nextTick } from "vue";
+
+import { Slider } from "@glass/components/slider";
+
+async function ticks(): Promise<void> {
+    await nextTick();
+    await nextTick();
+}
+
+function mountSlider() {
+    const wrapper = mount(Slider, {
+        props: { modelValue: [40], "aria-label": "Keys" },
+        attachTo: document.body,
+    });
+    return { wrapper, root: wrapper.element as HTMLElement };
+}
+
+describe("engaged stage · keyboard arm", () => {
+    it("focus from the keyboard promotes the slider and writes no hand", async () => {
+        const { root } = mountSlider();
+        root.dispatchEvent(new FocusEvent("focusin", { bubbles: true }));
+        await ticks();
+        expect(root.matches(":popover-open")).toBe(true);
+        expect(root.hasAttribute("data-engaged")).toBe(true);
+        expect(root.hasAttribute("data-held")).toBe(false);
+        expect(root.querySelector(".slider-range")?.hasAttribute("data-held")).toBe(false);
+
+        root.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
+        await ticks();
+        expect(root.hasAttribute("data-engaged")).toBe(false);
+    });
+
+    it("focus a pointer brought does not engage, and a modifier alone does not either", async () => {
+        const { root } = mountSlider();
+        root.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true }));
+        root.dispatchEvent(new FocusEvent("focusin", { bubbles: true }));
+        window.dispatchEvent(new PointerEvent("pointerup", { bubbles: true }));
+        await ticks();
+        expect(root.hasAttribute("data-engaged")).toBe(false);
+
+        for (const key of ["Shift", "Meta", "Control", "Alt", "Tab"]) {
+            root.dispatchEvent(new KeyboardEvent("keydown", { key, bubbles: true }));
+            await ticks();
+            expect(root.hasAttribute("data-engaged"), key).toBe(false);
+        }
+
+        root.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowRight", bubbles: true }));
+        await ticks();
+        expect(root.hasAttribute("data-engaged")).toBe(true);
+        expect(root.hasAttribute("data-held")).toBe(false);
+    });
+
+    it("a press that focused nothing leaves the next keyboard arrival keyed", async () => {
+        const { root } = mountSlider();
+        root.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true }));
+        await ticks();
+        window.dispatchEvent(new PointerEvent("pointerup", { bubbles: true }));
+        await ticks();
+        root.dispatchEvent(new FocusEvent("focusin", { bubbles: true }));
+        await ticks();
+        expect(root.hasAttribute("data-engaged")).toBe(true);
+        expect(root.hasAttribute("data-held")).toBe(false);
+    });
+
+    it("leaving the control disengages it", async () => {
+        const { root } = mountSlider();
+        root.dispatchEvent(new FocusEvent("focusin", { bubbles: true }));
+        await ticks();
+        expect(root.hasAttribute("data-engaged")).toBe(true);
+        root.dispatchEvent(new FocusEvent("focusout", { bubbles: true, relatedTarget: document.body }));
+        await ticks();
+        expect(root.hasAttribute("data-engaged")).toBe(false);
+    });
+});
