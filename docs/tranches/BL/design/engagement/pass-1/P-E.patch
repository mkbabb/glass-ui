@@ -0,0 +1,86 @@
+/* glass/engage-stage.css
+   THE ENGAGED STAGE (composables/motion/engage/engageStage.ts): the ladder's ENGAGED rung.
+
+   A held control takes `popover="manual"` + `[data-engage-stage]` and enters the top layer
+   WHERE IT STANDS (no DOM move: pointer capture, focus and inheritance survive). Its
+   footprint stays in flow and is the anchor it is pinned to, so the promoted control
+   sits exactly on its rest box and follows scroll by anchor positioning. While
+   `[data-engaged]` it grows on the dock spring by `--scale-engage`, capped along the
+   inline axis by the gutter (below). The world's half is the stage's one veil, a manual
+   popover shown under the host (glass/focus-veil.css). Reduced motion retires the grow
+   and keeps the veil.
+
+   TWO STRENGTHS, ON PURPOSE. The popover UA sheet paints a box (border, padding, margin,
+   Canvas, CanvasText) the host never asked for: those are neutralized at the LOWEST
+   author strength (`@layer base`, zero specificity), so any paint or box the host
+   authors itself still wins. The pin is GEOMETRY and has to win over the host's own:
+   it is UNLAYERED at (0,2,0), because the hosts it promotes author their geometry
+   unlayered at (0,1,0) (slider/styles.css). */
+
+@layer base {
+    :where([popover][data-engage-stage], [popover].glass-focus-veil) {
+        margin: 0;
+        border: 0;
+        padding: 0;
+        overflow: visible;
+        background: transparent;
+        color: inherit;
+    }
+    /* The stage's veil is a manual popover too: the UA's fit-content box would collapse
+       the full-viewport plate the recipe's `inset: 0` asks for. */
+    :where([popover].glass-focus-veil) {
+        inline-size: auto;
+        block-size: auto;
+        max-inline-size: none;
+        max-block-size: none;
+    }
+}
+
+.engage-footprint {
+    display: block;
+    flex: none;
+    anchor-name: --engage-footprint;
+}
+
+[popover][data-engage-stage] {
+    position: fixed;
+    position-anchor: --engage-footprint;
+    inset: auto;
+    left: anchor(left);
+    top: anchor(top);
+    inline-size: anchor-size(width);
+    block-size: anchor-size(height);
+    scale: 1;
+    transition: scale var(--spring-dock-duration) var(--spring-dock);
+}
+
+/* THE GUTTER CAP, AND THE REACH. Inline, the grow may spend only the clearance the
+   control has beyond the page gutter (`--space-section`, the spacing register's "page
+   gutter" rung): 1 + 2·max(0, room − gutter)/width, at most `--scale-engage`. A control
+   already on its gutter (a full-width phone slider) keeps its width and grows along the
+   block axis alone. The figure is `--stage-reach`, registered so it computes to a
+   number the stage can read: the release fling (engageStage.ts `flingStage`) spends
+   the same reach and no more. Typed arithmetic (length ÷ length) parses in both
+   engines (R-E platform probe). */
+@property --stage-reach {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 1;
+}
+
+[popover][data-engage-stage] {
+    --stage-reach: min(
+        var(--scale-engage),
+        calc(1 + 2 * max(0px, var(--stage-room) - var(--space-section)) / var(--stage-w))
+    );
+}
+
+[popover][data-engage-stage][data-engaged] {
+    scale: var(--stage-reach) var(--scale-engage);
+}
+
+@media (prefers-reduced-motion: reduce) {
+    [popover][data-engage-stage][data-engaged] {
+        scale: 1;
+    }
+}
