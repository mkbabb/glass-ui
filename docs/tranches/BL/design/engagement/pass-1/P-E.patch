index 00000000..ccc690e9
--- /dev/null
+++ b/src/composables/motion/engage/release.ts
@@ -0,0 +1,118 @@
+// The release rule: hallmark 6's one owner.
+//
+// "A release carries its velocity into the settle" is one sentence with two halves,
+// and both live here so no surface writes its own:
+//   · the MEASUREMENT — `VelocitySampler`, the chord across the last few pointer
+//     samples (one stalled frame cannot fling anything). It was the sortable list's;
+//     the list now reads it from here.
+//   · the SETTLE — `impulseFrames`, a named spring row's response to an initial
+//     velocity with no displacement, sampled into keyframes the compositor plays. The
+//     row is named, never restated; the clock is the row's own CSS token.
+//
+// Nothing here mints a response, a damping fraction or a duration.
+
+import { SpringProgress } from "@mkbabb/keyframes.js";
+
+import { motionTempo } from "../core/motionTempo";
+import { springPreset, type SpringPresetName } from "../spring/springPresets";
+
+/** A pointer sample: position and the clock it was taken on. */
+interface Sample {
+    x: number;
+    y: number;
+    t: number;
+}
+
+/**
+ * A small ring buffer over the last few pointer samples. Release velocity is the chord
+ * across the window rather than the last frame's delta.
+ */
+export class VelocitySampler {
+    private readonly ring: Sample[] = [];
+    private readonly size = 5;
+
+    push(x: number, y: number, t: number = performance.now()): void {
+        this.ring.push({ x, y, t });
+        if (this.ring.length > this.size) this.ring.shift();
+    }
+
+    reset(): void {
+        this.ring.length = 0;
+    }
+
+    /**
+     * px/s across the sample window; `{x:0,y:0}` when the window is degenerate. With
+     * `withinMs`, only samples that young (against the last) count, so a finger held
+     * still before it lets go releases with no velocity.
+     */
+    velocity(withinMs?: number): { x: number; y: number } {
+        const last = this.ring[this.ring.length - 1];
+        const first =
+            withinMs == null || !last
+                ? this.ring[0]
+                : this.ring.find((s) => last.t - s.t <= withinMs);
+        if (!first || !last) return { x: 0, y: 0 };
+        const dt = (last.t - first.t) / 1000;
+        if (dt <= 0) return { x: 0, y: 0 };
+        return { x: (last.x - first.x) / dt, y: (last.y - first.y) / dt };
+    }
+}
+
+/**
+ * The settle clock of a row, in ms, read from its CSS token on `el` — the same clock a
+ * CSS transition on that row runs, tempo included.
+ */
+export function rowClockMs(row: SpringPresetName, el?: Element | null): number {
+    const source = el ?? document.documentElement;
+    const raw = getComputedStyle(source).getPropertyValue(`--spring-${row}-settle`).trim();
+    const s = Number.parseFloat(raw);
+    return Number.isFinite(s) && s > 0 ? s * 1000 * motionTempo(el) : 0;
+}
+
+/**
+ * A row's response to an impulse: displacement 0, velocity `v0` (units per second),
+ * target 0. Returns the displacement sampled at `n + 1` evenly spaced instants over
+ * `ms`, the last forced to 0 (the row's clock is its settle; the residue is inside the
+ * row's own band).
+ */
+export function impulseFrames(
+    row: SpringPresetName,
+    v0: number,
+    ms: number,
+    n = 24,
+): number[] {
+    const r = springPreset(row);
+    const spring = new SpringProgress({
+        response: r.response * motionTempo(),
+        dampingFraction: r.dampingFraction,
+        initial: 0,
+        initialVelocity: v0,
+        respectReducedMotion: false,
+    });
+    spring.target = 0;
+    const out: number[] = [];
+    for (let k = 0; k <= n; k++) out.push(k === n ? 0 : spring.tickToTime((k / n) * (ms / 1000)));
+    spring.dispose();
+    return out;
+}
+
+/**
+ * A row's step response: displacement 0, target 1, at rest. Returns the progress
+ * sampled at `n + 1` evenly spaced instants over `ms`, the last forced to 1. The commit
+ * maps this phase onto its crest (`useEngage`), so the row's own overshoot past 1 is
+ * the commit's rebound.
+ */
+export function stepFrames(row: SpringPresetName, ms: number, n = 48): number[] {
+    const r = springPreset(row);
+    const spring = new SpringProgress({
+        response: r.response * motionTempo(),
+        dampingFraction: r.dampingFraction,
+        initial: 0,
+        respectReducedMotion: false,
+    });
+    spring.target = 1;
+    const out: number[] = [];
+    for (let k = 0; k <= n; k++) out.push(k === n ? 1 : spring.tickToTime((k / n) * (ms / 1000)));
+    spring.dispose();
+    return out;
+}
