@@ -0,0 +1,203 @@
+/* utilities/engage.css — ONE RECIPE PER ENGAGEMENT CLASS.
+ *
+ * `ENGAGE_DECLARATION` (composables/motion/engage/engageClasses.ts) says what each
+ * component directory is; this file says what each class does. A member composes its
+ * class's utility. Every recipe stamps its class as `--rung-class` (registered, not
+ * inherited), which the runtime census reads to prove a member composes the recipe its
+ * row declares. Where a class's light answer belongs to a substrate that already paints
+ * the member (the control bit's face, the sortable row, the field), the substrate keeps
+ * it and the utility only stamps.
+ *
+ * The registered names are `--rung-*`: the `--engage-*` namespace on `:root` is the
+ * envelope table's mirror, and a registered property with an initial value lands there.
+ *
+ * THE MECHANISM IS REGISTERED NUMBERS, NOT KEYFRAMES. Each rung is a registered
+ * `<number>` that a state selector sets and a spring row transitions; the geometry is a
+ * function of those numbers. So a member that MOUNTS committed pops nothing (a
+ * transition needs a before-style, and an inserted element has none); a commit from
+ * the model and one from a gesture take one path; a re-commit mid-flight retargets.
+ *
+ * THE PRESS IS NEVER A CLASS'S GEOMETRY. A member presses in LIGHT on its own paint
+ * (the control bit's face, the chip's press layer, the row's fill), or by script where
+ * a press primitive owns it (`useLiquidPress` writes an inline `scale` on the Button).
+ * A CSS squish released into the commit cancels the pop it precedes (measured: an action
+ * chip's pointer commit peaked at 1.012, its tap at 1.000). The commit writes
+ * `transform` and the held grow writes `scale`, so neither can mask the other, and the
+ * pressed and chosen classes set `scale: none`: a co-composed hover lift or press-snap
+ * (`.glass-capsule-hover`) would sum into the commit, and its unguarded hover latches on
+ * a coarse tap (measured: the chip's tap settled at 1.015).
+ *
+ * THE POP. `c` (`--rung-commit`) rides the `panel` spring, the one row whose rebound is
+ * intrinsic, from 0 to 1 (or back). The commit is `scale(1 + (crest − 1)·sin(π·c))`: a
+ * crest at c = ½, rest at c = 1, and a rebound below rest while `panel` overshoots c past
+ * 1, of sin(π·M_panel) ≈ 0.132 of the crest. The crest is a scale-register row. A
+ * stateless member flips a parity attribute (`data-commit="a" ↔ "b"`) on each commit
+ * edge; parity maps to c, and `sin(π·c)` pops in both directions.
+ *
+ * Clocks: geometry on the spring table's generated tokens, light on the envelope
+ * table's (`--engage-*`). */
+
+@property --rung-class {
+    syntax: "<custom-ident>";
+    inherits: false;
+    initial-value: unclassed;
+}
+
+@property --rung-commit {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+@property --rung-grow {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+/* PRESSED — an action with no state (button, action chip). The press is the member's
+   light or its script press; the commit pops on each parity edge. */
+@utility engage-pressed {
+    --rung-class: pressed;
+    scale: none;
+    transform: scale(
+        calc(1 + (var(--scale-commit-pop) - 1) * sin(var(--rung-commit) * 180deg))
+    );
+    transform-origin: center;
+    transition:
+        --rung-commit var(--spring-panel-duration) var(--spring-panel),
+        background-color var(--engage-control-engage-release) var(--ease-standard),
+        border-color var(--engage-control-engage-release) var(--ease-standard),
+        box-shadow var(--engage-control-engage-release) var(--ease-standard),
+        color var(--engage-control-engage-release) var(--ease-standard),
+        opacity var(--engage-control-engage-release) var(--ease-standard);
+
+    &[data-commit="b"] {
+        --rung-commit: 1;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        transform: none;
+    }
+}
+
+/* CHOSEN — a control with a committed state (switch, checkbox, radio, selectable chip).
+   The press is LIGHT, on the member's own paint (the control bit's face, the chip's
+   press layer), never a host squish: at 20 px the scale channel is below the legible
+   floor (glass/control-bit.css §ENGAGEMENT), and a squish released into the commit
+   cancels the pop it precedes. The commit pops on the host, or, where the member has a
+   travelling body (`[data-engage-body]`, the switch's thumb), the body travels on the
+   same `panel` row instead. */
+@utility engage-chosen {
+    --rung-class: chosen;
+    --rung-crest: var(--scale-commit-pop);
+    scale: none;
+    transform: scale(calc(1 + (var(--rung-crest) - 1) * sin(var(--rung-commit) * 180deg)));
+    transform-origin: center;
+    transition:
+        --rung-commit var(--spring-panel-duration) var(--spring-panel),
+        background-color var(--engage-control-engage-release) var(--ease-standard),
+        border-color var(--engage-control-engage-release) var(--ease-standard),
+        color var(--engage-control-engage-release) var(--ease-standard);
+
+    &:is([data-state="checked"], [data-state="on"]) {
+        --rung-commit: 1;
+    }
+
+    &:has([data-engage-body]) {
+        --rung-crest: 1;
+    }
+
+    & [data-engage-body] {
+        transition: translate var(--spring-panel-duration) var(--spring-panel);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        transform: none;
+
+        & [data-engage-body] {
+            transition: none;
+        }
+    }
+}
+
+/* DISCLOSED — a trigger that opens a region (accordion, collapsible, popover, select).
+   A row-width target answers a press in LIGHT only (a full-width squish reads as the row
+   collapsing), on the press envelope's attack; it pops when the region opens and when it
+   closes. Its hover is the substrate's (components/_shared/disclosure/disclosure.css). */
+@utility engage-disclosed {
+    --rung-class: disclosed;
+    transform: scale(
+        calc(1 + (var(--scale-commit-pop) - 1) * sin(var(--rung-commit) * 180deg))
+    );
+    transform-origin: center;
+    transition:
+        --rung-commit var(--spring-panel-duration) var(--spring-panel),
+        background-color var(--engage-press-drain-release) var(--ease-standard),
+        color var(--duration-control) var(--ease-standard),
+        box-shadow var(--duration-control) var(--ease-standard);
+
+    &[data-state="open"] {
+        --rung-commit: 1;
+    }
+
+    &:active:not(:disabled, [data-disabled]) {
+        background-color: color-mix(
+            in oklab,
+            var(--foreground) calc(var(--fill-selected) * 100%),
+            transparent
+        );
+        transition-duration:
+            var(--spring-panel-duration), var(--engage-press-drain-attack),
+            var(--duration-control), var(--duration-control);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        transform: none;
+    }
+}
+
+/* HELD — a control the hand holds (slider, number-field scrub, the dock's controls).
+   The ENGAGED rung in place on a fine pointer: the host grows to `--scale-engage` on
+   the `dock` row while `[data-held]` (the hold's writer, `useDockHold`), and leaves on
+   the row's exit clock when the hold ends. Not `:has(:focus-visible)`: reka focuses the
+   thumb by script on a pointer drag, so that arm held the grow after release. A
+   keyboard engagement needs a modality signal, which is script. On a coarse pointer it
+   does not grow in place; the rung there is a promotion this class does not own. */
+@utility engage-held {
+    --rung-class: held;
+    scale: calc(1 + (var(--scale-engage) - 1) * var(--rung-grow));
+    transform-origin: center;
+    transition:
+        --rung-grow var(--spring-dock-exit-duration) var(--spring-dock),
+        color var(--duration-fast) var(--ease-standard);
+
+    @media (hover: hover) and (pointer: fine) {
+        &[data-held] {
+            --rung-grow: 1;
+            transition-duration: var(--spring-dock-duration), var(--duration-fast);
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+    }
+}
+
+/* DRAGGED — a surface the hand moves, whose job is momentum (script). Its press is the
+   substrate's light rule (sortable-list/styles.css); the utility stamps the class. */
+@utility engage-dragged {
+    --rung-class: dragged;
+}
+
+/* FIELD — text entry. Its engagement is focus, painted by the field substrate
+   (components/_shared/field/control.css); the utility stamps the class. */
+@utility engage-field {
+    --rung-class: field;
+}
+
+/* STATIC — no input of its own. The class carries no rung; composing it is the
+   member's declaration that it was classified, read at runtime like any other. */
+@utility engage-static {
+    --rung-class: static;
+}
