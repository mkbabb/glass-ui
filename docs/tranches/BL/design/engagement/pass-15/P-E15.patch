+/**
+ * Lay a host out by hand: its layout box `at` (offsets, no offsetParent) and the root's
+ * scroll `sc`, painted through the map `m` of its ancestors: the painted centre is
+ * m·(layout centre − scroll + every probe + every running glide). Glides are recorded at
+ * their first frame (progress 0) until `land()`. `blocked`: an `!important` translate owns
+ * the host, so no probe or glide paints.
+ */
+function painting(host: HTMLElement, at: { left: number; top: number; width: number; height?: number }, opts: { m?: () => Map2; blocked?: () => boolean } = {}) {
+    const m = opts.m ?? (() => ID);
+    const blocked = opts.blocked ?? (() => false);
+    const sc = { top: 0, range: 1000 };
+    const probes = new Set<[number, number]>();
+    const glides: (Glide & { a: Animation })[] = [];
+    Object.defineProperties(host, {
+        offsetParent: { get: () => null, configurable: true },
+        offsetLeft: { get: () => at.left, configurable: true },
+        offsetTop: { get: () => at.top, configurable: true },
+        offsetWidth: { get: () => at.width, configurable: true },
+        offsetHeight: { get: () => at.height ?? 20, configurable: true },
+    });
+    const root = document.documentElement;
+    Object.defineProperties(root, {
+        scrollTop: { get: () => sc.top, configurable: true },
+        scrollLeft: { get: () => 0, configurable: true },
+        scrollHeight: { get: () => sc.range + 600, configurable: true },
+        clientHeight: { get: () => 600, configurable: true },
+        scrollWidth: { get: () => 800, configurable: true },
+        clientWidth: { get: () => 800, configurable: true },
+    });
+    host.getBoundingClientRect = () => {
+        let u = at.left + at.width / 2;
+        let v = at.top + (at.height ?? 20) / 2 - sc.top;
+        if (!blocked()) {
+            for (const p of probes) {
+                u += p[0];
+                v += p[1];
+            }
+            for (const g of glides) {
+                const [x = 0, y = 0] = g.translate.split(" ").map(Number.parseFloat);
+                u += x * (1 - g.progress);
+                v += y * (1 - g.progress);
+            }
+        }
+        const M = m();
+        const cx = M.a * u + M.b * v;
+        const cy = M.c * u + M.d * v;
+        return rect(cx - at.width / 2, cy - (at.height ?? 20) / 2, at.width, at.height ?? 20);
+    };
