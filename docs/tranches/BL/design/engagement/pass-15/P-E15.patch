+// The engagement register's shared rules (utilities/engage.css; D5 pass 3, F5'): the
+// mount frame's transition hold (CK-03, F-7), and no reduced-motion authorization of a
+// commit clock (AUTH-4 retired with the commit light, O-103d (1)).
+//
+// happy-dom runs no cascade, so these read the shipped source; the battery reads the paint.
+
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+const read = (rel: string): string => readFileSync(join(process.cwd(), rel), "utf8");
+const ENGAGE = read("src/styles/utilities/engage.css");
+const UTILITIES = read("src/styles/utilities.css");
+const A11Y = read("src/styles/utilities/a11y-overrides.css");
+const decomment = (css: string): string => css.replace(/\/\*[\s\S]*?\*\//g, "");
+
+/** The rules of a CSS text: [selector list, declarations], one level under any wrapper. */
+const rules = (css: string): Array<{ selector: string; body: string }> =>
+    [...decomment(css).matchAll(/([^{};]+)\{([^{}]*)\}/g)].map((m) => ({
+        selector: m[1]!.trim(),
+        body: m[2]!.trim(),
+    }));
+
+describe("the mount frame (CK-03): the door's arming mark holds every transition under its host", () => {
+    it("is imported by the utilities root", () => {
+        expect(UTILITIES).toMatch(/@import "\.\/utilities\/engage\.css";/);
+    });
+
+    it("holds transition-property only, on the host, its descendants and their pseudo-elements", () => {
+        const gate = rules(ENGAGE).find((r) => r.selector.includes("[data-engage-arming]"));
+        expect(gate).toBeDefined();
+        const sel = gate!.selector.split(",").map((s) => s.trim());
+        for (const s of [
+            "[data-engage-arming]",
+            "[data-engage-arming] *",
+            "[data-engage-arming]::before",
+            "[data-engage-arming]::after",
+            "[data-engage-arming] *::before",
+            "[data-engage-arming] *::after",
+        ])
+            expect(sel).toContain(s);
+        expect(gate!.body).toBe("transition-property: none !important;");
+    });
+});
+
+describe("AUTH-4 is retired with the commit light (O-103d (1))", () => {
+    it("engage.css authorizes no clock under reduced motion", () => {
+        expect(ENGAGE).not.toMatch(/AUTH-4/);
+        expect(decomment(ENGAGE)).not.toMatch(/transition-duration:[^;]*!important/);
+    });
+
+    it("the authorized-set register a11y-overrides.css names carries no AUTH-4 row", () => {
+        const register = A11Y.match(/(docs\/[\w./-]+\.md)\s*§PRM-AUTHORIZED-SET/);
+        expect(register, "a11y-overrides.css no longer names its authorized-set register").not.toBeNull();
+        const row = read(register![1]!)
+            .split("\n")
+            .find((line) => /^\|\s*AUTH-4\s*\|/.test(line));
+        expect(row).toBeUndefined();
+    });
+});
