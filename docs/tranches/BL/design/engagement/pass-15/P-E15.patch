+        const native = window.getComputedStyle;
+        gcs = vi.spyOn(window, "getComputedStyle").mockImplementation((el, p) => {
+            const cs = native(el, p);
+            if (el !== card || !cardScale) return cs;
+            return new Proxy(cs, { get: (t, k) => (k === "scale" ? cardScale : Reflect.get(t, k)) });
+        });
+        w.w.element.before(card);
+        card.append(w.w.element);
+        const subject = w.a.appendChild(document.createElement("div"));
+        subject.setAttribute("data-engage-lens-subject", "");
+        // its painted map: the card's scale along each of its axes (read by probes, never from its box)
+        probed(subject, () => track, map ?? Number(cardScale ?? 1));
+        const lens = w.a.appendChild(document.createElement("div"));
+        lens.setAttribute("data-engage-lens", "");
