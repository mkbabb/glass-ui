+
+    it("no press outside the dock keys on `:active`: the material, the sortable list and the dialog close are on the mark (CK-17)", () => {
+        const bare = (f: string): string => read(f).replace(/\/\*[\s\S]*?\*\//g, "");
+        for (const f of ["components/sortable-list/styles.css", "components/dialog/styles.css"]) expect(bare(f)).not.toMatch(/:active/);
+        // the material's remaining `:active` lines are the dock controls', D2's fence
