+            (x, ax) => x ?? [0, 0.5, 1].reduce((m, c) => (Math.abs(dc[ax]! + o(pk, [c, c])[ax]! - o(k, [c, c])[ax]!) < Math.abs(dc[ax]! + o(pk, [m, m])[ax]! - o(k, [m, m])[ax]!) ? c : m)),
+        ) as Pt;
+        s = add(dc, sub(o(pk, ref), o(k, ref)));
+        u = inv(paintJ, s) ?? [0, 0];
+    }
+    let t: Pt | null = null;
+    let aim: Decision["aim"];
+    // a classified frame whose step is within the measure's resolution is a still frame (b.6): the held place did not move
+    const still = kind === "paint" ? hyp(s) <= GLIDE_FLOOR : hyp(u) <= CHAIN_PX;
+    if (kind && !still && !h.blocked) {
+        // rule 5: past the ceiling the move is a step, its departure from the carried velocity glided and superposed, and the velocity is not
+        // taken up (a ramp running under it keeps being carried: M18); at or below it b.6 carries the velocity and glides only its departure
+        const d: Pt = sub(u, h.v);
+        const past = kind === "paint" ? hyp(fwd(paintJ!, d)) > GLIDE_FLOOR : hyp(d) > CHAIN_PX;
+        if (past) {
+            if (kind === "chain") t = d;
+            else {
+                const at = add(P, fwd(paintJ!, d));
+                t = solve(host, at, d, mapAt(host, d, h.walk!.sc), h.walk!.sc);
+                if (t) aim = { at, J: paintJ! };
+            }
+            if (t && follow) {
+                const L = above(h.cv);
+                const Li = inv2(L[follow.i]!);
+                if (Li) follow.w = app(Li, app(h.J, t).map((x) => -x) as Pt);
+            }
+        }
+        if (hyp(u) <= CARRY_PX) h.v = u;
+    } else if ((!kind || still) && hyp(h.v) > CHAIN_PX) h.v = [0, 0];
+    h.prev = { k, P, g, sz };
+    return { h, t, aim, follow: t ? follow : undefined, re, moved: boxMoved || kind !== null || !sameLinks };
+}
+
+/** Lay the host's lens, if it shows one, on its subject's painted box (THE LENS, above). */
+function placeLens(h: Holder): void {
+    const lens = h.host.querySelector<HTMLElement>(":scope > [data-engage-lens]");
+    const subject = h.host.querySelector<HTMLElement>("[data-engage-lens-subject]");
+    if (!lens || !subject || !lens.offsetHeight) return;
+    if (h.lens.el !== lens) h.lens = { ...noLens(), el: lens };
+    const L = h.lens;
+    // the subject's painted scale: its probe map's axis lengths, re-asked when its painted size changes (b.9;
+    // a carrier that translates it moves the box and leaves the lengths, so no probe is due, §S14-h)
+    const at = sizeOf(subject);
+    if (at !== L.at) {
+        L.at = at;
+        if (!L.blocked) {
+            const m = mapAt(subject);
+            const s = axes(m);
+            if (s[0] > 0 && s[1] > 0) L.s = s;
+        }
+    }
+    // read painted; written in the lens's own px: its frame's axis lengths (a top-layer box: its zoom)
+    const f = axes(mapAt(lens));
+    const t = subject.getBoundingClientRect();
+    // the lens's painted height at rest is its CSS height at the subject's painted scale
+    const room = t.top - lens.offsetHeight * L.s[1];
+    const below = L.below ? room <= HOLD_SLOP_PX : room < 0;
+    let r = lens.getBoundingClientRect();
+    const turned = below !== L.below;
+    const painted = r.top + r.height / 2;
+    // the part of the lens's paint its travel still owes, which the correction must not close
+    let owed = L.span * f[1] * (1 - (L.travel?.effect?.getComputedTiming().progress ?? 1));
+    if (turned) {
+        L.travel?.cancel();
+        owed = 0;
+        L.below = below;
+        lens.toggleAttribute("data-engage-lens-below", below);
+        r = lens.getBoundingClientRect();
+    }
+    // the lens scales about its pinned edge's centre, so that point moves by the correction alone
+    const dy = (below ? t.bottom - r.top : t.top - r.bottom) + owed;
+    L.dx = round2(L.dx + (t.left + t.width / 2 - (r.left + r.width / 2)) / f[0]);
+    L.dy = round2(L.dy + dy / f[1]);
+    const sx = `${Math.round((L.s[0] / f[0]) * 1e4) / 1e4}`;
+    const sy = `${Math.round((L.s[1] / f[1]) * 1e4) / 1e4}`;
+    const written = `${L.dx} ${L.dy} ${sx} ${sy}`;
+    if (turned && L.written) {
+        L.span = round2((painted - (r.top + r.height / 2 + dy)) / f[1]);
+        L.travel = glide(lens, h.host, [0, L.span]);
+    }
+    if (written === L.written) return;
+    L.written = written;
+    lens.style.setProperty("--lens-dx", `${L.dx}px`);
+    lens.style.setProperty("--lens-dy", `${L.dy}px`);
+    lens.style.setProperty("--lens-sx", sx);
+    lens.style.setProperty("--lens-sy", sy);
+}
+
+/**
+ * Read the reach's inputs, loudly (the declared reads; THE REACH, above), and the host's
+ * frame along its inline axis: J's inline axis length from computed values (§S15-g rule 1),
+ * which leaves out the host's own scale (`translate` composes outside it). On a map that is
+ * not affine, the probe map's, asked again only on a frame whose layout key or a carrier's
+ * computed value above the host changed, never because the stage's own glide moved the box
+ * (§S15-g rule 1): a translate on the host composes outside its own transform-family values,
+ * so the host's own carrier, where that glide composes, is not read. Under an unseen carrier
+ * the painted size is the only signal, so it is asked again when that changes. A blocked host
+ * keeps the frame it was given at the hold.
+ */
+function readReach(h: Holder, k: Key): void {
+    const says = "the held control does not grow along its inline axis";
+    h.grow = readOf(h.host, "--stage-read-grow", "number", { names: "--scale-engage", ok: (v) => v > 0, who: "engage stage", says });
+    h.gutter = readOf(document.documentElement, "--stage-read-gutter", "px", {
+        names: "--space-section",
+        ok: (v) => v >= 0,
+        who: "engage stage",
+        says,
+        on: h.host,
+    });
+    if (h.blocked) return;
+    if (h.affine && h.walk?.unseen === Number.POSITIVE_INFINITY && !inTopLayer(h.host)) {
+        h.fx = Math.hypot(h.J[0], h.J[2]);
+        h.fxAt = "";
+        return;
+    }
+    const at =
+        h.walk && h.walk.unseen !== Number.POSITIVE_INFINITY
+            ? `s ${sizeOf(h.host)}`
+            : `k ${k.lv.join(" ")} ${k.w},${k.h} ${k.ws.join(" ")} ${k.z.join(" ")} ${k.zp.join(" ")} ${k.S.join(" ")}|${h.cv.slice(1).map((c) => (c ? `${c.v}|${c.tr}` : "-")).join("|")}`;
+    if (at !== h.fxAt) {
+        h.fxAt = at;
+        h.fx = axes(mapAt(h.host))[0];
+    }
+}
+
+/**
+ * Write the reach on the host: the inline grow the clearance beyond the page gutter allows
+ * (1 + 2·max(0, room − gutter)/width, at most the grow), every term in the host's own px:
+ * the room read painted (its centre, the viewport) over its frame, the width its layout
+ * width. A refused input writes 1: no inline grow, as its message says. Written only when it
+ * changes.
+ */
+function writeReach(h: Holder): void {
+    const host = h.host;
+    const w = host.offsetWidth;
+    let reach = "1";
+    if (!Number.isNaN(h.grow) && !Number.isNaN(h.gutter) && w > 0 && h.fx > 0) {
+        const c = centreOf(host);
+        const half = (w * h.fx) / 2;
+        const room = Math.max(0, Math.min(c[0] - half, window.innerWidth - (c[0] + half))) / h.fx;
+        reach = `${Math.round(Math.min(h.grow, 1 + (2 * Math.max(0, room - h.gutter)) / w) * 1e5) / 1e5}`;
+    }
+    if (reach === h.reach) return;
+    h.reach = reach;
+    host.style.setProperty("--stage-reach", reach);
+}
+
+/**
+ * The hold's check (b.10), from the hold's own task: a `CHECK_PX` probe that moves the box
+ * under the glide floor against the mean of two unprobed reads (a running grow moves the box
+ * between reads) means an `!important` declaration owns the box's `translate`.
+ */
+function owned(el: HTMLElement): boolean {
+    const p0 = centreOf(el);
+    const p1 = probe(el, [CHECK_PX, 0]);
+    const p2 = centreOf(el);
+    return Math.hypot(p1[0] - (p0[0] + p2[0]) / 2, p1[1] - (p0[1] + p2[1]) / 2) < GLIDE_FLOOR;
+}
+
+function checkOwned(h: Holder): void {
+    h.blocked = owned(h.host);
+    if (h.blocked)
+        sayOnce(
+            h.host,
+            "translate !important",
+            "[glass-ui] engage stage: the held control's translate is owned by an !important declaration (translate !important); it engages with no glide, so its place steps during the hold are cut.",
+        );
+    const subject = h.host.querySelector<HTMLElement>("[data-engage-lens-subject]");
+    h.lens.blocked = !!subject && owned(subject);
+    if (h.lens.blocked)
+        sayOnce(
+            h.host,
+            "lens translate !important",
+            "[glass-ui] engage stage: the lens subject's translate is owned by an !important declaration (translate !important); the lens is laid at scale 1.",
+        );
+}
+
+/**
+ * The frame's resize step (after layout, before paint): every engaged host read and
+ * classified first, then every write (the glides, the re-derived glides, the reach), then
+ * each lens laid on the paint those writes leave.
+ */
+function step(): void {
+    const decisions: Decision[] = [];
+    for (const h of holders.values()) if (h.engaged) decisions.push(read(h));
+    const wrote = new Set<Holder>();
+    for (const { h, t, aim, follow, re, moved } of decisions) {
+        for (const [f, u] of re) {
+            rewrite(f.a, u);
+            f.t = u;
+            wrote.add(h);
+        }
+        if (t) {
+            const a = glide(h.host, h.host, t);
+            if (a) {
+                h.glides.add(a);
+                wrote.add(h);
+                if (aim) land(h.host, a, t, aim.at, aim.J);
+                if (follow) h.follow.add({ a, i: follow.i, w: follow.w, t });
+            }
+        }
+        if (moved) {
+            readReach(h, h.prev!.k);
+            writeReach(h);
+            wrote.add(h);
+        }
+    }
+    for (const { h } of decisions) {
+        placeLens(h);
+        // the place painted after the frame's writes is the next frame's start
+        if (h.prev && wrote.has(h)) {
+            const r = h.host.getBoundingClientRect();
+            h.prev.P = [r.left + r.width / 2, r.top + r.height / 2];
+            h.prev.sz = [r.width, r.height];
+            h.prev.g = glideOffset(h);
+        }
+    }
+}
+
+const anyEngaged = (): boolean => [...holders.values()].some((h) => h.engaged);
+
+/** Each frame while a host is engaged: re-observe each engaged host, so the frame's resize step delivers to `step`. */
+function tick(): void {
+    if (!anyEngaged()) {
+        stopFrames();
+        return;
+    }
+    for (const h of holders.values()) {
+        sizes?.unobserve(h.host);
+        if (h.engaged) sizes?.observe(h.host);
+    }
+    frame = requestAnimationFrame(tick);
+}
+
+function startFrames(): void {
+    if (!sizes) sizes = new ResizeObserver(step);
+    if (!frame) frame = requestAnimationFrame(tick);
+}
+
+function stopFrames(): void {
+    cancelAnimationFrame(frame);
+    frame = 0;
+    sizes?.disconnect();
+    sizes = null;
+}
+
+function hide(h: Holder): void {
+    const { host } = h;
+    clearTimeout(h.timer);
+    h.timer = undefined;
+    holders.delete(host);
+    if (!anyEngaged()) stopFrames();
+    host.removeAttribute("data-engage-stage");
+    host.style.removeProperty("--stage-reach");
+    // MIGRATION row 2: a host that had no `style` attribute when it came on the stage is left with none
+    if (!h.hadStyle && host.style.length === 0) host.removeAttribute("style");
+}
+
+/**
+ * Release `h`: it is not read again (the loop stops at release), and it leaves the stage on
+ * one timer at the later of its glides' end, release plus its `dock` clock, and release plus
+ * the clock its grow returns on (F-11).
+ */
+function leave(h: Holder): void {
+    if (!h.engaged) return;
+    h.engaged = false;
+    if (current === h) current = null;
+    h.host.removeAttribute("data-engaged");
+    if (!anyEngaged()) stopFrames();
+    const now = performance.now();
+    const dock = dockClockMs(h.host, "engage stage", true);
+    const exit = dockExitClockMs(h.host, "engage stage");
+    let late = 0;
+    for (const a of h.glides) {
+        const end = a.effect?.getComputedTiming().endTime;
+        const at = typeof a.currentTime === "number" ? a.currentTime : 0;
+        if (typeof end === "number" && Number.isFinite(end) && a.playState !== "finished") late = Math.max(late, end - at);
+    }
+    const ms = Math.max(Number.isFinite(dock) ? dock : 0, Number.isFinite(exit) ? exit : 0, late);
+    clearTimeout(h.timer);
+    // the grow's transition starts at the style update after release, so at the bound it can still run a frame: its end, not a frame loop, moves the exit later
+    const off = (): void => {
+        if (h.engaged || holders.get(h.host) !== h) return;
+        const grow = (h.host.getAnimations?.() ?? []).filter((a) => (a as CSSTransition).transitionProperty === "--rung-grow" && a.playState === "running");
+        if (grow.length) void Promise.all(grow.map((a) => a.finished)).then(off, off);
+        else hide(h);
+    };
+    h.timer = setTimeout(off, Math.max(0, now + ms - performance.now()));
+}
+
+/** Engage `host` on the stage, in place. */
+function engageStage(host: HTMLElement): void {
+    generation += 1;
+    if (current && current.host !== host) leave(current);
+    let h = holders.get(host);
+    if (!h) {
+        h = {
+            host,
+            generation,
+            engaged: false,
+            hadStyle: host.hasAttribute("style"),
+            grow: Number.NaN,
+            gutter: Number.NaN,
+            fx: 1,
+            fxAt: "",
+            reach: "",
+            walk: null,
+            cv: [],
+            J: I2,
+            affine: true,
+            prev: null,
+            v: [0, 0],
+            glides: new Set(),
+            follow: new Set(),
+            blocked: false,
+            timer: undefined,
+            lens: noLens(),
+        };
+        holders.set(host, h);
+        host.setAttribute("data-engage-stage", "");
+    }
+    // a re-press during the exit: the timer is dropped and the read starts afresh (the released host was not read)
+    clearTimeout(h.timer);
+    h.timer = undefined;
+    h.prev = null;
+    h.v = [0, 0];
+    h.generation = generation;
+    h.engaged = true;
+    current = h;
+    checkOwned(h);
+    if (h.blocked) {
+        const w = host.offsetWidth;
+        h.fx = w > 0 ? host.getBoundingClientRect().width / w : 1;
+    }
+    readReach(h, rewalk(h));
+    writeReach(h);
+    host.setAttribute("data-engaged", "");
+    startFrames();
+}
+
+/** Release `host`. `immediate` (an unmount) leaves at once. */
+function releaseStage(host: HTMLElement, immediate = false): void {
+    const h = holders.get(host);
+    if (!h) return;
+    leave(h);
+    if (immediate && holders.get(host) === h) hide(h);
+}
+
+/**
+ * Bind a control's engagement to the stage: `engaged` true puts the host on the stage,
+ * false releases it. The engagement is the door's; the stage owns the rung.
+ */
+export function useEngageStage(
+    resolveHost: () => HTMLElement | null,
+    engaged: Readonly<Ref<boolean>>,
+    enabled: () => boolean = () => true,
+): void {
+    let on = false;
+    watch(
+        () => engaged.value,
+        (e) => {
+            const host = resolveHost();
+            if (!host || typeof window === "undefined") return;
+            if (e && enabled()) {
+                engageStage(host);
+                on = true;
+            } else if (on) {
+                releaseStage(host);
+                on = false;
+            }
+        },
+    );
+    onBeforeUnmount(() => {
+        const host = resolveHost();
+        if (host) releaseStage(host, true);
+    });
+}
