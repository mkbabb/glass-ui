+        const opts = (typeof o === "object" ? o : {}) as KeyframeAnimationOptions;
+        const tr = (kf as { translate?: string[] } | null)?.translate;
+        if (opts.fill === "both" && tr) {
+            const [x = 0, y = 0] = tr[0]!.split(" ").map(Number.parseFloat);
+            const set = probesOf.get(this) ?? new Set();
+            probesOf.set(this, set);
+            const p: [number, number] = [x, y];
+            set.add(p);
+            return { pause: () => {}, cancel: () => set.delete(p) } as unknown as Animation;
+        }
+        return { cancel: () => {}, pause: () => {}, finished: Promise.resolve(), playState: "finished" } as unknown as Animation;
+    } as typeof HTMLElement.prototype.animate;
