+++ b/tests/components/rest-loop.test.ts
@@ -0,0 +1,63 @@
+import { mount } from "@vue/test-utils";
+import { nextTick } from "vue";
+import { describe, expect, it } from "vitest";
+import { TestIntersectionObserver } from "../setup";
+import { Skeleton } from "@glass/components/skeleton";
+import { StatusDot } from "@glass/components/status-dot";
+import SkeletonSfc from "@glass/components/skeleton/Skeleton.vue?raw";
+import StatusDotSfc from "@glass/components/status-dot/StatusDot.vue?raw";
+
+// FL-6 (CK-16): the register's two rest carriers pause their loop while off-screen.
+// The browser half (currentTime stops advancing below the fold, both engines) is the
+// D5 harness's E-12 `rest-running off-screen` cell; this is the mount-level half.
+const observing = (el: Element) =>
+    TestIntersectionObserver.instances.filter((o) => o.observe.mock.calls.some(([t]) => t === el));
+
+describe("rest loops pause off-screen", () => {
+    it("a Skeleton marks itself off-screen and back", async () => {
+        const w = mount(Skeleton, { attachTo: document.body });
+        await nextTick();
+        const [io] = observing(w.element);
+        expect(io, "the skeleton host is observed").toBeDefined();
+        expect(w.attributes("data-offscreen")).toBeUndefined();
+        io.trigger(w.element, false);
+        await nextTick();
+        expect(w.attributes("data-offscreen")).toBe("");
+        io.trigger(w.element, true);
+        await nextTick();
+        expect(w.attributes("data-offscreen")).toBeUndefined();
+        w.unmount();
+    });
+
+    it("a StatusDot observes only its live pulse, and pauses it off-screen", async () => {
+        const quiet = mount(StatusDot, { props: { state: "online" }, attachTo: document.body });
+        await nextTick();
+        expect(observing(quiet.element)).toHaveLength(0);
+
+        const live = mount(StatusDot, { props: { state: "active" }, attachTo: document.body });
+        await nextTick();
+        const [io] = observing(live.element);
+        expect(io, "the live dot is observed").toBeDefined();
+        io.trigger(live.element, false);
+        await nextTick();
+        expect(live.get(".feedback-mark").attributes("data-offscreen")).toBe("");
+
+        await live.setProps({ motion: "off" });
+        expect(live.get(".feedback-mark").attributes("data-offscreen")).toBeUndefined();
+        quiet.unmount();
+        live.unmount();
+    });
+
+    // the pause rule must out-rank the rule that declares the loop: an `animation` shorthand on a
+    // more specific selector resets the play state (the first F5″ build's StatusDot kept running
+    // off-screen in the harness's E-12, Chromium)
+    it("each sheet pauses its loop on the mark, never restarts it", () => {
+        const strip = (s: string) => s.replace(/\/\*[\s\S]*?\*\//g, "");
+        expect(strip(SkeletonSfc as unknown as string)).toMatch(
+            /\.skeleton\[data-offscreen\]\s*\{\s*animation-play-state:\s*paused;\s*\}/,
+        );
+        expect(strip(StatusDotSfc as unknown as string)).toMatch(
+            /\.feedback-mark\[data-state="active"\]\[data-motion\]\[data-offscreen\]::after\s*\{\s*animation-play-state:\s*paused;\s*\}/,
+        );
+    });
+});
