@@ -0,0 +1,164 @@
+import { onBeforeUnmount, onMounted, onScopeDispose, ref, type Ref } from "vue";
+
+/**
+ * ══ THE HAND, AND THE ONE KEEP-OPEN TOKEN ══
+ *
+ * Two pieces that every engaged control composes, kept beside the engage door that
+ * owns them (`useEngage.ts`). Neither knows about a dock: the posture a hold takes is
+ * handed in as a `HoldTarget`, so this module imports nothing from `components/`.
+ *
+ * WHAT KIND OF HOLD A TOKEN IS. Two different facts, and only one is a hand:
+ *  - `"morph"` (the default): posture only. "Something is open and the host must not
+ *    idle-collapse under it": an armed search field, an open popover, a focused
+ *    switcher tab. It is NOT a hand and never engages the grasp optic (glass/grasp.css).
+ *  - `"grasp"`: a live pointer hold on a control. A grasp implies a morph hold (a
+ *    finger down must also hold the host open), so a target takes both counts.
+ */
+export type HoldKind = "morph" | "grasp";
+
+/**
+ * THE HAND'S SLOP, in px: the series rung above coarse-tap jitter (5–10 px). Below it a
+ * gesture is a click; past it the hand has taken the control (a sortable row's lift, a
+ * number field's scrub). An activation threshold only: a scrub's pitch is its own figure
+ * (`--scrub-pitch`, utilities/engage.css).
+ */
+export const HOLD_SLOP_PX = 8;
+
+/** The ref-counted posture a token holds: the dock's `keepOpen`/`release` pair. */
+export interface HoldTarget {
+    keepOpen: (kind?: HoldKind) => void;
+    release: (kind?: HoldKind) => void;
+}
+
+export interface HoldToken {
+    /** `true` while this token holds its count. */
+    readonly isHeld: Readonly<Ref<boolean>>;
+    /** Idempotent: a second call while held is a no-op, never a second count. */
+    acquire: () => void;
+    /** Idempotent: a release while free is a no-op, never a negative count. */
+    release: () => void;
+}
+
+/**
+ * One holder takes exactly one count and gives it back exactly once, including on
+ * teardown. Four sites used to hand-roll these six lines (a Popover, the dock layer
+ * group, the dock search, the hand); a leaked token is a dock that never idle-collapses
+ * again for the life of the page.
+ *
+ * `target` is a getter so a holder can sit above the thing it holds. A null target is
+ * not an error: the flag still flips, because whether the holder is holding is a fact
+ * about the holder, not about whether a dock happened to be listening.
+ */
+export function useHoldToken(
+    target: () => HoldTarget | null | undefined,
+    kind?: HoldKind,
+): HoldToken {
+    const isHeld = ref(false);
+
+    function acquire(): void {
+        if (isHeld.value) return;
+        isHeld.value = true;
+        target()?.keepOpen(kind);
+    }
+
+    function release(): void {
+        if (!isHeld.value) return;
+        isHeld.value = false;
+        target()?.release(kind);
+    }
+
+    onScopeDispose(release);
+
+    return { isHeld, acquire, release };
+}
+
+export interface UseHoldOptions {
+    /** The posture the hold takes (the enclosing dock's context), or none. */
+    target?: () => HoldTarget | null | undefined;
+    /** Whether the hold is armed. A getter, so a prop can disarm it live. Default armed. */
+    enabled?: () => boolean;
+}
+
+/**
+ * THE HAND: a host's own live pointer or touch hold.
+ *
+ * The only path in the library driven by a pointer actually going down, so it is the
+ * one the grasp register (glass/grasp.css) is sourced from. The returned `isHeld` flips
+ * with the finger whether or not a target is listening: a standalone control engages
+ * on its own drag, and a control inside a dock never co-engages off a sibling's hold.
+ *
+ * Native listeners on the RESOLVED host, for three reasons: `pointerdown` and
+ * `touchstart` fold onto one acquire under one owner; the release is window-scoped and
+ * so survives reka's `setPointerCapture` retarget; and the acquire is capture-
+ * independent, so it is instant-on (the halo lights the instant the pointer goes down;
+ * the spring governs only the settle). reka's `<SliderRoot>` does forward a consumer
+ * `@pointerdown` (`mergeProps` chains it), but last, after its own slide start.
+ *
+ * THE PRIMARY BUTTON ONLY. A secondary or middle press is not a hand on the control: it
+ * opens a context menu or an auto-scroll, and WebKit sends a secondary press a
+ * `contextmenu` and no `pointerup`, so a hold taken on it never ended (the slider stayed
+ * held after a click elsewhere). A `contextmenu` also ends a pointer hold (a Control-click
+ * on macOS is button 0 and opens the menu). It does not end a touch hold: a long press
+ * fires `contextmenu` while the finger is still down, and a touch always ends in
+ * `pointerup` or `pointercancel`.
+ *
+ * @param resolveHost a getter for the real host element, called in `onMounted`, so a
+ *   reka forwardRef host (`SliderRoot.$el`) is live by then.
+ */
+export function useHold(
+    resolveHost: () => HTMLElement | null,
+    options: UseHoldOptions = {},
+): { isHeld: Readonly<Ref<boolean>> } {
+    const armed = options.enabled ?? (() => true);
+    const token = useHoldToken(() => options.target?.(), "grasp");
+
+    // a touch's long press fires `contextmenu` with the finger still down (above)
+    let byTouch = false;
+
+    const off = (): void => {
+        window.removeEventListener("pointerup", onWindowRelease);
+        window.removeEventListener("pointercancel", onWindowRelease);
+        window.removeEventListener("blur", onWindowRelease);
+        window.removeEventListener("contextmenu", onContextMenu);
+    };
+
+    function onWindowRelease(): void {
+        byTouch = false;
+        token.release();
+        off();
+    }
+
+    function onContextMenu(): void {
+        if (!byTouch) onWindowRelease();
+    }
+
+    function onPress(event: PointerEvent | TouchEvent): void {
+        if (!armed()) return;
+        if ("button" in event && event.button !== 0) return;
+        byTouch ||= event.type === "touchstart" || ("pointerType" in event && event.pointerType === "touch");
+        token.acquire();
+        // remove-then-add: a touch then its synthesized pointer must not install two
+        off();
+        window.addEventListener("pointerup", onWindowRelease);
+        window.addEventListener("pointercancel", onWindowRelease);
+        window.addEventListener("blur", onWindowRelease);
+        window.addEventListener("contextmenu", onContextMenu);
+    }
+
+    let host: HTMLElement | null = null;
+    onMounted(() => {
+        host = resolveHost();
+        host?.addEventListener("pointerdown", onPress);
+        host?.addEventListener("touchstart", onPress, { passive: true });
+    });
+    onBeforeUnmount(() => {
+        // a gesture mid-flight at unmount (a slider unmounted under a held thumb) gives
+        // its count back here, so the target's keep-open count can never leak
+        host?.removeEventListener("pointerdown", onPress);
+        host?.removeEventListener("touchstart", onPress);
+        if (typeof window !== "undefined") off();
+        token.release();
+    });
+
+    return { isHeld: token.isHeld };
+}
diff --git a/src/composables/motion/engage/press.ts b/src/composables/motion/engage/press.ts
new file mode 100644
index 000000000..e2d9219ee
--- /dev/null
+++ b/src/composables/motion/engage/press.ts
@@ -0,0 +1,87 @@
+// The press mark: the door's one writer of `data-press`.
+//
+// `data-press` says the press part is down: a primary pointer down on the control, or
+// its activation key (Enter, Space) held. The engage door marks its host with it
+// (`useEngage`'s press part, or its light press on a committing member), and a group
+// control whose press lands on one of many hit targets names that organ with `organ`
+// (the pager rail: a transparent button over a pip in the bed layer; a tab strip).
+// Either way this file is the only place the attribute is written (CK-08).
+//
+// The mark is the hand's state only. It paints nothing: the recipe that reads it does.
+
+import { onBeforeUnmount, onMounted, watch, type WatchStopHandle } from "vue";
+
+/**
+ * Native listeners on the host, bound from mount to unmount and moved with the host: a host
+ * that renders after its owner mounts (a portalled sheet's handle, a `v-if` close) or is
+ * replaced is followed, so its press is never left unheard.
+ */
+export function listen(host: () => HTMLElement | null, on: [string, (e: Event) => void][]): void {
+    let el: HTMLElement | null = null;
+    let stop: WatchStopHandle | null = null;
+    const bind = (next: HTMLElement | null): void => {
+        if (next === el) return;
+        for (const [n, f] of on) el?.removeEventListener(n, f);
+        el = next;
+        for (const [n, f] of on) el?.addEventListener(n, f);
+    };
+    onMounted(() => {
+        bind(host());
+        stop = watch(host, bind, { flush: "post" });
+    });
+    onBeforeUnmount(() => {
+        stop?.();
+        bind(null);
+    });
+}
+
+export interface UsePressMarkOptions {
+    /** The element a press marks, from the event that pressed (default the host). */
+    organ?: (e: Event) => Element | null | undefined;
+    /** A disabled control is not pressed. */
+    disabled?: () => boolean;
+}
+
+const ACTIVATION_KEYS: ReadonlySet<string> = new Set(["Enter", " "]);
+
+/**
+ * Mark `host` with `data-press` while its press is down: a primary pointer down on it (or
+ * entering it with the primary button held), or Enter or Space held while it has focus.
+ * Lifted on up, cancel, leave, key up and focus-out, and at unmount. The mark paints
+ * nothing; a recipe that reads `[data-press]` does (the material classes' gleam,
+ * `glass/material.css`). `host` is a getter, followed as it renders or is replaced.
+ *
+ * @example
+ * const plate = ref<HTMLElement | null>(null);
+ * usePressMark(() => plate.value);
+ * // <div ref="plate" class="glass-wash" role="button" tabindex="0">…</div>
+ */
+export function usePressMark(host: () => HTMLElement | null, o: UsePressMarkOptions = {}): void {
+    let marked: Element | null = null;
+    const down = (e: Event): void => {
+        if (o.disabled?.()) return;
+        const el = o.organ ? o.organ(e) : host();
+        if (!el || el === marked) return;
+        up();
+        marked = el;
+        el.setAttribute("data-press", "");
+    };
+    const up = (): void => {
+        marked?.removeAttribute("data-press");
+        marked = null;
+    };
+    listen(host, [
+        ["pointerdown", (e) => { if ((e as PointerEvent).button === 0) down(e); }],
+        ["pointerenter", (e) => { if ((e as PointerEvent).buttons & 1) down(e); }],
+        ["pointerup", up],
+        ["pointercancel", up],
+        ["pointerleave", up],
+        ["keydown", (e) => {
+            const k = e as KeyboardEvent;
+            if (ACTIVATION_KEYS.has(k.key) && !k.repeat) down(e);
+        }],
+        ["keyup", (e) => { if (ACTIVATION_KEYS.has((e as KeyboardEvent).key)) up(); }],
+        ["focusout", up],
+    ]);
+    onBeforeUnmount(up);
+}
diff --git a/src/composables/motion/engage/release.ts b/src/composables/motion/engage/release.ts
new file mode 100644
index 000000000..dedc3891e
--- /dev/null
+++ b/src/composables/motion/engage/release.ts
@@ -0,0 +1,69 @@
+// THE RELEASE RULE: hallmark 6's one measurement.
+//
+// "A release carries its velocity into the settle" has two halves. This file is the
+// first, for every surface: the release velocity is the chord across the pointer
+// samples no older than the rule's window, measured back from the release itself, and
+// the release is a sample. A finger held still for longer than the window before it
+// lifts therefore throws nothing, and one stalled frame cannot fling anything.
+//
+// The second half, the settle, stays with each surface, seeded with this velocity on a
+// named spring row (`springPresets.ts`): the slider's carry and the tabs drag on `dock`
+// through the engage door and the drag morph, the sortable flight on `dock`
+// (`sortable-list/motion.ts`), the Sheet on its own detent legs (`sheet/detents`).
+//
+// Pure data and arithmetic: no Vue, no keyframes.js. `useDragVelocity` ships on the
+// keyframes-free root and `/dom` entries and reads this file.
+
+/** The rule's one table. A surface reads it; none restates a figure from it. */
+export const RELEASE_RULE = {
+    /**
+     * The velocity window, in ms: only samples this young, against the release, count.
+     * It is the drag engine's own default (keyframes.js `Draggable`'s `velocityWindow`,
+     * 100 ms) and the platforms' velocity-tracker horizon (Android `VelocityTracker`,
+     * Flutter `VelocityTracker._horizonMilliseconds`), so a drag measured here and a
+     * drag the engine measures agree. It is not the press-acknowledge budget
+     * (`ACKNOWLEDGE_WINDOW_MS`), which bounds how fast a press is answered, not how far
+     * back a release looks.
+     */
+    windowMs: 100,
+    /** The settle row a release carry rides unless its surface names its own. */
+    row: "dock",
+} as const;
+
+/** A pointer sample: position and the clock it was taken on. */
+interface Sample {
+    x: number;
+    y: number;
+    t: number;
+}
+
+/** The last few pointer samples; the release velocity is the chord across the window. */
+export class VelocitySampler {
+    private readonly ring: Sample[] = [];
+    private readonly size = 8;
+
+    push(x: number, y: number, t: number = performance.now()): void {
+        this.ring.push({ x, y, t });
+        if (this.ring.length > this.size) this.ring.shift();
+    }
+
+    reset(): void {
+        this.ring.length = 0;
+    }
+
+    /** px/s across the samples inside the rule's window; `{x:0,y:0}` when there are fewer than two. */
+    velocity(): { x: number; y: number } {
+        const last = this.ring[this.ring.length - 1];
+        const first = last && this.ring.find((s) => last.t - s.t <= RELEASE_RULE.windowMs);
+        if (!first || !last) return { x: 0, y: 0 };
+        const dt = (last.t - first.t) / 1000;
+        if (dt <= 0) return { x: 0, y: 0 };
+        return { x: (last.x - first.x) / dt, y: (last.y - first.y) / dt };
+    }
+
+    /** The release: the lift is a sample, then the windowed velocity. */
+    release(x: number, y: number, t: number = performance.now()): { x: number; y: number } {
+        this.push(x, y, t);
+        return this.velocity();
+    }
+}
diff --git a/src/composables/motion/engage/settle.ts b/src/composables/motion/engage/settle.ts
new file mode 100644
index 000000000..3e1dfc054
--- /dev/null
+++ b/src/composables/motion/engage/settle.ts
@@ -0,0 +1,181 @@
+// THE SETTLE: the second half of the release rule (release.ts), and the voice that says
+// when it cannot run.
+//
+// A surface that settles on a spring row reads that row twice: its clock from the CSS
+// token, as the consumer computes it (so the tempo and a consumer's override reach it),
+// and its shape from the spring table (`springPresets.ts`). Every read of a token or clock
+// the engagement code depends on fails LOUD when it is unreadable (CK-21): one
+// `console.error` per token and host, never a silent default.
+//
+// THE READS ARE DECLARED, EACH AS ITS CONSUMER'S OWN EXPRESSION (P-E14 §S14-e). A token the
+// engagement reads is a registered property the stylesheet declares on the member's class
+// (utilities/engage.css `--stage-read-*`), set to the very expression the library's consumer
+// computes (`--spring-dock-duration`, the grow's `calc()`, the gutter on `:root`), on the
+// class's `::before`, which the host's own `transition` list does not reach. The script
+// reads it back with `getComputedStyle(host, "::before")` and writes nothing, so no read
+// leaves a `style` attribute or makes a record. The syntax is `<type> | stage-unset` with
+// the ident as its initial value, so a form the consumer's expression refuses computes to
+// the ident, which no value equals: it is loud by name and drives nothing. A clock is taken
+// as `transition-duration` takes it: a negative time computes 0 there, so it reads 0 here
+// (instant, no error), and 0 is the clock CSS runs. An easing is read by the parser
+// `animate()` itself uses (`easingOf`, a `KeyframeEffect` built on it): one easing, so a
+// list is refused here. Nothing throws.
+//
+// Stated limit (§S14-e): a consumer that declares its own `transition: all … allow-discrete`
+// on a host's generated `::before` puts the read under a transition (WebKit reads the ident
+// for that transition's first half). The gutter is read at the root, so a context-relative
+// `--space-section` set on a nearer container is not that container's (D8).
+
+import { SpringProgress } from "@mkbabb/keyframes.js";
+
+import { motionTempo } from "../core/motionTempo";
+import { springPreset, type SpringPresetName } from "../spring/springPresets";
+
+// once per host and message: each degraded control speaks, none repeats itself
+const said = new WeakMap<Element, Set<string>>();
+
+/** Say `message` once per host (`on`) and `key`, loudly. */
+export function sayOnce(on: Element, key: string, message: string): void {
+    const seen = said.get(on) ?? new Set<string>();
+    if (seen.has(key)) return;
+    said.set(on, seen.add(key));
+    console.error(message);
+}
+
+/** Say once per host, loudly, that `token` is unreadable where the engagement reads it on `on`, and what then paints (`says`). */
+export function loud(token: string, on: Element, who = "engage", says = "the engagement it drives paints nothing"): void {
+    sayOnce(on, token, `[glass-ui] ${who}: ${token} is unreadable on the host; ${says}. Is the glass-ui stylesheet loaded?`);
+}
+
+type Unit = "ms" | "px" | "number";
+
+/** The refusal every declared read computes to when its expression is invalid: an ident no value equals. */
+const UNSET = "stage-unset";
+
+interface Read {
+    /** Whether the value, in `unit`, is one the consumer runs on (default: any value of the type). */
+    ok?: (v: number) => boolean;
+    /** The token(s) the message names: the consumer's own (default: the property read). */
+    names?: string;
+    who?: string;
+    /** What paints when the read is refused, as the message says it. */
+    says?: string;
+    /** The pseudo-element the read is declared on (default `::before`); null reads the element itself (a registered token). */
+    pseudo?: string | null;
+    /** The host the message is said once for (default `el`). */
+    on?: Element;
+    /** Refuse silently (a bound that only needs the value when there is one). */
+    quiet?: boolean;
+}
+
+const NUM = String.raw`[-+]?(?:\d+\.?\d*|\.\d+)(?:e[-+]?\d+)?`;
+/** The canonical computed text of each type: one number in the canonical unit. */
+const CANON: Readonly<Record<Unit, RegExp>> = {
+    ms: new RegExp(`^(${NUM})(ms|s)$`, "i"),
+    number: new RegExp(`^(${NUM})$`, "i"),
+    px: new RegExp(`^(${NUM})px$`, "i"),
+};
+/** A computed `<length-percentage>` that keeps a percentage: `N%`, or `calc(N% ± Mpx)` in either order. */
+const PERCENT = new RegExp(`^(${NUM})%$`, "i");
+const MIXED = new RegExp(`^calc\\((${NUM})(%|px) ([-+]) (${NUM})(%|px)\\)$`, "i");
+
+/** The canonical computed `text` in `unit`; a percentage is of the root's inline size (the box the page gutter pads). NaN when it is none. */
+function valueOf(text: string, unit: Unit): number {
+    const m = CANON[unit].exec(text);
+    if (m) return Number(m[1]) * (m[2]?.toLowerCase() === "s" ? 1000 : 1);
+    if (unit !== "px") return Number.NaN;
+    const of = (n: string, u: string | undefined): number => (u === "%" ? (Number(n) / 100) * document.documentElement.clientWidth : Number(n));
+    const p = PERCENT.exec(text);
+    if (p) return of(p[1]!, "%");
+    const c = MIXED.exec(text);
+    if (c && c[2] !== c[5]) return of(c[1]!, c[2]) + (c[3] === "-" ? -1 : 1) * of(c[4]!, c[5]);
+    return Number.NaN;
+}
+
+/**
+ * THE READ (above): the declared property `name` on `el`'s `::before` (or `el` itself), in
+ * `unit`. NaN, loudly by the consumer's token, when it computes to the refusal or `ok`
+ * refuses it.
+ */
+export function readOf(
+    el: Element,
+    name: string,
+    unit: Unit,
+    { ok = () => true, names = name, who = "engage", says, pseudo = "::before", on = el, quiet = false }: Read = {},
+): number {
+    const text = getComputedStyle(el, pseudo).getPropertyValue(name).trim();
+    const v = text === UNSET ? Number.NaN : valueOf(text, unit);
+    if (Number.isFinite(v) && ok(v)) return v;
+    if (!quiet) loud(names, on, who, says);
+    return Number.NaN;
+}
+
+/** The token the stage's clock is, as the consumer computes it (scheme-spring.css): the message names its parts. */
+const DOCK_CLOCK = "--spring-dock-duration (calc(var(--spring-dock-settle) * var(--motion-tempo)), at the root)";
+
+/**
+ * The `dock` row's clock on a held host in ms, as `transition-duration` runs
+ * `--spring-dock-duration` (`--stage-read-clock`): a negative time runs 0, so it reads 0.
+ * NaN, loudly by name, when the consumer's expression is invalid (`quiet`: silently).
+ */
+export function dockClockMs(host: Element, who = "engage stage", quiet = false): number {
+    const v = readOf(host, "--stage-read-clock", "ms", { names: DOCK_CLOCK, who, quiet, says: "the move it clocks is not travelled" });
+    return Number.isNaN(v) ? v : Math.max(0, v);
+}
+
+/** The token the grow returns on at release (scheme-spring.css): the message names its parts. */
+const DOCK_EXIT_CLOCK = "--spring-dock-exit-duration (the dock row's exit clock, at the root)";
+
+/**
+ * The clock a held host's grow returns on at release, in ms, as `engage-held` transitions
+ * `--rung-grow` on `--spring-dock-exit-duration` (`--stage-read-exit-clock`; F-11): the
+ * stage keeps a released host's reach until it has run. NaN, loudly by name, when refused.
+ */
+export function dockExitClockMs(host: Element, who = "engage stage"): number {
+    const v = readOf(host, "--stage-read-exit-clock", "ms", { names: DOCK_EXIT_CLOCK, who, says: "the released control leaves the stage at its dock clock" });
+    return Number.isNaN(v) ? v : Math.max(0, v);
+}
+
+/**
+ * The easing `token` holds on `el`, as `animate()` will read it: asked of the parser
+ * WAAPI itself uses (a `KeyframeEffect` built on it). null, loudly by name, when empty or
+ * refused: a list, a word, `initial`.
+ */
+export function easingOf(el: Element, token: string, who = "engage"): string | null {
+    const easing = getComputedStyle(el).getPropertyValue(token).trim();
+    try {
+        if (easing !== "") {
+            void new KeyframeEffect(null, null, { easing });
+            return easing;
+        }
+    } catch {
+        // refused by the engine's own parser: said below
+    }
+    loud(token, el, who);
+    return null;
+}
+
+/**
+ * A row's settle from displacement `x0` (any unit) with velocity `v0` (units/s) to 0,
+ * sampled over `ms`: an impulse is `x0 = 0`, a landing is `v0 = 0`.
+ */
+export function settleFrames(row: SpringPresetName, x0: number, v0: number, ms: number, n = 24): number[] {
+    const r = springPreset(row);
+    const spring = new SpringProgress({
+        response: r.response * motionTempo(),
+        dampingFraction: r.dampingFraction,
+        initial: x0,
+        initialVelocity: v0,
+        respectReducedMotion: false,
+    });
+    spring.target = 0;
+    const out: number[] = [];
+    for (let k = 0; k <= n; k++) out.push(k === n ? 0 : spring.tickToTime((k / n) * (ms / 1000)));
+    spring.dispose();
+    return out;
+}
+
+export const reducedMotion = (): boolean =>
+    typeof window !== "undefined" &&
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
