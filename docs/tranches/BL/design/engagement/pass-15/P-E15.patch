diff --git a/src/components/_shared/useRestLoop.ts b/src/components/_shared/useRestLoop.ts
new file mode 100644
index 000000000..b662c5be7
--- /dev/null
+++ b/src/components/_shared/useRestLoop.ts
@@ -0,0 +1,20 @@
+import type { MaybeRefOrGetter, Ref } from "vue";
+import { useIntersectionPause } from "../../composables/motion/core/useIntersectionPause";
+
+/**
+ * FL-6: a loop that runs at rest stops while its host is off-screen.
+ *
+ * The register has two rest carriers, Skeleton's breathe and StatusDot's `active` pulse,
+ * each one infinite CSS animation. Off-screen a browser skips their paint but keeps their
+ * clocks running, so a loading list scrolled away kept every tile's animation ticking.
+ * The host binds `data-offscreen` from the returned flag and its sheet pauses the loop
+ * there (`animation-play-state: paused`), so the loop resumes where it stopped, with no
+ * restart jump. The paint reads the flag through the template, which is why the runtime
+ * handed to `useIntersectionPause` has nothing to do. A null host is not observed and
+ * reads on-screen.
+ */
+export function useRestLoop(
+    host: MaybeRefOrGetter<Element | null | undefined>,
+): Readonly<Ref<boolean>> {
+    return useIntersectionPause(host, { pause() {}, resume() {} }).isPaused;
+}
