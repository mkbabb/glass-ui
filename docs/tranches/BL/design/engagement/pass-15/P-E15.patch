+++ b/tests/components/ui/slider/release-carry.test.ts
@@ -0,0 +1,123 @@
+// The slider's release carry (D5 pass 6, F5‴ F-13; CK-05, CK-20). The battery found the
+// carry bimodal in Chromium: two one-frame steps backward at the release, and E-4's
+// reference frame landing on either side of them. Each cure is pinned here; the paint is
+// the battery's.
+//   · the fill's transform origin is its geometry, declared on the fill's own rule, never
+//     only while held (it snapped to the centre on the release frame)
+//   · the carry rides the body's individual `scale` channel, never a `composite: "add"`
+//     animation on `transform`, the channel the held squish eases home on (Chromium
+//     dropped that running transition's value under the added animation)
+
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, ref } from "vue";
+import { describe, expect, it, vi } from "vitest";
+
+import { useEngage } from "@glass/composables/motion/engage/useEngage";
+
+const CSS = readFileSync(join(process.cwd(), "src/components/slider/styles.css"), "utf8").replace(/\/\*[\s\S]*?\*\//g, "");
+const rules = [...CSS.matchAll(/([^{};]+)\{([^{}]*)\}/g)].map((m) => ({ selector: m[1]!.trim().replace(/\s+/g, " "), body: m[2]! }));
+
+describe("the fill's origin is its geometry (F-13)", () => {
+    it("the fill's own rules declare the origin, horizontal and vertical", () => {
+        const base = rules.find((r) => r.selector === ".slider-range");
+        expect(base?.body).toMatch(/transform-origin:\s*var\(--slider-range-origin\)/);
+        const vertical = rules.find((r) => r.selector === '.glass-slider[data-orientation="vertical"] .slider-range');
+        expect(vertical?.body).toMatch(/transform-origin:\s*center bottom/);
+    });
+
+    it("no held or pressed rule moves the origin, so the release frame keeps it", () => {
+        const held = rules.filter((r) => r.selector.includes(".slider-range") && /\[data-held\]|:active/.test(r.selector) && !/:not\(/.test(r.selector));
+        expect(held.length).toBeGreaterThan(0);
+        for (const r of held) expect(r.body).not.toMatch(/transform-origin/);
+    });
+});
+
+describe("the carry rides its own channel (F-13)", () => {
+    it("a fling's release animates the body's scale, not an added transform", async () => {
+        const body = document.body.appendChild(document.createElement("div"));
+        body.getBoundingClientRect = () => ({ x: 0, y: 0, left: 0, top: 0, right: 223, bottom: 8, width: 223, height: 8, toJSON: () => ({}) }) as DOMRect;
+        const animate = vi.fn(() => ({ cancel() {} }) as unknown as Animation);
+        body.animate = animate as unknown as typeof body.animate;
+        const C = defineComponent({
+            setup() {
+                const el = ref<HTMLElement | null>(null);
+                useEngage(() => el.value, { drag: { axis: () => "x", body: () => body } });
+                return () => h("div", { ref: el });
+            },
+        });
+        const w = mount(C, { attachTo: document.body });
+        await nextTick();
+        const host = w.element as HTMLElement;
+        // the release row's clock, as the held host's consumer computes it (`--stage-read-clock`: the dock row's duration)
+        host.style.setProperty("--spring-dock-duration", "0.21s");
+        const at = (type: string, x: number, t: number, target: EventTarget): void => {
+            const e = new PointerEvent(type, { clientX: x, clientY: 0, bubbles: true, button: 0, pointerType: "mouse" });
+            Object.defineProperty(e, "timeStamp", { value: t });
+            target.dispatchEvent(e);
+        };
+        at("pointerdown", 0, 0, host);
+        for (let k = 1; k <= 3; k++) at("pointermove", 40 * k, 120 + 16 * k, window);
+        at("pointerup", 120, 172, window);
+        expect(animate).toHaveBeenCalledTimes(1);
+        const [frames, options] = animate.mock.calls[0] as unknown as [Keyframe[], KeyframeAnimationOptions];
+        expect(frames.length).toBeGreaterThan(2);
+        for (const k of frames) {
+            expect(k).toHaveProperty("scale");
+            expect(k).not.toHaveProperty("transform");
+        }
+        // the impulse leaves the rest and comes home
+        expect(frames.some((k) => k.scale !== "1 1")).toBe(true);
+        expect(frames.at(-1)!.scale).toBe("1 1");
+        expect(options.composite ?? "replace").not.toBe("add");
+        w.unmount();
+        body.remove();
+    });
+});
+
+describe("one carry, on the body, on the stage too (D5 pass 7, CK-05)", () => {
+    // The pass-6 composition carried a host on the stage by stretching the whole host with
+    // its trailing edge held (`flingStage`), so the value point, which sits at its value's
+    // fraction of the host's width, carried that fraction of the stretch: about half at a
+    // mid value (WebKit 4.35-7.44 px against the floor's 13.65). The carry is the body's,
+    // in place under every modality: the host plays no release animation of its own.
+    it.each(["mouse", "touch"])("a %s hold's fling carries on the body, never on the host", async (pointerType) => {
+        const body = document.body.appendChild(document.createElement("div"));
+        body.getBoundingClientRect = () => ({ x: 0, y: 0, left: 0, top: 0, right: 223, bottom: 8, width: 223, height: 8, toJSON: () => ({}) }) as DOMRect;
+        const bodyAnimate = vi.fn(() => ({ cancel() {} }) as unknown as Animation);
+        body.animate = bodyAnimate as unknown as typeof body.animate;
+        const C = defineComponent({
+            setup() {
+                const el = ref<HTMLElement | null>(null);
+                useEngage(() => el.value, { hold: {}, drag: { axis: () => "x", body: () => body } });
+                return () => h("div", { ref: el, tabindex: 0 });
+            },
+        });
+        const w = mount(C, { attachTo: document.body });
+        await nextTick();
+        const host = w.element as HTMLElement;
+        // the release row's clock, as the held host's consumer computes it (`--stage-read-clock`: the dock row's duration)
+        host.style.setProperty("--spring-dock-duration", "0.21s");
+        const hostAnimate = vi.fn(() => ({ cancel() {}, pause() {}, finished: Promise.resolve() }) as unknown as Animation);
+        host.animate = hostAnimate as unknown as typeof host.animate;
+        const at = (type: string, x: number, t: number, target: EventTarget): void => {
+            const e = new PointerEvent(type, { clientX: x, clientY: 0, bubbles: true, button: 0, pointerType });
+            Object.defineProperty(e, "timeStamp", { value: t });
+            target.dispatchEvent(e);
+        };
+        at("pointerdown", 0, 0, host);
+        await nextTick();
+        // on the stage while held, in place under every modality (Q-3′ (i))
+        expect(host.hasAttribute("data-engage-stage")).toBe(true);
+        expect(host.matches(":popover-open")).toBe(false);
+        for (let k = 1; k <= 3; k++) at("pointermove", 40 * k, 120 + 16 * k, window);
+        at("pointerup", 120, 172, window);
+        expect(bodyAnimate).toHaveBeenCalledTimes(1);
+        // the stage asks the engine for the host's map with paused probes (`fill: "both"`); none is an animation the host plays
+        expect(hostAnimate.mock.calls.filter((c) => (c as unknown[])[1] && ((c as unknown[])[1] as { fill?: string }).fill !== "both")).toEqual([]);
+        w.unmount();
+        body.remove();
+    });
+});
diff --git a/tests/composables/motion/engage-door.test.ts b/tests/composables/motion/engage-door.test.ts
