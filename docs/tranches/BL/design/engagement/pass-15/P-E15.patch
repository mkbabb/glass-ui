+    /** The subject painted at `track()`, plus `m` of every probe the engine is asked for (a number: a uniform scale). */
+    function probed(subject: HTMLElement, track: () => DOMRect, map: number | Map2) {
+        const m: Map2 = typeof map === "number" ? { a: map, b: 0, c: 0, d: map } : map;
+        const probes = new Set<[number, number]>();
+        subject.getBoundingClientRect = () => {
+            let x = 0;
+            let y = 0;
+            for (const p of probes) {
+                x += m.a * p[0] + m.b * p[1];
+                y += m.c * p[0] + m.d * p[1];
+            }
+            const t = track();
+            return rect(t.left + x, t.top + y, t.width, t.height);
+        };
+        subject.animate = ((kf: { translate: string[] }) => {
+            const [x = 0, y = 0] = kf.translate[0]!.split(" ").map(Number.parseFloat);
+            const p: [number, number] = [x, y];
+            probes.add(p);
+            return { pause: () => {}, cancel: () => probes.delete(p) };
+        }) as unknown as HTMLElement["animate"];
+    }
+    /**
+     * A engaged by the keyboard with a lens (80 px tall, laid out with its bottom centre at
+     * `lensAt`) over a subject painted at `track`, inside a card painted at `cardScale`.
+     */
+    async function laid(track: DOMRect, cardScale: string | null, lensAt: { x: number; y: number }, map?: Map2) {
+        const w = mountPair();
+        const card = document.createElement("div");
