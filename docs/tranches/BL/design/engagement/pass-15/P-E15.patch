+        ["components/button/styles.css", /\.button\.glass-specular-track\[data-press\]::before \{\s*--specular-intensity: var\(--glass-specular-intensity-active\);/],
+        ["components/switch/styles.css", /\.switch:not\(:disabled, \[data-disabled\]\)\[data-press\] \.switch__thumb/],
+        ["components/sortable-list/styles.css", /\.sortable-item:not\(\[data-disabled\]\)\[data-press\]/],
+        ["components/sortable-list/styles.css", /\.sortable-handle\[data-press\]/],
+        ["components/dialog/styles.css", /:where\(\[data-slot="dialog-close"\]\)\[data-press\]::before/],
+        ["styles/glass/material.css", /\.glass-specular-track\[data-press\]::before/],
+    ] as const;
+    for (const [file, rx] of SHEETS) {
