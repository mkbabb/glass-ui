+        const [x = 0, y = 0] = kf.translate[0]!.split(" ").map(Number.parseFloat);
+        if (o.fill === "both") {
+            const p: [number, number] = [x, y];
+            probes.add(p);
+            return { pause: () => {}, cancel: () => probes.delete(p) };
+        }
+        const g = { translate: kf.translate[0]!, duration: o.duration, easing: o.easing, progress: 0 } as Glide & { a: Animation };
+        const a = {
+            cancel: () => {},
+            finished: Promise.resolve(),
+            get playState() {
+                return g.progress >= 1 ? "finished" : "running";
+            },
+            currentTime: 0,
+            effect: {
+                getComputedTiming: () => ({ progress: g.progress, endTime: o.duration }),
+                getKeyframes: () => [{ translate: g.translate }],
+                setKeyframes: (k: { translate: string[] }) => (g.translate = k.translate[0]!),
