+// useEngage: the engage door.
+//
+// Engagement is behaviour, so it has one door. A component hands it its host and names
+// the parts it has; the door owns the state and is the ONLY writer of the engagement
+// attributes:
+//   · data-held      the hand is down on the control (a pointer or touch hold), and only
+//                    that. The grasp register (glass/grasp.css) and a host's own rules
+//                    read it as the hand's
+//   · data-engaged   the control is engaged: the hand is down, or the keyboard is driving
+//                    it. The door owns the STATE; the engaged stage (stage.ts) is the one
+//                    WRITER of the attribute, because the rung it marks is the stage's
+//   · data-press     the press part is down (written through press.ts, its one writer)
+//   · data-commit    a stateless control's commit edge, as a parity ("a" ↔ "b") that
+//                    flips on every activation
+//   · data-engage-arming   a state member's mount frame (`commit: "state"`): its
+//                    transitions are held off from mount until the first frame
+//                    (utilities/engage.css), so a state that ARRIVES with the mount (an
+//                    async model set in the mount's own task, even after a style read) is
+//                    the rest it mounts in, never a commit. On that frame the door flushes
+//                    style, so the arrived state is the before-change style, and lifts the
+//                    mark. A state set after it commits. B's one-frame arming (CP), moved
+//                    to the door (F5' F-7)
+//
+// The engagement's inputs fail loud. Every committing door reads every engagement clock
+// the stylesheet transitions on: the envelope table's tokens, `--engage-<role>-{attack,
+// release}` for each row of `ENGAGE_ENVELOPES`, each through its declared read
+// `--stage-read-<role>-<edge>` (utilities/engage.css, settle.ts `readOf`), so a row added
+// or renamed is read with no list kept here (D5 pass 5's rename left the control bit's
+// clocks silent: C-E5 §0.2); a clock of 0 is one CSS runs. A host whose `--rung-class`
+// commits (`ENGAGE_DECLARATION` `commits`) also reads its pop: the crest (`--rung-crest`,
+// registered `<number> | stage-unset`: any number is a crest, 1 no pop; the ident is an
+// unresolved row) and the `panel` row's clock (`--stage-read-panel`) and curve. A host
+// whose `--rung-class` is empty is an undeclared member: it says so once by name and
+// commits with no pop. The door reads one frame after mount (a state member at its arming
+// frame), then on every `data-state` edge or `commit()`, so a token planted after mount is
+// caught on the commit it degrades. No read writes the DOM. Each unreadable token is said
+// once per host in a `console.error`: a transition whose clock does not resolve plays
+// nothing and says nothing (C-A2 CK-21). B's loud read (CP), moved to the door (F-8)
+//
+// The parts, each the shipped leaf composed rather than copied:
+//   · the hand      `useHold` (hold.ts): pointer and touch acquire, the window-scoped
+//                   release, the target's posture token. Beside it the keyboard
+//                   engagement: a focus that Tab brought (never a script `focus()`, even
+//                   one a printable key's handler makes; never a pointer's), or a key the
+//                   control acts on, engages; Escape and leaving disengage. An Escape that
+//                   disengages is spent there (default prevented), so it does not also
+//                   close the Dialog the control sits in: the next one does. A modifier
+//                   alone, or a key the control does not act on, does nothing
+//   · the stage     `stage`: the engagement puts the host on the engaged stage
+//                   (stage.ts), grown in place under every modality (Q-3′ (i)). No
+//                   engagement veils the world
+//   · the scrub     `scrub`: a press that starts on the scrub's surface and travels past
+//                   the hand's slop (`HOLD_SLOP_PX`, the activation threshold) takes the
+//                   control (a number field's value scrub): one `step` per pitch travelled.
+//                   The pitch is its own figure, `--scrub-pitch` on the surface (one glyph
+//                   cell of the value, `1ch`), read loudly; never the slop (CK-12). The
+//                   scrubbing host grows in place, as every engaged control does
+//   · the press     `useLiquidPress`, on its one `--press-t` drive with its own defaults:
+//                   the door takes no press options beyond `disabled`. It binds the
+//                   handlers natively and writes the press style on the host, so an
+//                   adopter binds nothing in its template. Under reduced motion the
+//                   press keeps its light (`--press-t`) and drops its geometry (`scale`)
+//   · the light press  a member that commits (`commit`, either kind) and has no press
+//                   spring presses in LIGHT on its own paint, and its recipe keys that
+//                   light on the door's press mark (`data-press`, press.ts), never on
+//                   `:active`: Chromium's touch long-press sets `:active` 175-200 ms after
+//                   touch-down, past the 150 ms acknowledge window (`engageEnvelopes.ts`
+//                   `ACKNOWLEDGE_WINDOW_MS`), and iOS Safari sets it only under a
+//                   `touchstart` listener (X-8). The mark lands on `pointerdown`. A strip
+//                   whose presses land on one of many hit targets names it with `organ`
+//   · the commit    `commit: "call"`, a stateless control (a command): the adopter calls
+//                   the returned `commit()` on activation and the door flips the parity.
+//                   `commit: "state"`, a control with a committed state its class recipe
+//                   plays from `data-state`: the door arms its mount frame and reads its
+//                   commit loudly; it plays nothing.
+//                   The door paints nothing for it; a class recipe reads the parity
+//   · the release   `useDragVelocity` measures the release on the release rule
+//                   (release.ts) and the door carries it on the visible body: the fill's
+//                   leading edge stretches toward the fling from its own transform
+//                   origin, on the host's stage or off it, and the release row brings it
+//                   home. The value the finger chose does not move. One carry: the body
+//                   is the value point, so a stretch of the whole host (which moves the
+//                   value point by its fraction of the host's width) is not a second one
+
+import {
+    computed,
+    onBeforeUnmount,
+    onMounted,
+    shallowRef,
+    watch,
+    type Ref,
+} from "vue";
+import { useDragVelocity } from "../../dom/useDragVelocity";
+import { useLiquidPress } from "../spring/useLiquidPress";
+import { ENGAGE_DECLARATION, type EngageClassRow } from "./engageClasses";
+import { ENGAGE_ENVELOPES } from "./engageEnvelopes";
+import { HOLD_SLOP_PX, useHold, type HoldTarget } from "./hold";
+import { listen, usePressMark } from "./press";
+import { RELEASE_RULE } from "./release";
+import { dockClockMs, easingOf, readOf, reducedMotion as reduced, sayOnce, settleFrames } from "./settle";
+import { useEngageStage } from "./stage";
+
+/** The keys a range control acts on: the acting-key set a held range engages on. */
+const RANGE_ACTING_KEYS: ReadonlySet<string> = new Set([
+    "ArrowLeft",
+    "ArrowRight",
+    "ArrowUp",
+    "ArrowDown",
+    "PageUp",
+    "PageDown",
+    "Home",
+    "End",
+]);
+
+export interface UseEngageOptions {
+    /** The hand, and the keyboard engagement beside it. */
+    hold?: {
+        /** The posture a hold takes (the enclosing dock's context), or none. */
+        target?: () => HoldTarget | null | undefined;
+        /** The keys the control acts on. Default `RANGE_ACTING_KEYS`. */
+        keys?: ReadonlySet<string>;
+        /** Elements that carry `data-held` with the host (a grasp register's host). */
+        heldOn?: () => (Element | null | undefined)[];
+    };
+    /** The engaged stage: whether an engagement puts the host on it (default: always). */
+    stage?: () => boolean;
+    /**
+     * A press that travels takes the control: `step(n)` moves the value n steps (±).
+     * `surface` is the element a scrub press must start on (default the host): a press on
+     * any other part of the host (a step button) is that part's own. The surface carries
+     * the pitch, `--scrub-pitch`.
+     */
+    scrub?: { step: (n: number) => void; surface?: () => Element | null | undefined; disabled?: () => boolean };
+    /** The press: the interruptible press spring on the host. */
+    press?: { disabled?: () => boolean };
+    /** The element a light press marks, from the event that pressed (default the host):
+     *  a strip whose presses land on one of many hit targets (a tab). */
+    organ?: (e: Event) => Element | null | undefined;
+    /** The commit: `"call"`, a stateless edge the adopter fires with `commit()`; `"state"`,
+     *  a committed state the class recipe plays (the door arms the mount frame). */
+    commit?: "call" | "state";
+    /** A drag surface: the axis its velocity is read on and the visible body a release carries. */
+    drag?: {
+        axis: () => "x" | "y";
+        body: () => HTMLElement | null;
+        /** A second element that receives the live drag velocity (a teleported organ). */
+        mirror?: () => HTMLElement | null;
+        enabled?: () => boolean;
+    };
+}
+
+export interface UseEngageReturn {
+    /** The hand is down on the control. */
+    isHeld: Readonly<Ref<boolean>>;
+    /** The hand is down, or the keyboard drives the control. */
+    isEngaged: Readonly<Ref<boolean>>;
+    /** Fire the commit edge now (a stateless control's activation). */
+    commit: () => void;
+}
+
+// ── the keys held down, page-wide ───────────────────────────────────────────────
+// A focus is the keyboard's only while a key is down: Tab moves focus inside its own
+// keydown, before its keyup. A script `focus()` arrives with no key down. One capture
+// listener pair for the page, installed by the first door that needs it.
+const keysDown = new Set<string>();
+let tracking = false;
+function trackKeys(): void {
+    if (tracking || typeof window === "undefined") return;
+    tracking = true;
+    window.addEventListener("keydown", (e) => keysDown.add(e.key), true);
+    window.addEventListener("keyup", (e) => keysDown.delete(e.key), true);
+    window.addEventListener("blur", () => keysDown.clear());
+}
+
+// ── the commit's loud read ─────────────────────────────────────────────────────
+// `loud` (settle.ts) says each unreadable token once per host and token: each degraded
+// control speaks, none repeats itself
+
+/** Every engagement clock the stylesheet transitions on: the envelope table's CSS mirror, each with its declared read. */
+const ENGAGE_CLOCKS: readonly { token: string; read: string }[] = ENGAGE_ENVELOPES.flatMap((r) =>
+    (["attack", "release"] as const).map((edge) => ({
+        token: `--engage-${r.role}-${edge}`,
+        read: `--stage-read-${r.role}-${edge}`,
+    })),
+);
+
+/** The host's declared class commits: its recipe plays a commit edge. An empty class is an undeclared member, said once. */
+function commitsByClass(h: Element): boolean {
+    const name = getComputedStyle(h).getPropertyValue("--rung-class").trim();
+    if (name === "")
+        sayOnce(
+            h,
+            "--rung-class",
+            "[glass-ui] engage: --rung-class is empty on the host, so it is an undeclared engagement member; it commits with no pop. Compose its class's engage-* utility.",
+        );
+    const rows = ENGAGE_DECLARATION.classes as Readonly<Record<string, EngageClassRow | undefined>>;
+    return rows[name]?.commits === true;
+}
+
+/**
+ * Read the engagement's inputs on the host, loudly, each as its consumer computes it
+ * (settle.ts `readOf`, `easingOf`): every clock one `<time>` of 0 or more (a list would
+ * shift the items of the transition list it is set in), and the pop a committing class
+ * plays: the crest any number, the panel clock as `transition-duration` takes it.
+ */
+function readInputs(h: Element, pops: boolean): void {
+    for (const c of ENGAGE_CLOCKS) readOf(h, c.read, "ms", { names: c.token, ok: (v) => v >= 0 });
+    if (!pops) return;
+    readOf(h, "--rung-crest", "number", { pseudo: null, says: "it commits with no pop (its scale computes none)" });
+    readOf(h, "--stage-read-panel", "ms", { names: "--spring-panel-duration" });
+    easingOf(h, "--spring-panel");
+}
+
+/**
+ * The release carry on the visible body: its edge away from its transform origin (the
+ * leading edge of a fill) travels with the fling and the row brings it home, as a
+ * stretch along the axis on the body's individual `scale` channel. `scale` composes
+ * with whatever `transform` the body already plays (the held squish easing home on its
+ * own CSS transition) without touching it: a `composite: "add"` animation on
+ * `transform` itself made Chromium drop that running transition's value, so the held
+ * squish snapped to rest in one frame (7 px on a 223 px fill) under the carry.
+ */
+function carry(host: HTMLElement, body: HTMLElement, axis: "x" | "y", v: number): void {
+    if (!v) return;
+    // the release row (`dock`, release.ts) clocked as the held host's consumer computes it (`--stage-read-clock`); 0 is instant
+    const ms = dockClockMs(host, "engage");
+    if (!ms) return;
+    const box = body.getBoundingClientRect();
+    const length = axis === "x" ? box.width : box.height;
+    if (length < 1) return;
+    const [ox, oy] = getComputedStyle(body).transformOrigin.split(" ").map(Number.parseFloat);
+    const origin = axis === "x" ? ox : oy;
+    // the edge that moves is the one away from the origin: a fill growing from its start
+    // stretches with a forward fling and shortens with a backward one
+    const dir = (origin ?? 0) <= length / 2 ? 1 : -1;
+    const s = (d: number): number => Math.max(0, 1 + (dir * d) / length);
+    body.animate(
+        settleFrames(RELEASE_RULE.row, 0, v, ms).map((d) => ({
+            scale: axis === "x" ? `${s(d)} 1` : `1 ${s(d)}`,
+        })),
+        { duration: ms },
+    );
+}
+
+export function useEngage(
+    host: () => HTMLElement | null,
+    o: UseEngageOptions,
+): UseEngageReturn {
+    // ── the hand, and the keyboard that engages like it ─────────────────────────
+    const held = o.hold ? useHold(host, { target: o.hold.target }) : null;
+    const hand: Readonly<Ref<boolean>> = held?.isHeld ?? shallowRef(false);
+    const scrubbing = shallowRef(false);
+    const isHeld = computed(() => hand.value || scrubbing.value);
+    const keyed = shallowRef(false);
+    const isEngaged = computed(() => isHeld.value || keyed.value);
+    if (o.hold) {
+        const h = o.hold;
+        const keys = h.keys ?? RANGE_ACTING_KEYS;
+        trackKeys();
+        // A pointer's focus (reka focuses the thumb by script on a slide) is not the
+        // keyboard's, though `:focus-visible` may match it, and a key held through a
+        // click (Shift-click) must not make it one. The mark lives as long as the hand.
+        let pointed = false;
+        watch(isHeld, (held) => {
+            if (!held) pointed = false;
+        });
+        listen(host, [
+            ["pointerdown", () => { pointed = true; keyed.value = false; }],
+            // Only Tab moves focus as the keyboard's own act. A focus that arrives while
+            // some other key is down is a script's (an app shortcut's handler), and a
+            // focus with no key down is a script's or a pointer's
+            ["focusin", () => { keyed.value = !pointed && keysDown.has("Tab"); }],
+            ["keydown", (e) => {
+                const k = (e as KeyboardEvent).key;
+                if (k === "Escape") {
+                    // spent here when it disengages: the enclosing layer's dismiss reads
+                    // `defaultPrevented` (reka's DismissableLayer), so one Escape is one act
+                    if (keyed.value) e.preventDefault();
+                    keyed.value = false;
+                } else if (keys.has(k)) keyed.value = true;
+            }],
+            ["focusout", (e) => {
+                const to = (e as FocusEvent).relatedTarget as Node | null;
+                if (to && host()?.contains(to)) return;
+                keyed.value = false;
+            }],
+        ]);
+    }
+    if (o.hold || o.scrub) {
+        const heldOn = o.hold?.heldOn;
+        watch(
+            () => [isHeld.value, heldOn?.()] as const,
+            ([held, on]) => {
+                for (const x of [host(), ...(on ?? [])]) x?.toggleAttribute("data-held", held);
+            },
+            { flush: "post" },
+        );
+        // every modality grows in place (stage.ts, Q-3′ (i))
+        useEngageStage(host, isEngaged, () => o.stage?.() !== false);
+    }
+
+    // ── the scrub: a press that travels takes the control ───────────────────────
+    if (o.scrub) {
+        const sc = o.scrub;
+        const surface = (): Element | null => sc.surface?.() ?? host();
+        let x0 = 0;
+        let applied = 0;
+        let armed = false;
+        let pitch = 0;
+        const move = (e: PointerEvent): void => {
+            if (!armed) return;
+            const dx = e.clientX - x0;
+            if (!scrubbing.value) {
+                // the slop says the hand has taken the control; it is not the pitch
+                if (Math.abs(dx) < HOLD_SLOP_PX) return;
+                scrubbing.value = true;
+                window.getSelection()?.removeAllRanges();
+            }
+            e.preventDefault();
+            if (!pitch) return;
+            const n = Math.trunc(dx / pitch);
+            if (n !== applied) {
+                sc.step(n - applied);
+                applied = n;
+            }
+        };
+        const up = (): void => {
+            armed = false;
+            scrubbing.value = false;
+            window.removeEventListener("pointermove", move);
+            window.removeEventListener("pointerup", up);
+            window.removeEventListener("pointercancel", up);
+        };
+        listen(host, [
+            ["pointerdown", (e) => {
+                const p = e as PointerEvent;
+                if (p.button !== 0 || sc.disabled?.()) return;
+                const from = surface();
+                if (!from || !(p.target instanceof Node) || !from.contains(p.target)) return;
+                // the pitch, read at the press: registered `<length>` with initial 0, which no
+                // valid input computes to, so an unreadable one scrubs nothing and says so
+                const v = readOf(from, "--scrub-pitch", "px", { pseudo: null, ok: (n) => n > 0, who: "engage scrub" });
+                pitch = Number.isNaN(v) ? 0 : v;
+                armed = true;
+                x0 = p.clientX;
+                applied = 0;
+                window.addEventListener("pointermove", move, { passive: false });
+                window.addEventListener("pointerup", up);
+                window.addEventListener("pointercancel", up);
+            }],
+        ]);
+        onBeforeUnmount(up);
+    }
+
+    // ── the press ──────────────────────────────────────────────────────────────
+    if (o.press) {
+        const disabled = o.press.disabled;
+        const el = shallowRef<HTMLElement | null>(null);
+        const p = useLiquidPress({ el, disabled });
+        let written: string[] = [];
+        watch(
+            () => p.pressStyle.value,
+            (style) => {
+                const h = el.value;
+                if (!h) return;
+                const rec = style as Record<string, string>;
+                for (const k of written) if (!(k in rec)) h.style.removeProperty(k);
+                // under reduce the press keeps its light and drops its geometry
+                written = Object.keys(rec).filter((k) => k !== "scale" || !reduced());
+                for (const k of written) h.style.setProperty(k, rec[k]!);
+            },
+            { flush: "sync" },
+        );
+        // the mark is press.ts's, the one writer of `data-press`
+        usePressMark(host, { disabled });
+        listen(host, [
+            ["pointerdown", (e) => p.handlers.onPointerdown(e as PointerEvent)],
+            ["pointerenter", (e) => p.handlers.onPointerenter(e as PointerEvent)],
+            ["pointerup", () => p.handlers.onPointerup()],
+            ["pointercancel", () => p.handlers.onPointercancel()],
+            ["pointerleave", () => p.handlers.onPointerleave()],
+            ["keydown", (e) => p.handlers.onKeydown(e as KeyboardEvent)],
+            ["keyup", (e) => p.handlers.onKeyup(e as KeyboardEvent)],
+            ["blur", () => p.handlers.onBlur()],
+        ]);
+        onMounted(() => {
+            el.value = host();
+            // the press is JS-owned from here: the `:active` CSS floors stand down
+            el.value?.setAttribute("data-press-armed", "");
+        });
+    }
+
+    // ── the light press: a committing member without a press spring ─────────────
+    if (o.commit && !o.press) usePressMark(host, { organ: o.organ });
+
+    // ── the release, carried on the visible body ────────────────────────────────
+    if (o.drag) {
+        const d = o.drag;
+        useDragVelocity({
+            host: () => (d.enabled?.() === false ? null : host()),
+            mirror: d.mirror,
+            axis: d.axis,
+            onRelease: (v) => {
+                const body = d.body();
+                const h = host();
+                if (body && h && !reduced()) carry(h, body, d.axis(), v);
+            },
+        });
+    }
+
+    // ── a state member's mount frame, and the commit's loud read ────────────────
+    // `data-engage-arming` holds the host's transitions off until the first frame; there
+    // the door flushes style (the arrived state becomes the before-change style), lifts
+    // the mark, reads the commit's inputs, and watches `data-state` for every edge after,
+    // each read again: a token planted after mount is caught on the commit it degrades.
+    let edges: MutationObserver | null = null;
+    let arming = 0;
+    if (o.commit === "state") {
+        onMounted(() => {
+            const h = host();
+            if (!h) return;
+            h.setAttribute("data-engage-arming", "");
+            arming = requestAnimationFrame(() => {
+                arming = 0;
+                if (!h.isConnected) return;
+                // the arrived state becomes every held element's before-change style: the
+                // host's and its subtree's (a style read is scoped to the element it reads)
+                for (const e of [h, ...h.querySelectorAll("*")]) void getComputedStyle(e).transitionProperty;
+                h.removeAttribute("data-engage-arming");
+                const pops = commitsByClass(h);
+                readInputs(h, pops);
+                edges = new MutationObserver(() => readInputs(h, pops));
+                edges.observe(h, { attributes: true, attributeFilter: ["data-state"] });
+            });
+        });
+        onBeforeUnmount(() => {
+            if (arming) cancelAnimationFrame(arming);
+            edges?.disconnect();
+        });
+    }
+
+    // ── the stateless commit edge ──────────────────────────────────────────────
+    // The parity is stamped at mount (no before-change style, so nothing reads it as a
+    // commit) and flips on every activation, so a recipe keyed on it answers each one.
+    // It reads its inputs on its first frame, as a state member does at its arming frame.
+    let first = 0;
+    if (o.commit === "call") {
+        onMounted(() => {
+            const h = host();
+            if (!h) return;
+            h.setAttribute("data-commit", "a");
+            first = requestAnimationFrame(() => {
+                first = 0;
+                if (h.isConnected) readInputs(h, commitsByClass(h));
+            });
+        });
+        onBeforeUnmount(() => {
+            if (first) cancelAnimationFrame(first);
+        });
+    }
+    const commit = (): void => {
+        const h = host();
+        if (o.commit !== "call" || !h) return;
+        h.setAttribute("data-commit", h.getAttribute("data-commit") === "a" ? "b" : "a");
+        readInputs(h, commitsByClass(h));
+    };
+
+    return { isHeld, isEngaged, commit };
+}
