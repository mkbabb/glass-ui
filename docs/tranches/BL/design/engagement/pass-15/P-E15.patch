+}
+
+/** No engagement veils the world (O-103d (5)): the stage creates no veil element. */
+const noVeil = (): void => {
+    expect(document.querySelector(".glass-focus-veil")).toBeNull();
+};
+
+
+// ── happy-dom lays nothing out and runs no rendering steps ─────────────────────────────
+// The frame and its resize step are played by hand (`paint`), for every box observed in it.
+// Every box paints at its own (zero) rect plus the translates the engine is asked for: a
+// paused probe (`fill: "both"`) while it lives, a glide at its first frame (progress 0) until
+// a case finishes it. A case that needs a laid-out host gives it a layout and a map (`painting`).
+const steps = new Set<{ cb: ResizeObserverCallback; boxes: Set<Element> }>();
+class FrameResizeObserver {
+    private readonly own: { cb: ResizeObserverCallback; boxes: Set<Element> };
+    constructor(cb: ResizeObserverCallback) {
+        this.own = { cb, boxes: new Set() };
+        steps.add(this.own);
+    }
+    observe(el: Element) {
+        this.own.boxes.add(el);
+    }
+    unobserve(el: Element) {
+        this.own.boxes.delete(el);
+    }
+    disconnect() {
+        steps.delete(this.own);
+    }
+}
+/** One animation frame and its resize step. */
+const paint = async (): Promise<void> => {
+    await new Promise<void>((ok) => requestAnimationFrame(() => ok()));
+    for (const s of [...steps]) if (s.boxes.size) s.cb([], s as unknown as ResizeObserver);
+};
+/** A released host's exit: past its bound (an unread clock bounds it at the release), then a frame. */
+const settled = async (): Promise<void> => {
+    await new Promise((r) => setTimeout(r, 0));
+    await paint();
+};
+type Map2 = { a: number; b: number; c: number; d: number };
+const ID: Map2 = { a: 1, b: 0, c: 0, d: 1 };
+const rotate = (deg: number, s = 1): Map2 => {
+    const r = (deg * Math.PI) / 180;
+    return { a: s * Math.cos(r), b: -s * Math.sin(r), c: s * Math.sin(r), d: s * Math.cos(r) };
+};
+const rect = (l: number, t: number, w: number, h: number) =>
+    ({ left: l, top: t, right: l + w, bottom: t + h, width: w, height: h, x: l, y: t, toJSON: () => ({}) }) as DOMRect;
