+/** The stylesheet's figures the stage reads (happy-dom loads no stylesheet), on every box. */
+function withTokens(v: Record<string, string> = { "--scale-engage": "1.06", "--space-section": "20px", "shape-margin": "20px" }) {
+    const native = window.getComputedStyle;
+    return vi.spyOn(window, "getComputedStyle").mockImplementation((el, p) => {
+        const cs = native(el, p);
