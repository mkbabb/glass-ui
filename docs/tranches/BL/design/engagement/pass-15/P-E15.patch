+        const r = nativeRect.call(this);
+        let x = 0;
+        let y = 0;
+        for (const p of probesOf.get(this) ?? []) {
+            x += p[0];
+            y += p[1];
+        }
+        return rect(r.left + x, r.top + y, r.width, r.height);
+    };
+});
