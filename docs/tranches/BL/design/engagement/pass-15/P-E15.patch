@@ -0,0 +1,398 @@
+/* utilities/engage.css — ONE RECIPE PER ENGAGEMENT CLASS.
+ *
+ * `ENGAGE_DECLARATION` (composables/motion/engage/engageClasses.ts) says what each
+ * component directory is; this file says what each class does. A member composes its
+ * class's utility on the element it paints, and every utility stamps its class as the
+ * registered `--rung-class` (tokens/property-regs.css), which the runtime census reads
+ * to prove the member composes the recipe its row declares. Where a class's answer
+ * belongs to a substrate that already paints the member (the field's focus paint, the
+ * sortable row's fill, the modal veil), the substrate keeps it and the utility stamps.
+ *
+ * THE PRESS IS NEVER A CLASS'S GEOMETRY. A member presses in LIGHT on its own paint,
+ * or by script where the engage door owns the press (`useEngage`: the Button's squish
+ * on the one `--press-t` drive). No recipe here writes `scale` for a press, and none
+ * sets `scale: none` to silence another class. `.tap-squish` and `.interactive-item`
+ * are deleted. `.glass-capsule-hover` keeps its hover lift and press snap
+ * (glass/glass-capsule.css), and no engagement member composes it: its one composer is
+ * the dock's `DockControl`, whose press and hover are D2's. The harness drives every
+ * composer outside the dock (E-12 `capsule`), so this sentence is a cell, not a claim.
+ *
+ * THE COMMIT IS A GEOMETRIC POP (CK-02 arm ii: this build answers Q-5 the other way,
+ * and is admissible only on the owner's ruling, which amends the spring table's law,
+ * springPresets.ts). `c` (`--rung-commit`) rides the `panel` spring from 0 to 1 on the
+ * commit edge (state on, open, or the parity "b") and back on the release edge; the face
+ * scales by `1 + (crest − 1)·sin(π·c)`: a crest at c = ½, rest at c = 1, and a rebound
+ * below rest while `panel` overshoots c past 1. Registered numbers, not keyframes, so a
+ * member that MOUNTS committed pops nothing and a re-commit mid-flight retargets. The
+ * pop rides `transform` and the door's press rides `scale`, so neither masks the other.
+ * The crest is a scale-register row with its reason (tokens/scale-paper.css): the press
+ * mirrored about rest (`--scale-commit-pop`) on a face whose committed state shows the
+ * commit, and the ladder's engaged rung (`--scale-engage`) on a stateless command and on
+ * the 20 px control bit.
+ *
+ * THE POP IS A LEG IN THE MEMBER'S OWN LIST. `transition` is a shorthand, so a class that
+ * wrote one would replace every leg its member declares (a selectable Card's fill and
+ * press, the tabs strip's background: D5 pass 2 C-A2 §0 item 6). The pop's transform and
+ * its one-leg list sit at zero specificity in the components layer; a member that keeps
+ * its own list lists the pop's leg in it (button, chip, toggle item, the disclosure
+ * recipe below), and a member whose list carries no pop leg simply does not pop.
+ *
+ * UNDER REDUCED MOTION THE COMMIT IS AN INSTANT STATE CHANGE (O-103d (1)). The pop
+ * retires with no scale and no translate, and nothing stands in for it: the commit is
+ * legible through the face's own state (the switch's fill and thumb, the check, the
+ * dot, the selected fill, the open region). Light is not the commit's form on either
+ * path, so no seat, envelope row or authorization carries a commit light. ONE mechanism
+ * holds it: the library's instant fallback (utilities/a11y-overrides.css) zeroes the
+ * `--rung-commit` leg's clock, so `c` lands on its endpoint in the frame the state
+ * changes and the face paints at rest scale (sin 0 = 0; sin π vanishes to the scale
+ * read's last digit). This file states no reduce arm of its own for the pop: a second
+ * guarantee would keep the cells green with either one removed (D5 pass 6 C-E6 §0.4).
+ *
+ * Clocks: geometry on the spring table's generated tokens, light (the press, the
+ * engaged wash) on the envelope table's (`--engage-*`). */
+
+@property --rung-commit {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+@property --rung-grow {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+/* The pop's crest, computed to a number (its rows are `calc()`s and `var()`s). Any number
+   is a crest: 1 is no pop, a consumer's own value (a `--scale-press: 1` mirrors to a
+   `--scale-commit-pop` of 1). A row that does not resolve computes the ident
+   `stage-unset`, which no number equals, so the pop's `calc()` is invalid there (no
+   scale) and the engage door says so by name (`useEngage` readInputs, CK-21). */
+@property --rung-crest {
+    syntax: "<number> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+/* The scrub's PITCH (the engage door's `scrub`): the travel that moves a scrubbed value
+   one step, set on the scrub's surface. Its own figure, never the hand's slop: the slop
+   (`HOLD_SLOP_PX`) says the hand has taken the control, the pitch says how far one step
+   is. Registered `<length>`, so a font-relative value (`1ch`, one glyph cell of the value)
+   computes to px where it is set; its initial value 0 is no valid pitch, so an unset or
+   unreadable one scrubs nothing and the door says so (CK-21). */
+@property --scrub-pitch {
+    syntax: "<length>";
+    inherits: false;
+    initial-value: 0px;
+}
+
+/* THE ENGAGEMENT'S READS (settle.ts `readOf`). Each token the engagement's script reads is
+   a registered property DECLARED here, on its member's class, as the expression the
+   library's own consumer computes, and the script reads it back with `getComputedStyle`
+   and writes nothing. The declarations sit on the class's `::before`, which inherits every
+   custom property from its host, so the expression computes there as it does on the host,
+   and which the host's own `transition` list does not reach (a consumer's
+   `transition: all` on the host cannot delay the read). The rules carry custom properties
+   only and generate no box. Each syntax is `<type> | stage-unset`, initial `stage-unset`: a
+   form the consumer's expression refuses computes to the ident, which no value equals, and
+   the script says so by name. Private names, outside `--engage-*`. */
+@property --stage-read-grow {
+    syntax: "<number> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-clock {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-exit-clock {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-panel {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-gutter {
+    syntax: "<length-percentage> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-press-drain-attack {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-press-drain-release {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-medium-exit-attack {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-medium-exit-release {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-control-engage-attack {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-control-engage-release {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-signal-decay-attack {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+@property --stage-read-signal-decay-release {
+    syntax: "<time> | stage-unset";
+    inherits: false;
+    initial-value: stage-unset;
+}
+
+/* The declared reads, in the components layer (every rule the library ships sits in a layer). */
+@layer components {
+    /* The page gutter the stage's reach clears (`--space-section`), resolved where the
+       viewport's lengths resolve: the reach clears the viewport's edges. */
+    :root::before {
+        --stage-read-gutter: var(--space-section);
+    }
+
+    /* The held rung's reads: the grow's own block-axis expression at `--rung-grow` 1 (the
+       reach's cap), the clock its glides and its release carry run on, the `dock` row's
+       duration as `engage-held` transitions on it, and the clock its grow returns on at
+       release, which bounds the released host's exit (root-substituted, scheme-spring.css). */
+    .engage-held::before {
+        --stage-read-grow: calc(1 + (var(--scale-engage) - 1) * 1);
+        --stage-read-clock: var(--spring-dock-duration);
+        --stage-read-exit-clock: var(--spring-dock-exit-duration);
+    }
+
+    /* The commit's clock, on the members that pop (the pop's transition below). */
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed)::before {
+        --stage-read-panel: var(--spring-panel-duration);
+    }
+
+    /* The envelope table's clocks (`ENGAGE_ENVELOPES`, tokens/motion-registers.css), one read
+       per role and edge, on every member the door reads them for. */
+    :where(.engage-pressed, .engage-chosen, .engage-disclosed, .engage-held, .engage-dragged)::before {
+        --stage-read-press-drain-attack: var(--engage-press-drain-attack);
+        --stage-read-press-drain-release: var(--engage-press-drain-release);
+        --stage-read-medium-exit-attack: var(--engage-medium-exit-attack);
+        --stage-read-medium-exit-release: var(--engage-medium-exit-release);
+        --stage-read-control-engage-attack: var(--engage-control-engage-attack);
+        --stage-read-control-engage-release: var(--engage-control-engage-release);
+        --stage-read-signal-decay-attack: var(--engage-signal-decay-attack);
+        --stage-read-signal-decay-release: var(--engage-signal-decay-release);
+    }
+}
+
+/* PRESSED — an action with no state (button, action chip). The press is the member's
+   light or the door's script press; the commit edge is the door's parity
+   (`data-commit` "a" ↔ "b", `useEngage` `commit: "call"`). */
+@utility engage-pressed {
+    --rung-class: pressed;
+}
+
+/* CHOSEN — a control with a committed state (switch, checkbox, radio, selectable chip,
+   toggle item, segmented tabs). The press is LIGHT on the member's own paint; the
+   commit is the pop below, or, where the member has a travelling body (the tabs'
+   indicator), that body's travel on its own row. */
+@utility engage-chosen {
+    --rung-class: chosen;
+}
+
+/* DISCLOSED — a trigger that opens a region (accordion, collapsible, popover, select,
+   menu). A row-width target answers a press in LIGHT only (a full-width squish reads
+   as the row collapsing), on the press envelope's attack; it commits by the pop below
+   when the region opens and when it closes. Its hover is the substrate's
+   (components/_shared/disclosure/disclosure.css), under `(hover: hover)`.
+   The press is a WASH, not a slab: a press is a transient pointer answer, which is the
+   fill ladder's `--fill-hover` rung (tokens/color-radius.css §1.3), summed over the
+   hover's own `--fill-hover` wash so the press deepens the hover; `--fill-selected` is
+   persistent state, and at 12 % across a 320 px row it read as an opaque grey bar
+   (D5 pass 3 C-A3 §3 item 2). It keys on the door's press mark (`data-press`), which
+   lands on `pointerdown`, not on `:active` (composables/motion/engage/useEngage.ts). */
+@utility engage-disclosed {
+    --rung-class: disclosed;
+    transition:
+        --rung-commit var(--spring-panel-duration) var(--spring-panel),
+        background-color var(--engage-press-drain-release) var(--ease-standard),
+        color var(--duration-control) var(--ease-standard),
+        box-shadow var(--duration-control) var(--ease-standard);
+
+    &[data-press]:not(:disabled, [data-disabled]) {
+        background-color: color-mix(
+            in oklab,
+            var(--foreground) calc(var(--fill-hover) * 200%),
+            transparent
+        );
+        transition-duration:
+            var(--spring-panel-duration), var(--engage-press-drain-attack),
+            var(--duration-control), var(--duration-control);
+    }
+
+    /* The press is the hover rung's ink and the press rung's, summed (one mix, no nested
+       endpoint): on a pointer that hovers it lands on the hover wash and DEEPENS it, the
+       hand going down and the row taking more ink, never less (D5 pass 4 C-A4 §0 item 3:
+       a press at 0.05 under a hover at 0.15 un-painted the row); on a touch, which has
+       no hover, it is the same transient ink, which a held touch can tell from the
+       sticky hover a tap leaves (E-5). A plate member (the select trigger) hovers on the
+       plate's own rung, so its press inks over that rung rather than replacing it. */
+    @media (hover: hover) {
+        &.control-surface[data-press]:hover:not(:disabled, [data-disabled]) {
+            background-color: color-mix(
+                in oklab,
+                var(--foreground) calc(var(--fill-hover) * 100%),
+                var(--control-surface-bg-hover)
+            );
+        }
+    }
+
+    /* FL-3: under forced colours the system palette owns the fill, so the wash would
+       compute Canvas and the press would vanish; the press is the system's Highlight
+       ring instead, the disclosure's own focus idiom (disclosure.css). Under reduced
+       transparency the wash stays: it is an opaque-ink rung, not a material. */
+    @media (forced-colors: active) {
+        &[data-press]:not(:disabled, [data-disabled]) {
+            outline: 2px solid Highlight;
+            outline-offset: -2px;
+        }
+    }
+}
+
+/* HELD — a control the hand holds (slider, number-field scrub, timeline, the dock's
+   controls). The ENGAGED rung is the stage's (composables/motion/engage/stage.ts): the
+   door's engagement (the hand down, or a key that brought the focus or acts on it)
+   engages the host where it stands, in flow, under every modality (Q-3′ (i)), and this
+   recipe is its grow: to
+   `--scale-engage` (the ladder's engaged row) on the block axis, and inline to the reach
+   the stage computes from the page gutter (`--stage-reach`, glass/engage-stage.css), on
+   the `dock` row, leaving on the row's exit clock. A host off the stage reads reach 0 and
+   rests at ×1, because `--rung-grow` is 0 there. Every pointer: the gutter cap is what
+   keeps a phone's full-width control inside the page. */
+@utility engage-held {
+    --rung-class: held;
+    scale: calc(1 + (var(--stage-reach) - 1) * var(--rung-grow))
+        calc(1 + (var(--scale-engage) - 1) * var(--rung-grow));
+    transform-origin: center;
+    /* the host's ink leg rides with the grow: the slider lane (unlayered) declares no
+       transition of its own, so this list is the host's one */
+    transition:
+        --rung-grow var(--spring-dock-exit-duration) var(--spring-dock),
+        color var(--duration-fast) var(--ease-standard);
+
+    &[data-engaged] {
+        --rung-grow: 1;
+        transition-duration: var(--spring-dock-duration), var(--duration-fast);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        scale: none;
+    }
+
+    /* FL-3: the grow is geometry, which neither forced colours nor reduced transparency
+       repaints, so it stays under both; the control's own fills take the system palette
+       (slider/styles.css). */
+}
+
+/* DRAGGED — a surface the hand moves, whose job is momentum (the door's release rule).
+   Its press is the substrate's light rule; the utility stamps the class. */
+@utility engage-dragged {
+    --rung-class: dragged;
+}
+
+/* PRESENTED — a surface raised over the page (dialog, sheet, toast, tooltip). Its rung
+   is the modal one, and its paint is the veil's: the scrim keys on its overlay's open
+   state (glass/focus-veil.css), never on `data-engaged`. The utility stamps the class
+   on the presented plate. */
+@utility engage-presented {
+    --rung-class: presented;
+}
+
+/* FIELD — text entry. Its engagement is focus, painted by the field substrate
+   (components/_shared/field/control.css); the utility stamps the class. */
+@utility engage-field {
+    --rung-class: field;
+}
+
+/* AMBIENT — a field that answers the pointer's presence (aurora, blob, constellation,
+   the fourier field, the staff). Its rung is REST: the member's own field moves with
+   the pointer, and the utility stamps the class on the field's root. */
+@utility engage-ambient {
+    --rung-class: ambient;
+}
+
+/* STATIC — no input of its own. The class carries no rung; composing it is the
+   member's declaration that it was classified, read at runtime like any other. */
+@utility engage-static {
+    --rung-class: static;
+}
+
+@layer components {
+    /* THE COMMIT'S POP: zero specificity, so a member's own `transform` and its own
+       transition list win; such a member lists the pop's leg itself. */
+    :where(.engage-chosen, .engage-pressed, .engage-disclosed) {
+        --rung-crest: var(--scale-commit-pop);
+        transform: scale(calc(1 + (var(--rung-crest) - 1) * sin(var(--rung-commit) * 180deg)));
+        transform-origin: center;
+        transition: --rung-commit var(--spring-panel-duration) var(--spring-panel);
+    }
+
+    /* the engaged rung: a stateless command (its pop is its whole commit) and the 20 px
+       control bit (the held thumb's size) */
+    :where(.engage-pressed, .engage-chosen.control-bit) {
+        --rung-crest: var(--scale-engage);
+    }
+
+    /* committed: the state on, open, or the parity "b" */
+    :where(.engage-chosen, .engage-disclosed):where([data-state="checked"], [data-state="on"], [data-state="open"]),
+    :where(.engage-pressed):where([data-commit="b"]) {
+        --rung-commit: 1;
+    }
+}
+
+@layer components {
+    /* ── THE MOUNT FRAME (the one-frame commit arming) ──────────────────────────────
+       The engage door (composables/motion/engage/useEngage.ts) marks its host
+       `data-engage-arming` from mount until the first frame, where it flushes style
+       and lifts the mark. Until then nothing under the host transitions, so a state
+       that arrives with the mount (an async model set in the mount's own task, even
+       after something read style) is the rest the host mounts in, not a commit
+       (CK-03). Only `transition-property` is held: a duration or an authorization is
+       untouched, and an animation (an entrance keyframe) is not a transition. The
+       theme flip's `html.no-transition` (a11y-overrides.css) is the same idiom for
+       a different moment. */
+    [data-engage-arming],
+    [data-engage-arming] *,
+    [data-engage-arming]::before,
+    [data-engage-arming]::after,
+    [data-engage-arming] *::before,
+    [data-engage-arming] *::after {
+        transition-property: none !important;
+    }
+}
diff --git a/tests/components/custom/aurora/Aurora.cursor-writer.test.ts b/tests/components/custom/aurora/Aurora.cursor-writer.test.ts
new file mode 100644
index 000000000..2a232de3d
--- /dev/null
+++ b/tests/components/custom/aurora/Aurora.cursor-writer.test.ts
@@ -0,0 +1,65 @@
+import { mount } from "@vue/test-utils";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+// The field's cursor has ONE writer (D5 pass 7, CK-22): the root's presence leg writes it
+// until a consumer drives it through the exposed API, and the consumer's first write takes
+// it for the mount's life. keyframes.js (`HeroAurora.vue`) and value.js (`useAtmosphere.ts`)
+// drive it from window listeners; before this, every pointer move over the root gave the
+// field two writers in two pointer spaces (D5 pass 6 C-E6 §0.5).
+const calls = vi.hoisted(() => [] as [string, ...unknown[]][]);
+
+vi.mock("@glass/components/aurora/composables/useAurora", async () => {
+    const { ref } = await vi.importActual<typeof import("vue")>("vue");
+    return {
+        useAurora: () => ({
+            setCursor: (...a: unknown[]) => calls.push(["set", ...a]),
+            clearCursor: () => calls.push(["clear"]),
+            setCursorRadius: () => undefined,
+            renderAt: () => undefined,
+            pause: () => undefined,
+            resume: () => undefined,
+            isArmed: ref(false),
+            isSettled: ref(false),
+            rendererStatus: ref({ phase: "ready" as const, engine: "css" as const, adapter: "Static paint" }),
+        }),
+    };
+});
+
+vi.mock("@glass/components/aurora/composables/auroraFallbackGround", () => ({
+    auroraFallbackGround: () => ({ backgroundImage: "none", backgroundColor: "#123" }),
+}));
+
+import Aurora from "@glass/components/aurora/Aurora.vue";
+
+type Exposed = { setCursor: (x: number, y: number, s?: number) => void; clearCursor: () => void };
+
+const sized = (el: Element): void => {
+    (el as HTMLElement).getBoundingClientRect = () =>
+        ({ left: 0, top: 0, width: 200, height: 100, right: 200, bottom: 100, x: 0, y: 0, toJSON: () => ({}) }) as DOMRect;
+};
+
+describe("Aurora · one cursor writer", () => {
+    afterEach(() => void calls.splice(0));
+
+    it("the root's presence leg writes the cursor while no consumer drives it", async () => {
+        const w = mount(Aurora, { props: { renderMode: "css" } });
+        const root = w.get(".aurora-root");
+        sized(root.element);
+        await root.trigger("pointermove", { clientX: 50, clientY: 25 });
+        await root.trigger("pointerleave");
+        expect(calls).toEqual([["set", 0.25, 0.25], ["clear"]]);
+        w.unmount();
+    });
+
+    it("a consumer's write takes the cursor: the root leg stands down for the mount's life", async () => {
+        const w = mount(Aurora, { props: { renderMode: "css" } });
+        const root = w.get(".aurora-root");
+        sized(root.element);
+        (w.vm as unknown as Exposed).setCursor(0.9, 0.1, 0.6);
+        await root.trigger("pointermove", { clientX: 50, clientY: 25 });
+        await root.trigger("pointerleave");
+        (w.vm as unknown as Exposed).clearCursor();
+        expect(calls).toEqual([["set", 0.9, 0.1, 0.6], ["clear"]]);
+        w.unmount();
+    });
+});
diff --git a/tests/components/engage-adoption.test.ts b/tests/components/engage-adoption.test.ts
new file mode 100644
index 000000000..8fbd93aea
--- /dev/null
+++ b/tests/components/engage-adoption.test.ts
@@ -0,0 +1,88 @@
+// D5 pass 3 (P-A3), CK-03 and CK-21 on route A's members: every state member of a committing
+// class goes through the engage door with `commit: "state"`, so its host carries the mount
+// frame (`data-engage-arming`) from mount to the first frame. A member that skipped the door
+// would glide or light on an in-task arrival after a style read (the D5 battery's
+// `arrival·ownflush` cell); this reads the adoption at the source of the behaviour, the
+// rendered host. The paint is the battery's.
+
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, type Component } from "vue";
+import { describe, expect, it } from "vitest";
+
+import { Switch } from "@glass/components/switch";
+import { Checkbox } from "@glass/components/checkbox";
+import { RadioGroup, RadioGroupItem } from "@glass/components/radio-group";
+import { Chip } from "@glass/components/chip";
+import { ToggleGroup, ToggleGroupItem } from "@glass/components/toggle-group";
+import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@glass/components/accordion";
+import { SegmentedTabs } from "@glass/components/tabs";
+import { Popover, PopoverTrigger } from "@glass/components/popover";
+import { Button } from "@glass/components/button";
+import { Collapsible, CollapsibleTrigger } from "@glass/components/collapsible";
+import { Select, SelectTrigger, SelectValue } from "@glass/components/select";
+import { DropdownMenu, DropdownMenuTrigger } from "@glass/components/menu";
+
+const frame = (): Promise<void> => new Promise((ok) => requestAnimationFrame(() => ok()));
+
+const MEMBERS: Array<[string, () => ReturnType<typeof h>, string]> = [
+    ["switch", () => h(Switch), '[data-slot="switch"]'],
+    ["checkbox", () => h(Checkbox), '[data-slot="checkbox"]'],
+    ["radio", () => h(RadioGroup, { defaultValue: "a" }, () => [h(RadioGroupItem, { value: "a" })]), '[data-slot="radio-group-item"]'],
+    ["chip (selectable)", () => h(Chip as Component, { mode: "selectable" }, () => "Chip"), ".engage-chosen"],
+    ["toggle item", () => h(ToggleGroup, { type: "single" }, () => [h(ToggleGroupItem, { value: "a" }, () => "A")]), '[data-slot="toggle-group-item"]'],
+    [
+        "accordion trigger",
+        () =>
+            h(Accordion, { type: "single", collapsible: true }, () => [
+                h(AccordionItem, { value: "one" }, () => [h(AccordionTrigger, () => "One"), h(AccordionContent, () => "Body")]),
+            ]),
+        '[data-slot="accordion-trigger"]',
+    ],
+    ["collapsible trigger", () => h(Collapsible, () => [h(CollapsibleTrigger, () => "More")]), '[data-slot="collapsible-trigger"]'],
+    ["select trigger", () => h(Select, () => [h(SelectTrigger, () => [h(SelectValue, { placeholder: "Pick" })])]), '[data-slot="select-trigger"]'],
+    ["dropdown trigger", () => h(DropdownMenu, () => [h(DropdownMenuTrigger, () => "Menu")]), '[data-slot="menu-trigger"]'],
+    ["popover trigger", () => h(Popover, () => [h(PopoverTrigger, () => "Open")]), '[aria-haspopup="dialog"]'],
+    ["segmented tabs", () => h(SegmentedTabs, { modelValue: "a", options: [{ label: "A", value: "a" }, { label: "B", value: "b" }], ariaLabel: "t" }), ".segmented-tabs"],
+];
+
+describe("route A's state members hold the mount frame through the door (CK-03)", () => {
+    for (const [name, render, sel] of MEMBERS) {
+        it(`${name}: armed at mount, lifted after the first frame`, async () => {
+            const w = mount(defineComponent({ setup: () => render }), { attachTo: document.body });
+            await nextTick();
+            const host = w.element.ownerDocument.querySelector(sel) as HTMLElement | null;
+            expect(host, `${name} rendered no ${sel}`).not.toBeNull();
+            expect(host!.hasAttribute("data-engage-arming")).toBe(true);
+            await frame();
+            await frame();
+            expect(host!.hasAttribute("data-engage-arming")).toBe(false);
+            w.unmount();
+        });
+    }
+});
+
+
+describe("the popover trigger stamps its class on either path (CK-01)", () => {
+    const classesOf = (asChild: boolean, child: () => ReturnType<typeof h>): string[] => {
+        const w = mount(
+            defineComponent({ setup: () => () => h(Popover, () => [h(PopoverTrigger, { asChild }, child)]) }),
+            { attachTo: document.body },
+        );
+        const el = w.element.ownerDocument.querySelector('[aria-haspopup="dialog"]') as HTMLElement;
+        const out = [...el.classList].filter((c) => c.startsWith("engage-"));
+        w.unmount();
+        return out;
+    };
+
+    it("its own button is disclosed", () => {
+        expect(classesOf(false, () => h("span", "Open"))).toEqual(["engage-disclosed"]);
+    });
+
+    it("as-child, a plain element it merges onto is disclosed", () => {
+        expect(classesOf(true, () => h("span", { tabindex: 0 }, "Open"))).toEqual(["engage-disclosed"]);
+    });
+
+    it("as-child over a library Button, the Button carries one class, the disclosure's", () => {
+        expect(classesOf(true, () => h(Button, () => "Open"))).toEqual(["engage-disclosed"]);
+    });
+});
diff --git a/tests/components/engage-light-press.test.ts b/tests/components/engage-light-press.test.ts
new file mode 100644
index 000000000..6a2761651
--- /dev/null
+++ b/tests/components/engage-light-press.test.ts
@@ -0,0 +1,165 @@
+// D5 pass 4 (P-A4), CK-06 and CK-25 on route A's members: a committing member that presses in
+// LIGHT keys that light on the door's press mark (`data-press`, written on `pointerdown` by
+// engage/press.ts), not on `:active`, which a touch long-press sets only 175-200 ms in. The
+// mark lands on the member's host, or on the organ a strip names (the tab the press hit).
+// The sheets read the mark, and only the dock triggers' slop survives the forced-colours arm.
+// The paint is the battery's (E-5, E-12, the capture).
+
+import { mount } from "@vue/test-utils";
+import { defineComponent, h, nextTick, type Component } from "vue";
+import { describe, expect, it } from "vitest";
+import fs from "node:fs";
+import path from "node:path";
+
+import { Switch } from "@glass/components/switch";
+import { ToggleGroup, ToggleGroupItem } from "@glass/components/toggle-group";
+import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@glass/components/accordion";
+import { SegmentedTabs } from "@glass/components/tabs";
+import { Chip } from "@glass/components/chip";
+import { Card } from "@glass/components/card";
+import { Button } from "@glass/components/button";
+import { ENGAGE_ENVELOPES } from "@glass/composables/motion/engage/engageEnvelopes";
+
+const SRC = path.resolve(__dirname, "../../src");
+const read = (p: string): string => fs.readFileSync(path.join(SRC, p), "utf8");
+
+const down = (el: Element): void => {
+    el.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true, button: 0 }));
+};
+const up = (el: Element): void => {
+    el.dispatchEvent(new PointerEvent("pointerup", { bubbles: true, button: 0 }));
+};
+
+const MEMBERS: Array<[string, () => ReturnType<typeof h>, string]> = [
+    ["switch", () => h(Switch), '[data-slot="switch"]'],
+    ["toggle item", () => h(ToggleGroup, { type: "single" }, () => [h(ToggleGroupItem, { value: "a" }, () => "A")]), '[data-slot="toggle-group-item"]'],
+    [
+        "accordion trigger",
+        () =>
+            h(Accordion, { type: "single", collapsible: true }, () => [
+                h(AccordionItem, { value: "one" }, () => [h(AccordionTrigger, () => "One"), h(AccordionContent, () => "Body")]),
+            ]),
+        '[data-slot="accordion-trigger"]',
+    ],
+    ["chip (selectable)", () => h(Chip as Component, { mode: "selectable" }, () => "Chip"), ".engage-chosen"],
+    // D5 pass 5 (P-A5): the members that still pressed on `:active` (CK-17's naming half)
+    ["card (selectable)", () => h(Card as Component, { selected: false }, () => "Card"), '[role="option"]'],
+    ["button (quiet)", () => h(Button as Component, { emphasis: "quiet" }, () => "Go"), "button"],
+];
+
+describe("a light press is the door's mark, from pointerdown (CK-06)", () => {
