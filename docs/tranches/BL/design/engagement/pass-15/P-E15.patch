+        expect(hover).toMatch(/&\.control-surface\[data-press\]:hover:not\(:disabled, \[data-disabled\]\) \{\s*background-color: color-mix\(\s*in oklab,\s*var\(--foreground\) calc\(var\(--fill-hover\) \* 100%\),\s*var\(--control-surface-bg-hover\)/);
+        // the hover it deepens is the same transient rung, never the plate's slab
