+        } as unknown as Animation;
+        g.a = a;
+        glides.push(g);
+        return a;
+    }) as unknown as HTMLElement["animate"];
+    return {
+        at,
+        sc,
+        glides,
+        probes,
+        land: () => glides.forEach((g) => (g.progress = 1)),
+        restore: () => {
+            for (const k of ["scrollTop", "scrollLeft", "scrollHeight", "clientHeight", "scrollWidth", "clientWidth"]) delete (root as unknown as Record<string, unknown>)[k];
+        },
+    };
