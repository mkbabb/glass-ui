+<script setup lang="ts">
+import { ref } from "vue";
+import { cn } from "../_shared/class-names";
+import { useEngage } from "../../composables/motion/engage/useEngage";
+
+/**
+ * <ConfiguratorPresetChip> — one chip of the Configurator's default preset gallery: an
+ * `aria-pressed` toggle, so a `chosen` member (`engage-chosen`, the configurator's
+ * `modes` row in `ENGAGE_DECLARATION`). Its committed state is the active preset
+ * (`data-state="on"`), which pops on the class's crest; its press is light on its own
+ * paint, keyed on the door's press mark; its hover is the capsule's ink
+ * (configurator/styles.css). The warm-glass cel is `.glass-capsule`; the capsule's hover
+ * lift and press snap (`.glass-capsule-hover`) are the dock's geometry and are not
+ * composed here.
+ */
+const props = defineProps<{ active: boolean }>();
+
+const el = ref<HTMLElement | null>(null);
+
+/* The engage door holds the mount frame (`commit: "state"`): the active preset a gallery
+ * mounts with is its rest, never a commit, and the commit's tokens are read loudly on
+ * every `data-state` edge (CK-03, CK-21). It marks the press (`data-press`); it paints
+ * nothing. */
+useEngage(() => el.value, { commit: "state" });
+</script>
+
+<template>
+    <button
+        ref="el"
+        type="button"
+        data-preset-tile
+        :data-active="props.active || undefined"
+        :data-state="props.active ? 'on' : 'off'"
+        :aria-pressed="props.active"
+        :class="
+            cn(
+                // `shadow-cartoon` adds the static technicolor cel cast (a direct
+                // box-shadow utility: the cast is static on a chip, not the moving
+                // inert-child caster).
+                'configurator-preset-chip glass-capsule engage-chosen shadow-cartoon focus-ring shrink-0 px-3 py-1 text-micro font-medium text-foreground',
+                props.active && 'is-active',
+            )
+        "
+    >
+        <slot />
+    </button>
+</template>
