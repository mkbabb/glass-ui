+  const feasible = ladders.filter((l) => l.feasible);
+  const chosen = (feasible.length ? feasible : ladders.filter((l) => l.rows.every((r) => r.best))).reduce((a, b) => (b.meanT > a.meanT ? b : a), { meanT: -1 });
