+#!/usr/bin/env node
+// solve.mjs · the calibrated-ladder solve over rendered, filtered corpus backdrops (backdrops.mjs).
+//
+// Variables per theme: the pole P (one colour, searched along the theme card's hue in OKLCh lightness), the muted
+// ink (the M-4 register floor: the fg lightness ± dl, or HEAD's ink), and per level the veil alpha, the blur radius
+// r ≤ F48's cap for the level, and the saturate s.
+// Constraints, all read on C = α·P + (1 − α)·B(r, s), B the engine's filtered backdrop:
+//   M-2  fg and muted p05 ≥ --target (the gate is 4.5; the margin is the difference) on the 1 px glyph ring, every corpus field of the level's band;
+//   M-8  (chrome) bleed ≤ --bleed (the gate is 1.25; the margin is the difference) and chroma ≤ 0.04 over the stripes;
+//   M-6  adjacent composites over the theme's paper ≥ sep, and (dark) every plate ≥ 0.05 from the page;
+//   M-1  (light) every composite over paper L ≥ L_paper − 0.01 and ΔE ≤ 0.02.
+// Objective: maximise transmission T = 1 − α (per level: least α; per theme: the pole with the highest mean T whose
+// ladder is feasible; a theme with no feasible pole emits its best-T pole and names the violated rows).
+// The M-2 pass set of every ring pixel is upward-closed in α once the pole sits on the far side of the ink from the
+// ground, so the p05 predicate is monotone and bisection is sound; a pole illegible under the ink at α = 1 is rejected.
+//   node solve.mjs <bddir> [--band as-written|banded] [--cap f48|head] [--ink head|floor] [--dl 0.10] [--sep 0.012]
+//        [--target 4.5] [--bleed 1.25] [--json out.json] [--tag chromium-metal] [--poles-light 0.985,...] [--poles-dark 0.05,...]
+import fs from "node:fs";
+import path from "node:path";
+import { parseArgs } from "node:util";
+import { geometry, loadB, ringP05, calm, flatComposite, bisect, lch, dE, hex, oklab, oklchToRgb, hslToRgb } from "./solve-lib.mjs";
+
+const { values: o, positionals } = parseArgs({ allowPositionals: true, strict: false, options: {
+  band: { type: "string" }, cap: { type: "string" }, ink: { type: "string" }, dl: { type: "string" }, sep: { type: "string" },
+  target: { type: "string" }, bleed: { type: "string" }, json: { type: "string" }, tag: { type: "string" }, "poles-light": { type: "string" }, "poles-dark": { type: "string" },
+  sats: { type: "string" }, themes: { type: "string" }, radii: { type: "string" } } });
+const dir = positionals[0], tag = o.tag || "chromium-metal";
+const band = o.band || "as-written", capMode = o.cap || "f48", inkMode = o.ink || "floor";
+const DL = +(o.dl || 0.10), SEP = +(o.sep || 0.012), TARGET = +(o.target || 4.5), BLEED = +(o.bleed || 1.25);
+const G = geometry(dir, tag);
+const idx = JSON.parse(fs.readFileSync(path.join(dir, `index-${tag}.json`), "utf8")).index;
+
+export const INK = {
+  light: { fg: hslToRgb(24, 10, 10), muted: hslToRgb(30, 26, 35), page: [0xfb, 0xfa, 0xf8] },
+  dark: { fg: hslToRgb(30, 14, 90), muted: hslToRgb(34, 16, 72), page: [0x0b, 0x0a, 0x09] },
+};
+// The pole family per theme: the card's hue at a small chroma, lightness searched.
+const POLE_FAMILY = { light: { C: 0.006, h: 75 }, dark: { C: 0.02, h: 60 } };
+const POLE_L = {
+  light: (o["poles-light"] || "0.975,0.985,0.992,1.0").split(",").map(Number),
+  dark: (o["poles-dark"] || "0.02,0.06,0.10,0.14,0.20,0.26,0.30").split(",").map(Number),
+};
+export const LEVELS = [
+  { id: "wash", band: "content", cap: { f48: 1, head: 10 } }, { id: "quiet", band: "content", cap: { f48: 6, head: 14 } },
+  { id: "resting", band: "content", cap: { f48: 6, head: 16 } }, { id: "floating", band: "chrome", cap: { f48: 9, head: 20 } },
+  { id: "overlay", band: "chrome", cap: { f48: 9, head: 22 } }, { id: "dialog", band: "chrome", cap: { f48: 9, head: 20 } },
+  { id: "dock", band: "chrome", cap: { f48: 6, head: 16 } },
+];
+const LADDER = ["wash", "quiet", "resting", "floating", "overlay"];
+const inBand = (lvl, f) => band === "as-written" || lvl.band === "chrome" || f === "paper" || /-c0\.5$/.test(f) || f.startsWith("blob");
+const sats = (o.sats || "1,1.5").split(",").map(Number);
+const radii = [...new Set(idx.map((e) => e.r))].filter((r) => !o.radii || o.radii.split(",").map(Number).includes(r)).filter((r) => r <= Math.max(...LEVELS.map((l) => l.cap[capMode]))).sort((a, b) => a - b);
+
+function mutedInk(theme) {
+  if (inkMode === "head") return INK[theme].muted;
+  const [Lf] = oklab(INK[theme].fg), [, C, h] = lch(INK[theme].muted);
+  return oklchToRgb(theme === "light" ? Lf + DL : Lf - DL, C, h);
+}
+
+const out = { band, cap: capMode, ink: inkMode, dl: DL, sep: SEP, target: TARGET, bleed: BLEED, themes: {} };
+for (const theme of (o.themes || "light,dark").split(",")) {
+  const inks = { fg: INK[theme].fg, muted: mutedInk(theme) };
+  const poles = POLE_L[theme].map((L) => ({ L, P: oklchToRgb(L, POLE_FAMILY[theme].C, POLE_FAMILY[theme].h) }));
+  // α* per (pole, field, r, s, ink) and the M-8 α* per (pole, r, s): fields outer, so each backdrop decodes once.
+  const A = new Map(), M8 = new Map(), key = (...k) => k.join("|");
+  const cells = idx.filter((e) => e.theme === theme && radii.includes(e.r) && sats.includes(e.s));
+  for (const e of cells) {
+    const D = loadB(path.join(dir, e.file));
+    for (const p of poles) {
+      for (const which of ["fg", "muted"]) {
+        const legible = ringP05(D, G.plates, which, inks[which], p.P, 1).p05 >= TARGET;
+        A.set(key(p.L, e.field, e.r, e.s, which), legible ? bisect((x) => ringP05(D, G.plates, which, inks[which], p.P, x).p05 >= TARGET) : null);
+      }
+      if (e.field === "stripes") M8.set(key(p.L, e.r, e.s), bisect((x) => { const c = calm(D, G.plates, p.P, x); return c.bleed <= BLEED && c.chroma <= 0.04; }));
+    }
+  }
+  const fields = [...new Set(cells.map((e) => e.field))];
+  const paperB = (r, s) => loadB(path.join(dir, idx.find((e) => e.theme === theme && e.field === "paper" && e.r === r && e.s === s).file));
+  const page = INK[theme].page, Lp = lch(page)[0];
+  const ladders = [];
+  for (const p of poles) {
+    const rows = [];
+    for (const lvl of LEVELS) {
+      let best = null;
+      for (const r of radii.filter((r) => r <= lvl.cap[capMode])) for (const s of sats) {
+        let alpha = 0, binding = null, infeasible = null;
+        for (const f of fields.filter((f) => inBand(lvl, f))) for (const which of ["fg", "muted"]) {
+          const a = A.get(key(p.L, f, r, s, which));
+          if (a === undefined) continue;
+          if (a === null) { infeasible = `M-2 ${which} over ${f}: pole illegible under the ink at α = 1`; break; }
+          if (a > alpha) { alpha = a; binding = `M-2 ${which} over ${f}`; }
+        }
+        if (!infeasible && lvl.band === "chrome") {
+          const a = M8.get(key(p.L, r, s));
+          if (a === null) infeasible = "M-8 over stripes at α = 1"; else if (a > alpha) { alpha = a; binding = "M-8 over stripes"; }
+        }
+        if (infeasible) continue;
+        // least α; ties (within one bisection step) to the larger radius, then to s = 1
+        if (!best || alpha < best.alpha - 0.0025 || (Math.abs(alpha - best.alpha) <= 0.0025 && (r > best.r || (r === best.r && s < best.s)))) best = { r, s, alpha, binding };
