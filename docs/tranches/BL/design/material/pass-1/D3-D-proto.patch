+  console.log(`  chosen: pole ${chosen.pole} (L ${chosen.poleL}) ${chosen.feasible ? "feasible" : "INFEASIBLE: " + chosen.violations.join("; ")}`);
+  for (const r of chosen.rows) console.log(`    ${r.level.padEnd(8)} cap ${String(r.cap).padStart(2)}px → α ${r.best.alpha.toFixed(3)} r ${r.best.r} s ${r.best.s} T ${r.best.T} · paper ${r.best.paperComposite} L ${r.best.L} ΔE ${r.best.dEpaper} · ${r.best.binding}`);
+}
