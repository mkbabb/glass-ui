-        luma.value = null;
-        bucket.value = null;
-        sample.value = {
-            state: "unavailable",
-            mode,
-            source: mode === "live" ? "canvas" : "elements",
-            reason,
-            sampledAt,
-            targetRect: targetRect(el),
