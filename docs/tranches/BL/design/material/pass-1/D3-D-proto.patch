-    const luma = ref<number | null>(null);
-    const bucket = ref<GlassBackdropBucket | null>(null);
-    const sample = ref<GlassBackdropSample>({
-        state: "pending",
-        mode: options.live === true ? "live" : "static",
-        source: options.live === true ? "canvas" : "elements",
-    });
