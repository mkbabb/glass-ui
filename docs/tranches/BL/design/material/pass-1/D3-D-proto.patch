+    ladders.push({ poleL: p.L, pole: hex(p.P), rows, violations, meanT: +(Ts.reduce((a, b) => a + b, 0) / Math.max(1, Ts.length)).toFixed(4), feasible: violations.length === 0 && Ts.length === rows.length });
