+export function flatComposite(D, plates, P, alpha) { const pl = plates[0]; const m = [0, 0, 0]; for (const i of pl.sample) { const j = i * 4; for (let k = 0; k < 3; k++) m[k] += q8(alpha * P[k] + (1 - alpha) * D[j + k]); } return m.map((v) => v / pl.sample.length); }
