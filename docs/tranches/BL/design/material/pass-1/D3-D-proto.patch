+// Structure kept: mean over plates of std(Y) of the backdrop body, for the transmission term.
+export function stdY(D, plates) { let s = 0; for (const pl of plates) { let a = 0, a2 = 0; for (const i of pl.body) { const j = i * 4; const y = Y8(D[j], D[j + 1], D[j + 2]); a += y; a2 += y * y; } const n = pl.body.length; s += Math.sqrt(Math.max(0, a2 / n - (a / n) ** 2)); } return s / plates.length; }
