+export function geometry(dir, tag = "chromium-metal") {
+  const A = png(path.join(dir, `${tag}-maskA.png`)), B = png(path.join(dir, `${tag}-maskB.png`)), W = A.width;
+  const cov = new Float32Array(W * A.height);
