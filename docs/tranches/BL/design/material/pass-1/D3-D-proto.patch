+    for (let n = 0; n < pl.sample.length; n++) { const j = pl.sample[n] * 4; const c = [0, 1, 2].map((k) => q8(alpha * P[k] + (1 - alpha) * D[j + k])); ys[n] = Y8(...c); m[0] += c[0]; m[1] += c[1]; m[2] += c[2]; }
