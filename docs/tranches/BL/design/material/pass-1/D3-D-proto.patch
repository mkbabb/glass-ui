+    const row = (id) => rows.find((r) => r.level === id);
+    const comp = (b) => flatComposite(paperB(b.r, b.s), G.plates, p.P, b.alpha);
+    if (theme === "dark") for (const r of rows) if (r.best && dE(comp(r.best), page) < 0.05 + SEP - 0.01) {
+      const a = bisect((x) => dE(comp({ ...r.best, alpha: x }), page) >= 0.05 + SEP - 0.01, r.best.alpha, 1, 0.001);
+      if (a !== null) { r.best.alpha = a; r.best.binding += " → raised by M-6 (page)"; }
+    }
+    const violations = [];
+    for (let k = 1; k < LADDER.length; k++) {
+      const lo = row(LADDER[k - 1]).best, hi = row(LADDER[k]).best;
+      if (!lo || !hi) continue;
+      // a thicker rung never carries less veil than the rung below it (the ladder is ordered), and it sits SEP above
+      const floor = Math.max(hi.alpha, lo.alpha), cl = comp(lo), need = (x) => x >= floor && dE(cl, comp({ ...hi, alpha: x })) >= SEP;
+      if (!need(floor)) {
+        const a = bisect((x) => need(Math.max(x, floor)), 0, 1, 0.001);
+        if (a === null) { violations.push(`M-6 ${LADDER[k - 1]}→${LADDER[k]}: no α ≤ 1 separates it by ${SEP}`); hi.alpha = Math.max(hi.alpha, lo.alpha); }
