-          state: "pending";
-          mode: "live" | "static";
-          source: "canvas" | "elements";
-      }
-    | {
-          state: "sampled";
-          mode: "live" | "static";
-          source: "canvas" | "elements";
-          luma: number;
-          sampledAt: number;
-          targetRect: GlassBackdropTargetRect;
-      }
