-            sampleNow();
-            applyMotionState();
-        },
-        { immediate: true, flush: "post" },
-    );
-
-    function dispose(): void {
-        stopTargetWatch();
-        stopMotionWatch();
-        loop.dispose();
-        io.dispose();
-        ro.stop();
-        downCanvas = null;
-        downCtx = null;
-    }
-
-    onScopeDispose(dispose);
-
