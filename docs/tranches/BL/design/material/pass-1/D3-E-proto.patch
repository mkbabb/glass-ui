diff --git a/src/styles/glass/ink-ground.css b/src/styles/glass/ink-ground.css
new file mode 100644
index 00000000..f32529ce
--- /dev/null
+++ b/src/styles/glass/ink-ground.css
@@ -0,0 +1,95 @@
+/* glass/ink-ground.css
+   THE INK GROUND — legibility bought at the glyph.
+
+   Every plate declares one inherited ground: a `--card` stroke painted UNDER the
+   fill (`paint-order: stroke fill`). The stroke leaves the fill's advances, line box
+   and raster bit-identical in both engines, so type is unchanged; what changes is
+   the ring around each glyph, which is card-opaque at `--glass-ink-ground-width`.
+   Each ink's contrast pair is therefore ink against `--card`, fixed in tokens, and
+   independent of what the plate transmits:
+     --foreground         16.19 light · 11.17 dark
+     --muted-foreground    5.01 light ·  5.43 dark
+
+   Icons carry the same ground by a different road, since text stroke never reaches
+   SVG: four zero-blur `drop-shadow()`s at ±2px on each axis compose a 3×3 dilation
+   of the icon's own alpha, flooded with `--card`. It resolves `--card` at the
+   element and needs no filter mounted in the document.
+
+   THE RESETS. The stroke is a second paint on every glyph, and every other text
+   feature that paints the glyph region collides with it:
+     - forced colours and print: the platform owns ink there, and the stroke is not
+       forced (Chromium keeps the card stroke under the forced ink);
+     - `::selection` has NO reset: neither Chromium nor WebKit honours a
+       text-stroke property inside `::selection`, so a selected run on glass reads
+       perforated by the ground (an open break of this mechanism);
+     - `background-clip: text` runs: the stroke hides the clipped gradient;
+     - a solid tone fill inside a plate (a Badge): its ground is its own fill. */
+@layer components {
+    :where(
+        .glass-wash,
+        .glass-quiet,
+        .glass-resting,
+        .glass-card,
+        .glass-floating,
+        .glass-overlay,
+        .glass-dock
+    ) {
+        -webkit-text-stroke: var(--glass-ink-ground-width) var(--card);
+        paint-order: stroke fill;
+    }
+
+    :where(
+            .glass-wash,
+            .glass-quiet,
+            .glass-resting,
+            .glass-card,
+            .glass-floating,
+            .glass-overlay,
+            .glass-dock
+        )
+        svg.lucide {
+        filter: drop-shadow(2px 0 0 var(--card)) drop-shadow(-2px 0 0 var(--card))
+            drop-shadow(0 2px 0 var(--card)) drop-shadow(0 -2px 0 var(--card));
+    }
+
+    :where(
+        .gold-shimmer,
+        .metal-gold,
+        .metal-silver,
+        .metal-bronze,
+        .badge-atom:not(.badge-atom--outline)
+    ) {
+        -webkit-text-stroke: 0;
+    }
+
+    :where(.badge-atom:not(.badge-atom--outline), .control-bit) svg.lucide {
+        filter: none;
+    }
+
+    @media (forced-colors: active), print {
+        :where(
+            .glass-wash,
+            .glass-quiet,
+            .glass-resting,
+            .glass-card,
+            .glass-floating,
+            .glass-overlay,
+            .glass-dock
+        ) {
+            -webkit-text-stroke: 0;
+        }
+
+        :where(
+                .glass-wash,
+                .glass-quiet,
+                .glass-resting,
+                .glass-card,
+                .glass-floating,
+                .glass-overlay,
+                .glass-dock
+            )
+            svg.lucide {
+            filter: none;
+        }
+    }
+}
