-// owns reactive wiring, canvas reuse, and the custom-property writes.
-import {
-    sampleStatic,
-    sampleAnimated,
-    resolveSourceCanvas,
-    resolveUnderlayRgb,
-    SAMPLE_DOWNSAMPLE,
-    type SampleResult,
-    type BackgroundCanvasSource,
-} from "./backdropLuminanceSample";
