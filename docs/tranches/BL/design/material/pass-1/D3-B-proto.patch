+type Box = { x0: number; y0: number; x1: number; y1: number };
+const covers = (t: FieldTiles, b: Box) =>
+    b.x0 >= t.rect.left - 0.5 &&
+    b.y0 >= t.rect.top - 0.5 &&
+    b.x1 <= t.rect.left + t.rect.width + 0.5 &&
+    b.y1 <= t.rect.top + t.rect.height + 0.5;
+const meets = (r: { left: number; top: number; right: number; bottom: number }, b: Box) =>
+    r.left < b.x1 && r.right > b.x0 && r.top < b.y1 && r.bottom > b.y0;
+
+/** The one publisher that describes everything under `pad`, or null. */
+function owner(pad: Box): FieldTiles | null {
+    const covering: FieldTiles[] = [];
+    for (const t of publishers.values()) {
+        const r = t.rect;
+        if (covers(t, pad)) covering.push(t);
+        else if (meets({ left: r.left, top: r.top, right: r.left + r.width, bottom: r.top + r.height }, pad))
+            return null;
+    }
+    if (covering.length <= 1) return covering[0] ?? null;
+    // Several cover it. A declared medium sits over a substrate; between two of a layer,
+    // the later in document order paints later (a z-index can invert that: a named gap).
+    return covering.reduce((a, b) =>
+        b.layer > a.layer ||
+        (b.layer === a.layer && a.el.compareDocumentPosition(b.el) & Node.DOCUMENT_POSITION_FOLLOWING)
+            ? b
+            : a,
+    );
+}
+
+/** Worst extremes over the tiles `pad` touches; mean weighted by overlap with `core`. */
+function stats(t: FieldTiles, core: Box, pad: Box): [number, number, number] | null {
+    const { left, top, width, height } = t.rect;
+    const tw = width / t.tx;
+    const th = height / t.ty;
+    const ix = (x: number) => Math.min(t.tx - 1, Math.max(0, Math.floor((x - left) / tw)));
+    const iy = (y: number) => Math.min(t.ty - 1, Math.max(0, Math.floor((y - top) / th)));
+    let lo = 1;
+    let hi = 0;
+    for (let j = iy(pad.y0); j <= iy(pad.y1 - 1e-3); j++)
+        for (let i = ix(pad.x0); i <= ix(pad.x1 - 1e-3); i++) {
+            const k = j * t.tx + i;
+            lo = Math.min(lo, t.lo[k]);
+            hi = Math.max(hi, t.hi[k]);
+        }
+    let sum = 0;
+    let area = 0;
+    for (let j = iy(core.y0); j <= iy(core.y1 - 1e-3); j++)
+        for (let i = ix(core.x0); i <= ix(core.x1 - 1e-3); i++) {
+            const ox = Math.min(core.x1, left + (i + 1) * tw) - Math.max(core.x0, left + i * tw);
+            const oy = Math.min(core.y1, top + (j + 1) * th) - Math.max(core.y0, top + j * th);
+            const w = Math.max(0, ox) * Math.max(0, oy);
+            sum += t.mean[j * t.tx + i] * w;
+            area += w;
+        }
+    return area ? [sum / area, lo, hi] : null;
+}
+
+function apply(): void {
+    raf = 0;
+    if (!publishers.size) {
+        for (const el of surfaces.keys()) clear(el);
+        return;
+    }
+    const vw = innerWidth;
+    const vh = innerHeight;
+    const occluders = [...document.querySelectorAll<HTMLElement>(OCCLUDERS)]
+        .map((o) => o.getBoundingClientRect())
+        .filter((r) => r.width && r.height);
+    for (const [el, padPx] of surfaces) {
+        const r = el.getBoundingClientRect();
+        if (!r.width || !r.height || !el.isConnected) {
+            clear(el);
+            continue;
+        }
+        const core = { x0: r.left, y0: r.top, x1: r.right, y1: r.bottom };
+        // Nothing outside the viewport reaches the backdrop.
+        const pad = {
+            x0: Math.max(0, r.left - padPx),
+            y0: Math.max(0, r.top - padPx),
+            x1: Math.min(vw, r.right + padPx),
+            y1: Math.min(vh, r.bottom + padPx),
+        };
+        const t = occluders.some((o) => meets(o, core)) ? null : owner(pad);
+        const next = t && (!t.valid || t.valid()) ? stats(t, core, pad) : null;
+        if (!next) {
+            clear(el);
+            continue;
+        }
+        const prev = written.get(el);
+        if (prev && next.every((v, i) => Math.abs(v - prev[i]) < EPSILON)) continue;
+        PROPS.forEach((p, i) => el.style.setProperty(p, next[i].toFixed(4)));
+        written.set(el, next);
+        el.setAttribute("data-field", "published");
+    }
+    if (publishers.size) schedule();
+}
+
+/* ── declareField — a medium the library reduces itself ───────────────────────────── */
+
+export type FieldMedium = HTMLImageElement | HTMLVideoElement | HTMLCanvasElement;
+
+let devicePromise: Promise<GPUDevice> | null = null;
+function fieldDevice(): Promise<GPUDevice> {
+    devicePromise ??= (async () => {
+        if (typeof navigator === "undefined" || !navigator.gpu)
+            throw new Error("[declareField] WebGPU is unavailable: the medium cannot publish");
+        const adapter = await navigator.gpu.requestAdapter();
+        if (!adapter) throw new Error("[declareField] no WebGPU adapter: the medium cannot publish");
+        return adapter.requestDevice();
+    })();
+    return devicePromise;
+}
+
+const TEX_BINDING = 0x04;
+const TEX_COPY_DST = 0x02;
+const TEX_RENDER_ATTACHMENT = 0x10;
+
+/**
+ * Declare a medium whose paint lies under glass: an `<img>`, a `<video>` or a
+ * `<canvas>`. The library copies it into a texture, reduces it (on decode for an image,
+ * per presented frame for a video, per animation frame for a canvas) and publishes the
+ * tiles over the element's box. A consumer never hands in a number. Cross-origin media
+ * without CORS rejects at `copyExternalImageToTexture` (a tainted source cannot be
+ * read), and so does an engine without WebGPU: the surfaces over it stay at the bound.
+ * Resolves the withdraw function.
+ */
+export async function declareField(el: FieldMedium): Promise<() => void> {
+    const device = await fieldDevice();
+    const reduction = createReduction(device);
+    let texture: GPUTexture | null = null;
+    let stats_: FieldStats | null = null;
+    let dead = false;
+    let loop = 0;
+
+    const size = (): [number, number] =>
+        el instanceof HTMLImageElement
+            ? [el.naturalWidth, el.naturalHeight]
+            : el instanceof HTMLVideoElement
+              ? [el.videoWidth, el.videoHeight]
+              : [el.width, el.height];
+
+    const put = () => {
+        if (dead || !stats_) return;
+        const r = el.getBoundingClientRect();
+        publishField(el, {
+            ...stats_,
+            el,
+            layer: 1,
+            rect: { left: r.left, top: r.top, width: r.width, height: r.height },
+            valid: () => el.isConnected && +getComputedStyle(el).opacity >= 0.999,
+        });
+    };
+
+    const reduce = async (): Promise<void> => {
+        const [w, h] = size();
+        if (!w || !h) return;
+        if (!texture || texture.width !== w || texture.height !== h) {
+            texture?.destroy();
+            texture = device.createTexture({
+                size: [w, h],
+                format: "rgba8unorm",
+                usage: TEX_BINDING | TEX_COPY_DST | TEX_RENDER_ATTACHMENT,
+            });
+        }
+        // Throws SecurityError on a tainted (cross-origin, no CORS) source: loud, by design.
+        device.queue.copyExternalImageToTexture({ source: el }, { texture }, [w, h]);
+        const encoder = device.createCommandEncoder({ label: "[declareField] reduce" });
+        if (!reduction.encode(encoder, texture, 1, pageGround(), true)) return;
+        device.queue.submit([encoder.finish()]);
+        const s = await reduction.read();
+        if (s && !dead) {
+            stats_ = s;
+            put();
+        }
+    };
+
+    if (el instanceof HTMLImageElement) {
+        await el.decode();
+        await reduce();
+        el.addEventListener("load", () => void reduce().catch(console.error));
+    } else if (el instanceof HTMLVideoElement) {
+        const tick = () => {
+            if (dead) return;
+            void reduce().catch(console.error);
+            loop = el.requestVideoFrameCallback(tick);
+        };
+        await reduce();
+        loop = el.requestVideoFrameCallback(tick);
+    } else {
+        const tick = () => {
+            if (dead) return;
+            void reduce().catch(console.error);
+            loop = requestAnimationFrame(tick);
+        };
+        await reduce();
+        loop = requestAnimationFrame(tick);
+    }
+
+    const ro = new ResizeObserver(put);
+    ro.observe(el);
+    addEventListener("scroll", put, { passive: true, capture: true });
+    return () => {
+        dead = true;
+        if (el instanceof HTMLVideoElement) el.cancelVideoFrameCallback(loop);
+        else if (el instanceof HTMLCanvasElement) cancelAnimationFrame(loop);
+        ro.disconnect();
+        removeEventListener("scroll", put, { capture: true });
+        publishField(el, null);
+        reduction.destroy();
+        texture?.destroy();
+    };
+}
