+/**
+ * The field bus: publishers in, registered surfaces out.
+ *
+ * A PUBLISHER is a region whose luminance statistics are known without a DOM readback:
+ * a library substrate that reduced its own frame on the GPU (reduceFrame.ts), or a
+ * medium a consumer declared (`declareField`), which the library reduces itself. It
+ * publishes a grid of tiles over its rect.
+ *
+ * A SURFACE is a glass element a component REGISTERED (`useFieldSurface`: GlassDock,
+ * PopoverContent, DialogContent, Card). Plain `.glass-*` markup never registers and
+ * stays unpublished. Once per animation frame while a publisher exists, the bus reads
+ * each registered surface's rect, pads it by 3σ of its blur, and writes onto it
+ * `--glass-backdrop-luma` (the mean under the rect) and `-lo` / `-hi` (the worst p05 /
+ * p95 under the padded rect), registered `inherits: false`, only when a value moved by
+ * more than `EPSILON`. A surface is UNPUBLISHED, its inline values removed so the CSS
+ * solves the any-input bound, when:
+ *   - no single valid publisher covers its padded rect;
+ *   - another publisher reaches into the padded rect without covering it (two owners,
+ *     neither of which describes the whole backdrop);
+ *   - an OCCLUDER intersects it: a layer the publisher did not reduce sits between the
+ *     publisher and the surface (the modal scrim, the focus veil, `[data-glass-occluder]`).
+ * There is no page publication: an unpublished surface is the bound, never a guess.
+ */
+import { onBeforeUnmount, watch } from "vue";
+import { createReduction, pageGround } from "./reduceFrame";
+
+export interface FieldStats {
+    tx: number;
+    ty: number;
+    /** Per tile, row-major: mean, low and high percentile of relative luminance. */
+    mean: Float32Array;
+    lo: Float32Array;
+    hi: Float32Array;
+}
+
+export interface FieldTiles extends FieldStats {
+    /** The element that paints the published region. */
+    el: Element;
+    /** 0 a substrate (a backdrop by construction), 1 a declared medium (content drawn
+     *  over the backdrop). Where two cover a surface, the higher layer owns it. */
+    layer: 0 | 1;
+    /** The published region, CSS px, viewport coordinates. */
+    rect: { left: number; top: number; width: number; height: number };
+    /** Read at every apply: false while what paints no longer matches what was reduced. */
+    valid?: () => boolean;
+}
+
+const OCCLUDERS = ".bg-overlay-scrim, .glass-focus-veil, [data-glass-occluder]";
+const EPSILON = 0.004;
+const PROPS = ["--glass-backdrop-luma", "--glass-backdrop-luma-lo", "--glass-backdrop-luma-hi"] as const;
+
+const publishers = new Map<object, FieldTiles>();
+/** Registered surfaces → the pad (3σ of the blur that paints them), px. */
+const surfaces = new Map<HTMLElement, number>();
+const written = new WeakMap<HTMLElement, [number, number, number]>();
+let raf = 0;
+
+/** Publish (or replace) a region's statistics. `null` withdraws the publisher. */
+export function publishField(owner: object, tiles: FieldTiles | null): void {
+    if (tiles) publishers.set(owner, tiles);
+    else publishers.delete(owner);
+    schedule();
+}
+
+/** 3σ of the widest `blur()` in the backdrop filter of `el` or of a descendant plate
+ *  (the dock's filter sits on `.dock-plate`, not on the root the bus writes). */
+function padOf(el: HTMLElement): number {
+    let r = 0;
+    for (const node of [el, ...el.querySelectorAll<HTMLElement>(":scope > .dock-plate, :scope > * > .dock-plate")]) {
+        const f = getComputedStyle(node).backdropFilter;
+        for (const m of f.matchAll(/blur\(([\d.]+)px\)/g)) r = Math.max(r, +m[1]);
+    }
+    return 3 * r;
+}
+
+/** Register a surface; returns the unregister function. */
+function registerFieldSurface(el: HTMLElement): () => void {
+    surfaces.set(el, padOf(el));
+    const ro = new ResizeObserver(() => {
+        if (surfaces.has(el)) surfaces.set(el, padOf(el));
+        schedule();
+    });
+    ro.observe(el);
+    schedule();
+    return () => {
+        ro.disconnect();
+        surfaces.delete(el);
+        clear(el);
+    };
+}
+
+/** The component seam: register whatever element `target` resolves, for as long as the
+ *  component lives. */
+export function useFieldSurface(target: () => HTMLElement | null | undefined): void {
+    let off: (() => void) | null = null;
+    watch(
+        target,
+        (el) => {
+            off?.();
+            off = el ? registerFieldSurface(el) : null;
+        },
+        { flush: "post", immediate: true },
+    );
+    onBeforeUnmount(() => {
+        off?.();
+        off = null;
+    });
+}
+
+function schedule(): void {
+    if (!raf && typeof requestAnimationFrame === "function") raf = requestAnimationFrame(apply);
+}
