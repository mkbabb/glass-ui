@@ -0,0 +1,257 @@
+/**
+ * The GPU half of the field signal. A reduction turns a texture, COMPOSITED as it paints
+ * (its layer opacity over the page ground, on encoded channels, where the engines
+ * composite), into per-tile statistics of relative luminance: the mean, and the p05/p95
+ * of a 128-bin histogram (p05 on the bin's lower edge, p95 on its upper edge, so both
+ * err outward). Stats are copied into a 3-deep ring of `MAP_READ` buffers and read by
+ * `mapAsync` a frame or two later. The main thread never blocks and never reads a
+ * canvas: no `getImageData`, no `readPixels`.
+ *
+ * Two callers. A library substrate reduces the frame it just drew, inside its own
+ * command encoder (`createFrameReducer`, the aurora's WebGPU arm). A declared medium
+ * (`declareField`, fieldBus.ts) is copied into a texture and reduced the same way.
+ */
+import { publishField, type FieldStats } from "./fieldBus";
+
+const TX = 32;
+const TY = 18;
+const BINS = 128;
+const STATS_BYTES = TX * TY * 16;
+const P_LO = 0.05;
+const P_HI = 0.95;
+
+// GPUBufferUsage / GPUTextureUsage / GPUMapMode bits, spelled once (the enums are not
+// globals under every test environment).
+const BUF_MAP_READ = 0x1;
+const BUF_COPY_SRC = 0x4;
+const BUF_COPY_DST = 0x8;
+const BUF_UNIFORM = 0x40;
+const BUF_STORAGE = 0x80;
+const MAP_READ = 0x1;
+
+const WGSL = /* wgsl */ `
+struct U { size: vec2f, ceil: f32, straight: f32, bg: vec4f };
+@group(0) @binding(0) var src: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> u: U;
+@group(0) @binding(2) var<storage, read_write> stats: array<vec4f>;
+var<workgroup> hist: array<atomic<u32>, ${BINS}>;
+var<workgroup> sum: atomic<u32>;
+var<workgroup> cnt: atomic<u32>;
+fn lin(c: vec3f) -> vec3f { return select(pow((c + 0.055) / 1.055, vec3f(2.4)), c / 12.92, c <= vec3f(0.04045)); }
+@compute @workgroup_size(16, 16)
+fn main(@builtin(workgroup_id) wg: vec3u, @builtin(local_invocation_id) l: vec3u, @builtin(local_invocation_index) li: u32) {
+  if (li < ${BINS}u) { atomicStore(&hist[li], 0u); }
+  if (li == 0u) { atomicStore(&sum, 0u); atomicStore(&cnt, 0u); }
+  workgroupBarrier();
+  let tile = u.size / vec2f(${TX}.0, ${TY}.0);
+  let o = vec2u(floor(vec2f(wg.xy) * tile));
+  let e = vec2u(floor(vec2f(wg.xy + vec2u(1u)) * tile));
+  for (var y = o.y + l.y; y < e.y; y += 16u) {
+    for (var x = o.x + l.x; x < e.x; x += 16u) {
+      let f = textureLoad(src, vec2u(x, y), 0);
+      // The layer's opacity (and a declared medium's own straight alpha; an opaque
+      // swap chain's alpha is not presented, so it is ignored) over the page ground.
+      let a = u.ceil * select(1.0, f.a, u.straight > 0.5);
+      let comp = a * f.rgb + (1.0 - a) * u.bg.rgb;
+      let Y = clamp(dot(lin(comp), vec3f(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
+      atomicAdd(&hist[min(u32(Y * ${BINS}.0), ${BINS - 1}u)], 1u);
+      atomicAdd(&sum, u32(Y * 4096.0));
+      atomicAdd(&cnt, 1u);
+    }
+  }
+  workgroupBarrier();
+  if (li == 0u) {
+    let n = f32(atomicLoad(&cnt));
+    var acc = 0.0; var lo = 0.0; var hi = 1.0; var gotLo = false; var gotHi = false;
+    for (var b = 0u; b < ${BINS}u; b++) {
+      acc += f32(atomicLoad(&hist[b]));
+      if (!gotLo && acc >= ${P_LO} * n) { lo = f32(b) / ${BINS}.0; gotLo = true; }
+      if (!gotHi && acc >= ${P_HI} * n) { hi = f32(b + 1u) / ${BINS}.0; gotHi = true; }
+    }
+    stats[wg.y * ${TX}u + wg.x] = vec4f(lo, f32(atomicLoad(&sum)) / 4096.0 / max(n, 1.0), hi, n);
+  }
+}`;
+
+/** The page ground the medium composites over. Fails loud on a ground it cannot parse. */
+export function pageGround(): [number, number, number] {
+    const body = getComputedStyle(document.body).backgroundColor;
+    const css = /rgba\(0, 0, 0, 0\)|transparent/.test(body)
+        ? getComputedStyle(document.documentElement).backgroundColor
+        : body;
+    const m = /^rgba?\(\s*([\d.]+)[ ,]+([\d.]+)[ ,]+([\d.]+)/.exec(css);
+    if (!m)
+        throw new Error(
+            `[field] the page ground "${css}" is not an rgb() colour; the field cannot be composited`,
+        );
+    return [+m[1] / 255, +m[2] / 255, +m[3] / 255];
+}
+
+export interface Reduction {
+    /** Encode one reduction of `texture` into `encoder`. False when every ring buffer is
+     *  still mapping (the frame is skipped, never queued). */
+    encode(
+        encoder: GPUCommandEncoder,
+        texture: GPUTexture,
+        ceil: number,
+        bg: readonly number[],
+        straightAlpha: boolean,
+    ): boolean;
+    /** After submit: map the encoded slot; resolves the tile stats, or null if destroyed. */
+    read(): Promise<FieldStats | null> | null;
+    destroy(): void;
+}
+
+export function createReduction(device: GPUDevice): Reduction {
+    const pipeline = device.createComputePipeline({
+        label: "[field] reduce",
+        layout: "auto",
+        compute: {
+            module: device.createShaderModule({ label: "[field] reduce.wgsl", code: WGSL }),
+            entryPoint: "main",
+        },
+    });
+    const uniforms = device.createBuffer({ size: 32, usage: BUF_UNIFORM | BUF_COPY_DST });
+    const stats = device.createBuffer({ size: STATS_BYTES, usage: BUF_STORAGE | BUF_COPY_SRC });
+    const ring = [0, 1, 2].map(() => ({
+        buf: device.createBuffer({ size: STATS_BYTES, usage: BUF_MAP_READ | BUF_COPY_DST }),
+        busy: false,
+    }));
+    let pending: (typeof ring)[number] | null = null;
+    let dead = false;
+
+    return {
+        encode(encoder, texture, ceil, bg, straightAlpha) {
+            pending = null;
+            const slot = ring.find((r) => !r.busy);
+            if (!slot) return false;
+            device.queue.writeBuffer(
+                uniforms,
+                0,
+                new Float32Array([
+                    texture.width, texture.height, ceil, straightAlpha ? 1 : 0,
+                    bg[0], bg[1], bg[2], 1,
+                ]),
+            );
+            const pass = encoder.beginComputePass({ label: "[field] reduce" });
+            pass.setPipeline(pipeline);
+            pass.setBindGroup(
+                0,
+                device.createBindGroup({
+                    layout: pipeline.getBindGroupLayout(0),
+                    entries: [
+                        { binding: 0, resource: texture.createView() },
+                        { binding: 1, resource: { buffer: uniforms } },
+                        { binding: 2, resource: { buffer: stats } },
+                    ],
+                }),
+            );
+            pass.dispatchWorkgroups(TX, TY);
+            pass.end();
+            encoder.copyBufferToBuffer(stats, 0, slot.buf, 0, STATS_BYTES);
+            pending = slot;
+            return true;
+        },
+        read() {
+            const slot = pending;
+            if (!slot) return null;
+            pending = null;
+            slot.busy = true;
+            return slot.buf.mapAsync(MAP_READ).then(
+                () => {
+                    slot.busy = false;
+                    if (dead) {
+                        slot.buf.unmap();
+                        return null;
+                    }
+                    const a = new Float32Array(slot.buf.getMappedRange().slice(0));
+                    slot.buf.unmap();
+                    const n = TX * TY;
+                    const lo = new Float32Array(n);
+                    const mean = new Float32Array(n);
+                    const hi = new Float32Array(n);
+                    for (let k = 0; k < n; k++) {
+                        lo[k] = a[k * 4];
+                        mean[k] = a[k * 4 + 1];
+                        hi[k] = a[k * 4 + 2];
+                    }
+                    return { tx: TX, ty: TY, lo, mean, hi };
+                },
+                () => {
+                    slot.busy = false;
+                    return null;
+                },
+            );
+        },
+        destroy() {
+            dead = true;
+            uniforms.destroy();
+            stats.destroy();
+        },
+    };
+}
+
+/** The composite opacity of the canvas's own layers up to its field root. */
+function opacities(canvas: HTMLCanvasElement): { root: number; inner: number } {
+    const root = canvas.closest<HTMLElement>(".aurora-root");
+    let inner = 1;
+    for (let el: HTMLElement | null = canvas; el && el !== root; el = el.parentElement)
+        inner *= +getComputedStyle(el).opacity;
+    return { root: root ? +getComputedStyle(root).opacity : 1, inner };
+}
+
+export interface FrameReducer {
+    encode(encoder: GPUCommandEncoder, texture: GPUTexture): void;
+    after(): void;
+    destroy(): void;
+}
+
+/** A substrate reduces the frame it just drew and publishes it under its own canvas. */
+export function createFrameReducer(device: GPUDevice, canvas: HTMLCanvasElement): FrameReducer {
+    const reduction = createReduction(device);
+    let at: { ceil: number; rect: DOMRect } | null = null;
+    let dead = false;
+
+    return {
+        encode(encoder, texture) {
+            at = null;
+            let ceil: number;
+            let bg: [number, number, number];
+            try {
+                ceil = opacities(canvas).root;
+                bg = pageGround();
+            } catch (err) {
+                console.error(err);
+                publishField(canvas, null);
+                return;
+            }
+            if (reduction.encode(encoder, texture, ceil, bg, false))
+                at = { ceil, rect: canvas.getBoundingClientRect() };
+        },
+        after() {
+            const reducedAt = at;
+            const read = reduction.read();
+            if (!read || !reducedAt) return;
+            void read.then((s) => {
+                if (!s || dead) return;
+                const r = reducedAt.rect;
+                publishField(canvas, {
+                    ...s,
+                    el: canvas,
+                    layer: 0,
+                    rect: { left: r.left, top: r.top, width: r.width, height: r.height },
+                    // What was reduced still paints: the arm cross-fade has landed and
+                    // the ceiling is the one the reduction composited with.
+                    valid: () => {
+                        const o = opacities(canvas);
+                        return o.inner >= 0.999 && Math.abs(o.root - reducedAt.ceil) < 0.002;
+                    },
+                });
+            });
+        },
+        destroy() {
+            dead = true;
+            publishField(canvas, null);
+            reduction.destroy();
+        },
+    };
+}
