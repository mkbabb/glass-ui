-    return {
-        luma: readonly(luma) as Readonly<Ref<number | null>>,
-        bucket: readonly(bucket) as Readonly<Ref<GlassBackdropBucket | null>>,
-        sample: readonly(sample) as Readonly<Ref<GlassBackdropSample>>,
-        sampleNow,
-        dispose,
-    };
-}
