+/**
+ * The field well, one function in both shading languages. A substrate splices the chunk
+ * and calls `fieldWell(linearRgb, topLeftPixel)` just before its OETF:
+ *
+ *   w  = max(ambient, max_i (1 − smoothstep(outset − feather, outset, sdRoundBox_i(p))))
+ *   L' = mix(L, pole + gain·(L − pole), w)
+ *
+ * in OKLab, hue kept, chroma cut by a 6-step bisection only when L' leaves the sRGB
+ * gamut. The chunk carries its own OKLab pair (`fw_` prefix) so it depends on nothing in
+ * the host shader. The data comes from `fieldWellsFor` (registry.ts).
+ */
+
+/** WGSL: the `Well` block at `@group(group) @binding(binding)` plus `fieldWell()`. */
+export function fieldWellWGSL(group: number, binding: number): string {
+    return /* wgsl */ `
+struct FieldWell {
+  band: vec4<f32>,   // pole, gain, feather (px), outset (px)
+  extra: vec4<f32>,  // ambient, canvas height (px), count, _
+  rects: array<vec4<f32>, 16>,
+  radii: array<vec4<f32>, 4>,
+};
+@group(${group}) @binding(${binding}) var<uniform> fw: FieldWell;
+
+fn fw_toLab(c: vec3<f32>) -> vec3<f32> {
+  let l = pow(0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b, 1.0 / 3.0);
+  let m = pow(0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b, 1.0 / 3.0);
+  let s = pow(0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b, 1.0 / 3.0);
+  return vec3<f32>(
+    0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+    1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+    0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
+}
+fn fw_toLin(lab: vec3<f32>) -> vec3<f32> {
+  let l = pow(lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z, 3.0);
+  let m = pow(lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z, 3.0);
+  let s = pow(lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z, 3.0);
+  return vec3<f32>(
+    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
+}
+fn fw_sd(p: vec2<f32>, r: vec4<f32>, rad: f32) -> f32 {
+  let c = (r.xy + r.zw) * 0.5;
+  let h = (r.zw - r.xy) * 0.5;
+  let q = abs(p - c) - h + vec2<f32>(rad);
+  return length(max(q, vec2<f32>(0.0))) + min(max(q.x, q.y), 0.0) - rad;
+}
+fn fw_inGamut(c: vec3<f32>) -> bool {
+  return all(c >= vec3<f32>(-0.0005)) && all(c <= vec3<f32>(1.0005));
+}
+fn fieldWell(col: vec3<f32>, p: vec2<f32>) -> vec3<f32> {
+  var w = fw.extra.x;
+  let n = i32(fw.extra.z);
+  let feather = max(fw.band.z, 1.0);
+  for (var i = 0; i < 16; i = i + 1) {
+    if (i >= n) { break; }
+    let d = fw_sd(p, fw.rects[i], fw.radii[i / 4][i % 4]);
+    w = max(w, 1.0 - smoothstep(fw.band.w - feather, fw.band.w, d));
+  }
+  if (w <= 0.0) { return col; }
+  let lab = fw_toLab(max(col, vec3<f32>(0.0)));
+  let L = mix(lab.x, fw.band.x + fw.band.y * (lab.x - fw.band.x), w);
+  let full = fw_toLin(vec3<f32>(L, lab.yz));
+  if (fw_inGamut(full)) { return full; }
+  var lo = 0.0;
+  var hi = 1.0;
+  for (var k = 0; k < 6; k = k + 1) {
+    let m = 0.5 * (lo + hi);
+    if (fw_inGamut(fw_toLin(vec3<f32>(L, lab.yz * m)))) { lo = m; } else { hi = m; }
+  }
+  return clamp(fw_toLin(vec3<f32>(L, lab.yz * lo)), vec3<f32>(0.0), vec3<f32>(1.0));
+}
+`;
+}
+
+/** GLSL ES 3.00: the four uniforms of FIELD_WELL_UNIFORMS plus `fieldWell()`. */
+export const FIELD_WELL_GLSL = /* glsl */ `
+uniform vec4  uWellBand;       // pole, gain, feather px, outset px
+uniform vec4  uWellExtra;      // ambient, canvas height px, count, _
+uniform vec4  uWellRects[16];
+uniform float uWellRadius[16];
+
+vec3 fw_toLab(vec3 c) {
+  float l = pow(0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b, 1.0 / 3.0);
+  float m = pow(0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b, 1.0 / 3.0);
+  float s = pow(0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b, 1.0 / 3.0);
+  return vec3(
+    0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
+    1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+    0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
+}
+vec3 fw_toLin(vec3 lab) {
+  float l = pow(lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z, 3.0);
+  float m = pow(lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z, 3.0);
+  float s = pow(lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z, 3.0);
+  return vec3(
+    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
+}
+float fw_sd(vec2 p, vec4 r, float rad) {
+  vec2 c = (r.xy + r.zw) * 0.5;
+  vec2 h = (r.zw - r.xy) * 0.5;
+  vec2 q = abs(p - c) - h + vec2(rad);
+  return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - rad;
+}
+bool fw_inGamut(vec3 c) {
+  return all(greaterThanEqual(c, vec3(-0.0005))) && all(lessThanEqual(c, vec3(1.0005)));
+}
+vec3 fieldWell(vec3 col, vec2 p) {
+  float w = uWellExtra.x;
+  int n = int(uWellExtra.z);
+  float feather = max(uWellBand.z, 1.0);
+  for (int i = 0; i < 16; i++) {
+    if (i >= n) break;
+    float d = fw_sd(p, uWellRects[i], uWellRadius[i]);
+    w = max(w, 1.0 - smoothstep(uWellBand.w - feather, uWellBand.w, d));
+  }
+  if (w <= 0.0) return col;
+  vec3 lab = fw_toLab(max(col, vec3(0.0)));
+  float L = mix(lab.x, uWellBand.x + uWellBand.y * (lab.x - uWellBand.x), w);
+  vec3 full = fw_toLin(vec3(L, lab.yz));
+  if (fw_inGamut(full)) return full;
+  float lo = 0.0; float hi = 1.0;
+  for (int k = 0; k < 6; k++) {
+    float m = 0.5 * (lo + hi);
+    if (fw_inGamut(fw_toLin(vec3(L, lab.yz * m)))) lo = m; else hi = m;
+  }
+  return clamp(fw_toLin(vec3(L, lab.yz * lo)), 0.0, 1.0);
+}
+/* The GL fragment origin is bottom-left; the registry's rects are top-left. */
+vec2 fieldWellPx() { return vec2(gl_FragCoord.x, uWellExtra.y - gl_FragCoord.y); }
+`;
