@@ -0,0 +1,289 @@
+/**
+ * The field-well registry. Glass is found by the ladder's own class set; a library
+ * substrate reads the rects inside its own frame and compresses its OKLab lightness
+ * under them toward the theme band (`--field-well-*`: tokens/glass.css light,
+ * tokens/dark-arm.css dark). Nothing is read back from any canvas.
+ *
+ * One registry per document. A substrate calls `fieldWellsFor(canvas)` inside its frame,
+ * subscribes `onFieldWellChange(wake)` so a parked substrate repaints when glass mounts,
+ * moves, resizes or the theme flips, and registers `onFieldWellOverflow(canvas, report)`
+ * so a page with more glass over one canvas than the uniform block holds fails loud.
+ */
+
+export const FIELD_WELL_MAX = 16;
+
+/** The glass the field yields under: every ladder rung, the dock plate and the opt-in attribute. */
+const FIELD_WELL_SELECTOR =
+    ":is(.glass-wash, .glass-quiet, .glass-resting, .glass-card, .glass-floating, .glass-overlay, .dock-plate, [data-field-well])";
+
+export interface FieldWellFrame {
+    /** Live rects (≤ FIELD_WELL_MAX). */
+    count: number;
+    /** x0, y0, x1, y1 per rect in canvas device pixels, top-left origin. */
+    rects: Float32Array;
+    /** Corner radius per rect, device pixels, clamped to half the short side. */
+    radii: Float32Array;
+    /** pole, gain, feather (device px), outset (device px). */
+    band: Float32Array;
+    /** ambient (0..1 whole-field weight), canvas height (device px), count, _. */
+    extra: Float32Array;
+}
+
+interface Band {
+    pole: number;
+    gain: number;
+    feather: number;
+    outset: number;
+    ambient: number;
+}
+
+interface Entry {
+    el: Element;
+    radius: number;
+    /** The element paints a `clip-path: inset()`: its visible extent is read per frame. */
+    clipped: boolean;
+}
+
+let entries: Entry[] = [];
+let band: Band = { pole: NaN, gain: NaN, feather: NaN, outset: NaN, ambient: NaN };
+let dirty = true;
+const listeners = new Set<() => void>();
+const overflowReporters = new WeakMap<HTMLCanvasElement, (count: number) => void>();
+const overflowed = new WeakSet<HTMLCanvasElement>();
+let observer: MutationObserver | null = null;
+let pollHandle = 0;
+let stillFrames = 0;
+let lastSignature = "";
+
+const frame: FieldWellFrame = {
+    count: 0,
+    rects: new Float32Array(FIELD_WELL_MAX * 4),
+    radii: new Float32Array(FIELD_WELL_MAX),
+    band: new Float32Array(4),
+    extra: new Float32Array(4),
+};
+
+function num(style: CSSStyleDeclaration, name: string): number {
+    return parseFloat(style.getPropertyValue(name));
+}
+
+function refresh(): void {
+    if (!dirty || typeof document === "undefined") return;
+    dirty = false;
+    entries = Array.from(document.querySelectorAll(FIELD_WELL_SELECTOR), (el) => {
+        const cs = getComputedStyle(el);
+        return {
+            el,
+            radius: parseFloat(cs.borderTopLeftRadius) || 0,
+            clipped: cs.clipPath.startsWith("inset("),
+        };
+    });
+    const root = getComputedStyle(document.documentElement);
+    band = {
+        pole: num(root, "--field-well-pole"),
+        gain: num(root, "--field-well-gain"),
+        feather: num(root, "--field-well-feather"),
+        outset: num(root, "--field-well-outset"),
+        ambient: num(root, "--field-well-ambient"),
+    };
+}
+
+/**
+ * Paint order, approximated by the stacking facts a substrate actually uses. A canvas
+ * inside the glass paints over the glass's own background, so it never yields to it.
+ * A canvas whose nearest z-indexed ancestor sits below zero (a page backdrop) paints
+ * under every in-flow surface. Otherwise tree order decides: glass after the canvas
+ * paints above it.
+ */
+function canvasIsBackdrop(canvas: HTMLCanvasElement): boolean {
+    for (let n: Element | null = canvas; n && n !== document.documentElement; n = n.parentElement) {
+        const z = parseInt(getComputedStyle(n).zIndex, 10);
+        if (Number.isFinite(z)) return z < 0;
+    }
+    return false;
+}
+
+function paintsAbove(glass: Element, canvas: HTMLCanvasElement, backdrop: boolean): boolean {
+    if (glass.contains(canvas)) return false;
+    if (backdrop) return true;
+    return Boolean(canvas.compareDocumentPosition(glass) & Node.DOCUMENT_POSITION_FOLLOWING);
+}
+
+/** `inset(t r b l)` in px from the computed clip-path; 1-4 values, `round …` ignored. */
+function clipInset(el: Element): [number, number, number, number] {
+    const m = getComputedStyle(el).clipPath.match(/^inset\(([^)]*?)(?:\s+round[^)]*)?\)/);
+    if (!m) return [0, 0, 0, 0];
+    const v = m[1].trim().split(/\s+/).map((s) => parseFloat(s) || 0);
+    const [t, r = t, b = t, l = r] = v;
+    return [t, r, b, l];
+}
+
+function notify(): void {
+    for (const cb of listeners) cb();
+}
+
+function markDirty(): void {
+    dirty = true;
+    startPoll();
+}
+
+function signature(): string {
+    let s = "";
+    for (const { el } of entries) {
+        const r = el.getBoundingClientRect();
+        s += `${r.left | 0},${r.top | 0},${r.width | 0},${r.height | 0};`;
+    }
+    return s;
+}
+
+/* While anything may be moving, a cheap rect poll wakes the substrates; it parks after
+   30 still frames and restarts on any DOM, scroll, resize or animation event. */
+function startPoll(): void {
+    stillFrames = 0;
+    if (pollHandle || typeof requestAnimationFrame === "undefined") return;
+    const tick = () => {
+        refresh();
+        const sig = signature();
+        if (sig !== lastSignature) {
+            lastSignature = sig;
+            stillFrames = 0;
+            notify();
+        } else if (++stillFrames > 30) {
+            pollHandle = 0;
+            return;
+        }
+        pollHandle = requestAnimationFrame(tick);
+    };
+    pollHandle = requestAnimationFrame(tick);
+}
+
+const WAKE_EVENTS = ["scroll", "resize", "transitionrun", "animationstart"] as const;
+
+function install(): void {
+    if (observer || typeof document === "undefined") return;
+    observer = new MutationObserver(() => {
+        markDirty();
+        notify();
+    });
+    observer.observe(document.documentElement, {
+        subtree: true,
+        childList: true,
+        attributes: true,
+        attributeFilter: ["class", "style", "data-state", "data-field-well"],
+    });
+    for (const type of WAKE_EVENTS)
+        window.addEventListener(type, startPoll, { capture: true, passive: true });
+    startPoll();
+}
+
+function uninstall(): void {
+    observer?.disconnect();
+    observer = null;
+    for (const type of WAKE_EVENTS) window.removeEventListener(type, startPoll, { capture: true });
+    if (pollHandle) cancelAnimationFrame(pollHandle);
+    pollHandle = 0;
+}
+
+export function onFieldWellChange(cb: () => void): () => void {
+    listeners.add(cb);
+    install();
+    return () => {
+        listeners.delete(cb);
+        if (!listeners.size) uninstall();
+    };
+}
+
+/** Called once each time the glass over `canvas` first exceeds FIELD_WELL_MAX. */
+export function onFieldWellOverflow(
+    canvas: HTMLCanvasElement,
+    report: (count: number) => void,
+): () => void {
+    overflowReporters.set(canvas, report);
+    return () => overflowReporters.delete(canvas);
+}
+
+/** The wells over `canvas`, in its device-pixel space. Called once per substrate frame. */
+export function fieldWellsFor(canvas: HTMLCanvasElement): FieldWellFrame {
+    refresh();
+    const c = canvas.getBoundingClientRect();
+    const sx = c.width > 0 ? canvas.width / c.width : 1;
+    const sy = c.height > 0 ? canvas.height / c.height : 1;
+    const backdrop = canvasIsBackdrop(canvas);
+    const live: { x0: number; y0: number; x1: number; y1: number; r: number }[] = [];
+    for (const { el, radius, clipped } of entries) {
+        const b = el.getBoundingClientRect();
+        let x0 = b.left, y0 = b.top, x1 = b.right, y1 = b.bottom;
+        if (clipped) {
+            const [t, r, bo, l] = clipInset(el);
+            x0 += l; y0 += t; x1 -= r; y1 -= bo;
+        }
+        if (x1 - x0 <= 0 || y1 - y0 <= 0) continue;
+        if (x1 < c.left || x0 > c.right || y1 < c.top || y0 > c.bottom) continue;
+        if (!paintsAbove(el, canvas, backdrop)) continue;
+        live.push({ x0, y0, x1, y1, r: Math.min(radius, (x1 - x0) / 2, (y1 - y0) / 2) });
+    }
+    // Weights compose by max, so a rect lying inside another's straight-edged interior adds nothing.
+    const kept = live.filter((a, i) =>
+        !live.some((o, j) => {
+            if (j === i) return false;
+            const k = o.r * (1 - Math.SQRT1_2);
+            const inside = a.x0 >= o.x0 + k && a.y0 >= o.y0 + k && a.x1 <= o.x1 - k && a.y1 <= o.y1 - k;
+            // Two identical rects keep the first.
+            return inside && !(j > i && a.x0 === o.x0 && a.y0 === o.y0 && a.x1 === o.x1 && a.y1 === o.y1);
+        }),
+    );
+    if (kept.length > FIELD_WELL_MAX) {
+        if (!overflowed.has(canvas)) {
+            overflowed.add(canvas);
+            overflowReporters.get(canvas)?.(kept.length);
+        }
+    } else overflowed.delete(canvas);
+    // Glass over a substrate with no band declared is a broken token cascade, not a
+    // reason to paint the field unwelled (E-2).
+    if (kept.length && !Object.values(band).every(Number.isFinite))
+        throw new Error("[field well] --field-well-{pole,gain,feather,outset,ambient} are not all declared on :root");
+    const n = Math.min(kept.length, FIELD_WELL_MAX);
+    for (let k = 0; k < n; k++) {
+        const w = kept[k], i = k * 4;
+        frame.rects[i] = (w.x0 - c.left) * sx;
+        frame.rects[i + 1] = (w.y0 - c.top) * sy;
+        frame.rects[i + 2] = (w.x1 - c.left) * sx;
+        frame.rects[i + 3] = (w.y1 - c.top) * sy;
+        frame.radii[k] = w.r * sx;
+    }
+    frame.count = n;
+    frame.band[0] = band.pole;
+    frame.band[1] = band.gain;
+    frame.band[2] = band.feather * sx;
+    frame.band[3] = band.outset * sx;
+    frame.extra[0] = Number.isFinite(band.ambient) ? band.ambient : 0;
+    frame.extra[1] = canvas.height;
+    frame.extra[2] = n;
+    return frame;
+}
+
+/** The 352-byte WebGPU block: band, extra, 16 rects, 16 radii in 4 lanes. */
+export const FIELD_WELL_BYTES = 352;
+
+export function packFieldWell(canvas: HTMLCanvasElement, into: Float32Array): Float32Array {
+    const w = fieldWellsFor(canvas);
+    into.set(w.band, 0);
+    into.set(w.extra, 4);
+    into.set(w.rects, 8);
+    into.set(w.radii, 72);
+    return into;
+}
+
+export const FIELD_WELL_UNIFORMS = ["uWellBand", "uWellExtra", "uWellRects", "uWellRadius"] as const;
+
+/** The WebGL2 upload; `loc` maps each of FIELD_WELL_UNIFORMS to its location in the bound program. */
+export function uploadFieldWellGL(
+    gl: WebGL2RenderingContext,
+    loc: (name: (typeof FIELD_WELL_UNIFORMS)[number]) => WebGLUniformLocation | null,
+): void {
+    const w = fieldWellsFor(gl.canvas as HTMLCanvasElement);
+    gl.uniform4fv(loc("uWellBand"), w.band);
+    gl.uniform4fv(loc("uWellExtra"), w.extra);
+    gl.uniform4fv(loc("uWellRects"), w.rects);
+    gl.uniform1fv(loc("uWellRadius"), w.radii);
+}
