+// The ground a glass claim reads: the tone arithmetic and the per-host publication.
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { glassGroundTone, publishGlassField } from "@glass/composables/glass/groundTone";
+import { auroraGroundTones } from "@glass/components/aurora/composables/auroraFallbackGround";
+import { DEFAULT_AURORA_CONFIG } from "@glass/components/aurora/constants/presets";
+
+const read = (el: HTMLElement) => ({
+    lo: el.style.getPropertyValue("--glass-field-lo"),
+    hi: el.style.getPropertyValue("--glass-field-hi"),
+    ceiling: el.style.getPropertyValue("--glass-field-ceiling"),
+    live: el.style.getPropertyValue("--glass-field-live"),
+});
+
+describe("glassGroundTone", () => {
+    it("reads the any-input poles at black and white", () => {
+        expect(glassGroundTone("#000000", { saturate: 1.5 })).toEqual({ lo: 0, hi: 0 });
+        const w = glassGroundTone("#ffffff", { saturate: 1.5 });
+        expect(w.lo).toBeCloseTo(1, 4);
+        expect(w.hi).toBeCloseTo(1, 4);
+    });
+
+    it("lo is the encoded luma; hi rises with the backdrop's saturate on a chromatic ground", () => {
+        const [r, g, b] = [0x76 / 255, 0x16 / 255, 0x17 / 255];
+        const t1 = glassGroundTone([r, g, b], { saturate: 1 });
+        const t15 = glassGroundTone([r, g, b], { saturate: 1.5 });
+        expect(t1.lo).toBeCloseTo(0.2126 * r + 0.7152 * g + 0.0722 * b, 6);
+        expect(t15.lo).toBeCloseTo(t1.lo, 6);
+        expect(t15.hi).toBeGreaterThan(t1.hi);
+    });
+});
+
+describe("publishGlassField", () => {
+    afterEach(() => vi.restoreAllMocks());
+
+    it("a host carries the worst of its substrates, and an unmount recomputes from the rest", () => {
+        const host = document.createElement("div");
+        const a = publishGlassField(host);
+        const b = publishGlassField(host);
+        a.set({ lo: 0.4, hi: 0.7, ceiling: 0.5 });
+        b.set({ lo: 0.6, hi: 0.9, ceiling: 1 });
+        expect(read(host)).toEqual({ lo: "0.4000", hi: "0.9000", ceiling: "1.0000", live: "1" });
+        b.dispose();
+        expect(read(host)).toEqual({ lo: "0.4000", hi: "0.7000", ceiling: "0.5000", live: "1" });
+        a.dispose();
+        expect(read(host)).toEqual({ lo: "", hi: "", ceiling: "", live: "" });
+    });
+
+    it("one substrate that cannot state its tones unpublishes the host, loudly", () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+        const host = document.createElement("div");
+        const a = publishGlassField(host);
+        const b = publishGlassField(host);
+        a.set({ lo: 0.4, hi: 0.7, ceiling: 1 });
+        b.set(null);
+        expect(read(host)).toEqual({ lo: "", hi: "", ceiling: "", live: "" });
+        expect(warn).toHaveBeenCalledTimes(1);
+    });
+
+    it("announces every change on document, so a claim re-reads", () => {
+        const host = document.createElement("div");
+        const seen = vi.fn();
+        document.addEventListener("glass-field", seen);
+        const a = publishGlassField(host);
+        a.set({ lo: 0.4, hi: 0.7, ceiling: 1 });
+        a.dispose();
+        document.removeEventListener("glass-field", seen);
+        expect(seen).toHaveBeenCalledTimes(2);
+    });
+
+    it("two hosts never share a publication (nothing is document-global)", () => {
+        const h1 = document.createElement("div");
+        const h2 = document.createElement("div");
+        publishGlassField(h1).set({ lo: 0.1, hi: 0.2, ceiling: 1 });
+        publishGlassField(h2).set({ lo: 0.5, hi: 0.6, ceiling: 1 });
+        expect(read(h1).lo).toBe("0.1000");
+        expect(read(h2).lo).toBe("0.5000");
+    });
+});
+
+describe("auroraGroundTones", () => {
+    it("bounds the default field's lattice, and refuses an image source", () => {
+        const t = auroraGroundTones(DEFAULT_AURORA_CONFIG, 1.5);
+        expect(t).not.toBeNull();
+        expect(t!.lo).toBeGreaterThan(0);
+        expect(t!.lo).toBeLessThan(t!.hi);
+        expect(auroraGroundTones({ ...DEFAULT_AURORA_CONFIG, source: "image" }, 1.5)).toBeNull();
+        expect(auroraGroundTones(DEFAULT_AURORA_CONFIG, Number.NaN)).toBeNull();
+    });
+});
