+
+function resolveAll(): void {
+    for (const [el, claim] of claims) resolve(el, claim);
+}
+
+function watchPage(doc: Document): void {
+    if (observer) return;
+    observer = new MutationObserver(resolveAll);
+    observer.observe(doc.documentElement, { attributes: true, attributeFilter: ["class", "style"] });
+    observer.observe(doc.head, { childList: true, subtree: true, characterData: true });
+    onField = resolveAll;
+    doc.addEventListener(GLASS_FIELD_EVENT, onField);
+}
+
+function unwatchPage(doc: Document): void {
+    observer?.disconnect();
+    observer = null;
+    if (onField) doc.removeEventListener(GLASS_FIELD_EVENT, onField);
+    onField = null;
+}
+
+/**
+ * Claim the ground under `el`'s glass. Returns the release, which removes the attribute,
+ * the tones and the stamp. Throws on the root element (a claim there would move
+ * `--glass-bound` itself, which chrome reads) and on an empty colour list.
+ */
+export function claimGlassGround(el: HTMLElement, source: GlassGroundSource): () => void {
+    const doc = el.ownerDocument;
+    if (el === doc.documentElement) {
+        throw new Error("[glass-ui] claimGlassGround: the root element cannot be claimed; claim a scope below it");
+    }
+    if (typeof source !== "string" && source.length === 0) {
+        throw new Error("[glass-ui] claimGlassGround: an empty colour list states no ground");
+    }
+    if (claims.has(el)) release(el);
+    const claim: Claim = { source, warned: new Set() };
+    claims.set(el, claim);
+    el.setAttribute(CLAIM_ATTR, typeof source === "string" ? source : "");
+    watchPage(doc);
+    resolve(el, claim);
+    return () => release(el);
+}
+
+function release(el: HTMLElement): void {
+    if (!claims.delete(el)) return;
+    el.removeAttribute(CLAIM_ATTR);
+    el.removeAttribute(GROUND_STATE_ATTR);
+    for (const p of TONES) set(el, p, null);
+    if (claims.size === 0) unwatchPage(el.ownerDocument);
+}
+
+/** `claimGlassGround` for a component's element: claimed on mount, re-claimed when the target changes, released on unmount. */
+export function useGlassGround(
+    target: MaybeRefOrGetter<HTMLElement | null | undefined>,
+    source: GlassGroundSource,
+): void {
+    let releaseClaim: (() => void) | null = null;
+    const claim = (el: HTMLElement | null | undefined): void => {
+        releaseClaim?.();
+        releaseClaim = el ? claimGlassGround(el, source) : null;
+    };
+    onMounted(() => {
+        claim(toValue(target));
+        watch(() => toValue(target), claim, { flush: "post" });
+    });
+    onBeforeUnmount(() => {
+        releaseClaim?.();
+        releaseClaim = null;
+    });
+}
