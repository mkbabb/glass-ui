--- /dev/null
+++ b/src/composables/glass/groundTone.ts
@@ -0,0 +1,129 @@
+// The ground a glass claim reads (tokens/glass.css `[data-glass-ground]`), in the one unit
+// the CSS solve composites in: the encoded sRGB tone of the neutral that bounds the ground.
+//
+//   lo  the darkest Rec. 709 luma of the encoded channels. Under a dark (light-theme) ink
+//       it is the conservative statistic: the EOTF is convex, so a composite's Y is never
+//       below the Y of its luma tone (Jensen).
+//   hi  the brightest encoded tone of Y after `saturate(--glass-saturate)`, the filter the
+//       backdrop passes through. Under a light (dark-theme) ink it is the conservative
+//       statistic: the encoded mix with a neutral plate is concave in Y.
+//
+// A substrate publishes its tones on a host with `publishGlassField`; it never claims. A
+// consumer claims with `claimGlassGround` (groundClaim.ts), which turns colours into tones
+// here and reads a publication through the cascade. Only the consumer knows what it paints
+// between a substrate and its glass.
+import { cssToOklch, oklchToLinear } from "../color";
+
+/** An encoded (gamma) sRGB triple, each channel in [0, 1]. */
+export type EncodedRgb = readonly [number, number, number];
+
+/** The two tones a claim reads. */
+export interface GlassGroundTones {
+    lo: number;
+    hi: number;
+}
+
+const clamp01 = (v: number): number => Math.max(0, Math.min(1, v));
+const eotf = (c: number): number => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+const oetf = (y: number): number => (y <= 0.0031308 ? 12.92 * y : 1.055 * y ** (1 / 2.4) - 0.055);
+
+function encoded(color: string | EncodedRgb): EncodedRgb {
+    if (typeof color !== "string") return color;
+    return oklchToLinear(cssToOklch(color)).map((c) => oetf(clamp01(c))) as unknown as EncodedRgb;
+}
+
+/**
+ * The tones of one colour as a ground under glass. `saturate` is the backdrop's
+ * `--glass-saturate` (read it from the cascade; it is a token, not a constant).
+ */
+export function glassGroundTone(
+    color: string | EncodedRgb,
+    { saturate }: { saturate: number },
+): GlassGroundTones {
+    const [r, g, b] = encoded(color);
+    const lo = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+    // The Filter Effects saturate matrix, on the encoded channels the engines filter.
+    const s = saturate;
+    const sr = clamp01((0.213 + 0.787 * s) * r + (0.715 - 0.715 * s) * g + (0.072 - 0.072 * s) * b);
+    const sg = clamp01((0.213 - 0.213 * s) * r + (0.715 + 0.285 * s) * g + (0.072 - 0.072 * s) * b);
+    const sb = clamp01((0.213 - 0.213 * s) * r + (0.715 - 0.715 * s) * g + (0.072 + 0.928 * s) * b);
+    const y = 0.2126 * eotf(sr) + 0.7152 * eotf(sg) + 0.0722 * eotf(sb);
+    return { lo: clamp01(lo), hi: clamp01(oetf(y)) };
+}
+
+/** One substrate's publication: its tones at full presence and its opacity ceiling. */
+export interface GlassFieldPublication extends GlassGroundTones {
+    ceiling: number;
+}
+
+export interface GlassFieldPublisher {
+    /** Publish (or, with `null`, mark unpublished and warn once). Not per frame. */
+    set(publication: GlassFieldPublication | null): void;
+    /** Withdraw this substrate's tones; the host keeps the rest's. */
+    dispose(): void;
+}
+
+// One host can hold several substrates. It carries the worst of them (min lo, max hi, max
+// ceiling), so a claim's page mix stays conservative, and an unmount recomputes from the
+// rest. Nothing is document-global. `--glass-field-live` (registered, initial 0) is the one
+// statement that a publication is in force: a claim reads it through the cascade, so a
+// claim outside the host's subtree reads 0, which an attribute on the host could not say.
+// Every change is announced as a `glass-field` event on `document`, so a claim re-reads.
+const hosts = new WeakMap<HTMLElement, Map<symbol, GlassFieldPublication | null>>();
+const PROPS = ["--glass-field-lo", "--glass-field-hi", "--glass-field-ceiling", "--glass-field-live"] as const;
+
+/** The event a publication change dispatches on `document` (claims re-read on it). */
+export const GLASS_FIELD_EVENT = "glass-field";
+
+function clear(host: HTMLElement): void {
+    for (const p of PROPS) host.style.removeProperty(p);
+}
+
+function write(host: HTMLElement): void {
+    const pubs = hosts.get(host);
+    const all = pubs ? [...pubs.values()] : [];
+    if (all.length === 0) {
+        clear(host);
+        hosts.delete(host);
+    } else if (all.some((p) => p === null)) {
+        // One substrate cannot state its tones: the host publishes nothing, so a claim
+        // over it reads the any-input tones and stamps itself unpublished.
+        clear(host);
+    } else {
+        const known = all as GlassFieldPublication[];
+        host.style.setProperty("--glass-field-lo", Math.min(...known.map((p) => p.lo)).toFixed(4));
+        host.style.setProperty("--glass-field-hi", Math.max(...known.map((p) => p.hi)).toFixed(4));
+        host.style.setProperty("--glass-field-ceiling", clamp01(Math.max(...known.map((p) => p.ceiling))).toFixed(4));
+        host.style.setProperty("--glass-field-live", "1");
+    }
+    host.ownerDocument.dispatchEvent(new CustomEvent(GLASS_FIELD_EVENT));
+}
+
+/** Register one substrate's publication on `host`. */
+export function publishGlassField(host: HTMLElement): GlassFieldPublisher {
+    const id = Symbol("glass-field");
+    let warned = false;
+    return {
+        set(publication) {
+            const live = hosts.get(host) ?? new Map();
+            hosts.set(host, live);
+            if (publication === null && !warned) {
+                warned = true;
+                console.warn(
+                    "[glass-ui] a substrate could not publish its ground tones; glass claimed over it solves against the any-input tones",
+                );
+            }
+            live.set(id, publication);
+            write(host);
+        },
+        dispose() {
+            hosts.get(host)?.delete(id);
+            write(host);
+        },
+    };
+}
+
+/** The backdrop saturate a ground passes through, read once from the cascade (NaN when absent). */
+export function readGlassSaturate(el: Element): number {
+    return parseFloat(getComputedStyle(el).getPropertyValue("--glass-saturate"));
+}
