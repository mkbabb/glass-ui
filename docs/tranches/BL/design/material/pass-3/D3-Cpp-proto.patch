+        --glass-veil-quiet:   calc(var(--glass-content-bound) + 1 * var(--glass-content-step));
+        --glass-veil-resting: calc(var(--glass-content-bound) + 2 * var(--glass-content-step));
+    }
+
+    /* ── THE CLAIM ───────────────────────────────────────────────────────────────
+       `claimGlassGround(el, source)` is the one writer: it sets the attribute, reads the
+       page's `--background` colour into `--glass-page-lo/-hi`, writes a colour list's
+       worst tones, and stamps `data-glass-ground-state`. A field claim mixes the
+       publication on an ancestor (`--glass-field-*`, `publishGlassField`) with the page
