+// The claim's resolver: what it writes, what it stamps, and what it refuses. The cascade is
+// stubbed (happy-dom resolves no custom properties): `getComputedStyle` reads a token
+// table, and a `var(--x)` painted on `color` resolves through the same table.
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { claimGlassGround } from "@glass/composables/glass/groundClaim";
+import { publishGlassField } from "@glass/composables/glass/groundTone";
+
+const LIGHT: Record<string, string> = {
+    "--glass-saturate": "1.5",
+    "--glass-bound-ground": "0",
+    "--card-l": "0.9799",
+    "--card": "oklch(0.9799 0.011 63.36)",
+    "--on-glass-muted-l": "0.481",
+    "--foreground": "oklch(0.22 0.01 56)",
+    "--background": "oklch(0.985 0.004 70)",
+};
+
+let tokens: Record<string, string>;
+let fieldLive = "0";
+
+beforeEach(() => {
+    tokens = { ...LIGHT };
+    fieldLive = "0";
+    vi.spyOn(window, "getComputedStyle").mockImplementation((el: Element) => {
+        const painted = (el as HTMLElement).style.color;
+        const m = /^var\((--[\w-]+)\)$/.exec(painted);
+        return {
+            getPropertyValue: (p: string) => (p === "--glass-field-live" ? fieldLive : (tokens[p] ?? "")),
+            color: m ? (tokens[m[1]] ?? "") : painted,
+        } as unknown as CSSStyleDeclaration;
+    });
+});
+afterEach(() => vi.restoreAllMocks());
+
+const state = (el: HTMLElement) => el.getAttribute("data-glass-ground-state");
+const tone = (el: HTMLElement, p: string) => el.style.getPropertyValue(p);
+
+describe("claimGlassGround", () => {
+    it("a page claim reads the page colour into its tones and stamps live", () => {
+        const el = document.createElement("main");
+        const release = claimGlassGround(el, "page");
+        expect(el.getAttribute("data-glass-ground")).toBe("page");
+        expect(state(el)).toBe("live");
+        expect(Number(tone(el, "--glass-page-lo"))).toBeGreaterThan(0.95);
+        release();
+        expect(el.hasAttribute("data-glass-ground")).toBe(false);
+        expect(state(el)).toBeNull();
+        expect(tone(el, "--glass-page-lo")).toBe("");
+    });
+
+    it("a page colour retune is followed, not held as a stale number", () => {
+        const el = document.createElement("main");
+        claimGlassGround(el, "page");
+        const before = Number(tone(el, "--glass-page-lo"));
+        tokens["--background"] = "hsl(210 22% 70%)";
+        document.dispatchEvent(new CustomEvent("glass-field"));
+        expect(Number(tone(el, "--glass-page-lo"))).toBeLessThan(before - 0.1);
+        expect(state(el)).toBe("live");
+    });
+
+    it("a field claim with no publication in scope is stamped unpublished, once, loudly; a publication re-stamps it", () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+        const el = document.createElement("main");
+        claimGlassGround(el, "field");
+        expect(state(el)).toBe("unpublished");
+        document.dispatchEvent(new CustomEvent("glass-field"));
+        expect(warn).toHaveBeenCalledTimes(1);
+        fieldLive = "1";
+        const host = document.createElement("div");
+        const pub = publishGlassField(host);
+        pub.set({ lo: 0.41, hi: 0.78, ceiling: 1 });
+        expect(state(el)).toBe("published");
+        fieldLive = "0";
+        pub.dispose();
+        expect(state(el)).toBe("unpublished");
+    });
+
+    it("a colour list writes the worst of its tones", () => {
+        const el = document.createElement("main");
+        claimGlassGround(el, ["#000000", "#ffffff"]);
+        expect(el.getAttribute("data-glass-ground")).toBe("");
+        expect(tone(el, "--glass-ground-lo")).toBe("0.0000");
+        expect(tone(el, "--glass-ground-hi")).toBe("1.0000");
+        expect(state(el)).toBe("live");
+    });
+
+    it("refuses loud when --card is written as a colour its number does not describe", () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+        const el = document.createElement("main");
+        tokens["--card"] = "hsl(212 30% 60%)";
+        claimGlassGround(el, "page");
+        expect(state(el)).toBe("desync");
+        expect(tone(el, "--glass-page-lo")).toBe("");
+        expect(warn.mock.calls[0][0]).toMatch(/--card-l/);
+    });
+
+    it("refuses loud when --foreground is retuned into the muted ink's register", () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+        const el = document.createElement("main");
+        tokens["--foreground"] = "oklch(0.42 0.02 56)";
+        claimGlassGround(el, ["#000000"]);
+        expect(state(el)).toBe("desync");
+        expect(tone(el, "--glass-ground-lo")).toBe("");
+        expect(warn.mock.calls[0][0]).toMatch(/--on-glass-muted-l/);
+    });
+
+    it("throws on the root element and on an empty colour list", () => {
+        expect(() => claimGlassGround(document.documentElement, "page")).toThrow(/root/);
+        expect(() => claimGlassGround(document.createElement("main"), [])).toThrow(/empty/);
+    });
+});
