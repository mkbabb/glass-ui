@@ -0,0 +1,197 @@
+// The consumer's claim on the ground under a scope (tokens/glass.css `[data-glass-ground]`).
+//
+// A claim states what is painted between the page's substrate and the glass inside `el`.
+// Inside it the content band (wash, quiet, resting) solves FL-5's own bound against the
+// claimed ground instead of the any-input pole; chrome does not move. This function is the
+// one writer of a claim, so the knowledge it states is checked where it is written:
+//
+//   "page"      the page itself. The page tone is read from the computed `--background`
+//               COLOUR, so a colour retune of the page is followed, never a stale number.
+//   "field"     a substrate's publication on an ancestor (`publishGlassField`, written by
+//               `<Aurora>` on its parent), mixed with the page at the field's ceiling by
+//               the CSS. Read through the cascade: out of scope, `--glass-field-live` is 0
+//               and the tones are the any-input poles, so the claim paints the bound.
+//   colours     the colours painted under `el` (a consumer's palette stops); the worst of
+//               their tones is written.
+//
+// The state is stamped as `data-glass-ground-state`: `live` and `published` say the
+// knowledge is good; `unpublished` (a field claim with no publication in scope) and
+// `desync` (a number the licence reads disagrees with a colour the page paints) are
+// refusals. A refusal paints the bound and warns once. A hand-written `data-glass-ground`
+// with no claim behind it carries no page tone, so it computes the bound too.
+//
+// It re-reads on claim, on every publication change (a `glass-field` event on `document`)
+// and on one shared observer of `<html>`'s class and style and `<head>`'s children (a theme
+// switch, a retune stylesheet). It never runs per frame and reads no pixels.
+import { onBeforeUnmount, onMounted, toValue, watch, type MaybeRefOrGetter } from "vue";
+import { cssToOklch } from "../color";
+import { resolveTokenColor } from "../dom/useResolveTokenColor";
+import { GLASS_FIELD_EVENT, glassGroundTone, readGlassSaturate } from "./groundTone";
+
+/** What a claim states is painted under its scope. */
+export type GlassGroundSource = "field" | "page" | readonly string[];
+
+/** The claim's stamped state (the harness reads it as `GROUND_STATE_ATTR`). */
+const GROUND_STATE_ATTR = "data-glass-ground-state";
+export type GlassGroundState = "live" | "published" | "unpublished" | "desync";
+
+const CLAIM_ATTR = "data-glass-ground";
+const TONES = ["--glass-page-lo", "--glass-page-hi", "--glass-ground-lo", "--glass-ground-hi"] as const;
+// The resolution a computed colour is read at (8-bit channels: about 0.002 in OKLab L).
+const L_TOLERANCE = 0.005;
+// M-4's split between fg and muted, in OKLab L, signed per theme.
+const HIERARCHY = 0.08;
+
+interface Claim {
+    source: GlassGroundSource;
+    warned: Set<string>;
+}
+
+const claims = new Map<HTMLElement, Claim>();
+let observer: MutationObserver | null = null;
+let onField: (() => void) | null = null;
+
+const num = (cs: CSSStyleDeclaration, prop: string): number => parseFloat(cs.getPropertyValue(prop));
+const lightness = (css: string, el: HTMLElement): number => cssToOklch(resolveTokenColor(css, el)).L;
+
+function set(el: HTMLElement, prop: string, value: string | null): void {
+    if (value === null) {
+        if (el.style.getPropertyValue(prop) !== "") el.style.removeProperty(prop);
+    } else if (el.style.getPropertyValue(prop) !== value) {
+        el.style.setProperty(prop, value);
+    }
+}
+
+function stamp(el: HTMLElement, claim: Claim, state: GlassGroundState, why?: string): void {
+    if (el.getAttribute(GROUND_STATE_ATTR) !== state) el.setAttribute(GROUND_STATE_ATTR, state);
+    if (why && !claim.warned.has(why)) {
+        claim.warned.add(why);
+        console.warn(`[glass-ui] glass ground claim refused, glass paints the bound: ${why}`);
+    }
+}
+
+/** The numbers the licence reads, checked against the colours the page paints. */
+function incoherence(el: HTMLElement, cs: CSSStyleDeclaration): string | null {
+    const cardL = num(cs, "--card-l");
+    const mutedL = num(cs, "--on-glass-muted-l");
+    const dark = num(cs, "--glass-bound-ground") === 1;
+    let card: number;
+    let fg: number;
+    try {
+        card = lightness("var(--card)", el);
+        fg = lightness("var(--foreground)", el);
+    } catch {
+        return "--card or --foreground is not a colour this claim can read";
+    }
+    if (!Number.isFinite(cardL) || Math.abs(card - cardL) > L_TOLERANCE) {
+        return `--card paints L ${card.toFixed(3)} but --card-l is ${cardL}; retune --card-l`;
+    }
+    const split = dark ? fg - mutedL : mutedL - fg;
+    if (!Number.isFinite(mutedL) || split < HIERARCHY) {
+        return `--foreground (L ${fg.toFixed(3)}) sits within ${HIERARCHY} of --on-glass-muted-l (${mutedL}); retune --on-glass-muted-l`;
+    }
+    return null;
+}
+
+function resolve(el: HTMLElement, claim: Claim): void {
+    const { source } = claim;
+    const cs = getComputedStyle(el);
+    const saturate = readGlassSaturate(el);
+    const why = Number.isFinite(saturate) ? incoherence(el, cs) : "no glass stylesheet in the cascade";
+    if (why) {
+        for (const p of TONES) set(el, p, null);
+        stamp(el, claim, "desync", why);
+        return;
+    }
