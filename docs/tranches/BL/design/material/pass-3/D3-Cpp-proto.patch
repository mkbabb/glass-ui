+        if (live) stamp(el, claim, "published");
+        else stamp(el, claim, "unpublished", "a field claim with no publication in scope");
+    } else {
+        let lo = 1;
+        let hi = 0;
+        for (const c of source) {
+            const t = glassGroundTone(resolveTokenColor(c, el), { saturate });
+            lo = Math.min(lo, t.lo);
+            hi = Math.max(hi, t.hi);
+        }
+        set(el, "--glass-ground-lo", lo.toFixed(4));
+        set(el, "--glass-ground-hi", hi.toFixed(4));
+        stamp(el, claim, "live");
