-    return [Number(m[1]), Number(m[2]), Number(m[3]), m[4] === undefined ? 1 : Number(m[4])];
-}
-
-export function isCanvas(v: unknown): v is HTMLCanvasElement {
-    return (
-        typeof HTMLCanvasElement !== "undefined" && v instanceof HTMLCanvasElement
