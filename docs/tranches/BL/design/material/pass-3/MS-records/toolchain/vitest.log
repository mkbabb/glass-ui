    --glass-border-defined:  color-mix(in srgb, var(--foreground) calc(var(--glass-definition) * 14%), transparent);

    
    --control-surface-bg:        var(--glass-plate-quiet);
    --control-surface-border:    var(--glass-border-floating);
    --control-surface-blur:      var(--glass-blur-quiet);
    --control-surface-bg-hover:  light-dark(
        color-mix(in oklab, var(--glass-plate-quiet), var(--foreground) calc(var(--fill-hover) * 100%)),
        color-mix(in oklab, var(--glass-plate-quiet), var(--glass-plate-resting) 35%)
    );

    
    --glass-ink-target: 4.8;
    --glass-bound-ground: 0;

    
    --glass-ink-y: pow(var(--on-glass-muted-l), 3);
    --glass-pole-y: pow(var(--card-l), 3);
    --glass-need-y: calc(
        (1 - var(--glass-bound-ground)) * (var(--glass-ink-target) * (var(--glass-ink-y) + 0.05) - 0.05) +
