    );
    --glass-need-e: calc(1.055 * pow(var(--glass-need-y), 0.416667) - 0.055);
    --glass-pole-e: calc(1.055 * pow(var(--glass-pole-y), 0.416667) - 0.055);
    --glass-bound: clamp(
        0,
        calc(
            (var(--glass-need-e) - var(--glass-bound-ground)) /
                (var(--glass-pole-e) - var(--glass-bound-ground))
        ),
        1
    );
}

