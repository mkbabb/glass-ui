== minor10 veil.css:66-92
   every state. It is not a backdrop root, so the carriers still sample the ground.
   Measured: the held floating plate's well read 2.64:1 over black without it and 3.28
   with it (D3 pass 5, light, Chromium). */
@utility glass-plate {
    --glass-veil-rest: clamp(
        var(--glass-veil-tier, var(--glass-veil-resting)),
        calc(
            var(--glass-veil-tier, var(--glass-veil-resting)) + 2 *
                var(--glass-veil-step) *
                max(
                    0,
                    (var(--glass-backdrop-luma, 0) - var(--glass-backdrop-luma-knee)) /
                        (1 - var(--glass-backdrop-luma-knee))
                )
        ),
        calc(
            var(--glass-veil-tier, var(--glass-veil-resting)) + 2 *
                var(--glass-veil-step)
        )
    );
    --glass-veil-rung: var(--glass-veil-rest);
    --glass-veil: color-mix(
        in srgb,
        oklch(from var(--glass-veil-ink) l c h / var(--glass-veil-rung))
            calc(var(--glass-level) * 100%),
        var(--card)
    );
