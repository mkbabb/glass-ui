== minor10 tokens/glass.css:45-60, :140-158
       every rung (tokens/dark-arm.css).

       THE SUBSTITUTION-VS-INHERITANCE SEAM: the composed `--glass-plate-{rung}` colors
       below resolve at THIS `:root`, so re-pointing `--glass-veil-base` on a DESCENDANT
       does not re-compose an inherited plate color. A per-scope retune composes the
       plate AT the element — `@utility glass-plate` (glass/veil.css) is that seam. */
    --glass-veil-base: var(--glass-bound);
    --glass-veil-step: calc((1 - var(--glass-bound)) / 3);

    --glass-veil-wash:     var(--glass-veil-base);
    --glass-veil-quiet:    calc(var(--glass-veil-base) + 1 * var(--glass-veil-step));
    --glass-veil-resting:  calc(var(--glass-veil-base) + 2 * var(--glass-veil-step));
    --glass-veil-floating: var(--glass-veil-base);
    --glass-veil-overlay:  calc(var(--glass-veil-base) + 1 * var(--glass-veil-step));

    /* THICKNESS — the rung's radius. The band is [6, 20], strictly ascending, each
         dialog   α 1        the room: its plate composes over the modal scrim, and any
                             thinner α transmits that scrim as grey */
    --glass-veil-chassis: var(--glass-veil-base);
    --glass-veil-dock:    var(--glass-veil-base);
    --glass-veil-crown:   var(--glass-veil-base);
    --glass-veil-dialog:  1;
    --glass-veil-sheet:   calc(var(--glass-veil-base) + 1 * var(--glass-veil-step));

    /* THE HELD FLOOR (glass/grasp.css). A held light plate sheds toward 0.6 × its rest
       α and never below the bound: it still carries text, so it keeps the α that holds
       that text over any ground, and what comes forward under the finger is the
       carrier's dilated optic. The dark ink ladder sheds the whole band
       (tokens/dark-arm.css), and a grasp host that paints no plate declares 0
       (glass/liquid-fill.css). */
    --glass-veil-floor:   var(--glass-bound);

    /* The dock control's foreground base — a complete `hsl()` color consumed via
       `var()`; for the muted icon weight the control mixes it down with
       `--opacity-icon-muted`. A dock over an animated field sits on a shifting
== minor10 dark-arm.css:270-298
       rung; every rung is arithmetic on base and step.

       (The state veils are the exception, and they are governed elsewhere: a grasp or
       selection veil moves AWAY from the plate, which in dark means lighter. That is a
       STATE law, not the medium's.) */
    --glass-veil-ink:  oklch(0.17 0.03 70);
    --glass-veil-base: 0.18;
    --glass-veil-step: 0.04;

    --glass-veil-wash:     calc(var(--glass-veil-base) - 2 * var(--glass-veil-step));
    --glass-veil-quiet:    calc(var(--glass-veil-base) - 1 * var(--glass-veil-step));
    --glass-veil-resting:  var(--glass-veil-base);
    --glass-veil-floating: calc(var(--glass-veil-base) + 1 * var(--glass-veil-step));
    --glass-veil-overlay:  calc(var(--glass-veil-base) + 2 * var(--glass-veil-step));
    /* The off-ladder footprints in steps off resting: dock −1, crown +1, dialog +1,
       sheet +2, chassis −2. */
    --glass-veil-chassis:  calc(var(--glass-veil-base) - 2 * var(--glass-veil-step));
    --glass-veil-dock:     calc(var(--glass-veil-base) - 1 * var(--glass-veil-step));
    --glass-veil-crown:    calc(var(--glass-veil-base) + 1 * var(--glass-veil-step));
    --glass-veil-dialog:   calc(var(--glass-veil-base) + 1 * var(--glass-veil-step));
    --glass-veil-sheet:    calc(var(--glass-veil-base) + 2 * var(--glass-veil-step));
    /* The held floor (glass/grasp.css): the dark ink ladder sheds the whole band, 0.6 ×
       rest, so its floor is 0. The light arm holds its plates at the bound
       (tokens/glass.css). */
    --glass-veil-floor:    0;

