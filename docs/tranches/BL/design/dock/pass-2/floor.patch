+// The posture chart [D2 floor row 4 · REGISTRY F-4, M-2]: four rungs, typed inputs, one
+// edge table. The compact rung (O-55 R-1), the coarse press (W-11) and the fine-hover
+// gate (F-77) are its edges.
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ref } from "vue";
+import { DOCK_CHART, useDockState } from "@glass/components/dock/composables/useDockState";
+import {
+    DOCK_COMPACT_ENTER_PX,
+    DOCK_COMPACT_EXIT_PX,
+    DOCK_COMPACT_REARM_MS,
+} from "@glass/components/dock/constants";
+import { mountComposable } from "../../../utils/mountComposable";
+
+function chart(opts: { alwaysExpanded?: boolean; compactOnScroll?: boolean } = {}) {
+    const root = document.createElement("div");
+    document.body.append(root);
+    const mounted = mountComposable(() =>
+        useDockState({
+            rootEl: ref(root),
+            alwaysExpanded: opts.alwaysExpanded ?? false,
+            compactOnScroll: () => opts.compactOnScroll ?? false,
+        }),
+    );
+    return { root, ...mounted };
+}
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+});
+
+describe("useDockState — the chart", () => {
+    it("a collapsible dock has no compact rung (it is already its own compact form)", () => {
+        expect(DOCK_CHART.collapsed["scroll.past"]).toBeUndefined();
+        expect(DOCK_CHART.hover["scroll.past"]).toBeUndefined();
+        const { result, unmount } = chart({ compactOnScroll: true });
+        result.onScroll(DOCK_COMPACT_ENTER_PX + 10);
+        expect(result.state.value).toBe("collapsed");
+        unmount();
+    });
+
+    it("a never-collapsing dock compacts past the threshold, with hysteresis", () => {
+        const { result, unmount } = chart({ alwaysExpanded: true, compactOnScroll: true });
+        expect(result.state.value).toBe("pinned");
+        result.onScroll(DOCK_COMPACT_ENTER_PX);
+        expect(result.isCompact.value).toBe(true);
+        // Between the exit and enter thresholds the rung holds (no flutter).
+        result.onScroll((DOCK_COMPACT_ENTER_PX + DOCK_COMPACT_EXIT_PX) / 2);
+        expect(result.isCompact.value).toBe(true);
+        result.onScroll(DOCK_COMPACT_EXIT_PX);
+        expect(result.state.value).toBe("pinned");
+        unmount();
+    });
+
