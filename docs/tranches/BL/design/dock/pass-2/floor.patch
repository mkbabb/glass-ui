+        const { result, unmount } = chart({ alwaysExpanded: true });
+        result.onScroll(DOCK_COMPACT_ENTER_PX * 4);
+        expect(result.state.value).toBe("pinned");
+        unmount();
+    });
+
+    it("a coarse press pins a collapsed dock and unfolds a compact one", () => {
+        const a = chart();
+        a.result.onCoarsePress();
+        expect(a.result.state.value).toBe("pinned");
+        a.unmount();
+
+        const b = chart({ alwaysExpanded: true, compactOnScroll: true });
+        b.result.onScroll(DOCK_COMPACT_ENTER_PX);
+        b.result.onCoarsePress();
+        expect(b.result.state.value).toBe("pinned");
+        b.unmount();
+    });
+
+    it("a compact dock re-arms after engagement clears while still past", () => {
+        vi.stubGlobal("matchMedia", (q: string) => ({ matches: q === "(hover: hover)" }));
+        const { result, unmount } = chart({ alwaysExpanded: true, compactOnScroll: true });
+        result.onScroll(DOCK_COMPACT_ENTER_PX);
+        result.onMouseEnter();
+        vi.runOnlyPendingTimers();
+        expect(result.state.value).toBe("pinned");
+        result.onMouseLeave();
+        vi.advanceTimersByTime(DOCK_COMPACT_REARM_MS);
+        expect(result.isCompact.value).toBe(true);
+        unmount();
+    });
+
+    it("a hover without a fine pointer is not engagement (the (hover: hover) gate)", () => {
