index 00000000..781bd753
--- /dev/null
+++ b/tests/components/custom/dock/useDockScrollSource.test.ts
@@ -0,0 +1,112 @@
+// The one scroll reader [D2 floor row 4 · REGISTRY F-4]: a refcounted document binder
+// (A X-1), a source resolved at each event so a late getter binds (C CX-3), and a
+// binding that fails loud (E-2).
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createApp, defineComponent, h } from "vue";
+import {
+    useDockScrollSource,
+    type DockScrollReading,
+    type DockScrollSource,
+} from "@glass/components/dock/composables/useDockScrollSource";
+
+function subscribe(source: () => DockScrollSource | undefined) {
+    const reads: DockScrollReading[] = [];
+    const errors: unknown[] = [];
+    const host = document.createElement("div");
+    document.body.append(host);
+    const app = createApp(
+        defineComponent({
+            setup() {
+                useDockScrollSource(source, (r) => reads.push(r));
+                return () => h("div");
+            },
+        }),
+    );
+    app.config.errorHandler = (err) => {
+        errors.push(err);
+    };
+    app.mount(host);
+    return {
+        reads,
+        errors,
+        unmount: () => {
+            app.unmount();
+            host.remove();
+        },
+    };
+}
+
+function scroller(top = 0) {
+    const el = document.createElement("div");
+    Object.defineProperty(el, "scrollHeight", { value: 1100, configurable: true });
+    Object.defineProperty(el, "clientHeight", { value: 100, configurable: true });
+    el.scrollTop = top;
+    document.body.append(el);
+    return el;
+}
+
+function scroll(el: HTMLElement, top: number) {
+    el.scrollTop = top;
+    el.dispatchEvent(new Event("scroll"));
+}
+
+afterEach(() => {
+    vi.restoreAllMocks();
+    document.body.innerHTML = "";
+});
+
+describe("useDockScrollSource — the one scroll reader", () => {
+    it("reads offset and progress from an element source", () => {
+        const el = scroller();
+        const s = subscribe(() => el);
+        scroll(el, 500);
+        expect(s.reads.at(-1)).toEqual({ y: 500, progress: 0.5 });
+        s.unmount();
+    });
+
+    it("refcounts the document binder: one unmount leaves the other dock reading", () => {
+        const add = vi.spyOn(document, "addEventListener");
+        const remove = vi.spyOn(document, "removeEventListener");
+        const el = scroller();
+        const a = subscribe(() => el);
+        const b = subscribe(() => el);
+        expect(add.mock.calls.filter(([t]) => t === "scroll")).toHaveLength(1);
+        a.unmount();
+        scroll(el, 250);
+        expect(b.reads.at(-1)?.y).toBe(250);
+        expect(remove.mock.calls.filter(([t]) => t === "scroll")).toHaveLength(0);
+        b.unmount();
+        expect(remove.mock.calls.filter(([t]) => t === "scroll")).toHaveLength(1);
+    });
+
+    it("binds a getter whose element mounts late", () => {
+        let late: HTMLElement | null = null;
+        const s = subscribe(() => () => late);
+        expect(s.errors).toEqual([]);
+        expect(s.reads).toEqual([]);
+        late = scroller();
+        scroll(late, 100);
+        expect(s.reads.at(-1)?.y).toBe(100);
+        s.unmount();
+    });
+
+    it("fails loud on a selector string", () => {
+        const s = subscribe(() => "#main" as unknown as DockScrollSource);
+        expect(s.errors[0]).toBeInstanceOf(TypeError);
+        s.unmount();
+    });
+
+    it("fails loud on a literal null", () => {
+        const s = subscribe(() => null);
+        expect(s.errors[0]).toBeInstanceOf(TypeError);
+        s.unmount();
+    });
+
+    it("fails loud when an element source has left the document", () => {
+        const el = scroller();
+        const s = subscribe(() => el);
+        el.remove();
+        expect(() => document.dispatchEvent(new Event("scroll"))).toThrow(/left the document/);
+        s.unmount();
+    });
+});
