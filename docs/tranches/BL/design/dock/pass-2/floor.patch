+/**
+ * Subscribe to a scroll source for the life of the calling component. `onRead` runs
+ * once at mount (when the source already resolves) and on every scroll of it.
+ */
+export function useDockScrollSource(
+    source: () => DockScrollSource | undefined,
+    onRead: (reading: DockScrollReading) => void,
+): void {
+    let subscriber: Subscriber | null = null;
+
+    function subscribe(next: DockScrollSource | undefined): void {
+        if (subscriber) {
