diff --git a/src/components/dock/styles/scroll-rungs.css b/src/components/dock/styles/scroll-rungs.css
new file mode 100644
index 00000000..96acddb2
--- /dev/null
+++ b/src/components/dock/styles/scroll-rungs.css
@@ -0,0 +1,86 @@
+/* The dock's two SCROLL-DRIVEN surfaces, both fed by the one scroll reader
+ * (useDockScrollSource) through the grouped `scroll` prop [D2 floor rows 2 and 4].
+ *
+ * @import-ed by index.css after run.css, in the SAME `@layer components`. */
+
+@layer components {
+    /* ── THE COMPACT RUNG (O-55 R-1) ──────────────────────────────────────────────
+       A dock that never collapses, scrolled past its threshold with nothing engaging
+       it, keeps only its CURRENT seat: every declared seat at any depth that is not
+       current leaves, and so do the run's separators. "Current" is every expression
+       of selection the tree stamps: `aria-current` (any truthy token), DockControl's
+       `data-active`, and a selected tab. A run with no current seat keeps none, and the
+       compact dock is its persistent regions. How the seats LEAVE is the carrier's
+       (a route's P3, REGISTRY §7.3 B′ item 7): here they leave in one frame. */
+    .glass-dock.compact
+        .dock-run
+        [data-dock-seat]:not(
+            [aria-current]:not([aria-current="false"]),
+            [data-active],
+            [aria-selected="true"]
+        ),
+    .glass-dock.compact .dock-run .dock-separator {
+        display: none;
+    }
+
+    /* ── THE PROGRESS RIM (O-55 R-2) ──────────────────────────────────────────────
+       A child of the plate at the plate's own padding box, rounded by the plate's
+       radius and clipped on both axes by it (`overflow: clip`, never a scroll port), so
+       every rim pixel lies inside the silhouette in every rung and orientation (S-29,
+       REGISTRY F-2). The track and the fill are its two pseudos along the trailing edge
+       (the bottom of a horizontal dock, the inline end of a vertical one); the fill is a
+       `scale` of the track, from the start edge, by `--dock-rim-t`, the source's
+       progress (0..1) the reader writes on this element.
+
+       ITS INKS ARE THE HOUSE RIM'S, never a second pair: the element composes
+       `.track-ground` (GlassDock.vue), so the track is `--track-well-recess` derived
+       from the plate's own `--background`, and the fill is ScrollProgressRim's
+       spectrum (scroll-progress-rim/styles.css). */
+    .dock-plate > .dock-rim {
+        --dock-rim-t: 0;
+        --dock-rim-weight: 0.1875rem;
+        position: absolute;
+        inset: 0;
+        border-radius: inherit;
+        overflow: clip;
+        pointer-events: none;
+    }
+
+    .dock-plate > .dock-rim::before,
+    .dock-plate > .dock-rim::after {
+        content: "";
+        position: absolute;
+        inset-inline: 0;
+        inset-block-end: 0;
+        block-size: var(--dock-rim-weight);
+    }
+
+    .dock-plate > .dock-rim::before {
+        background: var(--track-well-recess);
+    }
+
+    .dock-plate > .dock-rim::after {
+        background: var(--scroll-progress-rim-spectrum, var(--rainbow-violet));
+        transform-origin: left center;
+        scale: var(--dock-rim-t) 1;
+    }
+
+    /* The fill grows from the inline start, as the house rim's does. */
+    .glass-dock:not(.vertical) > .dock-plate > .dock-rim:dir(rtl)::after {
+        transform-origin: right center;
+    }
+
+    .glass-dock.vertical > .dock-plate > .dock-rim::before,
+    .glass-dock.vertical > .dock-plate > .dock-rim::after {
+        inset-block: 0;
+        inset-inline-start: auto;
+        inset-inline-end: 0;
+        block-size: auto;
+        inline-size: var(--dock-rim-weight);
+    }
+
+    .glass-dock.vertical > .dock-plate > .dock-rim::after {
+        transform-origin: center top;
+        scale: 1 var(--dock-rim-t);
+    }
+}
