+// THE DOCK'S ONE SCROLL READER [D2 floor row 4 · REGISTRY F-4, M-2; O-55 R-1].
+//
+// The compact rung (useDockState) and the progress rim (GlassDock) read ONE scroll
+// source through this reader, never two listeners on one fact.
+//
+// THE BINDER IS LAZY AND SHARED. One capture-phase `scroll` listener on `document`
+// serves every dock on the page (`scroll` does not bubble, but it is dispatched
+// through the capture phase, so `document` sees an element's scroll as well as the
+// window's). It is added with the first subscriber and removed with the last: a
+// refcount, so unmounting one of two docks on one scroller leaves the other reading
+// (A X-1). The source is resolved AT EACH EVENT through `toValue`, so a getter whose
+// element mounts late binds the moment that element first scrolls, with no watcher
+// on a non-reactive getter to go stale (C CX-3).
+//
+// IT FAILS LOUD (E-2). A source that resolves to anything but an element, the window
+// or `null` throws. An element source that has left the document throws: that is a
+// binding that died. A literal `null` (neither a ref nor a getter, so it can never
+// become an element) throws at mount. A ref or a getter may read `null` while the
+// element it names is not mounted yet: that is pending, not dead.
+import { onBeforeUnmount, onMounted, toValue, watch, type MaybeRefOrGetter } from "vue";
+
+export type DockScrollSource = MaybeRefOrGetter<HTMLElement | Window | null>;
+
+/** One reading of the source: the offset along its block axis and 0..1 progress. */
+export interface DockScrollReading {
+    y: number;
+    progress: number;
+}
+
+interface Subscriber {
+    source: DockScrollSource;
+    onRead: (reading: DockScrollReading) => void;
+}
+
+const subscribers = new Set<Subscriber>();
+
+function resolve(source: DockScrollSource): HTMLElement | Window | null {
+    const value = toValue(source);
+    if (value === null || value === undefined) return null;
+    if (typeof Window !== "undefined" && value instanceof Window) return value;
+    if (typeof HTMLElement !== "undefined" && value instanceof HTMLElement) {
+        if (!value.isConnected)
+            throw new Error(
+                "[glass-ui:dock] the dock's scroll source element has left the document; the binding is dead",
+            );
+        return value;
+    }
+    throw new TypeError(
+        "[glass-ui:dock] a dock scroll source must be an element, the window, or a ref or getter to one; never a selector string",
+    );
