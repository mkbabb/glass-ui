+    // ── the overflow flag [D2 floor row 5, moved here: one observer] ─────────────
+    // The run scrolls only when its seats genuinely exceed the budget: the demand is a
+    // layout sum of the run's flex items (border boxes, margins, gaps), the budget the
+    // run's own content box. A zero budget is "not laid out": the flag holds.
+    function judgeOverflow(): void {
+        const run = full.value;
+        const r = root.value;
+        if (!run || !r) return;
+        const vertical = r.classList.contains("vertical");
+        const content = sizeOf(run);
+        const budget = vertical ? content.ch : content.cw;
+        if (budget <= 0) return;
