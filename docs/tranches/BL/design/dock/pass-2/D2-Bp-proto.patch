+            demand += (vertical ? s.h : s.w) + (vertical
+                ? Number.parseFloat(cs.marginTop) + Number.parseFloat(cs.marginBottom)
+                : Number.parseFloat(cs.marginLeft) + Number.parseFloat(cs.marginRight));
