+
+// The dock body steps every lane from one requestAnimationFrame. These tests drive that
+// frame by hand: `frame(dt)` advances the clock and runs the callbacks the body queued.
+let queue: Array<FrameRequestCallback> = [];
+let now = 0;
+let prm = false;
+
+function frame(dt = 1000 / 60): number {
+    now += dt;
+    const run = queue;
+    queue = [];
+    for (const cb of run) cb(now);
+    return run.length;
+}
+
+beforeEach(() => {
+    queue = [];
+    now = 1000;
+    prm = false;
+    vi.stubGlobal("requestAnimationFrame", (cb: FrameRequestCallback) => {
+        queue.push(cb);
+        return queue.length;
+    });
+    vi.stubGlobal("cancelAnimationFrame", () => {
+        queue = [];
+    });
+    vi.spyOn(performance, "now").mockImplementation(() => now);
+    Object.defineProperty(document, "timeline", { configurable: true, get: () => ({ currentTime: now }) });
+    vi.stubGlobal("matchMedia", (q: string) => ({
+        matches: prm && q.includes("reduce"),
+        media: q,
+        addEventListener() {},
+        removeEventListener() {},
