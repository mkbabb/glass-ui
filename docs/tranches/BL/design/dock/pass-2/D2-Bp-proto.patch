+        for (const m of ordered) {
+            const was = first.get(m);
+            if (!was) {
+                // A box that just joined is laid out where it lands; a seat joining a
+                // face that was already there appears as its neighbours make room.
+                if (depth(m) === 2 && m.parent && first.has(m.parent)) joined.add(m);
+                m.hold = null;
+                m.lx.seat(0);
+                m.ly.seat(0);
