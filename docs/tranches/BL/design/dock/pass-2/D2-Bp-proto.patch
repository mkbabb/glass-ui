+    onMounted(() => {
+        const r = root.value;
+        if (!r || typeof ResizeObserver === "undefined") return;
+        ro = new ResizeObserver(check);
+        mo = new MutationObserver(check);
+        mo.observe(r, { childList: true, characterData: true, subtree: true });
+        track();
+        window.addEventListener("resize", onViewportResize);
+        r.addEventListener("transitionrun", onTransitionRun, { capture: true });
+        r.addEventListener("animationstart", onTransitionRun, { capture: true });
+    });
+
+    onScopeDispose(() => {
+        disposed = true;
+        ro?.disconnect();
+        mo?.disconnect();
+        window.removeEventListener("resize", onViewportResize);
+        root.value?.removeEventListener("transitionrun", onTransitionRun, { capture: true });
+        root.value?.removeEventListener("animationstart", onTransitionRun, { capture: true });
+        for (const m of movers.values()) {
+            m.lx.release();
+            m.ly.release();
+        }
+        movers.clear();
+    });
+
+    return {
+        outerCurrentLayer: readonly(currentLayer),
+        outerLeavingLayer: readonly(leavingLayer),
+        morphing: readonly(morphing),
+    };
+}
