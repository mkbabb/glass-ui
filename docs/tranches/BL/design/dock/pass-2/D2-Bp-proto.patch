+        expect(lane.moving).toBe(false);
+        expect(Math.min(...painted)).toBeGreaterThanOrEqual(0);
+        expect(painted.at(-1)).toBe(0);
+        // The step into the target is never longer than the step before it.
+        const last = painted.at(-2)! - painted.at(-1)!;
+        const prev = painted.at(-3)! - painted.at(-2)!;
+        expect(last).toBeLessThanOrEqual(prev);
+        // The dock rung (0.30 s, ζ 0.88) reaches 0.5 px of a 380 px travel in about 260 ms.
