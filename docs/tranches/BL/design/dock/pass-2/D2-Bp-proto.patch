+export function provideDockBody(): DockBody {
+    const body = createDockBody();
+    provide(DOCK_BODY_KEY, body);
+    onScopeDispose(() => body.dispose());
+    return body;
+}
+
+/** The enclosing dock's body, or one of the caller's own (a standalone crossfade). */
+export function useDockBody(): DockBody {
+    const shared = inject(DOCK_BODY_KEY, null);
+    if (shared) return shared;
+    const own = createDockBody();
+    onScopeDispose(() => own.dispose());
+    return own;
+}
