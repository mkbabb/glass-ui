+    function onViewportResize(): void {
+        viewportChanged = true;
+    }
+
+    // One owner per animated property (O-64 R-5): a layout-affecting CSS transition or
+    // animation inside the dock would be a second owner of the extent. It is finished
+    // before its first moved frame paints, and the dock's spring carries the change.
+    const warned = new WeakSet<Element>();
+    function onTransitionRun(event: Event): void {
+        const target = event.target;
+        if (!(target instanceof Element) || target === root.value) return;
+        const pseudo = (event as TransitionEvent).pseudoElement ?? "";
+        const prop = event instanceof TransitionEvent ? event.propertyName : null;
+        let finished = false;
+        for (const a of target.getAnimations()) {
+            const effect = a.effect as KeyframeEffect | null;
+            if ((effect?.pseudoElement ?? "") !== pseudo) continue;
+            if (prop !== null) {
+                if (!("transitionProperty" in a) || (a as CSSTransition).transitionProperty !== prop || !SIZE_PROPERTY.test(prop)) continue;
+            } else {
+                const props = (effect?.getKeyframes() ?? []).flatMap((k) => Object.keys(k));
+                if (!props.some((p) => SIZE_PROPERTY.test(p.replace(/[A-Z]/g, (ch) => "-" + ch.toLowerCase())))) continue;
+            }
+            a.finish();
+            finished = true;
+        }
+        if (finished && import.meta.env.DEV && !warned.has(target)) {
+            warned.add(target);
+            console.error(
+                "[glass-ui dock] a CSS size transition or animation inside the dock was finished: the dock's spring owns its extent.",
+                target,
+                prop ?? "",
+            );
+        }
+    }
