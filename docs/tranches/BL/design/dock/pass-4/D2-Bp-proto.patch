diff --git a/tests/components/custom/dock/useDockBody.test.ts b/tests/components/custom/dock/useDockBody.test.ts
new file mode 100644
index 0000000..0120de6
--- /dev/null
+++ b/tests/components/custom/dock/useDockBody.test.ts
@@ -0,0 +1,176 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { createDockBody } from "@glass/components/dock/composables/useDockBody";
+
+// The dock body steps every lane from one requestAnimationFrame. These tests drive that
+// frame by hand: `frame(dt)` advances the clock and runs the callbacks the body queued.
+let queue: Array<FrameRequestCallback> = [];
+let now = 0;
+let prm = false;
+
+function frame(dt = 1000 / 60): number {
+    now += dt;
+    const run = queue;
+    queue = [];
+    for (const cb of run) cb(now);
+    return run.length;
+}
+
+beforeEach(() => {
+    queue = [];
+    now = 1000;
+    prm = false;
+    vi.stubGlobal("requestAnimationFrame", (cb: FrameRequestCallback) => {
+        queue.push(cb);
+        return queue.length;
+    });
+    vi.stubGlobal("cancelAnimationFrame", () => {
+        queue = [];
+    });
+    vi.spyOn(performance, "now").mockImplementation(() => now);
+    Object.defineProperty(document, "timeline", { configurable: true, get: () => ({ currentTime: now }) });
+    vi.stubGlobal("matchMedia", (q: string) => ({
+        matches: prm && q.includes("reduce"),
+        media: q,
+        addEventListener() {},
+        removeEventListener() {},
+        addListener() {},
+        removeListener() {},
+    }));
+});
+
+afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+    delete (document as unknown as Record<string, unknown>).timeline;
+});
+
+describe("useDockBody — one rAF, lanes that land and park", () => {
+    it("a spatial lane lands dead: it never crosses its target, and paints the target last", () => {
+        const body = createDockBody();
+        const painted: number[] = [];
+        const lane = body.lane({ kind: "spatial", eps: 0.5, onFrame: (v) => painted.push(v) });
+        lane.from(380, 0, 0);
+        let frames = 0;
+        while (queue.length && frames < 200) {
+            frame();
+            frames++;
+        }
+        expect(lane.moving).toBe(false);
+        expect(Math.min(...painted)).toBeGreaterThanOrEqual(0);
+        expect(painted.at(-1)).toBe(0);
+        // The step into the target is never longer than the step before it.
+        const last = painted.at(-2)! - painted.at(-1)!;
+        const prev = painted.at(-3)! - painted.at(-2)!;
+        expect(last).toBeLessThanOrEqual(prev);
+        // The dock rung (0.30 s, ζ 0.88) reaches 0.5 px of a 380 px travel in about 260 ms.
+        expect(frames * (1000 / 60)).toBeGreaterThan(220);
+        expect(frames * (1000 / 60)).toBeLessThan(300);
+        body.dispose();
+    });
+
+    it("a lane with a lower damping fraction paints its overshoot: the landing is never a clamp", () => {
+        const body = createDockBody();
+        const painted: number[] = [];
+        const lane = body.lane({ kind: "spatial", eps: 0.5, dampingFraction: 0.6, onFrame: (v) => painted.push(v) });
+        lane.from(380, 0, 0);
+        while (queue.length) frame();
+        // ζ 0.6 overshoots by about 9.5 % of the travel; the lane shows it before it lands.
+        expect(Math.min(...painted)).toBeLessThan(-20);
+        expect(painted.at(-1)).toBe(0);
+        body.dispose();
+    });
+
+    it("parks at rest: no frame is requested once every lane has seated", () => {
+        const body = createDockBody();
+        const lane = body.lane({ kind: "spatial", eps: 0.5 });
+        lane.from(100, 0, 0);
+        while (queue.length) frame();
+        const ran = body.frames;
+        for (let i = 0; i < 60; i++) frame();
+        expect(body.frames).toBe(ran);
+        body.dispose();
+    });
+
+    it("seats on its landing: the frame it stops moving is the last frame it paints", () => {
+        const body = createDockBody();
+        const painted: number[] = [];
+        const lane = body.lane({ kind: "spatial", eps: 0.5, onFrame: (v) => painted.push(v) });
+        lane.from(200, 0, 0);
+        let seatedAt = -1;
+        for (let i = 0; queue.length; i++) {
+            frame();
+            if (seatedAt < 0 && !lane.moving) seatedAt = painted.length;
+        }
+        expect(seatedAt).toBeGreaterThan(0);
+        expect(painted.length).toBe(seatedAt);
+        expect(painted.at(-1)).toBe(0);
+        body.dispose();
+    });
+
+    it("a retarget keeps the lane's position and velocity", () => {
+        const body = createDockBody();
+        const lane = body.lane({ kind: "spatial", eps: 0.5 });
+        lane.from(300, 0, 0);
+        for (let i = 0; i < 5; i++) frame();
+        const x = lane.value;
+        const v = lane.velocity;
+        expect(v).not.toBe(0);
+        lane.from(x, v, 300);
+        expect(lane.value).toBe(x);
+        expect(lane.velocity).toBeCloseTo(v, 6);
+        body.dispose();
+    });
+
+    it("a stalled frame steps one frame at the cadence the dock last ran at", () => {
+        for (const cadence of [1000 / 60, 1000 / 30]) {
+            const a = createDockBody();
+            const stalled = a.lane({ kind: "spatial", eps: 0.5 });
+            stalled.from(300, 0, 0);
+            frame(cadence);
+            frame(cadence);
+            frame(1200);
+            const afterStall = stalled.value;
+            a.dispose();
+            const b = createDockBody();
+            const steady = b.lane({ kind: "spatial", eps: 0.5 });
+            steady.from(300, 0, 0);
+            frame(cadence);
+            frame(cadence);
+            frame(cadence);
+            expect(afterStall).toBeCloseTo(steady.value, 9);
+            b.dispose();
+        }
+    });
+
+    it("a stall at the trigger replays from rest at 60 Hz", () => {
+        const a = createDockBody();
+        const stalled = a.lane({ kind: "spatial", eps: 0.5 });
+        stalled.from(300, 0, 0);
+        frame(1200);
+        const afterStall = stalled.value;
+        a.dispose();
+        const b = createDockBody();
+        const steady = b.lane({ kind: "spatial", eps: 0.5 });
+        steady.from(300, 0, 0);
+        frame(1000 / 60);
+        expect(afterStall).toBeCloseTo(steady.value, 9);
+        b.dispose();
+    });
+
+    it("under reduced motion a spatial retarget seats at once and a fade keeps its curve", () => {
+        prm = true;
+        const body = createDockBody();
+        const spatial = body.lane({ kind: "spatial", eps: 0.5 });
+        const fade = body.lane({ kind: "fade", eps: 0.002 });
+        spatial.from(120, 0, 0);
+        fade.from(0, 0, 1);
+        expect(spatial.moving).toBe(false);
+        expect(spatial.value).toBe(0);
+        expect(fade.moving).toBe(true);
+        frame();
+        expect(fade.value).toBeGreaterThan(0);
+        expect(fade.value).toBeLessThan(1);
+        body.dispose();
+    });
+});
