--- /dev/null
+++ b/src/components/dock/composables/useDockBody.ts
@@ -0,0 +1,236 @@
+// The dock BODY: one requestAnimationFrame steps every moving quantity of one dock.
+//
+// A lane is a keyframes `SpringProgress` stepped by `tickDt` from this loop; the
+// spring's own `.play()` loop is never started. The loop runs only while a lane is
+// moving and parks when every lane has seated, so an idle dock requests no frames.
+//
+// Two lane kinds:
+//   - `spatial` lanes are built `respectReducedMotion: true`: under reduced motion a
+//     retarget seats in the frame it is made (canon P6 drops the transform).
+//   - `fade` lanes are built `false`: they keep their curve under reduced motion
+//     (canon P6 keeps the fade).
+//
+// Landing, on the dock rung (no `dampingFraction` given). A lane LANDS on the first frame
+// its step ends within `eps` of its target: it paints that value, and seats on the target
+// the next frame, so the last step into the target is at most `eps`, never `eps` plus a
+// frame of motion. At ζ 0.88 the approach is monotone until the crossing, and the rung's
+// 0.3 %-of-travel overshoot is undesigned: it would paint as a sub-pixel settle ring
+// (O-64 R-3), so it never paints. A step that crosses its target and ends inside the band
+// seats on the target too.
+//
+// Landing, with a designed damping (`dampingFraction` given, REGISTRY §5 Q-5 (b)). The
+// overshoot is the design, so the band is no landing: the lane seats only at rest,
+// within `eps` of its target and slower than `eps` per 60 Hz frame. The lane passes
+// through the band on its way to the peak and paints the bounce.
+//
+// Time. `dt` is frame time: the rAF timestamp, measured from the frame the trigger
+// landed in (`document.timeline.currentTime` at the kick), so each step is the interval
+// between the frames that paint it, however late the main thread runs a frame's
+// callbacks. It is capped at two 60 Hz frames. A gap no display cadence has (over
+// 100 ms: the main thread stalled) steps one frame at the cadence the dock last ran at,
+// so a stalled morph replays from where it froze, at the speed it was painting, instead
+// of jumping a capped step ahead of the paint (H3-4 `stall`). A timestamp from before
+// the stall (Chromium hands one to the first callback after a long task) steps 0.
+
+import { SpringProgress } from "@mkbabb/keyframes.js";
+import { onScopeDispose } from "vue";
+
+import { motionTempo } from "../../../composables/motion/core/motionTempo";
+import { DOCK_SPRING } from "../constants";
+
+/** The longest step the body takes, ms: two 60 Hz frames. */
+const DOCK_BODY_MAX_DT_MS = 1000 / 30;
+/** A frame gap no display cadence has, ms: past it the main thread stalled. */
+const DOCK_BODY_STALL_MS = 100;
+
+export type DockLaneKind = "spatial" | "fade";
+
+export interface DockLaneOptions {
+    kind: DockLaneKind;
+    /** Seat distance, in the lane's own unit. */
+    eps: number;
+    /** iOS damping fraction: a designed bounce, landing at rest. Defaults to the dock
+        rung, landing on the band (see the header). */
+    dampingFraction?: number;
+    /** Called with the lane's value on every frame it steps. */
+    onFrame?: (value: number) => void;
+}
+
+export interface DockLane {
+    readonly value: number;
+    /** Units per second; 0 while seated. */
+    readonly velocity: number;
+    /** Stepping or seating: the body still has a frame to paint for it. */
+    readonly moving: boolean;
+    /** Continue from `value` at `velocity` toward `target`. */
+    from(value: number, velocity: number, target: number): void;
+    /** Seat at `value` with no motion. */
+    seat(value: number): void;
+    /** Remove the lane from the body. */
+    release(): void;
+}
+
+export interface DockBody {
+    lane(options: DockLaneOptions): DockLane;
+    /** Called after every lane of a frame has stepped. */
+    onFrame(fn: () => void): () => void;
+    /** Frames the loop has run (an instrument for the idle budget). */
+    readonly frames: number;
+    dispose(): void;
+}
+
+export function createDockBody(): DockBody {
+    const lanes = new Set<LaneImpl>();
+    const writers = new Set<() => void>();
+    let raf = 0;
+    let last = 0;
+    // The interval between the frames the dock last painted (60 Hz until it has run).
+    let cadence = 1000 / 60;
+    let kicked = false;
+    let frames = 0;
+    let disposed = false;
+
+    function kick(): void {
+        if (raf || disposed) return;
+        const t = document.timeline?.currentTime;
+        last = typeof t === "number" ? t : performance.now();
+        kicked = true;
+        raf = requestAnimationFrame(step);
+    }
+
+    function step(now: number): void {
+        raf = 0;
+        const gap = Math.max(0, now - last);
+        const dt = gap > DOCK_BODY_STALL_MS ? cadence : Math.min(DOCK_BODY_MAX_DT_MS, gap);
+        // The first gap runs from the trigger, not from a painted frame.
+        if (!kicked && gap > 0 && gap <= DOCK_BODY_STALL_MS) cadence = dt;
+        kicked = false;
+        last = Math.max(last, now);
+        frames++;
+        let live = false;
+        for (const lane of lanes) if (lane.step(dt)) live = true;
+        for (const write of writers) write();
+        if (live) raf = requestAnimationFrame(step);
+    }
+
+    class LaneImpl implements DockLane {
+        spring: SpringProgress;
+        moving = false;
+        landed = false;
+        constructor(readonly o: DockLaneOptions) {
+            this.spring = this.build(0, 0);
+        }
+        build(value: number, velocity: number): SpringProgress {
+            const s = new SpringProgress({
+                response: DOCK_SPRING.response * motionTempo(),
+                dampingFraction: this.o.dampingFraction ?? DOCK_SPRING.dampingFraction,
+                initial: value,
+                respectReducedMotion: this.o.kind === "spatial",
+            });
+            s.reset(value, velocity);
+            return s;
+        }
+        get value(): number {
+            return this.spring.value;
+        }
+        get velocity(): number {
+            return this.moving && !this.landed ? this.spring.velocity : 0;
+        }
+        from(value: number, velocity: number, target: number): void {
+            if (Math.abs(value - target) <= this.o.eps && Math.abs(velocity) < 1e-9) {
+                this.seat(target);
+                return;
+            }
+            // The tempo axis may have moved since the lane was built; rebuild so the
+            // lane runs on the register's current clock.
+            this.spring.dispose();
+            this.spring = this.build(value, velocity);
+            this.spring.target = target;
+            this.landed = false;
+            if (this.spring.settled) {
+                // Reduced motion: a spatial retarget has seated inside SpringProgress.
+                this.moving = false;
+                this.o.onFrame?.(target);
+                return;
+            }
+            this.moving = true;
+            kick();
+        }
+        seat(value: number): void {
+            this.spring.reset(value, 0);
+            this.moving = false;
+            this.landed = false;
+            this.o.onFrame?.(value);
+        }
+        step(dt: number): boolean {
+            if (!this.moving) return false;
+            const target = this.spring.target;
+            if (this.landed) {
+                this.seat(target);
+                return false;
+            }
+            const designed = this.o.dampingFraction !== undefined;
+            const before = this.spring.value - target;
+            this.spring.tickDt(dt);
+            const after = this.spring.value - target;
+            const inBand = Math.abs(after) <= this.o.eps;
+            if (this.spring.settled || (!designed && inBand && after * before <= 0)) {
+                this.seat(target);
+                return false;
+            }
+            // A designed bounce lands at rest: in the band and slower than `eps` per frame.
+            if (inBand && (!designed || Math.abs(this.spring.velocity) / 60 <= this.o.eps)) this.landed = true;
+            this.o.onFrame?.(this.spring.value);
+            return true;
+        }
+        release(): void {
+            lanes.delete(this);
+            this.spring.dispose();
+        }
+    }
+
+    // Reduced motion preferred mid-flight: every moving spatial lane seats now.
+    const prm = typeof matchMedia === "function" ? matchMedia("(prefers-reduced-motion: reduce)") : null;
+    const onPrm = (event: MediaQueryListEvent): void => {
+        if (!event.matches) return;
+        let any = false;
+        for (const lane of lanes) {
+            if (!lane.moving || lane.o.kind !== "spatial") continue;
+            lane.seat(lane.spring.target);
+            any = true;
+        }
+        if (any) for (const write of writers) write();
+    };
+    prm?.addEventListener?.("change", onPrm);
+
+    return {
+        lane(options: DockLaneOptions): DockLane {
+            const lane = new LaneImpl(options);
+            lanes.add(lane);
+            return lane;
+        },
+        onFrame(fn) {
+            writers.add(fn);
+            return () => writers.delete(fn);
+        },
+        get frames() {
+            return frames;
+        },
+        dispose() {
+            disposed = true;
+            prm?.removeEventListener?.("change", onPrm);
+            if (raf) cancelAnimationFrame(raf);
+            raf = 0;
+            for (const lane of lanes) lane.spring.dispose();
+            lanes.clear();
+            writers.clear();
+        },
+    };
+}
+
+/** The dock's one body, disposed with the dock's scope. */
+export function useDockBody(): DockBody {
+    const body = createDockBody();
+    onScopeDispose(() => body.dispose());
+    return body;
+}
