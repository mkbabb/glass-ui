--- /dev/null
+++ b/src/components/dock/composables/useDockScene.ts
@@ -0,0 +1,1346 @@
+// THE MEASURED SCENE [D2-B′]. One model of the dock in layout space, one trigger per
+// fact, and every morph as FLIP on the dock's one body (useDockBody).
+//
+// The model. In the root's own px:
+//   - the plate's four edges and its corner radius;
+//   - the regions (leading `.dock-persistent`, `.dock-layers`, trailing `.dock-persistent`);
+//   - the faces (the full face, which is the run, and the summary), inside `.dock-layers`;
+//   - the cells (each face's flex items, read through `display: contents`), inside their
+//     face, and the units of a crossfade inside a cell (each face's flex items), inside
+//     that cell.
+// Sizes are the used border boxes from computed style. Positions are layout: the whole-px
+// offsets (`offsetLeft`/`offsetTop` summed up to the frame), refined to sub-pixel by the
+// painted rects only within the half pixel the offsets round away, so an ancestor scale
+// or rotate moves the model no further than that rounding. Without the refinement a box
+// that moves 0.1 px can read as a 1 px move and step by it (W3 `lattice`, Playwright
+// WebKit). The anchor below is the other painted read: a ratio of two lengths in the
+// same frame, so a uniform ancestor scale cancels.
+//
+// The episode. On a trigger the scene reads the new layout (Last). Every quantity's lane
+// holds `painted − layout`, so First is the lane's current value re-expressed against
+// Last, and each lane carries it to 0 on the dock rung with the velocity it already had.
+// A posture morph moves the plate and the regions; cells move only when their place
+// inside their face changes (a content change, compaction), so a posture morph writes no
+// cell translate.
+//
+// Content travels with the glass [F-9; REGISTRY P2-4 §4.3]. A unit (a cell with no units
+// inside it, or a crossfade unit) is clipped to the plate's painted silhouette on every
+// frame of an episode, so the closing edge takes what it passes and the opening edge
+// reveals what it reaches. No unit fades by coverage, and a cell that holds units is a
+// transparent container: only its units are clipped, so a growing cell never hides the
+// face inside it (H3-1, W3 `swap-long`).
+//
+// The exchange. Every change of which units are shown runs on one progress lane, 0 → 1 on
+// the dock rung: a posture flip (the leaving face's units out, the current face's in), a
+// crossfade swap (DockCrossfade), the compact rung (its leaving seats out, held where
+// they were painted), and a seat that left the DOM (a clone of it, out). A unit going
+// out whose place lies inside the new plate is wiped toward the side its neighbours
+// arrive from, by the lane's progress, so it is gone exactly when the glass lands and
+// never under a unit coming in; one outside the new plate is left to the closing edge.
+// A unit coming in (or a seat that joined) shows only where no other unit still paints,
+// so the two never paint the same place (no double exposure, no blank trough).
+//
+// The seam (H4-1). A unit going out wipes from each side a unit arrives from: its front.
+// The unit coming in stops one seam short of that front: `--dock-seam`, one glyph advance
+// (`1ch`) of the wider of the two. Two faces never meet inside a glyph run, so no frame
+// paints a false glyph ("Bools"). A unit cut inside the plate to less than its own seam
+// paints nothing: a sliver of a glyph reads as a stray mark, not as a face leaving. The
+// plate's own edge is not such a cut: there the glass takes what it passes. The front
+// starts two seams in (the lead), so the arriving unit paints from the first frame, and
+// ends two seams past the place the two meet, so the arriving unit is whole a seam before
+// the exchange lands; the leaving unit is paced to reach its own seam late in the exchange,
+// where it stops painting, and its front runs on after it, so the edge coming in never
+// steps.
+//
+// The window. `[data-morphing]` opens with the episode and closes on the frame its last
+// lane lands, the exchanges included, and every inline value the scene wrote is cleared
+// in that same frame: whatever moves (a translate, a clip, the plate) moves inside the
+// window (H4-2).
+//
+// The flow. While an episode runs, the root's main-axis margins are its margins at rest
+// plus the difference between the painted plate and the layout box, split by where the container holds the
+// dock (½ centred, 0 start-, 1 end-anchored: the root's start-edge move over its size
+// change, read from its sub-pixel box against its parent's, since offsets are whole px), so
+// an in-flow neighbour follows the painted edge instead of the layout's one-frame step
+// (H3-7). A dock its container shrinks (its run overflows) also holds its layout size,
+// since there the margins change the space it is given, and it would re-lay out, and
+// re-check, on every frame. Both are non-inheriting properties that shell.css "THE FLOW"
+// reads, so a consumer's own inline margin or width is never touched.
+//
+// Triggers (one per fact):
+//   - the dock's content changed (a node joined or left, a text changed, `aria-current`
+//     moved): the
+//     dock's one content observer (useDockContent, N-2), in its own microtask;
+//   - a box changed size for any other reason: the one ResizeObserver (root, regions,
+//     faces, cells);
+//   - a posture changed: a watch on the outer layer and the compact rung;
+//   - a size transition or animation inside the dock: the floor's scoped hand-off
+//     (dockSizeHandoff, N-3) at `transitionrun` / `animationstart` and at every check.
+//     "take" finishes it and the spring carries the change; "hold" and "follow" let it
+//     run on its own clock, and the scene follows the layout with no window;
+//   - the viewport resized: the next check seats at layout, with no episode.
+
+import {
+    getCurrentInstance,
+    inject,
+    nextTick,
+    onBeforeUnmount,
+    onMounted,
+    onScopeDispose,
+    provide,
+    readonly,
+    ref,
+    watch,
+    type InjectionKey,
+    type Ref,
+} from "vue";
+
+import type { DockBody, DockLane } from "./useDockBody";
+import type { DockContent } from "./useDockContent";
+import { handOffSizes } from "./dockSizeHandoff";
+
+type Face = "full" | "summary";
+interface V {
+    x: number;
+    y: number;
+}
+interface Size {
+    w: number;
+    h: number;
+    /** The content box, for the run's budget. */
+    cw: number;
+    ch: number;
+    /** One glyph advance in the box's own font (`--dock-seam: 1ch`, layers.css). */
+    seam: number;
+}
+/** A main-axis interval and a cross-axis interval, root-local px. */
+interface Span {
+    lo: number;
+    hi: number;
+    clo: number;
+    chi: number;
+}
+
+/** Seat distance of a spatial lane, CSS px. */
+const LAND_PX = 0.5;
+/** Seat distance of the veil's expanded-ness lane. */
+const FADE_EPS = 0.002;
+/** Absorbs float noise in the overflow sum, CSS px. */
+const OVERFLOW_TOLERANCE_PX = 0.5;
+/** Two intervals overlap when they share more than this, CSS px. */
+const TOUCH_PX = 0.5;
+/** What a whole-px layout offset rounds away, at most, CSS px (plus float noise). */
+const OFFSET_ROUNDING_PX = 0.5 + 1e-3;
+/** A seam keeps this much more than one advance, CSS px: past the half pixel a clip
+    edge is read as cut, with room for sub-pixel paint. */
+const SEAM_SLACK_PX = 1;
+/** The exchange progress at which a leaving unit has wiped down to its seam. */
+const SEAM_AT = 0.8;
+
+/** A seat is current when any expression of selection marks it (scroll-rungs.css). */
+const CURRENT_SEAT = '[aria-current]:not([aria-current="false"]), [data-active], [aria-selected="true"]';
+
+export interface UseDockSceneOptions {
+    root: Ref<HTMLElement | null>;
+    plate: Ref<HTMLElement | null>;
+    layers: Ref<HTMLElement | null>;
+    full: Ref<HTMLElement | null>;
+    summary: Ref<HTMLElement | null>;
+    outerActiveLayer: Ref<Face>;
+    isCompact: Ref<boolean>;
+    body: DockBody;
+    /** The dock's one content observer (N-2). */
+    content: DockContent;
+    /** The window opened or closed. */
+    onWindow?: (open: boolean) => void;
+}
+
+export interface UseDockSceneReturn {
+    outerCurrentLayer: Readonly<Ref<Face>>;
+    outerLeavingLayer: Readonly<Ref<Face | null>>;
+    /** The morph window is open (`[data-morphing]`). */
+    morphing: Readonly<Ref<boolean>>;
+}
+
+/** What a dock's descendants hand the scene: a face swap, and a seat leaving the DOM. */
+export interface DockSceneHost {
+    /** A crossfade swaps faces: the units of every face in `leave` go out from what each
+        still paints, `enter`'s come in, on one exchange. `done` runs when it has landed,
+        or when a later swap of the same key takes it over. */
+    swap(key: object, leave: readonly HTMLElement[], enter: HTMLElement, done: () => void): void;
+    /** A seat is about to leave the DOM: a clone of it leaves where it was painted. */
+    retire(seat: HTMLElement): void;
+}
+
+const DOCK_SCENE_KEY: InjectionKey<DockSceneHost> = Symbol("glass-ui:dock-scene");
+
+/** The enclosing dock's scene, or null outside a dock. */
+export function useOptionalDockScene(): DockSceneHost | null {
+    return inject(DOCK_SCENE_KEY, null);
+}
+
+/**
+ * A seat's half of "a seat left": before a DockControl or DockTrigger leaves the DOM it
+ * hands its element to the dock's scene, which lets a clone of it leave where it was
+ * painted. The fact arrives from the seat's own lifecycle; no observer infers it.
+ */
+export function useDockSeatRetire(): void {
+    const scene = useOptionalDockScene();
+    const instance = getCurrentInstance();
+    if (!scene || !instance) return;
+    onBeforeUnmount(() => {
+        const el = instance.proxy?.$el;
+        if (el instanceof HTMLElement) scene.retire(el);
+    });
+}
+
+/** The run's flex items: element children, looking through `display: contents`. */
+function cellsOf(el: HTMLElement): HTMLElement[] {
+    const cells: HTMLElement[] = [];
+    for (const child of Array.from(el.children)) {
+        if (!(child instanceof HTMLElement)) continue;
+        if (getComputedStyle(child).display === "contents") cells.push(...cellsOf(child));
+        else cells.push(child);
+    }
+    return cells;
+}
+
+/** A crossfade face's units: the flex items of its content box. */
+function unitsOfFace(face: HTMLElement): HTMLElement[] {
+    const content = face.querySelector<HTMLElement>(":scope > .dock-face-content");
+    return cellsOf(content ?? face);
+}
+
+/** Layout position of `el` in `frame`'s padding box: offsets summed up the offsetParent chain. */
+function posIn(el: HTMLElement, frame: HTMLElement): V | null {
+    let x = 0;
+    let y = 0;
+    let e: Element | null = el;
+    while (e && e !== frame) {
+        if (!(e instanceof HTMLElement)) return null;
+        x += e.offsetLeft;
+        y += e.offsetTop;
+        e = e.offsetParent;
+    }
+    return e === frame ? { x, y } : null;
+}
+
+function clamp01(v: number): number {
+    return v < 0 ? 0 : v > 1 ? 1 : v;
+}
+
+/** One exchange: the units going out and coming in, on one progress lane. */
+interface Exchange {
+    key: object;
+    lane: DockLane;
+    out: Set<HTMLElement>;
+    in: Set<HTMLElement>;
+    done: (() => void) | null;
+}
+/** A unit going out: its visible part at the start [s0, e0] (local px along the main
+    axis) and the part it shrinks to by the exchange's end (`to`, local; empty when it is
+    gone; null when the closing edge alone takes it; undefined until armed against Last). */
+interface Exit {
+    ex: Exchange;
+    s0: number;
+    e0: number;
+    to: [number, number] | null | undefined;
+    /** The fronts' path, unit-local, armed with `to`: from [s0, e0] less the lead on
+        each side a unit arrives from, to `to` plus one seam on that side. */
+    path?: { from: [number, number]; to: [number, number]; cut: [boolean, boolean] };
+    /** It was already coming in or going out when this exchange took it (a retarget). */
+    moving?: boolean;
+}
+
+/** A moving box: a layout position in its parent's frame, and an offset lane per axis. */
+class Mover {
+    pos: V = { x: 0, y: 0 };
+    size: V = { x: 0, y: 0 };
+    /** Held at this root-local painted position (a seat leaving, a clone), or null. */
+    hold: V | null = null;
+    /** The translate this scene last wrote on it, or null: none. */
+    wrote: V | null = null;
+    /** The clip this scene last wrote on it, or null: none. */
+    clip: string | null = null;
+    /** The main-axis interval it painted on the last frame (root-local), or null: whole. */
+    vis: [number, number] | null = null;
+    exit: Exit | null = null;
