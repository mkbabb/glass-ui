+    function onViewportResize(): void {
+        viewportChanged = true;
+    }
+
+    /** A size transition or animation starts inside the dock: the floor's one policy
+        decides, before its first moved frame paints (N-3). */
+    function onSizeEffect(event: Event): void {
+        const r = root.value;
+        if (!r || event.target === r) return;
+        handOffSizes(r, vertical() ? "vertical" : "horizontal");
+    }
+
+    onMounted(() => {
+        const r = root.value;
+        if (!r || typeof ResizeObserver === "undefined") return;
+        ro = new ResizeObserver(check);
+        unsubscribe = content.subscribe(check);
+        track();
+        window.addEventListener("resize", onViewportResize);
+        r.addEventListener("transitionrun", onSizeEffect, { capture: true });
+        r.addEventListener("animationstart", onSizeEffect, { capture: true });
+    });
+
+    // A dock that unmounts takes its seats with it: none of them leaves on its own.
+    onBeforeUnmount(() => {
+        disposed = true;
+    });
+
+    onScopeDispose(() => {
+        disposed = true;
+        ro?.disconnect();
+        unsubscribe?.();
+        window.removeEventListener("resize", onViewportResize);
+        root.value?.removeEventListener("transitionrun", onSizeEffect, { capture: true });
+        root.value?.removeEventListener("animationstart", onSizeEffect, { capture: true });
