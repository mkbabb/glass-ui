+    // ── observers ────────────────────────────────────────────────────────────────
+    let ro: ResizeObserver | null = null;
+    let unsubscribe: (() => void) | null = null;
+    const observed = new Set<Element>();
+
+    function track(): void {
+        const r = root.value;
+        if (!r || !ro) return;
+        const want = new Set<Element>([r]);
+        for (const el of regionsOf(r)) want.add(el);
+        for (const face of ["full", "summary"] as const) {
+            const fe = faceEl(face);
+            if (!fe) continue;
+            want.add(fe);
+            for (const cell of cellsOf(fe)) if (!ghosts.has(cell)) want.add(cell);
+        }
+        for (const el of observed) if (!want.has(el)) {
+            ro.unobserve(el);
+            observed.delete(el);
+        }
+        for (const el of want) if (!observed.has(el)) {
+            ro.observe(el, { box: "border-box" });
+            observed.add(el);
+        }
+    }
