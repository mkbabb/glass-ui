+import { isTeleportedTarget } from "../../_shared/overlay/isTeleportedTarget";
+import { DOCK_COLLAPSE_DELAY_MS, HOVER_INTENT_MS } from "../constants";
+import type { DockHoldKind } from "./dockContext";
