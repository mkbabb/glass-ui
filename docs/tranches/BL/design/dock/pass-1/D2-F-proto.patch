+export type DockRung = "collapsed" | "compact" | "expanded" | "pinned" | "held";
+export type DockInput =
+    | "hover.fine" | "leave.idle" | "press.coarse" | "click.summary" | "focus.visible" | "focus.out"
+    | "scroll.past" | "scroll.top" | "layer.open" | "layer.close" | "click.away" | "expand" | "collapse";
+
+/** What a seam drives on a dock: the `<GlassDock>` expose satisfies it. */
+export interface DockHandle {
+    expand: () => void;
+    keepOpen: (kind?: DockHoldKind) => void;
+    release: (kind?: DockHoldKind) => void;
+}
+
+export interface DockChartContext {
+    collapsible: boolean;
+    compactOnScroll: boolean;
+    past: boolean;
+    holds: number;
+    /** the rung a hold returns to when it clears and nothing is engaged */
+    heldFrom: DockRung;
+    engaged: () => boolean;
+}
+
+type Edge = DockRung | ((c: DockChartContext) => DockRung | null);
+const rest = (c: DockChartContext): DockRung => (c.collapsible ? "collapsed" : c.compactOnScroll && c.past ? "compact" : "expanded");
+const settle = (c: DockChartContext): DockRung => (c.engaged() ? "expanded" : c.heldFrom === "pinned" ? "pinned" : rest(c));
+
+export const TABLE: Record<DockRung, Partial<Record<DockInput, Edge>>> = {
+    collapsed: { "hover.fine": "expanded", "focus.visible": "expanded", "press.coarse": "pinned", "click.summary": "pinned", expand: "expanded", "layer.open": "held" },
+    compact: { "hover.fine": "expanded", "focus.visible": "expanded", "scroll.top": "expanded", "press.coarse": "expanded", expand: "expanded", "layer.open": "held" },
+    expanded: {
+        "leave.idle": (c) => (c.engaged() ? null : rest(c)),
+        "focus.out": (c) => (c.engaged() ? null : rest(c)),
+        "scroll.past": (c) => (c.compactOnScroll && !c.collapsible && !c.engaged() ? "compact" : null),
+        "click.away": (c) => (c.collapsible ? "collapsed" : null),
+        "click.summary": "pinned",
+        "layer.open": "held",
+        collapse: (c) => (c.collapsible ? "collapsed" : null),
+    },
+    pinned: { "click.away": rest, collapse: rest, "layer.open": "held" },
+    held: { "layer.close": (c) => (c.holds > 0 ? null : settle(c)) },
+};
+
+export interface UseDockChartOptions {
+    rootEl: Ref<HTMLElement | null>;
+    collapsible: Ref<boolean>;
+    initial: DockRung;
+    dockId: string;
+    compactOnScroll?: MaybeRefOrGetter<boolean | { enter?: number; exit?: number } | undefined>;
+    scrollSource?: MaybeRefOrGetter<HTMLElement | Window | null | undefined>;
+}
+
+export function useDockChart(o: UseDockChartOptions) {
+    const rung = ref<DockRung>(o.initial);
+    let pointer: { x: number; y: number } | null = null;
+    const frozen = () => !!o.rootEl.value?.hasAttribute("data-rung-transition");
+    const holds = ref(0);
+    const grasps = ref(0);
+    const past = ref(false);
+    let heldFrom: DockRung = rung.value;
+    const band = () => { const v = toValue(o.compactOnScroll); return typeof v === "object" && v ? { enter: v.enter ?? 160, exit: v.exit ?? 64 } : { enter: 160, exit: 64 }; };
+    const ctx: DockChartContext = {
+        get collapsible() { return o.collapsible.value; },
+        get compactOnScroll() { return !!toValue(o.compactOnScroll); },
+        get past() { return past.value; },
+        get holds() { return holds.value; },
+        get heldFrom() { return heldFrom; },
