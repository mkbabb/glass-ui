+/* D2-F · static rungs carried by the user agent.
+ *
+ * A rung is a static box: no CSS transition, scroll or scalar owns the dock's
+ * geometry. Every rung change runs inside an element-scoped view transition on the
+ * dock's parent (GlassDock.vue `transition`), and the user agent interpolates the
+ * pseudo tree below. PRM, and an engine without element-scoped transitions, commit
+ * the rung in one frame (GlassDock.vue warns on the latter at mount).
+ */
+@layer components {
+    /* The plate is a stadium by the radius clamp in every rung. */
+    .glass-dock.shape-pill,
+    .glass-dock.shape-pill > .dock-plate {
+        border-radius: var(--radius-pill);
+    }
+    .glass-dock > .dock-plate {
+        container-type: size;
+    }
+    /* No rung scrolls: seats beyond capacity fold into the More seat. */
+    .glass-dock [data-dock-folded] {
+        display: none;
+    }
+    /* The compact rung is the whole geometry cascade one step down. */
+    .glass-dock.compact {
+        --dock-scale: calc(var(--ui-scale, 1) * 0.8);
+    }
+    /* The dock box is one group; seats keep identity inside it and the UA FLIPs them.
+       The names exist ONLY while a rung transition runs: in Chromium an element with a
+       `view-transition-name` is a backdrop root, so a resting name on the dock would
+       cut the plate's lens off from the page behind it (measured: stripe sharpness
+       28.00 under the plate with the name, 0.23 without). */
+    .glass-dock[data-rung-transition] {
+        view-transition-name: dock-box;
+        view-transition-group: contain;
+    }
+    .glass-dock[data-rung-transition] > .dock-plate {
+        view-transition-name: dock-plate;
+    }
+    .glass-dock[data-rung-transition] :is(.dock-icon-button, .dock-tab-button, .dock-trigger) {
+        view-transition-name: match-element;
+    }
+    /* The pseudo tree hangs off the scope (the dock's parent), on the dock spring. */
+    :has(> .glass-dock)::view-transition-group(*) {
+        animation-duration: var(--spring-dock-duration);
+        animation-timing-function: var(--spring-dock);
+    }
+    :has(> .glass-dock)::view-transition-group-children(dock-box) {
+        overflow: clip;
+        border-radius: var(--dock-vt-plate-radius);
+    }
+    /* The plate is painted by its group, never by a snapshot: a snapshot of either
+       endpoint cannot fill an interpolated box without gaps (`none`) or a stretched
+       corner (`fill`). The border is the plate's own width and colour, inset. */
+    :has(> .glass-dock)::view-transition-group(dock-plate) {
+        background: var(--dock-vt-plate-bg);
+        box-shadow: inset 0 0 0 var(--dock-vt-plate-border-width) var(--dock-vt-plate-border);
+        border-radius: var(--dock-vt-plate-radius);
+        /* The group inherits from the scope, which the dock does not own: its paint
+           must not hang on the scope's visibility. */
+        visibility: visible;
+    }
+    :has(> .glass-dock)::view-transition-old(dock-plate),
+    :has(> .glass-dock)::view-transition-new(dock-plate) {
+        animation: none;
+        opacity: 0;
+    }
+    :has(> .glass-dock)::view-transition-old(*),
+    :has(> .glass-dock)::view-transition-new(*) {
+        inline-size: 100%;
+        block-size: 100%;
+        object-fit: none;
+    }
+    /* The rim: a static seat inside the plate, inset so it clears the corner. At
+       0.6 · 50cqmin from each end, a 4px-deep rim stays inside the stadium for any
+       radius up to 47.9px. */
+    .glass-dock .dock-rim {
+        position: absolute;
+        inset-block-end: 4px;
+        block-size: 3px;
+        inset-inline: calc(0.6 * 50cqmin);
+        border-radius: 1.5px;
+        overflow: clip;
+        background: color-mix(in oklab, var(--foreground) 18%, transparent);
+        pointer-events: none;
+    }
+    .glass-dock.vertical .dock-rim {
+        inset-block: calc(0.6 * 50cqmin);
+        inset-inline: auto 4px;
+        inline-size: 3px;
+        block-size: auto;
+    }
+    .glass-dock .dock-rim-fill {
+        position: absolute;
+        inset: 0;
+        background: var(--primary);
+        transform-origin: left center;
+        animation: gl-dock-rim-x linear both;
+        animation-timeline: scroll(root block);
+    }
+    .glass-dock.vertical .dock-rim-fill {
+        transform-origin: center top;
+        animation-name: gl-dock-rim-y;
+    }
+}
+@keyframes gl-dock-rim-x {
+    from { transform: scaleX(0); }
+    to { transform: scaleX(1); }
+}
+@keyframes gl-dock-rim-y {
+    from { transform: scaleY(0); }
+    to { transform: scaleY(1); }
+}
