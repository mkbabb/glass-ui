new file mode 100644
index 00000000..a19b6660
--- /dev/null
+++ b/src/components/dock/styles/aperture.css
@@ -0,0 +1,341 @@
+/* The dock aperture: the total lattice (D2-A).
+ *
+ * Every moving dock length is a closed form of tokens and one scalar that CSS owns.
+ * The script measures nothing; its only write is the posture class.
+ *
+ *   t      `--dock-extent-t`, registered, 1 expanded / 0 collapsed, transitioned on the
+ *          dock spring's own clock.
+ *   c      the compaction: a scroll-driven ramp times an engagement gate.
+ *   a      clamp(0, min(t, 1 − c), 1), the aperture's openness.
+ *   E_c    the collapsed extent, max(cross, n_c·seat + (n_c − 1)·gap + 2·pad), with n_c
+ *          counted by `:has()` rungs (an ancestor cannot read `sibling-count()`).
+ *   span   (1 − a)·(W − E_c), the length the aperture gives up, split by the anchor s.
+ *
+ * The box keeps the expanded footprint in layout at every posture. The expanded end of
+ * the aperture is the in-flow box itself, so a posture morph needs no seat lattice.
+ * One closed form is stamped on two boxes:
+ *   1. the plate's insets: the plate IS the visible dock, so its border, elevation
+ *      and rim follow it (a clip on the plate would cut the border off the caps);
+ *   2. the controls row: a glide `translate` and a clip in the row's own box.
+ * No wrapper: a clip on an ancestor of the plate is its backdrop root. */
+
+@property --dock-extent-t {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 1;
+}
+
+@property --dock-c-scroll {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+@property --dock-c-gate {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 1;
+}
+
+/* The two cap radii the cut animates (run.css). */
+@property --dock-cap-s {
+    syntax: "<length>";
+    inherits: false;
+    initial-value: 0px;
+}
+
+@property --dock-cap-e {
+    syntax: "<length>";
+    inherits: false;
+    initial-value: 0px;
+}
+
+@property --dock-rim-p {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+
+@layer components {
+    .glass-dock:is(.horizontal, .vertical) {
+        /* Concentric: one pad on every side, the corner half the cross. */
+        --dock-pad: var(--dock-padding-block, 0.5rem);
+        --dock-cross: calc(var(--dock-seat) + 2 * var(--dock-pad));
+        --dock-corner: calc(var(--dock-cross) / 2);
+
+        --dock-n-ps: 0;
+        --dock-n-sum: 1;
+        --dock-n-pe: 0;
+        --dock-n-c: calc(var(--dock-n-ps) + var(--dock-n-sum) + var(--dock-n-pe));
+        --dock-extent-c: max(
+            var(--dock-cross),
+            calc(
+                var(--dock-n-c) * var(--dock-seat) +
+                    max(0, var(--dock-n-c) - 1) * var(--dock-layer-gap) + 2 *
+                    var(--dock-pad)
+            )
+        );
+
+        --dock-s: 0.5;
+        --dock-c: calc(var(--dock-c-scroll) * var(--dock-c-gate));
+        --dock-a: clamp(0, min(var(--dock-extent-t), 1 - var(--dock-c)), 1);
+        /* `100%` resolves where the token is read: the plate's containing block. */
+        --dock-span: calc((1 - var(--dock-a)) * (100% - var(--dock-extent-c)));
+        --dock-expand-t: var(--dock-extent-t);
+        /* How far a seat paints past its box: the hover scale's growth plus the ring,
+           scaled (6.4px at the base rung). It must stay within the pad. */
+        --dock-paint-reach: calc(
+            (var(--scale-hover-dock) - 1) * var(--dock-seat) / 2 +
+                var(--scale-hover-dock) * var(--dock-ring-reserve)
+        );
+
+        padding: var(--dock-pad);
+        transition:
+            --dock-extent-t var(--spring-dock-duration) var(--spring-dock),
+            --dock-c-gate var(--spring-dock-duration) var(--spring-dock) 150ms;
+    }
+
+    .glass-dock.collapsed {
+        --dock-extent-t: 0;
+    }
+
+    .glass-dock[data-anchor="start"] {
+        --dock-s: 0;
+    }
+
+    .glass-dock[data-anchor="end"] {
+        --dock-s: 1;
+    }
+
+    .glass-dock.shape-rounded {
+        --dock-corner: var(--radius-card);
+    }
+
+    .glass-dock.shape-card {
+        --dock-corner: calc(
+            var(--dock-cross) / 2 +
+                (var(--dock-card-radius) - var(--dock-cross) / 2) * var(--dock-expand-t)
+        );
+    }
+
+    /* n_c, the seats the collapsed aperture shows: the persistent regions and a
+       non-empty summary. The table is bounded at 3 per region. */
+    .glass-dock:has(> .dock-controls > .dock-persistent:not(.dock-persistent-end) > :nth-child(1)) {
+        --dock-n-ps: 1;
+    }
+    .glass-dock:has(> .dock-controls > .dock-persistent:not(.dock-persistent-end) > :nth-child(2)) {
+        --dock-n-ps: 2;
+    }
+    .glass-dock:has(> .dock-controls > .dock-persistent:not(.dock-persistent-end) > :nth-child(3)) {
+        --dock-n-ps: 3;
+    }
+    .glass-dock:has(> .dock-controls > .dock-persistent-end > :nth-child(1)) {
+        --dock-n-pe: 1;
+    }
+    .glass-dock:has(> .dock-controls > .dock-persistent-end > :nth-child(2)) {
+        --dock-n-pe: 2;
+    }
+    .glass-dock:has(> .dock-controls > .dock-persistent-end > :nth-child(3)) {
+        --dock-n-pe: 3;
+    }
+    .glass-dock:has(> .dock-controls > .dock-layers > .dock-layer--summary:empty) {
+        --dock-n-sum: 0;
+    }
+
+    /* ── The plate: the aperture itself ─────────────────────────────────────────── */
+    .glass-dock > .dock-plate {
+        --dock-cap-s: var(--dock-corner);
+        --dock-cap-e: var(--dock-corner);
+        border-radius: var(--dock-cap-s) var(--dock-cap-e) var(--dock-cap-e)
+            var(--dock-cap-s);
+        overflow: clip;
+        box-shadow:
+            var(--glass-rim-top), var(--glass-rim-bottom),
+            var(--shadow-dock-override, var(--shadow-dock));
+    }
+
+    .glass-dock.vertical > .dock-plate {
+        border-radius: var(--dock-cap-s) var(--dock-cap-s) var(--dock-cap-e)
+            var(--dock-cap-e);
+    }
+
+    .glass-dock.collapsed > .dock-plate {
+        box-shadow: var(--shadow-dock-override, var(--shadow-dock-collapsed));
+    }
+
+    .glass-dock.collapsed:hover > .dock-plate {
+        box-shadow: var(--shadow-dock-override, var(--shadow-dock));
+    }
+
+    .glass-dock:not(.vertical) > .dock-plate {
+        left: calc(var(--dock-s) * var(--dock-span));
+        right: calc((1 - var(--dock-s)) * var(--dock-span));
+    }
+
+    .glass-dock.vertical > .dock-plate {
+        top: calc(var(--dock-s) * var(--dock-span));
+        bottom: calc((1 - var(--dock-s)) * var(--dock-span));
+    }
+
+    /* ── The controls row: a real box, so it can glide and clip ────────────────── */
+    .glass-dock > .dock-controls {
+        display: flex;
+        align-items: center;
+        flex: 1 1 auto;
+        min-inline-size: 0;
+        min-block-size: 0;
+    }
+
+    .glass-dock.vertical > .dock-controls {
+        flex-direction: column;
+        align-items: stretch;
+        gap: var(--dock-layer-gap, 0.375rem);
+    }
+
+    /* The full face stays in flow at every posture (it is the expanded footprint);
+       the summary sits out of flow at the run's start, where the glide brings it. */
+    .glass-dock > .dock-controls > .dock-layers {
+        position: relative;
+    }
+
+    .glass-dock > .dock-controls > .dock-layers > .dock-layer--full {
+        position: relative;
+        inset: auto;
+    }
+
+    .glass-dock > .dock-controls > .dock-layers > .dock-layer--summary {
+        position: absolute;
+        inset: 0 auto 0 0;
+    }
+
+    .glass-dock.vertical > .dock-controls > .dock-layers > .dock-layer--summary {
+        inset: 0 0 auto 0;
+    }
+
+    /* The glide and the clip exist only while the aperture is narrower than the box.
+       At expanded rest the row is transform-free and unclipped: no containing block
+       for anchored surfaces, no backdrop root over the seats' own lenses. */
+    .glass-dock:is(.collapsed, [data-morphing], [data-compact-on-scroll]) > .dock-controls {
+        --dock-row-span: calc(
+            (1 - var(--dock-a)) * (100% + 2 * var(--dock-pad) - var(--dock-extent-c))
+        );
+        --dock-row-out: calc(-1 * var(--dock-pad));
+        --dock-row-cut: calc(var(--dock-row-span) - var(--dock-pad));
+        translate: calc(var(--dock-s) * var(--dock-row-span)) 0;
+        clip-path: inset(
+            var(--dock-row-out) var(--dock-row-cut) var(--dock-row-out)
+                var(--dock-row-out) round var(--dock-corner)
+        );
+    }
+
+    .glass-dock.vertical:is(.collapsed, [data-morphing], [data-compact-on-scroll])
+        > .dock-controls {
+        translate: 0 calc(var(--dock-s) * var(--dock-row-span));
+        clip-path: inset(
+            var(--dock-row-out) var(--dock-row-out) var(--dock-row-cut)
+                var(--dock-row-out) round var(--dock-corner)
+        );
+    }
+
+    /* The trailing persistent region lands beside the summary when the aperture closes
+       (horizontal; `100%` is the row). */
+    .glass-dock:not(.vertical) > .dock-controls > .dock-persistent-end {
+        position: relative;
+        left: calc(
+            -1 * (1 - var(--dock-a)) *
+                (100% + 2 * var(--dock-pad) - var(--dock-extent-c))
+        );
+    }
+
+    /* ── P2 · the paint gutter: the active run's padding box reaches the seats' paint on
+       both axes (a scroll container clips to its padding box), and an equal negative
+       margin keeps the footprint. Scroll padding keeps the half-pitch snap line. */
+    .glass-dock .dock-run.is-active {
+        padding: var(--dock-paint-reach);
+        margin: calc(-1 * var(--dock-paint-reach));
+        scroll-padding-inline: calc(var(--dock-pitch) / 2 + var(--dock-paint-reach));
+    }
+
+    .glass-dock.vertical .dock-run.is-active {
+        padding: var(--dock-paint-reach);
+        margin: calc(-1 * var(--dock-paint-reach));
+        scroll-padding-inline: 0;
+        scroll-padding-block: calc(var(--dock-pitch) / 2 + var(--dock-paint-reach));
+    }
+
+    /* ── P4 · compaction: a scroll ramp times an engagement gate ──────────────────
+       `data-compact-on-scroll` is set by the binder only after it binds `--dock-page`,
+       so an unbound timeline can never compact the dock. */
+    .glass-dock[data-compact-on-scroll] {
+        animation: gl-dock-compact linear both;
+        animation-timeline: var(--dock-page);
+        animation-range: 0 var(--dock-compact-distance, 200px);
+    }
+
+    .glass-dock:is(:focus-within, [data-held], [data-kept-open]) {
+        --dock-c-gate: 0;
+        transition-delay: 0s;
+    }
+
+    @media (hover: hover) {
+        .glass-dock:hover {
+            --dock-c-gate: 0;
+            transition-delay: 0s;
+        }
+    }
+
+    /* ── P5 · the rim: a child of the plate, clipped by the plate's own radius ──── */
+    .glass-dock > .dock-plate > .dock-rim {
+        position: absolute;
+        inset: 0;
+        pointer-events: none;
+        --dock-rim-fill: linear-gradient(
+            var(--dock-rim-color, var(--rainbow-violet)),
+            var(--dock-rim-color, var(--rainbow-violet))
+        );
+        --dock-rim-track: linear-gradient(
+            color-mix(in srgb, var(--foreground) 14%, transparent),
+            color-mix(in srgb, var(--foreground) 14%, transparent)
+        );
+        /* The fill over its track: the rim is visible at progress 0. */
+        background:
+            var(--dock-rim-fill) no-repeat left bottom / calc(var(--dock-rim-p) * 100%)
+                var(--dock-rim-width, 3px),
+            var(--dock-rim-track) no-repeat left bottom / 100% var(--dock-rim-width, 3px);
+        animation: gl-dock-rim linear both;
+        animation-timeline: var(--dock-page);
+    }
+
+    .glass-dock.vertical > .dock-plate > .dock-rim {
+        background-position: right top, right top;
+        background-size:
+            var(--dock-rim-width, 3px) calc(var(--dock-rim-p) * 100%),
+            var(--dock-rim-width, 3px) 100%;
+    }
+}
+
+@keyframes gl-dock-compact {
+    from {
+        --dock-c-scroll: 0;
+    }
+    to {
+        --dock-c-scroll: 1;
+    }
+}
+
+@keyframes gl-dock-rim {
+    from {
+        --dock-rim-p: 0;
+    }
+    to {
+        --dock-rim-p: 1;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    @layer components {
+        .glass-dock:is(.horizontal, .vertical) {
+            transition-duration: 0s;
+        }
+    }
+}
