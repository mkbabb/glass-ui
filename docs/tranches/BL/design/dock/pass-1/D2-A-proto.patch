index 00000000..d73674c5
--- /dev/null
+++ b/src/components/dock/composables/useDockScrollTimeline.ts
@@ -0,0 +1,89 @@
+import { onScopeDispose, ref, watch } from "vue";
+import type { Ref } from "vue";
+
+/** A scroll source: an element, the window, or a getter resolved after mount. Never a
+ *  selector. */
+export type DockScrollSource =
+    | HTMLElement
+    | Window
+    | (() => HTMLElement | Window | null)
+    | null;
+
+export interface UseDockScrollTimelineOptions {
+    rootEl: Ref<HTMLElement | null>;
+    /** The source prop; `undefined` means the document's own scroll. */
+    source: () => DockScrollSource | undefined;
+    /** Whether anything on the dock reads the timeline (compaction or the rim). */
+    wanted: () => boolean;
+    /** A stable per-dock id for the timeline name. */
+    id: string;
+}
+
+function resolve(source: DockScrollSource | undefined): HTMLElement | Window | null {
+    if (source === undefined) return typeof window === "undefined" ? null : window;
+    return typeof source === "function" ? source() : source;
+}
+
+/** Append `entry` to a comma list held in one inline property, keeping what is there. */
+function appendList(el: HTMLElement, prop: string, entry: string): () => void {
+    const before = el.style.getPropertyValue(prop);
+    const computed = getComputedStyle(el).getPropertyValue(prop).trim();
+    const base = before || (computed && computed !== "none" ? computed : "");
+    el.style.setProperty(prop, base ? `${base}, ${entry}` : entry);
+    return () => {
+        if (before) el.style.setProperty(prop, before);
+        else el.style.removeProperty(prop);
+    };
+}
+
+/**
+ * Bind the dock's `--dock-page` timeline to its scroll source. The window binds the
+ * root timeline. An element gets a named `scroll-timeline`, appended to its own list,
+ * and the name is scoped on `:root`, appended to that list. `bound` turns true only
+ * after the binding lands, so CSS that reads the timeline can be gated on it; an
+ * unresolved source logs an error and leaves the dock full.
+ */
+export function useDockScrollTimeline(options: UseDockScrollTimelineOptions): {
+    bound: Readonly<Ref<boolean>>;
+} {
+    const bound = ref(false);
+    let undo: Array<() => void> = [];
+
+    function unbind(): void {
+        for (const u of undo.reverse()) u();
+        undo = [];
+        options.rootEl.value?.style.removeProperty("--dock-page");
+        bound.value = false;
+    }
+
+    function bind(): void {
+        unbind();
+        const root = options.rootEl.value;
+        if (!root || !options.wanted()) return;
+        const target = resolve(options.source());
+        if (!target) {
+            console.error(
+                "[GlassDock] scrollSource resolved to null: compactOnScroll and progressRim stay unbound",
+            );
+            return;
+        }
+        if (target instanceof Window) {
+            root.style.setProperty("--dock-page", "scroll(root block)");
+        } else {
+            const name = `--dock-page-${options.id.replace(/[^\w-]/g, "")}`;
+            undo.push(appendList(target, "scroll-timeline-name", name));
+            undo.push(appendList(target, "scroll-timeline-axis", "block"));
+            undo.push(appendList(document.documentElement, "timeline-scope", name));
+            root.style.setProperty("--dock-page", name);
+        }
+        bound.value = true;
+    }
+
+    watch([options.rootEl, () => options.source(), () => options.wanted()], bind, {
+        flush: "post",
+        immediate: true,
+    });
+    onScopeDispose(unbind);
+
+    return { bound };
+}
