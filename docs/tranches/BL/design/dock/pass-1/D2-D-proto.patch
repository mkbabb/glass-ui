+    rimEl: Ref<SVGSVGElement | null>;
+    source: Ref<DockProgressSource>;
+    axis: Ref<"horizontal" | "vertical">;
+    /** True while the extent morph runs; the rim follows the extent every frame. */
+    morphing: Ref<boolean>;
+}
+
+/** Inset of the rim's centre line from the silhouette: edge 1.5 + gap 1.5 + half the 3px stroke. */
+const RIM_INSET = 4.5;
+
+const px = (style: CSSStyleDeclaration, name: string): number =>
+    Number.parseFloat(style.getPropertyValue(name));
+
+/**
+ * The leading half of the silhouette, inset by RIM_INSET, in the dock box's pixel space:
+ * horizontal from 9 o'clock round the bottom to 3 o'clock, vertical from 12 o'clock down
+ * the trailing side to 6 o'clock. It reads the same inputs the CSS path reads (the extent,
+ * the anchor and the frame's resolved per-end radii), so it tracks the cut and the morph.
+ */
+function rimPathD(
+    W: number,
+    H: number,
+    e: number,
+    a: number,
+    rs: number,
+    re: number,
+    vertical: boolean,
+): string {
+    const i = RIM_INSET;
+    const qs = Math.max(0, rs - i);
+    const qe = Math.max(0, re - i);
+    if (vertical) {
+        const y0 = (H - e) * a;
+        const y1 = y0 + e;
+        const c = W / 2;
+        return `M ${c} ${y0 + i} H ${W - rs} A ${qs} ${qs} 0 0 1 ${W - i} ${y0 + rs} V ${y1 - re} A ${qe} ${qe} 0 0 1 ${W - re} ${y1 - i} H ${c}`;
+    }
+    const x0 = (W - e) * a;
+    const x1 = x0 + e;
+    const c = H / 2;
+    return `M ${x0 + i} ${c} V ${H - rs} A ${qs} ${qs} 0 0 0 ${x0 + rs} ${H - i} H ${x1 - re} A ${qe} ${qe} 0 0 0 ${x1 - i} ${H - re} V ${c}`;
+}
+
+/**
+ * The dock's own progress rim. Geometry is written as an attribute (the CSS `d` property
+ * takes no `shape()` on either engine); progress is written as `--dock-progress` and read
+ * by `stroke-dashoffset` against `pathLength="1"`. The rim sits inside the plate's clip.
+ */
+export function useDockRim(options: UseDockRimOptions): void {
+    const { rootEl, frameEl, runEl, rimEl, source, axis, morphing } = options;
+    let ro: ResizeObserver | null = null;
+    let mo: MutationObserver | null = null;
+    let raf = 0;
+    let pending = 0;
+    const detachers: Array<() => void> = [];
+
+    function resolve(): HTMLElement | Window | null {
+        const s = source.value;
+        return (typeof s === "function" ? s() : s) ?? null;
+    }
+
+    function draw(): void {
+        const root = rootEl.value;
+        const frame = frameEl.value;
+        const svg = rimEl.value;
+        if (!root || !frame || !svg) return;
+        const vertical = axis.value === "vertical";
+        const W = root.offsetWidth;
+        const H = root.offsetHeight;
+        const rootStyle = getComputedStyle(root);
+        const frameStyle = getComputedStyle(frame);
+        const e = root.hasAttribute("data-morphing")
+            ? px(rootStyle, "--dock-live")
+            : vertical
+              ? H
+              : W;
+        const d = rimPathD(
+            W,
+            H,
+            e,
+            px(rootStyle, "--dock-a"),
+            px(frameStyle, "--dock-sil-rs"),
+            px(frameStyle, "--dock-sil-re"),
+            vertical,
+        );
+        svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
+        for (const path of svg.querySelectorAll("path")) path.setAttribute("d", d);
+    }
+
+    function progressOf(s: HTMLElement | Window): number {
+        const el =
+            s instanceof Window ? (document.scrollingElement ?? document.documentElement) : s;
+        const range = el.scrollHeight - el.clientHeight;
+        return range > 0 ? Math.min(1, Math.max(0, el.scrollTop / range)) : 0;
+    }
+
+    /* A scroll event runs before the frame's animation update, so κ (a scroll-driven
+       value) is read on the next frame, when the timeline has caught up. */
+    function schedule(): void {
+        if (!pending) pending = requestAnimationFrame(() => ((pending = 0), draw()));
+    }
+
+    function listen(target: EventTarget, fn: () => void): void {
+        target.addEventListener("scroll", fn, { passive: true });
+        detachers.push(() => target.removeEventListener("scroll", fn));
+    }
+
+    function attach(): void {
+        for (const off of detachers.splice(0)) off();
+        ro?.disconnect();
+        mo?.disconnect();
+        ro = null;
+        mo = null;
+        const root = rootEl.value;
+        const s = resolve();
+        if (!root || !s || !rimEl.value) return;
+        const write = () => root.style.setProperty("--dock-progress", `${progressOf(s)}`);
+        listen(s, write);
+        write();
+        ro = new ResizeObserver(draw);
+        ro.observe(root);
+        const run = runEl.value;
+        if (run) {
+            // κ moves when the run scrolls, resizes, or gains or loses seats.
+            listen(run, schedule);
+            ro.observe(run);
+            // New seats lay out after this frame's rAF, and the timeline sees the new
+            // range on the frame after that: read there.
+            mo = new MutationObserver(() => requestAnimationFrame(schedule));
+            mo.observe(run, { childList: true });
+        }
+        draw();
+    }
+
+    function follow(): void {
+        draw();
+        raf = morphing.value ? requestAnimationFrame(follow) : 0;
+    }
+
+    watch([rootEl, frameEl, runEl, rimEl, source, axis], attach, {
+        immediate: true,
+        flush: "post",
+    });
+    watch(morphing, (on) => {
+        cancelAnimationFrame(raf);
+        raf = 0;
+        if (on) raf = requestAnimationFrame(follow);
+        else draw();
+    });
+    onScopeDispose(() => {
+        for (const off of detachers.splice(0)) off();
+        ro?.disconnect();
+        mo?.disconnect();
+        cancelAnimationFrame(raf);
+        cancelAnimationFrame(pending);
+    });
+}
diff --git a/src/components/dock/styles/silhouette.css b/src/components/dock/styles/silhouette.css
new file mode 100644
index 00000000..e5e200ab
--- /dev/null
+++ b/src/components/dock/styles/silhouette.css
@@ -0,0 +1,393 @@
+/* The drawn silhouette.
+ *
+ * The plate is one parametric shape S(e, a, cross, κs, κe, orientation), written ONCE below
+ * and resolved on each element that needs it: the glass (`.dock-plate`), its drawn edge
+ * (`.dock-edge`, the complement of S inset by the edge width), the elevation
+ * (`.dock-shadow`, the complement of S, over a fill of S) and, while the extent morphs,
+ * the face aperture (`.dock-controls`). Every one of those boxes is the dock's own box, so
+ * the path's percentages agree. The rim (useDockRim) is the one other derivation: an SVG
+ * attribute, because the CSS `d` property takes no `shape()` on either engine.
+ *
+ * Inputs, one owner each:
+ *   cross  `--dock-cross-px`, the layout cross extent (dockMorphMeasure, per resize);
+ *   e      the main extent: `100%` at rest, `--dock-live` (layers.css) while morphing;
+ *   a      the anchor, 0 · ½ · 1 from `data-anchor`: where e sits inside the reserved box;
+ *   κ      `--dock-ks`/`--dock-ke`, the run's scroll timeline on `.dock-frame`;
+ *   rest, cut  the shape's rest radius and its cut radius, below.
+ *
+ * The hit region is the silhouette ∪ the seats: the root is `pointer-events: none` and the
+ * clip removes everything outside the path from hit testing. */
+
+@property --dock-ks {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+@property --dock-ke {
+    syntax: "<number>";
+    inherits: false;
+    initial-value: 0;
+}
+/* Registered so the rim reads resolved pixels, not a token stream. Declared on the box
+   (κ = 0, the aperture's radii) and on the frame (κ live, the plate's radii). */
+@property --dock-sil-rs {
+    syntax: "<length>";
+    inherits: false;
+    initial-value: 0px;
+}
+@property --dock-sil-re {
+    syntax: "<length>";
+    inherits: false;
+    initial-value: 0px;
+}
+/* The spring's main extent in pixels (layers.css declares it while morphing). */
+@property --dock-live {
+    syntax: "<length>";
+    inherits: false;
+    initial-value: 0px;
+}
+
+@layer components {
+    .glass-dock {
+        pointer-events: none;
+        --dock-e: 100%;
+        --dock-a: 0.5;
+        --dock-align: center;
+        /* rest and cut per shape. The cut is two rungs down the 4 · 10 · 16 · 24 ·
+           stadium series (run.css, the cut cap). */
+        --dock-sil-rest: 9999px;
+        --dock-sil-cut: var(--radius-card);
+    }
+    .glass-dock.shape-rounded {
+        --dock-sil-rest: var(--radius-card);
+        --dock-sil-cut: var(--radius-xs);
+    }
+    .glass-dock.shape-card {
+        --dock-sil-rest: calc(
+            var(--dock-cross-px) / 2 +
+                (var(--dock-card-radius) - var(--dock-cross-px) / 2) * var(--dock-expand-t)
+        );
+        --dock-sil-cut: var(--radius-lg);
+    }
+    .glass-dock[data-anchor="start"] {
+        --dock-a: 0;
+        --dock-align: start;
+    }
+    .glass-dock[data-anchor="end"] {
+        --dock-a: 1;
+        --dock-align: end;
+    }
+    .glass-dock[data-morphing] {
+        --dock-e: var(--dock-live);
+    }
+    .glass-dock:not(.vertical) {
+        --dock-ex: var(--dock-e);
+        --dock-ey: 100%;
+    }
+    .glass-dock.vertical {
+        --dock-ex: 100%;
+        --dock-ey: var(--dock-e);
+    }
+
+    /* The corner radii, r = clamp(0, rest, cross/2) so no spring value can overshoot a
+       corner past the half-cross or below zero, each end cut by its κ. */
+    .glass-dock,
+    .dock-frame {
+        --dock-sil-r: clamp(0px, var(--dock-sil-rest), calc(var(--dock-cross-px) / 2));
+        --dock-sil-k: min(var(--dock-sil-cut), var(--dock-sil-r));
+        --dock-sil-rs: calc(
+            var(--dock-sil-r) + (var(--dock-sil-k) - var(--dock-sil-r)) * var(--dock-ks)
+        );
+        --dock-sil-re: calc(
+            var(--dock-sil-r) + (var(--dock-sil-k) - var(--dock-sil-r)) * var(--dock-ke)
+        );
+    }
+    .glass-dock:not(.vertical),
+    .glass-dock:not(.vertical) > .dock-frame {
+        --dock-r-tl: var(--dock-sil-rs);
+        --dock-r-bl: var(--dock-sil-rs);
+        --dock-r-tr: var(--dock-sil-re);
+        --dock-r-br: var(--dock-sil-re);
+    }
+    .glass-dock.vertical,
+    .glass-dock.vertical > .dock-frame {
+        --dock-r-tl: var(--dock-sil-rs);
+        --dock-r-tr: var(--dock-sil-rs);
+        --dock-r-bl: var(--dock-sil-re);
+        --dock-r-br: var(--dock-sil-re);
+    }
+
+    /* THE PATH — written once, resolved on each element against its own inset --dock-i. */
+    .dock-plate,
+    .dock-edge,
+    .dock-shadow,
+    .dock-shadow > i,
+    .glass-dock[data-morphing] > .dock-controls {
+        --x0: calc((100% - var(--dock-ex)) * var(--dock-a) + var(--dock-i, 0px));
+        --x1: calc((100% - var(--dock-ex)) * var(--dock-a) + var(--dock-ex) - var(--dock-i, 0px));
+        --y0: calc((100% - var(--dock-ey)) * var(--dock-a) + var(--dock-i, 0px));
+        --y1: calc((100% - var(--dock-ey)) * var(--dock-a) + var(--dock-ey) - var(--dock-i, 0px));
+        --tl: max(0px, var(--dock-r-tl) - var(--dock-i, 0px));
+        --tr: max(0px, var(--dock-r-tr) - var(--dock-i, 0px));
+        --br: max(0px, var(--dock-r-br) - var(--dock-i, 0px));
+        --bl: max(0px, var(--dock-r-bl) - var(--dock-i, 0px));
+        --dock-sil-from: calc(var(--x0) + var(--tl)) var(--y0);
+        --dock-sil-cmds:
+            hline to calc(var(--x1) - var(--tr)),
+            arc to var(--x1) calc(var(--y0) + var(--tr)) of var(--tr) cw,
+            vline to calc(var(--y1) - var(--br)),
+            arc to calc(var(--x1) - var(--br)) var(--y1) of var(--br) cw,
+            hline to calc(var(--x0) + var(--bl)),
+            arc to var(--x0) calc(var(--y1) - var(--bl)) of var(--bl) cw,
+            vline to calc(var(--y0) + var(--tl)),
+            arc to calc(var(--x0) + var(--tl)) var(--y0) of var(--tl) cw,
+            close;
+        /* S itself is always a rounded rectangle, so its fill is `inset(… round …)` over
+           the same inputs; only the complement needs the command list (evenodd). The
+           fill must not be `shape()`: on `.dock-plate` in this DOM, Chromium 149 paints a
+           `shape()` clip as its bounding rectangle whenever the plate carries no
+           backdrop-filter (a reduced-transparency or static plate), while `inset(round)`
+           paints the arcs in both states. */
+        --dock-sil: inset(
+            var(--y0) calc(100% - var(--x1)) calc(100% - var(--y1)) var(--x0) round var(--tl)
+                var(--tr) var(--br) var(--bl)
+        );
+        --dock-sil-outside: shape(
+            evenodd from -64px -64px,
+            hline to calc(100% + 64px),
+            vline to calc(100% + 64px),
+            hline to -64px,
+            close,
+            move to var(--dock-sil-from),
+            var(--dock-sil-cmds)
+        );
+    }
+
+    /* L0's box. It carries κ (the one scroll-timeline reader) and stacks under the
+       controls. Each end's cut is proportional to what that end hides, saturating at one
+       pitch: a run that overflows by 2px under a hover scale cuts its corner by 2/P of
+       the drop, not all of it. */
+    .dock-frame {
+        position: absolute;
+        inset: 0;
+        z-index: -1;
+        pointer-events: none;
+        animation:
+            gl-dock-kappa-start linear both,
+            gl-dock-kappa-end linear both;
+        animation-timeline: --dock-run, --dock-run;
+        animation-range:
+            0 var(--dock-pitch),
+            calc(100% - var(--dock-pitch)) 100%;
+    }
+    /* A morph lays the run out against an endpoint, not a settled budget, so an overflow
+       seen mid-morph is transient: κ holds at 0 until the posture seats. */
+    .glass-dock[data-morphing] > .dock-frame {
+        animation: none;
+    }
+
+    .dock-plate {
+        clip-path: var(--dock-sil);
+        /* The same radii as the path, for the one state that drops the clip (the grasp
+           hold, dock.css). */
+        border-start-start-radius: var(--dock-r-tl);
+        border-start-end-radius: var(--dock-r-tr);
+        border-end-end-radius: var(--dock-r-br);
+        border-end-start-radius: var(--dock-r-bl);
+        box-shadow: var(--glass-rim-top), var(--glass-rim-bottom);
+    }
+
+    /* The drawn edge: everything outside S inset by the edge width, bounded by the
+       plate's own clip. Two layers, one per rung, so no value nests two translucent
+       `color-mix()` arms (the Playwright WebKit crash signature, HARNESS.md §4). At
+       these alphas (≤ 8%) the pair departs from a true lerp by under 0.1 of a
+       percentage point mid-morph, and is exact at both rests. */
+    .dock-edge {
+        position: absolute;
+        inset: 0;
+        pointer-events: none;
+        --dock-i: 1.5px;
+        clip-path: var(--dock-sil-outside);
+    }
+    .dock-edge::before,
+    .dock-edge::after {
+        content: "";
+        position: absolute;
+        inset: 0;
+    }
+    .dock-edge::before {
+        background: var(--dock-plate-collapsed-border);
+        opacity: calc(1 - var(--dock-expand-t));
+    }
+    .dock-edge::after {
+        background: var(--dock-plate-expanded-border);
+        opacity: var(--dock-expand-t);
+    }
+
+    /* The elevation: a sibling layer (never an ancestor filter: the backdrop-root fence)
+       whose fill is S and whose own clip keeps only what falls outside S. `drop-shadow`
+       takes a standard deviation, so it reads the σ tokens `--shadow-dock` derives from. */
+    .dock-shadow {
+        position: absolute;
+        inset: 0;
+        pointer-events: none;
+        --dock-lift: var(--dock-expand-t);
+        filter: drop-shadow(
+            0 0
+                calc(
+                    var(--shadow-dock-sigma-collapsed) +
+                        (var(--shadow-dock-sigma) - var(--shadow-dock-sigma-collapsed)) *
+                        var(--dock-lift)
+                )
+                color-mix(
+                    in srgb,
+                    var(--shadow-color)
+                        calc(
+                            var(--shadow-dock-ink-collapsed) +
+                                (var(--shadow-dock-ink) - var(--shadow-dock-ink-collapsed)) *
+                                var(--dock-lift)
+                        ),
+                    transparent
+                )
+        );
+        clip-path: var(--dock-sil-outside);
+    }
+    .dock-shadow > i {
+        position: absolute;
+        inset: 0;
+        background: #000;
+        clip-path: var(--dock-sil);
+    }
+    /* A hovered collapsed pill lifts to the expanded elevation. */
+    @media (hover: hover) {
+        .glass-dock.collapsed:hover > .dock-frame > .dock-shadow {
+            --dock-lift: 1;
+        }
+    }
+
+    /* L1: a flex box whose border box IS the dock box (the dock's padding lives here), so
+       the face aperture can take the plate's path. */
+    .glass-dock > .dock-controls {
+        display: flex;
+        flex-direction: inherit;
+        align-items: inherit;
+        justify-content: inherit;
+        gap: inherit;
+        flex: 1 1 auto;
+        min-inline-size: 0;
+        min-block-size: 0;
+        box-sizing: border-box;
+        padding: var(--dock-pad-b) var(--dock-pad-i);
+        overflow: visible;
+        pointer-events: none;
+    }
+    /* Rectangular wrappers opt out of hit testing so the corners outside the arc reach
+       the page; what they hold opts back in. */
+    .glass-dock > .dock-controls .dock-layer.is-active,
+    .glass-dock > .dock-controls .dock-persistent {
+        pointer-events: none;
+    }
+    .glass-dock > .dock-controls .dock-layer.is-active *,
+    .glass-dock > .dock-controls .dock-persistent * {
+        pointer-events: auto;
+    }
+    .glass-dock > .dock-controls .dock-layer--summary.is-active {
+        pointer-events: auto;
+    }
+
+    /* THE LAYOUT RULE. Every face is laid out at its own extent and aligned on the
+       anchor; only the active face is in flow. An inactive face is out of flow at
+       `max-content` (so its size is its own before it is ever shown), and during the
+       morph the run does not grow into the reserved box, so the incoming face sits
+       where the settled box will put it, inside the silhouette, from its first frame. */
+    .glass-dock:not(.vertical) > .dock-controls > .dock-layers > .dock-layer:not(.is-active) {
+        inline-size: max-content;
+        justify-self: var(--dock-align);
+    }
+    .glass-dock.vertical > .dock-controls > .dock-layers > .dock-layer:not(.is-active) {
+        block-size: max-content;
+        align-self: var(--dock-align);
+    }
+    .glass-dock[data-morphing] > .dock-controls {
+        justify-content: var(--dock-align);
+        /* The aperture: faces are clipped by the same path only while the extent morphs;
+           at rest nothing clips a seat, so rings and hover capsules overhang freely. */
+        clip-path: var(--dock-sil);
+    }
+    .glass-dock[data-morphing] > .dock-controls > .dock-layers {
+        flex: 0 1 auto;
+    }
+    /* The persistent regions ride the silhouette's edges. The row is laid out in the
+       posture the morph is going to, so each region sits where it will land; it is
+       carried from there to the silhouette's live edge by the extent still to travel,
+       (e_target − e), split by the anchor. At settle the drift is zero. */
+    .glass-dock.expanded[data-morphing] {
+        --dock-e-target: var(--dock-expanded-px);
+    }
+    .glass-dock.collapsed[data-morphing] {
+        --dock-e-target: var(--dock-collapsed-px);
+    }
+    .glass-dock[data-morphing] {
+        --dock-drift: calc(var(--dock-e-target) - var(--dock-live));
+    }
+    .glass-dock[data-morphing]:not(.vertical)
+        > .dock-controls
+        > .dock-persistent:not(.dock-persistent-end) {
+        translate: calc(var(--dock-drift) * var(--dock-a)) 0;
+    }
+    .glass-dock[data-morphing]:not(.vertical) > .dock-controls > .dock-persistent-end {
+        translate: calc(var(--dock-drift) * (var(--dock-a) - 1)) 0;
+    }
+    .glass-dock[data-morphing].vertical
+        > .dock-controls
+        > .dock-persistent:not(.dock-persistent-end) {
+        translate: 0 calc(var(--dock-drift) * var(--dock-a));
+    }
+    .glass-dock[data-morphing].vertical > .dock-controls > .dock-persistent-end {
+        translate: 0 calc(var(--dock-drift) * (var(--dock-a) - 1));
+    }
+
+    /* The rim: a stroke on the silhouette's leading half, inside the plate's clip. */
+    .dock-rim {
+        position: absolute;
+        inset: 0;
+        inline-size: 100%;
+        block-size: 100%;
+        overflow: visible;
+        pointer-events: none;
+        fill: none;
+        stroke-width: 3px;
+        stroke-linecap: round;
+    }
+    .dock-rim > .dock-rim-track {
+        stroke: color-mix(in srgb, var(--foreground) 18%, transparent);
+    }
+    .dock-rim > .dock-rim-fill {
+        stroke: var(--primary);
+        stroke-dasharray: 1 1;
+        stroke-dashoffset: calc(1 - var(--dock-progress, 0));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .glass-dock[data-morphing] {
+            --dock-e: 100%;
+        }
+    }
+}
+
+@keyframes gl-dock-kappa-start {
+    from {
+        --dock-ks: 0;
+    }
+    to {
+        --dock-ks: 1;
+    }
+}
+@keyframes gl-dock-kappa-end {
+    from {
+        --dock-ke: 1;
+    }
+    to {
+        --dock-ke: 0;
+    }
+}
