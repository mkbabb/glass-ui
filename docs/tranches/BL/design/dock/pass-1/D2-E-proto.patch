--- /dev/null
+++ b/src/components/dock/composables/useDockProjection.ts
@@ -0,0 +1,115 @@
+import { onScopeDispose, watch, type Ref } from "vue";
+
+/** A seat of the run: a DockControl, a DockTrigger, or a consumer `[data-dock-seat]`. */
+const DOCK_SEAT_SELECTOR =
+    ".dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]";
+
+/** The plate's anchored insets: the four properties whose transition IS the morph. */
+const PLATE_INSETS = new Set(["top", "right", "bottom", "left"]);
+
+export interface UseDockProjectionOptions {
+    /** The `.glass-dock` root; it carries `[data-morphing]` while the plate moves. */
+    rootEl: Ref<HTMLElement | null>;
+    /** The anchored plate. */
+    plateEl: Ref<HTMLElement | null>;
+    /** The run (`.dock-run`), which scrolls only while its seats exceed its box. */
+    runEl: Ref<HTMLElement | null>;
+    orientation: Ref<"horizontal" | "vertical">;
+    /** Notifies the shell when the plate starts and stops moving. */
+    onMovingChange?: (moving: boolean) => void;
+}
+
+/**
+ * The two facts the anchored projection needs from script (D2-E):
+ *
+ * 1. THE WINDOW. The morph is the plate's own inset transition, so the window is that
+ *    transition: `transitionrun` opens it and `transitionend`/`transitioncancel` close
+ *    it, counted per inset property. There is no spring here and no measured endpoint:
+ *    the platform's anchor solver moves the plate whenever the dock box changes.
+ *
+ * 2. THE OVERFLOW BIT. The run is a scroll container only while its seats genuinely
+ *    exceed its box. No seat paints past its box or transforms (seat.css), so the native
+ *    `scrollWidth − clientWidth` reading is exact here: one binary read, re-taken by one
+ *    ResizeObserver over the run and its seats.
+ */
+export function useDockProjection(options: UseDockProjectionOptions): void {
+    const { rootEl, plateEl, runEl, orientation } = options;
+    const running = new Set<string>();
+
+    function setMoving(moving: boolean): void {
+        rootEl.value?.toggleAttribute("data-morphing", moving);
+        options.onMovingChange?.(moving);
+    }
+
+    function onRun(event: TransitionEvent): void {
+        if (event.target !== event.currentTarget || !PLATE_INSETS.has(event.propertyName))
+            return;
+        const was = running.size;
+        running.add(event.propertyName);
+        if (was === 0) setMoving(true);
+    }
+
+    function onEnd(event: TransitionEvent): void {
+        if (event.target !== event.currentTarget || !running.delete(event.propertyName))
+            return;
+        if (running.size === 0) setMoving(false);
+    }
+
+    let resize: ResizeObserver | null = null;
+    let mutations: MutationObserver | null = null;
+
+    function readOverflow(): void {
+        const run = runEl.value;
+        if (!run) return;
+        const over =
+            orientation.value === "vertical"
+                ? run.scrollHeight - run.clientHeight > 0.5
+                : run.scrollWidth - run.clientWidth > 0.5;
+        run.toggleAttribute("data-overflowing", over);
+    }
+
+    function observeSeats(): void {
+        const run = runEl.value;
+        if (!run || !resize) return;
+        resize.disconnect();
+        resize.observe(run);
+        for (const seat of run.querySelectorAll(DOCK_SEAT_SELECTOR)) resize.observe(seat);
+    }
+
+    function detach(plate: HTMLElement | null): void {
+        plate?.removeEventListener("transitionrun", onRun);
+        plate?.removeEventListener("transitionend", onEnd);
+        plate?.removeEventListener("transitioncancel", onEnd);
+        resize?.disconnect();
+        mutations?.disconnect();
+        resize = mutations = null;
+        if (running.size) {
+            running.clear();
+            setMoving(false);
+        }
+    }
+
+    watch(
+        [plateEl, runEl, orientation],
+        (_next, previous) => {
+            detach(previous?.[0] ?? null);
+            const plate = plateEl.value;
+            const run = runEl.value;
+            plate?.addEventListener("transitionrun", onRun);
+            plate?.addEventListener("transitionend", onEnd);
+            plate?.addEventListener("transitioncancel", onEnd);
+            if (!run || typeof ResizeObserver === "undefined") return;
+            resize = new ResizeObserver(readOverflow);
+            mutations = new MutationObserver(() => {
+                observeSeats();
+                readOverflow();
+            });
+            mutations.observe(run, { childList: true, subtree: true });
+            observeSeats();
+            readOverflow();
+        },
+        { immediate: true, flush: "post" },
+    );
+
+    onScopeDispose(() => detach(plateEl.value));
+}
diff --git a/src/components/dock/styles/controls/seat.css b/src/components/dock/styles/controls/seat.css
new file mode 100644
index 00000000..15781e45
--- /dev/null
+++ b/src/components/dock/styles/controls/seat.css
@@ -0,0 +1,190 @@
+/* The seat and its projection (D2-E).
+ *
+ * A seat (`DockControl` of either shape, `DockTrigger`, or any consumer element stamped
+ * `[data-dock-seat]`) is a GLYPH BOX: it paints no background, shadow, backdrop, outline,
+ * scale or filter of its own. Every state it shows (hover fill and lift, selected
+ * capsule, press, focus ring) is painted by its own `::after`, anchored to the seat
+ * through a per-seat scoped name.
+ *
+ * Inside a dock the seat is `position: static`, so its projection's containing block is
+ * outside the run: the run's port never clips it and it adds nothing to the run's
+ * scrollable overflow. Outside a dock the seat is `position: relative` (glass/material.css)
+ * and is the containing block of its own projection. One recipe, one declaration apart.
+ *
+ * `isolation: isolate` makes each seat its own stacking context, so the `z-index: -1`
+ * projection paints behind the glyph and never behind an ancestor's background.
+ */
+
+@layer components {
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]) {
+        isolation: isolate;
+        anchor-name: --dock-seat;
+        anchor-scope: --dock-seat;
+    }
+
+    .glass-dock :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]) {
+        position: static;
+    }
+
+    /* The one selected seat of a single-select group also names the glide's anchor
+       (dock.css). Multi-select pressed state paints per seat, below. */
+    .glass-dock
+        :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):is(
+            [aria-current]:not([aria-current="false"]),
+            [aria-checked="true"],
+            [aria-selected="true"]
+        ):not(:where([inert] *)) {
+        anchor-name: --dock-seat, --dock-selected;
+    }
+
+    /* ── THE PROJECTION ─────────────────────────────────────────────────────────── */
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat])::after {
+        content: "";
+        position: absolute;
+        position-anchor: --dock-seat;
+        top: anchor(top);
+        right: anchor(right);
+        bottom: anchor(bottom);
+        left: anchor(left);
+        z-index: -1;
+        pointer-events: none;
+        border-radius: var(--dock-control-radius, var(--radius-pill));
+        background: transparent;
+        outline: var(--dock-ring-width) solid transparent;
+        outline-offset: var(--dock-ring-offset);
+        /* The press rides the inherited `--dock-press-t` that `useLiquidPress` writes. */
+        scale: calc(1 - var(--dock-press-t, 0) * 0.04);
+        transition:
+            background var(--dock-motion-fast),
+            box-shadow var(--dock-motion-fast),
+            outline-color var(--dock-motion-fast),
+            scale var(--dock-press-spring);
+    }
+
+    /* Hover paints only where a pointer can hover: a coarse tap never latches it. */
+    @media (hover: hover) {
+        :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):hover:not(
+                :disabled,
+                [aria-disabled="true"]
+            )::after {
+            background: var(--dock-control-hover-bg);
+            scale: calc(var(--scale-hover-dock) - var(--dock-press-t, 0) * 0.04);
+        }
+        .dock-icon-button:hover:not(:disabled, [aria-disabled="true"])::after {
+            background: var(--dock-icon-hover-bg, var(--dock-control-hover-bg));
+        }
+    }
+
+    /* Selected: multi-select pressed state on the seat; a single-select seat paints its
+       own capsule only outside a dock (inside one, the glide paints it). */
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):is(
+            .is-active,
+            .active,
+            [data-active],
+            [aria-pressed="true"],
+            [aria-expanded="true"]
+        )::after,
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):is(
+            [aria-current]:not([aria-current="false"]),
+            [aria-checked="true"],
+            [aria-selected="true"]
+        ):not(:where(.glass-dock *))::after {
+        background: var(--dock-active-bg);
+        border: var(--dock-active-border);
+        box-shadow: var(--glass-rim-top), var(--glass-rim-bottom), var(--glass-shadow-capsule);
+        scale: calc(var(--dock-active-scale, 1) - var(--dock-press-t, 0) * 0.04);
+    }
+
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):active:not(
+            :disabled,
+            [aria-disabled="true"]
+        )::after {
+        background: var(--dock-control-press-bg);
+    }
+
+    /* The no-JS press floor (the tab and trigger shapes, and an icon seat before
+       hydration arms the spring press). */
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):active:not(
+            :disabled,
+            [aria-disabled="true"],
+            [data-press-armed]
+        )::after {
+        scale: var(--scale-press-dock);
+    }
+
+    :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat]):focus-visible::after {
+        outline-color: var(--dock-ring-color);
+    }
+
+    .glass-dock [data-ring-yield]:focus-visible::after {
+        outline-color: transparent;
+    }
+
+    /* Tiers paint on the projection too. */
+    .dock-tab-button[data-tier="primary"]::after {
+        background: color-mix(in srgb, var(--card) 60%, transparent);
+    }
+
+    :is(.dock-tab-button, .dock-icon-button)[data-tier="secondary"]::after {
+        background: color-mix(in srgb, var(--card) 50%, transparent);
+        border: 1px solid var(--glass-border-quiet);
+        box-shadow: var(--border-hairline);
+    }
+
+    @media (hover: hover) {
+        :is(.dock-tab-button, .dock-icon-button)[data-tier="secondary"]:hover:not(
+                :disabled,
+                [aria-disabled="true"]
+            )::after {
+            background: color-mix(in srgb, var(--card) 65%, transparent);
+            box-shadow:
+                var(--glass-material-rim),
+                0 0.5px 0 0 rgb(0 0 0 / 0.06);
+        }
+    }
+
+    /* The specular catch-light, re-anchored to its seat (the same box as before). */
+    .glass-dock :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat])::before {
+        position-anchor: --dock-seat;
+        inset: auto;
+        top: anchor(top);
+        right: anchor(right);
+        bottom: anchor(bottom);
+        left: anchor(left);
+    }
+
+    /* The vertical dock's leading accent bar, anchored to the selected seat. */
+    .glass-dock.vertical
+        .dock-icon-button:is(.is-active, [aria-current="page"], [aria-pressed="true"])::before {
+        content: "";
+        top: anchor(top);
+        bottom: anchor(bottom);
+        left: auto;
+        right: calc(
+            anchor(left) + var(--dock-vertical-accent-gap, 2px)
+        );
+        margin-block: calc(anchor-size(height) * 0.18);
+        width: var(--dock-vertical-accent-width, 3px);
+        border-radius: var(--radius-pill);
+        background: var(--dock-selected-accent);
+        opacity: 1;
+        mask: none;
+        mix-blend-mode: normal;
+        pointer-events: none;
+    }
+
+    /* A trigger's hit cell is its own box: on a coarse pointer the box meets the
+       touch target itself, so no pseudo is spent on hit slop. */
+    @media (pointer: coarse) {
+        .dock-trigger {
+            min-block-size: var(--dock-touch-target, 2.75rem);
+            min-inline-size: var(--dock-touch-target, 2.75rem);
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        :is(.dock-icon-button, .dock-tab-button, .dock-trigger, [data-dock-seat])::after {
+            transition: none;
+        }
+    }
+}
