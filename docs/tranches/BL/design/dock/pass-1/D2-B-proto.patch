@@ -0,0 +1,480 @@
+import { useMediaQuery } from "@vueuse/core";
+import { onMounted, onScopeDispose, readonly, ref, watch, type Ref } from "vue";
+import { DOCK_SPRING } from "../constants";
+import { useDockSpring } from "./useDockSpring";
+
+/**
+ * The measured scene. Layout owns every endpoint: the active face is in flow and
+ * the dock's box is always the current posture's layout. When a mutation changes
+ * that layout, the scene reads it once (in the mutation's microtask, before any
+ * paint), writes the inversion, and lets the dock spring carry a lerp between the
+ * rect that was painted and the rect layout produced.
+ *
+ * Per-frame writes are plain properties: the plate's `inset`, each region's
+ * `translate`, the layers' `clip-path`, and on a posture flip the leaving face's
+ * `opacity` plus a face-local reveal scalar. Nothing inherited is written on the
+ * root. No layout is read per frame.
+ */
+
+type Face = "full" | "summary";
+interface Box {
+    l: number;
+    t: number;
+    r: number;
+    b: number;
+}
+interface Vec {
+    x: number;
+    y: number;
+}
+interface Geometry {
+    root: Box;
+    regions: Map<HTMLElement, Box>;
+    /** The first leading and trailing persistent regions, for the layers aperture. */
+    persistent: HTMLElement[];
+    k: Vec;
+    /** The root's resolved corner radius (the plate inherits it), in local px. */
+    radius: number;
+    /** The radius is the stadium (at least half the cross extent). */
+    pill: boolean;
+}
+
+export interface UseDockSceneOptions {
+    rootEl: Ref<HTMLElement | null>;
+    plateEl: Ref<HTMLElement | null>;
+    layersEl: Ref<HTMLElement | null>;
+    runEl: Ref<HTMLElement | null>;
+    faceEl: (face: Face) => HTMLElement | null;
+    axis: Ref<"horizontal" | "vertical">;
+    outerActiveLayer: Ref<Face>;
+    onMorphActiveChange?: (active: boolean) => void;
+}
+
+export interface UseDockSceneReturn {
+    outerCurrentLayer: Readonly<Ref<Face>>;
+    outerLeavingLayer: Readonly<Ref<Face | null>>;
+}
+
+/** A morph lands when every edge and region is this close to its endpoint (CSS px). */
+const LAND_PX = 0.5;
+/** Faces stay this far off a persistent region while the aperture moves (CSS px). */
+const APERTURE_MARGIN_PX = 3;
+/** Absorbs float noise in the overflow sum (CSS px). */
+const FLAG_EPSILON_PX = 0.01;
+
+const WATCHED_ATTRIBUTES = ["class", "hidden", "aria-current", "data-active"];
+
+function lerp(a: number, b: number, s: number): number {
+    return a + (b - a) * s;
+}
+function lerpBox(a: Box, b: Box, s: number): Box {
+    return { l: lerp(a.l, b.l, s), t: lerp(a.t, b.t, s), r: lerp(a.r, b.r, s), b: lerp(a.b, b.b, s) };
+}
+function boxDistance(a: Box, b: Box): number {
+    return Math.max(Math.abs(a.l - b.l), Math.abs(a.t - b.t), Math.abs(a.r - b.r), Math.abs(a.b - b.b));
+}
+
+/** The run's flex items, read through `display: contents` groups (C-1). */
+function flexItemsOf(el: Element): HTMLElement[] {
+    const out: HTMLElement[] = [];
+    for (const child of el.children) {
+        if (!(child instanceof HTMLElement)) continue;
+        const cs = getComputedStyle(child);
+        if (cs.display === "contents") out.push(...flexItemsOf(child));
+        else if (cs.display !== "none" && cs.position !== "absolute" && cs.position !== "fixed")
+            out.push(child);
+    }
+    return out;
+}
+
+export function useDockScene(options: UseDockSceneOptions): UseDockSceneReturn {
+    const { rootEl, plateEl, layersEl, runEl, faceEl, axis, outerActiveLayer } = options;
+
+    const currentLayer = ref<Face>(outerActiveLayer.value);
+    const leavingLayer = ref<Face | null>(null);
+    const reducedMotion = useMediaQuery("(prefers-reduced-motion: reduce)");
+    const spring = useDockSpring({
+        response: DOCK_SPRING.response,
+        dampingFraction: DOCK_SPRING.dampingFraction,
+    });
