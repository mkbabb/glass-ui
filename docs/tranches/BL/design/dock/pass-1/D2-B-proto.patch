+        if (boxDistance(a.root, b.root) > 0.01) return false;
+        if (a.regions.size !== b.regions.size) return false;
+        for (const [el, box] of b.regions) {
+            const prev = a.regions.get(el);
+            if (!prev || boxDistance(prev, box) > 0.01) return false;
+        }
+        return true;
+    }
+
+    // ── the overflow flag (a layout sum; never scrollWidth) ────────────────────
+    function sizeOf(el: HTMLElement): { inline: number; block: number } {
+        return itemSize.get(el) ?? { inline: el.offsetWidth, block: el.offsetHeight };
+    }
+
+    function updateOverflow(root: HTMLElement): void {
+        const run = runEl.value;
+        const layers = layersEl.value;
