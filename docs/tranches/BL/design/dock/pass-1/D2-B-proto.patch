+        // not change what the items need.
+        const margin = v
+            ? (Number.parseFloat(rcs.marginTop) || 0) + (Number.parseFloat(rcs.marginBottom) || 0)
+            : (Number.parseFloat(rcs.marginLeft) || 0) + (Number.parseFloat(rcs.marginRight) || 0);
+        let sum = 0;
+        for (const item of items) {
+            const sz = sizeOf(item);
+            sum += v ? sz.block : sz.inline;
+        }
+        sum += gap * Math.max(0, items.length - 1) + pad + margin;
+        const rootMain = v ? root.offsetHeight : root.offsetWidth;
+        const layersMain = v ? layers.offsetHeight : layers.offsetWidth;
+        const chrome = Math.max(0, rootMain - layersMain);
+        const cs = getComputedStyle(root);
+        const parent = root.parentElement;
+        let budget = Number.POSITIVE_INFINITY;
+        const cap = Number.parseFloat(v ? cs.maxHeight : cs.maxWidth);
+        if (Number.isFinite(cap)) budget = cap;
+        if (parent) {
+            const pcs = getComputedStyle(parent);
+            const avail = v
+                ? parent.clientHeight - (Number.parseFloat(pcs.paddingTop) || 0) - (Number.parseFloat(pcs.paddingBottom) || 0)
+                : parent.clientWidth - (Number.parseFloat(pcs.paddingLeft) || 0) - (Number.parseFloat(pcs.paddingRight) || 0);
+            if (avail > 0) budget = Math.min(budget, avail);
+        }
+        run.toggleAttribute("data-overflowing", sum + chrome > budget + FLAG_EPSILON_PX);
+    }
+
+    // ── writing ────────────────────────────────────────────────────────────────
+    function write(): void {
+        const root = rootEl.value;
+        const plate = plateEl.value;
+        if (!root || !plate || !layout || !fromPlate) return;
+        const R = layout.root;
+        const P = lerpBox(fromPlate, R, s);
+        plate.style.inset = `${P.t - R.t}px ${R.r - P.r}px ${R.b - P.b}px ${P.l - R.l}px`;
+        if (radiusFrom !== null) {
+            radiusNow = lerp(radiusFrom, layout.radius, s);
+            plate.style.borderRadius = `${radiusNow}px`;
+        } else {
+            radiusNow = Math.min(layout.radius, (P.r - P.l) / 2, (P.b - P.t) / 2);
+            if (layout.pill) radiusNow = Math.min(P.r - P.l, P.b - P.t) / 2;
+        }
+
+        for (const el of layout.regions.keys()) {
+            const d = shiftOf(el);
+            el.style.translate = `${d.x}px ${d.y}px`;
+        }
+
+        // The layers aperture: the plate, cut back from each persistent region.
+        const layers = layersEl.value;
+        const L = layers ? layout.regions.get(layers) : undefined;
+        if (layers && L) {
+            const dl = shiftOf(layers);
+            const Lp = { l: L.l + dl.x, t: L.t + dl.y, r: L.r + dl.x, b: L.b + dl.y };
+            const v = vertical();
+            let start = v ? P.t : P.l;
+            let end = v ? P.b : P.r;
+            let startCapped = false;
+            let endCapped = false;
+            const mid = v ? (Lp.t + Lp.b) / 2 : (Lp.l + Lp.r) / 2;
+            for (const el of layout.persistent) {
+                const q = layout.regions.get(el);
+                if (!q) continue;
+                const dq = shiftOf(el);
+                const a = v ? q.t + dq.y : q.l + dq.x;
+                const b = v ? q.b + dq.y : q.r + dq.x;
+                if ((a + b) / 2 < mid) {
+                    if (b + APERTURE_MARGIN_PX > start) {
+                        start = b + APERTURE_MARGIN_PX;
+                        startCapped = true;
+                    }
+                } else if (a - APERTURE_MARGIN_PX < end) {
+                    end = a - APERTURE_MARGIN_PX;
+                    endCapped = true;
+                }
+            }
+            const A = v
+                ? { l: P.l, r: P.r, t: start, b: Math.max(start, end) }
+                : { t: P.t, b: P.b, l: start, r: Math.max(start, end) };
+            const cap = Math.min(radiusNow, (v ? P.r - P.l : P.b - P.t) / 2);
+            const rs = startCapped ? 0 : cap;
+            const re = endCapped ? 0 : cap;
+            // Corner order: top-left, top-right, bottom-right, bottom-left.
+            const radii = v ? `${rs}px ${rs}px ${re}px ${re}px` : `${rs}px ${re}px ${re}px ${rs}px`;
+            layers.style.clipPath = `inset(${A.t - Lp.t}px ${Lp.r - A.r}px ${Lp.b - A.b}px ${A.l - Lp.l}px round ${radii})`;
+        }
+
+        if (posture) {
+            const e = lerp(expandFrom, expandTo, s);
+            plate.style.setProperty("--dock-expand-t", `${e}`);
+            const current = currentLayer.value;
+            const leaving = leavingLayer.value;
+            const vis = (face: Face): number => (face === "full" ? e : 1 - e);
+            faceEl(current)?.style.setProperty("--dock-face-t", `${vis(current)}`);
+            if (leaving) {
+                const el = faceEl(leaving);
+                if (el) el.style.opacity = `${Math.min(1, Math.max(0, vis(leaving)))}`;
+            }
+        }
+    }
+
+    function clearWrites(): void {
+        const root = rootEl.value;
+        const plate = plateEl.value;
+        plate?.style.removeProperty("inset");
+        plate?.style.removeProperty("border-radius");
+        plate?.style.removeProperty("--dock-expand-t");
+        if (root) for (const el of regionsOf(root)) el.style.removeProperty("translate");
+        layersEl.value?.style.removeProperty("clip-path");
+        for (const face of ["full", "summary"] as const) {
+            const el = faceEl(face);
+            el?.style.removeProperty("--dock-face-t");
+            el?.style.removeProperty("opacity");
+        }
+    }
+
+    // ── the episode ──────────────────────────────────────────────────────────────
+    function settle(): void {
+        const root = rootEl.value;
+        const wasLive = live;
+        live = false;
+        s = 1;
+        fromPlate = null;
+        fromShift = new Map();
+        posture = false;
+        radiusFrom = null;
+        clearWrites();
+        root?.removeAttribute("data-morphing");
+        root?.removeAttribute("data-posture-morph");
+        leavingLayer.value = null;
+        spring.dispose();
+        if (wasLive) options.onMorphActiveChange?.(false);
+    }
+
+    function frame(value: number): void {
+        s = Math.min(1, Math.max(-0.5, value));
+        write();
+        // The dead landing: every edge and region within LAND_PX, then clear in this
+        // frame. The spring's overshoot is never shown.
+        if ((1 - s) * travel <= LAND_PX) settle();
+    }
+
+    function retarget(next: Geometry, flip: Face | null): void {
+        const root = rootEl.value;
+        if (!root || !layout) return;
+        const R0 = layout.root;
+        const painted = live && fromPlate ? lerpBox(fromPlate, R0, s) : R0;
+        const shifts = new Map<HTMLElement, Vec>();
+        let reach = boxDistance(painted, next.root);
+        for (const [el, box] of next.regions) {
+            const cur = shiftOf(el);
+            const prev = layout.regions.get(el) ?? box;
+            const d = { x: cur.x + prev.l - box.l, y: cur.y + prev.t - box.t };
+            shifts.set(el, d);
+            reach = Math.max(reach, Math.abs(d.x), Math.abs(d.y));
+        }
+        const oldTravel = live ? travel : 0;
+
+        // Expanded-ness continues from what is painted: a reversal starts from the
+        // live value (the c0 complement), a fresh flip from the face that is leaving.
+        if (flip || (live && posture)) {
+            expandFrom =
+                live && posture
+                    ? lerp(expandFrom, expandTo, s)
+                    : 1 - expandedness(currentLayer.value);
+            expandTo = expandedness(currentLayer.value);
+            posture = true;
+        } else {
+            posture = false;
+        }
+        // A stadium on both ends lerps itself (its radius is half a lerped extent);
+        // any other pair lerps the resolved corner, from what is painted.
+        const prevRadius = radiusFrom !== null && live ? radiusNow : layout.radius;
+        radiusFrom = layout.pill && next.pill && radiusFrom === null ? null : prevRadius;
+        reach = Math.max(reach, radiusFrom === null ? 0 : Math.abs(radiusFrom - next.radius));
+        layout = next;
+        if (reach <= LAND_PX) {
+            settle();
+            return;
+        }
+        fromPlate = painted;
+        fromShift = shifts;
+        travel = reach;
+        s = 0;
+        const wasLive = live;
+        live = true;
+        root.setAttribute("data-morphing", "");
+        root.toggleAttribute("data-posture-morph", posture);
+        write();
+        if (!wasLive) options.onMorphActiveChange?.(true);
+        spring.playTo(0, 1, {
+            inheritVelocityScale: wasLive && travel > 0 ? oldTravel / travel : 1,
+            onFrame: frame,
+        });
+    }
+
+    function check(): void {
+        const root = rootEl.value;
+        if (!root || disposed) return;
+        updateOverflow(root);
+        const next = read(root);
+        const flip = pendingPosture;
+        pendingPosture = null;
+        if (!layout) {
+            // The first delivery records rest: there is no mount morph.
+            layout = next;
+            return;
+        }
+        if (reducedMotion.value) {
+            layout = next;
+            if (live || flip) settle();
+            return;
+        }
+        if (sameLayout(layout, next) && !flip) return;
+        retarget(next, flip);
+    }
+
+    // ── observers ────────────────────────────────────────────────────────────────
+    let disposed = false;
+    let mo: MutationObserver | null = null;
+    let ro: ResizeObserver | null = null;
+    const observed = new WeakSet<Element>();
+
+    function observeItem(el: Element): void {
+        if (!ro || observed.has(el)) return;
+        observed.add(el);
+        ro.observe(el);
+    }
+
+    function onResize(entries: ResizeObserverEntry[]): void {
+        for (const entry of entries) {
+            const box = entry.borderBoxSize?.[0];
+            if (box) itemSize.set(entry.target, { inline: box.inlineSize, block: box.blockSize });
+        }
+        check();
+    }
+
+    watch(outerActiveLayer, (next, prev) => {
+        if (next === prev) return;
+        currentLayer.value = next;
+        leavingLayer.value = prev;
+        pendingPosture = next;
+    });
+
+    watch(reducedMotion, (reduced) => {
+        if (reduced && live) settle();
+    });
+
+    onMounted(() => {
+        const root = rootEl.value;
+        if (!root) return;
+        mo = new MutationObserver(() => check());
+        mo.observe(root, {
+            childList: true,
+            subtree: true,
+            characterData: true,
+            attributes: true,
+            attributeFilter: WATCHED_ATTRIBUTES,
+        });
+        ro = new ResizeObserver(onResize);
+        observed.add(root);
+        ro.observe(root);
+        check();
+    });
+
+    onScopeDispose(() => {
+        disposed = true;
+        mo?.disconnect();
+        ro?.disconnect();
+        spring.dispose();
+    });
+
+    return {
+        outerCurrentLayer: readonly(currentLayer),
+        outerLeavingLayer: readonly(leavingLayer),
+    };
+}
