+        const persistent: HTMLElement[] = [];
+        for (const el of regionsOf(root)) {
+            const b = rel(el.getBoundingClientRect());
+            const d = shiftOf(el);
+            regions.set(el, { l: b.l - d.x, t: b.t - d.y, r: b.r - d.x, b: b.b - d.y });
+            if (el !== layersEl.value) persistent.push(el);
+        }
