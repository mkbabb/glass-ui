@@ -0,0 +1,129 @@
+import { onMounted, onScopeDispose, ref, watch, type Ref } from "vue";
+import {
+    createScrollReader,
+    type ScrollReader,
+} from "../../../composables/motion/scroll/scrollReader";
+import {
+    DOCK_COMPACT_ENTER_PX,
+    DOCK_COMPACT_EXIT_PX,
+    DOCK_COMPACT_REARM_MS,
+} from "../constants";
+
+export type DockScrollSource =
+    | HTMLElement
+    | Window
+    | (() => HTMLElement | Window | null)
+    | null;
+
+export interface UseDockScrollOptions {
+    rootEl: Ref<HTMLElement | null>;
+    source: () => DockScrollSource | undefined;
+    /** The compact rung is opted into. */
+    compactOnScroll: () => boolean;
+    /** A hold (an open menu, an armed field) engages the dock like a hand does. */
+    held: Ref<boolean>;
+    /** Per-frame progress in [0, 1] for the rim; written, never made reactive. */
+    onProgress?: (progress: number) => void;
+}
+
+export interface UseDockScrollReturn {
+    compact: Readonly<Ref<boolean>>;
+}
+
+/**
+ * The dock's scroll input: one rAF-coalesced reader (`createScrollReader`) feeds
+ * position hysteresis for the compact rung and the rim's progress. `scrollend`
+ * is never the trigger: Playwright WebKit fires it once per gesture, 677-700 ms
+ * after the crossing.
+ *
+ * Engagement is a fine-pointer hover, focus within the dock, or any hold. It
+ * expands at once and re-arms compaction a short beat after it closes.
+ */
+export function useDockScroll(options: UseDockScrollOptions): UseDockScrollReturn {
+    const { rootEl, held } = options;
+    const past = ref(false);
+    const hovered = ref(false);
+    const focused = ref(false);
+    const armed = ref(true);
+    const compact = ref(false);
+    let reader: ScrollReader | null = null;
+    let rearmTimer: ReturnType<typeof setTimeout> | null = null;
+
+    function resolve(): HTMLElement | Window | null {
+        const src = options.source();
+        const value = typeof src === "function" ? src() : src;
+        return value ?? null;
+    }
+
+    function tick(r: ScrollReader): void {
+        const y = r.position();
+        if (!past.value && y >= DOCK_COMPACT_ENTER_PX) past.value = true;
+        else if (past.value && y <= DOCK_COMPACT_EXIT_PX) past.value = false;
+        const extent = r.extent();
+        options.onProgress?.(extent > 0 ? Math.min(1, Math.max(0, y / extent)) : 0);
+    }
+
+    function attach(): void {
+        reader?.stop();
+        reader = null;
+        const src = resolve();
+        if (!src) return;
+        reader = createScrollReader(src instanceof Window ? null : src, tick);
+        tick(reader);
+    }
+
+    const engaged = (): boolean => hovered.value || focused.value || held.value;
+
+    watch([past, hovered, focused, held, armed], () => {
+        compact.value = options.compactOnScroll() && past.value && armed.value && !engaged();
+    });
+
+    watch(engaged, (now) => {
+        if (rearmTimer) clearTimeout(rearmTimer);
+        rearmTimer = null;
+        if (now) {
+            armed.value = false;
+            return;
+        }
+        rearmTimer = setTimeout(() => {
+            rearmTimer = null;
+            armed.value = true;
+        }, DOCK_COMPACT_REARM_MS);
+    });
+
+    function onPointerEnter(e: PointerEvent): void {
+        if (e.pointerType === "mouse") hovered.value = true;
+    }
+    function onPointerLeave(e: PointerEvent): void {
+        if (e.pointerType === "mouse") hovered.value = false;
+    }
+    function onFocusChange(): void {
+        // Read after the focus move lands, so a hop between two seats never reads
+        // as a blur.
+        queueMicrotask(() => {
+            focused.value = !!rootEl.value?.matches(":focus-within");
+        });
+    }
+
+    onMounted(() => {
+        const root = rootEl.value;
+        root?.addEventListener("pointerenter", onPointerEnter);
+        root?.addEventListener("pointerleave", onPointerLeave);
+        root?.addEventListener("focusin", onFocusChange);
+        root?.addEventListener("focusout", onFocusChange);
+        attach();
+    });
+    watch(options.source, attach);
+
+    onScopeDispose(() => {
+        reader?.stop();
+        if (rearmTimer) clearTimeout(rearmTimer);
+        const root = rootEl.value;
+        root?.removeEventListener("pointerenter", onPointerEnter);
+        root?.removeEventListener("pointerleave", onPointerLeave);
+        root?.removeEventListener("focusin", onFocusChange);
+        root?.removeEventListener("focusout", onFocusChange);
+    });
+
+    return { compact };
+}
