--- /dev/null
+++ b/src/components/dock/composables/useDockExtent.ts
@@ -0,0 +1,438 @@
+// The dock EXTENT: one body lane carries the plate's main-axis length through every
+// change of the dock's natural extent — a posture flip, a content change, a face swap.
+//
+// ENDPOINTS. The DOM is always laid out at its target: the root's box IS the natural
+// extent, read after the change and before paint, never measured out of flow. A posture
+// flip retargets from a `flush: "post"` watcher; everything else arrives through a
+// ResizeObserver on the root, the regions and the faces. Nothing the body writes changes
+// layout (plate insets on an absolute leaf, translates, clips), so every read is the
+// target layout and nothing relayouts per frame.
+//
+// WHAT MOVES, per frame, as px custom properties:
+//   - the plate's two main-axis insets: its edges lerp in anchor coordinates from where
+//     they were painted to the new box, so the dock morphs about whatever edge its layout
+//     anchors (centre, start or end);
+//   - one translate per persistent region, lerping between its painted and its target
+//     position; an entering face sits at its target; a leaving face stays where it was;
+//   - the outer faces' main-axis aperture clip, while moving only;
+//   - the squish: a cross-axis swell of σ = 0.04·min(1, |v|/3000), never a thinning.
+//
+// COMPACTION rides its own lane `c`: the plate resizes about its centre by k = 1 − 0.16c
+// and the regions scale by k about the dock's centre.
+//
+// ANCHOR COORDINATES are viewport coordinates plus the window scroll for a dock that is
+// not in a fixed chain, so window scroll between two reads is not motion. A non-window
+// scroller that moves the dock between two reads is not corrected (named residual).
+
+import { onMounted, onScopeDispose, ref, watch, type ComputedRef, type Ref } from "vue";
+
+import type { DockBody, DockLane } from "./useDockBody";
+
+export interface UseDockExtentOptions {
+    body: DockBody;
+    rootEl: Ref<HTMLElement | null>;
+    plateEl: Ref<HTMLElement | null>;
+    fullEl: Ref<HTMLElement | null>;
+    summaryEl: Ref<HTMLElement | null>;
+    orientation: ComputedRef<"horizontal" | "vertical">;
+    /** The outer face that owns layout: "full" or "summary". */
+    activeLayer: ComputedRef<string>;
+    /** Compaction target, 0 or 1 (already gated by engagement). */
+    compact: ComputedRef<boolean>;
+    onWindow?: (open: boolean) => void;
+}
+
+export interface UseDockExtentReturn {
+    /** The outer face still painting on its way out, or null. */
+    leavingLayer: Readonly<Ref<string | null>>;
+    /** The extent lane: exposed for instruments. */
+    extent: DockLane;
+}
+
+const SWELL = 0.04;
+const SWELL_V = 3000;
+const COMPACT_K = 0.16;
+
+type Box = { a: number; b: number; ca: number; cb: number };
+
+function lerp(a: number, b: number, t: number): number {
+    return a + (b - a) * t;
+}
+
+export function useDockExtent(o: UseDockExtentOptions): UseDockExtentReturn {
+    const { body } = o;
+    const leavingLayer = ref<string | null>(null);
+    const vertical = (): boolean => o.orientation.value === "vertical";
+
+    // ── the model ──
+    let fixedChain = false;
+    let root: Box | null = null; // root layout box, anchor coords (the episode's target)
+    let e0 = 0; // episode start length
+    let e1 = 0; // episode target length
+    let from = { a: 0, b: 0 }; // episode start edges
+    let painted = { a: 0, b: 0 }; // edges as last painted (no compaction)
+    // main-axis start of each moved element: painted-from and layout-to, anchor coords
+    const regionFrom = new Map<HTMLElement, number>();
+    const regionTo = new Map<HTMLElement, number>();
+    const regionCross = new Map<HTMLElement, number>();
+    // faces: layout start (anchor) and main length; the leaving ones hold `hold`
+    const faceLayout = new Map<HTMLElement, { a: number; len: number; ca: number }>();
+    const faceHold = new Map<HTMLElement, number>();
+    let restPos = new Map<HTMLElement, number>();
+    let written = new Set<HTMLElement>();
+    let windowOpen = false;
+
+    // The window closes when the extent and the face crossfade have both seated.
+    const faceLane = body.lane({ eps: 0.004, onSeat: () => maybeClose() });
+    const compactLane = body.lane({ eps: 0.002 });
+    const extent = body.lane({ eps: 0.5, onSeat: () => maybeClose() });
+    faceLane.set(1);
+    compactLane.set(0);
+    extent.set(0);
+    // The layers box: scaled by compaction, never translated (its faces are).
+    let layers: { el: HTMLElement; a: number; ca: number } | null = null;
+
+    function anchor(): { x: number; y: number } {
+        return fixedChain ? { x: 0, y: 0 } : { x: window.scrollX, y: window.scrollY };
+    }
+
+    function rectOf(el: Element): Box {
+        const r = el.getBoundingClientRect();
+        const s = anchor();
+        return vertical()
+            ? { a: r.top + s.y, b: r.bottom + s.y, ca: r.left + s.x, cb: r.right + s.x }
+            : { a: r.left + s.x, b: r.right + s.x, ca: r.top + s.y, cb: r.bottom + s.y };
+    }
+
+    function regions(): HTMLElement[] {
+        const r = o.rootEl.value;
+        if (!r) return [];
+        return Array.from(r.querySelectorAll<HTMLElement>(":scope > .dock-controls > .dock-persistent"));
+    }
+    function layersBox(): HTMLElement | null {
+        return o.rootEl.value?.querySelector<HTMLElement>(":scope > .dock-controls > .dock-layers") ?? null;
+    }
+    function outerFaces(): HTMLElement[] {
+        return [o.fullEl.value, o.summaryEl.value].filter((x): x is HTMLElement => !!x);
+    }
+    function innerFaces(): HTMLElement[] {
+        const r = o.rootEl.value;
+        return r ? Array.from(r.querySelectorAll<HTMLElement>(".dock-face")) : [];
+    }
+    function isLeaving(el: HTMLElement): boolean {
+        if (el === o.fullEl.value) return leavingLayer.value === "full";
+        if (el === o.summaryEl.value) return leavingLayer.value === "summary";
+        return el.classList.contains("is-leaving");
+    }
+    function isActive(el: HTMLElement): boolean {
+        if (el === o.fullEl.value) return o.activeLayer.value === "full";
+        if (el === o.summaryEl.value) return o.activeLayer.value === "summary";
+        return el.classList.contains("is-active");
+    }
+
+    const PROPS = ["--dock-tx", "--dock-ty", "--dock-k", "--dock-ox", "--dock-oy", "--dock-clip-s", "--dock-clip-e", "--dock-fade", "--dock-reveal", "--dock-plate-s", "--dock-plate-e", "--dock-plate-x", "--dock-plate-t"];
+    function clearWrites(): void {
+        for (const el of written) for (const p of PROPS) el.style.removeProperty(p);
+        written = new Set();
+    }
+    function put(el: HTMLElement, prop: string, v: string): void {
+        el.style.setProperty(prop, v);
+        written.add(el);
+    }
+
+    /** Read the target layout. Our writes are cleared first: none of them is layout. */
+    function readLayout(): void {
+        const r = o.rootEl.value;
+        if (!r) return;
+        clearWrites();
+        root = rectOf(r);
+        regionTo.clear();
+        regionCross.clear();
+        for (const el of regions()) {
+            const b = rectOf(el);
+            regionTo.set(el, b.a);
+            regionCross.set(el, b.ca);
+        }
+        const lb = layersBox();
+        layers = lb ? { el: lb, ...(({ a, ca }) => ({ a, ca }))(rectOf(lb)) } : null;
+        faceLayout.clear();
+        for (const el of [...outerFaces(), ...innerFaces()]) {
+            const b = rectOf(el);
+            faceLayout.set(el, { a: b.a, len: b.b - b.a, ca: b.ca });
+        }
+    }
+
+    function detectFixed(): void {
+        fixedChain = false;
+        for (let el: Element | null = o.rootEl.value; el; el = el.parentElement) {
+            if (getComputedStyle(el).position === "fixed") {
+                fixedChain = true;
+                return;
+            }
+        }
+    }
+
+    /** Record the resting geometry: every element sits at its layout. */
+    function recordRest(): void {
+        if (!root) return;
+        painted = { a: root.a, b: root.b };
+        restPos = new Map();
+        for (const [el, a] of regionTo) restPos.set(el, a);
+        for (const [el, f] of faceLayout) restPos.set(el, f.a);
+    }
+
+    function openWindow(): void {
+        const r = o.rootEl.value;
+        if (!r || windowOpen) return;
+        windowOpen = true;
+        r.setAttribute("data-morphing", "");
+        o.onWindow?.(true);
+    }
+    function maybeClose(): void {
+        if (extent.moving || faceLane.moving) return;
+        if (!windowOpen) return;
+        windowOpen = false;
+        leavingLayer.value = null;
+        faceHold.clear();
+        o.rootEl.value?.removeAttribute("data-morphing");
+        o.onWindow?.(false);
+        recordRest();
+        paint();
+    }
+
+    /**
+     * Retarget the extent to the current layout. `flip` names the face that just left
+     * (a posture flip); a content change passes null.
+     */
+    function retarget(flip: HTMLElement | null): void {
+        const r = o.rootEl.value;
+        if (!r) return;
+        // The painted state before the change, from the model (no reads).
+        const moving = windowOpen;
+        const fromEdges = { ...painted };
+        const pos = new Map<HTMLElement, number>(moving ? currentPositions() : restPos);
+        readLayout();
+        if (!root) return;
+        const len = root.b - root.a;
+        from = fromEdges;
+        e0 = from.b - from.a;
+        e1 = len;
+        // regions lerp from their painted position
+        regionFrom.clear();
+        for (const [el, a] of regionTo) regionFrom.set(el, pos.get(el) ?? a);
+        // faces: a leaving face holds where it was painted; the new leaving outer face too
+        const nextHold = new Map<HTMLElement, number>();
+        for (const el of [...outerFaces(), ...innerFaces()]) {
+            if (el === flip || (isLeaving(el) && !isActive(el))) {
+                const at = faceHold.get(el) ?? pos.get(el);
+                if (at != null) nextHold.set(el, at);
+            }
+        }
+        faceHold.clear();
+        for (const [k, v] of nextHold) faceHold.set(k, v);
+        if (Math.abs(e1 - e0) < 0.5 && Math.abs(from.a - root.a) < 0.5 && !flip && !faceLane.moving) {
+            // Nothing to travel: seat and repaint at the new layout.
+            extent.set(e1);
+            if (!windowOpen) recordRest();
+            paint();
+            return;
+        }
+        if (!moving) extent.set(e0);
+        openWindow();
+        paint();
+        extent.to(e1);
+        if (!extent.moving) maybeClose();
+    }
+
+    /** Painted main-axis starts of every tracked element, from the model. */
+    function currentPositions(): Map<HTMLElement, number> {
+        const m = new Map<HTMLElement, number>();
+        const p = progress();
+        for (const [el, to] of regionTo) m.set(el, lerp(regionFrom.get(el) ?? to, to, p));
+        for (const [el, f] of faceLayout) m.set(el, faceHold.get(el) ?? f.a);
+        return m;
+    }
+
+    function progress(): number {
+        return e1 === e0 ? 1 : (extent.value - e0) / (e1 - e0);
+    }
+
+    /** Write one frame from the lane states. */
+    function paint(): void {
+        const plate = o.plateEl.value;
+        if (!plate || !root) return;
+        const v = vertical();
+        const p = progress();
+        const moving = windowOpen;
+        const edges = moving
+            ? { a: lerp(from.a, root.a, p), b: lerp(from.b, root.b, p) }
+            : { a: root.a, b: root.b };
+        painted = edges;
+        const c = compactLane.value;
+        const k = 1 - COMPACT_K * c;
+        const cross = root.cb - root.ca;
+        const mid = (edges.a + edges.b) / 2;
+        const len = edges.b - edges.a;
+        // the plate: main-axis edges, compaction about its centre, the swell
+        const sw = moving ? SWELL * Math.min(1, Math.abs(extent.velocity) / SWELL_V) : 0;
+        const ps = mid - (len * k) / 2 - root.a;
+        const pe = root.b - (mid + (len * k) / 2);
+        const px = (cross * (1 - k)) / 2 - (sw * cross) / 2;
+        const idle = !moving && c === 0 && !compactLane.moving;
+        if (idle) {
+            clearWrites();
+            return;
+        }
+        put(plate, "--dock-plate-s", `${ps}px`);
+        put(plate, "--dock-plate-e", `${pe}px`);
+        put(plate, "--dock-plate-x", `${px}px`);
+        if (faceLane.moving || leavingLayer.value) {
+            const expandedness = o.activeLayer.value === "full" ? faceLane.value : 1 - faceLane.value;
+            put(plate, "--dock-plate-t", `${expandedness}`);
+        }
+        // Both translate components are written: an unset one leaves `translate` invalid.
+        const shift = (el: HTMLElement, t: number): void => {
+            put(el, "--dock-tx", v ? "0px" : `${t}px`);
+            put(el, "--dock-ty", v ? `${t}px` : "0px");
+        };
+        const ox = v ? "--dock-oy" : "--dock-ox";
+        const oy = v ? "--dock-ox" : "--dock-oy";
+        const crossMid = (root.ca + root.cb) / 2;
+        // regions: translate, then scale about the dock's centre
+        if (layers && (c !== 0 || compactLane.moving)) {
+            put(layers.el, "--dock-k", `${k}`);
+            put(layers.el, ox, `${mid - layers.a}px`);
+            put(layers.el, oy, `${crossMid - layers.ca}px`);
+        }
+        for (const [el, to] of regionTo) {
+            const at = moving ? lerp(regionFrom.get(el) ?? to, to, p) : to;
+            const t = at - to;
+            shift(el, t);
+            if (c !== 0 || compactLane.moving) {
+                put(el, "--dock-k", `${k}`);
+                put(el, ox, `${mid - to - t}px`);
+                put(el, oy, `${crossMid - (regionCross.get(el) ?? root.ca)}px`);
+            }
+        }
+        // faces: the leaving ones hold; the outer ones are clipped to the plate while moving
+        const f = faceLane.value;
+        for (const [el, lay] of faceLayout) {
+            const hold = faceHold.get(el);
+            const t = hold != null ? hold - lay.a : 0;
+            if (hold != null) shift(el, t);
+            const outer = el === o.fullEl.value || el === o.summaryEl.value;
+            if (!outer || !moving) continue;
+            const start = lay.a + t;
+            put(el, "--dock-clip-s", `${Math.max(0, edges.a - start)}px`);
+            put(el, "--dock-clip-e", `${Math.max(0, start + lay.len - edges.b)}px`);
+            if (leavingLayer.value) {
+                if (isActive(el)) put(el, "--dock-reveal", `${f}`);
+                else put(el, "--dock-fade", `${1 - f}`);
+            }
+        }
+    }
+
+    body.onFrame(() => {
+        if (windowOpen || compactLane.moving || written.size > 0) paint();
+    });
+
+    // ── posture flips ──
+    watch(
+        o.activeLayer,
+        (next, prev) => {
+            if (next === prev || !root) return;
+            const left = prev === "full" ? o.fullEl.value : o.summaryEl.value;
+            leavingLayer.value = prev;
+            // The face crossfade: a reversal carries the painted opacity over.
+            const carry = faceLane.moving ? 1 - faceLane.value : 0;
+            faceLane.fling(carry, -faceLane.velocity, 1);
+            retarget(left);
+            if (!faceLane.moving) maybeClose();
+        },
+        { flush: "post" },
+    );
+
+    // Compaction: the c lane follows the gated target.
+    watch(o.compact, (on) => {
+        if (!root) readLayout();
+        compactLane.to(on ? 1 : 0);
+        if (root) paint();
+    });
+
+    // ── content changes ──
+    let ro: ResizeObserver | null = null;
+    function observe(): void {
+        ro?.disconnect();
+        const r = o.rootEl.value;
+        if (!r || typeof ResizeObserver === "undefined") return;
+        ro = new ResizeObserver(() => check());
+        for (const el of [r, ...regions(), ...outerFaces(), ...innerFaces()]) ro.observe(el);
+    }
+
+    /** Has the natural extent changed? Retarget; at rest, refresh the resting geometry. */
+    function check(): void {
+        const r = o.rootEl.value;
+        if (!r) return;
+        if (!root) {
+            readLayout();
+            const box = root as Box | null;
+            extent.set(box ? box.b - box.a : 0);
+            recordRest();
+            return;
+        }
+        const now = rectOf(r);
+        const len = now.b - now.a;
+        if (Math.abs(len - e1) >= 0.5 || (windowOpen && Math.abs(len - extent.target) >= 0.5)) {
+            retarget(null);
+        } else if (!windowOpen) {
+            readLayout();
+            recordRest();
+            paint();
+        }
+    }
+
+    function onResize(): void {
+        if (windowOpen) return;
+        readLayout();
+        recordRest();
+        paint();
+    }
+
+    onMounted(() => {
+        detectFixed();
+        readLayout();
+        if (root) {
+            e0 = e1 = root.b - root.a;
+            extent.set(e1);
+            recordRest();
+        }
+        observe();
+        window.addEventListener("resize", onResize, { passive: true });
+    });
+    watch([o.rootEl, o.orientation], () => {
+        detectFixed();
+        observe();
+    });
+    // A DOM change inside the dock (a seat added, a face swapped) is checked in the
+    // microtask that follows it, before any later task can read the layout or the frame
+    // can paint: the plate never shows the new extent unmorphed. New faces also join
+    // the ResizeObserver, which covers size changes with no DOM mutation (fonts, window).
+    let mo: MutationObserver | null = null;
+    onMounted(() => {
+        const r = o.rootEl.value;
+        if (!r) return;
+        mo = new MutationObserver((records) => {
+            if (records.some((m) => m.type === "childList")) observe();
+            check();
+        });
+        mo.observe(r, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ["class"] });
+    });
+
+    onScopeDispose(() => {
+        ro?.disconnect();
+        mo?.disconnect();
+        window.removeEventListener("resize", onResize);
+    });
+
+    return { leavingLayer, extent };
+}
