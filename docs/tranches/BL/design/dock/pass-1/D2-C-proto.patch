+// The dock's scroll source: one element (or the window) whose scroll drives two state
+// inputs, the compact-on-scroll rung and the progress rim.
+//
+// COMPACTION is position hysteresis, in script because WebKit has no cross-engine CSS
+// form of it: the target flips to compact above T + h, and back below T − h or at the
+// top. The dead band is the hysteresis; the c lane that paints it rides the dock register.
+//
+// PROGRESS is offset / range, 0..1, for the rim's follower lane.
+
+import { onScopeDispose, ref, watch, type Ref } from "vue";
+
+export type DockScrollSource = HTMLElement | Window | (() => HTMLElement | Window | null) | null | undefined;
+export type DockCompactOnScroll = boolean | { threshold?: number; band?: number } | undefined;
+
+const DEFAULT_THRESHOLD = 120;
+const DEFAULT_BAND = 40;
+
+function resolve(src: DockScrollSource): HTMLElement | Window | null {
+    if (!src) return null;
+    return typeof src === "function" ? src() : src;
+}
+
+function offsetOf(el: HTMLElement | Window): number {
+    return el instanceof Window ? el.scrollY : el.scrollTop;
+}
+
+function rangeOf(el: HTMLElement | Window): number {
+    if (el instanceof Window) return document.documentElement.scrollHeight - el.innerHeight;
+    return el.scrollHeight - el.clientHeight;
+}
+
+export function useDockScrollSource(
+    source: () => DockScrollSource,
+    compactOnScroll: () => DockCompactOnScroll,
+): { compact: Ref<boolean>; progress: Ref<number> } {
+    const compact = ref(false);
+    const progress = ref(0);
+    let bound: HTMLElement | Window | null = null;
+
+    function read(): void {
+        if (!bound) return;
+        const y = offsetOf(bound);
+        const range = rangeOf(bound);
+        progress.value = range > 0 ? Math.min(1, Math.max(0, y / range)) : 0;
+        const opt = compactOnScroll();
+        if (!opt) {
+            compact.value = false;
+            return;
+        }
+        const t = typeof opt === "object" ? (opt.threshold ?? DEFAULT_THRESHOLD) : DEFAULT_THRESHOLD;
+        const h = typeof opt === "object" ? (opt.band ?? DEFAULT_BAND) : DEFAULT_BAND;
+        if (y <= 0 || y < t - h) compact.value = false;
+        else if (y > t + h) compact.value = true;
+    }
+
+    function bind(): void {
+        bound?.removeEventListener("scroll", read);
+        bound = typeof window === "undefined" ? null : resolve(source());
+        bound?.addEventListener("scroll", read, { passive: true });
+        read();
+    }
+
+    watch([source, compactOnScroll], bind, { immediate: true });
+    onScopeDispose(() => bound?.removeEventListener("scroll", read));
+
+    return { compact, progress };
+}
