index 00000000..ffe7db56
--- /dev/null
+++ b/src/components/dock/composables/useDockBody.ts
@@ -0,0 +1,253 @@
+// The dock BODY: one requestAnimationFrame steps every moving quantity of one dock.
+//
+// A lane is a keyframes `SpringProgress` advanced by `tickDt` from this loop; the
+// spring's own `.play()` loop is never started. Lanes are allocated once, at setup.
+// The loop runs only while a lane is moving and parks when every lane has seated, so
+// an idle dock requests no frames.
+//
+// Seating. A lane with `seat: "cross"` seats when it is within `eps` of its target or on
+// the frame it would cross it: the register's undesigned overshoot (0.3 % of the travel
+// at ζ 0.88) is below its own settle band, so it is seated instead of rung out. A lane
+// with `seat: "rest"` keeps its overshoot (a flick's bounce is designed) and seats once
+// it is within `eps` and slower than `vEps`.
+//
+// PRM. Every lane is built `respectReducedMotion: true`, so a retarget seats in the
+// frame it is made.
+
+import { SpringProgress } from "@mkbabb/keyframes.js";
+import { inject, onScopeDispose, provide, type InjectionKey } from "vue";
+
+import { motionTempo } from "../../../composables/motion/core/motionTempo";
+import { DOCK_SPRING } from "../constants";
+
+export interface DockLaneOptions {
+    /** iOS response, seconds. Defaults to the dock register. */
+    response?: number;
+    /** iOS damping fraction. Defaults to the dock register. */
+    dampingFraction?: number;
+    /** `cross` seats at `eps` or on the crossing frame; `rest` keeps its overshoot. */
+    seat?: "cross" | "rest";
+    /** Seat distance, in the lane's own unit. */
+    eps?: number;
+    /** `rest` seating only: seat speed, units per second. */
+    vEps?: number;
+    /** Called with the lane's value on every frame it moves, and once when it seats. */
+    onFrame?: (value: number, velocity: number) => void;
+    /** Called once when the lane seats. */
+    onSeat?: () => void;
+}
+
+export interface DockLane {
+    readonly value: number;
+    readonly velocity: number;
+    readonly target: number;
+    readonly moving: boolean;
+    /** Retarget from the current (value, velocity). */
+    to(target: number): void;
+    /** Follow a drag: write `value` now, at zero velocity, and stop. */
+    hold(value: number): void;
+    /** Release at `value` with velocity `v` (units/s) toward `target`. */
+    fling(value: number, v: number, target: number): void;
+    /** Seat at `value` with no motion. */
+    set(value: number): void;
+}
+
+export interface DockBody {
+    lane(options?: DockLaneOptions): DockLane;
+    /** Called after every lane of a frame has stepped (the per-frame writers). */
+    onFrame(fn: () => void): void;
+    /** Frames the loop has run; an instrument for the idle budget. */
+    readonly frames: number;
+    dispose(): void;
+}
+
+const MAX_DT = 64;
+
+export function createDockBody(): DockBody {
+    const lanes: LaneImpl[] = [];
+    const writers: Array<() => void> = [];
+    let raf = 0;
+    let last = 0;
+    let frames = 0;
+    let disposed = false;
+
+    function kick(): void {
+        if (raf || disposed) return;
+        last = performance.now();
+        raf = requestAnimationFrame(step);
+    }
+
+    function step(now: number): void {
+        raf = 0;
+        // The input landed at `last`; the first frame advances by the real elapsed time.
+        const dt = Math.min(MAX_DT, Math.max(0, now - last));
+        last = now;
+        frames++;
+        let live = false;
+        for (const lane of lanes) if (lane.step(dt)) live = true;
+        for (const w of writers) w();
+        for (const lane of lanes) lane.flushSeat();
+        if (live) raf = requestAnimationFrame(step);
+    }
+
+    class LaneImpl implements DockLane {
+        spring: SpringProgress;
+        tempo: number;
+        moving = false;
+        seatedNow = false;
+        constructor(private o: DockLaneOptions) {
+            this.tempo = motionTempo();
+            this.spring = this.build(0, 0);
+        }
+        build(value: number, velocity: number): SpringProgress {
+            const s = new SpringProgress({
+                response: (this.o.response ?? DOCK_SPRING.response) * this.tempo,
+                dampingFraction: this.o.dampingFraction ?? DOCK_SPRING.dampingFraction,
+                initial: value,
+                respectReducedMotion: true,
+            });
+            s.reset(value, velocity);
+            return s;
+        }
+        retempo(): void {
+            const t = motionTempo();
+            if (t === this.tempo) return;
+            const { value, velocity } = this.spring;
+            this.spring.dispose();
+            this.tempo = t;
+            this.spring = this.build(value, velocity);
+        }
+        get value(): number {
+            return this.spring.value;
+        }
+        get velocity(): number {
+            return this.moving ? this.spring.velocity : 0;
+        }
+        get target(): number {
+            return this.spring.target;
+        }
+        to(target: number): void {
+            this.retempo();
+            if (!this.moving && Math.abs(this.spring.value - target) < 1e-6) return;
+            this.spring.target = target;
+            this.arm();
+        }
+        hold(value: number): void {
+            this.spring.reset(value, 0);
+            this.moving = false;
+            this.o.onFrame?.(value, 0);
+        }
+        fling(value: number, v: number, target: number): void {
+            this.retempo();
+            this.spring.reset(value, v);
+            this.spring.target = target;
+            this.arm();
+        }
+        set(value: number): void {
+            this.spring.reset(value, 0);
+            const was = this.moving;
+            this.moving = false;
+            this.o.onFrame?.(value, 0);
+            if (was) this.o.onSeat?.();
+        }
+        arm(): void {
+            // A reduced-motion retarget has already seated inside SpringProgress.
+            if (this.spring.settled) {
+                this.moving = false;
+                this.o.onFrame?.(this.spring.value, 0);
+                this.o.onSeat?.();
+                return;
+            }
+            this.moving = true;
+            kick();
+        }
+        step(dt: number): boolean {
+            if (!this.moving) return false;
+            const tgt = this.spring.target;
+            const before = this.spring.value - tgt;
+            this.spring.tickDt(dt);
+            const after = this.spring.value - tgt;
+            const eps = this.o.eps ?? 0.5;
+            let seat = this.spring.settled;
+            if (this.o.seat === "rest") {
+                seat ||= Math.abs(after) <= eps && Math.abs(this.spring.velocity) <= (this.o.vEps ?? 20);
+            } else {
+                seat ||= Math.abs(after) <= eps || (before !== 0 && Math.sign(after) !== Math.sign(before));
+            }
+            if (seat) {
+                this.spring.reset(tgt, 0);
+                this.moving = false;
+                this.seatedNow = true;
+            }
+            this.o.onFrame?.(this.spring.value, this.velocity);
+            return !seat;
+        }
+        emit(): void {
+            this.o.onFrame?.(this.spring.value, 0);
+        }
+        flushSeat(): void {
+            if (!this.seatedNow) return;
+            this.seatedNow = false;
+            this.o.onSeat?.();
+        }
+    }
+
+    // Reduced motion preferred mid-flight: every moving lane seats at its target now.
+    const prm = typeof matchMedia === "function" ? matchMedia("(prefers-reduced-motion: reduce)") : null;
+    const onPrm = (event: MediaQueryListEvent): void => {
+        if (!event.matches) return;
+        let any = false;
+        for (const lane of lanes) {
+            if (!lane.moving) continue;
+            lane.spring.reset(lane.spring.target, 0);
+            lane.moving = false;
+            lane.seatedNow = true;
+            any = true;
+        }
+        if (!any) return;
+        for (const lane of lanes) if (lane.seatedNow) lane.emit();
+        for (const w of writers) w();
+        for (const lane of lanes) lane.flushSeat();
+    };
+    prm?.addEventListener?.("change", onPrm);
+
+    return {
+        lane(options: DockLaneOptions = {}): DockLane {
+            const lane = new LaneImpl(options);
+            lanes.push(lane);
+            return lane;
+        },
+        onFrame(fn) {
+            writers.push(fn);
+        },
+        get frames() {
+            return frames;
+        },
+        dispose() {
+            disposed = true;
+            prm?.removeEventListener?.("change", onPrm);
+            if (raf) cancelAnimationFrame(raf);
+            raf = 0;
+            for (const lane of lanes) lane.spring.dispose();
+        },
+    };
+}
+
+const DOCK_BODY_KEY: InjectionKey<DockBody> = Symbol("glass-dock-body");
+
+/** One body per dock, shared with its descendants. */
+export function provideDockBody(): DockBody {
+    const body = createDockBody();
+    provide(DOCK_BODY_KEY, body);
+    onScopeDispose(() => body.dispose());
+    return body;
+}
+
+/** The enclosing dock's body, or a body of the caller's own (a standalone crossfade). */
+export function useDockBody(): DockBody {
+    const shared = inject(DOCK_BODY_KEY, null);
+    if (shared) return shared;
+    const own = createDockBody();
+    onScopeDispose(() => own.dispose());
+    return own;
+}
