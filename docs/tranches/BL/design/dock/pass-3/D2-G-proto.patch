+ * entering seat will cover fades first, and the entering seat waits for it; every other
+ * leaving seat rides its face with the glass and is taken by the closing edge, fading only
+ * if more than a sliver of it is still on the glass when the window lands (H3-3). A swap's
+ * faces share one place, so the new face is drawn over the old one behind a seam. A seat
+ * that left the DOM paints as a clone clipped back by whatever seat moves into its place.
+ * A unit under the paint floor is hidden, so it is not pressed either (Q-7).
+ *
+ * THE FLOW [H3-7]. An in-flow dock's layout box changes length at the flip. The carrier
+ * gives that length back to the page on the window's own curve as root margins, split
+ * by the side the container grows the dock from, so the root box holds still and a
+ * neighbour travels with the glass.
+ *
+ * THE WINDOW FLAG. `data-morphing` is set when the lanes have a start and cleared when
+ * everything that moves is within 0.5 px of its target on the lanes' own clock; the lanes
+ * are pinned at their first crossing and hand over at the end (every animation is
+ * cancelled at its identity and the aperture returns to the root box).
+ */
+export interface UseDockApertureOptions {
+    rootEl: Ref<HTMLElement | null>;
+    /** The two faces whose boxes, with the root's, the carrier's ResizeObserver watches. */
+    expandedEl: Ref<HTMLElement | null>;
+    collapsedEl: Ref<HTMLElement | null>;
+    orientation: Ref<"horizontal" | "vertical">;
+    /** The outer collapsed/expanded face id. */
+    outerActiveLayer: Ref<string>;
+    /** The dock's one content observer (N-2): a seat added, removed or relabelled. */
+    content: DockContent;
+    /** Notifies the shell when the window opens and closes. */
+    onMorphActiveChange?: (active: boolean) => void;
+}
+
+export interface UseDockApertureReturn {
+    /** The outer face that currently owns layout and interaction. */
+    outerCurrentLayer: Readonly<Ref<string>>;
+    /** The face fading out, or null after the episode lands. */
+    outerLeavingLayer: Readonly<Ref<string | null>>;
+    /** A controlled face swap (DockCrossfade): the next episode carries its fades. */
+    swap: () => void;
+    /** A seat leaving the DOM hands its painted self to the carrier. */
+    retire: (seat: HTMLElement) => void;
+    /** Resolve when the current episode (if any) has landed. */
+    settled: () => Promise<void>;
+}
+
+/** Keyframe grid, ms: 120 Hz, finer than any display the carrier paints on. */
+const STEP_MS = 1000 / 120;
+/** Below this a lane does not move anything worth an animation, px. */
+const STILL_PX = 0.01;
+/** Two seats may share this fraction of the narrower one while both paint (H-3b). */
+const OVERLAP_FRAC = 0.2;
+/** A unit paints when its opacity is above this (H-3b, H3-1). */
+const PAINTS = 0.05;
+/** A leaving seat's fade, as a fraction of the episode's motion, and its floor in ms. */
+const FADE_OUT_FRAC = 0.4;
+/** An entering seat's fade, likewise. */
+const FADE_IN_FRAC = 0.35;
+const FADE_MIN_MS = 80;
+/** What the closing edge may leave of a seat on the glass when the window lands, as a fraction of it. */
+const SLIVER = 0.05;
+/** A frame gap longer than this is a block on the main thread, ms. */
+const STALL_MS = 100;
+const FRAME_MS = 1000 / 60;
+/** How far before the frame time an engine may sample, ms (after it: up to two frames). */
+const CLOCK_SLACK_MS = 2;
+/** The window lands when its length is this close to its target, px. */
+const LAND_PX = 0.5;
+
+type Axis = "x" | "y";
+interface Beat {
+    step: number;
+    window: number;
+}
+interface Span {
+    lo: number;
+    hi: number;
+}
+interface Geometry {
+    lo: number;
+    hi: number;
+    /** Seat extent on the main axis. */
+    seats: Map<HTMLElement, Span>;
+}
+/** An opacity fade on the episode's own time: `onset` and `window` in ms from its start. */
+interface FadeSpec {
+    el: HTMLElement;
+    from: number;
+    to: number;
+    onset: number;
+    window: number;
+}
+interface Ghost {
+    el: HTMLElement;
+    span: Span;
+    crossRect: DOMRect;
+    from: number;
+}
+interface Episode {
+    /** The animations' start time; null while they are pending (an episode from rest). */
+    t0: number | null;
+    endMs: number;
+    /** When the window lands and its flag closes, ms from the start. */
+    closeMs: number;
+    /** The span the aperture covers through the episode (its doors' reference). */
+    uLo: number;
+    uHi: number;
+    a: DockLane;
+    b: DockLane;
+    e: DockLane | null;
+    /** Per-seat own lanes (absolute offset from the seat's new layout). */
+    sigma: Map<HTMLElement, DockLane>;
+    /** The new natural geometry the lanes land on. */
+    target: Geometry;
+    /** Which edge each seat rides when it has no own lane. */
+    region: Map<HTMLElement, "a" | "b">;
+    fades: FadeSpec[];
+    anims: Animation[];
+    timers: number[];
+    resolve: Array<() => void>;
+    /** A swap's seam: where it stood at the start (px from the faces' start), its speed, and the seats it draws in. */
+    seam: { w0: number; v: number; enter: Set<HTMLElement> } | null;
+    /** What a seam cuts of each seat on the episode's grid: [start side, end side] in face coordinates, px. */
+    cuts: Map<HTMLElement, Array<[number, number]>>;
+}
+
+export function useDockAperture(
+    options: UseDockApertureOptions,
+): UseDockApertureReturn {
+    const { rootEl, orientation, outerActiveLayer } = options;
+    const currentLayer = ref(outerActiveLayer.value);
+    const leavingLayer = ref<string | null>(null);
+    const prefersReducedMotion = useMediaQuery("(prefers-reduced-motion: reduce)");
+
+    let episode: Episode | null = null;
+    /** Root span relative to its parent's start, and seat spans relative to the root's. */
+    let rest: { rootLo: number; rootHi: number; seats: Map<HTMLElement, Span> } | null =
+        null;
+    /** The side the container grows the dock from (0 its min side, 1 its max side), per run of episodes. */
+    let anchor = 0.5;
+    let postureChanged = false;
+    let swapPending = false;
+    const ghosts: Ghost[] = [];
+    let queued = false;
+    let disposed = false;
+
+    const axis = (): Axis => (orientation.value === "vertical" ? "y" : "x");
+    const lo = (r: DOMRect, ax: Axis) => (ax === "x" ? r.left : r.top);
+    const hi = (r: DOMRect, ax: Axis) => (ax === "x" ? r.right : r.bottom);
+    const tr = (v: number, ax: Axis) => (ax === "x" ? `${v}px 0px` : `0px ${v}px`);
+    const rtl = (root: HTMLElement) =>
+        axis() === "x" && getComputedStyle(root).direction === "rtl";
+    const tauOf = (ep: Episode, now: number) =>
+        ep.t0 == null ? 0 : Math.max(0, now - ep.t0);
+
+    function q<T extends Element = HTMLElement>(
+        root: HTMLElement,
+        sel: string,
+    ): T | null {
+        return root.querySelector<T & Element>(sel) as T | null;
+    }
+    function parts(root: HTMLElement) {
+        return {
+            aperture: q(root, ":scope > .dock-aperture"),
+            doorMin: q(root, ':scope > .dock-aperture > .dock-door[data-end="min"]'),
+            counterMin: q(
+                root,
+                ':scope > .dock-aperture > .dock-door[data-end="min"] > .dock-door-counter',
+            ),
+            doorMax: q(root, '.dock-door[data-end="max"]'),
+            counterMax: q(root, '.dock-door[data-end="max"] > .dock-door-counter'),
+            hitMin: q(root, ':scope > .dock-aperture > .dock-hit[data-end="min"]'),
+            hitCounter: q(
+                root,
+                ':scope > .dock-aperture > .dock-hit[data-end="min"] > .dock-door-counter',
+            ),
+            hitMax: q(root, '.dock-hit[data-end="max"]'),
+            shadeMin: q(root, ':scope > .dock-shade[data-end="min"]'),
+            casterMin: q(
+                root,
+                ':scope > .dock-shade[data-end="min"] > .dock-shade-caster',
+            ),
+            shadeMax: q(root, ':scope > .dock-shade[data-end="max"]'),
+            casterMax: q(
+                root,
+                ':scope > .dock-shade[data-end="max"] > .dock-shade-caster',
+            ),
+            persistent: q(
+                root,
+                ":scope > .dock-controls > .dock-persistent:not(.dock-persistent-end)",
+            ),
+            persistentEnd: q(root, ":scope > .dock-controls > .dock-persistent-end"),
+            layers: q(root, ":scope > .dock-controls > .dock-layers"),
+            ghosts: q(root, ":scope > .dock-controls > .dock-layers > .dock-ghosts"),
+        };
+    }
+    /** The faces: every child of the face door, the ghost layer included. */
+    function faceBoxes(layers: HTMLElement | null): HTMLElement[] {
+        return layers ? ([...layers.children] as HTMLElement[]) : [];
+    }
+    const HIDDEN_FACE =
+        ".dock-layer:not(.is-active):not(.is-leaving), .dock-face:not(.is-active):not(.is-leaving)";
+    /** The seats that paint: laid out, not a clone, not in a hidden face. */
+    function seatsIn(root: HTMLElement): HTMLElement[] {
+        return [...root.querySelectorAll<HTMLElement>("[data-dock-seat]")].filter(
+            (s) =>
+                !s.closest(".dock-ghosts") &&
+                !s.closest(HIDDEN_FACE) &&
+                s.getClientRects().length > 0,
+        );
+    }
+    /** What a face fades as units: its top-level seats and its separators, never a hidden face's. */
+    function unitsOf(face: HTMLElement): HTMLElement[] {
+        return [
+            ...face.querySelectorAll<HTMLElement>("[data-dock-seat], .dock-separator"),
+        ].filter(
+            (u) =>
+                !u.parentElement?.closest("[data-dock-seat]") &&
+                !u.closest(".dock-ghosts") &&
+                !(
+                    u.parentElement?.closest(HIDDEN_FACE) &&
+                    u.parentElement.closest(HIDDEN_FACE) !== face
+                ),
+        );
+    }
+
+    // ── geometry reads ────────────────────────────────────────────────────────────
+    /** The absolute lane offset an element paints at, τ ms into the episode. */
+    function offsetOf(ep: Episode, el: HTMLElement, tau: number): number {
+        const own = ep.sigma.get(el);
+        if (own) return own.at(tau).x;
+        return (regionOf(ep, el) === "b" ? ep.b : ep.a).at(tau).x;
+    }
+    /** The edge a seat rides: the end edge inside `.dock-persistent-end`, else the start edge. */
+    function regionOf(ep: Episode, el: HTMLElement): "a" | "b" {
+        const known = ep.region.get(el);
+        if (known) return known;
+        const root = rootEl.value;
+        const flipped = !!root && rtl(root);
+        const end = !!el.closest(".dock-persistent-end");
+        return end !== flipped ? "b" : "a";
+    }
+    function velocityOf(ep: Episode, el: HTMLElement, tau: number): number {
+        const own = ep.sigma.get(el);
+        if (own) return own.at(tau).v;
+        return (regionOf(ep, el) === "b" ? ep.b : ep.a).at(tau).v;
+    }
+    /**
+     * The natural (layout) geometry now. Read with no episode animation applied (`run`
+     * lifts a live episode's animations first), so a rect is the layout box; a seat's own
+     * engagement `scale` is centred on it, and its layout width is its painted width over
+     * that scale.
+     */
+    function natural(root: HTMLElement): Geometry {
+        const ax = axis();
+        const r = root.getBoundingClientRect();
+        const seats = new Map<HTMLElement, Span>();
+        for (const s of seatsIn(root)) {
+            const b = s.getBoundingClientRect();
+            const sc = getComputedStyle(s).scale;
+            const [kx, ky = kx] = sc === "none" ? ["1"] : sc.split(" ");
+            const w = (hi(b, ax) - lo(b, ax)) / Number.parseFloat(ax === "x" ? kx : ky);
+            const c = (lo(b, ax) + hi(b, ax)) / 2;
+            seats.set(s, { lo: c - w / 2, hi: c + w / 2 });
+        }
+        return { lo: lo(r, ax), hi: hi(r, ax), seats };
+    }
+    /** The geometry painted now: the running lanes at τ, or the rest cache. */
+    function painted(root: HTMLElement, tau: number): Geometry | null {
+        if (episode) {
+            const ep = episode;
+            const seats = new Map<HTMLElement, Span>();
+            for (const [s, span] of ep.target.seats) {
+                const off = offsetOf(ep, s, tau);
+                seats.set(s, { lo: span.lo + off, hi: span.hi + off });
+            }
+            return {
+                lo: ep.target.lo + ep.a.at(tau).x,
+                hi: ep.target.hi + ep.b.at(tau).x,
+                seats,
+            };
+        }
+        if (!rest || !root.parentElement) return null;
+        const ax = axis();
+        const p = root.parentElement.getBoundingClientRect();
+        const base = lo(p, ax);
+        const rootLo = base + rest.rootLo;
+        const seats = new Map<HTMLElement, Span>();
+        for (const [s, span] of rest.seats)
+            seats.set(s, { lo: rootLo + span.lo, hi: rootLo + span.hi });
+        return { lo: rootLo, hi: base + rest.rootHi, seats };
+    }
+    /** The observed boxes' sizes at the last read. */
+    const seen = new WeakMap<Element, string>();
+    const sizeOf = (el: Element) => {
+        const r = el.getBoundingClientRect();
+        return `${r.width.toFixed(2)} ${r.height.toFixed(2)}`;
+    };
+    function noteSizes(): void {
+        for (const el of observed) seen.set(el, sizeOf(el));
+    }
+    function cacheRest(root: HTMLElement): void {
+        if (episode || !root.parentElement) return;
+        const ax = axis();
+        const r = root.getBoundingClientRect();
+        if (r.width === 0 || r.height === 0) return;
+        const base = lo(root.parentElement.getBoundingClientRect(), ax);
+        const g = natural(root);
+        const seats = new Map<HTMLElement, Span>();
+        for (const [s, span] of g.seats)
+            seats.set(s, { lo: span.lo - g.lo, hi: span.hi - g.lo });
+        rest = { rootLo: g.lo - base, rootHi: g.hi - base, seats };
+    }
+
+    // ── the flip ──────────────────────────────────────────────────────────────────
+    function flip(): void {
+        if (queued || disposed) return;
+        queued = true;
+        void nextTick(() => {
+            queued = false;
+            run();
+        });
+    }
+
+    function swap(): void {
+        swapPending = true;
+        flip();
+    }
+
+    function run(): void {
+        const root = rootEl.value;
+        if (!root || disposed) return;
+        const rr = root.getBoundingClientRect();
+        if (rr.width === 0 || rr.height === 0) return; // not laid out: no rest, no episode
+        noteSizes();
+        // The time the window paints: the frame's clock, re-read from the doors (an
+        // engine that samples on its live clock is past the frame time by now).
+        const frameNow = document.timeline.currentTime as number;
+        const frameTau = episode ? tauOf(episode, frameNow) : 0;
+        const tau = episode ? paintedTau(root, episode, frameTau) : 0;
+        const now = frameNow + (tau - frameTau);
+        const pending = postureChanged || swapPending || ghosts.length > 0;
+        // One owner of the dock's extent (N-3, O-64 R-5): a seat's own size effect that
+        // holds the extent (the open-seat exchange) or keeps changing (an infinite effect)
+        // is the layout's, and opens no window; one that moves the extent is finished here
+        // and carried on the rung.
+        const handoff = handOffSizes(root, orientation.value);
+        if ((handoff === "hold" || handoff === "follow") && !pending) {
+            if (!episode) cacheRest(root);
+            return;
+        }
+        // What paints now comes from the lanes, in closed form. A live episode's animations
+        // are lifted before the layout read: an engine may or may not have applied the
+        // ones started this frame, so a rect read through them is ambiguous. A read that
+        // finds nothing changed re-releases every lane from its own (x, v), which continues
+        // the same curves.
+        const prev = episode;
+        const old = prev ? painted(root, tau) : null;
+        if (prev) for (const an of prev.anims) an.cancel();
+        const nat = natural(root);
+        if (!prev) {
+            const ref0 = painted(root, 0);
+            if (!ref0 || (!pending && same(nat, ref0))) {
+                cacheRest(root);
+                return;
+            }
+            // The side the container grows the dock from, read once from a rest: where the
+            // root's layout box moved against how much it grew.
+            const p = root.parentElement?.getBoundingClientRect();
+            if (rest && p) {
+                const base = lo(p, axis());
+                const grew = nat.hi - nat.lo - (rest.rootHi - rest.rootLo);
+                if (Math.abs(grew) > 0.5)
+                    anchor = Math.min(
+                        1,
+                        Math.max(0, -(nat.lo - base - rest.rootLo) / grew),
+                    );
+            }
+            play(root, now, 0, ref0, nat);
+            return;
+        }
+        play(root, now, tau, old!, nat);
+    }
+
+    /**
+     * The episode time the window paints. An engine may sample its animations on its live
+     * clock rather than the frame's (Playwright WebKit: a read later in the same task sees
+     * a later state), and at the window's speed a millisecond is pixels. The faster door's
+     * sampled `translate` finds the time on its own keyframes, so a retarget continues from
+     * what paints, not from the frame's clock.
+     */
+    function paintedTau(root: HTMLElement, ep: Episode, tau: number): number {
+        const P = parts(root);
+        const useMax = Math.abs(ep.b.at(tau).v) >= Math.abs(ep.a.at(tau).v);
+        const door = useMax ? P.doorMax : P.doorMin;
+        const lane = useMax ? ep.b : ep.a;
+        const edge = useMax ? ep.target.hi - ep.uHi : ep.target.lo - ep.uLo;
+        if (!door || Math.abs(lane.at(tau).v) < 10) return tau; // px/s: too slow to tell the time by
+        const t = getComputedStyle(door).translate;
+        if (t === "none") return tau;
+        const parts2 = t.split(" ").map((v) => Number.parseFloat(v));
+        const sampled = axis() === "x" ? parts2[0]! : (parts2[1] ?? 0);
+        // The keyframes are the lane on the episode's grid, linear between grid points.
+        const keyed = (k: number) => {
+            const i = Math.floor(k / STEP_MS);
+            const k0 = i * STEP_MS;
+            const k1 = Math.min(k0 + STEP_MS, ep.endMs);
+            if (k1 <= k0) return lane.at(k0).x;
+            const f = (k - k0) / (k1 - k0);
+            return lane.at(k0).x + (lane.at(k1).x - lane.at(k0).x) * f;
+        };
+        let best = tau;
+        let err = Number.POSITIVE_INFINITY;
+        for (
+            let k = Math.max(0, tau - CLOCK_SLACK_MS);
+            k <= Math.min(ep.endMs, tau + CLOCK_SLACK_MS + 2 * FRAME_MS);
+            k += 0.05
+        ) {
+            const e = Math.abs(edge + keyed(k) - sampled);
+            if (e < err) {
+                err = e;
+                best = k;
+            }
+        }
+        return best;
+    }
+
+    function same(a: Geometry, b: Geometry): boolean {
+        if (Math.abs(a.lo - b.lo) > 0.25 || Math.abs(a.hi - b.hi) > 0.25) return false;
+        if (a.seats.size !== b.seats.size) return false;
+        for (const [s, span] of a.seats) {
+            const o = b.seats.get(s);
+            if (
+                !o ||
+                Math.abs(o.lo - span.lo) > 0.25 ||
+                Math.abs(o.hi - span.hi) > 0.25
+            )
+                return false;
+        }
+        return true;
+    }
+
+    function fadeAt(f: FadeSpec, tau: number): number {
+        const k =
+            f.window <= 0
+                ? tau >= f.onset
+                    ? 1
+                    : 0
+                : Math.min(1, Math.max(0, (tau - f.onset) / f.window));
+        return f.from + (f.to - f.from) * k;
+    }
+    function readOpacity(ep: Episode | null, el: Element, tau: number): number | null {
+        const f = ep?.fades.find((x) => x.el === el);
+        return f ? fadeAt(f, tau) : null;
+    }
+
+    /**
+     * The face door's clip, an `inset()` of its own box: the window's cross edges, its end
+     * edge with the end cap's arcs (radius: the doors' corner, at most half the cross
+     * length) or, when an end region trails the faces, that region's first edge, straight;
+     * the start side reaches far past anything a face holds. The end sits at the inner
+     * side of the window's edge ring (`--dock-edge-width`), so content is cut under the
+     * ring and a glyph's anti-aliased edge never reaches past the glass's own (the two
+     * are rastered as separate layers).
+     */
+    function doorShape(
+        root: HTMLElement,
+        P: ReturnType<typeof parts>,
+        nat: Geometry,
+        ax: Axis,
+        isRtl: boolean,
+    ): string {
+        const lr = P.layers!.getBoundingClientRect();
+        const rr = root.getBoundingClientRect();
+        const pe = P.persistentEnd?.getBoundingClientRect();
+        const trails = !!pe && hi(pe, ax) - lo(pe, ax) > 0.5;
+        const px = (v: number) => `${+v.toFixed(2)}px`;
+        const far = "-100000px";
+        const cross = ax === "x" ? rr.height : rr.width;
+        const corner =
+            Number.parseFloat(
+                getComputedStyle(P.doorMax ?? root).borderTopRightRadius,
+            ) || 0;
+        const r = px(trails ? 0 : Math.min(corner, cross / 2));
+        const dp =
+            Number.parseFloat(
+                getComputedStyle(root).getPropertyValue("--dock-edge-width"),
+            ) || 0;
+        if (ax === "y") {
+            const end = (trails ? lo(pe!, ax) : nat.hi) - dp - lr.bottom;
+            return `inset(${far} ${px(lr.right - rr.right)} ${px(-end)} ${px(rr.left - lr.left)} round 0 0 ${r} ${r})`;
+        }
+        const t = px(rr.top - lr.top);
+        const b = px(lr.bottom - rr.bottom);
+        if (isRtl) {
+            const end = lr.left - (trails ? hi(pe!, ax) : nat.lo) - dp;
+            return `inset(${t} ${far} ${b} ${px(-end)} round ${r} 0 0 ${r})`;
+        }
+        const end = (trails ? lo(pe!, ax) : nat.hi) - dp - lr.right;
+        return `inset(${t} ${px(-end)} ${b} ${far} round 0 ${r} ${r} 0)`;
+    }
+
+    function play(
+        root: HTMLElement,
+        now: number,
+        tau: number,
+        old: Geometry,
+        nat: Geometry,
+    ): void {
+        const ax = axis();
+        const prev = episode;
+        const reduced = prefersReducedMotion.value;
+        const P = parts(root);
+        const isRtl = rtl(root);
+        const startEnd: "a" | "b" = isRtl ? "b" : "a";
+        const endEnd: "a" | "b" = isRtl ? "a" : "b";
+
+        // The ink scalar's painted value before anything is cancelled.
+        const eNow = prev?.e ? prev.e.at(tau) : null;
+        const eFromStyle = Number.parseFloat(
+            getComputedStyle(root).getPropertyValue("--dock-expand-t"),
+        );
+
+        // What each unit paints now, for the fades that continue.
+        const prevOpacity = new Map<Element, number>();
+        if (prev) for (const f of prev.fades) prevOpacity.set(f.el, fadeAt(f, tau));
+
+        // Cancel the running episode; every lane is replaced from its (x, v) at τ.
+        const va = prev ? prev.a.at(tau).v : 0;
+        const vb = prev ? prev.b.at(tau).v : 0;
+        const seatV = new Map<HTMLElement, number>();
