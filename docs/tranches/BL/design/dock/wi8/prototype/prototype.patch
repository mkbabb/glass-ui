+++ b/src/components/dock/styles/beside.css
@@ -0,0 +1,61 @@
+/* W-I.8 R-6: the fission seat. One slot (`#beside`), a region after the trailing
+   persistent region. Open, it is in flow one `--dock-layer-gap` past the main plate, on
+   a plate of its own; folded, it is out of flow, hidden and inert, and the pill is one
+   plate. The carrier writes the plates' and the neck's boxes; nothing here animates. */
+@layer components {
+    .glass-dock.has-beside:not(.vertical) {
+        padding-inline-end: 0;
+    }
+    .glass-dock:not(.vertical) > .dock-controls > .dock-beside {
+        display: flex;
+        align-items: center;
+        align-self: stretch;
+        /* The main plate's end padding, then the gap (the region's own padding, so the
+           pointer resting in it is inside the dock), then the seat's plate. */
+        margin-inline-start: var(--dock-padding-inline, 0.5rem);
+        margin-block: calc(-1 * var(--dock-padding-block, 0.375rem));
+        padding-inline: calc(var(--dock-layer-gap, 0.375rem) + var(--dock-padding-block, 0.375rem))
+            var(--dock-padding-block, 0.375rem);
+        padding-block: var(--dock-padding-block, 0.375rem);
+        position: relative;
+    }
+    .glass-dock.collapsed:not(.vertical) > .dock-controls > .dock-beside {
+        position: absolute;
+        inset-block: 0;
+        inset-inline-start: 100%;
+        margin: 0;
+    }
+    .glass-dock.collapsed:not([data-morphing]) > .dock-controls > .dock-beside {
+        visibility: hidden;
+    }
+    /* The second plate and the neck paint the dock's surface (`.dock-plate`); the neck
+       draws its two long edges only. The carrier shows them while they part. */
+    .glass-dock > .dock-neck {
+        border-inline-width: 0;
+        box-shadow: none;
+    }
+    .glass-dock.has-beside > .dock-plate {
+        box-shadow: var(--glass-rim-top), var(--glass-rim-bottom);
+    }
+    /* One shadow for the surface: one leaf under the plates whose box is the row's
+       painted extent. An outer shadow does not paint inside its own box. */
+    .glass-dock > .dock-shadow {
+        position: absolute;
+        inset: 0;
+        z-index: -2;
+        border-radius: inherit;
+        pointer-events: none;
+        box-shadow: var(
+            --shadow-dock-override,
+            0 0 calc(12px + 8px * var(--dock-expand-t))
+                color-mix(in srgb, var(--shadow-color) calc(12% + 2% * var(--dock-expand-t)), transparent)
+        );
+    }
+    /* The seat's glyph turns on hover (W-B.17's `data-glyph="turn"`); the dock adds no lift. */
+    .dock-beside [data-glyph="turn"] svg {
+        transition: rotate var(--spring-dock-duration) var(--spring-dock);
+    }
+    .dock-beside [data-glyph="turn"]:hover svg {
+        rotate: 45deg;
+    }
+}
