@@ -0,0 +1,54 @@
+/* W-I.8 R-7: the labelled seat. The name is one aria-hidden span against the seat's
+   inline start, out of flow, so showing it lays nothing out. The neighbours' room is a
+   `translate` the run writes; the seat's own list tweens it. Flat: one colour, no gleam,
+   no gradient, no shadow, no backdrop-filter. */
+@layer components {
+    .glass-dock [data-dock-label] {
+        position: relative;
+        background-image: none;
+        backdrop-filter: none;
+        box-shadow: none;
+        background-color: var(--plate-tone, transparent);
+    }
+    .glass-dock [data-dock-label]::before {
+        content: none;
+    }
+    .glass-dock [data-dock-label]:hover,
+    .glass-dock [data-dock-label][data-label-shown] {
+        background-color: color-mix(in srgb, var(--dock-fg-on-aurora, var(--foreground)) 8%, var(--plate-tone, transparent));
+    }
+    .dock-seat-label {
+        position: absolute;
+        inset-inline-end: calc(100% + 6px);
+        inset-block-start: 50%;
+        white-space: nowrap;
+        pointer-events: none;
+        font-size: var(--dock-label-size, 0.9375rem);
+        font-weight: 550;
+        line-height: 1;
+        color: var(--dock-fg-on-aurora, var(--foreground));
+        opacity: 0;
+        translate: 4px -50%;
+        transition:
+            opacity var(--spring-present-exit-duration, 160ms) var(--ease-out, ease-out),
+            translate var(--spring-present-exit-duration, 160ms) var(--ease-out, ease-out),
+            scale var(--spring-present-exit-duration, 160ms) var(--ease-out, ease-out);
+    }
+    [data-label-shown] > .dock-seat-label {
+        opacity: 1;
+        translate: 0 -50%;
+        transition:
+            opacity var(--duration-control, 140ms) var(--ease-out, ease-out),
+            translate var(--spring-present-duration, 220ms) var(--spring-present, ease-out),
+            scale var(--spring-present-duration, 220ms) var(--spring-present, ease-out);
+    }
+    /* Design B: it grows from the icon. */
+    .glass-dock[data-label-enter="b"] .dock-seat-label {
+        translate: 0 -50%;
+        scale: 0.8;
+        transform-origin: right center;
+    }
+    .glass-dock[data-label-enter="b"] [data-label-shown] > .dock-seat-label {
+        scale: 1;
+    }
+}
