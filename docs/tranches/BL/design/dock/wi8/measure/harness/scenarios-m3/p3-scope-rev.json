{
 "name": "p3-scope-rev",
 "url": "/?c=dock-wi8&cell=w-scope",
 "cells": [
  {
   "tag": "1440-fine-light",
   "w": 1440,
   "h": 900,
   "pointer": "fine",
   "scheme": "light"
  }
 ],
 "ready": "[data-testid=w-scope]",
 "warmMs": 600,
 "track": [
  {
   "as": "dock",
   "sel": "[data-testid=w-scope]",
   "attrs": [
    "class",
    "data-morphing"
   ],
   "props": [
    "--dock-expand-t",
    "--dock-morph-t"
   ],
   "colors": [
    "box-shadow"
   ]
  },
  {
   "as": "plate",
   "sel": "[data-testid=w-scope] .dock-plate",
   "colors": [
    "box-shadow",
    "background-color"
   ],
   "styles": [
    "clip-path"
   ]
  },
  {
   "as": "persistent",
   "sel": "[data-testid=w-scope] > .dock-controls > .dock-persistent:not(.dock-persistent-end)",
   "chain": true,
   "styles": [
    "clip-path"
   ]
  },
  {
   "as": "pend",
   "sel": "[data-testid=w-scope] > .dock-controls > .dock-persistent-end",
   "chain": true,
   "styles": [
    "clip-path"
   ]
  },
  {
   "as": "layers",
   "sel": "[data-testid=w-scope] .dock-layers",
   "chain": true,
   "styles": [
    "clip-path"
   ]
  },
  {
   "as": "full",
   "sel": "[data-testid=w-scope] .dock-layer--full",
   "chain": true
  },
  {
   "as": "summary",
   "sel": "[data-testid=w-scope] .dock-layer--summary",
   "chain": true
  },
  {
   "as": "seat",
   "sel": "[data-testid=w-scope] .dock-layer--full > [data-glass-dock-seat], [data-testid=w-scope] .dock-layer--full > * > [data-glass-dock-seat]",
   "all": true,
   "chain": true,
   "styles": [
    "translate"
   ]
  },
  {
   "as": "follower",
   "sel": "[data-testid=w-scope-follower]"
  },
  {
   "as": "scopehost",
   "sel": "[data-testid=w-scope-host]",
   "props": [
    "--dock-expand-t"
   ]
  },
  {
   "as": "kid",
   "sel": "[data-testid=w-scope] .dock-layer--full > *:not([data-dock-leaving])",
   "all": true,
   "chain": true
  }
 ],
 "cropAs": [
  "dock",
  "plate"
 ],
 "cropPad": 24,
 "gapMs": 250,
 "strips": [],
 "steps": [
  {
   "do": "leave",
   "to": [
    8,
    8
   ]
  },
  {
   "do": "mark",
   "name": "enter"
  },
  {
   "do": "hover",
   "sel": "[data-testid=w-scope]",
   "ms": 100,
   "hz": 60
  },
  {
   "do": "wait",
   "ms": 110
  },
  {
   "do": "mark",
   "name": "reverse-50"
  },
  {
   "do": "eval",
   "js": "document.querySelector('[data-testid=w-scope] .dock-run').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}))"
  },
  {
   "do": "leave",
   "to": [
    8,
    8
   ]
  },
  {
   "do": "settle",
   "quietMs": 500,
   "maxMs": 3000
  }
 ]
}