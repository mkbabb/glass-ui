@layer components :: .tl__mark-seat[data-v-(TimelineMarks)] {top:50%;left:calc(var(--tl-at) * 100%);pointer-events:none;line-height:0;display:flex;position:absolute;translate:-50% -50%}
@layer components :: .tl__mark-seat[data-v-(TimelineMarks)]>* {pointer-events:auto}
@layer components :: .tl__mark[data-v-(TimelineMarks)] {cursor:pointer;background:0 0;border:0;place-items:center;min-block-size:1.5rem;min-inline-size:1.5rem;padding:0;display:grid}
@layer components > @media (pointer:coarse) :: .tl__marks[data-v-(TimelineMarks)] {min-block-size:var(--touch-target)}
@layer components > @media (pointer:coarse) :: .tl__mark[data-v-(TimelineMarks)] {min-inline-size:var(--touch-target);min-block-size:var(--touch-target)}
@layer components :: .tl__mark[data-v-(TimelineMarks)]:focus-visible {box-shadow:var(--focus-ring-shadow);border-radius:var(--radius-pill);outline:none}
@layer components :: .tl__disc[data-v-(TimelineMarks)] {inline-size:var(--space-family);block-size:var(--space-family);background:var(--card);border:1px solid color-mix(in oklab, var(--foreground) calc(var(--ink-perimeter) * 100%), oklch(0% 0 0/0));transform:scaleX(var(--stretch,1)) scaleY(calc(1 / var(--stretch,1)));border-radius:50%;place-items:center;display:grid}
@layer components :: .tl__mark[data-crossing] .tl__disc[data-v-(TimelineMarks)] {will-change:transform}
@layer components :: .tl__mark[data-state=active] .tl__disc[data-v-(TimelineMarks)] {border-color:var(--tl-accent);border-width:2px}
@layer components :: .tl__mark[data-state=completed] .tl__disc[data-v-(TimelineMarks)] {background:var(--tl-accent);border-color:var(--tl-accent)}
@layer components :: .tl__mark[aria-current=step] .tl__disc[data-v-(TimelineMarks)] {box-shadow:0 0 0 2px color-mix(in oklab, var(--foreground) calc(var(--ink-perimeter) / 2 * 100%), oklch(0% 0 0/0))}
@layer components :: .tl__check[data-v-(TimelineMarks)] {block-size:100%;inline-size:100%;overflow:visible}
@layer components :: .tl__check path[data-v-(TimelineMarks)] {fill:none;stroke:contrast-color(var(--tl-accent));stroke-width:3px;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:32;stroke-dashoffset:0;animation:tl-check-(TimelineMarks) var(--spring-dock-duration) var(--spring-dock) both}
@layer components > @media (hover:hover) :: .tl__mark:hover .tl__disc[data-v-(TimelineMarks)] {scale:var(--scale-hover);background:color-mix(in oklab, var(--tl-accent) calc(var(--fill-hover) * 100%), var(--card))}
@layer components > @media (hover:hover) :: .tl__mark[data-state=completed]:hover .tl__disc[data-v-(TimelineMarks)] {background:var(--tl-accent)}
@layer components > @media (prefers-reduced-motion:reduce) :: .tl__check path[data-v-(TimelineMarks)] {animation:none}
@layer components > @media (prefers-reduced-motion:reduce) :: .tl__mark:hover .tl__disc[data-v-(TimelineMarks)] {scale:1}
@layer components :: .tl[data-v-(Timeline)] {row-gap:var(--space-body);grid-template-columns:100%;display:grid;position:relative}
@layer components :: .tl__track[data-v-(Timeline)],.tl__marks[data-v-(Timeline)] {grid-area:1/1;align-self:center}
@layer components :: .tl__track[data-v-(Timeline)] {block-size:var(--timeline-track-h);background:oklch(from var(--card) calc(l - .04) c h)}
@layer components :: .tl__span[data-v-(Timeline)] {inset-block:0;left:calc(var(--tl-l) * 100%);width:calc(var(--tl-w) * 100%);position:absolute;overflow:hidden}
@layer components :: .tl__fill[data-v-(Timeline)] {background:var(--tl-accent);transform:translateX(calc((var(--tl-f) - 1) * 100%));position:absolute;inset:0}
@layer components :: .tl__track[data-advancing] .tl__fill[data-v-(Timeline)] {will-change:transform}
@layer components :: .tl__cap[data-v-(Timeline)] {inset-block:0;inline-size:var(--timeline-track-h);border-radius:var(--radius-pill);background:var(--tl-accent);box-shadow:var(--glass-rim-top);transform:scaleX(var(--stretch,1)) scaleY(calc(1 / var(--stretch,1)));pointer-events:none;position:absolute;right:0}
@layer components :: .tl .track-flow[data-v-(Timeline)] {--track-flow-peak:var(--fill-selected)}
@layer components :: .tl__detail[data-v-(Timeline)] {animation:tl-detail-(Timeline) var(--spring-dock-duration) var(--spring-dock) both;grid-area:2/1}
@layer components > @media (prefers-reduced-motion:reduce) :: .tl__detail[data-v-(Timeline)] {animation-duration:.01ms}
@layer components :: .tw-root[data-v-(TypewriterText)] {vertical-align:baseline;max-width:100%;display:inline-grid;position:relative}
@layer components :: .tw-reserve[data-v-(TypewriterText)] {visibility:hidden;white-space:pre-wrap;overflow-wrap:anywhere;pointer-events:none;grid-area:1/1;min-width:0}
@layer components :: .tw-visual[data-v-(TypewriterText)] {white-space:pre-wrap;overflow-wrap:anywhere;position:absolute;inset:0}
@layer components :: .tw-tail[data-v-(TypewriterText)] {white-space:nowrap}
@layer components :: .tw-cursor[data-v-(TypewriterText)] {font-weight:100;display:inline-block}
@layer components :: .tw-cursor--blink[data-v-(TypewriterText)] {animation:1.06s step-end infinite typewriter-blink}
@layer components > @media (prefers-reduced-motion:reduce) :: .tw-cursor--blink[data-v-(TypewriterText)] {animation:none}
@keyframes disclosure-open :: 0% {opacity:0;block-size:0}
@keyframes disclosure-open :: to {block-size:var(--disclosure-content-size);opacity:1}
@keyframes disclosure-close :: 0% {block-size:var(--disclosure-content-size);opacity:1}
@keyframes disclosure-close :: to {opacity:0;block-size:0}
@keyframes expandable-container-birth :: 0% {opacity:0;scale:.78}
@keyframes expandable-container-birth :: to {opacity:1;scale:1}
@keyframes expandable-container-arrive :: 0% {opacity:0}
@keyframes expandable-container-arrive :: to {opacity:1}
@keyframes skeleton-breathe-(Skeleton) :: to {opacity:.55}
@keyframes progress-discharge-(Progress) :: 0% {box-shadow:inset 0 0 .5rem oklch(100% 0 0/0)}
@keyframes progress-discharge-(Progress) :: 50% {box-shadow:inset 0 0 .75rem oklch(100% 0 0/.12)}
@keyframes progress-discharge-(Progress) :: to {box-shadow:inset 0 0 .5rem oklch(100% 0 0/0)}
@keyframes feedback-mark-pulse-(StatusDot) :: 0% {opacity:.5;scale:.72}
@keyframes feedback-mark-pulse-(StatusDot) :: 55%,to {opacity:0;scale:1.08}
@keyframes hm-settle-(HandMark) :: 0% {opacity:.85}
@keyframes hm-settle-(HandMark) :: to {opacity:1}
@keyframes tl-check-(TimelineMarks) :: 0% {stroke-dashoffset:32px}
@keyframes tl-check-(TimelineMarks) :: to {stroke-dashoffset:0}
@keyframes tl-detail-(Timeline) :: 0% {opacity:0;translate:calc(var(--tl-dir) * var(--space-atom)) 0}
@keyframes tl-detail-(Timeline) :: to {opacity:1;translate:0}
