@@ -0,0 +1,64 @@
+import { mount } from "@vue/test-utils";
+import { defineComponent, nextTick, ref } from "vue";
+import { expect, it, vi } from "vitest";
+import { ToggleGroup, ToggleGroupItem } from "@glass/components/toggle-group";
+
+/* floor v3 (FV3-2, H3-12) · a consumer role, tabindex or state on an item no longer
+ * replaces the engine's. Its own file: a mount here, run before ToggleGroup.test.ts's
+ * late development-name case, can leave that case's MutationObserver silent in happy-dom
+ * (pass-3/D4-Dp-spec/logs/wt-devname-flake.log). */
+const host = (type: "single" | "multiple", initial: string | string[]) =>
+    mount(
+        defineComponent({
+            components: { ToggleGroup, ToggleGroupItem },
+            setup: () => ({ model: ref(initial), type }),
+            template: `<ToggleGroup :type="type" v-model="model">
+                <ToggleGroupItem v-for="v in ['a','b','c']" :key="v" :value="v" role="option" tabindex="0"
+                    aria-checked="false" aria-pressed="false" data-x="kept" title="t" style="color: red">{{ v }}</ToggleGroupItem>
+            </ToggleGroup>`,
+        }),
+        { attachTo: document.body },
+    );
+
+it("single: the engine's radio, checked state and one tab stop stand over a consumer's", async () => {
+    const wrapper = host("single", "b");
+    await nextTick();
+    const items = wrapper.findAll("button");
+    expect(items.map((b) => b.attributes("role"))).toEqual(["radio", "radio", "radio"]);
+    expect(items.map((b) => b.attributes("aria-checked"))).toEqual(["false", "true", "false"]);
+    expect(items.map((b) => b.attributes("tabindex"))).toEqual(["-1", "0", "-1"]);
+    expect(items[0]!.attributes("aria-pressed")).toBeUndefined();
+    // everything the engine does not own still lands
+    expect(items[0]!.attributes("data-x")).toBe("kept");
+    expect(items[0]!.attributes("title")).toBe("t");
+    expect(items[0]!.attributes("style")).toContain("color: red");
+    wrapper.unmount();
+});
+
+it("multiple: a consumer role is dropped (the button's own stands) and the pressed state is the engine's", async () => {
+    const wrapper = host("multiple", ["c"]);
+    await nextTick();
+    const items = wrapper.findAll("button");
+    expect(items.map((b) => b.attributes("role"))).toEqual([undefined, undefined, undefined]);
+    expect(items.map((b) => b.attributes("aria-pressed"))).toEqual(["false", "false", "true"]);
+    expect(items[0]!.attributes("aria-checked")).toBeUndefined();
+    expect(items.filter((b) => b.attributes("tabindex") === "0")).toHaveLength(1);
+    wrapper.unmount();
+});
+
+it("development names a consumer's role, tabindex or state once per item", async () => {
+    const errors: string[] = [];
+    const spy = vi.spyOn(console, "error").mockImplementation((m: unknown) => {
+        errors.push(String(m));
+    });
+    const wrapper = host("single", "a");
+    await nextTick();
+    await new Promise((r) => requestAnimationFrame(() => r(null)));
+    const owned = errors.filter((e) => e.includes("the group's engine owns"));
+    expect(owned).toHaveLength(3);
+    expect(owned[0]).toBe(
+        '[ToggleGroupItem] value="a" sets role, tabindex, aria-checked, aria-pressed: the group\'s engine owns an option\'s role, state and tab stop, and its values stand.',
+    );
+    spy.mockRestore();
+    wrapper.unmount();
+});
diff --git a/tests/utils/strongObservers.ts b/tests/utils/strongObservers.ts
new file mode 100644
index 000000000..e8f5296a8
--- /dev/null
+++ b/tests/utils/strongObservers.ts
@@ -0,0 +1,38 @@
+/* A MutationObserver that must hear LATE content, made under a strong reference.
+ *
+ * happy-dom holds an observer's delivery closure only through a WeakRef
+ * (`mutation-observer/MutationObserverListener.js`: `callback: new WeakRef((record) =>
+ * this.report(record))`), and nothing else holds that closure. Once a scavenge collects
+ * it, the observed node's mutations are dropped with no error, so a test that adds
+ * content after mount passes alone and fails in the full suite. A browser keeps the
+ * callback for as long as the observer lives, so the component is not at fault: the
+ * environment is. Every observer created inside `create` keeps its closure. */
+class StrongRef<T extends object> {
+    readonly #target: T;
+    constructor(target: T) {
+        this.#target = target;
+    }
+    deref(): T {
+        return this.#target;
+    }
+}
+
+export function withStrongObservers<T>(create: () => T): T {
+    const weak = globalThis.WeakRef;
+    globalThis.WeakRef = StrongRef as unknown as WeakRefConstructor;
+    try {
+        return create();
+    } finally {
+        globalThis.WeakRef = weak;
+    }
+}
+
+/* Give the collector its chance before late content arrives: a forced collection where
+ * `--expose-gc` is on, and three macrotask turns, which let a scavenge take an unpinned
+ * closure. */
+export async function letCollectorRun(): Promise<void> {
+    for (let k = 0; k < 3; k++) {
+        (globalThis as { gc?: () => void }).gc?.();
+        await new Promise((r) => setTimeout(r, 0));
+    }
+}
