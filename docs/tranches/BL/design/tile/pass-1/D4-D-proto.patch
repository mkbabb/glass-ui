+/* glass/cell.css — the cell shape, one declaration for both selection atoms.
+
+   A selectable option that holds more than one line is a box, not a stadium
+   (radius.css: "a box is not a stadium"), so its corner is the field rung. Chip
+   (`shape="cell"`) and ToggleGroup (`shape="cell"`, declared once at the group)
+   share this one rule; neither sheet restates it. The chip pair doubles the class
+   to outrank `.glass-capsule`'s own corner; the group arm outranks the item's
+   stadium by specificity. */
+@layer components {
+    .glass-chip--cell,
+    .glass-chip--cell.glass-capsule,
+    .toggle-group[data-shape="cell"] .toggle-group__item {
+        border-radius: var(--radius-field);
+    }
+}
