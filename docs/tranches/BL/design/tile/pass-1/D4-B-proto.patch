@@ -0,0 +1,82 @@
+<script setup lang="ts">
+import { computed, onBeforeUnmount, onMounted, ref, useSlots, type HTMLAttributes } from "vue";
+import { cn } from "../_shared/class-names";
+import type { SelectionValue } from "../_shared/selection";
+import { useChoiceGroupContext, type ChoiceEntry } from "./context";
+
+/* A card that is a radio (or, in a `multiple` group, a pressed toggle). Anatomy, in
+ * reading order: a title row with a trailing mark, an optional body (live content: a
+ * thumbnail, a stage, a readout, a blurb), and a meta line. The host is the button:
+ * every state paints on it through attributes, so a live slot is never re-rendered to
+ * show a state. Content is phrasing content and presentational (a radio's children
+ * are): no controls. */
+export interface ChoiceCardProps {
+    value: SelectionValue;
+    disabled?: boolean;
+    /** The selection hue: a complete colour. The edge, fill and flood read it. */
+    tone?: string;
+    class?: HTMLAttributes["class"];
+}
+
+defineOptions({ name: "ChoiceCard" });
+const props = defineProps<ChoiceCardProps>();
+defineSlots<{
+    default?: () => unknown;
+    title?: () => unknown;
+    meta?: () => unknown;
+    mark?: (p: { selected: boolean }) => unknown;
+}>();
+const slots = useSlots();
+
+const group = useChoiceGroupContext();
+if (!group) throw new Error("[ChoiceCard] must be a descendant of <ChoiceGroup>.");
+
+const el = ref<HTMLElement | null>(null);
+const entry: ChoiceEntry = {
+    get value() {
+        return props.value;
+    },
+    disabled: () => props.disabled === true || group.disabled.value,
+    el: null,
+};
+onMounted(() => {
+    entry.el = el.value;
+    group.register(entry);
+    if (import.meta.env.DEV && el.value?.querySelector("a[href],button,input,select,textarea,[tabindex]"))
+        console.error("[ChoiceCard] holds an interactive descendant; a radio's content is presentational.", el.value);
+});
+onBeforeUnmount(() => group.unregister(entry));
+
+const selected = computed(() => group.isSelected(props.value));
+const showMark = computed(() => !!slots.mark || group.size.value === "md");
+const hasHead = computed(() => !!slots.title || showMark.value);
+</script>
+
+<template>
+    <button
+        ref="el"
+        type="button"
+        data-slot="choice-card"
+        :class="cn('choice-card focus-ring', props.class)"
+        :data-state="selected ? 'on' : 'off'"
+        :data-size="group.size.value"
+        :disabled="entry.disabled() || undefined"
+        :tabindex="group.tabindex(entry)"
+        :style="props.tone ? { '--choice-tone': props.tone } : undefined"
+        v-bind="group.itemAttrs(props.value)"
+        @click="group.select(entry)"
+    >
+        <span v-if="hasHead" class="choice-card__head">
+            <span class="choice-card__title"><slot name="title" /></span>
+            <span v-if="showMark" class="choice-card__mark" aria-hidden="true">
+                <slot name="mark" :selected="selected">
+                    <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg>
+                </slot>
+            </span>
+        </span>
+        <span v-if="slots.default" class="choice-card__body"><slot /></span>
+        <span v-if="slots.meta" class="choice-card__meta"><slot name="meta" /></span>
+    </button>
+</template>
+
+<style src="./styles.css"></style>
