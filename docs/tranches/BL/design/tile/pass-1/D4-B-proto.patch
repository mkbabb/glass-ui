index 00000000..4994e43e
--- /dev/null
+++ b/src/components/choice/styles.css
@@ -0,0 +1,259 @@
+/* The choice card's state channels, registered so they interpolate on the light clock.
+   The fill does not inherit; the two progress numbers do, because the perimeter, the
+   flood and the mark are the card's own pseudo-elements and descendants. */
+@property --choice-fill {
+    syntax: "<color>";
+    inherits: false;
+    initial-value: transparent;
+}
+@property --choice-edge-t {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+}
+@property --choice-flood-t {
+    syntax: "<number>";
+    inherits: true;
+    initial-value: 0;
+}
+
+@layer components {
+    /* THE GROUP owns the layout and the ring's clearance: the ring reaches 4 px
+       (2 px outline + 2 px offset), so a group inside a scroll port pads 4 px and the
+       port can never cut it. */
+    .choice-group {
+        display: grid;
+        grid-template-columns: repeat(auto-fill, minmax(min(var(--choice-column), 100%), 1fr));
+        gap: var(--space-atom);
+        padding: var(--space-residue);
+    }
+
+    /* THE CARD. The card rung by construction (r : pad = 16 : 12); a box, never a
+       stadium, whatever it holds. */
+    .choice-card {
+        --choice-tone: var(--foreground);
+        /* the selection ink: the tone, solid, with its lightness floored away from
+           the plate so any hue separates from the unselected sibling at >= 3:1
+           (a mid-L violet at L 0.56 measured short of the bar in light). */
+        --choice-edge: oklch(from var(--choice-tone) min(l, 0.42) c h);
+        --choice-cast: var(--glass-shadow-resting);
+        position: relative;
+        isolation: isolate;
+        display: flex;
+        flex-direction: column;
+        align-items: stretch;
+        gap: var(--space-residue);
+        min-inline-size: 0;
+        min-block-size: var(--control-h-md);
+        padding: var(--space-atom) var(--space-body);
+        border: 1px solid oklch(from var(--foreground) l c h / var(--ink-edge));
+        border-radius: var(--radius-card);
+        background-color: var(--control-surface-bg);
+        /* the state fill rides the plate's own image layer, above its colour */
+        background-image: linear-gradient(var(--choice-fill), var(--choice-fill));
+        backdrop-filter: var(--control-surface-blur);
+        box-shadow: var(--glass-rim-top), var(--glass-rim-bottom);
+        color: var(--foreground);
+        font: inherit;
+        font-size: var(--control-text);
+        line-height: var(--type-leading-body);
+        text-align: start;
+        cursor: pointer;
+        appearance: none;
+        touch-action: manipulation;
+        user-select: none;
+        scale: 1;
+        transition:
+            --choice-fill var(--engage-control-engage-release) var(--ease-standard),
+            --choice-edge-t var(--engage-control-engage-release) var(--ease-standard),
+            border-color var(--engage-control-engage-release) var(--ease-standard),
+            box-shadow var(--engage-control-engage-release) var(--ease-standard),
+            scale var(--spring-press-duration) var(--transition-liquid-spatial);
+    }
+
+    .dark .choice-card {
+        --choice-edge: oklch(from var(--choice-tone) max(l, 0.8) c h);
+    }
+
+    .choice-card[data-size="sm"] {
+        min-block-size: var(--control-h-sm);
+        padding: var(--space-residue) var(--space-atom);
+        font-size: var(--control-text-sm);
+    }
+
+    /* THE PERIMETER: its own layer over the border, 2 px of the tone, so the state
+       never spends `outline` (the ring's) or `box-shadow` (the ring's and the rim's)
+       and never shifts layout. */
+    .choice-card::before {
+        content: "";
+        position: absolute;
+        inset: -1px;
+        border: 2px solid var(--choice-edge);
+        border-radius: inherit;
+        opacity: var(--choice-edge-t);
+        pointer-events: none;
+    }
+
+    /* THE FLOOD: a wash of the tone that blooms after the spatial pop and settles
+       under the content. Normal blending in both arms and a low strength, so the
+       content keeps its own ink contrast (a plus-lighter flood lifts a dark plate
+       toward a light label: measured 3.82:1 on the title in dark). */
+    .choice-card::after {
+        content: "";
+        position: absolute;
+        inset: 0;
+        z-index: -1;
+        border-radius: inherit;
+        background: radial-gradient(
+            130% 150% at 50% 0%,
+            color-mix(in oklab, var(--choice-tone) 8%, transparent),
+            color-mix(in oklab, var(--choice-tone) 3%, transparent) 70%
+        );
+        opacity: var(--choice-flood-t);
+        pointer-events: none;
+        transition: opacity var(--duration-normal) var(--ease-out) 60ms;
+    }
+
+    .choice-card[data-state="on"] {
+        --choice-fill: color-mix(in oklab, var(--choice-tone) calc(var(--fill-selected) * 100%), transparent);
+        --choice-edge-t: 1;
+        --choice-flood-t: 1;
+        /* the commit attacks on the fast clock whatever set it (pointer or key);
+           the release back to rest keeps the slow clock of the base rule */
+        transition:
+            --choice-fill var(--engage-control-engage-attack) var(--ease-standard),
+            --choice-edge-t var(--engage-control-engage-attack) var(--ease-standard),
+            border-color var(--engage-control-engage-release) var(--ease-standard),
+            box-shadow var(--engage-control-engage-release) var(--ease-standard),
+            scale var(--spring-press-duration) var(--transition-liquid-spatial);
+    }
+
+    .choice-group[data-live] .choice-card[data-state="on"] {
+        animation: choice-commit var(--spring-press-duration) var(--ease-cartoon-punch);
+    }
+
+    @keyframes choice-commit {
+        0% { scale: 1; }
+        40% { scale: 1.025; }
+        100% { scale: 1; }
+    }
+
+    /* HOVER lifts one elevation rung and answers in light; bracketed so a coarse tap
+       never latches it. */
+    @media (hover: hover) {
+        .choice-card:hover:not(:disabled) {
+            --choice-fill: oklch(from var(--foreground) l c h / var(--fill-hover));
+            border-color: oklch(from var(--foreground) l c h / var(--ink-perimeter));
+            box-shadow: var(--glass-rim-top), var(--glass-rim-bottom), var(--glass-shadow-floating);
+            scale: 1.015;
+            transition:
+                --choice-fill var(--engage-control-engage-attack) var(--ease-standard),
+                --choice-edge-t var(--engage-control-engage-attack) var(--ease-standard),
+                border-color var(--engage-control-engage-attack) var(--ease-standard),
+                box-shadow var(--engage-control-engage-attack) var(--ease-standard),
+                scale var(--spring-press-duration) var(--transition-liquid-spatial);
+        }
+
+        .choice-card[data-state="on"]:hover:not(:disabled) {
+            --choice-fill: color-mix(
+                in oklab,
+                var(--choice-tone) calc((var(--fill-selected) + var(--fill-hover)) * 100%),
+                transparent
+            );
+        }
+    }
+
+    .choice-card:active:not(:disabled) {
+        scale: var(--scale-press-sm);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .choice-card:hover:not(:disabled),
+        .choice-card:active:not(:disabled) {
+            scale: 1;
+        }
+        .choice-group[data-live] .choice-card[data-state="on"] {
+            animation: none;
+        }
+    }
+
+    .choice-card:disabled {
+        opacity: var(--opacity-disabled);
+        cursor: not-allowed;
+    }
+
+    /* ── ANATOMY ── */
+    .choice-card__body {
+        display: block;
+        min-inline-size: 0;
+    }
+
+    .choice-card__head {
+        display: flex;
+        align-items: center;
+        gap: var(--space-atom);
+        min-inline-size: 0;
+    }
+
+    .choice-card__title {
+        flex: 1 1 auto;
+        min-inline-size: 0;
+        font-weight: 500;
+        overflow-wrap: anywhere;
+    }
+
+    .choice-card__meta {
+        min-inline-size: 0;
+        overflow: hidden;
+        color: var(--muted-foreground-strong);
+        font-family: var(--font-mono);
+        font-size: var(--type-caption);
+        font-variant-numeric: tabular-nums;
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    /* the selected plate carries a fill and a flood; the meta line lifts to full ink
+       with it so a caption keeps 4.5:1 on the darker (light) or lighter (dark) plate */
+    .choice-card[data-state="on"] .choice-card__meta {
+        color: var(--foreground);
+    }
+
+    .choice-card__mark {
+        display: inline-grid;
+        flex: none;
+        place-items: center;
+        inline-size: 1rem;
+        block-size: 1rem;
+        border-radius: var(--radius-pill);
+        background: var(--choice-tone);
+        color: var(--background);
+        opacity: var(--choice-edge-t);
+        scale: calc(0.6 + 0.4 * var(--choice-edge-t));
+    }
+
+    .choice-card__mark svg {
+        inline-size: 0.75rem;
+        block-size: 0.75rem;
+        fill: none;
+        stroke: currentColor;
+        stroke-width: 2;
+        stroke-linecap: round;
+        stroke-linejoin: round;
+    }
+
+    @media (forced-colors: active) {
+        .choice-card {
+            border-color: ButtonText;
+            background: Canvas;
+            box-shadow: none;
+        }
+        .choice-card::before {
+            border-color: Highlight;
+        }
+        .choice-card__mark {
+            background: Highlight;
+            color: HighlightText;
+        }
+    }
+}
diff --git a/tests/components/choice/Choice.test.ts b/tests/components/choice/Choice.test.ts
new file mode 100644
index 00000000..2d2540e8
--- /dev/null
+++ b/tests/components/choice/Choice.test.ts
@@ -0,0 +1,75 @@
+/* The choice card's node-readable contract: roles per mode, one tab stop, the
+ * commit on click, the refusal outside a group. Geometry, the perimeter's contrast
+ * and the grid walk are browser measurements (the D4 tile battery, W-B and T-3). */
+import { mount } from "@vue/test-utils";
+import { defineComponent, nextTick, ref } from "vue";
+import { describe, expect, it } from "vitest";
+import { ChoiceCard, ChoiceGroup } from "@glass/components/choice";
+
+function mountGroup(type: "single" | "multiple", initial: string | string[]) {
+    return mount(
+        defineComponent({
+            components: { ChoiceGroup, ChoiceCard },
+            setup: () => ({ model: ref(initial), type }),
+            template: `
+                <ChoiceGroup v-model="model" :type="type">
+                    <ChoiceCard value="a"><template #title>A</template><template #meta>one</template></ChoiceCard>
+                    <ChoiceCard value="b"><template #title>B</template></ChoiceCard>
+                    <ChoiceCard value="c" disabled><template #title>C</template></ChoiceCard>
+                </ChoiceGroup>`,
+        }),
+        { attachTo: document.body },
+    );
+}
+
+describe("ChoiceGroup + ChoiceCard", () => {
+    it("single is a radiogroup of radios with one tab stop", async () => {
+        const w = mountGroup("single", "b");
+        await nextTick();
+        const group = w.get('[data-slot="choice-group"]');
+        expect(group.attributes("role")).toBe("radiogroup");
+        const cards = w.findAll('[data-slot="choice-card"]');
+        expect(cards.map((c) => c.attributes("role"))).toEqual(["radio", "radio", "radio"]);
+        expect(cards.map((c) => c.attributes("aria-checked"))).toEqual(["false", "true", "false"]);
+        expect(cards.filter((c) => c.attributes("tabindex") === "0")).toHaveLength(1);
+        expect(cards[1].attributes("tabindex")).toBe("0");
+        expect(cards[1].attributes("data-state")).toBe("on");
+        w.unmount();
+    });
+
+    it("a click commits the value and moves the state", async () => {
+        const w = mountGroup("single", "b");
+        await nextTick();
+        await w.findAll('[data-slot="choice-card"]')[0].trigger("click");
+        const cards = w.findAll('[data-slot="choice-card"]');
+        expect(cards[0].attributes("aria-checked")).toBe("true");
+        expect(cards[0].attributes("data-state")).toBe("on");
+        expect(cards[1].attributes("data-state")).toBe("off");
+        w.unmount();
+    });
+
+    it("multiple is a group of pressed toggles", async () => {
+        const w = mountGroup("multiple", ["a"]);
+        await nextTick();
+        expect(w.get('[data-slot="choice-group"]').attributes("role")).toBe("group");
+        const cards = w.findAll('[data-slot="choice-card"]');
+        expect(cards[0].attributes("aria-pressed")).toBe("true");
+        expect(cards[1].attributes("aria-pressed")).toBe("false");
+        w.unmount();
+    });
+
+    it("renders the anatomy it is given, and the md mark", async () => {
+        const w = mountGroup("single", "a");
+        await nextTick();
+        const first = w.findAll('[data-slot="choice-card"]')[0];
+        expect(first.find(".choice-card__title").text()).toBe("A");
+        expect(first.find(".choice-card__meta").text()).toBe("one");
+        expect(first.find(".choice-card__mark").exists()).toBe(true);
+        expect(first.find(".choice-card__body").exists()).toBe(false);
+        w.unmount();
+    });
+
+    it("refuses to render outside a group", () => {
+        expect(() => mount(ChoiceCard, { props: { value: "x" } })).toThrow(/ChoiceGroup/);
+    });
+});
