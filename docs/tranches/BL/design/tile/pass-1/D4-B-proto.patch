@@ -0,0 +1,83 @@
+<script setup lang="ts">
+import { computed, onMounted, ref, shallowRef, triggerRef, type HTMLAttributes } from "vue";
+import { cn } from "../_shared/class-names";
+import type { SelectionMode, SelectionValue } from "../_shared/selection";
+import { useSelectionGroup } from "../../composables/motion/morph/useSelectionGroup";
+import { provideChoiceGroupContext, type ChoiceEntry } from "./context";
+
+/* A set of choice cards: one-of-N (`single`, a radiogroup) or N-of-M (`multiple`, a
+ * group of pressed toggles). The group owns the layout (an auto-fill grid of
+ * `minColumn` tracks), the ring clearance, and the keyboard: the one selection
+ * engine with the `grid` arrow model, so every arrow moves in a set laid out in rows. */
+export interface ChoiceGroupProps {
+    type?: SelectionMode;
+    size?: "sm" | "md";
+    /** The narrowest column the auto-fill grid will make. */
+    minColumn?: string;
+    disabled?: boolean;
+    class?: HTMLAttributes["class"];
+}
+
+defineOptions({ name: "ChoiceGroup" });
+const props = withDefaults(defineProps<ChoiceGroupProps>(), { type: "single", size: "md", minColumn: "12rem" });
+const model = defineModel<SelectionValue | SelectionValue[]>();
+
+const containerRef = ref<HTMLElement | null>(null);
+const entries = shallowRef<ChoiceEntry[]>([]);
+const ordered = computed(() =>
+    [...entries.value].sort((a, b) =>
+        !a.el || !b.el ? 0 : a.el.compareDocumentPosition(b.el) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
+    ),
+);
+const options = computed(() => ordered.value.map((e) => ({ value: e.value, disabled: e.disabled() })));
+const buttonRefs = computed(() => ordered.value.map((e) => e.el).filter((el): el is HTMLElement => !!el));
+
+const selection = useSelectionGroup<{ value: SelectionValue; disabled: boolean }>({
+    options,
+    model,
+    mode: computed(() => props.type),
+    activation: computed(() => (props.type === "single" ? "automatic" : "manual")),
+    arrows: computed(() => "grid"),
+    containerRef,
+    buttonRefs,
+});
+
+/* The commit pop plays on a committed change, never on the first paint. */
+const live = ref(false);
+onMounted(() => requestAnimationFrame(() => (live.value = true)));
+
+provideChoiceGroupContext({
+    register(entry) {
+        entries.value.push(entry);
+        triggerRef(entries);
+    },
+    unregister(entry) {
+        const at = entries.value.indexOf(entry);
+        if (at >= 0) entries.value.splice(at, 1);
+        triggerRef(entries);
+    },
+    isSelected: (v) => selection.isSelected(v),
+    itemAttrs: (v) => selection.itemAttrs(v),
+    tabindex: (entry) => selection.rovingTabindex(ordered.value.indexOf(entry)),
+    select: (entry) => selection.select(entry.value, ordered.value.indexOf(entry)),
+    disabled: computed(() => props.disabled),
+    size: computed(() => props.size),
+});
+</script>
+
+<template>
+    <div
+        ref="containerRef"
+        data-slot="choice-group"
+        :class="cn('choice-group', props.class)"
+        :role="selection.groupRole.value"
+        :data-size="props.size"
+        :data-live="live || undefined"
+        :style="{ '--choice-column': props.minColumn }"
+        @keydown="selection.onKeydown"
+    >
+        <slot />
+    </div>
+</template>
+
+<style src="./styles.css"></style>
