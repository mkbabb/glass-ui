+import type { ComputedRef } from "vue";
+import { createOptionalContext } from "../../composables/context";
+import type { SelectionValue } from "../_shared/selection";
+
+/* The item registry: each ChoiceCard publishes itself on mount, the group derives the
+ * engine's index-aligned `options` and `buttonRefs` in DOM order. */
+export interface ChoiceEntry {
+    readonly value: SelectionValue;
+    readonly disabled: () => boolean;
+    el: HTMLElement | null;
+}
+
+export interface ChoiceGroupContext {
+    register: (entry: ChoiceEntry) => void;
+    unregister: (entry: ChoiceEntry) => void;
+    isSelected: (value: SelectionValue) => boolean;
+    itemAttrs: (value: SelectionValue) => Record<string, string>;
+    tabindex: (entry: ChoiceEntry) => number;
+    select: (entry: ChoiceEntry) => void;
+    disabled: ComputedRef<boolean>;
+    size: ComputedRef<"sm" | "md">;
+}
+
+const ctx = createOptionalContext<ChoiceGroupContext>("glass-ui:choice-group");
+export const provideChoiceGroupContext = ctx.provide;
+export const useChoiceGroupContext = ctx.use;
