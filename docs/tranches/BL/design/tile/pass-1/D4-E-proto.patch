diff --git a/src/components/_shared/one-line.ts b/src/components/_shared/one-line.ts
new file mode 100644
index 00000000..35dc684e
--- /dev/null
+++ b/src/components/_shared/one-line.ts
@@ -0,0 +1,96 @@
+import { onBeforeUnmount, onMounted, onUpdated } from "vue";
+
+/* AN OPTION IS ONE LINE. A one-of-N option on the control rung is a stadium, and a
+ * stadium is only correct while the option holds one row: a label, a glyph, or both
+ * side by side. Past the rung the corner tracks the content and the pill becomes a
+ * lozenge. Detail belongs to the selection (one detail row), not to each option.
+ *
+ * DEV only, and loud: `console.error` on the first violation per element, stripped
+ * from the production bundle with the branch (the Button retired-prop idiom). */
+
+/** Rows of content inside `el`: text line boxes and graphics, clustered by overlap. */
+function rows(el: HTMLElement): number {
+    const rects: DOMRect[] = [];
+    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+    while (walker.nextNode()) {
+        const node = walker.currentNode;
+        if (!node.textContent?.trim()) continue;
+        const range = document.createRange();
+        range.selectNodeContents(node);
+        for (const r of range.getClientRects()) if (r.width > 0.5 && r.height > 0.5) rects.push(r);
+    }
+    for (const g of el.querySelectorAll("svg, img, canvas, video")) {
+        if (g.parentElement?.closest("svg")) continue;
+        const r = g.getBoundingClientRect();
+        if (r.width > 0.5 && r.height > 0.5) rects.push(r);
+    }
+    /* A new row starts past the vertical midpoint of the current one: text rects are
+       the font's content area, taller than a `line-height: 1` line box, so stacked
+       lines overlap and an edge-overlap test would merge them. */
+    rects.sort((a, b) => a.top - b.top);
+    let n = 0;
+    let mid = -Infinity;
+    for (const r of rects) {
+        if (r.top >= mid) {
+            n++;
+            mid = r.top + r.height / 2;
+        }
+    }
+    return n;
+}
+
+/**
+ * Refuse, in DEV, any option element that holds more than one row or grows past its
+ * control rung (`min-block-size`). `nodes` returns the option elements; `name` labels
+ * one for the message.
+ */
+export function useOneLineOptions(
+    host: string,
+    nodes: () => HTMLElement[],
+    name: (el: HTMLElement) => string,
+): void {
+    if (!import.meta.env.DEV || typeof ResizeObserver === "undefined") return;
+    const told = new WeakSet<HTMLElement>();
+    const check = (el: HTMLElement) => {
+        if (told.has(el) || !el.isConnected) return;
+        const cs = getComputedStyle(el);
+        const rung = parseFloat(cs.minBlockSize) || 0;
+        const h = el.offsetHeight;
+        const n = rows(el);
+        if (n <= 1 && !(rung > 0 && h > rung + 0.5)) return;
+        told.add(el);
+        console.error(
+            `[glass-ui] <${host}> option "${name(el)}" holds ${n} rows ` +
+                `(${h.toFixed(1)}px at a ${rung ? rung.toFixed(1) + "px" : "one-line"} rung). ` +
+                `An option is one line: a label, a glyph, or both. Move the detail out ` +
+                `of the option, into one detail row for the selection or a caption ` +
+                `outside the plate.`,
+        );
+    };
+    /* Two triggers: a resize (content grew the box) and a content mutation (the box
+       is locked to its rung, so a second row spills without resizing it). */
+    let ro: ResizeObserver | null = null;
+    let mo: MutationObserver | null = null;
+    const observe = () => {
+        ro?.disconnect();
+        mo?.disconnect();
+        ro = new ResizeObserver((entries) => entries.forEach((e) => check(e.target as HTMLElement)));
+        mo = new MutationObserver((records) => {
+            for (const r of records) {
+                const host = nodes().find((el) => el.contains(r.target));
+                if (host) check(host);
+            }
+        });
+        for (const el of nodes()) {
+            ro.observe(el);
+            mo.observe(el, { childList: true, subtree: true, characterData: true });
+            check(el);
+        }
+    };
+    onMounted(observe);
+    onUpdated(observe);
+    onBeforeUnmount(() => {
+        ro?.disconnect();
+        mo?.disconnect();
+    });
+}
