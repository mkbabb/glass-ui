new file mode 100644
index 00000000..239aba86
--- /dev/null
+++ b/src/components/selection/SelectionGroup.vue
@@ -0,0 +1,88 @@
+<script setup lang="ts">
+import { computed, ref, shallowRef, triggerRef, type HTMLAttributes } from "vue";
+import type { Orientation } from "../_shared/axes";
+import type { SelectionMode, SelectionValue } from "../_shared/selection";
+import { useSelectionGroup } from "../../composables/motion/morph/useSelectionGroup";
+import { provideSelectionGroupContext, type SelectionEntry, type SelectionGroupContext } from "./context";
+
+/* The headless one-of-N (or N-of-M) group. It renders one element that carries the
+ * group role and the keyboard, and paints nothing: the container each item renders
+ * owns the plate, and the register (styles.css) owns the state. */
+export interface SelectionGroupProps {
+    type: SelectionMode;
+    orientation?: Orientation;
+    disabled?: boolean;
+    as?: string;
+    class?: HTMLAttributes["class"];
+}
+
+defineOptions({ name: "SelectionGroup" });
+const props = withDefaults(defineProps<SelectionGroupProps>(), { orientation: "horizontal", as: "div", disabled: false });
+const model = defineModel<SelectionValue | SelectionValue[]>();
+const containerRef = ref<HTMLElement | null>(null);
+const entries = shallowRef<SelectionEntry[]>([]);
+
+const ordered = computed(() =>
+    [...entries.value].sort((a, b) => {
+        if (!a.el || !b.el) return 0;
+        const rel = a.el.compareDocumentPosition(b.el);
+        return rel & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : rel & Node.DOCUMENT_POSITION_PRECEDING ? 1 : 0;
+    }),
+);
+const options = computed(() => ordered.value.map((e) => ({ value: e.value, disabled: e.disabled() })));
+const buttonRefs = computed(() => ordered.value.map((e) => e.el).filter((el): el is HTMLElement => !!el));
+
+const selection = useSelectionGroup<{ value: SelectionValue; disabled: boolean }>({
+    options,
+    model,
+    mode: computed(() => props.type),
+    vertical: computed(() => props.orientation === "vertical"),
+    activation: computed(() => (props.type === "single" ? "automatic" : "manual")),
+    containerRef,
+    buttonRefs,
+});
+
+const context: SelectionGroupContext = {
+    register(entry) { entries.value.push(entry); triggerRef(entries); },
+    unregister(entry) {
+        const at = entries.value.indexOf(entry);
+        if (at >= 0) entries.value.splice(at, 1);
+        triggerRef(entries);
+    },
+    isSelected: (v) => selection.isSelected(v),
+    stamp(entry) {
+        const on = selection.isSelected(entry.value);
+        const off = entry.disabled();
+        return {
+            ...selection.itemAttrs(entry.value),
+            tabindex: selection.rovingTabindex(ordered.value.indexOf(entry)),
+            "data-state": on ? "on" : "off",
+            "data-selection-item": "",
+            "data-disabled": off ? "" : undefined,
+            "aria-disabled": off ? "true" : undefined,
+        };
+    },
+    select: (entry) => selection.select(entry.value, ordered.value.indexOf(entry)),
+    disabled: computed(() => props.disabled),
+};
+provideSelectionGroupContext(context);
+</script>
+
+<template>
+    <component
+        :is="props.as"
+        ref="containerRef"
+        data-slot="selection-group"
+        data-selection-group
+        :class="props.class"
+        :role="selection.groupRole.value"
+        :data-type="props.type"
+        :data-orientation="props.orientation"
+        :aria-orientation="props.orientation"
+        @keydown="selection.onKeydown"
+    >
+        <slot />
+    </component>
+</template>
+
+<style src="./styles.css"></style>
diff --git a/src/components/selection/SelectionItem.vue b/src/components/selection/SelectionItem.vue
new file mode 100644
index 00000000..fa92703b
--- /dev/null
+++ b/src/components/selection/SelectionItem.vue
@@ -0,0 +1,61 @@
+<script setup lang="ts">
+import { computed, getCurrentInstance, onBeforeUnmount, onMounted, onUpdated, useAttrs, mergeProps, nextTick } from "vue";
+import { Slot } from "reka-ui";
+import type { SelectionValue } from "../_shared/selection";
+import { useOptionalSelectionGroupContext, type SelectionEntry } from "./context";
+import { refuseInteractiveDescendants, verifyStamp } from "./guard";
+
+/* Renders NO element of its own. The stamp reaches the consumer's
+ * element in one of two forms: the scoped slot (`v-slot="{ itemProps }"` +
+ * `v-bind="itemProps"` on the element) or `as-child` (merged onto the single child). */
+export interface SelectionItemProps {
+    value: SelectionValue;
+    disabled?: boolean;
+    asChild?: boolean;
+}
+defineOptions({ name: "SelectionItem", inheritAttrs: false });
+const props = defineProps<SelectionItemProps>();
+defineSlots<{ default?: (p: { itemProps: Record<string, unknown>; selected: boolean }) => unknown }>();
+
+const group = useOptionalSelectionGroupContext();
+if (!group) throw new Error("[SelectionItem] must render inside a <SelectionGroup>.");
+const entry: SelectionEntry = {
+    get value() { return props.value; },
+    disabled: () => props.disabled === true || group.disabled.value,
+    el: null,
+};
+const inst = getCurrentInstance()!;
+function bindEl() {
+    /* A scoped slot renders as a Fragment, so `$el` is its start anchor (an empty
+     * text node); the item's element is the first element after it. */
+    let el = inst.proxy?.$el as Node | null;
+    while (el && !(el instanceof HTMLElement) && el.nextSibling) el = el.nextSibling;
+    const next = el instanceof HTMLElement ? el : null;
+    if (import.meta.env.DEV && !next) console.error("[SelectionItem] the item must render exactly one element; got", el);
+    entry.el = next;
+}
+/* DEV: read the rendered element back against the stamp it was rendered with. */
+function check() {
+    if (!import.meta.env.DEV || !entry.el) return;
+    refuseInteractiveDescendants(entry.el);
+    verifyStamp(entry.el, group!.stamp(entry));
+}
+onMounted(() => { bindEl(); group.register(entry); nextTick(check); });
+onUpdated(() => { bindEl(); check(); });
+onBeforeUnmount(() => group.unregister(entry));
+
+const selected = computed(() => group.isSelected(props.value));
+/* The consumer's own attributes on <SelectionItem> travel with the stamp; the stamp
+ * is spread LAST, so nothing a consumer writes can un-stamp an option. */
+const attrs = useAttrs();
+const itemProps = computed(() =>
+    mergeProps(attrs, group.stamp(entry), {
+        onClick: () => { if (!entry.disabled()) group.select(entry); },
+    }),
+);
+</script>
+
+<template>
+    <Slot v-if="props.asChild" v-bind="itemProps"><slot :item-props="itemProps" :selected="selected" /></Slot>
+    <slot v-else :item-props="itemProps" :selected="selected" />
+</template>
diff --git a/src/components/selection/context.ts b/src/components/selection/context.ts
new file mode 100644
index 00000000..87271af3
--- /dev/null
+++ b/src/components/selection/context.ts
@@ -0,0 +1,27 @@
+import type { ComputedRef } from "vue";
+import { createOptionalContext } from "../../composables/context";
+import type { SelectionValue } from "../_shared/selection";
+
+/* The item registry the selection engine needs: options and element refs,
+ * index-aligned, in DOM order. Every SelectionItem publishes itself here on mount
+ * and withdraws on unmount; the group sorts by document position, never by
+ * registration order (onMounted fires child-first). */
+export interface SelectionEntry {
+    readonly value: SelectionValue;
+    readonly disabled: () => boolean;
+    el: HTMLElement | null;
+}
+
+export interface SelectionGroupContext {
+    register: (entry: SelectionEntry) => void;
+    unregister: (entry: SelectionEntry) => void;
+    isSelected: (value: SelectionValue) => boolean;
+    /** The whole stamp: role-per-mode ARIA, roving tabindex, data-state, the marker. */
+    stamp: (entry: SelectionEntry) => Record<string, string | number | undefined>;
+    select: (entry: SelectionEntry) => void;
+    disabled: ComputedRef<boolean>;
+}
+
+const ctx = createOptionalContext<SelectionGroupContext>("glass-ui:selection-group");
+export const provideSelectionGroupContext = ctx.provide;
+export const useOptionalSelectionGroupContext = ctx.use;
diff --git a/src/components/selection/guard.ts b/src/components/selection/guard.ts
new file mode 100644
index 00000000..7b8543b3
--- /dev/null
+++ b/src/components/selection/guard.ts
@@ -0,0 +1,28 @@
+/* the content-model refusal (DEV). A radio's children are
+ * presentational (ARIA 1.2), so an option that holds a control is two controls
+ * pretending to be one. Fail loud, name the element. */
+const INTERACTIVE =
+    'a[href],button,input,select,textarea,summary,[contenteditable]:not([contenteditable="false"]),[tabindex]:not([tabindex="-1"]),[role="button"],[role="link"],[role="checkbox"],[role="switch"]';
+export function refuseInteractiveDescendants(el: HTMLElement): void {
+    const hit = el.querySelector(INTERACTIVE);
+    if (hit) {
+        const msg = `[SelectionItem] an option cannot hold interactive content (ARIA: a radio's children are presentational). Found <${hit.tagName.toLowerCase()}> inside the item. Split the action out of the option.`;
+        console.error(msg, hit);
+        throw new Error(msg);
+    }
+}
+
+/* the E-11 readback (DEV). The stamp travels through props, and a
+ * component that binds the same key after `$attrs`, filters it, or a consumer
+ * binding written after `v-bind="itemProps"` drops it without a sound. Read the
+ * DOM back and name every key that did not land. */
+export function verifyStamp(el: HTMLElement, stamp: Record<string, string | number | undefined>): void {
+    const lost = Object.entries(stamp)
+        .filter(([k, v]) => (v === undefined ? el.hasAttribute(k) : el.getAttribute(k) !== String(v)))
+        .map(([k, v]) => `${k}=${JSON.stringify(v)} (found ${JSON.stringify(el.getAttribute(k))})`);
+    if (lost.length) {
+        const msg = `[SelectionItem] the option's stamp did not land on <${el.tagName.toLowerCase()}>: ${lost.join(", ")}. A component or binding between the item and its element is overriding or filtering it.`;
+        console.error(msg, el);
+        throw new Error(msg);
+    }
+}
