+/* The selection behaviour: one engine, one stamp, any container. jsdom reads the
+ * stamp, the roles and the model; paint, geometry and the grid walk are browser
+ * facts and are read by the tile battery, not here. */
+import { mount } from "@vue/test-utils";
+import { defineComponent, nextTick, ref } from "vue";
+import { describe, expect, it } from "vitest";
+import { SelectionGroup, SelectionItem } from "@glass/components/selection";
+import { Card } from "@glass/components/card";
+import { Chip } from "@glass/components/chip";
+import { refuseInteractiveDescendants, verifyStamp } from "@glass/components/selection/guard";
+
+function board(type: "single" | "multiple", start: string | string[], host: "div" | "card" | "chip") {
+    const inner = {
+        div: `<div v-bind="itemProps" data-t>{{ v }}</div>`,
+        card: `<Card size="sm" v-bind="itemProps" data-t>{{ v }}</Card>`,
+        chip: `<Chip v-bind="itemProps" data-t>{{ v }}</Chip>`,
+    }[host];
+    return mount(
+        defineComponent({
+            components: { SelectionGroup, SelectionItem, Card, Chip },
+            setup: () => ({ model: ref(start), values: ["a", "b", "c"] }),
+            template: `
