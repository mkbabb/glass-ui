+
+describe("SelectionGroup / SelectionItem", () => {
+    for (const host of ["div", "card", "chip"] as const) {
+        it(`stamps one-of-N onto a ${host}: radiogroup, radio, aria-checked, one tab stop`, async () => {
+            const w = board("single", "b", host);
+            await nextTick();
+            await nextTick();
+            expect(w.get('[data-slot="selection-group"]').attributes("role")).toBe("radiogroup");
