new file mode 100644
index 00000000..1be66c17
--- /dev/null
+++ b/src/components/selection/styles.css
@@ -0,0 +1,121 @@
+/* THE SELECTION REGISTER. One state register, keyed on the group's
+   stamp, composed onto whatever plate the consumer rendered (Card, Surface, Chip,
+   the ToggleGroup pill). Selection spends the plate's FILL layer and its EDGE;
+   the ring keeps `outline`, the rim keeps `box-shadow`. */
+/* `--selection-fill` is registered globally (tokens/property-regs.css): the plate arms
+   read it on every control, option or not. */
+@layer components {
+    /* ZERO-SPECIFICITY DEFAULTS, for an item whose container brings no plate, corner
+       or edge of its own (a bare element: the FLUSH option). Every plate recipe wins
+       over these: Card, Surface, the control chassis and the Chip each list the state
+       layer in their own image list (the ARMS: glass/veil.css, glass/defined.css,
+       glass/glass-chip.css), because a register that wrote background-image at a
+       real specificity would erase whichever plate it outranked. */
+    :where([data-selection-item]) {
+        border-radius: var(--radius-ctx);
+        background-image: linear-gradient(var(--selection-fill), var(--selection-fill));
+        border-width: 1px;
+        border-style: solid;
+        border-color: oklch(from var(--foreground) l c h / var(--ink-seam));
+    }
+
+    [data-selection-item] {
+        /* the tone a consumer may set per item (X-7); ink by default */
+        --selection-tone: var(--foreground);
+        /* Q2: a Surface item has only the relay corner; the option publishes the
+           field rung as its context, so it paints 16 wherever it sits. */
+        --radius-ctx: var(--radius-field);
+        cursor: pointer;
+        touch-action: manipulation;
+        -webkit-tap-highlight-color: transparent;
+        /* `transition` is a shorthand and this rule outranks the host's own list, so
+           it restates the UNION of what every host plate animates (the pill's
+           background, shadow, ink and gleam; the card's cast; the chip's colours).
+           Listing only the register's own channels would make them snap. */
+        transition:
+            --selection-fill var(--engage-control-engage-release) var(--ease-standard),
+            border-color var(--engage-control-engage-release) var(--ease-standard),
+            background-color var(--engage-control-engage-release) var(--ease-standard),
+            box-shadow var(--engage-control-engage-release) var(--ease-standard),
+            color var(--engage-control-engage-release) var(--ease-standard),
+            opacity var(--engage-control-engage-release) var(--ease-standard),
+            --specular-intensity var(--duration-fast) var(--ease-standard),
+            scale var(--spring-press-duration) var(--transition-liquid-spatial);
+    }
+
+    [data-selection-item][data-state="on"] {
+        --selection-fill: oklch(from var(--selection-tone) l c h / var(--fill-selected));
+        /* THE TONE ITSELF, not --ink-perimeter: 0.48 separates 3:1 from the plate but
+           not from the unselected sibling's own edge (measured 0 px² at ≥3:1 in light) */
+        border-color: var(--selection-tone);
+    }
+
+    /* THE COMMIT (D-2): the option that just became the choice settles on the press
+       spring, a pop past rest and back. Keyed on :focus so a page that loads with a
+       choice made does not pop it; a click and an arrow both focus the new option. */
+    [data-selection-item][data-state="on"]:focus {
+        animation: selection-commit var(--spring-press-duration) var(--transition-liquid-spatial);
+    }
+
+    [data-selection-item]:focus-visible {
+        outline: 2px solid oklch(from var(--foreground) l c h / var(--ink-perimeter));
+        outline-offset: 2px;
+    }
+
+    @media (hover: hover) {
+        [data-selection-item]:hover:not([data-disabled]) {
+            --selection-fill: oklch(from var(--selection-tone) l c h / var(--fill-hover));
+            scale: 1.015;
+        }
+
+        /* the hover's light channel on the EDGE too: seam → the floating boundary
+           rung. The 0.05 fill alone moves no pixel past 10 levels on an opaque tile. */
+        [data-selection-item][data-state="off"]:hover:not([data-disabled]) {
+            border-color: oklch(from var(--selection-tone) l c h / var(--ink-edge));
+        }
+
+        [data-selection-item][data-state="on"]:hover:not([data-disabled]) {
+            --selection-fill: oklch(
+                from var(--selection-tone) l c h / calc(var(--fill-hover) + var(--fill-selected))
+            );
+        }
+    }
+
+    [data-selection-item]:active:not([data-disabled]) {
+        scale: var(--scale-press-sm);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        [data-selection-item]:hover,
+        [data-selection-item]:active {
+            scale: 1;
+        }
+
+        [data-selection-item][data-state="on"]:focus {
+            animation: none;
+        }
+    }
+
+    [data-selection-item][data-disabled] {
+        cursor: not-allowed;
+        opacity: var(--opacity-disabled);
+    }
+
+    @media (forced-colors: active) {
+        [data-selection-item] {
+            border: 1px solid ButtonText;
+        }
+
+        [data-selection-item][data-state="on"] {
+            border-color: Highlight;
+            background: Highlight;
+            color: HighlightText;
+        }
+    }
+
+    @keyframes selection-commit {
+        45% {
+            scale: 1.025;
+        }
+    }
+}
