+        const Nothing = defineComponent({ render: () => null });
+        expect(rows(`<template #media><svg /></template><template #meta><span>0.5 s</span></template>`)).toEqual([
+            "toggle-group__media",
+            "toggle-group__meta",
+        ]);
+        // a false v-if (a comment), a v-for over nothing (an empty fragment), blank text: unfilled
+        expect(rows(`<template #meta><span v-if="hint">{{ hint }}</span></template>`, { hint: "" })).toEqual([]);
