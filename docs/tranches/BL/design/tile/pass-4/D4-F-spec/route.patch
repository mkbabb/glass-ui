+        const withChild = defineComponent({
+            components: { ToggleGroup, ToggleGroupItem, Nothing },
+            template: `<ToggleGroup type="single" model-value="a"><ToggleGroupItem value="a">A<template #meta><Nothing /></template></ToggleGroupItem></ToggleGroup>`,
+        });
+        const w = mount(withChild);
