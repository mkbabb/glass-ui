+
+    it("the commit stamp is keyed on the model: mount stamps nothing, a change stamps once", async () => {
+        const model = ref("a");
+        const Host = defineComponent({
+            components: { ToggleGroup, ToggleGroupItem },
+            setup: () => ({ model }),
+            template: `
+                <ToggleGroup type="single" v-model="model">
+                    <ToggleGroupItem value="a">A</ToggleGroupItem>
+                    <ToggleGroupItem value="b">B</ToggleGroupItem>
+                </ToggleGroup>`,
+        });
+        const wrapper = mount(Host, { attachTo: document.body });
+        await nextTick();
+        const [a, b] = wrapper.findAll("button");
+        expect(wrapper.findAll("[data-commit]")).toHaveLength(0); // the selected item merely appeared
+        a!.element.focus(); // focus entering a made choice commits nothing
+        await nextTick();
+        expect(wrapper.findAll("[data-commit]")).toHaveLength(0);
+        model.value = "b"; // a programmatic write is a commit
+        await nextTick();
+        expect(b!.attributes("data-commit")).toBe("");
+        expect(a!.attributes("data-commit")).toBeUndefined();
+        // another animation ending on the button does not clear the kick early
+        b!.element.dispatchEvent(Object.assign(new Event("animationend"), { animationName: "other" }));
+        await nextTick();
+        expect(b!.attributes("data-commit")).toBe("");
+        b!.element.dispatchEvent(
+            Object.assign(new Event("animationend"), { animationName: "toggle-group-commit" }),
+        );
+        await nextTick();
+        expect(b!.attributes("data-commit")).toBeUndefined();
+        model.value = "a"; // back, then forth: each commit stamps again
+        await nextTick();
+        model.value = "b";
+        await nextTick();
+        expect(b!.attributes("data-commit")).toBe("");
         wrapper.unmount();
     });
+
+    it("the sheet: one tile reading, a one-row pill lock, and the kick on the stamp", async () => {
+        const postcss = (await import("postcss")).default;
+        const root = postcss.parse(read(LANE_SHEET));
+        const ANATOMY = ".toggle-group__media, .toggle-group__meta";
+        const rules = new Map<string, Record<string, string>>();
+        root.walkRules((r) => {
+            const decls: Record<string, string> = {};
+            r.walkDecls((d) => {
+                if (d.parent === r) decls[d.prop] = d.value + (d.important ? " !important" : "");
+            });
+            for (const sel of r.selectors) {
+                const key = sel.replace(/\s+/g, " ").trim();
+                if (!rules.has(key)) rules.set(key, decls); // the first: the forced-colours arm restates
+            }
+        });
+        const tile = rules.get(`.toggle-group:has(${ANATOMY}) .toggle-group__item`);
+        expect(rules.get(`.toggle-group__item:has(> .toggle-group__media, > .toggle-group__meta)`)).toBe(tile);
+        expect(tile).toMatchObject({
+            "--selection-perimeter": "1",
+            "border-radius": "var(--radius-field)",
+            "flex-direction": "column",
+            "max-block-size": "none",
+        });
+        const pill = rules.get(".toggle-group__item");
+        expect(pill?.["border-radius"]).toBe("var(--radius-pill)");
+        expect(pill?.["max-block-size"]).toBe("var(--toggle-group-item-size)");
+        const lock = [...rules.entries()].find(([sel]) => sel.startsWith(".toggle-group__item:not("));
+        expect(lock?.[0]).toContain(`.toggle-group:has(${ANATOMY}) *`);
+        expect(lock?.[1]).toMatchObject({
+            "flex-direction": "row !important",
+            "flex-wrap": "nowrap !important",
+        });
+        expect(rules.get(".toggle-group__item[data-commit]")?.animation).toMatch(/^toggle-group-commit /);
+    });
