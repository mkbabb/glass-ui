+        expect(a!.find(".toggle-group__media [data-x='glyph']").exists()).toBe(true);
+        expect(a!.get(".toggle-group__meta [data-x='readout']").text()).toBe("0.5 s");
+        expect(b!.find(".toggle-group__media, .toggle-group__meta").exists()).toBe(false);
+        // one item, two content models: the same element, classes and ARIA
+        expect(a!.attributes("class")).toBe(b!.attributes("class"));
+        expect(a!.attributes("role")).toBe(b!.attributes("role"));
+        wrapper.unmount();
