diff --git a/tests/components/custom/tabs/roving-grid.test.ts b/tests/components/custom/tabs/roving-grid.test.ts
new file mode 100644
index 00000000..5ac2c119
--- /dev/null
+++ b/tests/components/custom/tabs/roving-grid.test.ts
@@ -0,0 +1,127 @@
+/* The radio-group arrow model (`arrows: "grid"`) on stubbed rects.
+ *
+ * The walk reads layout at key time, so each case lays its items out by stubbing
+ * `getBoundingClientRect` and presses real keys on the strip handler. Every arrow
+ * moves: Left and Right step in order (flipped under RTL), Up and Down go to the
+ * nearest enabled item in the adjacent row, nearest centre first, and step in order
+ * where no row lies that way. The `axis` model keeps its inert cross pair. A key typed
+ * into an editable descendant stays the descendant's.
+ */
+import { computed, ref } from "vue";
+import { describe, expect, it } from "vitest";
+import {
+    useTabRovingFocus,
+    type RovingArrows,
+} from "@glass/components/tabs/composables/useTabRovingFocus";
+
+type Box = [x: number, y: number, w?: number, h?: number];
+
+function strip(boxes: Box[], opts: { arrows?: RovingArrows; disabled?: number[]; rtl?: boolean } = {}) {
+    const host = document.createElement("div");
+    if (opts.rtl) host.setAttribute("dir", "rtl");
+    document.body.append(host);
+    const els = boxes.map(([x, y, w = 80, h = 40], i) => {
+        const b = document.createElement("button");
+        b.textContent = String(i);
+        b.getBoundingClientRect = () =>
+            ({ x, y, left: x, top: y, width: w, height: h, right: x + w, bottom: y + h, toJSON() {} }) as DOMRect;
+        host.append(b);
+        return b;
+    });
+    const options = computed(() =>
+        boxes.map((_, i) => ({ value: String(i), disabled: opts.disabled?.includes(i) ?? false })),
+    );
+    const model = ref<string | undefined>("0");
+    const roving = useTabRovingFocus({
+        stripOptions: options,
+        stripValue: computed(() => model.value),
+        isVertical: computed(() => false),
+        activation: computed(() => "automatic" as const),
+        buttonRefs: ref(els),
+        select: (v) => {
+            model.value = v;
+        },
+        arrows: computed(() => opts.arrows ?? "grid"),
+    });
+    const press = (from: number, key: string, target: HTMLElement = els[from]!) => {
+        model.value = String(from);
+        const e = new KeyboardEvent("keydown", { key, bubbles: true, cancelable: true });
+        Object.defineProperty(e, "currentTarget", { value: host });
+        Object.defineProperty(e, "target", { value: target });
+        roving.onStripKeydown(e);
+        return Number(model.value);
+    };
+    return { press, els, host };
+}
+
+// A 2×2 grid: 0 1 / 2 3.
+const GRID: Box[] = [[0, 0], [100, 0], [0, 50], [100, 50]];
+
+describe("the grid arrow model", () => {
+    it("Left and Right step in order, wrapping", () => {
+        const s = strip(GRID);
+        expect(s.press(0, "ArrowRight")).toBe(1);
+        expect(s.press(1, "ArrowRight")).toBe(2);
+        expect(s.press(0, "ArrowLeft")).toBe(3);
+    });
+
+    it("Up and Down go to the item in the adjacent row under the same centre", () => {
+        const s = strip(GRID);
+        expect(s.press(0, "ArrowDown")).toBe(2);
+        expect(s.press(1, "ArrowDown")).toBe(3);
+        expect(s.press(3, "ArrowUp")).toBe(1);
+        expect(s.press(2, "ArrowUp")).toBe(0);
+    });
+
+    it("where no row lies that way, Up and Down step in order", () => {
+        const s = strip(GRID);
+        expect(s.press(3, "ArrowDown")).toBe(0);
+        expect(s.press(0, "ArrowUp")).toBe(3);
+        // one line: the cross pair steps, it is never inert
+        const line = strip([[0, 0], [100, 0], [200, 0]]);
+        expect(line.press(0, "ArrowDown")).toBe(1);
+        expect(line.press(0, "ArrowUp")).toBe(2);
+    });
+
+    it("the nearest centre wins among the next row, and the nearest row wins over a farther one", () => {
+        // three across, then two offset under them, then one far below
+        const s = strip([[0, 0], [100, 0], [200, 0], [40, 50], [160, 50], [100, 200]]);
+        expect(s.press(0, "ArrowDown")).toBe(3);
+        expect(s.press(2, "ArrowDown")).toBe(4);
+        expect(s.press(1, "ArrowDown")).toBe(3); // a tie at 60 px each keeps the first found
+        expect(s.press(4, "ArrowDown")).toBe(5);
+    });
+
+    it("items of unequal height in one row stay one row", () => {
+        const s = strip([[0, 0, 80, 40], [100, 0, 80, 90], [0, 100, 80, 40]]);
+        expect(s.press(0, "ArrowDown")).toBe(2);
+        expect(s.press(1, "ArrowDown")).toBe(2);
+    });
+
+    it("a disabled item is skipped by the row walk and by the step", () => {
+        const s = strip(GRID, { disabled: [2] });
+        expect(s.press(0, "ArrowDown")).toBe(3);
+        expect(s.press(1, "ArrowRight")).toBe(3);
+    });
+
+    it("RTL flips Left and Right, not Up and Down", () => {
+        const s = strip(GRID, { rtl: true });
+        expect(s.press(1, "ArrowRight")).toBe(0);
+        expect(s.press(0, "ArrowLeft")).toBe(1);
+        expect(s.press(0, "ArrowDown")).toBe(2);
+    });
+
+    it("the axis model keeps the cross pair inert", () => {
+        const s = strip(GRID, { arrows: "axis" });
+        expect(s.press(0, "ArrowDown")).toBe(0);
+        expect(s.press(0, "ArrowRight")).toBe(1);
+    });
+
+    it("an arrow typed into an editable descendant stays the descendant's", () => {
+        const s = strip(GRID);
+        const input = document.createElement("input");
+        s.els[0]!.append(input);
+        expect(s.press(0, "ArrowRight", input)).toBe(0);
+        expect(s.press(0, "ArrowDown", input)).toBe(0);
+    });
+});
