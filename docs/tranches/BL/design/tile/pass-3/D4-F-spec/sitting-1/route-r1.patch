+                default: `
+                    <ToggleGroupItem value="a" role="option" tabindex="0" data-x="a" title="A">A</ToggleGroupItem>
+                    <ToggleGroupItem value="b" role="option" tabindex="0">B</ToggleGroupItem>`,
+            },
+            global: { components: { ToggleGroupItem } },
+            attachTo: document.body,
+        });
+        await nextTick(); // the items register on mount; the roving stop follows
+        const [a, b] = wrapper.findAll("button");
+        expect([a!.attributes("role"), b!.attributes("role")]).toEqual(["radio", "radio"]);
+        expect([a!.attributes("tabindex"), b!.attributes("tabindex")]).toEqual(["-1", "0"]);
+        // the rest of the consumer's attributes still land on the button
+        expect(a!.attributes("data-x")).toBe("a");
+        expect(a!.attributes("title")).toBe("A");
+        wrapper.unmount();
+    });
