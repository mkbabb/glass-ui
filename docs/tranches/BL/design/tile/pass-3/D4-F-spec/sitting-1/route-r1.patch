+        root.walkRules((r) => {
+            const parent = r.parent as { type: string; selector?: string } | undefined;
+            if (parent?.type === "rule") return; // nested: it inherits the parent's spelling
+            if (r.selectors.some((s) => s.includes(":has(") && ANATOMY.test(s))) reading.push(r.selector);
+        });
+        expect(reading).toEqual([
+            ".toggle-group:has(.toggle-group__item > :is(.toggle-group__media, .toggle-group__meta))",
+        ]);
+        let tile: CssRule | undefined;
