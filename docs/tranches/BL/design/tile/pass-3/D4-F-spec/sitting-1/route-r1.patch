+    it("#media and #meta render in library-marked rows only when filled", () => {
+        const wrapper = mount(ToggleGroup, {
+            props: { type: "single", modelValue: "a" },
+            slots: {
+                default: `
+                    <ToggleGroupItem value="a">
+                        <template #media><svg data-x="glyph" /></template>
+                        A
+                        <template #meta><span data-x="readout">0.5 s</span></template>
+                    </ToggleGroupItem>
+                    <ToggleGroupItem value="b">B</ToggleGroupItem>`,
+            },
+            global: { components: { ToggleGroupItem } },
+        });
+        const [a, b] = wrapper.findAll("button");
+        expect([...a!.element.children].map((c) => c.className)).toEqual([
+            "toggle-group__media",
+            "toggle-group__meta",
+        ]);
+        expect(a!.find(".toggle-group__media [data-x='glyph']").exists()).toBe(true);
+        expect(a!.get(".toggle-group__meta [data-x='readout']").text()).toBe("0.5 s");
