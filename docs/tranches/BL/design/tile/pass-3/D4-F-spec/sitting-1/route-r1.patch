+            "flex-direction": "column",
+        });
+        // no other rule in the sheet writes the field corner
+        const field: string[] = [];
+        root.walkDecls("border-radius", (d) => {
+            if (d.value === "var(--radius-field)") field.push((d.parent as CssRule).selector);
+        });
+        expect(field).toEqual(["& .toggle-group__item"]);
+    });
