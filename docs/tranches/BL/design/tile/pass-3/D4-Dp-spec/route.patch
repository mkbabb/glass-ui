+import { mount } from "@vue/test-utils";
+import { defineComponent, nextTick, ref } from "vue";
+import { expect, it } from "vitest";
+import { ToggleGroup, ToggleGroupItem } from "@glass/components/toggle-group";
+
+/* Its own file: in ToggleGroup.test.ts this mount, run before the floor's late
+ * development-name case, left that case's MutationObserver silent in happy-dom 7 runs
+ * of 10 (pass-3/D4-Dp-spec/logs/wt-devname-flake.log). The names are measured in both
+ * engines by the harness (pass-3/D4-Dp-spec.md). */
+/* H3-12 · a consumer role or tabindex on an item no longer replaces the engine's:
+ * the radio group keeps `radio`, its checked state and one tab stop. */
+it("the engine's role, state and tab stop stand over a consumer's", async () => {
+    const wrapper = mount(
+        defineComponent({
+            components: { ToggleGroup, ToggleGroupItem },
+            setup: () => ({ model: ref("b") }),
+            template: `<ToggleGroup type="single" v-model="model">
+                <ToggleGroupItem v-for="v in ['a','b','c']" :key="v" :value="v" role="option" tabindex="0" aria-checked="false" data-x="kept">{{ v }}</ToggleGroupItem>
+            </ToggleGroup>`,
+        }),
+        { attachTo: document.body },
+    );
+    await nextTick();
+    const items = wrapper.findAll("button");
+    expect(items.map((b) => b.attributes("role"))).toEqual(["radio", "radio", "radio"]);
+    expect(items.map((b) => b.attributes("aria-checked"))).toEqual(["false", "true", "false"]);
+    expect(items.map((b) => b.attributes("tabindex"))).toEqual(["-1", "0", "-1"]);
+    expect(items[0].attributes("data-x")).toBe("kept");
+    wrapper.unmount();
+});
