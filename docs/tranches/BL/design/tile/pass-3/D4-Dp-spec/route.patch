+/* THE OPTION SHAPE, declared once at the group. `pill` (the default) is a one-row
+ * option: a stadium at the control rung that lays its content out on one row. `cell`
+ * is a tile, an option that holds more than one row: the field corner, a column, the
+ * card pad pair and body leading. The declaration is the one fact; styles.css turns it
+ * into `--selection-tile`, which every other reader derives from. */
+export const TOGGLE_GROUP_SHAPES = ["pill", "cell"] as const;
+export type ToggleGroupShape = (typeof TOGGLE_GROUP_SHAPES)[number];
