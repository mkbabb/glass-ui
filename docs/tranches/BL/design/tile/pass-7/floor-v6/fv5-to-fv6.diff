diff --git a/tests/components/ui/toggle-group/ToggleGroup.test.ts b/tests/components/ui/toggle-group/ToggleGroup.test.ts
index 15951ab07..a694c9799 100644
--- a/tests/components/ui/toggle-group/ToggleGroup.test.ts
+++ b/tests/components/ui/toggle-group/ToggleGroup.test.ts
@@ -624,3 +624,57 @@ describe("floor v2 — the commit, the names and the tile fact", () => {
         expect(peak).toContain("max(var(--motion-weight), 0.618)");
     });
 });
+
+/* R-10 · "IS A TILE" IS WRITTEN IN ONE SHEET, BY ONE RULE (B-1). The units above read the
+ * lane sheet, so a second writer of the tile fact in another sheet (`.card > .toggle-group
+ * { --selection-tile: flush }` in base.css) passed every one of them. This case reads all
+ * of `src`: every stylesheet, every `.vue` `<style>` block, and every other spelling of a
+ * write in `.vue` and `.ts` source (a style binding, a `setProperty`, a utility). A tile
+ * value is written in the lane sheet only, by one rule at most: the route's, which the
+ * route's own unit names. */
+describe("floor v6 — one writer of the tile fact, sheet-wide", () => {
+    it("every --selection-tile: flush | plated in src is the lane sheet's one rule", async () => {
+        const postcss = (await import("postcss")).default;
+        const { readdirSync } = await import("node:fs");
+        const files = (dir: string): string[] =>
+            readdirSync(resolve(ROOT, dir), { withFileTypes: true }).flatMap((d) =>
+                d.isDirectory() ? files(`${dir}/${d.name}`) : /\.(css|vue|ts)$/.test(d.name) ? [`${dir}/${d.name}`] : [],
+            );
+        const TILE = /^(flush|plated)$/;
+        const writers: string[] = [];
+        for (const file of files("src")) {
+            const text = read(file);
+            if (!text.includes("--selection-tile")) continue;
+            const styles = file.endsWith(".css")
+                ? [text]
+                : [...text.matchAll(/<style\b[^>]*>([^]*?)<\/style>/g)].map((m) => m[1]);
+            for (const css of styles)
+                postcss.parse(css).walkDecls("--selection-tile", (d) => {
+                    if (TILE.test(d.value.replace(/!important/, "").trim()))
+                        writers.push(`${file} ${(d.parent as { selector?: string }).selector?.replace(/\s+/g, " ")}`);
+                });
+            const code = file.endsWith(".css") ? "" : text.replace(/<style\b[^>]*>[^]*?<\/style>/g, "");
+            for (const m of code.matchAll(
+                /["'`]?--selection-tile["'`]?\s*[:,]\s*["'`]\s*(flush|plated)\b|\[--selection-tile:\s*(flush|plated)\]/g,
+            ))
+                writers.push(`${file} «${m[0]}»`);
+        }
+        expect(writers.filter((w) => !w.startsWith(`${LANE_SHEET} `))).toEqual([]);
+        expect(writers.length).toBeLessThanOrEqual(1);
+    });
+
+    /* B-3 · a control inside a tile option (a Select, a switch, a responsive strip's
+     * trigger) inherits the option's fact and carries `[data-state]` too. The flush plate
+     * rule names the option itself, so that control keeps its own plate. */
+    it("the flush plate rule names the option, not every control inside it", async () => {
+        const postcss = (await import("postcss")).default;
+        const flush: string[] = [];
+        postcss.parse(read("src/styles/glass/control-surfaces.css")).walkAtRules("container", (q) => {
+            if (/style\(--selection-tile:\s*flush\)/.test(q.params))
+                q.walkRules((r) => {
+                    flush.push(r.selector.replace(/\s+/g, " "));
+                });
+        });
+        expect(flush).toEqual([".control-surface[data-state]:where(.toggle-group__item)"]);
+    });
+});
