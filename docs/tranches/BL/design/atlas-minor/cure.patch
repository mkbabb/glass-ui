+describe("DataTable fit", () => {
+    // The ruler's own entry carries the viewport's inline size, each column's span its
+    // width; the root reads wide, so the table projection stands.
+    function fitObserver(room: { value: number }, widths: Record<string, number>) {
+        const observers: { cb: ResizeObserverCallback; targets: Element[] }[] = [];
+        class FitResizeObserver {
+            private readonly record: { cb: ResizeObserverCallback; targets: Element[] };
+            constructor(cb: ResizeObserverCallback) {
+                this.record = { cb, targets: [] };
+                observers.push(this.record);
+            }
+            observe(target: Element) {
+                this.record.targets.push(target);
+            }
+            unobserve() {}
+            disconnect() {
+                this.record.targets = [];
+            }
+        }
+        const sizeOf = (target: Element): number => {
+            const el = target as HTMLElement;
+            if (el.dataset.column !== undefined) return widths[el.dataset.column] ?? 0;
+            if (el.classList.contains("data-table-ruler")) return room.value;
+            return 1200;
+        };
+        const deliver = () => {
+            for (const { cb, targets } of observers) {
+                if (targets.length === 0) continue;
+                cb(
+                    targets.map((target) => {
+                        const size = sizeOf(target);
+                        const box = [{ inlineSize: size, blockSize: 0 }];
+                        return {
+                            target,
+                            contentRect: { width: size, height: 0 },
+                            borderBoxSize: box,
+                            contentBoxSize: box,
+                        } as unknown as ResizeObserverEntry;
+                    }),
+                    {} as ResizeObserver,
+                );
+            }
+        };
+        vi.stubGlobal("ResizeObserver", FitResizeObserver);
+        return deliver;
+    }
+
+    const fitColumns: DataTableColumn[] = ["a", "b", "c", "d"].map((key) => ({
+        key,
+        label: key.toUpperCase(),
+        width: "200px",
+    }));
+
+    it("shows the leading columns that fit the viewport and reports the rest", async () => {
+        const room = { value: 640 };
+        const deliver = fitObserver(room, { a: 200, b: 200, c: 200, d: 200 });
+        const wrapper = mountTable([{ _id: "1", name: "Ada" }], {
+            columns: fitColumns,
+            fit: true,
+        });
+        await nextTick();
+        expect(wrapper.attributes("data-fit")).toBe("");
+        expect(wrapper.findAll(".data-table-ruler [data-column]")).toHaveLength(4);
+
+        deliver();
+        await nextTick();
+        expect(wrapper.findAll("thead th").map((th) => th.text())).toEqual(["A", "B", "C"]);
+        expect(
+            (wrapper.emitted("fold")?.at(-1)?.[0] as DataTableColumn[]).map((col) => col.key),
+        ).toEqual(["d"]);
+
+        // A narrower viewport keeps the first column however little room there is.
+        room.value = 150;
+        deliver();
+        await nextTick();
+        expect(wrapper.findAll("thead th").map((th) => th.text())).toEqual(["A"]);
+        expect(
+            (wrapper.emitted("fold")?.at(-1)?.[0] as DataTableColumn[]).map((col) => col.key),
+        ).toEqual(["b", "c", "d"]);
+
+        // The ruler still measures the folded columns, so a wider viewport brings them back.
+        expect(wrapper.findAll(".data-table-ruler [data-column]")).toHaveLength(4);
+        room.value = 900;
+        deliver();
+        await nextTick();
+        expect(wrapper.findAll("thead th")).toHaveLength(4);
+        expect(wrapper.emitted("fold")?.at(-1)?.[0]).toEqual([]);
+        wrapper.unmount();
+    });
+
+    it("measures nothing and folds nothing without fit", async () => {
+        const deliver = fitObserver({ value: 100 }, { a: 200, b: 200, c: 200, d: 200 });
+        const wrapper = mountTable([{ _id: "1", name: "Ada" }], { columns: fitColumns });
+        deliver();
+        await nextTick();
+        expect(wrapper.find(".data-table-ruler").exists()).toBe(false);
+        expect(wrapper.findAll("thead th")).toHaveLength(4);
+        expect(wrapper.emitted("fold")).toBeUndefined();
+        wrapper.unmount();
+    });
+});
