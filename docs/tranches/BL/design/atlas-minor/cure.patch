@@ -0,0 +1,113 @@
+// Which leading columns fit the table's viewport, measured off a hidden ruler.
+import {
+    computed,
+    onScopeDispose,
+    shallowRef,
+    toValue,
+    watch,
+    type ComputedRef,
+    type MaybeRefOrGetter,
+    type Ref,
+} from "vue";
+import type { DataTableColumn } from "../types";
+
+export interface UseDataTableFitOptions<T> {
+    /** Whether the table folds the columns that do not fit. */
+    enabled: MaybeRefOrGetter<boolean>;
+    /** Every column, in order, shown or folded. */
+    columns: MaybeRefOrGetter<DataTableColumn<T>[]>;
+    /**
+     * The ruler: out of flow inside the viewport, so its own inline size is the
+     * viewport's. Each child with `data-column` carries one column's width; a child with
+     * `data-actions` carries the row-actions column.
+     */
+    ruler: Readonly<Ref<HTMLElement | null>>;
+}
+
+export interface UseDataTableFitReturn<T> {
+    /** The leading columns that fit, the first always among them. */
+    shown: ComputedRef<DataTableColumn<T>[]>;
+    /** The columns after them. */
+    folded: ComputedRef<DataTableColumn<T>[]>;
+}
+
+const inlineSize = (entry: ResizeObserverEntry, box: "border" | "content"): number =>
+    (box === "border" ? entry.borderBoxSize : entry.contentBoxSize)?.[0]?.inlineSize ??
+    entry.contentRect.width;
+
+/**
+ * The ruler measures every column whether or not the table shows it, so hiding a column
+ * never changes the measure that hid it. The observer takes sizes from its entries only,
+ * and the fold resizes nothing it observes: the ruler is out of flow and as wide as the
+ * viewport, whose inline size the fold leaves alone.
+ */
+export function useDataTableFit<T>(
+    options: UseDataTableFitOptions<T>,
+): UseDataTableFitReturn<T> {
+    const room = shallowRef(0);
+    const actions = shallowRef(0);
+    const widths = shallowRef<ReadonlyMap<string, number>>(new Map());
