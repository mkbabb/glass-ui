+    it("advances by at most one 60 Hz frame across a long frame", async () => {
+        // A frame clock the test runs by hand: each `frame(at)` fires the callbacks queued
+        // since the last one at that timestamp.
+        let queue: FrameRequestCallback[] = [];
+        const request = (cb: FrameRequestCallback): number => queue.push(cb);
+        vi.stubGlobal("requestAnimationFrame", request);
+        Object.defineProperty(window, "requestAnimationFrame", {
+            configurable: true,
+            writable: true,
+            value: request,
+        });
+        const frame = (at: number) => {
+            const run = queue;
+            queue = [];
+            for (const cb of run) cb(at);
+        };
+        const after = async (gaps: number[]) => {
+            const target = ref(0);
+            const spring = useSpring(target, {
+                response: 0.4,
+                dampingFraction: 0.8,
+                respectReducedMotion: false,
+            });
+            target.value = 100;
+            await nextTick();
+            let at = 1000;
+            frame(at);
+            for (const gap of gaps) frame((at += gap));
+            const value = spring.value.value;
+            spring.dispose();
+            queue = [];
+            return value;
+        };
+        const frameMs = 1000 / 60;
+        // A 200 ms frame (a body that mounts, a table that renders) moves the spring as far
+        // as one steady frame does, not twelve.
+        const steady = await after([frameMs, frameMs]);
+        const long = await after([frameMs, 200]);
+        expect(steady).toBeGreaterThan(0);
+        expect(long).toBeCloseTo(steady, 9);
+    });
+
