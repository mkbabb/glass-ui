# AS.W2 inv-θ — gate output is a pure function in a gitignored cache (no
# tracked-state side effect; a deliberate snapshot uses GATE_SNAPSHOT=1 + the
# gate's env override to a committed path).
.cache/
.DS_Store
**/.DS_Store

# AP.W4 — audit/profiling scratch (screenshots + RSS-probe timing captures) must not collect at root
*.jpeg
*.jpg
*_time.txt

# AS.W6 — visual-capture scratch (the W7 paired-π capture scripts + their PNGs).
# Single-shot verification scratch, not the archived visual-evidence protocol
# (that lives under docs/tranches/*/audit/visual/). Gitignored so a `git add -A`
# can never sweep it into a commit or a release tarball.
as-verify/
