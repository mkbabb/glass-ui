node_modules/
dist/
*.png
# AX.W13 — the committed public-domain reference fixtures (Van Gogh's Starry Night is
# public domain). The π painterly-statistics gate anchors its atomicity-congruence read
# against this crop; it must be TRACKED past the *.png ignore.
!tests-visual/fixtures/*.png
# AX.W54 — the archived visual-evidence protocol: every live-verified wave's
# captured DELTA screenshots live under docs/tranches/*/audit/visual/ and MUST be
# TRACKED past the *.png ignore (the cardinal-lesson artefact — the
# proof:live-verified-ledger gate asserts these on-disk pngs exist on a fresh CI
# checkout, so they are version-controlled evidence, not scratch).
!docs/tranches/*/audit/visual/*.png
# The AZ reflection records' captures (proof:az-reflect asserts the cited pngs
# exist on a fresh CI runner — the same cardinal-lesson class as the visual dir).
!docs/tranches/*/audit/visual/*/*.png
!docs/tranches/*/audit/reflect/*.png
!docs/tranches/*/audit/reflect/*/*.png
# BJ — the per-wave evidence packets (docs/tranches/*/evidence/<WAVE>/). Same
# cardinal-lesson class: a pixel floor's proof is the captured DELTA PAIR (the real
# render AND the planted bite), so those captures are version-controlled evidence and
# must be TRACKED past the *.png ignore. A banked JSON report without its paired
# screenshot is half a DELTA.
!docs/tranches/*/evidence/*/*.png
.playwright-mcp/
demo/dist/
demo/.qa/
.claude/worktrees/
# AS.W2 inv-θ — gate output is a pure function in a gitignored cache (no
# tracked-state side effect; a deliberate snapshot uses GATE_SNAPSHOT=1 + the
# gate's env override to a committed path).
.cache/
.DS_Store
**/.DS_Store

# AP.W4 — audit/profiling scratch (screenshots + RSS-probe timing captures) must not collect at root
*.jpeg
*.jpg
*_time.txt

# BK adj:P2A S2 — the tranche execution-evidence captures (docs/tranches/*/execution/**).
# Same cardinal-lesson class as the audit/visual + evidence carve-outs above: a cited
# capture is version-controlled evidence, and a citation whose image is ignored is half
# a DELTA. Placed AFTER the *.jpeg/*.jpg ignores so the negations win. Scoped to the
# tranche execution dirs only — no widening past docs/tranches evidence.
!docs/tranches/*/execution/**/*.png
!docs/tranches/*/execution/**/*.jpeg
!docs/tranches/*/execution/**/*.jpg

# AS.W6 — visual-capture scratch (the W7 paired-π capture scripts + their PNGs).
# Single-shot verification scratch, not the archived visual-evidence protocol
# (that lives under docs/tranches/*/audit/visual/). Gitignored so a `git add -A`
# can never sweep it into a commit or a release tarball.
as-verify/
docs/tranches/F/audit/W1-runtime-smoke.json
docs/tranches/BD/_verify/

# BH.B0-W0 hygiene — close the three scratch-dir gaps so a `git add -A` can never
# re-adopt run scratch (the test-results/ Playwright artefacts were accidentally
# tracked; .tmp/ + .playwright/ are single-shot probe scratch). Dir-scoped, so the
# force-track carve-outs above (the visual-evidence *.png exceptions) are untouched.
.tmp/
.playwright/
test-results/
dist-demo/
docs/tranches/BG/audit/.wkshot-bin
docs/tranches/BG/audit/visual/.wkshot-drawer-bin
.judge-chrome-profile/
docs/tranches/BG/audit/.wkshot-scroll-bin
.chrome-profile-blob/
docs/tranches/BG/audit/visual/.serve-blob.log
docs/tranches/BG/audit/visual/.chrome-profile-*/
docs/tranches/BG/audit/ios27-eyeglass-tabs/frames/
docs/tranches/BG/audit/ios27-eyeglass-tabs/bar60/
docs/tranches/BG/audit/ios27-eyeglass-tabs/strip-*.png
docs/tranches/BG/audit/ios27-eyeglass-tabs/ext/
.claude/
docs/tranches/BJ/formation/round-3-live/perf-trace-*.json

# The publish lifecycle stages a generation in the repo ROOT (same filesystem, so
# the swap into dist/ is an atomic rename) and keeps the displaced dist as
# `<generation>.previous` until the swap succeeds. A SIGKILL mid-build leaves both
# behind; neither is ever committable.
.glass-generation-*/
*.previous
