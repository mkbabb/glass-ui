    "scripts": {
        "build": "vite build && npm run emit-types",
        "build:watch": "vite build --watch",
        "demo:dist:build": "vite build --config demo/vite.demo-dist.config.ts",
        "demo:dist:serve": "vite preview --config demo/vite.demo-dist.config.ts --port 5200",
        "demo:serve": "vite --host 127.0.0.1 --port 5199",
        "dev": "vite",
        "emit-types": "vue-tsc --project tsconfig.build.json && node scripts/flatten-subpath-types.mjs",
        "iter": "npm run iter-check && npm run iter-build && npm run iter-test",
        "iter-build": "vite build --config vite.iter.config.ts",
        "iter-check": "vue-tsc --noEmit --project tsconfig.src.json",
        "iter-test": "vitest run --reporter=verbose",
        "iter-test-watch": "vitest --watch",
        "prepare": "npm run build",
        "prepublishOnly": "npm run typecheck && npm run build && npm test",
        "profile:bundle": "node scripts/profile-bundle.mjs",
        "release": "bash scripts/release.sh",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
        "verify:package": "node scripts/verify-export-types.mjs"
