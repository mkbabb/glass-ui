    "scripts": {
        "dev": "vite",
        "build": "vite build && npm run emit-types",
        "build:watch": "vite build --watch",
        "prepare": "test -f dist/glass-ui.js -a -f dist/index.d.ts || npm run build",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "verify-export-types": "node scripts/verify-export-types.mjs",
        "audit:stash": "node scripts/audit-stash-list.mjs",
        "iter-check": "vue-tsc --noEmit --project tsconfig.src.json",
        "iter-build": "vite build --config vite.iter.config.ts",
        "iter-test": "vitest run --reporter=verbose",
        "iter-test-watch": "vitest --watch",
        "emit-types": "vue-tsc --project tsconfig.build.json",
        "iter": "npm run iter-check && npm run iter-build && npm run iter-test",
        "proof:package": "node scripts/proof-package.mjs",
