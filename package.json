{
    "name": "@mkbabb/glass-ui",
    "version": "0.3.0",
    "description": "Glassmorphic design system — Vue 3.5 components, reka-ui primitives, Tailwind CSS v4 tokens",
    "license": "MIT",
    "type": "module",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            "tokens": [
                "dist/tokens.d.ts"
            ],
            "*": [
                "dist/index.d.ts"
            ]
        }
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/glass-ui.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "import": "./dist/tokens.js"
        },
        "./styles": "./src/styles/index.css",
        "./styles/*": "./src/styles/*"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "verify-export-types": "node scripts/verify-export-types.mjs",
        "iter-check": "vue-tsc --noEmit --project tsconfig.src.json",
        "iter-build": "vite build --config vite.iter.config.ts",
        "iter-test": "vitest run --reporter=verbose",
        "iter-test-watch": "vitest --watch",
        "emit-types": "vue-tsc --emitDeclarationOnly --outDir dist/types --project tsconfig.json",
        "iter": "npm run iter-check && npm run iter-build && npm run iter-test",
        "profile-bundle": "vite build --config vite.config.ts",
        "profile-consumers": "scripts/validate-consumers.sh",
        "ay-close": "scripts/ay-close.sh",
        "validate-consumers": "scripts/validate-consumers.sh"
    },
    "engines": {
        "node": ">=22"
    },
    "peerDependencies": {
        "@mkbabb/keyframes.js": "^2.0.0",
        "@vueuse/core": "^14.0",
        "class-variance-authority": "^0.7",
        "clsx": "^2.0",
        "embla-carousel-vue": "^8.0",
        "reka-ui": "^2.0",
        "tailwind-merge": "^3.0",
        "tailwindcss": "^4.0",
        "vue": "^3.5"
    },
    "peerDependenciesMeta": {
        "@mkbabb/keyframes.js": {
            "optional": true
        },
        "embla-carousel-vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@mkbabb/keyframes.js": "file:../keyframes.js",
        "@tailwindcss/postcss": "^4.1.11",
        "@tailwindcss/vite": "^4.2.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.10",
        "@vueuse/core": "^14.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-vue": "^8.6.0",
        "happy-dom": "^20.9.0",
        "lucide-vue-next": "^0.525.0",
        "reka-ui": "^2.0.0",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.11",
        "tw-animate-css": "^1.2.5",
        "typescript": "^5.8.3",
        "vaul-vue": "^0.2.0",
        "vite": "^7.0.6",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.5",
        "vue": "^3.5.18",
        "vue-router": "^4.6.4",
        "vue-tsc": "^2.2.0"
    }
}
