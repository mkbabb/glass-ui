{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-ui.local/schemas/tranche/cursor.schema.json",
  "title": "Perfected BI reconstructable execution cursor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "authority",
    "formationDigest",
    "formationAnchor",
    "sourceBase",
    "atCommit",
    "atTree",
    "maxLiveAgents",
    "withdrawn",
    "runningWaves",
    "terminalCount",
    "waves"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "mode": { "const": "TRANCHE_DEVELOPMENT" },
    "authority": { "const": "GIT_FIRST_PARENT_PLUS_COMMITTED_RECEIPTS" },
    "formationDigest": { "$ref": "#/$defs/sha256" },
    "formationAnchor": { "$ref": "#/$defs/gitObject" },
    "sourceBase": { "$ref": "#/$defs/gitObject" },
    "atCommit": { "$ref": "#/$defs/gitObject" },
    "atTree": { "$ref": "#/$defs/gitObject" },
    "maxLiveAgents": { "const": 3 },
    "withdrawn": { "type": "boolean" },
    "runningWaves": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/waveId" }
    },
    "terminalCount": { "type": "integer", "minimum": 0 },
    "waves": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/waveId" },
      "additionalProperties": { "$ref": "#/$defs/wave" }
    }
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "waveId": {
      "type": "string",
      "pattern": "^BI\\.W-P(?:[0-9]{3}|[1-9][0-9]{3,})$"
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commit",
        "evidenceDigest",
        "terminalRationale",
        "receiptPath",
        "projectionMode",
        "dependsOn",
        "integrationRequires"
      ],
      "properties": {
        "status": { "enum": ["PLANNED", "RUNNING", "DONE", "DEAD"] },
        "commit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/gitObject" }
          ]
        },
        "evidenceDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "terminalRationale": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "receiptPath": {
          "type": "string",
          "pattern": "^docs/tranches/BI/(?:BOOTSTRAP\\.json|evidence/BI\\.W-P(?:[0-9]{3}|[1-9][0-9]{3,})/receipt\\.json)$"
        },
        "projectionMode": { "enum": ["NONE", "ACTIVATE", "REFRESH"] },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/waveId" }
        },
        "integrationRequires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/waveId" }
        }
      }
    }
  }
}
