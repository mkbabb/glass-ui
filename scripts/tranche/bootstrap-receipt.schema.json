{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-ui.dev/schemas/tranche/bootstrap-receipt.schema.json",
  "title": "BI.W-P000 self-reference-free bootstrap receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "formationDigest",
    "formationAnchorParent",
    "sourceBase",
    "waveId",
    "status",
    "integrationParent",
    "preCommandSet",
    "postCommandSet",
    "subjectOutcomes",
    "evidenceDigest",
    "routedCurrentReds",
    "intendedTrailers",
    "payloadDigestExcludingIntegrationAdjuncts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "authority": { "const": "GIT_FIRST_PARENT_PLUS_COMMITTED_RECEIPTS" },
    "formationDigest": { "$ref": "#/$defs/sha256" },
    "formationAnchorParent": { "$ref": "#/$defs/gitSha" },
    "sourceBase": { "$ref": "#/$defs/gitSha" },
    "waveId": { "const": "BI.W-P000" },
    "status": { "enum": ["DONE", "DEAD"] },
    "integrationParent": { "$ref": "#/$defs/gitSha" },
    "preCommandSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "postCommandSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "subjectOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/subjectOutcome" }
    },
    "evidenceDigest": { "$ref": "#/$defs/sha256" },
    "routedCurrentReds": {
      "type": "array",
      "items": { "$ref": "#/$defs/routedRed" }
    },
    "intendedTrailers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "values", "externallyDerived"],
      "properties": {
        "names": {
          "const": ["BI-Wave", "BI-Status", "BI-Receipt-SHA256", "BI-Formation-SHA256"]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["BI-Wave", "BI-Status", "BI-Formation-SHA256"],
          "properties": {
            "BI-Wave": { "const": "BI.W-P000" },
            "BI-Status": { "enum": ["DONE", "DEAD"] },
            "BI-Formation-SHA256": { "$ref": "#/$defs/sha256" }
          }
        },
        "externallyDerived": { "const": ["BI-Receipt-SHA256"] }
      }
    },
    "payloadDigestExcludingIntegrationAdjuncts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256", "entryCount", "excludes"],
      "properties": {
        "algorithm": { "const": "sha256(canonical-git-stage0-index-v1)" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "entryCount": { "type": "integer", "minimum": 1 },
        "excludes": {
          "const": [
            "docs/tranches/BI/BOOTSTRAP.json",
            "docs/tranches/BI/RELEASE-ATTESTATION.json",
            "docs/tranches/BI/FINAL.md"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "gitObject": {
      "anyOf": [
        { "$ref": "#/$defs/gitSha" },
        { "type": "null" }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "key", "argv"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "argv": { "type": "string", "minLength": 1 }
      }
    },
    "subjectOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "plannedAction", "disposition", "preimage", "postimage"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "plannedAction": { "enum": ["create", "delete", "modify", "rename", "repair", "verify"] },
        "disposition": {
          "enum": ["CREATED", "DELETED", "MODIFIED", "RENAMED", "VERIFIED_UNCHANGED"]
        },
        "preimage": { "$ref": "#/$defs/gitObject" },
        "postimage": { "$ref": "#/$defs/gitObject" }
      }
    },
    "routedRed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "invariantFamily", "summary", "status", "ownerWave", "evidencePath"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "invariantFamily": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "const": "ROUTED_RED" },
        "ownerWave": { "type": "string", "pattern": "^BI\\.W-P(?:00[1-9]|0[1-9][0-9]|1[0-2][0-9]|13[0-3])$" },
        "evidencePath": { "const": "docs/tranches/BI/BOOTSTRAP.json" }
      }
    }
  }
}
