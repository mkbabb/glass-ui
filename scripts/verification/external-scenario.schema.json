{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-ui.dev/schemas/verification/external-scenario.schema.json",
  "title": "Glass UI typed external verification scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "ownerWave",
    "title",
    "candidate",
    "invariantFamilies",
    "environments",
    "steps",
    "assertions",
    "receiptContract"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "ownerWave": { "type": "string", "pattern": "^BI\\.W-P[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "testedSourceSha", "packageName", "tarballSha256"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "testedSourceSha": { "$ref": "#/$defs/gitSha" },
        "packageName": { "type": "string", "minLength": 1 },
        "tarballSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "invariantFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)+$" }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["browser", "viewport", "colorScheme", "input"],
        "properties": {
          "browser": { "enum": ["chromium", "firefox", "webkit"] },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 240 },
              "height": { "type": "integer", "minimum": 240 }
            }
          },
          "colorScheme": { "enum": ["light", "dark"] },
          "input": { "enum": ["fine", "coarse", "keyboard"] },
          "reducedMotion": { "type": "boolean" },
          "forcedColors": { "type": "boolean" },
          "reducedTransparency": { "type": "boolean" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "enum": ["navigate", "keyboard", "pointer", "touch", "configure", "wait-for-state"]
          },
          "target": { "type": "string", "minLength": 1 },
          "value": {},
          "state": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "navigate" } }, "required": ["action"] },
            "then": { "required": ["target"] }
          },
          {
            "if": { "properties": { "action": { "enum": ["keyboard", "pointer", "touch", "configure"] } }, "required": ["action"] },
            "then": { "required": ["target", "value"] }
          },
          {
            "if": { "properties": { "action": { "const": "wait-for-state" } }, "required": ["action"] },
            "then": { "required": ["state"] }
          }
        ]
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "subject", "expected"],
        "properties": {
          "kind": {
            "enum": [
              "semantic",
              "geometry",
              "visual-order",
              "motion-trajectory",
              "performance",
              "accessibility",
              "resource-ownership"
            ]
          },
          "subject": { "type": "string", "minLength": 1 },
          "expected": {
            "anyOf": [
              { "type": "boolean" },
              { "type": "number" },
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1 },
              { "type": "object", "minProperties": 1 }
            ]
          }
        }
      }
    },
    "receiptContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testedSourceSha", "browserIdentity", "assertionOutcomes", "artifactDigests"],
      "properties": {
        "testedSourceSha": { "const": true },
        "browserIdentity": { "const": true },
        "assertionOutcomes": { "const": true },
        "artifactDigests": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
